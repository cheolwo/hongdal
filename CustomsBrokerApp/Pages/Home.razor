@page "/"
@inject CustomsBrokerAuthService AuthService
@inject HsCodeCorrectionService HsCodeService

<PageTitle>관세사 HS 코드 보정</PageTitle>

@if (!AuthService.IsSignedIn)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudPaper Outlined="true" Class="pa-6">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="5">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Customs Broker</MudText>
                        <MudText Typo="Typo.h4">HS 코드 보정</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            관세사 권한으로 로그인한 뒤 식품/일반화물 분류와 통관 주의 태그를 보정합니다.
                        </MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="7">
                    <EditForm Model="loginModel" OnValidSubmit="LoginAsync">
                        <DataAnnotationsValidator />
                        <MudStack Spacing="2">
                            <MudTextField T="string"
                                          Label="계정"
                                          @bind-Value="loginModel.UserNameOrEmail"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                            <MudTextField T="string"
                                          Label="비밀번호"
                                          @bind-Value="loginModel.Password"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            @if (!string.IsNullOrWhiteSpace(message))
                            {
                                <MudAlert Severity="@messageSeverity" Dense="true">@message</MudAlert>
                            }

                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Disabled="@isBusy"
                                       StartIcon="@Icons.Material.Filled.Login">
                                로그인
                            </MudButton>
                        </MudStack>
                    </EditForm>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudStack Spacing="3">
        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Color="Color.Secondary">HS Code Correction</MudText>
                    <MudText Typo="Typo.h4">관세사 보정 워크벤치</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        화주에게 공개될 HS 코드 데이터의 업무 분류와 통관 리스크 태그를 검토합니다.
                    </MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@AuthService.UserName</MudChip>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Logout"
                               OnClick="Logout">
                        로그아웃
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  Label="검색"
                                  @bind-Value="searchQuery"
                                  Placeholder="HS 코드, 한글명, 영문명"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="string"
                               Label="업무 분류"
                               @bind-Value="selectedBusinessCategory"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@AllOption">전체</MudSelectItem>
                        @foreach (var option in BusinessCategoryOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Value.ToString()">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string"
                               Label="주의 태그"
                               @bind-Value="selectedTagType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@AllOption">전체</MudSelectItem>
                        @foreach (var option in RiskTagOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Value.ToString()">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudCheckBox T="bool"
                                 Label="비활성 포함"
                                 @bind-Value="includeInactive"
                                 Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" md="1">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@isBusy"
                               OnClick="SearchAsync"
                               StartIcon="@Icons.Material.Filled.Refresh">
                        조회
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity" Dense="true">@message</MudAlert>
        }

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="5">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">HS 코드 목록</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">총 @(result.TotalCount)건</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Disabled="@(page <= 1 || isBusy)"
                                       OnClick="PreviousPageAsync"
                                       StartIcon="@Icons.Material.Filled.ChevronLeft">
                                이전
                            </MudButton>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@($"{page}쪽")</MudChip>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Disabled="@(IsLastPage || isBusy)"
                                       OnClick="NextPageAsync"
                                       EndIcon="@Icons.Material.Filled.ChevronRight">
                                다음
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (isBusy)
                    {
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                            <MudProgressCircular Indeterminate="true" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">데이터를 불러오는 중입니다.</MudText>
                        </MudStack>
                    }
                    else if (result.Items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">조회된 HS 코드가 없습니다.</MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            @foreach (var item in result.Items)
                            {
                                <MudPaper Outlined="true"
                                          Class="@EntryCardClass(item)"
                                          @onclick="() => SelectEntry(item)">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">@item.Code</MudText>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.BusinessCategoryLabel</MudChip>
                                        </MudStack>
                                        <MudText Typo="Typo.body2">@DisplayName(item)</MudText>
                                        @if (item.RiskTags.Any(x => x.IsActive))
                                        {
                                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                @foreach (var tag in item.RiskTags.Where(x => x.IsActive).Take(2))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@tag.Label</MudChip>
                                                }
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudPaper Outlined="true" Class="pa-4">
                    @if (selectedEntry is null)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            왼쪽 목록에서 보정할 HS 코드를 선택하세요.
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h5">@selectedEntry.Code</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@DisplayName(selectedEntry)</MudText>
                                </MudStack>
                                <MudChip T="string"
                                         Color="@(selectedEntry.IsActive ? Color.Success : Color.Default)"
                                         Variant="Variant.Filled">
                                    @(selectedEntry.IsActive ? "활성" : "비활성")
                                </MudChip>
                            </MudStack>

                            <MudDivider />

                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">업무 분류</MudText>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="int"
                                                   Label="분류"
                                                   @bind-Value="editBusinessCategory"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense">
                                            @foreach (var option in BusinessCategoryOptions)
                                            {
                                                <MudSelectItem T="int" Value="@option.Value">@option.Label</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="8">
                                        <MudTextField T="string"
                                                      Label="보정 사유"
                                                      @bind-Value="editBusinessCategoryReason"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@isSaving"
                                           OnClick="SaveBusinessCategoryAsync"
                                           StartIcon="@Icons.Material.Filled.Save">
                                    분류 저장
                                </MudButton>
                            </MudStack>

                            <MudDivider />

                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.h6">통관 주의 태그</MudText>
                                    <MudButton Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               OnClick="ResetTagForm"
                                               StartIcon="@Icons.Material.Filled.Add">
                                        새 태그
                                    </MudButton>
                                </MudStack>

                                @if (selectedEntry.RiskTags.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">등록된 주의 태그가 없습니다.</MudAlert>
                                }
                                else
                                {
                                    <MudStack Spacing="1">
                                        @foreach (var tag in selectedEntry.RiskTags)
                                        {
                                            <MudPaper Outlined="true" Class="pa-3">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2">
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.subtitle2">@tag.Label</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@tag.SourceLabel</MudText>
                                                        <MudText Typo="Typo.body2">@tag.Reason</MudText>
                                                    </MudStack>
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="@(tag.IsActive ? Color.Success : Color.Default)"
                                                                 Variant="Variant.Outlined">
                                                            @(tag.IsActive ? "사용" : "숨김")
                                                        </MudChip>
                                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => EditTag(tag)">수정</MudButton>
                                                        <MudButton Variant="Variant.Text"
                                                                   Size="Size.Small"
                                                                   Color="Color.Secondary"
                                                                   Disabled="@isSaving"
                                                                   OnClick="() => ToggleTagAsync(tag)">
                                                            @(tag.IsActive ? "숨김" : "사용")
                                                        </MudButton>
                                                    </MudStack>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                }

                                <MudPaper Outlined="true" Class="pa-3">
                                    <MudStack Spacing="2">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" md="4">
                                                <MudSelect T="int"
                                                           Label="태그 유형"
                                                           @bind-Value="editTagType"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense">
                                                    @foreach (var option in RiskTagOptions)
                                                    {
                                                        <MudSelectItem T="int" Value="@option.Value">@option.Label</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="8">
                                                <MudTextField T="string"
                                                              Label="표시명"
                                                              @bind-Value="editTagLabel"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" />
                                            </MudItem>
                                        </MudGrid>
                                        <MudTextField T="string"
                                                      Label="보정 사유"
                                                      @bind-Value="editTagReason"
                                                      Variant="Variant.Outlined"
                                                      Lines="3" />
                                        <MudCheckBox T="bool"
                                                     Label="활성 태그로 사용"
                                                     @bind-Value="editTagIsActive"
                                                     Color="Color.Primary" />
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@isSaving"
                                                   OnClick="SaveTagAsync"
                                                   StartIcon="@Icons.Material.Filled.Save">
                                            태그 저장
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                            </MudStack>
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
}

@code {
    private const string AllOption = "";

    private static readonly IReadOnlyList<OptionItem> BusinessCategoryOptions =
    [
        new(0, "미분류"),
        new(10, "식품 관련"),
        new(20, "일반 화물"),
        new(30, "복합")
    ];

    private static readonly IReadOnlyList<OptionItem> RiskTagOptions =
    [
        new(10, "식품 관련"),
        new(20, "검역/식품신고 확인"),
        new(30, "조제식품/보충제 검토"),
        new(40, "섬유/의류"),
        new(50, "화학물질 확인"),
        new(60, "전기/인증 확인"),
        new(70, "배터리 포함 가능"),
        new(80, "가구/생활용품"),
        new(900, "관세사 검토 권장")
    ];

    private readonly LoginModel loginModel = new();
    private AdminHsCodeListResponse result = new();
    private AdminHsCodeEntryResponse? selectedEntry;
    private string? searchQuery;
    private string selectedBusinessCategory = AllOption;
    private string selectedTagType = AllOption;
    private bool includeInactive;
    private int page = 1;
    private const int PageSize = 25;
    private bool isBusy;
    private bool isSaving;
    private string? message;
    private Severity messageSeverity = Severity.Success;

    private int editBusinessCategory = 20;
    private string editBusinessCategoryReason = string.Empty;
    private long? editingTagId;
    private int editTagType = 900;
    private string editTagLabel = string.Empty;
    private string editTagReason = string.Empty;
    private bool editTagIsActive = true;

    private bool IsLastPage => result.TotalCount <= page * PageSize;

    private async Task LoginAsync()
    {
        isBusy = true;
        message = null;

        try
        {
            var loginResult = await AuthService.LoginAsync(loginModel.UserNameOrEmail, loginModel.Password);
            if (!loginResult.Succeeded)
            {
                ShowError(loginResult.ErrorMessage);
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowError($"로그인 처리 실패: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void Logout()
    {
        AuthService.Logout();
        result = new AdminHsCodeListResponse();
        selectedEntry = null;
        message = null;
    }

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        message = null;

        try
        {
            result = await HsCodeService.SearchAsync(
                searchQuery,
                selectedBusinessCategory,
                selectedTagType,
                includeInactive,
                page,
                PageSize);

            if (selectedEntry is not null)
            {
                selectedEntry = result.Items.FirstOrDefault(x => x.Id == selectedEntry.Id);
            }
        }
        catch (Exception ex)
        {
            ShowError($"HS 코드 조회 실패: {ex.Message}");
            result = new AdminHsCodeListResponse();
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SelectEntry(AdminHsCodeEntryResponse item)
    {
        selectedEntry = item;
        editBusinessCategory = item.BusinessCategory;
        editBusinessCategoryReason = item.BusinessCategoryReason;
        ResetTagForm();
    }

    private async Task SaveBusinessCategoryAsync()
    {
        if (selectedEntry is null)
        {
            return;
        }

        isSaving = true;
        try
        {
            var updated = await HsCodeService.UpdateBusinessCategoryAsync(
                selectedEntry.Id,
                new AdminHsCodeBusinessCategoryUpdateRequest
                {
                    BusinessCategory = editBusinessCategory,
                    Reason = editBusinessCategoryReason
                });

            ApplyUpdatedEntry(updated);
            ShowSuccess("업무 분류를 저장했습니다.");
        }
        catch (Exception ex)
        {
            ShowError($"업무 분류 저장 실패: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveTagAsync()
    {
        if (selectedEntry is null)
        {
            return;
        }

        isSaving = true;
        try
        {
            var payload = new AdminHsCodeRiskTagUpdateRequest
            {
                TagType = editTagType,
                Label = editTagLabel,
                Reason = editTagReason,
                IsActive = editTagIsActive
            };

            var updated = editingTagId is long tagId
                ? await HsCodeService.UpdateRiskTagAsync(tagId, payload)
                : await HsCodeService.SaveRiskTagAsync(selectedEntry.Id, payload);

            ApplyUpdatedEntry(updated);
            ResetTagForm();
            ShowSuccess("주의 태그를 저장했습니다.");
        }
        catch (Exception ex)
        {
            ShowError($"주의 태그 저장 실패: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleTagAsync(AdminHsCodeRiskTagResponse tag)
    {
        isSaving = true;
        try
        {
            var updated = await HsCodeService.UpdateRiskTagAsync(
                tag.Id,
                new AdminHsCodeRiskTagUpdateRequest
                {
                    TagType = tag.TagType,
                    Label = tag.Label,
                    Reason = tag.Reason,
                    IsActive = !tag.IsActive
                });

            ApplyUpdatedEntry(updated);
            ShowSuccess(tag.IsActive ? "주의 태그를 숨김 처리했습니다." : "주의 태그를 다시 사용 처리했습니다.");
        }
        catch (Exception ex)
        {
            ShowError($"주의 태그 상태 변경 실패: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditTag(AdminHsCodeRiskTagResponse tag)
    {
        editingTagId = tag.Id;
        editTagType = tag.TagType;
        editTagLabel = tag.Label;
        editTagReason = tag.Reason;
        editTagIsActive = tag.IsActive;
    }

    private void ResetTagForm()
    {
        editingTagId = null;
        editTagType = 900;
        editTagLabel = string.Empty;
        editTagReason = string.Empty;
        editTagIsActive = true;
    }

    private async Task PreviousPageAsync()
    {
        if (page <= 1)
        {
            return;
        }

        page--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (IsLastPage)
        {
            return;
        }

        page++;
        await LoadAsync();
    }

    private void ApplyUpdatedEntry(AdminHsCodeEntryResponse? updated)
    {
        if (updated is null)
        {
            return;
        }

        selectedEntry = updated;
        editBusinessCategory = updated.BusinessCategory;
        editBusinessCategoryReason = updated.BusinessCategoryReason;

        var items = result.Items.ToList();
        var index = items.FindIndex(x => x.Id == updated.Id);
        if (index >= 0)
        {
            items[index] = updated;
            result.Items = items;
        }
    }

    private string EntryCardClass(AdminHsCodeEntryResponse item)
    {
        const string baseClass = "pa-3 customs-entry-card";
        return selectedEntry?.Id == item.Id ? $"{baseClass} customs-entry-card--selected" : baseClass;
    }

    private static string DisplayName(AdminHsCodeEntryResponse item)
    {
        if (!string.IsNullOrWhiteSpace(item.KoreanName))
        {
            return item.KoreanName;
        }

        return string.IsNullOrWhiteSpace(item.EnglishName) ? item.NormalizedCode : item.EnglishName;
    }

    private void ShowSuccess(string text)
    {
        message = text;
        messageSeverity = Severity.Success;
    }

    private void ShowError(string text)
    {
        message = text;
        messageSeverity = Severity.Error;
    }

    private sealed class LoginModel
    {
        public string UserNameOrEmail { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed record OptionItem(int Value, string Label);
}
