@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Routing

<MudLayout>
    <MudAppBar Dense="true" Fixed="false" Elevation="0" Color="Color.Default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   Disabled="@(!CanGoBack)"
                   OnClick="GoBack"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            뒤로가기
        </MudButton>
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle1">Hongdal Customs</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">관세사 HS 코드 보정</MudText>
        </MudStack>
    </MudAppBar>

    <MudDrawer Open="@drawerOpen" Variant="DrawerVariant.Responsive" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 customs-main">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly Stack<string> _navigationHistory = new();
    private string? _currentUri;
    private bool _isNavigatingBack;
    private bool drawerOpen = true;

    private bool CanGoBack => _navigationHistory.Count > 0;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        _currentUri = NavigationManager.Uri;
    }

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }

    private void GoBack()
    {
        if (_navigationHistory.Count == 0)
        {
            return;
        }

        var previousUri = _navigationHistory.Pop();
        _isNavigatingBack = true;
        NavigationManager.NavigateTo(previousUri);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_isNavigatingBack)
        {
            _isNavigatingBack = false;
            _currentUri = args.Location;
            InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_currentUri) && !string.Equals(_currentUri, args.Location, StringComparison.OrdinalIgnoreCase))
        {
            _navigationHistory.Push(_currentUri);
        }

        _currentUri = args.Location;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
