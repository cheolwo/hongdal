@using Hongdal.Ui.Common.Areas.App.Services
@implements IDisposable
@inject PlatformHomeModeStateService HomeModeState

<MudNavMenu Class="pa-3 warehouse-navmenu">
    <MudStack Spacing="0" Class="px-2 pb-3">
        <MudText Typo="Typo.subtitle1" Class="fw-bold">Warehouse Manager</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">창고 공정 / 도심 물류</MudText>
    </MudStack>
    <MudDivider Class="mb-3" />

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">플랫폼 홈</MudNavLink>
    <MudNavLink Href="work/inbound" Icon="@Icons.Material.Filled.MoveToInbox">입고 시작</MudNavLink>
    <MudNavLink Href="work/outbound" Icon="@Icons.Material.Filled.Outbox">출고 시작</MudNavLink>
    <MudNavLink Href="work/packing" Icon="@Icons.Material.Filled.Inventory">포장 시작</MudNavLink>
    <MudNavLink Href="work/market-fulfillment" Icon="@Icons.Material.Filled.Storefront">마켓 출고</MudNavLink>
    <MudNavLink Href="work/international-forwarding" Icon="@Icons.Material.Filled.Public">해외 배송대행</MudNavLink>
    <MudNavLink Href="work/delivery-agency" Icon="@Icons.Material.Filled.LocalShipping">국내 배송대행</MudNavLink>

    <MudDivider Class="my-3" />
    <MudNavLink Href="mart" Icon="@Icons.Material.Filled.Storefront">알뜰살뜰 마트</MudNavLink>
    <MudNavLink Href="mart/work-board" Icon="@Icons.Material.Filled.Dashboard">알뜰살뜰 마트 작업 보드</MudNavLink>
    <MudNavLink Href="mart/picking" Icon="@Icons.Material.Filled.ShoppingCartCheckout">알뜰살뜰 마트 피킹/포장</MudNavLink>

    <MudDivider Class="my-3" />
    <MudNavLink Href="scan" Icon="@Icons.Material.Filled.QrCodeScanner">스캔 스테이션</MudNavLink>
    <MudNavLink Href="work-board" Icon="@Icons.Material.Filled.ViewKanban">일반 작업 보드</MudNavLink>
    <MudNavLink Href="work/picking-batch" Icon="@Icons.Material.Filled.Inventory2">피킹 배치</MudNavLink>

    <MudDivider Class="my-3" />
    <MudStack Spacing="1" Class="px-2 pb-2">
        <MudText Typo="Typo.caption" Color="Color.Secondary">모드 전환</MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudButton Variant="@CommunityModeVariant" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Forum" OnClick="@(() => SetMode(false))">커뮤니티</MudButton>
            <MudButton Variant="@WorkModeVariant" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Work" OnClick="@(() => SetMode(true))">업무</MudButton>
        </MudStack>
    </MudStack>
</MudNavMenu>

@code {
    private Variant CommunityModeVariant => HomeModeState.IsWorkMode ? Variant.Outlined : Variant.Filled;

    private Variant WorkModeVariant => HomeModeState.IsWorkMode ? Variant.Filled : Variant.Outlined;

    protected override void OnInitialized()
    {
        HomeModeState.Changed += HandleModeChanged;
    }

    private void SetMode(bool isWorkMode)
    {
        HomeModeState.SetWorkMode(isWorkMode);
    }

    private void HandleModeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        HomeModeState.Changed -= HandleModeChanged;
    }
}
