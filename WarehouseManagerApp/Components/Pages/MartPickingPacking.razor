@page "/mart/picking"
@inherits MvvmComponentBase<마트피킹포장PageViewModel>
@inject NavigationManager Navigation

<PageTitle>알뜰살뜰 마트 피킹/포장 조회</PageTitle>

<WarehousePageShell Model="@ViewModel"
                    Title="알뜰살뜰 마트 피킹/포장"
                    Description="접근 가능한 영속 마트 주문과 피킹·포장 작업을 조회합니다."
                    Icon="@Icons.Material.Filled.Inventory2"
                    Color="Color.Primary">
    <Actions>
        @if (ViewModel.기능사용가능 && ViewModel.인증.창고업무접근가능)
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">
                    @ViewModel.인증.현재사용자표시
                </MudChip>
                <MudTooltip Text="마트 피킹 주문 다시 조회">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   Disabled="@ViewModel.처리중"
                                   OnClick="RefreshAsync"
                                   aria-label="마트 피킹 주문 다시 조회" />
                </MudTooltip>
                <MudButton Href="@WarehouseManagerRoutes.MartHome"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Storefront">
                    마트 홈
                </MudButton>
            </MudStack>
        }
    </Actions>
    <ChildContent>
        @if (!ViewModel.초기화됨 || ViewModel.초기화중)
        {
            <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        마트 기능, 창고 권한과 영속 피킹 작업을 확인하고 있습니다.
                    </MudText>
                </MudStack>
            </MudPaper>
        }
        else if (!string.IsNullOrWhiteSpace(ViewModel.페이지오류메시지))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText>@ViewModel.페이지오류메시지</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@ViewModel.처리중" OnClick="RetryPageAsync">
                        다시 확인
                    </MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (!ViewModel.기능사용가능)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">마트 피킹 조회가 비활성입니다.</MudText>
                    <MudText Typo="Typo.body2">@ViewModel.기능안내</MudText>
                    <MudText Typo="Typo.caption">
                        <code>SsalddelMartWorkflow</code>가 활성화된 환경에서만 서버 작업 원장을 조회합니다.
                    </MudText>
                </MudStack>
            </MudAlert>
        }
        else if (!ViewModel.인증.창고업무접근가능)
        {
            <WarehouseAuthenticationPanel ViewModel="@ViewModel.인증"
                                          OnAuthenticated="AfterAuthenticationAsync"
                                          OnLoggedOut="OnLoggedOut" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Visibility">
                Beta/ReadOnly 페이지입니다. 서버 성공 응답 없이 피킹 수량, 포장 또는 출고 상태를 바꾸는 동작은 제공하지 않습니다.
            </MudAlert>

            <SsalddelMartPickingPackingWorkflow Model="@ViewModel.작업조회"
                                                WorkBoardUrl="@WarehouseManagerRoutes.MartWorkBoard"
                                                OnOrderSelected="OpenOrderAsync" />
        }
    </ChildContent>
</WarehousePageShell>

@code {
    private bool _parametersLoaded;
    private long? _loadedOrderId;

    [Parameter]
    [SupplyParameterFromQuery(Name = "orderId")]
    public long? OrderId { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!string.Equals(ViewModel.세션.운영ProfileCode, 창고운영ProfileCodes.마트도심, StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.세션.운영Profile설정(창고운영ProfileCodes.마트도심);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_parametersLoaded && _loadedOrderId == OrderId)
        {
            return;
        }

        _parametersLoaded = true;
        _loadedOrderId = OrderId;
        await ViewModel.초기화Async(OrderId);
    }

    private async Task AfterAuthenticationAsync()
        => await ViewModel.인증후조회Async();

    private void OnLoggedOut()
        => ViewModel.인증해제적용();

    private async Task RefreshAsync()
        => await ViewModel.다시조회Async();

    private async Task RetryPageAsync()
        => await ViewModel.초기화Async(OrderId);

    private Task OpenOrderAsync(long? orderId)
    {
        var target = orderId is > 0
            ? $"{WarehouseManagerRoutes.MartPickingPacking}?orderId={orderId.Value}"
            : WarehouseManagerRoutes.MartPickingPacking;
        Navigation.NavigateTo(target);
        return Task.CompletedTask;
    }
}
