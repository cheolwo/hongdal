@page "/scan"

<PageTitle>스캔 스테이션</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">스캔 스테이션</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">입고, 적재, 번들, 포장 작업의 바코드 스캔을 처리합니다.</MudText>
        </MudStack>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <HongdalWarehouseScanStation Step="@step"
                                         Scans="@scans"
                                         ScansChanged="OnScansChangedAsync"
                                         ActionConfirmed="OnActionConfirmedAsync"
                                         Title="@StepTitle"
                                         ConfirmButtonText="작업 확인"
                                         ClearButtonText="스캔 초기화"
                                         ScannerId="warehouse-manager-app" />
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="Severity.Success">@message</MudAlert>
        }
    </MudStack>
</MudContainer>

@code {
    private readonly List<WarehouseBarcodeScan> scans = [];
    private string step = WarehouseScanStepCode.ReceiveInbound;
    private string? message;

    private string StepTitle => step switch
    {
        WarehouseScanStepCode.ReceiveInbound => "입고 스캔",
        WarehouseScanStepCode.SplitProduct => "상품 분할",
        WarehouseScanStepCode.CreateBundle => "번들 생성",
        WarehouseScanStepCode.PutAway => "적재 스캔",
        _ => "창고 스캔"
    };

    private Task OnScansChangedAsync(IReadOnlyList<WarehouseBarcodeScan> value)
    {
        scans.Clear();
        scans.AddRange(value);
        return Task.CompletedTask;
    }

    private Task OnActionConfirmedAsync(WarehouseScanAction action)
    {
        if (action.IsReady)
        {
            message = $"{action.DisplayName} 작업 확인됨: {string.Join(", ", action.Scans.Select(x => x.RawCode))}";
            scans.Clear();
        }

        return Task.CompletedTask;
    }
}
