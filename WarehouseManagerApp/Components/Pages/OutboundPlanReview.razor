@page "/warehouse/general/outbound-plan-review"
@inherits MvvmComponentBase<창고출고예정검토PageViewModel>
@inject NavigationManager Navigation

<PageTitle>출고예정 운송 전 검토</PageTitle>

<WarehousePageShell Model="@ViewModel"
                    Title="출고예정 운송 전 검토"
                    Description="준비된 출고예정 원장과 운송의뢰 생성 전 필수 입력을 읽기 전용으로 확인합니다."
                    Icon="@Icons.Material.Filled.FactCheck"
                    Color="Color.Info">
    <Actions>@if(ViewModel.기능사용가능&&ViewModel.인증.창고업무접근가능){<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">@ViewModel.인증.현재사용자표시</MudChip>}</Actions>
    <ChildContent>
        @if(!ViewModel.초기화됨||ViewModel.초기화중){<MudPaper Class="pa-6" Elevation="0" Outlined="true"><MudStack AlignItems="AlignItems.Center"><MudProgressCircular Indeterminate="true" /><MudText>출고예정 검토 기능과 창고 업무 권한을 확인하고 있습니다.</MudText></MudStack></MudPaper>}
        else if(!string.IsNullOrWhiteSpace(ViewModel.페이지오류메시지)){<MudAlert Severity="Severity.Error">@ViewModel.페이지오류메시지 <MudButton Variant="Variant.Text" OnClick="RetryAsync">다시 확인</MudButton></MudAlert>}
        else if(!ViewModel.기능사용가능){<MudAlert Severity="Severity.Info"><MudText Typo="Typo.subtitle1">출고예정 검토 기능이 비활성입니다.</MudText><MudText>@ViewModel.기능안내</MudText><MudText Typo="Typo.caption">0.0 공개 커뮤니티에는 영향이 없습니다.</MudText></MudAlert>}
        else if(!ViewModel.인증.창고업무접근가능){<WarehouseAuthenticationPanel ViewModel="@ViewModel.인증" OnAuthenticated="AfterAuthAsync" OnLoggedOut="OnLoggedOut" />}
        else{<SsalddelOutboundPlanReviewWorkspace OutboundPlanId="@OutboundPlanId" OnPlanSelected="UpdateRoute" />}
    </ChildContent>
</WarehousePageShell>

@code {
    [SupplyParameterFromQuery(Name="outboundPlanId")] public long? OutboundPlanId { get; set; }
    protected override async Task OnInitializedAsync()=>await ViewModel.초기화Async();
    private Task AfterAuthAsync(){ViewModel.인증후준비();return Task.CompletedTask;}
    private void OnLoggedOut()=>ViewModel.인증해제적용();
    private async Task RetryAsync()=>await ViewModel.초기화Async();
    private Task UpdateRoute(long? id){Navigation.NavigateTo(id is>0?$"{WarehouseManagerRoutes.OutboundPlanReview}?outboundPlanId={id}":WarehouseManagerRoutes.OutboundPlanReview,replace:true);return Task.CompletedTask;}
}
