@page "/work/picking-batch"
@using Ssalddel.Contracts.Common.Warehouse
@inject NavigationManager Navigation

<PageTitle>피킹 작업 목록</PageTitle>

<PickingBatchAccessFrame Title="피킹 작업 목록"
                         Description="접근 가능한 피킹 작업을 검색하고 stable-key 상세 화면으로 이동합니다.">
    <PickingTaskListScreen Context="@Context" HomeHref="@WarehouseManagerRoutes.WorkBoard" />
</PickingBatchAccessFrame>

@code {
    [SupplyParameterFromQuery(Name = "taskKey")]
    public string? TaskKey { get; set; }

    private PickingTaskNavigationContext Context
        => PickingTaskNavigationContext.Parse(Navigation.Uri);

    protected override void OnParametersSet()
    {
        var normalized = TaskKey?.Trim();
        if (normalized?.Length is > 0 and <= 120)
        {
            Navigation.NavigateTo(Context.PathFor(PickingTaskScreenKind.Detail, normalized), replace: true);
        }
    }
}
