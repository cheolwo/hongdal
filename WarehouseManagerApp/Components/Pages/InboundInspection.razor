@page "/work/inbound/inspection"
@using Ssalddel.Contracts.Common.Inventory
@inject NavigationManager Navigation

<PageTitle>입고 검수 목록</PageTitle>

<InboundInspectionAccessFrame Title="입고 검수 목록"
                              Description="접근 가능한 입고 완료 상품을 검색하고 stable-ID 상세 화면으로 이동합니다.">
    <InboundInspectionListScreen Context="@Context" HomeHref="@WarehouseManagerRoutes.WorkBoard" />
</InboundInspectionAccessFrame>

@code {
    [SupplyParameterFromQuery(Name = "inboundItemId")]
    public long? InboundItemId { get; set; }

    private InboundInspectionNavigationContext Context
        => InboundInspectionNavigationContext.Parse(Navigation.Uri);

    protected override void OnParametersSet()
    {
        if (InboundItemId is > 0)
        {
            Navigation.NavigateTo(Context.PathFor(InboundInspectionScreenKind.Detail, InboundItemId.Value), replace: true);
        }
    }
}
