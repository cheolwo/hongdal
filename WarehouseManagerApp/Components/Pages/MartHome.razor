@page "/mart"

@inherits MvvmComponentBase<창고홈PageViewModel>

<PageTitle>알뜰살뜰 마트</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">알뜰살뜰 마트</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    도심 재고, 피킹, 포장과 기사 인계의 준비 상태를 책임별 서버 원장에서 확인합니다.
                </MudText>
            </MudStack>
            <MudButton Href="@WarehouseManagerRoutes.WorkBoard"
                       Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Warehouse">
                일반 창고
            </MudButton>
        </MudStack>

        <SsalddelMartWarehouseWorkflowHub ExpectedInboundsUrl="@WarehouseManagerRoutes.ExpectedInbounds"
                                          InventoryUrl="@WarehouseManagerRoutes.GeneralInventory"
                                          PickingUrl="@WarehouseManagerRoutes.MartPickingPacking" />

        <MudButton Href="@WarehouseManagerRoutes.MartWorkBoard"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   EndIcon="@Icons.Material.Filled.ChevronRight">
            업무 흐름 설명
        </MudButton>
    </MudStack>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!string.Equals(ViewModel.세션.운영ProfileCode, 창고운영ProfileCodes.마트도심, StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.세션.운영Profile설정(창고운영ProfileCodes.마트도심);
        }
    }
}
