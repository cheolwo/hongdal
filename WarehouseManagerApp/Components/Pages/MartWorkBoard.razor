@page "/mart/work-board"

<PageTitle>알뜰살뜰 마트 업무 흐름</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">알뜰살뜰 마트 업무 흐름</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    샘플 현황 대신 각 단계의 서버 원장 화면으로 이동하는 읽기 전용 허브입니다.
                </MudText>
            </MudStack>
            <MudButton Href="@WarehouseManagerRoutes.MartHome"
                       Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Storefront">
                마트 홈
            </MudButton>
        </MudStack>

        <SsalddelMartWarehouseWorkflowHub ExpectedInboundsUrl="@WarehouseManagerRoutes.ExpectedInbounds"
                                          InventoryUrl="@WarehouseManagerRoutes.GeneralInventory"
                                          PickingUrl="@WarehouseManagerRoutes.MartPickingPacking" />
    </MudStack>
</MudContainer>
