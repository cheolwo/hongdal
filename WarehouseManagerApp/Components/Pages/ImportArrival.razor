@page "/warehouse/import/arrival"
@inject 수입화물반입PageViewModel PageModel

<PageTitle>수입 화물 반입</PageTitle>

<WarehousePageShell Model="@PageModel"
                    Title="수입 화물 반입"
                    Description="선적·도착 예정과 보세 창고 반입 대상을 확인합니다."
                    Icon="@Icons.Material.Filled.MoveToInbox"
                    Color="Color.Info">
    <Actions>
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@PageModel.처리중"
                       OnClick="ReloadAsync">
                새로고침
            </MudButton>
            <MudButton Href="@WarehouseManagerRoutes.ImportCustoms"
                       Variant="Variant.Filled"
                       Color="Color.Info"
                       EndIcon="@Icons.Material.Filled.ChevronRight">
                통관 상태
            </MudButton>
        </MudStack>
    </Actions>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(PageModel.입고예정조회.오류메시지))
        {
            <MudAlert Severity="Severity.Error">@PageModel.입고예정조회.오류메시지</MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <HongdalOperationState ViewModel="@PageModel.입고예정조회" />
            <WarehouseExpectedInboundGrid @ref="_grid"
                                          ViewModel="@PageModel.입고예정조회"
                                          Color="Color.Info" />
        </MudPaper>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            @PageModel.원장물류.선택한경로안내
        </MudAlert>
    </ChildContent>
</WarehousePageShell>

@code {
    private WarehouseExpectedInboundGrid? _grid;

    protected override void OnInitialized() => EnsureProfile();

    private Task ReloadAsync() => _grid?.ReloadAsync() ?? Task.CompletedTask;

    private void EnsureProfile()
    {
        if (!string.Equals(PageModel.세션.운영ProfileCode, 창고운영ProfileCodes.보세수입, StringComparison.OrdinalIgnoreCase))
        {
            PageModel.세션.운영Profile설정(창고운영ProfileCodes.보세수입);
        }
    }
}
