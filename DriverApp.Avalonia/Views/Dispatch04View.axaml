<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="DriverApp.Avalonia.Views.Dispatch04View">
  <StackPanel Margin="24" Spacing="12">
	<TextBlock Text="04 배차" FontSize="28" FontWeight="Bold" />
	<Border Padding="16" CornerRadius="12">
	  <StackPanel Spacing="8">
		<TextBlock Text="배차 계획 신청/수정/취소" FontSize="18" FontWeight="SemiBold" />
		<TextBlock Text="배차 계획 상태를 메모리 기반으로 관리합니다." TextWrapping="Wrap" />
	  </StackPanel>
	</Border>
  </StackPanel>
</UserControl>
