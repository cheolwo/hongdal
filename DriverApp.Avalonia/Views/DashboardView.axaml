<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:DriverApp.Avalonia.ViewModels"
			 x:DataType="vm:DashboardViewModel"
			 x:Class="DriverApp.Avalonia.Views.DashboardView">
  <ScrollViewer>
	<StackPanel Margin="24" Spacing="16">
	  <TextBlock Text="대시보드" FontSize="28" FontWeight="Bold" />
	  <Border Padding="16" CornerRadius="12" Background="#F5F6FA">
		<StackPanel Spacing="8">
		  <TextBlock Text="{Binding Welcome}" FontSize="18" FontWeight="SemiBold" />
		  <TextBlock Text="01~04 업무 화면으로 이동해 기사 작업을 이어서 확인할 수 있습니다." TextWrapping="Wrap" />
		</StackPanel>
	  </Border>
	</StackPanel>
  </ScrollViewer>
</UserControl>
