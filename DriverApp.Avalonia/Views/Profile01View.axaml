<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="DriverApp.Avalonia.Views.Profile01View">
  <StackPanel Margin="24" Spacing="12">
	<TextBlock Text="01 프로필" FontSize="28" FontWeight="Bold" />
	<Border Padding="16" CornerRadius="12">
	  <StackPanel Spacing="8">
		<TextBlock Text="기사 프로필 등록/조회" FontSize="18" FontWeight="SemiBold" />
		<TextBlock Text="이 화면에서는 기사명, 연락처, 차량, 활동지역을 메모리 기반으로 보여줍니다." TextWrapping="Wrap" />
	  </StackPanel>
	</Border>
  </StackPanel>
</UserControl>
