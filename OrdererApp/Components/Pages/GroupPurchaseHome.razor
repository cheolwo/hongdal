@page "/group-purchase"
@using Ssalddel.Contracts.Common.Orderer

<PageTitle>먹거리 공동구매</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4 px-0">
    <GroupPurchaseScreenFrame CurrentScreen="GroupPurchaseScreenKind.Overview"
                              Eyebrow="GROUP PURCHASE · 1.0"
                              Title="먹거리 공동구매"
                              Description="내가 원하는 재료와 수량을 먼저 개별 원함으로 남기고, 같은 배송권·거래 문맥의 원함이 모일 때 공동 진행으로 이어집니다.">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Spacing="1">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Color="Color.Success" />
                        <MudText Typo="Typo.h6">처음이면 게임처럼 연습해 보세요</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        가상 이웃과 수량·보관·수령 조건을 맞춰봅니다. 로그인, 저장, 실제 주문·결제는 없습니다.
                    </MudText>
                </MudStack>
                <MudButton Href="@GroupPurchasePageRoutes.Practice"
                           Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.PlayArrow">
                    체험 공동구매 시작
                </MudButton>
            </MudStack>
        </MudPaper>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 group-purchase-route-card">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">재료와 수량 고르기</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            한 가지로 제한하지 않고 여러 재료를 골라 각 재료의 개별 원함을 따로 저장합니다.
                        </MudText>
                        <MudButton Href="@GroupPurchasePageRoutes.WishCreate"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true">
                            여러 재료 고르기
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 group-purchase-route-card">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">내 원함</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            재료별 희망 수량을 보고, 활성 원함을 직접 수정하거나 철회합니다.
                        </MudText>
                        <MudButton Href="@GroupPurchasePageRoutes.WishesRoot" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true">
                            내 원함 보기
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 group-purchase-route-card">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.GroupWork" Color="Color.Info" Size="Size.Large" />
                        <MudText Typo="Typo.h6">내 공동 진행</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            내 원함이 실제 포함된 집단의 공개 집계와 연결 원장만 확인합니다.
                        </MudText>
                        <MudButton Href="@GroupPurchasePageRoutes.GroupsRoot" Variant="Variant.Outlined" Color="Color.Info" FullWidth="true">
                            공동 진행 보기
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 group-purchase-route-card">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Info" Size="Size.Large" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">공급·가격·무역 준비</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Info">현재 1.5 검토 흐름</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            연결된 같이 수입 원장이 생긴 경우 공급·비용·HSK/HTS 후보와 포워더 회신을 읽습니다.
                        </MudText>
                        <MudButton Href="@GroupPurchasePageRoutes.GroupsRoot"
                                   Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   FullWidth="true">
                            연결된 준비 원장 찾기
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </GroupPurchaseScreenFrame>
</MudContainer>
