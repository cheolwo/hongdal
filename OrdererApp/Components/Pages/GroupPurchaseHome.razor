@page "/group-purchase"
@using Ssalddel.Contracts.Common.Orderer

<PageTitle>먹거리 공동구매</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4 px-0">
    <GroupPurchaseScreenFrame CurrentScreen="GroupPurchaseScreenKind.Overview"
                              Eyebrow="GROUP PURCHASE · 1.0"
                              Title="먹거리 공동구매"
                              Description="재료 카드를 보다가 집단화 버튼을 누르면 같은 배송권의 비구속 수요로 바로 묶입니다.">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 group-purchase-route-card">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">재료 자동집단화</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            재료 카드에서 한 번 클릭하면 기존 집단에 합류하거나 새 집단을 시작합니다. 근거 상세는 보조 화면으로 남깁니다.
                        </MudText>
                        <MudButton Href="@GroupPurchasePageRoutes.ProductsRoot"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true">
                            재료 카드 보기
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 group-purchase-route-card">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Info" Size="Size.Large" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">공급·가격·무역 준비</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Info">현재 1.5 검토 흐름</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            집단화 후보 재료에서 공식 기업 근거, 예상 원가와 한국 HSK·미국 HTSUS 후보를 확인합니다.
                        </MudText>
                        <MudButton Href="@GroupPurchasePageRoutes.ProductsRoot"
                                   Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   FullWidth="true">
                            1.5 검토 재료 선택
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </GroupPurchaseScreenFrame>
</MudContainer>
