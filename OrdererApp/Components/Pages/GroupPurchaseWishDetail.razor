@page "/group-purchase/wishes/{WishLedgerId}"
@using Ssalddel.Contracts.Common.Orderer

<PageTitle>내 원함 상세</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-0">
    <GroupPurchaseScreenFrame CurrentScreen="GroupPurchaseScreenKind.WishDetail"
                              Eyebrow="주문자 업무 · 02.04"
                              Title="내 원함 상세"
                              Description="개별 의사와 동일 상태를 원함 기준으로 확인합니다."
                              BackHref="@GroupPurchasePageRoutes.WishesRoot"
                              BoundaryMessage="본인 원함만 조회합니다. 철회는 비구속 원함을 닫는 동작이며 별도 주문이나 계약을 취소하지 않습니다.">
        <GroupPurchaseOrdererAccessGate LoginTitle="원함 상세 로그인"
                                        LoginDescription="본인 원함 원장을 보려면 로그인해 주세요.">
            <Authorized>
                <GroupPurchaseWishDetailScreen WishLedgerId="@WishLedgerId" />
            </Authorized>
        </GroupPurchaseOrdererAccessGate>
    </GroupPurchaseScreenFrame>
</MudContainer>

@code {
    [Parameter] public string WishLedgerId { get; set; } = string.Empty;
}
