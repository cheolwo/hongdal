@page "/group-purchase/wishes/{WishLedgerId}/edit"
@using Ssalddel.Contracts.Common.Orderer

<PageTitle>내 원함 수량 수정</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4 px-0">
    <GroupPurchaseScreenFrame CurrentScreen="GroupPurchaseScreenKind.WishEdit"
                              Eyebrow="OWNER CONTROL · 1.0"
                              Title="희망 수량 수정"
                              Description="공동성보다 먼저 보존된 내 개별 원함의 희망 수량을 내가 다시 정합니다."
                              BackHref="@GroupPurchasePageRoutes.WishDetailFor(WishLedgerId)"
                              BoundaryMessage="같은 비구속 원함의 수량만 교체합니다. 거래 문맥을 바꾸려면 기존 원함을 철회하고 새 원함으로 명시적으로 등록해야 합니다.">
        <GroupPurchaseOrdererAccessGate LoginTitle="원함 수정 로그인"
                                        LoginDescription="본인이 저장한 활성 원함의 수량을 바꾸려면 로그인해 주세요.">
            <Authorized>
                <GroupPurchaseWishEditScreen WishLedgerId="@WishLedgerId" />
            </Authorized>
        </GroupPurchaseOrdererAccessGate>
    </GroupPurchaseScreenFrame>
</MudContainer>

@code {
    [Parameter] public string WishLedgerId { get; set; } = string.Empty;
}
