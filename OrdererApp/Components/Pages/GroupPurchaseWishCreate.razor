@page "/group-purchase/wishes/new"
@using Ssalddel.Contracts.Common.Orderer
@inject GroupPurchaseCatalogViewModel Catalog
@inject GroupPurchaseWishBatchViewModel WishBatch
@inject 주문자앱인증ViewModel Authentication

<PageTitle>여러 재료 원함 등록</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-0">
    <GroupPurchaseScreenFrame CurrentScreen="GroupPurchaseScreenKind.WishCreate"
                              Eyebrow="주문자 업무 · 02.03"
                              Title="여러 재료 원함 등록"
                              Description="한 품목으로 제한하지 않고 재료별 희망 수량을 기록합니다."
                              BackHref="@GroupPurchasePageRoutes.ProductsRoot"
                              BoundaryMessage="저장 결과는 비구속 원함입니다. 결제·주문·계약·수입·운송을 실행하지 않으며 국제운송 방식도 고정하지 않습니다.">
        @if (Authentication.처리중 && !Authentication.초기화됨)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.body2">저장된 주문자 로그인과 배송권을 확인하고 있습니다.</MudText>
            </MudStack>
        }
        else if (!Authentication.로그인됨)
        {
            <Ssalddel공통로그인Panel 제목="내 원함 저장 로그인"
                                 설명="재료 선택은 공개입니다. 여러 재료의 개별 원함을 내 원장으로 저장할 때만 로그인합니다."
                                 상태메시지="@Authentication.오류메시지"
                                 상태Severity="@(Authentication.오류발생 ? Severity.Error : Severity.Info)"
                                 일반로그인표시="true"
                                 소셜로그인표시="false"
                                 일반로그인버튼텍스트="로그인하고 원함 저장"
                                 IsBusy="@Authentication.처리중"
                                 Elevation="0"
                                 OnPasswordLogin="LoginAsync" />
        }
        else if (WishBatch.DeliveryScope is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                주문자 배송권이 아직 없습니다. 가입 또는 온보딩에서 배송권을 설정한 뒤 여러 재료를 저장해 주세요.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                <b>@WishBatch.DeliveryScope.DisplayName</b> 배송권에서 재료별 자동집단을 각각 찾습니다.
            </MudAlert>
            <GroupPurchaseWishBatchPanel ViewModel="WishBatch" />
        }
    </GroupPurchaseScreenFrame>
</MudContainer>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Authentication.초기화됨)
        {
            await Authentication.복원Async();
        }
        WishBatch.Initialize(Catalog.ProductCards);
        WishBatch.PrepareForCurrentUser();
    }

    private async Task LoginAsync(공통로그인요청 request)
    {
        if (await Authentication.로그인Async(request.UserNameOrEmail, request.Password))
        {
            WishBatch.PrepareForCurrentUser();
        }
    }
}
