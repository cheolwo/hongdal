@page "/food/mart"
@inject NavigationManager Navigation

<PageTitle>알뜰살뜰 마트 상품</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">알뜰살뜰 마트 상품</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                내부 창고 원장과 분리된 공개 판매 상품과 마지막 투영 시각 기준의 판매 가능 수량을 확인합니다.
            </MudText>
        </MudStack>

        <OrdererMartCatalogWorkspace ProductId="@ProductId"
                                     OrderRequestBasePath="@OrdererRoutes.MartOrderRequest"
                                     ProductSelected="OnProductSelectedAsync" />
    </MudStack>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public long? ProductId { get; set; }

    private Task OnProductSelectedAsync(long? productId)
    {
        var target = productId.HasValue
            ? $"/food/mart?productId={productId.Value}"
            : "/food/mart";
        Navigation.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }
}
