@page "/food/mart"
@inject NavigationManager Navigation
@using Ssalddel.Contracts.Common.Mart

<PageTitle>알뜰살뜰 마트 상품</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MartProductAccessFrame Context="@Context"
                            CurrentScreen="MartProductScreenKind.List"
                            Eyebrow="LIST"
                            Title="알뜰살뜰 마트 공개 상품"
                            Description="공개된 상품과 마지막 투영 시각 기준 판매 가능 수량을 검색하고 stable-ID 상세로 이동합니다."
                            HomeHref="@OrdererRoutes.Food">
        <MartProductListScreen Context="@Context" ContextChanged="OnContextChangedAsync" />
    </MartProductAccessFrame>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public long? LegacyProductId { get; set; }

    private MartProductNavigationContext Context
        => MartProductNavigationContext.Parse(Navigation.Uri);

    protected override void OnParametersSet()
    {
        if (LegacyProductId is > 0)
        {
            Navigation.NavigateTo(Context.PathFor(MartProductScreenKind.Detail, LegacyProductId), replace: true);
        }
    }

    private Task OnContextChangedAsync(MartProductNavigationContext context)
    {
        Navigation.NavigateTo(context.PathFor(MartProductScreenKind.List), replace: true);
        return Task.CompletedTask;
    }
}
