@page "/"

<PageTitle>주문자 홈 · 살뜰 주문</PageTitle>

<RolePurposeJourney RoleName="주문자"
                    Title="원함을 실제 주문 근거까지 이어갑니다"
                    Description="재료를 고른 뒤 원함·집단·주문 원장을 같은 흐름에서 확인합니다."
                    Steps="@PurposeSteps"
                    BoundaryNote="원함 등록과 주문자 집단 참여는 비구속 상태입니다. 결제·계약·수입 실행은 별도 확인 뒤 진행됩니다." />

<OrdererMobileHomeScreen ScreenCode="02.01" />

@code {
    private static readonly IReadOnlyList<RolePurposeJourneyStep> PurposeSteps =
    [
        new("시작할 일", "재료 후보 확인", "공개 근거와 가격을 보고 필요한 재료를 고릅니다.", OrdererRoutes.GroupPurchaseProducts, true),
        new("진행 확인", "내 원함·주문자 집단", "등록한 원함과 함께 모이는 주문자 상태를 확인합니다.", OrdererRoutes.GroupPurchaseWishes),
        new("확인 필요", "공동 진행 조건", "수량·비용·일정과 아직 합의되지 않은 조건을 봅니다.", OrdererRoutes.GroupPurchaseGroups),
        new("완료 근거", "주문·수입 원장", "명시적으로 확정된 주문과 수입 기록을 다시 조회합니다.", OrdererRoutes.Orders)
    ];
}
