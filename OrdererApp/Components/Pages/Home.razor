@page "/"

<PageTitle>주문자 홈 · 살뜰 주문</PageTitle>

<RolePurposeJourney RoleName="주문자"
                    Title="내 개별주문에서 공동주문까지 이어갑니다"
                    Description="커뮤니티에서 발견한 필요를 내 원장에 먼저 남기고, 동의한 주문의 공동 조건과 진행을 확인합니다."
                    Steps="@PurposeSteps"
                    BoundaryNote="0.5 개별주문 의향과 1.0 공동주문 참여는 구분됩니다. 결제·계약·수입 실행은 별도 확인 뒤 진행됩니다." />

<OrdererMobileHomeScreen ScreenCode="02.01" />

<AppContextImageWall AppPackId="orderer"
                     Title="생산지와 장보기 이야기" />

@code {
    private static readonly IReadOnlyList<RolePurposeJourneyStep> PurposeSteps =
    [
        new("시작할 일", "과일·채소 가격 탐색", "공식 관측값을 같은 단위로 비교하고 필요한 재료를 고릅니다.", OrdererRoutes.ProducePriceComparison, true),
        new("재료 선택", "재료 후보 확인", "가격과 공개 근거를 함께 보고 필요한 재료를 고릅니다.", OrdererRoutes.GroupPurchaseProducts),
        new("원함 기록", "개별주문 의향 확인", "필요한 재료와 수량을 내 원장에 비구속 상태로 남깁니다.", OrdererRoutes.GroupPurchaseWishCreate),
        new("진행 확인", "내 개별주문", "커뮤니티App과 같은 원장에서 저장·철회 상태를 확인합니다.", OrdererRoutes.GroupPurchaseWishes),
        new("확인 필요", "공동주문 조건", "동의한 주문끼리 모인 수량·비용·일정과 예상 절감 근거를 봅니다.", OrdererRoutes.GroupPurchaseGroups),
        new("완료 근거", "주문·수입 원장", "명시적으로 확정된 주문과 수입 기록을 다시 조회합니다.", OrdererRoutes.Orders)
    ];
}
