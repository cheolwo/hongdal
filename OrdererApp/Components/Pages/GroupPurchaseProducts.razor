@page "/group-purchase/products"
@using Ssalddel.Contracts.Common.Orderer
@inherits MvvmComponentBase<주문자재료후보PageViewModel>

<PageTitle>재료 자동집단화</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-0">
    <GroupPurchaseScreenFrame CurrentScreen="GroupPurchaseScreenKind.ProductList"
                              Eyebrow="주문자 업무 · 02.02"
                              Title="재료 후보 목록"
                              Description="공동데이터 근거가 있는 여러 재료 후보를 탐색합니다."
                              BackHref="@GroupPurchasePageRoutes.Root">
        <MudButton Href="@GroupPurchasePageRoutes.WishCreate" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mb-3">여러 재료 한 번에 선택</MudButton>
        @if (ViewModel.Authentication.처리중 && !ViewModel.Authentication.초기화됨)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.body2">저장된 주문자 로그인과 배송권을 확인하고 있습니다.</MudText>
            </MudStack>
        }
        else if (!ViewModel.Authentication.로그인됨)
        {
            <Ssalddel공통로그인Panel 제목="카드 집단화 로그인"
                                 설명="재료 탐색은 공개입니다. 비구속 수요를 내 이름으로 저장하고 철회할 때만 로그인합니다."
                                 상태메시지="@ViewModel.Authentication.오류메시지"
                                 상태Severity="@ViewModel.AuthenticationSeverity"
                                 일반로그인표시="true"
                                 소셜로그인표시="false"
                                 일반로그인버튼텍스트="로그인하고 카드에서 집단화"
                                 IsBusy="@ViewModel.Authentication.처리중"
                                 Elevation="0"
                                 Class="pa-3 mb-3"
                                 OnPasswordLogin="ViewModel.LoginAsync" />
        }
        else if (ViewModel.AutoGrouping.DeliveryScope is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                주문자 배송권이 아직 없습니다. 가입 또는 온보딩에서 배송권을 한 번 설정하면 이후에는 카드 클릭만으로 집단화됩니다.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                <b>@ViewModel.AutoGrouping.ScopeDisplayName</b> 배송권으로 자동집단을 찾습니다. 버튼 클릭은 비구속 참여이며 결제나 주문 확정이 아닙니다.
            </MudAlert>
        }

        <GroupPurchaseProductCatalogPanel Products="ViewModel.Catalog.ProductCards"
                                          SelectedProductId="ViewModel.Catalog.SelectedProductId"
                                          ActionLabel="상품 근거 보기"
                                          CanAutoGroup="ViewModel.AutoGrouping.CanAutoGroup"
                                          GroupingStateResolver="ViewModel.AutoGrouping.StateFor"
                                          SuggestedQuantityResolver="ViewModel.AutoGrouping.SuggestedQuantityFor"
                                          GroupRequested="ViewModel.JoinGroupAsync"
                                          GroupWithdrawRequested="ViewModel.WithdrawGroupAsync"
                                          ProductSelected="ViewModel.OpenProductAsync" />
    </GroupPurchaseScreenFrame>
</MudContainer>

@code {
    protected override Task OnInitializedAsync()
        => ViewModel.초기화Async();
}
