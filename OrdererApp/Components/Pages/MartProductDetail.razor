@page "/food/mart/products/{ProductId:long}"
@inject NavigationManager Navigation
@using Ssalddel.Contracts.Common.Mart

<PageTitle>마트 상품 상세</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MartProductAccessFrame Context="@Context"
                            CurrentScreen="MartProductScreenKind.Detail"
                            ProductId="@ProductId"
                            Eyebrow="DETAIL"
                            Title="마트 공개 상품 상세"
                            Description="stable product ID 한 건의 공개 설명·판매 가능 수량·구매 근거와 후기를 읽기 전용으로 확인합니다."
                            HomeHref="@OrdererRoutes.Food">
        <MartProductDetailScreen ProductId="@ProductId" Context="@Context" />
    </MartProductAccessFrame>
</MudContainer>

@code {
    [Parameter] public long ProductId { get; set; }

    private MartProductNavigationContext Context
        => MartProductNavigationContext.Parse(Navigation.Uri);
}
