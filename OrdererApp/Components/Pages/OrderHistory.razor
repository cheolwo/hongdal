@page "/orders"
@using OrdererApp.Components.Orders
@inject NavigationManager Navigation

<PageTitle>내 주문</PageTitle>

<OrdererIndividualOrderLedgerHistoryScreen OrderSelected="OpenOrderAsync" />

@code {
    [SupplyParameterFromQuery(Name = "orderNo")]
    public string? OrderNo { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(OrderNo))
        {
            Navigation.NavigateTo(
                $"/orders/food?orderNo={Uri.EscapeDataString(OrderNo.Trim())}",
                replace: true);
        }
    }

    private Task OpenOrderAsync(string orderLedgerId)
    {
        Navigation.NavigateTo($"/orders/{Uri.EscapeDataString(orderLedgerId.Trim())}");
        return Task.CompletedTask;
    }
}
