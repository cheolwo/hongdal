@page "/food/mart/order"
@inject NavigationManager Navigation

<PageTitle>알뜰살뜰 마트 주문 요청</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">알뜰살뜰 마트 주문 요청</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                선택한 공개 상품의 비구속 주문 의향을 저장하고 같은 요청 ID를 서버에서 다시 확인합니다.
            </MudText>
        </MudStack>

        <OrdererMartOrderRequestWorkspace ProductId="@ProductId"
                                          RequestId="@RequestId"
                                          CatalogHref="@OrdererRoutes.Mart"
                                          RequestSelected="OnRequestSelectedAsync" />
    </MudStack>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public long? ProductId { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public Guid? RequestId { get; set; }

    private Task OnRequestSelectedAsync(Guid? requestId)
    {
        var target = requestId.HasValue
            ? $"{OrdererRoutes.MartOrderRequest}?requestId={requestId.Value:D}"
            : OrdererRoutes.MartOrderRequest;
        Navigation.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }
}
