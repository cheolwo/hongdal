@page "/group-purchase"
@using Hongdal.Contracts.Common.Orderer
@inject IGroupPurchaseShipmentTrackingService ShipmentTrackingService

<PageTitle>먹거리 공동주문</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4 group-purchase-page">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">먹거리 공동주문</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    HS 코드상 식품으로 분류되는 상품 카드를 보고, 주문자가 직접 공동 주문 집단 개설을 신청합니다.
                </MudText>
            </MudStack>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">HS 식품 코드 우선</MudChip>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <MudAlert Severity="@statusSeverity" Variant="Variant.Outlined">@statusMessage</MudAlert>
        }

        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">해외 공동구매 화물 위치 조회</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            플랫폼에 등록된 문서관리번호로 B/L 또는 AWB 기준 선적 상태와 공개 위치 이력을 확인합니다.
                        </MudText>
                    </MudStack>
                    @if (shipmentTracking is not null)
                    {
                        <MudChip T="string" Color="@ShipmentStatusColor(shipmentTracking.CurrentStatusCode)" Variant="Variant.Filled">
                            @ShipmentStatusLabel(shipmentTracking.CurrentStatusCode)
                        </MudChip>
                    }
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudTextField T="string"
                                  Label="문서관리번호"
                                  @bind-Value="shipmentDocumentManagementNumber"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="flex-grow-1" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               Disabled="@isShipmentTrackingLoading"
                               OnClick="LookupShipmentTracking">
                        조회
                    </MudButton>
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(shipmentTrackingMessage))
                {
                    <MudAlert Severity="@shipmentTrackingSeverity" Variant="Variant.Outlined">@shipmentTrackingMessage</MudAlert>
                }

                @if (shipmentTracking is not null)
                {
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">현재 위치</MudText>
                                <MudText Typo="Typo.subtitle1">@shipmentTracking.CurrentLocationSummary</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">운송 문서</MudText>
                                <MudText Typo="Typo.subtitle1">@TransportDocumentLabel(shipmentTracking.TransportDocumentType) @shipmentTracking.TransportDocumentNumber</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">도착 예정</MudText>
                                <MudText Typo="Typo.subtitle1">@DateLabel(shipmentTracking.EstimatedArrivalAtUtc)</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="2">
                        @foreach (var item in shipmentTracking.Events.OrderByDescending(x => x.OccurredAtUtc))
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle2">@item.DisplayName</MudText>
                                        <MudText Typo="Typo.body2">@item.LocationSummary</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.SourcePartyCode</MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@DateLabel(item.OccurredAtUtc)</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <MudGrid>
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                    <MudStack Spacing="3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">HS 먹거리 상품 카드</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                먼저 먹거리 수요가 모이기 쉬운 상품부터 공동주문 후보로 노출합니다.
                            </MudText>
                        </MudStack>

                        @foreach (var product in ProductCards)
                        {
                            var plan = PlanProduct(product);
                            <MudPaper Elevation="0" Outlined="true" Class="@ProductCardClass(product)">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@product.ProductName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">HS @product.HsCode · @product.HsDisplayName</MudText>
                                        </MudStack>
                                        <MudChip T="string" Size="Size.Small" Color="@PriorityColor(plan.ActivationPriority)">
                                            @PriorityLabel(plan.ActivationPriority)
                                        </MudChip>
                                    </MudStack>

                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@TemperatureLabel(product.TemperatureCode)</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@product.ExpectedLogisticsMode</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@($"{product.SuggestedTargetQuantityKg:N0}kg 목표")</MudChip>
                                    </MudStack>

                                    <MudText Typo="Typo.body2">@plan.Summary</MudText>

                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Groups"
                                               OnClick="@(() => SelectProduct(product.ProductCardId))">
                                        이 상품으로 집단 개설 신청
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudStack Spacing="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h5">@SelectedProduct.ProductName 공동 주문 집단</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        개설 신청이 승인되면 같은 주문자 집단 범위 안의 다른 사용자들이 참여할 수 있습니다.
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Color="@PriorityColor(CurrentApplicationPlan.IsFoodFocusedCandidate ? GroupPurchaseActivationPriorityCode.ColdChainFoodFocused : GroupPurchaseActivationPriorityCode.Normal)"
                                         Variant="Variant.Filled">
                                    @StatusLabel(CurrentApplicationPlan.SuggestedStatus)
                                </MudChip>
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">HS 코드</MudText>
                                        <MudText Typo="Typo.h6">@SelectedProduct.HsCode</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">예상 물류</MudText>
                                        <MudText Typo="Typo.h6">@SelectedProduct.ExpectedLogisticsMode</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">예상 단가</MudText>
                                        <MudText Typo="Typo.h6">@Money(SelectedProduct.ExpectedUnitPrice)</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                                <MudStack Spacing="3">
                                    <MudText Typo="Typo.h6">집단 개설 신청</MudText>
                                    <MudTextField T="string" Label="주문자 집단 범위" @bind-Value="ordererGroupScopeName" Variant="Variant.Outlined" />
                                    <MudNumericField T="decimal" Label="내 구매 의향 수량(kg)" @bind-Value="desiredQuantityKg" Min="1" Step="1M" Variant="Variant.Outlined" />
                                    <MudNumericField T="decimal" Label="희망 단가" @bind-Value="desiredUnitPrice" Min="1" Step="100M" Variant="Variant.Outlined" />
                                    <MudTextField T="string" Label="개설 신청 메모" @bind-Value="requestMemo" Lines="3" Variant="Variant.Outlined" />
                                    <MudCheckBox T="bool"
                                                 @bind-Value="nonBindingAgreementAccepted"
                                                 Label="이 신청은 구매 확정이 아니라 공동 주문 집단 개설 의향임을 확인합니다."
                                                 Color="Color.Primary" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Send"
                                               Disabled="@(!CurrentApplicationPlan.CanSubmit)"
                                               OnClick="SubmitOpeningApplication">
                                        개설 승인 요청
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                                <MudStack Spacing="3">
                                    <MudText Typo="Typo.h6">승인 후 참여 흐름</MudText>
                                    <MudList T="string" Dense="true">
                                        <MudListItem Icon="@Icons.Material.Filled.Inventory2">
                                            상품 카드와 HS 식품 코드 검토
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.Map">
                                            주문자 집단 범위 승인
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.GroupAdd">
                                            공동 주문 집단 생성
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.ShoppingCart">
                                            다른 주문자의 구매 의향 참여
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.AcUnit">
                                            냉장/냉동 보관 및 운송 검토
                                        </MudListItem>
                                    </MudList>

                                    <MudDivider />

                                    <MudText Typo="Typo.subtitle2">운영 검토 항목</MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var step in CurrentApplicationPlan.RequiredAdminReviewSteps)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@step</MudChip>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">공동구매 지급 일정</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        전액 선결제 대신 상차, 하차, 분배 확인 시점에 맞춰 나누어 지급합니다.
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                                    @PaymentPlan.Summary
                                </MudChip>
                            </MudStack>

                            <MudGrid>
                                @foreach (var line in PaymentPlan.Lines)
                                {
                                    <MudItem xs="12" md="4">
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.subtitle2">@line.DisplayName</MudText>
                                                    <MudChip T="string" Size="Size.Small" Color="@PaymentStatusColor(line.Status)">
                                                        @PaymentStatusLabel(line.Status)
                                                    </MudChip>
                                                </MudStack>
                                                <MudText Typo="Typo.h6">@Money(line.Amount)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@line.DueCondition</MudText>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

<style>
    .group-purchase-page .product-card {
        border-radius: 8px;
        transition: border-color 120ms ease, background-color 120ms ease;
    }

    .group-purchase-page .product-card--selected {
        border-color: var(--mud-palette-primary);
        background: color-mix(in srgb, var(--mud-palette-surface) 88%, var(--mud-palette-primary) 12%);
    }
</style>

@code {
    private readonly List<HsFoodGroupPurchaseProductCard> ProductCards =
    [
        new(
            ProductCardId: "hs-food-0203-pork-frozen",
            ProductName: "냉동 삼겹살",
            HsCode: "0203.29",
            HsDisplayName: "돼지고기 냉동 기타",
            TemperatureCode: GroupPurchaseTemperatureCode.Frozen,
            ExpectedLogisticsMode: GroupPurchaseLogisticsModeCode.Fcl,
            SuggestedTargetQuantityKg: 12000m,
            ExpectedUnitPrice: 8500m),
        new(
            ProductCardId: "hs-food-1602-prepared-meat",
            ProductName: "가공육 세트",
            HsCode: "1602.49",
            HsDisplayName: "조제 또는 저장 처리한 육류",
            TemperatureCode: GroupPurchaseTemperatureCode.Chilled,
            ExpectedLogisticsMode: GroupPurchaseLogisticsModeCode.Lcl,
            SuggestedTargetQuantityKg: 3000m,
            ExpectedUnitPrice: 7200m),
        new(
            ProductCardId: "hs-food-2106-prepared-food",
            ProductName: "간편식 소스",
            HsCode: "2106.90",
            HsDisplayName: "기타 조제 식료품",
            TemperatureCode: GroupPurchaseTemperatureCode.Ambient,
            ExpectedLogisticsMode: GroupPurchaseLogisticsModeCode.DomesticBulk,
            SuggestedTargetQuantityKg: 1500m,
            ExpectedUnitPrice: 3900m,
            RequiresImportFoodReview: true,
            RequiresMfdsManufacturerReview: true)
    ];

    private string selectedProductCardId = "hs-food-0203-pork-frozen";
    private string ordererGroupScopeKey = "road-address-level-2:gyeonggi-suwon-yeongtong";
    private string ordererGroupScopeName = "경기도 수원시 영통구";
    private decimal desiredQuantityKg = 20m;
    private decimal desiredUnitPrice = 8500m;
    private string requestMemo = "같은 지역 주문자들과 함께 먼저 수요를 모아보고 싶습니다.";
    private bool nonBindingAgreementAccepted;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private string shipmentDocumentManagementNumber = "HD-GP-IMPORT-2026-0001";
    private GroupPurchaseOverseasShipmentPublicDto? shipmentTracking;
    private bool isShipmentTrackingLoading;
    private string? shipmentTrackingMessage;
    private Severity shipmentTrackingSeverity = Severity.Info;

    private HsFoodGroupPurchaseProductCard SelectedProduct
        => ProductCards.First(x => x.ProductCardId == selectedProductCardId);

    private OrdererGroupOpeningApplicationPlan CurrentApplicationPlan
        => OrdererGroupOpeningApplicationPlanner.Plan(CreateApplicationDraft());

    private GroupPurchasePaymentMilestonePlan PaymentPlan
        => GroupPurchasePaymentMilestonePlanner.Plan(new GroupPurchasePaymentMilestoneDraft(
            GroupPurchaseId: SelectedProduct.ProductCardId,
            OrdererId: "demo-orderer",
            TotalAmount: desiredQuantityKg * desiredUnitPrice,
            IsPickupCompleted: true,
            IsDropoffCompleted: false,
            DistributionConfirmationRate: 0m));

    private void SelectProduct(string productCardId)
    {
        selectedProductCardId = productCardId;
        desiredQuantityKg = SelectedProduct.TemperatureCode == GroupPurchaseTemperatureCode.Frozen ? 20m : 5m;
        desiredUnitPrice = SelectedProduct.ExpectedUnitPrice;
        statusMessage = null;
    }

    private void SubmitOpeningApplication()
    {
        var plan = CurrentApplicationPlan;
        if (!plan.CanSubmit)
        {
            statusSeverity = Severity.Warning;
            statusMessage = "비구속 신청 동의와 HS 식품 코드 확인이 필요합니다.";
            return;
        }

        statusSeverity = Severity.Success;
        statusMessage = $"{SelectedProduct.ProductName} 공동 주문 집단 개설 신청이 승인 대기 상태로 접수되었습니다. 승인되면 다른 주문자들이 참여할 수 있습니다.";
    }

    private async Task LookupShipmentTracking()
    {
        if (string.IsNullOrWhiteSpace(shipmentDocumentManagementNumber))
        {
            shipmentTracking = null;
            shipmentTrackingSeverity = Severity.Warning;
            shipmentTrackingMessage = "문서관리번호를 입력해 주세요.";
            return;
        }

        isShipmentTrackingLoading = true;
        shipmentTrackingMessage = null;

        try
        {
            shipmentTracking = await ShipmentTrackingService.LookupAsync(shipmentDocumentManagementNumber);
            if (shipmentTracking is null)
            {
                shipmentTrackingSeverity = Severity.Warning;
                shipmentTrackingMessage = "해당 문서관리번호로 조회 가능한 해외 공동구매 선적 정보가 없습니다.";
                return;
            }

            shipmentTrackingSeverity = Severity.Success;
            shipmentTrackingMessage = $"{shipmentTracking.ProductSummary} 선적 정보를 조회했습니다.";
        }
        finally
        {
            isShipmentTrackingLoading = false;
        }
    }

    private ColdChainFoodGroupPurchasePlan PlanProduct(HsFoodGroupPurchaseProductCard product)
    {
        var draft = new ColdChainFoodGroupPurchaseDraft(
            ProductName: product.ProductName,
            OrdererGroupScopeKey: ordererGroupScopeKey,
            TargetQuantityKg: product.SuggestedTargetQuantityKg,
            CurrentIntentQuantityKg: 0m,
            TargetUnitPrice: product.ExpectedUnitPrice,
            HsCode: product.HsCode,
            TemperatureCode: product.TemperatureCode,
            LogisticsMode: product.ExpectedLogisticsMode,
            RequiresImportFoodReview: product.RequiresImportFoodReview,
            RequiresMfdsManufacturerReview: product.RequiresMfdsManufacturerReview,
            RequiresColdStorage: product.TemperatureCode is GroupPurchaseTemperatureCode.Frozen or GroupPurchaseTemperatureCode.Chilled);

        return ColdChainFoodGroupPurchasePlanner.Plan(draft);
    }

    private OrdererGroupOpeningApplicationDraft CreateApplicationDraft()
    {
        return new OrdererGroupOpeningApplicationDraft(
            ApplicantOrdererId: "demo-orderer",
            ProductCard: SelectedProduct,
            OrdererGroupScopeKey: ordererGroupScopeKey,
            OrdererGroupScopeName: ordererGroupScopeName,
            DesiredQuantityKg: desiredQuantityKg,
            DesiredUnitPrice: desiredUnitPrice,
            NonBindingAgreementAccepted: nonBindingAgreementAccepted,
            RequestMemo: requestMemo);
    }

    private string ProductCardClass(HsFoodGroupPurchaseProductCard product)
        => product.ProductCardId == selectedProductCardId
            ? "pa-3 product-card product-card--selected"
            : "pa-3 product-card";

    private static string Money(decimal value) => $"{value:N0}원";

    private static string TemperatureLabel(string value)
        => value switch
        {
            GroupPurchaseTemperatureCode.Frozen => "냉동",
            GroupPurchaseTemperatureCode.Chilled => "냉장",
            GroupPurchaseTemperatureCode.Ambient => "상온",
            _ => value
        };

    private static string PriorityLabel(string value)
        => value switch
        {
            GroupPurchaseActivationPriorityCode.ColdChainFoodFocused => "냉동/냉장 우선",
            GroupPurchaseActivationPriorityCode.FoodFocused => "먹거리 우선",
            _ => "일반 후보"
        };

    private static Color PriorityColor(string value)
        => value switch
        {
            GroupPurchaseActivationPriorityCode.ColdChainFoodFocused => Color.Success,
            GroupPurchaseActivationPriorityCode.FoodFocused => Color.Primary,
            _ => Color.Default
        };

    private static string PaymentStatusLabel(string value)
        => value switch
        {
            GroupPurchasePaymentMilestoneStatusCode.Requestable => "요청 가능",
            GroupPurchasePaymentMilestoneStatusCode.Paid => "지급 완료",
            GroupPurchasePaymentMilestoneStatusCode.Blocked => "대기",
            _ => "대기"
        };

    private static Color PaymentStatusColor(string value)
        => value switch
        {
            GroupPurchasePaymentMilestoneStatusCode.Requestable => Color.Primary,
            GroupPurchasePaymentMilestoneStatusCode.Paid => Color.Success,
            GroupPurchasePaymentMilestoneStatusCode.Blocked => Color.Default,
            _ => Color.Default
        };

    private static string StatusLabel(string value)
        => value switch
        {
            OrdererGroupOpeningApplicationStatusCode.PendingApproval => "승인 대기",
            OrdererGroupOpeningApplicationStatusCode.ApprovedGroupReady => "집단 생성",
            OrdererGroupOpeningApplicationStatusCode.Rejected => "반려",
            _ => "작성 중"
        };

    private static string TransportDocumentLabel(string value)
        => value switch
