@page "/group-purchase"

<PageTitle>수입 공동구매 의향</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4 group-purchase-page">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">수입 공동구매 의향</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    화주가 수입을 검토 중인 상품에 주문자가 구매 의향을 남겨 수입 수량, 가격, 통관 이후 판매 준비를 함께 가늠합니다.
                </MudText>
            </MudStack>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">구매 확정 전 수요 확인</MudChip>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <MudAlert Severity="@statusSeverity" Variant="Variant.Outlined">@statusMessage</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                    <MudStack Spacing="3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">진행 중인 수요 확인</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                현재는 샘플 데이터입니다. 이후 커뮤니티 게시글과 FCL/LCL 판단 초안이 서버에서 연결됩니다.
                            </MudText>
                        </MudStack>

                        @foreach (var campaign in Campaigns)
                        {
                            <MudPaper Elevation="0"
                                      Outlined="true"
                                      Class="@CampaignCardClass(campaign)"
                                      @onclick="@(() => SelectCampaign(campaign.Id))">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudText Typo="Typo.subtitle1">@campaign.ProductName</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@campaign.Color">@campaign.Status</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@campaign.ShipperAlias · @campaign.ExpectedArrival</MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@campaign.LogisticsMode</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">@campaign.CustomsMemo</MudChip>
                                    </MudStack>
                                    <div class="intent-meter">
                                        <div style="@ProgressStyle(campaign)"></div>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        의향 @campaign.InterestedQuantity:N0개 / 목표 @campaign.TargetQuantity:N0개
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudStack Spacing="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h5">@SelectedCampaign.ProductName</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SelectedCampaign.Summary</MudText>
                                </MudStack>
                                <MudChip T="string" Color="@SelectedCampaign.Color" Variant="Variant.Filled">@SelectedCampaign.Status</MudChip>
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="12" sm="4">@Metric("예상 판매가", Money(SelectedCampaign.TargetUnitPrice), Color.Success)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("수요 달성률", $"{SelectedCampaign.ProgressRate:P0}", Color.Info)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("수입 판단", SelectedCampaign.ImportDecisionHint, Color.Primary)</MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <HongdalSensitiveDisclosureList Title="공동구매 의향 상세"
                                                    Summary="@SelectedCampaign.LogisticsMode"
                                                    RelatedParties="주문자 · 화주 · 배송대행 담당자 · 관세사 · 국내 배송 담당자"
                                                    Icon="@Icons.Material.Filled.Groups"
                                                    Color="@SelectedCampaign.Color"
                                                    PrivacyHint="구매 의향은 수입 판단을 돕는 참고 정보입니다. 실제 결제, 개인정보, 배송지는 확정 단계에서 별도로 확인합니다.">
                        <MudExpansionPanel Text="상품/수입 정보" Expanded="true">
                            <HongdalSensitiveInfoRow Label="상품" Value="@SelectedCampaign.ProductName" />
                            <HongdalSensitiveInfoRow Label="화주" Value="@SelectedCampaign.ShipperAlias" />
                            <HongdalSensitiveInfoRow Label="예상 입고" Value="@SelectedCampaign.ExpectedArrival" />
                            <HongdalSensitiveInfoRow Label="수입 판단" Value="@SelectedCampaign.ImportDecisionHint" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="물류/통관 정보">
                            <HongdalSensitiveInfoRow Label="운송 방식" Value="@SelectedCampaign.LogisticsMode" />
                            <HongdalSensitiveInfoRow Label="통관 메모" Value="@SelectedCampaign.CustomsMemo" />
                            <HongdalSensitiveInfoRow Label="HS 검토" Value="@SelectedCampaign.HsReviewStatus" />
                            <HongdalSensitiveInfoRow Label="국내 배송" Value="@SelectedCampaign.DomesticDeliveryMemo" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="가격/혜택 정보">
                            <HongdalSensitiveInfoRow Label="예상 판매가" Value="@Money(SelectedCampaign.TargetUnitPrice)" />
                            <HongdalSensitiveInfoRow Label="의향 혜택" Value="@SelectedCampaign.EarlyIntentBenefit" />
                            <HongdalSensitiveInfoRow Label="결제 시점" Value="수입 진행 확정 후 별도 결제 요청" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="내 구매 의향">
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="int" Label="희망 수량" @bind-Value="desiredQuantity" Min="1" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="decimal" Label="희망 단가" @bind-Value="desiredUnitPrice" Min="0" Step="100M" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField T="string" Label="수령 지역" @bind-Value="deliveryRegion" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" Label="화주에게 남길 메모" @bind-Value="intentMemo" Lines="3" Variant="Variant.Outlined" />
                                </MudItem>
                            </MudGrid>
                            <MudCheckBox T="bool"
                                         @bind-Value="understandsNonBinding"
                                         Label="지금 남기는 내용은 구매 확정이 아니라 수입 검토를 돕는 구매 의향입니다."
                                         Color="Color.Primary" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                       Disabled="@(!understandsNonBinding)"
                                       OnClick="SubmitIntent">
                                구매 의향 남기기
                            </MudButton>
                        </MudExpansionPanel>
                    </HongdalSensitiveDisclosureList>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">다음 서버 골격</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="4">@FlowStep("1", "화주 수입 검토 글", "FCL/LCL 판단 또는 커뮤니티 글에서 수요 확인 캠페인을 엽니다.")</MudItem>
                                <MudItem xs="12" md="4">@FlowStep("2", "주문자 의향 등록", "희망 수량, 희망가, 지역, 메모를 비확정 의향으로 남깁니다.")</MudItem>
                                <MudItem xs="12" md="4">@FlowStep("3", "수입 진행 판단", "모인 의향을 보고 화주가 수입, 취소, 가격 재협의를 결정합니다.")</MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

<style>
    .group-purchase-page .campaign-card {
        border-radius: 8px;
        cursor: pointer;
        transition: border-color 120ms ease, background-color 120ms ease;
    }

    .group-purchase-page .campaign-card:hover,
    .group-purchase-page .campaign-card--selected {
        border-color: var(--mud-palette-primary);
        background: color-mix(in srgb, var(--mud-palette-surface) 88%, var(--mud-palette-primary) 12%);
    }

    .group-purchase-page .intent-meter {
        height: 8px;
        overflow: hidden;
        border-radius: 999px;
        background: var(--mud-palette-lines-default);
    }

    .group-purchase-page .intent-meter > div {
        height: 100%;
        border-radius: inherit;
        background: var(--mud-palette-primary);
    }

    .group-purchase-page .flow-step {
        border-radius: 8px;
        background: color-mix(in srgb, var(--mud-palette-surface) 90%, var(--mud-palette-info) 10%);
    }
</style>

@code {
    private readonly List<ImportDemandCampaign> Campaigns =
    [
        new(1, "접이식 캠핑 테이블", "글로벌 화주 A", "수요 확인", "FCL 검토", "HS 코드 9403 후보 검토 중", "2026년 8월 말 국내 입고 예상", 500, 185, 39000, "중국 출발 물량을 팔레트 단위로 묶어 들여오는 안입니다.", "관세사 검토 대기", "도착 후 택배 또는 근거리 묶음 배송", "초기 의향 고객에게 확정 판매가 우선 안내", "FCL/LCL 비교", Color.Primary),
        new(2, "소형 주방 정리함 세트", "생활용품 화주 B", "가격 재검토", "LCL 우선", "생활용품류 HS 후보 비교 필요", "2026년 9월 초 국내 입고 예상", 800, 520, 12900, "작은 부피 상품이라 LCL 공동 적재를 먼저 검토합니다.", "HS 코드 보정 필요", "도심 마트 출고 또는 택배", "수요가 700개 이상이면 단가 인하 검토", "수요 충분", Color.Success),
        new(3, "반려동물 이동 가방", "펫용품 화주 C", "주의 검토", "비교 견적", "섬유/플라스틱 복합재질 확인 필요", "2026년 9월 중순 이후", 300, 74, 28000, "재질과 검역/표시 조건을 확인한 뒤 진행 여부를 판단합니다.", "관세사 문의 권장", "국내 창고 입고 후 개별 출고", "진행 확정 시 알림 우선 발송", "통관 확인 우선", Color.Warning)
    ];

    private int selectedCampaignId = 1;
    private int desiredQuantity = 2;
    private decimal desiredUnitPrice = 39000;
    private string deliveryRegion = "서울 강서구";
    private string intentMemo = "입고가 확정되면 알림을 받고 싶습니다.";
    private bool understandsNonBinding;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;

    private ImportDemandCampaign SelectedCampaign => Campaigns.First(x => x.Id == selectedCampaignId);

    private void SelectCampaign(int campaignId)
    {
        selectedCampaignId = campaignId;
        desiredUnitPrice = SelectedCampaign.TargetUnitPrice;
        statusMessage = null;
    }

    private void SubmitIntent()
    {
        if (!understandsNonBinding)
        {
            statusSeverity = Severity.Warning;
            statusMessage = "구매 확정이 아닌 의향 표시라는 점을 확인한 뒤 등록할 수 있습니다.";
            return;
        }

        var campaign = SelectedCampaign;
        campaign.InterestedQuantity += Math.Max(desiredQuantity, 1);
        statusSeverity = Severity.Success;
        statusMessage = $"{campaign.ProductName}에 {desiredQuantity:N0}개 구매 의향을 남겼습니다. 실제 결제와 배송지는 수입 진행 확정 뒤 다시 확인합니다.";
    }

    private string CampaignCardClass(ImportDemandCampaign campaign)
    {
        var selectedClass = campaign.Id == selectedCampaignId ? "campaign-card--selected" : string.Empty;
        return $"pa-3 campaign-card {selectedClass}";
    }

    private static string ProgressStyle(ImportDemandCampaign campaign)
    {
        var percentage = Math.Clamp(campaign.ProgressRate * 100m, 0m, 100m);
        return $"width: {percentage:0.##}%;";
    }

    private static string Money(decimal value) => $"{value:N0}원";

    private static RenderFragment Metric(string label, string value, Color color) => builder =>
    {
        builder.OpenComponent<MudPaper>(0);
        builder.AddAttribute(1, "Elevation", 0);
        builder.AddAttribute(2, "Outlined", true);
        builder.AddAttribute(3, "Class", "pa-3 h-100");
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(childBuilder =>
        {
            childBuilder.OpenComponent<MudText>(0);
            childBuilder.AddAttribute(1, "Typo", Typo.caption);
            childBuilder.AddAttribute(2, "Color", Color.Secondary);
            childBuilder.AddAttribute(3, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, label)));
            childBuilder.CloseComponent();
            childBuilder.OpenComponent<MudText>(4);
            childBuilder.AddAttribute(5, "Typo", Typo.h6);
            childBuilder.AddAttribute(6, "Color", color);
            childBuilder.AddAttribute(7, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, value)));
            childBuilder.CloseComponent();
        }));
        builder.CloseComponent();
    };

    private static RenderFragment FlowStep(string number, string title, string description) => builder =>
    {
        builder.OpenComponent<MudPaper>(0);
        builder.AddAttribute(1, "Elevation", 0);
        builder.AddAttribute(2, "Outlined", true);
        builder.AddAttribute(3, "Class", "pa-3 h-100 flow-step");
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(childBuilder =>
        {
            childBuilder.OpenComponent<MudStack>(0);
            childBuilder.AddAttribute(1, "Spacing", 1);
            childBuilder.AddAttribute(2, "ChildContent", (RenderFragment)(stackBuilder =>
            {
                stackBuilder.OpenComponent<MudChip<string>>(0);
                stackBuilder.AddAttribute(1, "Color", Color.Info);
                stackBuilder.AddAttribute(2, "Size", Size.Small);
                stackBuilder.AddAttribute(3, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, number)));
                stackBuilder.CloseComponent();
                stackBuilder.OpenComponent<MudText>(4);
                stackBuilder.AddAttribute(5, "Typo", Typo.subtitle2);
                stackBuilder.AddAttribute(6, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, title)));
                stackBuilder.CloseComponent();
                stackBuilder.OpenComponent<MudText>(7);
                stackBuilder.AddAttribute(8, "Typo", Typo.body2);
                stackBuilder.AddAttribute(9, "Color", Color.Secondary);
                stackBuilder.AddAttribute(10, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, description)));
                stackBuilder.CloseComponent();
            }));
            childBuilder.CloseComponent();
        }));
        builder.CloseComponent();
    };

    private sealed class ImportDemandCampaign(
        int id,
        string productName,
        string shipperAlias,
        string status,
        string logisticsMode,
        string customsMemo,
        string expectedArrival,
        int targetQuantity,
        int interestedQuantity,
        decimal targetUnitPrice,
        string summary,
        string hsReviewStatus,
        string domesticDeliveryMemo,
        string earlyIntentBenefit,
        string importDecisionHint,
        Color color)
    {
        public int Id { get; } = id;
        public string ProductName { get; } = productName;
        public string ShipperAlias { get; } = shipperAlias;
        public string Status { get; } = status;
        public string LogisticsMode { get; } = logisticsMode;
        public string CustomsMemo { get; } = customsMemo;
        public string ExpectedArrival { get; } = expectedArrival;
        public int TargetQuantity { get; } = targetQuantity;
        public int InterestedQuantity { get; set; } = interestedQuantity;
        public decimal TargetUnitPrice { get; } = targetUnitPrice;
        public string Summary { get; } = summary;
        public string HsReviewStatus { get; } = hsReviewStatus;
        public string DomesticDeliveryMemo { get; } = domesticDeliveryMemo;
        public string EarlyIntentBenefit { get; } = earlyIntentBenefit;
        public string ImportDecisionHint { get; } = importDecisionHint;
        public Color Color { get; } = color;
        public decimal ProgressRate => TargetQuantity <= 0 ? 0 : (decimal)InterestedQuantity / TargetQuantity;
    }
}
