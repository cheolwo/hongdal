@page "/group-purchase"
@using OrdererApp.Components.GroupPurchase
@inject GroupPurchaseIntentPageViewModel PageViewModel

<PageTitle>먹거리 공동수입</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4 group-purchase-page">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">먹거리 공동수입</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    HS 코드상 식품으로 분류되는 상품 카드를 보고, 주문자가 직접 공동 주문 집단 개설을 신청합니다.
                </MudText>
            </MudStack>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">HS 식품 코드 우선</MudChip>
        </MudStack>

        <GroupPurchaseShipmentTrackingPanel />

        <MudGrid>
            <MudItem xs="12" lg="4">
                <GroupPurchaseProductCatalogPanel Products="PageViewModel.ProductCards"
                                                  SelectedProductId="PageViewModel.SelectedProduct.상품카드Id"
                                                  ProductSelected="SelectProductAsync" />
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudStack Spacing="3">
                    <GroupPurchaseProductAnalysisPanel Product="PageViewModel.SelectedProduct"
                                                       QuantityKg="PageViewModel.DesiredQuantityKg" />
                    <GroupPurchaseDemandPanel Product="PageViewModel.SelectedProduct"
                                              DesiredQuantityKg="PageViewModel.DesiredQuantityKg"
                                              DesiredQuantityKgChanged="UpdateDesiredQuantityAsync"
                                              DesiredUnitPrice="PageViewModel.DesiredUnitPrice"
                                              DesiredUnitPriceChanged="UpdateDesiredUnitPriceAsync" />
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    private Task SelectProductAsync(string productId)
    {
        PageViewModel.SelectProduct(productId);
        return Task.CompletedTask;
    }

    private Task UpdateDesiredQuantityAsync(decimal quantityKg)
    {
        PageViewModel.UpdateDesiredQuantity(quantityKg);
        return Task.CompletedTask;
    }

    private Task UpdateDesiredUnitPriceAsync(decimal unitPrice)
    {
        PageViewModel.UpdateDesiredUnitPrice(unitPrice);
        return Task.CompletedTask;
    }
}
