@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Dense="true" Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2 orderer-app-title">살뜰 주문</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Class="orderer-app-scope">음식 / 홈달마트 / 화물 / 공동구매</MudChip>
    </MudAppBar>

    <MudDrawer Open="@drawerOpen" Variant="DrawerVariant.Temporary" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4 pb-4 orderer-main">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
