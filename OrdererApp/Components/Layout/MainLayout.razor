@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="orderer-mobile-shell">
    <header class="orderer-mobile-shell__appbar">
        <button type="button"
                class="orderer-mobile-shell__icon-button"
                aria-label="주문자 메뉴 열기"
                aria-expanded="@_drawerOpen"
                @onclick="ToggleDrawer">
            <MudIcon Icon="@Icons.Material.Filled.Menu" />
        </button>
        <a class="orderer-mobile-shell__brand" href="@OrdererRoutes.Home">살뜰 주문</a>
        <span class="orderer-mobile-shell__spacer"></span>
        <span class="orderer-mobile-shell__scope">개별주문 → 공동주문</span>
        <span class="orderer-mobile-shell__avatar" aria-label="주문자">O</span>
    </header>

    @if (_drawerOpen)
    {
        <button type="button"
                class="orderer-mobile-shell__backdrop"
                aria-label="주문자 메뉴 닫기"
                @onclick="CloseDrawer"></button>
        <aside class="orderer-mobile-shell__drawer" aria-label="주문자 메뉴">
            <header>
                <div>
                    <strong>살뜰 주문</strong>
                    <span>내 주문에서 함께 주문까지</span>
                </div>
                <button type="button" aria-label="메뉴 닫기" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </header>
            <nav>
                <a href="@OrdererRoutes.Home" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.Home" />
                    주문자 홈
                </a>
                <a href="@OrdererRoutes.GroupPurchaseProducts" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" />
                    재료 후보
                </a>
                <a href="@OrdererRoutes.ProducePriceComparison" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.CompareArrows" />
                    과일·채소 가격
                </a>
                <a href="@OrdererRoutes.GroupPurchaseWishCreate" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" />
                    개별주문 의향 등록
                </a>
                <a href="@OrdererRoutes.GroupPurchaseWishes" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" />
                    내 개별주문
                </a>
                <a href="@OrdererRoutes.GroupPurchaseGroups" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.GroupWork" />
                    공동주문 후보
                </a>
                <a href="@OrdererRoutes.Orders" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                    주문 원장
                </a>
                <a href="@OrdererRoutes.IndividualImportLedger" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.Public" />
                    개별수입 원장
                </a>
                <a href="@OrdererRoutes.GroupExportLedger" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" />
                    공동수출 원장
                </a>
            </nav>
            <aside>
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                개별주문 의향과 공동주문 후보는 비구속 상태이며, 결제·계약·수입 실행과 분리됩니다.
            </aside>
        </aside>
    }

    <section class="orderer-mobile-shell__content">
        @Body
    </section>

    <footer class="orderer-mobile-shell__bottom-nav">
        <a class="@BuildBottomLinkClass(BottomDestination.Home)"
           href="@OrdererRoutes.Home"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Home) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
            <span>홈</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Ingredients)"
           href="@OrdererRoutes.GroupPurchaseProducts"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Ingredients) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
            <span>재료</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Wishes)"
           href="@OrdererRoutes.GroupPurchaseWishes"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Wishes) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Size="Size.Small" />
            <span>내 주문</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Ledgers)"
           href="@OrdererRoutes.Orders"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Ledgers) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
            <span>원장</span>
        </a>
    </footer>
</div>

@code {
    private bool _drawerOpen;

    protected override void OnInitialized()
        => Navigation.LocationChanged += HandleLocationChanged;

    private string CurrentPath
        => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/') is { Length: > 0 } path
            ? path
            : "/";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;

    private bool IsBottomDestinationActive(BottomDestination destination)
        => destination switch
        {
            BottomDestination.Ingredients =>
                CurrentPath.StartsWith(OrdererRoutes.ProducePriceComparison, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith(OrdererRoutes.GroupPurchaseProducts, StringComparison.OrdinalIgnoreCase)
                || string.Equals(CurrentPath, OrdererRoutes.GroupPurchaseWishCreate, StringComparison.OrdinalIgnoreCase),
            BottomDestination.Wishes =>
                (CurrentPath.StartsWith(OrdererRoutes.GroupPurchaseWishes, StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(CurrentPath, OrdererRoutes.GroupPurchaseWishCreate, StringComparison.OrdinalIgnoreCase))
                || CurrentPath.StartsWith(OrdererRoutes.GroupPurchaseGroups, StringComparison.OrdinalIgnoreCase),
            BottomDestination.Ledgers =>
                CurrentPath.StartsWith(OrdererRoutes.Orders, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith("/trade", StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith("/group-purchase/import", StringComparison.OrdinalIgnoreCase),
            _ => string.Equals(CurrentPath, OrdererRoutes.Home, StringComparison.OrdinalIgnoreCase)
                 || string.Equals(CurrentPath, OrdererRoutes.GroupPurchase, StringComparison.OrdinalIgnoreCase)
                 || CurrentPath.StartsWith("/food", StringComparison.OrdinalIgnoreCase)
                 || CurrentPath.StartsWith("/cargo", StringComparison.OrdinalIgnoreCase)
        };

    private string BuildBottomLinkClass(BottomDestination destination)
        => IsBottomDestinationActive(destination)
            ? "orderer-mobile-shell__bottom-link orderer-mobile-shell__bottom-link--active"
            : "orderer-mobile-shell__bottom-link";

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _drawerOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Navigation.LocationChanged -= HandleLocationChanged;

    private enum BottomDestination
    {
        Home,
        Ingredients,
        Wishes,
        Ledgers
    }
}
