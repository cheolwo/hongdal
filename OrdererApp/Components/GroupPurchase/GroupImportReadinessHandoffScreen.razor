@using Ssalddel.Contracts.Common.Orderer

<MudStack Spacing="3">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        주문자는 운송 방식을 확정하지 않습니다. 합산 물량과 조건을 사람이 포워더에게 인계한 뒤 기록된 회신을 확인합니다.
    </MudAlert>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6">포워더 인계 상태</MudText>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                    @Ledger.포워더인계.인계상태코드
                </MudChip>
            </MudStack>
            <MudText Typo="Typo.body2">@Ledger.포워더인계.전달범위요약</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                전달 범위 @Ledger.포워더인계.전달정보범위코드 · 기록 @DateLabel(Ledger.포워더인계.인계시각Utc)
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                전달 항목: @string.Join(", ", Ledger.포워더인계.전달항목코드목록)
            </MudText>
            @if (!string.IsNullOrWhiteSpace(Ledger.포워더인계.전달대상업체명))
            {
                <MudText Typo="Typo.body2">
                    기록된 인계 대상: @Ledger.포워더인계.전달대상업체명
                </MudText>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6">국제운송 검토 회신</MudText>
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">
                    @Ledger.국제운송검토.검토상태코드
                </MudChip>
            </MudStack>
            <MudText Typo="Typo.body2">
                비교 후보: @string.Join(" / ", Ledger.국제운송검토.방식후보목록)
            </MudText>
            @if (string.IsNullOrWhiteSpace(Ledger.국제운송검토.포워더제안방식코드))
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">아직 기록된 포워더 방식 제안이 없습니다.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.subtitle1">
                    제안 방식 @Ledger.국제운송검토.포워더제안방식코드
                </MudText>
                <MudText Typo="Typo.body2">@Ledger.국제운송검토.포워더회신요약</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Ledger.국제운송검토.회신업체표시명 · @DateLabel(Ledger.국제운송검토.회신시각Utc)
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    [Parameter, EditorRequired] public 같이수입준비주문자조회응답 Ledger { get; set; } = default!;

    private static string DateLabel(DateTimeOffset? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "회신 시각 미기록";
}
