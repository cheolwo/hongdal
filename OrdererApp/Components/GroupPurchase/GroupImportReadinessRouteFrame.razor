@using Ssalddel.Contracts.Common.Orderer

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4 px-0">
    <GroupPurchaseScreenFrame CurrentScreen="@ScreenKind"
                              Eyebrow="@($"주문자 업무 · {EffectiveScreenCode}")"
                              Title="@Title"
                              Description="@Description"
                              BackHref="@GroupPurchasePageRoutes.Root"
                              BoundarySeverity="Severity.Warning"
                              BoundaryMessage="이 화면은 공급·가격·무역 준비 근거를 읽는 곳입니다. 계약·결제·신고·운송 지시, 포워더 자동 선정이나 외부 자동 전송은 실행하지 않습니다.">
        <GroupPurchaseOrdererAccessGate LoginTitle="공동수입 준비현황 로그인"
                                        LoginDescription="본인이 참여한 공동 진행의 공개 준비자료만 확인할 수 있습니다."
                                        LoginButtonText="로그인하고 준비현황 보기">
            <Authorized>
                <OrdererGroupImportReadinessLoader LedgerId="@LedgerId" AutoGroupId="@AutoGroupId">
                    <ChildContent Context="readiness">
                        <MudStack Spacing="3">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-2">
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    @foreach (var item in Sections)
                                    {
                                        <MudButton Href="@OrdererGroupImportReadinessRoutes.For(item.Section, LedgerId, AutoGroupId!)"
                                                   Variant="@ButtonVariant(item.Section)"
                                                   Color="Color.Primary"
                                                   Size="Size.Small">
                                            @item.Label
                                        </MudButton>
                                    }
                                </MudStack>
                            </MudPaper>
                            @ChildContent(readiness)
                        </MudStack>
                    </ChildContent>
                </OrdererGroupImportReadinessLoader>
            </Authorized>
        </GroupPurchaseOrdererAccessGate>
    </GroupPurchaseScreenFrame>
</MudContainer>

@code {
    private static readonly IReadOnlyList<(GroupImportReadinessSection Section, string Label)> Sections =
    [
        (GroupImportReadinessSection.Overview, "준비 현황"),
        (GroupImportReadinessSection.Suppliers, "공급자 근거"),
        (GroupImportReadinessSection.Costs, "견적·예상 비용"),
        (GroupImportReadinessSection.Classification, "품목분류·규제"),
        (GroupImportReadinessSection.Handoff, "포워더 인계"),
        (GroupImportReadinessSection.Consent, "정보 제공")
    ];

    [Parameter, EditorRequired] public string LedgerId { get; set; } = string.Empty;
    [Parameter] public string? AutoGroupId { get; set; }
    [Parameter] public GroupImportReadinessSection CurrentSection { get; set; }
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment<공동수입준비주문자조회응답> ChildContent { get; set; } = default!;

    private GroupPurchaseScreenKind ScreenKind => CurrentSection switch
    {
        GroupImportReadinessSection.Suppliers => GroupPurchaseScreenKind.ImportSuppliers,
        GroupImportReadinessSection.Costs => GroupPurchaseScreenKind.ImportCosts,
        GroupImportReadinessSection.Classification => GroupPurchaseScreenKind.ImportClassification,
        GroupImportReadinessSection.Handoff => GroupPurchaseScreenKind.ImportHandoff,
        GroupImportReadinessSection.Consent => GroupPurchaseScreenKind.ImportConsent,
        _ => GroupPurchaseScreenKind.ImportOverview
    };

    private string EffectiveScreenCode
        => !string.IsNullOrWhiteSpace(ScreenCode)
            ? ScreenCode
            : CurrentSection == GroupImportReadinessSection.Costs
                ? "02.10"
                : "02.09";

    private Variant ButtonVariant(GroupImportReadinessSection section)
        => section == CurrentSection ? Variant.Filled : Variant.Text;
}
