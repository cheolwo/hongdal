@using Ssalddel.Contracts.Common.Orderer
@inject GroupPurchaseMyWishesViewModel ViewModel

@if (ViewModel.IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (ViewModel.FindWish(WishLedgerId) is not { } wish)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">수정할 수 있는 본인 원함을 찾지 못했습니다.</MudAlert>
}
else if (!GroupPurchaseMyWishesViewModel.IsActive(wish))
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">닫힌 원함은 수정할 수 없습니다.</MudAlert>
}
else
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@wish.상품명</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    현재 @wish.희망수량.ToString("N2") @wish.수량단위 · @wish.배송권명
                </MudText>
            </MudStack>
            <MudNumericField T="decimal"
                             Label="@($"새 희망 수량 ({wish.수량단위})")"
                             @bind-Value="_quantity"
                             Min="0.01m"
                             Step="1m"
                             Variant="Variant.Outlined"
                             Disabled="@ViewModel.IsOperating" />
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                같은 개별 원함의 수량만 교체합니다. 결제·주문·계약을 만들지 않으며 LCL/FCL 방식도 확정하지 않습니다.
            </MudAlert>
            @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.ErrorMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(ViewModel.Notice))
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@ViewModel.Notice</MudAlert>
            }
            <MudStack Row="true" Spacing="1">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@ViewModel.IsOperating"
                           OnClick="@(() => SaveAsync(wish))">
                    희망 수량 저장
                </MudButton>
                <MudButton Href="@GroupPurchasePageRoutes.WishDetailFor(wish.개별원함원장Id)"
                           Variant="Variant.Text">
                    원함 상세로
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@code {
    private string? _initializedWishId;
    private decimal _quantity;
    [Parameter, EditorRequired] public string WishLedgerId { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await ViewModel.LoadAsync();
        var wish = ViewModel.FindWish(WishLedgerId);
        if (wish is not null && !string.Equals(_initializedWishId, wish.개별원함원장Id, StringComparison.Ordinal))
        {
            _initializedWishId = wish.개별원함원장Id;
            _quantity = wish.희망수량;
        }
    }

    private Task SaveAsync(공동구매내원함응답 wish)
        => ViewModel.UpdateQuantityAsync(wish, _quantity);
}
