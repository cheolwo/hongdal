@using Ssalddel.Contracts.Common.Orderer
@inject GroupPurchaseMyWishesViewModel ViewModel

@if (ViewModel.IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage) && ViewModel.Result is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.ErrorMessage</MudAlert>
}
else if (ViewModel.FindWish(WishLedgerId) is not { } wish)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        본인 원함에서 이 원장을 찾을 수 없습니다. 철회됐거나 접근할 수 없는 원장일 수 있습니다.
    </MudAlert>
}
else
{
    <MudStack Spacing="3">
        @if (!string.IsNullOrWhiteSpace(ViewModel.Notice))
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@ViewModel.Notice</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.ErrorMessage</MudAlert>
        }

        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5">@wish.상품명</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">원함 원장 @wish.개별원함원장Id</MudText>
                    </MudStack>
                    <MudChip T="string"
                             Color="@(GroupPurchaseMyWishesViewModel.IsActive(wish) ? Color.Success : Color.Default)"
                             Variant="Variant.Outlined">
                        @(GroupPurchaseMyWishesViewModel.IsActive(wish) ? "활성" : "닫힘")
                    </MudChip>
                </MudStack>
                <MudGrid>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.caption">내 희망 수량</MudText><MudText>@wish.희망수량.ToString("N2") @wish.수량단위</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.caption">거래 문맥</MudText><MudText>@wish.거래유형</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.caption">배송권</MudText><MudText>@wish.배송권명</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.caption">운송 결정</MudText><MudText>포워더 후속 검토</MudText></MudItem>
                </MudGrid>
                @if (wish.거래유형 == 공동구매거래유형코드.B2B)
                {
                    <MudText Typo="Typo.body2">
                        구매 조직 @ValueOrPending(wish.구매조직표시명) · @(wish.세금계산서필요 ? "세금계산서 검토 필요" : "세금계산서 조건 없음")
                    </MudText>
                }
            </MudStack>
        </MudPaper>

        @if (wish.자동집단요약 is { } group)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">내 원함에서 이어진 공동 진행</MudText>
                    <MudText Typo="Typo.body2">
                        @group.참여자수.ToString("N0")명 · 총 @group.총희망수량.ToString("N2") @group.수량단위 · @group.현재상태
                    </MudText>
                    <MudButton Href="@GroupPurchasePageRoutes.GroupDetailFor(group.자동집단Id)"
                               Variant="Variant.Outlined"
                               Color="Color.Primary">
                        공동 진행 상세
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        @if (GroupPurchaseMyWishesViewModel.IsActive(wish))
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudButton Href="@GroupPurchasePageRoutes.WishEditFor(wish.개별원함원장Id)"
                           Color="Color.Primary"
                           Variant="Variant.Filled">
                    희망 수량 수정
                </MudButton>
                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="AskWithdraw">원함 철회</MudButton>
            </MudStack>
        }
        @if (_confirmWithdraw)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                비구속 원함만 닫습니다. 연결된 별도 주문·계약을 자동 취소하지 않습니다.
                <MudStack Row="true" Spacing="1" Class="mt-2">
                    <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@ViewModel.IsOperating" OnClick="@(() => WithdrawAsync(wish))">철회 확인</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="@(() => _confirmWithdraw = false)">계속 유지</MudButton>
                </MudStack>
            </MudAlert>
        }
    </MudStack>
}

@code {
    private bool _confirmWithdraw;
    [Parameter, EditorRequired] public string WishLedgerId { get; set; } = string.Empty;

    protected override Task OnParametersSetAsync() => ViewModel.LoadAsync();
    private void AskWithdraw() => _confirmWithdraw = true;

    private async Task WithdrawAsync(공동구매내원함응답 wish)
    {
        if (await ViewModel.WithdrawAsync(wish))
        {
            _confirmWithdraw = false;
        }
    }

    private static string ValueOrPending(string? value)
        => string.IsNullOrWhiteSpace(value) ? "미기록" : value;
}
