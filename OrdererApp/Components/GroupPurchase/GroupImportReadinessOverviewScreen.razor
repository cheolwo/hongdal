@using Ssalddel.Contracts.Common.Orderer

<MudStack Spacing="3">
    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@Ledger.상품명 같이 수입 준비</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        참여 주문자에게 공개된 집계·준비 상태
                    </MudText>
                </MudStack>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@Ledger.상태코드</MudChip>
            </MudStack>
            <MudText Typo="Typo.body2">
                @Ledger.거래유형 · @Ledger.가격표시기준 · 기준 시각 @DateLabel(Ledger.기준시각Utc)
            </MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">이번 수입의 목적과 통관 경로</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Ledger.통관목적안내.수입목적표시명</MudText>
                </MudStack>
                <MudChip T="string"
                         Color="@(Ledger.통관목적안내.자가사용소액면세검토대상 ? Color.Info : Color.Warning)"
                         Variant="Variant.Outlined">
                    @(Ledger.통관목적안내.자가사용소액면세검토대상 ? "면세 여부 추가 확인" : "사업 수입 비용 검토")
                </MudChip>
            </MudStack>
            <MudAlert Severity="@(Ledger.통관목적안내.자가사용소액면세검토대상 ? Severity.Info : Severity.Warning)"
                      Variant="Variant.Outlined"
                      Dense="true">
                @Ledger.통관목적안내.핵심안내
            </MudAlert>
            @foreach (var item in Ledger.통관목적안내.확인사항)
            {
                <MudText Typo="Typo.body2">· @item</MudText>
            }
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                기준 @Ledger.통관목적안내.기준일.ToString("yyyy-MM-dd") ·
                <MudLink Href="@Ledger.통관목적안내.관세청예상세액조회Url" Target="_blank">관세청 예상세액 조회</MudLink>
            </MudText>
            @if (CanOpenLogisticsReview)
            {
                <MudButton Href="@LogisticsReviewHref"
                           Variant="Variant.Filled"
                           Color="@(Ledger.통관목적안내.관세부가세예상비용검토필요 ? Color.Warning : Color.Primary)"
                           StartIcon="@Icons.Material.Filled.Warehouse">
                    @(Ledger.통관목적안내.관세부가세예상비용검토필요
                        ? "판매용 통관·3PL 경로 확인"
                        : "금액·식품 조건으로 통관·3PL 확인")
                </MudButton>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">함께 준비하는 재료</MudText>
            @foreach (var source in Ledger.재료집계목록)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">@source.재료명</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">참여 수요를 합산한 공개 물량</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2">@source.모인수요수량.ToString("N2") @source.수량단위</MudText>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    </MudPaper>

    <MudGrid>
        @foreach (var item in ReadinessItems)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2">@item.Label</MudText>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(item.Ready ? Color.Success : Color.Warning)"
                                 Variant="Variant.Outlined">
                            @(item.Ready ? "근거 있음" : "확인 필요")
                        </MudChip>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudAlert Severity="@(Ledger.준비현황.전문검토준비됨 ? Severity.Success : Severity.Info)"
              Variant="Variant.Outlined">
        @(Ledger.준비현황.전문검토준비됨
            ? "공개 근거가 전문 검토 인계 가능한 상태로 기록되어 있습니다."
            : "전문 검토에 필요한 공개 근거를 준비하고 있습니다.")
    </MudAlert>
</MudStack>

@code {
    [Parameter, EditorRequired] public 같이수입준비주문자조회응답 Ledger { get; set; } = default!;
    [Parameter] public string LedgerId { get; set; } = string.Empty;
    [Parameter] public string? AutoGroupId { get; set; }

    private bool CanOpenLogisticsReview
        => !string.IsNullOrWhiteSpace(LedgerId) && !string.IsNullOrWhiteSpace(AutoGroupId);

    private string LogisticsReviewHref
        => OrdererGroupImportReadinessRoutes.For(
            GroupImportReadinessSection.LogisticsReview,
            LedgerId,
            AutoGroupId ?? string.Empty);

    private IReadOnlyList<(string Label, bool Ready)> ReadinessItems =>
    [
        ("재료 집계", Ledger.준비현황.재료집계완료),
        ("공급자 근거", Ledger.준비현황.공급자근거있음),
        ("견적 근거", Ledger.준비현황.견적근거있음),
        ("예상 비용", Ledger.준비현황.예상비용근거있음),
        ("품목분류 후보", Ledger.준비현황.품목분류근거있음),
        ("국가별 검토", Ledger.준비현황.국가별검토근거있음)
    ];

    private static string DateLabel(DateTimeOffset value)
        => value == default ? "미기록" : value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
