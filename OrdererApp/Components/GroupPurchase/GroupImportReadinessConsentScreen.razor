@using Ssalddel.Contracts.Common.Orderer

<MudStack Spacing="3">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        기본 인계는 개인 식별정보를 제외한 집계 수요만 사용합니다. 아래 상태는 운영자가 기록한 집계 인계 조건이며
        현재 로그인 사용자의 주체·버전·범위·시각을 갖춘 본인 동의 기록이 아닙니다.
    </MudAlert>

    <MudAlert Severity="@(Ledger.통관목적안내.개인통관고유부호입력대상 ? Severity.Info : Severity.Warning)"
              Variant="Variant.Outlined">
        @if (Ledger.통관목적안내.개인통관고유부호입력대상)
        {
            <span>
                개인통관고유부호는 실제 개인 자가사용 통관 절차가 생성된 뒤 본인 확인용 전용 입력 단계에서만 받습니다.
                같이 수입 공동 원장이나 포워더 집계 자료에는 원문을 기록하지 않으며, 입력했다고 면세가 확정되지는 않습니다.
            </span>
        }
        else
        {
            <span>
                사업·판매 목적 수입에는 개인통관고유부호 입력을 요청하지 않습니다.
                사업자·수입자 정보와 품목별 신고·세금 근거를 별도 수입 절차에서 확인합니다.
            </span>
        }
    </MudAlert>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">정보 제공 범위</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">전달 범위</MudText>
                    <MudText Typo="Typo.body1">@Ledger.포워더인계.전달정보범위코드</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">개인정보 포함</MudText>
                    <MudChip T="string"
                             Color="@(Ledger.포워더인계.개인정보포함여부 ? Color.Warning : Color.Success)"
                             Variant="Variant.Outlined">
                        @(Ledger.포워더인계.개인정보포함여부 ? "포함" : "포함 안 함")
                    </MudChip>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">운영 기록상 조건 확인</MudText>
                    <MudChip T="string"
                             Color="@(Ledger.포워더인계.운영자기록정보제공조건확인여부 ? Color.Success : Color.Warning)"
                             Variant="Variant.Outlined">
                        @(Ledger.포워더인계.운영자기록정보제공조건확인여부 ? "운영 기록 있음" : "운영 기록 없음")
                    </MudChip>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.body2">@Ledger.포워더인계.전달범위요약</MudText>
        </MudStack>
    </MudPaper>

    @if (Ledger.포워더인계.개인정보포함여부
         && !Ledger.포워더인계.운영자기록정보제공조건확인여부)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            개인정보 포함 표시와 운영 기록상 조건 확인 상태가 일치하지 않습니다. 운영자가 인계를 진행하기 전에 반드시 보완해야 합니다.
        </MudAlert>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public 같이수입준비주문자조회응답 Ledger { get; set; } = default!;
}
