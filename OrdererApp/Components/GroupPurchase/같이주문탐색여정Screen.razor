    private static readonly IReadOnlyList<(같이주문여정단계 단계, string 코드, string 이름)> 여정지도 =
    [
        (같이주문여정단계.레시피활용, "03", "활용"),
        (같이주문여정단계.주문방식비교, "04", "비교"),
        (같이주문여정단계.배송권찾기, "05", "배송권"),
        (같이주문여정단계.같이주문목록, "06", "목록"),
        (같이주문여정단계.같이주문상세, "07", "상세"),
        (같이주문여정단계.공급자관계, "08", "공급자"),
        (같이주문여정단계.공급자Membership, "09", "혜택"),
        (같이주문여정단계.긴급수확제안, "10", "수확"),
        (같이주문여정단계.긴급수확검토, "11", "검토")
    ];

    private string 지도Class(같이주문여정단계 item)
        => item == 단계
            ? "together-journey__map-item together-journey__map-item--current"
            : "together-journey__map-item";

    private string? 지도경로(같이주문여정단계 item)
        => item switch
        {
            같이주문여정단계.레시피활용 when 상품키() is { Length: > 0 } product =>
                GroupPurchasePageRoutes.RecipeUseFor(product),
            같이주문여정단계.주문방식비교 when 상품키() is { Length: > 0 } product =>
                GroupPurchasePageRoutes.OrderModeComparisonFor(product),
            같이주문여정단계.배송권찾기 => GroupPurchasePageRoutes.DeliveryScopesRoot,
            같이주문여정단계.같이주문목록 when !string.IsNullOrWhiteSpace(유효배송권키) =>
                같이주문목록경로(유효배송권키),
            같이주문여정단계.같이주문상세 when 같이주문Id() is { Length: > 0 } groupId =>
                GroupPurchasePageRoutes.TogetherOrderDetailFor(groupId),
            같이주문여정단계.공급자관계 when 공급자키() is { Length: > 0 } supplier =>
                GroupPurchasePageRoutes.SupplierRelationshipFor(supplier),
            같이주문여정단계.공급자Membership when 공급자키() is { Length: > 0 } supplier =>
                GroupPurchasePageRoutes.SupplierMembershipFor(supplier),
            같이주문여정단계.긴급수확제안 when 제안키() is { Length: > 0 } offer =>
                GroupPurchasePageRoutes.UrgentHarvestOfferFor(offer),
            같이주문여정단계.긴급수확검토 when 제안키() is { Length: > 0 } offer =>
                GroupPurchasePageRoutes.UrgentHarvestReviewFor(offer),
            _ => null
        };

    private string? 상품키()
        => 단계 is 같이주문여정단계.레시피활용 or 같이주문여정단계.주문방식비교
            ? 문맥키
            : _같이주문상세?.상품키;

    private string? 같이주문Id()
        => 단계 == 같이주문여정단계.같이주문상세
            ? 문맥키
            : 단계 == 같이주문여정단계.공급자관계
                ? 공급자원천집단키(문맥키)
                : null;

    private string? 공급자키()
        => 단계 is 같이주문여정단계.공급자관계 or 같이주문여정단계.공급자Membership
            ? 문맥키
            : 단계 is 같이주문여정단계.긴급수확제안 or 같이주문여정단계.긴급수확검토
                ? 제안원천공급자키(문맥키)
                : null;

    private string? 제안키()
        => 단계 is 같이주문여정단계.긴급수확제안 or 같이주문여정단계.긴급수확검토
            ? 문맥키
            : 단계 == 같이주문여정단계.공급자관계
                ? 공급자제안키(문맥키)
                : null;

    private string 상품비교경로()
        => GroupPurchasePageRoutes.OrderModeComparisonFor(_상품?.상품카드Id ?? 문맥키 ?? "missing");

    private static string 같이주문목록경로(string? scopeKey)
        => string.IsNullOrWhiteSpace(scopeKey)
            ? GroupPurchasePageRoutes.TogetherOrdersRoot
            : $"{GroupPurchasePageRoutes.TogetherOrdersRoot}?scope={Uri.EscapeDataString(scopeKey.Trim())}";

    private static string 공급자후보경로(string groupId)
        => GroupPurchasePageRoutes.SupplierRelationshipFor($"pending-group:{groupId}");

    private static string 공급자제안키(string? supplierKey)
        => $"draft:{supplierKey ?? "pending"}";

    private static string 공급자원천집단키(string? supplierKey)
        => supplierKey?.StartsWith("pending-group:", StringComparison.Ordinal) == true
            ? supplierKey["pending-group:".Length..]
            : supplierKey ?? "pending";

    private static string 제안원천공급자키(string? offerKey)
        => offerKey?.StartsWith("draft:", StringComparison.Ordinal) == true
            ? offerKey["draft:".Length..]
            : offerKey ?? "pending";

    private static string 공급자표시명(string? supplierKey)
        => supplierKey?.StartsWith("pending-group:", StringComparison.Ordinal) == true
            ? "공급 제안 연결 대기"
            : supplierKey ?? "공급자 미지정";

    private static decimal 모집진척률(공동구매자동집단요약응답 group)
    {
        if (group.목표수량 is > 0m)
        {
            return Math.Min(100m, group.총희망수량 / group.목표수량.Value * 100m);
        }

        if (group.목표참여자수 is > 0)
        {
            return Math.Min(100m, (decimal)group.참여자수 / group.목표참여자수.Value * 100m);
        }

        return 0m;
    }

    private static string 금액(decimal amount)
        => $"{amount:N0}원";

    private string 레시피검토수량()
        => _레시피 is null
            ? "검토 수량 미정"
            : 같이주문수량Presentation.수량(
                _레시피.개인수령검토수량,
                _레시피.수량단위);

    private string 비교입력안내()
        => _비교 is null
            ? "비교 수량과 원 거래단위를 불러오는 중"
            : $"{같이주문수량Presentation.수량(_비교.요청수량, _비교.수량단위)} · {_비교.통화코드} · 원 거래단위 가격 구간 · 화면 검토용 물류비";
}
