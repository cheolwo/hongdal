@using Ssalddel.Contracts.Common.Orderer
@using Ssalddel.Ui.Common.Areas.App.Services
@inject I같이주문여정ReadService 여정ReadService
@inject ISsalddel현재사용자Context 현재사용자Context

<GroupPurchaseScreenFrame CurrentScreen="@현재화면"
                          Eyebrow="@($"02 ORDERER · {화면코드}")"
                          Title="@제목"
                          Description="@설명"
                          BackHref="@이전경로"
                          BoundaryMessage="@경계안내">
    <nav class="together-journey__map" aria-label="같이 주문 화면 이동 흐름">
        @foreach (var item in 여정지도)
        {
            var href = 지도경로(item.단계);
            if (string.IsNullOrWhiteSpace(href))
            {
                <span class="together-journey__map-item together-journey__map-item--disabled">
                    <small>@item.코드</small>
                    <strong>@item.이름</strong>
                </span>
            }
            else
            {
                <a class="@지도Class(item.단계)" href="@href" aria-current="@(item.단계 == 단계 ? "step" : null)">
                    <small>@item.코드</small>
                    <strong>@item.이름</strong>
                </a>
            }
        }
    </nav>

    @if (_불러오는중)
    {
        <section class="together-journey__state" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            <span>현재 원장과 공개 근거를 불러오고 있습니다.</span>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_오류))
    {
        <section class="together-journey__state together-journey__state--error" role="alert">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
            <span>
                <strong>이 화면의 자료를 불러오지 못했습니다.</strong>
                @_오류
            </span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="다시불러오기Async">
                다시 시도
            </MudButton>
        </section>
    }
    else
    {
        @switch (단계)
        {
            case 같이주문여정단계.레시피활용:
                @레시피활용화면
                break;
            case 같이주문여정단계.주문방식비교:
                @주문방식비교화면
                break;
            case 같이주문여정단계.배송권찾기:
                @배송권찾기화면
                break;
            case 같이주문여정단계.배송권상세:
                @배송권상세화면
                break;
            case 같이주문여정단계.같이주문목록:
                @같이주문목록화면
                break;
            case 같이주문여정단계.같이주문상세:
                @같이주문상세화면
                break;
            case 같이주문여정단계.공급자관계:
                @공급자관계화면
                break;
            case 같이주문여정단계.공급자Membership:
                @공급자Membership화면
                break;
            case 같이주문여정단계.긴급수확제안:
                @긴급수확제안화면
                break;
            case 같이주문여정단계.긴급수확검토:
                @긴급수확검토화면
                break;
        }
    }
</GroupPurchaseScreenFrame>

@code {
    [Parameter, EditorRequired] public 같이주문여정단계 단계 { get; set; }
    [Parameter] public string? 문맥키 { get; set; }
    [Parameter] public string? 배송권키 { get; set; }

    private bool _불러오는중;
    private string? _오류;
    private HS먹거리공동구매상품카드? _상품;
    private 같이주문레시피활용응답? _레시피;
    private 주문방식비교응답? _비교;
    private IReadOnlyList<공동구매자동집단요약응답> _같이주문목록 = [];
    private 같이주문공개상세응답? _같이주문상세;

    private 주문자집단배송권Snapshot? 저장배송권
        => 현재사용자Context.현재사용자.주문자집단배송권;

    private string? 유효배송권키
        => !string.IsNullOrWhiteSpace(배송권키)
            ? 배송권키.Trim()
            : 저장배송권?.ScopeKey;

    private string 화면코드 => 단계 switch
    {
        같이주문여정단계.레시피활용 => "02A2.03",
        같이주문여정단계.주문방식비교 => "02A2.04",
        같이주문여정단계.배송권찾기 => "02A2.05",
        같이주문여정단계.배송권상세 => "02A2.05",
        같이주문여정단계.같이주문목록 => "02A2.06",
        같이주문여정단계.같이주문상세 => "02A2.07",
        같이주문여정단계.공급자관계 => "02A2.08",
        같이주문여정단계.공급자Membership => "02A2.09",
        같이주문여정단계.긴급수확제안 => "02A2.10",
        _ => "02A2.11"
    };

    private GroupPurchaseScreenKind 현재화면 => 단계 switch
    {
        같이주문여정단계.레시피활용 => GroupPurchaseScreenKind.RecipeUse,
        같이주문여정단계.주문방식비교 => GroupPurchaseScreenKind.OrderModeComparison,
        같이주문여정단계.배송권찾기 => GroupPurchaseScreenKind.DeliveryScopeFinder,
        같이주문여정단계.배송권상세 => GroupPurchaseScreenKind.DeliveryScopeDetail,
        같이주문여정단계.같이주문목록 => GroupPurchaseScreenKind.TogetherOrderList,
        같이주문여정단계.같이주문상세 => GroupPurchaseScreenKind.TogetherOrderDetail,
        같이주문여정단계.공급자관계 => GroupPurchaseScreenKind.SupplierRelationshipDetail,
        같이주문여정단계.공급자Membership => GroupPurchaseScreenKind.SupplierMembership,
        같이주문여정단계.긴급수확제안 => GroupPurchaseScreenKind.UrgentHarvestOffer,
        _ => GroupPurchaseScreenKind.UrgentHarvestReview
    };

    private string 제목 => 단계 switch
    {
        같이주문여정단계.레시피활용 => "이 양을 어디에 쓸까요?",
        같이주문여정단계.주문방식비교 => "개별 주문과 같이 주문 비교",
        같이주문여정단계.배송권찾기 => "내 배송권 확인",
        같이주문여정단계.배송권상세 => "배송권 공개 범위",
        같이주문여정단계.같이주문목록 => "이 배송권의 같이 주문",
        같이주문여정단계.같이주문상세 => "같이 주문 상세",
        같이주문여정단계.공급자관계 => "공급자 관계 후보",
        같이주문여정단계.공급자Membership => "공급자 Membership 검토",
        같이주문여정단계.긴급수확제안 => "긴급 수확 제안",
        _ => "긴급 수확 연결 검토"
    };

    private string 설명 => 단계 switch
    {
        같이주문여정단계.레시피활용 => "개인이 받을 검토 수량을 음식별로 나누어 보고 과잉 주문인지 먼저 판단합니다.",
        같이주문여정단계.주문방식비교 => "같은 원 거래단위 기준으로 예상 비용, 더 기다리는 시간과 모집 조건을 함께 봅니다.",
        같이주문여정단계.배송권찾기 => "상세 주소는 공개하지 않고 같이 주문을 묶을 생활권만 확인합니다.",
        같이주문여정단계.배송권상세 => "배송권 안에서 공개되는 집계와 숨겨지는 개인정보를 구분합니다.",
        같이주문여정단계.같이주문목록 => "저장된 배송권 안에서 진행 중인 공개 모집을 상품별로 확인합니다.",
        같이주문여정단계.같이주문상세 => "참여자 식별정보 없이 원 거래단위의 총수량과 다음 가격 구간을 확인합니다.",
        같이주문여정단계.공급자관계 => "같이 주문 원장에서 연결된 공급 후보의 근거와 역할만 먼저 확인합니다.",
        같이주문여정단계.공급자Membership => "월 비용과 예상 혜택을 비교하되 가입과 주문 동의를 분리합니다.",
        같이주문여정단계.긴급수확제안 => "남는 수확 물량을 가격, 기한, 운송 책임이 있는 제안 초안으로 읽습니다.",
        _ => "수량과 역할이 맞는지 확인하고도 자동 계약이나 자동 주문은 실행하지 않습니다."
    };

    private string 경계안내 => 단계 switch
    {
        같이주문여정단계.같이주문상세 =>
            "KAMIS 등 가격 근거의 원 거래단위를 임의로 kg이나 상자로 바꾸지 않습니다. 실제 포장 수와 LCL·FCL은 공급자·포워더 회신 전까지 미판정입니다.",
        같이주문여정단계.공급자Membership =>
            "Membership 관심 등록, 유료 가입과 같이 주문 참여는 서로 다른 동의입니다. 이 화면은 결제나 가입을 실행하지 않습니다.",
        같이주문여정단계.긴급수확제안 or 같이주문여정단계.긴급수확검토 =>
            "긴급성만으로 가격·운송·검수 책임을 생략하지 않습니다. 화면 확인만으로 계약, 배차 또는 결제가 시작되지 않습니다.",
        _ =>
            "이 흐름은 읽기와 비구속 검토 단계입니다. 화면 이동만으로 같이 주문 참여, 결제, 계약 또는 수입 실행이 시작되지 않습니다."
    };

    private string? 이전경로 => 단계 switch
    {
        같이주문여정단계.레시피활용 when _상품 is not null =>
            GroupPurchasePageRoutes.ProductDetailFor(_상품.상품카드Id),
        같이주문여정단계.주문방식비교 when _상품 is not null =>
            GroupPurchasePageRoutes.RecipeUseFor(_상품.상품카드Id),
        같이주문여정단계.배송권찾기 when _상품 is not null =>
            GroupPurchasePageRoutes.OrderModeComparisonFor(_상품.상품카드Id),
        같이주문여정단계.배송권상세 => GroupPurchasePageRoutes.DeliveryScopesRoot,
        같이주문여정단계.같이주문목록 when !string.IsNullOrWhiteSpace(유효배송권키) =>
            GroupPurchasePageRoutes.DeliveryScopeFor(유효배송권키),
        같이주문여정단계.같이주문상세 when !string.IsNullOrWhiteSpace(_같이주문상세?.배송권키) =>
            같이주문목록경로(_같이주문상세.배송권키),
        같이주문여정단계.공급자관계 when !string.IsNullOrWhiteSpace(문맥키) =>
            GroupPurchasePageRoutes.TogetherOrderDetailFor(공급자원천집단키(문맥키)),
        같이주문여정단계.공급자Membership when !string.IsNullOrWhiteSpace(문맥키) =>
            GroupPurchasePageRoutes.SupplierRelationshipFor(문맥키),
        같이주문여정단계.긴급수확제안 when !string.IsNullOrWhiteSpace(문맥키) =>
            GroupPurchasePageRoutes.SupplierRelationshipFor(제안원천공급자키(문맥키)),
        같이주문여정단계.긴급수확검토 when !string.IsNullOrWhiteSpace(문맥키) =>
            GroupPurchasePageRoutes.UrgentHarvestOfferFor(문맥키),
        _ => GroupPurchasePageRoutes.ProductsRoot
    };

    protected override async Task OnParametersSetAsync()
        => await 불러오기Async();

    private async Task 불러오기Async()
    {
        _불러오는중 = 단계 is 같이주문여정단계.레시피활용
            or 같이주문여정단계.주문방식비교
            or 같이주문여정단계.같이주문목록
            or 같이주문여정단계.같이주문상세;
        _오류 = null;
        _상품 = null;
        _레시피 = null;
        _비교 = null;
        _같이주문목록 = [];
        _같이주문상세 = null;

        try
        {
            if (단계 is 같이주문여정단계.레시피활용 or 같이주문여정단계.주문방식비교)
            {
                if (string.IsNullOrWhiteSpace(문맥키))
                {
                    _오류 = "상품 키가 필요합니다.";
                    return;
                }

                _상품 = await 여정ReadService.상품조회Async(문맥키);
                if (_상품 is null)
                {
                    _오류 = "요청한 상품 후보를 찾을 수 없습니다.";
                    return;
                }

                if (단계 == 같이주문여정단계.레시피활용)
                {
                    _레시피 = await 여정ReadService.레시피활용조회Async(_상품);
                }
                else
                {
                    _비교 = await 여정ReadService.주문방식비교Async(_상품);
                }
            }
            else if (단계 == 같이주문여정단계.같이주문목록
                     && !string.IsNullOrWhiteSpace(유효배송권키))
            {
                _같이주문목록 = await 여정ReadService.같이주문목록조회Async(유효배송권키);
            }
            else if (단계 == 같이주문여정단계.같이주문상세)
            {
                if (string.IsNullOrWhiteSpace(문맥키))
                {
                    _오류 = "같이 주문 ID가 필요합니다.";
                    return;
                }

                _같이주문상세 = await 여정ReadService.같이주문상세조회Async(문맥키);
                if (_같이주문상세 is null)
                {
                    _오류 = "요청한 같이 주문을 찾을 수 없습니다.";
                }
            }
        }
        catch (Exception exception)
        {
            _오류 = exception.Message;
        }
        finally
        {
            _불러오는중 = false;
        }
    }

    private Task 다시불러오기Async() => 불러오기Async();

    private RenderFragment 레시피활용화면 => @<div class="together-journey__stack">
        <section class="together-journey__hero">
            <span>개인 수령 검토량</span>
            <strong>@레시피검토수량()</strong>
            <small>@(_상품?.상품명 ?? 문맥키) · 같이 주문 전체 수량과 분리</small>
        </section>
        @if (_레시피 is null)
        {
            <빈상태 제목="연결된 레시피 자료가 없습니다."
                    설명="상품명과 공식 식재료 색인이 연결되면 이 위치에 활용 음식이 표시됩니다." />
        }
        else
        {
            <p class="together-journey__notice">@_레시피.안내</p>
            <div class="together-journey__cards">
                @foreach (var recipe in _레시피.활용음식)
                {
                    <article class="together-journey__card">
                        <span>@recipe.RegionName · @recipe.Category</span>
                        <h2>@recipe.DishName</h2>
                        <p>@recipe.RecipeTitle</p>
                        <dl>
                            <div><dt>재료 사용량</dt><dd>@recipe.IngredientQuantityText @recipe.IngredientUnitText</dd></div>
                            <div><dt>준비</dt><dd>@recipe.PreparationNote</dd></div>
                            <div><dt>출처</dt><dd>@recipe.SourceProvider</dd></div>
                        </dl>
                    </article>
                }
            </div>
        }
        <a class="together-journey__primary" href="@상품비교경로()">현재 수량으로 주문 방식 비교하기</a>
    </div>;

    private RenderFragment 주문방식비교화면 => @<div class="together-journey__stack">
        <section class="together-journey__assumption">
            <strong>비교 입력</strong>
            <span>@비교입력안내()</span>
        </section>
        @if (_비교 is not null)
        {
            <div class="together-journey__comparison">
                <article>
                    <span>개별 주문</span>
                    <strong>@금액(_비교.개별주문.총예상비용)</strong>
                    <small>단위당 @금액(_비교.개별주문.단위당예상비용) / @같이주문수량Presentation.단위(_비교.수량단위)</small>
                </article>
                <article class="is-recommended">
                    <span>같이 주문 예상</span>
