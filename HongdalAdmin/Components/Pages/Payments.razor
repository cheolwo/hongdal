@page "/payments"
@inject I백오피스Service DataService

<PageTitle>05. 결제 관리</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">05. 결제 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Toss 결제 환경과 의뢰별 결제 상태를 확인합니다.</MudText>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField Label="결제상태" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="statusFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField Label="의뢰ID" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="requestIdFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" OnClick="LoadAsync">조회</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (config is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Toss 설정: @(config.IsConfigured ? "설정됨" : "미설정") / @config.BaseUrl
        </MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">결제 목록</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@items.Count 건</MudChip>
            </MudStack>

            @if (items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">조회된 결제가 없습니다.</MudAlert>
            }
            else
            {
                <MudTable Items="@items" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>결제ID</MudTh>
                        <MudTh>의뢰ID</MudTh>
                        <MudTh>금액</MudTh>
                        <MudTh>수단</MudTh>
                        <MudTh>상태</MudTh>
                        <MudTh>생성시각</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="결제ID">@context.결제Id</MudTd>
                        <MudTd DataLabel="의뢰ID">@context.의뢰Id</MudTd>
                        <MudTd DataLabel="금액">@context.결제금액.ToString("N0") 원</MudTd>
                        <MudTd DataLabel="수단">@context.결제수단</MudTd>
                        <MudTd DataLabel="상태">
                            <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.결제상태)" Variant="Variant.Filled">@context.결제상태</MudChip>
                        </MudTd>
                        <MudTd DataLabel="생성시각">@context.생성일시Utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private string? statusFilter;
    private string? requestIdFilter;
    private 토스결제환경응답? config;
    private IReadOnlyList<결제목록응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        config = await DataService.토스결제환경조회Async();
        items = await DataService.결제목록조회Async(statusFilter, requestIdFilter);
    }
}
