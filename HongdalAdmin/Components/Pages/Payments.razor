@page "/payments"
@inject I백오피스Service DataService

<PageTitle>05. 결제 관리</PageTitle>

<h1>05. 결제 관리</h1>

<div class="row g-2 mb-3">
    <div class="col-md-3"><input class="form-control" @bind="statusFilter" placeholder="결제상태" /></div>
    <div class="col-md-3"><input class="form-control" @bind="requestIdFilter" placeholder="의뢰ID" /></div>
    <div class="col-md-3"><button class="btn btn-primary" @onclick="LoadAsync">조회</button></div>
</div>

@if (config is not null)
{
    <div class="alert alert-info">Toss 설정: @(config.IsConfigured ? "설정됨" : "샘플/미설정") / @config.BaseUrl</div>
}

<table class="table table-striped table-hover">
    <thead><tr><th>결제ID</th><th>의뢰ID</th><th>금액</th><th>수단</th><th>상태</th><th>생성시각</th></tr></thead>
    <tbody>
        @foreach (var item in items)
        {
            <tr><td>@item.결제Id</td><td>@item.의뢰Id</td><td>@item.결제금액.ToString("N0") 원</td><td>@item.결제수단</td><td>@item.결제상태</td><td>@item.생성일시Utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>
        }
    </tbody>
</table>

@code {
    private string? statusFilter;
    private string? requestIdFilter;
    private 토스결제환경응답? config;
    private IReadOnlyList<결제목록응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        config = await DataService.토스결제환경조회Async();
        items = await DataService.결제목록조회Async(statusFilter, requestIdFilter);
    }
}
