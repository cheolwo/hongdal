@page "/revenue-policies"

<PageTitle>구독료 운영 정책</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h4">구독료 운영 정책</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                플랫폼 수익은 구독료를 중심으로 보고, API 비용과 서버 비용을 넘는 여유가 생기면 다음 구독료를 낮추는 방식으로 운영합니다.
            </MudText>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" lg="7">
                <MudPaper Class="pa-4 h-100" Elevation="1">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">구독 수익과 운영비</MudText>

                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="int"
                                                 Label="활성 구독자"
                                                 @bind-Value="activeSubscriberCount"
                                                 Min="0"
                                                 Step="1"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="명" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal"
                                                 Label="현재 월 구독료"
                                                 @bind-Value="monthlySubscriptionFee"
                                                 Min="0"
                                                 Step="1000m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="원" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="decimal"
                                                 Label="API 사용 비용"
                                                 @bind-Value="apiUsageCost"
                                                 Min="0"
                                                 Step="10000m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="원" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="decimal"
                                                 Label="서버 이용 비용"
                                                 @bind-Value="serverCost"
                                                 Min="0"
                                                 Step="10000m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="원" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="decimal"
                                                 Label="기타 운영비"
                                                 @bind-Value="otherOperatingCost"
                                                 Min="0"
                                                 Step="10000m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="원" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal"
                                                 Label="유지할 최소 여유액"
                                                 @bind-Value="minimumOperatingBuffer"
                                                 Min="0"
                                                 Step="10000m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="원" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal"
                                                 Label="최소 구독료"
                                                 @bind-Value="minimumSubscriptionFee"
                                                 Min="0"
                                                 Step="1000m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="원" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal"
                                                 Label="비용 상승 완충률"
                                                 @bind-Value="costIncreaseBufferPercent"
                                                 Min="0"
                                                 Max="100"
                                                 Step="1m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="%" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal"
                                                 Label="월 인하 한도"
                                                 @bind-Value="maximumMonthlyReduction"
                                                 Min="0"
                                                 Step="1000m"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="원" />
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="5">
                <MudPaper Class="pa-4 h-100" Elevation="1">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">다음 구독료 판단</MudText>

                        <MudStack Spacing="2">
                            @MetricRow("월 구독 수익", 금액표시(SubscriptionRevenue))
                            @MetricRow("월 운영 비용", 금액표시(TotalOperatingCost))
                            @MetricRow("완충 운영 비용", 금액표시(BufferedOperatingCost))
                            @MetricRow("운영비 차감 후 금액", 금액표시(OperatingSurplus))
                            @MetricRow("안전 인하 가능 재원", 금액표시(SafeReductionPool))
                            @MetricRow("권장 월 구독료", 금액표시(RecommendedSubscriptionFee), true)
                        </MudStack>

                        <MudAlert Severity="@DecisionSeverity" Variant="Variant.Outlined">
                            @DecisionMessage
                        </MudAlert>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">운영 원칙</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    별도 환원 항목을 전면에 내세우기보다, 구독료가 비용 구조에 맞춰 자연스럽게 내려가도록 관리합니다.
                    구독 수익이 API 비용, 서버 비용, 기타 운영비, 비용 상승 완충률, 최소 여유액을 충분히 넘으면 다음 구독료를 낮추고,
                    그렇지 않으면 현재 구독료를 유지합니다. 비용이 다시 늘어날 수 있으므로 한 번에 큰 폭으로 낮추지 않고 월 인하 한도를 둡니다.
                </MudText>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private int activeSubscriberCount = 120;
    private decimal monthlySubscriptionFee = 9_900m;
    private decimal apiUsageCost = 230_000m;
    private decimal serverCost = 180_000m;
    private decimal otherOperatingCost = 90_000m;
    private decimal minimumOperatingBuffer = 250_000m;
    private decimal minimumSubscriptionFee = 4_900m;
    private decimal costIncreaseBufferPercent = 25m;
    private decimal maximumMonthlyReduction = 1_000m;

    private decimal SubscriptionRevenue => activeSubscriberCount * monthlySubscriptionFee;

    private decimal TotalOperatingCost => apiUsageCost + serverCost + otherOperatingCost;

    private decimal BufferedOperatingCost => decimal.Round(TotalOperatingCost * (1m + costIncreaseBufferPercent / 100m), 0, MidpointRounding.AwayFromZero);

    private decimal OperatingSurplus => SubscriptionRevenue - TotalOperatingCost;

    private decimal SafeReductionPool => Math.Max(0m, SubscriptionRevenue - BufferedOperatingCost - minimumOperatingBuffer);

    private decimal RawPerSubscriberReduction => activeSubscriberCount <= 0
        ? 0m
        : decimal.Round(SafeReductionPool / activeSubscriberCount, 0, MidpointRounding.ToZero);

    private decimal PerSubscriberReduction => Math.Min(maximumMonthlyReduction, RawPerSubscriberReduction);

    private decimal RecommendedSubscriptionFee => Math.Max(minimumSubscriptionFee, monthlySubscriptionFee - PerSubscriberReduction);

    private Severity DecisionSeverity => RecommendedSubscriptionFee < monthlySubscriptionFee ? Severity.Success : Severity.Info;

    private string DecisionMessage
    {
        get
        {
            if (activeSubscriberCount <= 0)
            {
                return "활성 구독자가 없어 구독료 인하 판단을 할 수 없습니다.";
            }

            if (OperatingSurplus <= 0)
            {
                return "현재 구독 수익이 운영 비용을 넘지 못합니다. 구독료를 유지해야 합니다.";
            }

            if (SafeReductionPool <= 0)
            {
                return "현재는 운영비를 넘지만 비용 상승 완충률과 최소 여유액을 반영하면 인하 여지가 없습니다. 구독료를 유지합니다.";
            }

            if (RawPerSubscriberReduction > maximumMonthlyReduction)
            {
                return $"비용 상승 완충률과 최소 여유액을 반영해도 인하 여지가 있습니다. 다만 비용 변동을 고려해 이번 권고는 구독자당 {maximumMonthlyReduction:N0}원 한도로 제한합니다.";
            }

            return $"비용 상승 완충률과 최소 여유액을 반영하면 구독자당 약 {PerSubscriberReduction:N0}원 인하 여지가 있습니다.";
        }
    }

    private static string 금액표시(decimal amount) => $"{amount:N0}원";

    private static RenderFragment MetricRow(string label, string value, bool emphasis = false) => builder =>
    {
        var sequence = 0;
        builder.OpenComponent<MudStack>(sequence++);
        builder.AddAttribute(sequence++, "Row", true);
        builder.AddAttribute(sequence++, "AlignItems", AlignItems.Center);
        builder.AddAttribute(sequence++, "Justify", Justify.SpaceBetween);
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(childBuilder =>
        {
            var childSequence = 0;
            childBuilder.OpenComponent<MudText>(childSequence++);
            childBuilder.AddAttribute(childSequence++, "Typo", Typo.body2);
            childBuilder.AddAttribute(childSequence++, "Color", Color.Secondary);
            childBuilder.AddAttribute(childSequence++, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, label)));
            childBuilder.CloseComponent();

            childBuilder.OpenComponent<MudText>(childSequence++);
            childBuilder.AddAttribute(childSequence++, "Typo", emphasis ? Typo.subtitle1 : Typo.body2);
            childBuilder.AddAttribute(childSequence++, "Class", emphasis ? "fw-bold" : string.Empty);
            childBuilder.AddAttribute(childSequence++, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, value)));
            childBuilder.CloseComponent();
        }));
        builder.CloseComponent();
    };
}
