@page "/settlements"
@inject I백오피스Service DataService

<PageTitle>08. 정산 관리</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">08. 정산 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">기사 월정산 후보와 이용료 상태를 확인합니다.</MudText>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="2">
                <MudNumericField T="int" Label="년도" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="year" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="int" Label="월" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" @bind-Value="month" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField Label="기사ID" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="driverIdFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Disabled="@isLoading" FullWidth="true" OnClick="LoadAsync">조회</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudAlert Severity="Severity.Info">기사 월정산 데이터를 불러오는 중입니다...</MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">기사 월정산</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@items.Count 건</MudChip>
                </MudStack>

                @if (items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">조회된 월정산 데이터가 없습니다.</MudAlert>
                }
                else
                {
                    <MudTable Items="@items" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>기사ID</MudTh>
                            <MudTh>년월</MudTh>
                            <MudTh>배차건수</MudTh>
                            <MudTh>이용료</MudTh>
                            <MudTh>월 5,000원 상한</MudTh>
                            <MudTh>결제완료</MudTh>
                            <MudTh>갱신시각</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="기사ID">@context.기사Id</MudTd>
                            <MudTd DataLabel="년월">@context.년도-@context.월.ToString("00")</MudTd>
                            <MudTd DataLabel="배차건수">@context.배차건수</MudTd>
                            <MudTd DataLabel="이용료">@context.이용료.ToString("N0") 원</MudTd>
                            <MudTd DataLabel="월 5,000원 상한">@(context.월상한적용여부 ? "적용" : "미적용")</MudTd>
                            <MudTd DataLabel="결제완료">
                                <MudChip T="string" Size="Size.Small" Color="@(context.결제완료 ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                                    @(context.결제완료 ? "완료" : "미완료")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="갱신시각">@context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private int year = DateTime.UtcNow.Year;
    private int month = DateTime.UtcNow.Month;
    private string? driverIdFilter;
    private IReadOnlyList<기사월정산관리응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            items = await DataService.기사월정산목록조회Async(year, month, driverIdFilter);
        }
        catch (Exception ex)
        {
            errorMessage = $"기사 월정산 조회 실패: {ex.Message}";
            items = [];
        }
        finally
        {
            isLoading = false;
        }
    }
}
