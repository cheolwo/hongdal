@page "/settlements"
@inject I백오피스Service DataService

<PageTitle>08. 정산 관리</PageTitle>

<h1>08. 정산 관리</h1>

<div class="row g-2 mb-3">
    <div class="col-md-2"><input class="form-control" type="number" @bind="year" placeholder="년도" /></div>
    <div class="col-md-2"><input class="form-control" type="number" @bind="month" placeholder="월" /></div>
    <div class="col-md-3"><input class="form-control" @bind="driverIdFilter" placeholder="기사ID" /></div>
    <div class="col-md-3"><button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">조회</button></div>
</div>

@if (isLoading)
{
    <p>기사 월정산 데이터를 불러오는 중입니다...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead><tr><th>기사ID</th><th>년월</th><th>배차건수</th><th>이용료</th><th>월 5,000원 상한</th><th>결제완료</th><th>갱신시각</th></tr></thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.기사Id</td>
                    <td>@item.년도-@item.월.ToString("00")</td>
                    <td>@item.배차건수</td>
                    <td>@item.이용료.ToString("N0") 원</td>
                    <td>@(item.월상한적용여부 ? "적용" : "미적용")</td>
                    <td>@(item.결제완료 ? "Y" : "N")</td>
                    <td>@item.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private int year = DateTime.UtcNow.Year;
    private int month = DateTime.UtcNow.Month;
    private string? driverIdFilter;
    private IReadOnlyList<기사월정산관리응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            items = await DataService.기사월정산목록조회Async(year, month, driverIdFilter);
        }
        catch (Exception ex)
        {
            errorMessage = $"기사 월정산 조회 실패: {ex.Message}";
            items = [];
        }
        finally
        {
            isLoading = false;
        }
    }
}
