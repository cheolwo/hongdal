@page "/transports/{RequestId}"
@inject I백오피스Service DataService
@inject NavigationManager NavigationManager

<PageTitle>1.0 운송 관제 개요</PageTitle>

<div class="d-flex justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="mb-1">06-1. 1.0 운송 관제 개요</h1>
        <div class="text-muted">진행 단계와 운영 확인 항목을 중심으로 봅니다.</div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/transports"))">운송 목록</button>
        <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">새로고침</button>
    </div>
</div>

@if (isLoading)
{
    <div class="alert alert-info">관제 정보를 불러오는 중입니다...</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (detail is null)
{
    <div class="alert alert-warning">의뢰 @RequestId 관제 정보를 찾지 못했습니다.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                <div>
                    <div class="text-muted small">의뢰ID</div>
                    <h2 class="h4 mb-1">@detail.의뢰Id</h2>
                    <div>@detail.경로표시</div>
                    <div class="text-muted small">@detail.운송방식 · 화주 @관리자화면Ui.표시값(detail.화주Id)</div>
                </div>
                <span class="@관리자화면Ui.색상Badge(detail.현재상태색상)">@detail.현재상태라벨</span>
            </div>
            <div class="alert alert-info mt-3 mb-0">
                <strong>관리자 다음 행동</strong>
                <div>@detail.관리자다음행동</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @foreach (var step in detail.단계목록)
        {
            <div class="col-md-6 col-xl-3">
                <div class="card h-100 border-@step.색상">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="text-muted small">@step.순번. @step.제목</div>
                            <span class="@관리자화면Ui.색상Badge(step.색상)">@StepLabel(step)</span>
                        </div>
                        <div class="fw-semibold mt-2">@step.상태</div>
                        <div class="small text-muted mt-1">@step.설명</div>
                        <div class="small mt-2">@step.증빙</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">운영 확인</h5>
                        <span class="badge rounded-pill text-bg-primary">@detail.운영확인목록.Count 건</span>
                    </div>
                    @if (detail.운영확인목록.Count == 0)
                    {
                        <div class="alert alert-success mb-0">현재 즉시 확인할 운영 항목이 없습니다.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead><tr><th>구분</th><th>우선도</th><th>조치 안내</th></tr></thead>
                                <tbody>
                                @foreach (var item in detail.운영확인목록)
                                {
                                    <tr>
                                        <td>@item.구분</td>
                                        <td><span class="badge rounded-pill @(item.우선도 == "높음" ? "text-bg-danger" : "text-bg-warning")">@item.우선도</span></td>
                                        <td>@item.조치안내</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">연결 화면</h5>
                    <div class="list-group list-group-flush">
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0" href="@EventsHref">
                            <span>이벤트 로그</span>
                            <span class="badge rounded-pill text-bg-secondary">@detail.이벤트목록.Count</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0" href="@ProofsHref">
                            <span>증빙/POD</span>
                            <span class="badge rounded-pill text-bg-secondary">@detail.증빙목록.Count</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0" href="@SettlementHref">
                            <span>결제/정산</span>
                            <span class="badge rounded-pill text-bg-secondary">@detail.정산후보목록.Count</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;

    private bool isLoading = true;
    private string? errorMessage;
    private 운송워크플로우관제상세응답? detail;

    private string EventsHref => BuildSubPageHref("events");
    private string ProofsHref => BuildSubPageHref("proofs");
    private string SettlementHref => BuildSubPageHref("settlement");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            detail = null;
            errorMessage = "의뢰ID가 없습니다.";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            detail = await DataService.운송워크플로우관제상세조회Async(RequestId);
        }
        catch (Exception ex)
        {
            detail = null;
            errorMessage = $"관제 개요 조회 실패: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildSubPageHref(string segment)
        => $"/transports/{Uri.EscapeDataString(RequestId)}/{segment}";

    private static string StepLabel(운송워크플로우단계응답 step)
    {
        if (step.확인필요)
        {
            return "확인필요";
        }

        if (step.완료됨)
        {
            return "완료";
        }

        if (step.진행중)
        {
            return "진행중";
        }

        return "대기";
    }

}
