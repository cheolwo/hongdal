@page "/partners"
@inject I백오피스Service DataService

<PageTitle>11. 업체/화주 관리</PageTitle>

<h1>11. 업체/화주 관리</h1>

<div class="row g-2 mb-3"><div class="col-md-3"><input class="form-control" @bind="statusFilter" placeholder="업체 상태" /></div><div class="col-md-3"><button class="btn btn-primary" @onclick="LoadAsync">조회</button></div></div>

<div class="row g-3">
    <div class="col-lg-6">
        <h5>업체 목록</h5>
        <table class="table table-striped"><thead><tr><th>업체명</th><th>상태</th><th>연락처</th><th>담당자</th></tr></thead><tbody>
        @foreach (var item in companies)
        {
            <tr><td>@item.업체명</td><td>@item.상태</td><td>@item.대표연락처</td><td>@item.담당자</td></tr>
        }
        </tbody></table>
    </div>
    <div class="col-lg-6">
        <h5>화주 계정</h5>
        <table class="table table-striped"><thead><tr><th>사용자명</th><th>이메일</th><th>연락처</th><th>의뢰건수</th><th>상태</th></tr></thead><tbody>
        @foreach (var item in shippers)
        {
            <tr><td>@item.사용자명</td><td>@item.이메일</td><td>@item.연락처</td><td>@item.의뢰건수</td><td>@item.거래상태</td></tr>
        }
        </tbody></table>
    </div>
</div>

@code {
    private string? statusFilter;
    private IReadOnlyList<업체관리응답> companies = [];
    private IReadOnlyList<화주관리응답> shippers = [];
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        companies = await DataService.업체목록조회Async(statusFilter);
        shippers = await DataService.화주목록조회Async();
    }
}
