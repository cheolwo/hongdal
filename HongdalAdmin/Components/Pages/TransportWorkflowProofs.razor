@page "/transports/{RequestId}/proofs"
@inject I백오피스Service DataService
@inject NavigationManager NavigationManager

<PageTitle>1.0 운송 증빙/POD</PageTitle>

<div class="d-flex justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="mb-1">06-1. 운송 증빙/POD</h1>
        <div class="text-muted">상차·하차 사진과 인수증 파일의 업로드 상태를 확인합니다.</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo(OverviewHref))">관제 개요</button>
        <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">새로고침</button>
    </div>
</div>

@if (isLoading)
{
    <div class="alert alert-info">증빙 정보를 불러오는 중입니다...</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (detail is null)
{
    <div class="alert alert-warning">의뢰 @RequestId 관제 정보를 찾지 못했습니다.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                <div>
                    <div class="text-muted small">의뢰ID</div>
                    <h2 class="h5 mb-1">@detail.의뢰Id</h2>
                    <div>@detail.경로표시</div>
                </div>
                <span class="@관리자화면Ui.색상Badge(detail.현재상태색상)">@detail.현재상태라벨</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">증빙/POD</h5>
                <span class="badge rounded-pill text-bg-primary">@detail.증빙목록.Count 건</span>
            </div>
            @if (detail.증빙목록.Count == 0)
            {
                <div class="alert alert-warning mb-0">업로드된 증빙이 없습니다. 운송 완료 상태라면 기사 앱 업로드 결과를 확인하세요.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr><th>종류</th><th>파일명</th><th>상태</th><th>업로드</th><th>저장 위치</th></tr></thead>
                        <tbody>
                        @foreach (var item in detail.증빙목록)
                        {
                            <tr>
                                <td>@item.FileType</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Url) && item.Url != "#")
                                    {
                                        <a href="@item.Url" target="_blank" rel="noreferrer">@item.OriginalFileName</a>
                                    }
                                    else
                                    {
                                        @관리자화면Ui.표시값(item.OriginalFileName)
                                    }
                                </td>
                                <td><span class="@관리자화면Ui.상태Badge(item.UploadStatus)">@관리자화면Ui.표시값(item.UploadStatus)</span></td>
                                <td>@item.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small text-muted">@관리자화면Ui.표시값(item.BucketName) / @관리자화면Ui.표시값(item.ObjectName)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a class="btn btn-outline-primary" href="@EventsHref">이벤트 로그</a>
        <a class="btn btn-outline-primary" href="@SettlementHref">결제/정산</a>
    </div>
}

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;

    private bool isLoading = true;
    private string? errorMessage;
    private 운송워크플로우관제상세응답? detail;

    private string OverviewHref => BuildHref(null);
    private string EventsHref => BuildHref("events");
    private string SettlementHref => BuildHref("settlement");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            detail = null;
            errorMessage = "의뢰ID가 없습니다.";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            detail = await DataService.운송워크플로우관제상세조회Async(RequestId);
        }
        catch (Exception ex)
        {
            detail = null;
            errorMessage = $"증빙/POD 조회 실패: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildHref(string? segment)
    {
        var baseHref = $"/transports/{Uri.EscapeDataString(RequestId)}";
        return string.IsNullOrWhiteSpace(segment) ? baseHref : $"{baseHref}/{segment}";
    }

}
