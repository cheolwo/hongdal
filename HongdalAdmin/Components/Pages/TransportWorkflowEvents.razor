@page "/transports/{RequestId}/events"
@inject I백오피스Service DataService
@inject NavigationManager NavigationManager

<PageTitle>1.0 운송 이벤트 로그</PageTitle>

<div class="d-flex justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="mb-1">06-1. 운송 이벤트 로그</h1>
        <div class="text-muted">서버에 남은 이벤트 시각과 메타데이터를 확인합니다.</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo(OverviewHref))">관제 개요</button>
        <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">새로고침</button>
    </div>
</div>

@if (isLoading)
{
    <div class="alert alert-info">이벤트 로그를 불러오는 중입니다...</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (detail is null)
{
    <div class="alert alert-warning">의뢰 @RequestId 관제 정보를 찾지 못했습니다.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                <div>
                    <div class="text-muted small">의뢰ID</div>
                    <h2 class="h5 mb-1">@detail.의뢰Id</h2>
                    <div>@detail.경로표시</div>
                </div>
                <span class="@관리자화면Ui.색상Badge(detail.현재상태색상)">@detail.현재상태라벨</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">이벤트 로그</h5>
                <span class="badge rounded-pill text-bg-primary">@detail.이벤트목록.Count 건</span>
            </div>
            @if (detail.이벤트목록.Count == 0)
            {
                <div class="alert alert-secondary mb-0">등록된 이벤트가 없습니다.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr><th>시각</th><th>이벤트</th><th>메타데이터</th></tr></thead>
                        <tbody>
                        @foreach (var item in detail.이벤트목록)
                        {
                            <tr>
                                <td>@item.이벤트시각.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.이벤트타입</td>
                                <td class="small text-break">@관리자화면Ui.표시값(item.메타데이터)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a class="btn btn-outline-primary" href="@ProofsHref">증빙/POD</a>
        <a class="btn btn-outline-primary" href="@SettlementHref">결제/정산</a>
    </div>
}

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;

    private bool isLoading = true;
    private string? errorMessage;
    private 운송워크플로우관제상세응답? detail;

    private string OverviewHref => BuildHref(null);
    private string ProofsHref => BuildHref("proofs");
    private string SettlementHref => BuildHref("settlement");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            detail = null;
            errorMessage = "의뢰ID가 없습니다.";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            detail = await DataService.운송워크플로우관제상세조회Async(RequestId);
        }
        catch (Exception ex)
        {
            detail = null;
            errorMessage = $"이벤트 로그 조회 실패: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildHref(string? segment)
    {
        var baseHref = $"/transports/{Uri.EscapeDataString(RequestId)}";
        return string.IsNullOrWhiteSpace(segment) ? baseHref : $"{baseHref}/{segment}";
    }

}
