@page "/cargo"
@inject I백오피스Service DataService

<PageTitle>11. 공개 화물정보</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">11. 공개 화물정보</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">비회원도 조회 가능한 공개 화물 요약 목록입니다. 상세 정보는 로그인 후 확인할 수 있습니다.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@isLoading" OnClick="LoadAsync">새로고침</MudButton>
    </MudStack>

    @if (isLoading)
    {
        <MudAlert Severity="Severity.Info">공개 화물 요약을 불러오는 중입니다...</MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">공개된 화물정보가 없습니다.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var item in items)
            {
                <MudItem xs="12" lg="6">
                    <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                        <MudStack Spacing="2">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">@item.화물종류</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.의뢰Id</MudText>
                            </MudStack>
                            <MudDivider />
                            <AdminInfoField Label="운송방식" Value="@item.운송방식" />
                            <AdminInfoField Label="차량종류" Value="@item.차량종류" />
                            <AdminInfoField Label="수량" Value="@(item.화물수량?.ToString() ?? "-")" />
                            <AdminInfoField Label="중량" Value="@(item.화물중량Kg is null ? "-" : $"{item.화물중량Kg:N1} Kg")" />
                            <AdminInfoField Label="의뢰상태" Value="@item.의뢰상태" />
                            <AdminInfoField Label="배차상태" Value="@item.배차상태" />
                            <AdminInfoField Label="등록일시" Value="@item.생성일시.ToLocalTime().ToString("yyyy-MM-dd HH:mm")" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private IReadOnlyList<공개화물요약응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            items = await DataService.공개화물요약조회Async();
        }
        catch (Exception ex)
        {
            errorMessage = $"공개 화물 조회 실패: {ex.Message}";
            items = [];
        }
        finally
        {
            isLoading = false;
        }
    }
}
