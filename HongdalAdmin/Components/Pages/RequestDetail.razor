@page "/requests/{RequestId}"
@using Hongdal.Client.Infrastructure.Transport
@inject I백오피스Service DataService
@inject ITransportRequestLedgerObserver LedgerObserver
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>의뢰 상세</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">04-1. 의뢰 상세</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">화주 의뢰 원장의 결제, 배차, 정산 값을 확인합니다.</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/requests"))">의뢰 목록</MudButton>
            <MudButton Href="@WorkflowDetailHref" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Route">1.0 관제 개요</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@isLoading" OnClick="LoadAsync">새로고침</MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@MessageSeverity">@message</MudAlert>
    }

    @if (isLoading)
    {
        <MudAlert Severity="Severity.Info">의뢰 상세를 불러오는 중입니다...</MudAlert>
    }
    else if (request is null)
    {
        <MudAlert Severity="Severity.Warning">의뢰 @RequestId 정보를 찾지 못했습니다.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">의뢰ID</MudText>
                    <MudText Typo="Typo.h4">@request.의뢰Id</MudText>
                    <MudText Typo="Typo.body1">@request.픽업지 → @request.하차지</MudText>
                </MudStack>
                <MudChip T="string" Color="@ReviewColor(request)" Variant="Variant.Filled">@ReviewLabel(request)</MudChip>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="6">
                <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">의뢰 상태</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6"><AdminInfoField Label="의뢰 상태" Value="@request.의뢰상태" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="운송 방식" Value="@request.운송방식" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="배차 상태" Value="@request.배차상태" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="증빙 방식" Value="@request.증빙방식" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="생성 시각" Value="@request.생성일시.ToLocalTime().ToString("yyyy-MM-dd HH:mm")" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="화물" Value="@request.요약?.화물종류" /></MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="6">
                <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">결제/정산</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6"><AdminInfoField Label="결제 상태" Value="@request.결제상태" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="결제 수단" Value="@request.결제수단" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="정산 상태" Value="@request.정산상태" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="정산 시점" Value="@request.정산시점" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="최종 운임" Value="@(request.최종운임 is null ? null : $"{request.최종운임:N0}원")" /></MudItem>
                            <MudItem xs="12" md="6"><AdminInfoField Label="수납 주체" Value="@request.수납주체" /></MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">상차/하차</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" lg="6"><AdminInfoField Label="상차지" Value="@BuildAddress(request.픽업지, request.픽업상세지)" /></MudItem>
                    <MudItem xs="12" lg="6"><AdminInfoField Label="하차지" Value="@BuildAddress(request.하차지, request.하차상세지)" /></MudItem>
                    <MudItem xs="12" md="6"><AdminInfoField Label="상차 좌표" Value="@BuildPoint(request.픽업위도, request.픽업경도)" /></MudItem>
                    <MudItem xs="12" md="6"><AdminInfoField Label="하차 좌표" Value="@BuildPoint(request.하차위도, request.하차경도)" /></MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">취소/환불</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">취소 또는 환불이 필요한 의뢰만 처리합니다.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" Disabled="@isSaving" OnClick="CancelAsync">취소/환불 처리</MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool isSaving;
    private bool isError;
    private string? message;
    private 화주운송의뢰응답? request;
    private Severity MessageSeverity => isError ? Severity.Error : Severity.Success;
    private CancellationTokenSource? pollingCts;

    private string WorkflowDetailHref => $"/transports/{Uri.EscapeDataString(RequestId)}";

    protected override async Task OnParametersSetAsync()
    {
        EnsureObserverStarted();
        await LoadAsync();
    }

    private Task LoadAsync() => LoadAsync(showMessage: true);

    private async Task LoadAsync(bool showMessage)
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            request = null;
            isLoading = false;
            return;
        }

        isLoading = true;
        if (showMessage)
        {
            message = null;
        }

        try
        {
            request = await DataService.의뢰상세조회Async(RequestId);
            isError = false;
        }
        catch (Exception ex)
        {
            if (showMessage)
            {
                isError = true;
                message = $"의뢰 상세 조회 실패: {ex.Message}";
            }
            request = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CancelAsync()
    {
        if (request is null)
        {
            return;
        }

        isSaving = true;
        message = null;

        try
        {
            request = await DataService.의뢰취소환불처리Async(request.의뢰Id);
            isError = false;
            message = "취소/환불 처리했습니다.";
        }
        catch (Exception ex)
        {
            isError = true;
            message = $"취소/환불 처리 실패: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EnsureObserverStarted()
    {
        if (pollingCts is not null)
        {
            return;
        }

        LedgerObserver.Changed += OnLedgerChanged;
        LedgerObserver.RefreshRequested += OnLedgerRefreshRequested;
        pollingCts = new CancellationTokenSource();
        _ = RunPollingAsync(pollingCts.Token);
    }

    private async Task RunPollingAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (string.IsNullOrWhiteSpace(RequestId) || isLoading || isSaving)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    await LoadAsync(showMessage: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnLedgerChanged(TransportRequestLedgerChange change)
    {
        if (!IsCurrentRequest(change.RequestId))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync(showMessage: false);
            StateHasChanged();
        });
    }

    private void OnLedgerRefreshRequested(TransportRequestLedgerRefreshRequest request)
    {
        if (!IsCurrentRequest(request.RequestId))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync(showMessage: false);
            StateHasChanged();
        });
    }

    private bool IsCurrentRequest(string requestId)
        => !string.IsNullOrWhiteSpace(RequestId)
           && string.Equals(RequestId.Trim(), requestId.Trim(), StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        LedgerObserver.Changed -= OnLedgerChanged;
        LedgerObserver.RefreshRequested -= OnLedgerRefreshRequested;
        pollingCts?.Cancel();
        pollingCts?.Dispose();
    }

    private static string ReviewLabel(화주운송의뢰응답 item)
    {
        if (IsMatch(item.의뢰상태, "취소", "환불"))
        {
            return "취소/환불";
        }

        if (IsMatch(item.결제상태, "결제대기", "미결제", "대기"))
        {
            return "결제확인";
        }

        if (IsMatch(item.배차상태, "매칭중", "배차대기", "대기"))
        {
            return "배차확인";
        }

        return "정상";
    }

    private static Color ReviewColor(화주운송의뢰응답 item)
        => ReviewLabel(item) switch
        {
            "취소/환불" => Color.Error,
            "결제확인" => Color.Warning,
            "배차확인" => Color.Info,
            _ => Color.Success
        };

    private static string BuildAddress(string? address, string? detail)
    {
        if (string.IsNullOrWhiteSpace(detail))
        {
            return 관리자화면Ui.표시값(address);
        }

        return $"{관리자화면Ui.표시값(address)} {detail}";
    }

    private static string BuildPoint(decimal? latitude, decimal? longitude)
        => latitude is null || longitude is null ? "-" : $"{latitude:F6}, {longitude:F6}";

    private static bool IsMatch(string? value, params string[] candidates)
    {
        return candidates.Any(candidate => string.Equals(value, candidate, StringComparison.OrdinalIgnoreCase));
    }
}
