@page "/common-contents"
@inject I백오피스Service DataService

<PageTitle>15. 공통콘텐츠 관리</PageTitle>

<h1>15. 공통콘텐츠 관리</h1>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">콘텐츠 목록</h5>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">새로고침</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>제목</th>
                                <th>유형</th>
                                <th>노출위치</th>
                                <th>활성</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in contents)
                            {
                                <tr style="cursor:pointer" @onclick="() => SelectAsync(item.Id)">
                                    <td>@item.Id</td>
                                    <td>@item.제목</td>
                                    <td>@item.콘텐츠유형</td>
                                    <td>@item.노출위치</td>
                                    <td>
                                        <input type="checkbox" checked="@item.활성화여부" @onchange="async e => await ToggleActiveAsync(item.Id, (bool?)e.Value ?? false)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">콘텐츠 등록/수정</h5>

                <div class="mb-2">
                    <label class="form-label">제목</label>
                    <input class="form-control" @bind="model.제목" />
                </div>

                <div class="mb-2">
                    <label class="form-label">설명</label>
                    <textarea class="form-control" rows="2" @bind="model.설명"></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label">콘텐츠 유형</label>
                    <select class="form-select" @bind="model.콘텐츠유형">
                        @foreach (var type in Enum.GetValues<계약홍달콘텐츠유형>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label">이미지 URL</label>
                    <input class="form-control" @bind="model.이미지Url" />
                </div>

                <div class="mb-2">
                    <label class="form-label">영상 URL</label>
                    <input class="form-control" @bind="model.영상Url" />
                </div>

                <div class="mb-2">
                    <label class="form-label">외부링크 URL</label>
                    <input class="form-control" @bind="model.외부링크Url" />
                </div>

                <div class="mb-2">
                    <label class="form-label d-block">노출위치</label>
                    @foreach (var placement in Enum.GetValues<계약홍달노출위치>().Where(x => x != 계약홍달노출위치.없음))
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@HasPlacement(placement)" @onchange="e => SetPlacement(placement, (bool?)e.Value ?? false)" />
                            <label class="form-check-label">@placement</label>
                        </div>
                    }
                </div>

                <div class="mb-2">
                    <label class="form-label d-block">노출대상</label>
                    <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" @bind="model.기사노출" /><label class="form-check-label">기사</label></div>
                    <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" @bind="model.화주노출" /><label class="form-check-label">화주</label></div>
                    <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" @bind="model.운영자노출" /><label class="form-check-label">운영자</label></div>
                </div>

                <div class="mb-2">
                    <label class="form-label">보상정책</label>
                    <select class="form-select" @bind="rewardPolicyIdText">
                        <option value="">없음</option>
                        @foreach (var policy in rewardPolicies)
                        {
                            <option value="@policy.Id">@policy.Id - @policy.보상유형</option>
                        }
                    </select>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="model.활성화여부" />
                    <label class="form-check-label">활성화</label>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync">@(selectedId.HasValue ? "수정" : "등록")</button>
                    <button class="btn btn-outline-secondary" @onclick="ResetForm">신규</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">@message</div>
}

@code {
    private IReadOnlyList<관리자공통콘텐츠요약응답> contents = [];
    private IReadOnlyList<공통콘텐츠보상정책Dto> rewardPolicies = [];
    private 관리자공통콘텐츠저장요청 model = new();
    private long? selectedId;
    private string? rewardPolicyIdText;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        rewardPolicies = await DataService.공통콘텐츠보상정책목록조회Async();
        contents = await DataService.공통콘텐츠목록조회Async();
    }

    private async Task SelectAsync(long id)
    {
        var detail = await DataService.공통콘텐츠상세조회Async(id);
        if (detail is null)
        {
            return;
        }

        selectedId = detail.Id;
        model = new 관리자공통콘텐츠저장요청
        {
            제목 = detail.제목,
            설명 = detail.설명,
            콘텐츠유형 = detail.콘텐츠유형,
            이미지Url = detail.이미지Url,
            영상Url = detail.영상Url,
            외부링크Url = detail.외부링크Url,
            노출위치 = detail.노출위치,
            기사노출 = detail.기사노출,
            화주노출 = detail.화주노출,
            운영자노출 = detail.운영자노출,
            활성화여부 = detail.활성화여부,
            노출시작시각 = detail.노출시작시각,
            노출종료시각 = detail.노출종료시각,
            보상정책Id = detail.보상정책?.Id
        };

        rewardPolicyIdText = detail.보상정책?.Id.ToString();
    }

    private async Task SaveAsync()
    {
        model.보상정책Id = long.TryParse(rewardPolicyIdText, out var policyId) ? policyId : null;

        if (selectedId.HasValue)
        {
            await DataService.공통콘텐츠수정Async(selectedId.Value, model);
            message = "콘텐츠를 수정했습니다.";
        }
        else
        {
            await DataService.공통콘텐츠등록Async(model);
            message = "콘텐츠를 등록했습니다.";
        }

        await LoadAsync();
    }

    private async Task ToggleActiveAsync(long id, bool enabled)
    {
        await DataService.공통콘텐츠활성화변경Async(id, enabled);
        await LoadAsync();
    }

    private bool HasPlacement(계약홍달노출위치 placement)
        => (model.노출위치 & placement) == placement;

    private void SetPlacement(계약홍달노출위치 placement, bool enabled)
    {
        if (enabled)
        {
            model.노출위치 |= placement;
            return;
        }

        model.노출위치 &= ~placement;
    }

    private void ResetForm()
    {
        selectedId = null;
        rewardPolicyIdText = null;
        model = new 관리자공통콘텐츠저장요청
        {
            활성화여부 = true
        };
    }
}