@page "/documents/upload"
@rendermode InteractiveServer
@inject 문서관리메모리Service 문서관리메모리Service
@inject 관리자인증세션Service 관리자인증세션Service
@inject NavigationManager NavigationManager

<PageTitle>문서 업로드</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">문서 업로드</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">문서 파일을 선택하고 원장에 등록합니다.</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
            <MudButton Href="@관리자문서Routes.목록" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.List">문서 목록</MudButton>
            <MudButton Href="@관리자문서Routes.정책목록" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Policy">문서 정책</MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@MessageSeverity">@message</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">업로드 정보</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="3">
                    <MudTextField Label="문서코드" Variant="Variant.Outlined" @bind-Value="uploadDocumentCode" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="의뢰Id" Variant="Variant.Outlined" @bind-Value="uploadRequestId" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="문서명" Variant="Variant.Outlined" @bind-Value="uploadDocumentName" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3" Style="height: 100%;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">파일</MudText>
                        <InputFile OnChange="OnFileSelected" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="배송운송Id" Placeholder="선택" Variant="Variant.Outlined" @bind-Value="uploadTransportIdText" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="암호화" Variant="Variant.Outlined" @bind-Value="uploadEncryptText">
                        <MudSelectItem T="string" Value="@EmptyValue">정책 따름</MudSelectItem>
                        <MudSelectItem T="string" Value="@TrueValue">암호화</MudSelectItem>
                        <MudSelectItem T="string" Value="@FalseValue">비암호화</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" Label="다운로드" Variant="Variant.Outlined" @bind-Value="uploadDownloadText">
                        <MudSelectItem T="string" Value="@EmptyValue">정책 따름</MudSelectItem>
                        <MudSelectItem T="string" Value="@TrueValue">허용</MudSelectItem>
                        <MudSelectItem T="string" Value="@FalseValue">차단</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       Disabled="@isUploading"
                       OnClick="UploadAsync">
                업로드
            </MudButton>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private const string EmptyValue = "";
    private const string TrueValue = "true";
    private const string FalseValue = "false";

    private bool isUploading;
    private bool isError;
    private string? message;
    private IBrowserFile? selectedFile;

    private string uploadDocumentCode = "인수증";
    private string uploadDocumentName = "인수증";
    private string uploadRequestId = string.Empty;
    private string uploadTransportIdText = string.Empty;
    private string uploadEncryptText = string.Empty;
    private string uploadDownloadText = string.Empty;
    private Severity MessageSeverity => isError ? Severity.Error : Severity.Success;

    protected override void OnInitialized()
    {
        if (!관리자인증세션Service.서버관리자인가)
        {
            NavigationManager.NavigateTo(관리자문서Routes.로그인ReturnUrl(관리자문서Routes.업로드));
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadAsync()
    {
        if (selectedFile is null)
        {
            isError = true;
            message = "업로드할 파일을 선택하세요.";
            return;
        }

        if (string.IsNullOrWhiteSpace(uploadDocumentCode) || string.IsNullOrWhiteSpace(uploadRequestId))
        {
            isError = true;
            message = "문서코드와 의뢰Id는 필수입니다.";
            return;
        }

        isUploading = true;
        message = null;

        try
        {
            await using var stream = selectedFile.OpenReadStream(50_000_000);
            bool? encrypt = bool.TryParse(uploadEncryptText, out var encryptValue) ? encryptValue : null;
            bool? allowDownload = bool.TryParse(uploadDownloadText, out var downloadValue) ? downloadValue : null;
            long? transportId = long.TryParse(uploadTransportIdText, out var transportValue) ? transportValue : null;

            await 문서관리메모리Service.UploadDocumentAsync(
                stream,
                selectedFile.Name,
                selectedFile.ContentType,
                uploadDocumentCode,
                string.IsNullOrWhiteSpace(uploadDocumentName) ? uploadDocumentCode : uploadDocumentName,
                uploadRequestId,
                transportId,
                encrypt,
                allowDownload,
                관리자인증세션Service.UserName);

            selectedFile = null;
            isError = false;
            message = "문서를 업로드했습니다.";
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }
}
