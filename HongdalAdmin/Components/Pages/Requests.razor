@page "/requests"
@inject I백오피스Service DataService

<PageTitle>04. 의뢰 관리</PageTitle>

<h1>04. 의뢰 관리</h1>

<div class="row g-2 mb-3">
    <div class="col-md-3"><input class="form-control" @bind="paymentFilter" placeholder="결제상태" /></div>
    <div class="col-md-3"><input class="form-control" @bind="dispatchFilter" placeholder="배차상태" /></div>
    <div class="col-md-3"><button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">조회</button></div>
</div>

@if (isLoading)
{
    <div class="alert alert-info">의뢰 목록을 불러오는 중입니다...</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead><tr><th>의뢰ID</th><th>확인</th><th>결제</th><th>배차</th><th>픽업</th><th>하차</th><th>의뢰</th><th>관제</th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.의뢰Id</td>
                        <td><span class="@ReviewBadgeClass(item)">@ReviewLabel(item)</span></td>
                        <td><span class="@관리자화면Ui.상태Badge(item.결제상태)">@item.결제상태</span></td>
                        <td><span class="@관리자화면Ui.상태Badge(item.배차상태)">@item.배차상태</span></td>
                        <td>@(item.요약?.픽업지 ?? item.픽업지)</td>
                        <td>@(item.요약?.하차지 ?? item.하차지)</td>
                        <td><a class="btn btn-sm btn-outline-secondary" href="@RequestDetailHref(item.의뢰Id)">상세</a></td>
                        <td><a class="btn btn-sm btn-outline-primary" href="@WorkflowDetailHref(item.의뢰Id)">관제</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool isLoading;
    private string? paymentFilter;
    private string? dispatchFilter;
    private IReadOnlyList<화주운송의뢰응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            items = await DataService.의뢰목록조회Async(paymentFilter, dispatchFilter);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string ReviewLabel(화주운송의뢰응답 item)
    {
        if (IsMatch(item.의뢰상태, "취소", "환불"))
        {
            return "취소/환불";
        }

        if (IsMatch(item.결제상태, "결제대기", "미결제", "대기"))
        {
            return "결제확인";
        }

        if (IsMatch(item.배차상태, "매칭중", "배차대기", "대기"))
        {
            return "배차확인";
        }

        return "정상";
    }

    private static string ReviewBadgeClass(화주운송의뢰응답 item)
    {
        var label = ReviewLabel(item);
        return label switch
        {
            "취소/환불" => "badge rounded-pill text-bg-danger",
            "결제확인" => "badge rounded-pill text-bg-warning",
            "배차확인" => "badge rounded-pill text-bg-info",
            _ => "badge rounded-pill text-bg-success"
        };
    }

    private static bool IsMatch(string? value, params string[] candidates)
    {
        return candidates.Any(candidate => string.Equals(value, candidate, StringComparison.OrdinalIgnoreCase));
    }

    private static string RequestDetailHref(string requestId)
        => $"/requests/{Uri.EscapeDataString(requestId)}";

    private static string WorkflowDetailHref(string requestId)
        => $"/transports/{Uri.EscapeDataString(requestId)}";
}
