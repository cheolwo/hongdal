@page "/dispatch/wait"
@inject I백오피스Service DataService

<PageTitle>02. 유입/배차대기</PageTitle>

<h1>02. 유입/배차대기</h1>

<button class="btn btn-primary mb-3" @onclick="LoadAsync" disabled="@isLoading">새로고침</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
}

<table class="table table-striped table-hover">
    <thead><tr><th>ID</th><th>의뢰ID</th><th>유형</th><th>업무 범위</th><th>픽업 요약</th><th>하차 요약</th><th>확인</th><th>상태</th><th>작업</th></tr></thead>
    <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.의뢰Id</td>
                <td><span class="@TransportTypeBadgeClass(item)">@TransportTypeLabel(item)</span></td>
                <td>@WorkScopeLabel(item)</td>
                <td>@item.픽업_도로명주소</td>
                <td>@item.하차_도로명주소</td>
                <td><span class="@ReviewBadgeClass(item.상태)">@ReviewLabel(item.상태)</span></td>
                <td><span class="@StatusBadgeClass(item.상태)">@item.상태</span></td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick='() => ChangeAsync(item.Id, "확정")'>수동 배차</button>
                    <button class="btn btn-sm btn-outline-warning me-1" @onclick='() => ChangeAsync(item.Id, "보류")'>보류</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item.Id)">제거</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private bool isLoading;
    private bool isError;
    private string? message;
    private IReadOnlyList<배차대기응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        items = await DataService.배차대기목록조회Async();
        isLoading = false;
    }

    private async Task ChangeAsync(long id, string status)
    {
        await DataService.배차대기상태변경Async(id, status);
        isError = false;
        message = $"배차대기를 {status} 처리했습니다.";
        await LoadAsync();
    }

    private async Task DeleteAsync(long id)
    {
        await DataService.배차대기삭제Async(id);
        isError = false;
        message = "배차대기를 제거했습니다.";
        await LoadAsync();
    }

    private static string ReviewLabel(string? status)
    {
        if (IsMatch(status, "보류"))
        {
            return "보류확인";
        }

        if (IsMatch(status, "확정"))
        {
            return "확정됨";
        }

        return "대기확인";
    }

    private static string ReviewBadgeClass(string? status)
    {
        if (IsMatch(status, "보류"))
        {
            return "badge rounded-pill text-bg-warning";
        }

        if (IsMatch(status, "확정"))
        {
            return "badge rounded-pill text-bg-success";
        }

        return "badge rounded-pill text-bg-info";
    }

    private static string StatusBadgeClass(string? status)
    {
        if (IsMatch(status, "확정"))
        {
            return "badge rounded-pill text-bg-success";
        }

        if (IsMatch(status, "보류"))
        {
            return "badge rounded-pill text-bg-warning";
        }

        return "badge rounded-pill text-bg-secondary";
    }

    private static string TransportTypeLabel(배차대기응답 item)
        => IsGroupPurchaseTransport(item) ? "공동구매" : "일반";

    private static string TransportTypeBadgeClass(배차대기응답 item)
        => IsGroupPurchaseTransport(item)
            ? "badge rounded-pill text-bg-warning"
            : "badge rounded-pill text-bg-primary";

    private static string WorkScopeLabel(배차대기응답 item)
    {
        if (!IsGroupPurchaseTransport(item))
        {
            return "상하차";
        }

        if (item.공동구매도착지유형코드 == "ThreePlWarehouse")
        {
            return "상하차 + 3PL 입고";
        }

        if (item.공동구매기사세대배송여부 == true)
        {
            var count = item.공동구매세대배송건수.HasValue ? $" {item.공동구매세대배송건수.Value:N0}건" : string.Empty;
            return $"상하차 + 세대 문앞 배송{count}";
        }

        if (item.공동구매도착지유형코드 == "OrdererGroupRepresentativeDropoff")
        {
            return "상하차 + 집단 대표 인계";
        }

        return "상하차 + 공동주택 거점 하차";
    }

    private static bool IsGroupPurchaseTransport(배차대기응답 item)
        => item.원본의뢰유형 is "ImportCargoTransport" or "FclCargoTransport" or "LclCargoTransport";

    private static bool IsMatch(string? value, params string[] candidates)
    {
        return candidates.Any(candidate => string.Equals(value, candidate, StringComparison.OrdinalIgnoreCase));
    }
}
