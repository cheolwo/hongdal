@page "/dispatch/wait"
@inject I백오피스Service DataService

<PageTitle>02. 유입/배차대기</PageTitle>

<h1>02. 유입/배차대기</h1>

<button class="btn btn-primary mb-3" @onclick="LoadAsync" disabled="@isLoading">새로고침</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
}

<table class="table table-striped table-hover">
    <thead><tr><th>ID</th><th>의뢰ID</th><th>픽업지</th><th>하차지</th><th>상태</th><th>작업</th></tr></thead>
    <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td>@item.Id</td><td>@item.의뢰Id</td><td>@item.픽업_도로명주소 @item.픽업_상세주소</td><td>@item.하차_도로명주소 @item.하차_상세주소</td><td>@item.상태</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick='() => ChangeAsync(item.Id, "확정")'>수동 배차</button>
                    <button class="btn btn-sm btn-outline-warning me-1" @onclick='() => ChangeAsync(item.Id, "보류")'>보류</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item.Id)">제거</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private bool isLoading;
    private bool isError;
    private string? message;
    private IReadOnlyList<배차대기응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        items = await DataService.배차대기목록조회Async();
        isLoading = false;
    }

    private async Task ChangeAsync(long id, string status)
    {
        await DataService.배차대기상태변경Async(id, status);
        isError = false;
        message = $"배차대기를 {status} 처리했습니다.";
        await LoadAsync();
    }

    private async Task DeleteAsync(long id)
    {
        await DataService.배차대기삭제Async(id);
        isError = false;
        message = "배차대기를 제거했습니다.";
        await LoadAsync();
    }
}
