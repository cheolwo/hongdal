@page "/activity-logs"
@rendermode InteractiveServer
@using Hongdal.Contracts.Admin.Audit
@inject ActivityLogService ActivityLogService
@inject 관리자인증세션Service 관리자인증세션Service
@inject NavigationManager NavigationManager

<PageTitle>사용자 행위 로그</PageTitle>

<h1>사용자 행위 로그</h1>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">앱</label>
                <select class="form-select" @bind="search.AppKey">
                    <option value="">전체</option>
                    <option value="HongdalAdmin">HongdalAdmin</option>
                    <option value="DriverApp">DriverApp</option>
                    <option value="ShipperApp">ShipperApp</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">사용자 Id</label>
                <input class="form-control" @bind="search.UserId" />
            </div>
            <div class="col-md-3">
                <label class="form-label">이메일</label>
                <input class="form-control" @bind="search.Email" />
            </div>
            <div class="col-md-3">
                <label class="form-label">전화 끝 4자리</label>
                <input class="form-control" @bind="search.PhoneLast4" maxlength="4" />
            </div>
            <div class="col-md-3">
                <label class="form-label">행위 유형</label>
                <input class="form-control" @bind="search.ActionType" placeholder="Read, Update, Command" />
            </div>
            <div class="col-md-3">
                <label class="form-label">행위명</label>
                <input class="form-control" @bind="search.ActionName" />
            </div>
            <div class="col-md-3">
                <label class="form-label">TraceId</label>
                <input class="form-control" @bind="search.TraceId" />
            </div>
            <div class="col-md-3">
                <label class="form-label">성공 여부</label>
                <select class="form-select" @bind="selectedIsSuccess">
                    <option value="">전체</option>
                    <option value="true">성공</option>
                    <option value="false">실패</option>
                </select>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">조회</button>
            <button class="btn btn-outline-secondary" @onclick="Reset">초기화</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p>행위 로그를 불러오는 중입니다...</p>
}
else
{
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="text-muted">총 @result.TotalCount 건</div>
                        <div class="text-muted">페이지 @result.Page / 크기 @result.PageSize</div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>시각</th>
                                    <th>앱</th>
                                    <th>사용자</th>
                                    <th>행위</th>
                                    <th>결과</th>
                                    <th>TraceId</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in result.Items)
                                {
                                    <tr>
                                        <td>@item.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>@item.AppKey</td>
                                        <td>
                                            <div>@item.UserName</div>
                                            <div class="small text-muted">@item.UserId</div>
                                            <div class="small text-muted">@item.EmailMasked / @item.PhoneLast4</div>
                                        </td>
                                        <td>
                                            <span class="badge text-bg-secondary">@item.ActionType</span>
                                            <div>@item.ActionName</div>
                                            <div class="small text-muted">@item.Route</div>
                                        </td>
                                        <td>
                                            <span class="badge @(item.IsSuccess ? "text-bg-success" : "text-bg-danger")">@(item.IsSuccess ? "성공" : "실패")</span>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-link p-0" @onclick="() => LoadTraceAsync(item.TraceId)">@item.TraceId</button>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => LoadDetailAsync(item.Id)">상세</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">상세</h5>
                    @if (selectedDetail is null)
                    {
                        <p class="text-muted mb-0">상세 버튼을 눌러 선택한 로그를 확인할 수 있습니다.</p>
                    }
                    else
                    {
                        <dl class="row mb-0 small">
                            <dt class="col-4">앱</dt><dd class="col-8">@selectedDetail.AppKey</dd>
                            <dt class="col-4">사용자</dt><dd class="col-8">@selectedDetail.UserName (@selectedDetail.UserId)</dd>
                            <dt class="col-4">이메일</dt><dd class="col-8">@selectedDetail.EmailMasked</dd>
                            <dt class="col-4">전화</dt><dd class="col-8">@selectedDetail.PhoneLast4</dd>
                            <dt class="col-4">행위</dt><dd class="col-8">@selectedDetail.ActionType / @selectedDetail.ActionName</dd>
                            <dt class="col-4">결과</dt><dd class="col-8">@(selectedDetail.IsSuccess ? "성공" : "실패")</dd>
                            <dt class="col-4">오류</dt><dd class="col-8">@selectedDetail.ErrorCode @selectedDetail.ErrorMessage</dd>
                            <dt class="col-4">TraceId</dt><dd class="col-8">@selectedDetail.TraceId</dd>
                            <dt class="col-4">IP</dt><dd class="col-8">@selectedDetail.ClientIp</dd>
                            <dt class="col-4">UA</dt><dd class="col-8 text-break">@selectedDetail.UserAgent</dd>
                        </dl>
                        <hr />
                        <label class="form-label">Metadata</label>
                        <textarea class="form-control" rows="10" readonly>@selectedDetail.MetadataJson</textarea>
                    }
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Trace 묶음</h5>
                    @if (traceGroup is null || traceGroup.Items.Count == 0)
                    {
                        <p class="text-muted mb-0">TraceId를 선택하면 같은 요청의 행위를 확인할 수 있습니다.</p>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">@traceGroup.TraceId</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var item in traceGroup.Items)
                            {
                                <li class="list-group-item px-0">
                                    <div>@item.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss") · @item.ActionType · @item.ActionName</div>
                                    <div class="small text-muted">@item.AppKey / @(item.IsSuccess ? "성공" : "실패")</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly 사용자행위로그검색요청 search = new();
    private 사용자행위로그목록응답 result = new();
    private 사용자행위로그상세응답? selectedDetail;
    private Trace행위로그묶음응답? traceGroup;
    private bool isLoading = true;
    private string? errorMessage;
    private string selectedIsSuccess = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!관리자인증세션Service.서버관리자인가)
        {
            NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/activity-logs")}");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        search.IsSuccess = string.IsNullOrWhiteSpace(selectedIsSuccess) ? null : bool.Parse(selectedIsSuccess);

        try
        {
            result = await ActivityLogService.SearchAsync(search);
        }
        catch (Exception ex)
        {
            errorMessage = $"행위 로그 조회 실패: {ex.Message}";
            result = new 사용자행위로그목록응답();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync(long id)
    {
        selectedDetail = await ActivityLogService.GetDetailAsync(id);
    }

    private async Task LoadTraceAsync(string traceId)
    {
        traceGroup = await ActivityLogService.GetTraceAsync(traceId);
    }

    private void Reset()
    {
        search.AppKey = null;
        search.UserId = null;
        search.Email = null;
        search.PhoneLast4 = null;
        search.ActionType = null;
        search.ActionName = null;
        search.TraceId = null;
        search.IsSuccess = null;
        selectedIsSuccess = string.Empty;
    }
}
