@page "/documents/policies/{DocumentCode}"
@rendermode InteractiveServer
@inject 문서관리메모리Service 문서관리메모리Service
@inject 관리자인증세션Service 관리자인증세션Service
@inject NavigationManager NavigationManager

<PageTitle>문서 정책 편집</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">문서 정책 편집</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">선택한 문서 종류의 운영 정책만 수정합니다.</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
            <MudButton Href="@관리자문서Routes.정책목록" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Policy">문서 정책</MudButton>
            <MudButton Href="@관리자문서Routes.목록" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.List">문서 목록</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@isLoading" OnClick="LoadAsync">새로고침</MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@MessageSeverity">@message</MudAlert>
    }

    @if (isLoading)
    {
        <MudAlert Severity="Severity.Info">문서 정책을 불러오는 중입니다...</MudAlert>
    }
    else if (selectedPolicy is null)
    {
        <MudAlert Severity="Severity.Warning">문서코드 @DocumentCode 정책을 찾지 못했습니다.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">@selectedPolicy.문서코드</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudTextField Label="문서코드" Value="@selectedPolicy.문서코드" Variant="Variant.Outlined" ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Label="문서명" Variant="Variant.Outlined" @bind-Value="selectedPolicy.문서명" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Label="자동생성시점" Variant="Variant.Outlined" @bind-Value="selectedPolicy.자동생성시점" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField T="int" Label="보관일수" Variant="Variant.Outlined" Min="0" @bind-Value="selectedPolicy.보관일수" />
                    </MudItem>
                </MudGrid>

                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">정책 플래그</MudText>
                    <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                        <MudCheckBox T="bool" @bind-Value="selectedPolicy.사용여부" Label="사용" Color="Color.Primary" />
                        <MudCheckBox T="bool" @bind-Value="selectedPolicy.암호화여부" Label="암호화" Color="Color.Primary" />
                        <MudCheckBox T="bool" @bind-Value="selectedPolicy.다운로드허용여부" Label="다운로드 허용" Color="Color.Primary" />
                        <MudCheckBox T="bool" @bind-Value="selectedPolicy.서명필요여부" Label="서명 필요" Color="Color.Primary" />
                        <MudCheckBox T="bool" @bind-Value="selectedPolicy.수정가능여부" Label="수정 가능" Color="Color.Primary" />
                        <MudCheckBox T="bool" @bind-Value="selectedPolicy.감사로그여부" Label="감사로그" Color="Color.Primary" />
                    </MudStack>
                </MudStack>

                <MudTextField Label="조회 가능 역할 목록 JSON"
                              Variant="Variant.Outlined"
                              Lines="3"
                              @bind-Value="selectedPolicy.조회가능역할목록Json" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@isSaving"
                           OnClick="SavePolicyAsync">
                    정책 저장
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public string DocumentCode { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool isSaving;
    private bool isError;
    private string? message;
    private 문서정책요약응답? selectedPolicy;
    private Severity MessageSeverity => isError ? Severity.Error : Severity.Success;

    protected override async Task OnParametersSetAsync()
    {
        if (!관리자인증세션Service.서버관리자인가)
        {
            NavigationManager.NavigateTo(관리자문서Routes.로그인ReturnUrl(관리자문서Routes.정책상세(DocumentCode)));
            return;
        }

        await LoadAsync();
    }

    private Task LoadAsync()
    {
        isLoading = true;
        message = null;

        try
        {
            var source = 문서관리메모리Service.GetPolicies()
                .FirstOrDefault(x => string.Equals(x.문서코드, DocumentCode, StringComparison.OrdinalIgnoreCase));
            selectedPolicy = source is null ? null : CopyPolicy(source);
            isError = false;
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
            selectedPolicy = null;
        }
        finally
        {
            isLoading = false;
        }

        return Task.CompletedTask;
    }

    private async Task SavePolicyAsync()
    {
        if (selectedPolicy is null)
        {
            return;
        }

        isSaving = true;
        message = null;

        try
        {
            var updated = 문서관리메모리Service.UpdatePolicy(selectedPolicy.문서코드, new 문서정책수정요청
            {
                사용여부 = selectedPolicy.사용여부,
                암호화여부 = selectedPolicy.암호화여부,
                다운로드허용여부 = selectedPolicy.다운로드허용여부,
                서명필요여부 = selectedPolicy.서명필요여부,
                자동생성시점 = selectedPolicy.자동생성시점,
                조회가능역할목록Json = selectedPolicy.조회가능역할목록Json,
                보관일수 = selectedPolicy.보관일수,
                수정가능여부 = selectedPolicy.수정가능여부,
                감사로그여부 = selectedPolicy.감사로그여부
            });

            if (updated is null)
            {
                throw new InvalidOperationException("정책을 찾을 수 없습니다.");
            }

            selectedPolicy = CopyPolicy(updated);
            isError = false;
            message = "정책을 저장했습니다.";
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
        }
        finally
        {
            isSaving = false;
        }

        await Task.CompletedTask;
    }

    private static 문서정책요약응답 CopyPolicy(문서정책요약응답 item)
        => new()
        {
            Id = item.Id,
            문서코드 = item.문서코드,
            문서명 = item.문서명,
            사용여부 = item.사용여부,
            암호화여부 = item.암호화여부,
            다운로드허용여부 = item.다운로드허용여부,
            서명필요여부 = item.서명필요여부,
            자동생성시점 = item.자동생성시점,
            조회가능역할목록Json = item.조회가능역할목록Json,
            보관일수 = item.보관일수,
            수정가능여부 = item.수정가능여부,
            감사로그여부 = item.감사로그여부,
            생성일시 = item.생성일시,
            수정일시 = item.수정일시
        };
}
