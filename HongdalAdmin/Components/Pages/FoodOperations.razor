@page "/food/operations"
@inject 음식운영Service FoodService

<PageTitle>음식 운영</PageTitle>

<h1>음식 운영</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass">@message</div>
}

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>음식 운영 정책을 불러오는 중입니다.</span>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-7">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="card-title mb-1">배달 요금 정책</h5>
                            <p class="text-muted mb-0">플랫폼 배달요금과 기사 지급액 산정 기준을 조정합니다.</p>
                        </div>
                        <button class="btn btn-primary" @onclick="SavePricingPolicyAsync" disabled="@isSaving">
                            @(isSaving ? "저장 중" : "정책 저장")
                        </button>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">기본요금</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.BaseFee" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">최소요금</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.MinimumFee" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">기본 포함거리(m)</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.IncludedDistanceMeters" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">거리 단위(m)</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.DistanceUnitMeters" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">거리 단위 요금</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.DistanceUnitFee" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">기사 기본 지급액</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.DriverBasePayout" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">기사 최소 지급액</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.DriverMinimumPayout" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">기사 거리 지급액</label>
                            <InputNumber class="form-control" @bind-Value="pricingPolicy.DriverDistanceUnitPayout" />
                        </div>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">견적 테스트 거리(m)</label>
                            <InputNumber class="form-control" @bind-Value="previewDistanceMeters" />
                        </div>
                        <div class="col-md-8">
                            <div class="border rounded p-3 bg-light">
                                <div>플랫폼 배달요금: <strong>@PreviewPlatformFee.ToString("N0")원</strong></div>
                                <div>기사 지급액: <strong>@PreviewDriverPayout.ToString("N0")원</strong></div>
                                <div>플랫폼 마진: <strong>@PreviewMargin.ToString("N0")원</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">리뷰 운영</h5>
                    <p class="text-muted">음식점 리뷰 운영 정책과 관리자 검토 대상을 확인합니다.</p>

                    <dl class="row mb-3">
                        <dt class="col-7">기본 저평점 게시일수</dt>
                        <dd class="col-5 text-end">@reviewPolicy.기본저평점게시일수</dd>
                        <dt class="col-7">검토 대상 리뷰</dt>
                        <dd class="col-5 text-end">@reviewItems.Items.Count</dd>
                        <dt class="col-7">연속 저평점 주의</dt>
                        <dd class="col-5 text-end">@reviewItems.Items.Count(x => x.같은음식점기준저평점3회연속여부)</dd>
                    </dl>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>음식점</th>
                                    <th>별점</th>
                                    <th>상태</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in reviewItems.Items.Take(5))
                                {
                                    <tr>
                                        <td>@item.음식점명</td>
                                        <td>@item.별점</td>
                                        <td>@(item.관리자게시강제여부 ? "강제게시" : "대기")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private 음식배달요금정책응답 pricingPolicy = new();
    private 음식점리뷰관리목록응답 reviewItems = new();
    private 음식점리뷰운영정책응답 reviewPolicy = new();
    private int previewDistanceMeters = 2300;
    private bool isLoading = true;
    private bool isSaving;
    private string? message;
    private string messageClass = "alert-info";

    private decimal PreviewPlatformFee => CalculatePlatformFee(previewDistanceMeters);
    private decimal PreviewDriverPayout => CalculateDriverPayout(previewDistanceMeters);
    private decimal PreviewMargin => PreviewPlatformFee - PreviewDriverPayout;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            pricingPolicy = await FoodService.배달요금정책조회Async();
            reviewItems = await FoodService.리뷰운영목록조회Async();
            reviewPolicy = await FoodService.운영정책조회Async();
        }
        catch (Exception ex)
        {
            messageClass = "alert-danger";
            message = $"음식 운영 정보를 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SavePricingPolicyAsync()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        message = null;

        try
        {
            pricingPolicy = await FoodService.배달요금정책수정Async(pricingPolicy);
            messageClass = "alert-success";
            message = "배달 요금 정책을 저장했습니다.";
        }
        catch (Exception ex)
        {
            messageClass = "alert-danger";
            message = $"정책 저장에 실패했습니다: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private decimal CalculatePlatformFee(int distanceMeters)
    {
        var units = CalculateDistanceUnits(distanceMeters);
        return Math.Max(pricingPolicy.MinimumFee, pricingPolicy.BaseFee + units * pricingPolicy.DistanceUnitFee);
    }

    private decimal CalculateDriverPayout(int distanceMeters)
    {
        var units = CalculateDistanceUnits(distanceMeters);
        return Math.Max(pricingPolicy.DriverMinimumPayout, pricingPolicy.DriverBasePayout + units * pricingPolicy.DriverDistanceUnitPayout);
    }

    private int CalculateDistanceUnits(int distanceMeters)
    {
        var billableDistance = Math.Max(0, distanceMeters - Math.Max(0, pricingPolicy.IncludedDistanceMeters));
        var unit = Math.Max(1, pricingPolicy.DistanceUnitMeters);
        return (int)Math.Ceiling(billableDistance / (double)unit);
    }
}
