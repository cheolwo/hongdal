@page "/dispatch-ai-judgment-cases"
@rendermode InteractiveServer
@inject DispatchAIJudgmentCaseAdminService JudgmentCaseService
@inject 관리자인증세션Service AdminSession
@inject NavigationManager NavigationManager

<PageTitle>배차 AI 판단 사례</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">배차 AI 판단 사례</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    운영자가 예시 판단을 승인하거나 직접 입력하면 다음 배차 판단근거 검색에 사례가 누적됩니다.
                </MudText>
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@isLoading"
                       OnClick="LoadAsync">
                새로고침
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <MudAlert Severity="Severity.Success">@successMessage</MudAlert>
        }

        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" lg="7">
                    <MudPaper Class="pa-4 h-100" Elevation="1">
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2" Style="flex-wrap: wrap;">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">선택 가능한 예시</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">현재 정책과 대화에서 나온 판단 기준을 먼저 사례 후보로 제공합니다.</MudText>
                                </MudStack>
                                <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">@catalog.Suggestions.Count 개</MudChip>
                            </MudStack>

                            @foreach (var suggestion in catalog.Suggestions)
                            {
                                <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle1">@suggestion.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@suggestion.RelatedOS · @suggestion.SuggestionKey</MudText>
                                            </MudStack>
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       Disabled="@isSaving"
                                                       OnClick="@(() => PromoteSuggestionAsync(suggestion))">
                                                사례로 쌓기
                                            </MudButton>
                                        </MudStack>

                                        <MudText Typo="Typo.body2">@suggestion.SituationSummary</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@suggestion.SuggestedJudgmentSummary</MudText>

                                        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                                            @foreach (var keyword in suggestion.Keywords)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@keyword</MudChip>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="5">
                    <MudStack Spacing="3">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.h6">직접 사례 입력</MudText>
                                <MudTextField Label="제목" @bind-Value="draft.Title" Variant="Variant.Outlined" />
                                <MudTextField Label="관련 OS" @bind-Value="draft.RelatedOS" Variant="Variant.Outlined" />
                                <MudTextField Label="키워드" HelperText="쉼표로 구분합니다." @bind-Value="keywordText" Variant="Variant.Outlined" />
                                <MudTextField Label="상황 요약" @bind-Value="draft.SituationSummary" Variant="Variant.Outlined" Lines="3" />
                                <MudTextField Label="판단 요약" @bind-Value="draft.JudgmentSummary" Variant="Variant.Outlined" Lines="3" />
                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" Label="사용자 판정" @bind-Value="draft.UserDecision" Variant="Variant.Outlined">
                                            @foreach (var decision in decisionOptions)
                                            {
                                                <MudSelectItem Value="@decision">@decision</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField Label="중용 판정" @bind-Value="draft.BalancedDecision" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                                <MudSwitch T="bool" Label="RAG 검색에 반영" @bind-Value="draft.Active" Color="Color.Primary" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@isSaving"
                                           OnClick="CreateCaseAsync">
                                    직접 사례 저장
                                </MudButton>
                            </MudStack>
                        </MudPaper>

                        <MudPaper Class="pa-4" Elevation="1">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.h6">누적된 사례</MudText>
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">@catalog.Cases.Count 개</MudChip>
                                </MudStack>

                                @if (catalog.Cases.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">아직 운영자가 등록한 판단 사례가 없습니다.</MudAlert>
                                }
                                else
                                {
                                    <MudTable Items="@catalog.Cases" Dense="true" Hover="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>사례</MudTh>
                                            <MudTh>판정</MudTh>
                                            <MudTh>상태</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="사례">
                                                <MudText Typo="Typo.body2">@context.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CaseId</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="판정">@context.UserDecision</MudTd>
                                            <MudTd DataLabel="상태">
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Color="@(context.Active ? Color.Success : Color.Default)"
                                                         Variant="Variant.Filled">
                                                    @(context.Active ? "반영" : "보관")
                                                </MudChip>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudStack>
                </MudItem>
            </MudGrid>
        }
    </MudStack>
</MudContainer>

@code {
    private static readonly IReadOnlyList<string> decisionOptions = ["승인", "조건부 승인", "보류", "공개 전환", "제외"];

    private DispatchAIJudgmentCaseCatalogDto catalog = new();
    private DispatchAIJudgmentCaseCreateRequest draft = CreateDefaultDraft();
    private string keywordText = "묶음, 플랫폼, 기사, 배달권";
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!AdminSession.서버관리자인가)
        {
            NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/dispatch-ai-judgment-cases")}");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            catalog = await JudgmentCaseService.GetCatalogAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"판단 사례 조회 실패: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PromoteSuggestionAsync(DispatchAIJudgmentCaseSuggestionDto suggestion)
    {
        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            await JudgmentCaseService.PromoteSuggestionAsync(
                suggestion.SuggestionKey,
                new DispatchAIJudgmentCasePromoteSuggestionRequest
                {
                    Active = true
                });
            successMessage = $"{suggestion.Title} 사례를 RAG 판단 사례로 쌓았습니다.";
            catalog = await JudgmentCaseService.GetCatalogAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"판단 사례 등록 실패: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CreateCaseAsync()
    {
        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            draft.Keywords = keywordText
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();

            await JudgmentCaseService.CreateAsync(draft);
            successMessage = $"{draft.Title} 사례를 저장했습니다.";
            draft = CreateDefaultDraft();
            keywordText = "묶음, 플랫폼, 기사, 배달권";
            catalog = await JudgmentCaseService.GetCatalogAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"직접 사례 저장 실패: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static DispatchAIJudgmentCaseCreateRequest CreateDefaultDraft()
        => new()
        {
            Title = "운영자 판단 사례",
            RelatedOS = "국내 화물 운송 OS",
            UserDecision = "보류",
            BalancedDecision = "운영자 판정",
            Active = true
        };
}
