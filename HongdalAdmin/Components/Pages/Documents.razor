@page "/documents"
@rendermode InteractiveServer
@inject 문서관리메모리Service 문서관리메모리Service
@inject 관리자인증세션Service 관리자인증세션Service
@inject NavigationManager NavigationManager

<PageTitle>문서 관리</PageTitle>

<h1>문서 관리</h1>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">문서 업로드</h5>
        <div class="row g-2">
            <div class="col-md-3">
                <input class="form-control" @bind="uploadDocumentCode" placeholder="문서코드" />
            </div>
            <div class="col-md-3">
                <input class="form-control" @bind="uploadRequestId" placeholder="의뢰Id" />
            </div>
            <div class="col-md-3">
                <input class="form-control" @bind="uploadDocumentName" placeholder="문서명" />
            </div>
            <div class="col-md-3">
                <InputFile OnChange="OnFileSelected" />
            </div>
        </div>
        <div class="row g-2 mt-2">
            <div class="col-md-3">
                <input class="form-control" @bind="uploadTransportIdText" placeholder="배송운송Id(선택)" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="uploadEncryptText">
                    <option value="">암호화: 정책 따름</option>
                    <option value="true">암호화</option>
                    <option value="false">비암호화</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="uploadDownloadText">
                    <option value="">다운로드: 정책 따름</option>
                    <option value="true">허용</option>
                    <option value="false">차단</option>
                </select>
            </div>
        </div>
        <button class="btn btn-primary mt-3" @onclick="UploadAsync" disabled="@isUploading">업로드</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">문서 종류 정책</h5>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">새로고침</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead>
                            <tr>
                                <th>코드</th>
                                <th>이름</th>
                                <th>사용</th>
                                <th>암호화</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in policies)
                            {
                                <tr style="cursor:pointer" @onclick="() => SelectPolicy(item)">
                                    <td>@item.문서코드</td>
                                    <td>@item.문서명</td>
                                    <td>@(item.사용여부 ? "예" : "아니오")</td>
                                    <td>@(item.암호화여부 ? "예" : "아니오")</td>
                                    <td><button class="btn btn-sm btn-outline-primary" @onclick="() => SelectPolicy(item)">편집</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">정책 편집</h5>
                @if (selectedPolicy is null)
                {
                    <p class="text-muted mb-0">왼쪽에서 문서 종류를 선택하세요.</p>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">문서코드</label>
                            <input class="form-control" value="@selectedPolicy.문서코드" disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">문서명</label>
                            <input class="form-control" @bind="selectedPolicy.문서명" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">자동생성시점</label>
                            <input class="form-control" @bind="selectedPolicy.자동생성시점" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">보관일수</label>
                            <input class="form-control" type="number" @bind="selectedPolicy.보관일수" />
                        </div>
                        <div class="col-md-3 form-check mt-4 ms-3">
                            <input class="form-check-input" type="checkbox" @bind="selectedPolicy.사용여부" />
                            <label class="form-check-label">사용</label>
                        </div>
                        <div class="col-md-3 form-check mt-4 ms-3">
                            <input class="form-check-input" type="checkbox" @bind="selectedPolicy.암호화여부" />
                            <label class="form-check-label">암호화</label>
                        </div>
                        <div class="col-md-3 form-check mt-4 ms-3">
                            <input class="form-check-input" type="checkbox" @bind="selectedPolicy.다운로드허용여부" />
                            <label class="form-check-label">다운로드 허용</label>
                        </div>
                        <div class="col-md-3 form-check ms-3">
                            <input class="form-check-input" type="checkbox" @bind="selectedPolicy.서명필요여부" />
                            <label class="form-check-label">서명 필요</label>
                        </div>
                        <div class="col-md-3 form-check ms-3">
                            <input class="form-check-input" type="checkbox" @bind="selectedPolicy.수정가능여부" />
                            <label class="form-check-label">수정 가능</label>
                        </div>
                        <div class="col-md-3 form-check ms-3">
                            <input class="form-check-input" type="checkbox" @bind="selectedPolicy.감사로그여부" />
                            <label class="form-check-label">감사로그</label>
                        </div>
                        <div class="col-12">
                            <label class="form-label">조회 가능 역할 목록 JSON</label>
                            <textarea class="form-control" rows="3" @bind="selectedPolicy.조회가능역할목록Json"></textarea>
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" @onclick="SavePolicyAsync" disabled="@isSaving">정책 저장</button>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">문서 목록</h5>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>시각</th>
                                <th>문서</th>
                                <th>의뢰</th>
                                <th>파일명</th>
                                <th>상태</th>
                                <th>암호화</th>
                                <th>다운로드</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in documents)
                            {
                                <tr>
                                    <td>@item.생성일시.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.문서명</td>
                                    <td>@item.의뢰Id</td>
                                    <td>@item.파일명</td>
                                    <td>@item.생성상태</td>
                                    <td>@(item.암호화됨 ? "예" : "아니오")</td>
                                    <td>@(item.다운로드허용여부 ? "허용" : "차단")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">문서 조회 로그</h5>
                <div class="table-responsive" style="max-height: 420px; overflow:auto;">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>시각</th>
                                <th>행위</th>
                                <th>사용자</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in logs)
                            {
                                <tr>
                                    <td>@item.생성일시.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                    <td>@item.행위</td>
                                    <td>@item.사용자명</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
}

@code {
    private bool isLoading = true;
    private bool isSaving;
    private bool isUploading;
    private bool isError;
    private string? message;

    private IReadOnlyList<문서정책요약응답> policies = [];
    private IReadOnlyList<문서조회요약응답> documents = [];
    private IReadOnlyList<문서조회로그요약응답> logs = [];

    private 문서정책요약응답? selectedPolicy;
    private IBrowserFile? selectedFile;

    private string uploadDocumentCode = "인수증";
    private string uploadDocumentName = "인수증";
    private string uploadRequestId = string.Empty;
    private string uploadTransportIdText = string.Empty;
    private string uploadEncryptText = string.Empty;
    private string uploadDownloadText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!관리자인증세션Service.서버관리자인가)
        {
            NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/documents")}");
            return;
        }

        await LoadAsync();
    }

    private Task LoadAsync()
    {
        isLoading = true;
        message = null;

        try
        {
            policies = 문서관리메모리Service.GetPolicies();
            documents = 문서관리메모리Service.GetDocuments();
            logs = 문서관리메모리Service.GetLogs();
            selectedPolicy ??= policies.FirstOrDefault();
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
            policies = [];
            documents = [];
            logs = [];
        }
        finally
        {
            isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void SelectPolicy(문서정책요약응답 item)
    {
        selectedPolicy = new 문서정책요약응답
        {
            Id = item.Id,
            문서코드 = item.문서코드,
            문서명 = item.문서명,
            사용여부 = item.사용여부,
            암호화여부 = item.암호화여부,
            다운로드허용여부 = item.다운로드허용여부,
            서명필요여부 = item.서명필요여부,
            자동생성시점 = item.자동생성시점,
            조회가능역할목록Json = item.조회가능역할목록Json,
            보관일수 = item.보관일수,
            수정가능여부 = item.수정가능여부,
            감사로그여부 = item.감사로그여부,
            생성일시 = item.생성일시,
            수정일시 = item.수정일시
        };
    }

    private async Task SavePolicyAsync()
    {
        if (selectedPolicy is null)
        {
            return;
        }

        isSaving = true;
        message = null;

        try
        {
            var updated = 문서관리메모리Service.UpdatePolicy(selectedPolicy.문서코드, new 문서정책수정요청
            {
                사용여부 = selectedPolicy.사용여부,
                암호화여부 = selectedPolicy.암호화여부,
                다운로드허용여부 = selectedPolicy.다운로드허용여부,
                서명필요여부 = selectedPolicy.서명필요여부,
                자동생성시점 = selectedPolicy.자동생성시점,
                조회가능역할목록Json = selectedPolicy.조회가능역할목록Json,
                보관일수 = selectedPolicy.보관일수,
                수정가능여부 = selectedPolicy.수정가능여부,
                감사로그여부 = selectedPolicy.감사로그여부
            });

            if (updated is null)
            {
                throw new InvalidOperationException("정책을 찾을 수 없습니다.");
            }

            isError = false;
            message = "정책을 저장했습니다.";
            selectedPolicy = updated;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadAsync()
    {
        if (selectedFile is null)
        {
            isError = true;
            message = "업로드할 파일을 선택하세요.";
            return;
        }

        if (string.IsNullOrWhiteSpace(uploadDocumentCode) || string.IsNullOrWhiteSpace(uploadRequestId))
        {
            isError = true;
            message = "문서코드와 의뢰Id는 필수입니다.";
            return;
        }

        isUploading = true;
        message = null;

        try
        {
            await using var stream = selectedFile.OpenReadStream(50_000_000);
            bool? encrypt = bool.TryParse(uploadEncryptText, out var encryptValue) ? encryptValue : null;
            bool? allowDownload = bool.TryParse(uploadDownloadText, out var downloadValue) ? downloadValue : null;
            long? transportId = long.TryParse(uploadTransportIdText, out var transportValue) ? transportValue : null;

            await 문서관리메모리Service.UploadDocumentAsync(
                stream,
                selectedFile.Name,
                selectedFile.ContentType,
                uploadDocumentCode,
                string.IsNullOrWhiteSpace(uploadDocumentName) ? uploadDocumentCode : uploadDocumentName,
                uploadRequestId,
                transportId,
                encrypt,
                allowDownload,
                관리자인증세션Service.UserName);

            selectedFile = null;
            isError = false;
            message = "문서를 업로드했습니다.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }
}
