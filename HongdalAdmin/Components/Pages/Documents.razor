@page "/documents"
@rendermode InteractiveServer
@inject 문서관리메모리Service 문서관리메모리Service
@inject 관리자인증세션Service 관리자인증세션Service
@inject NavigationManager NavigationManager

<PageTitle>문서 목록</PageTitle>

<div class="d-flex justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="mb-1">문서 목록</h1>
        <div class="text-muted">생성된 문서 원장을 조회합니다.</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" href="@관리자문서Routes.업로드">문서 업로드</a>
        <a class="btn btn-outline-primary" href="@관리자문서Routes.정책목록">문서 정책</a>
        <a class="btn btn-outline-secondary" href="@관리자문서Routes.로그목록">조회 로그</a>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">새로고침</button>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" @bind="documentCodeFilter" placeholder="문서코드" />
    </div>
    <div class="col-md-3">
        <input class="form-control" @bind="requestIdFilter" placeholder="의뢰Id" />
    </div>
    <div class="col-md-3">
        <input class="form-control" @bind="statusFilter" placeholder="생성상태" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary w-100" @onclick="LoadAsync" disabled="@isLoading">조회</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
}

@if (isLoading)
{
    <div class="alert alert-info">문서 목록을 불러오는 중입니다...</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">문서 목록</h5>
                <span class="badge rounded-pill text-bg-primary">@documents.Count 건</span>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>시각</th>
                            <th>문서</th>
                            <th>의뢰</th>
                            <th>파일명</th>
                            <th>상태</th>
                            <th>암호화</th>
                            <th>다운로드</th>
                            <th>로그</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in documents)
                        {
                            <tr>
                                <td>@item.생성일시.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.문서명</td>
                                <td>@item.의뢰Id</td>
                                <td>@item.파일명</td>
                                <td><span class="@관리자화면Ui.상태Badge(item.생성상태)">@item.생성상태</span></td>
                                <td>@(item.암호화됨 ? "예" : "아니오")</td>
                                <td>@(item.다운로드허용여부 ? "허용" : "차단")</td>
                                <td><a class="btn btn-sm btn-outline-secondary" href="@DocumentLogHref(item.Id)">보기</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isError;
    private string? message;
    private string? documentCodeFilter;
    private string? requestIdFilter;
    private string? statusFilter;
    private IReadOnlyList<문서조회요약응답> documents = [];

    protected override async Task OnInitializedAsync()
    {
        if (!관리자인증세션Service.서버관리자인가)
        {
            NavigationManager.NavigateTo(관리자문서Routes.로그인ReturnUrl(관리자문서Routes.목록));
            return;
        }

        await LoadAsync();
    }

    private Task LoadAsync()
    {
        isLoading = true;
        message = null;

        try
        {
            documents = 문서관리메모리Service.GetDocuments(documentCodeFilter, requestIdFilter, statusFilter);
            isError = false;
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
            documents = [];
        }
        finally
        {
            isLoading = false;
        }

        return Task.CompletedTask;
    }

    private static string DocumentLogHref(long documentId)
        => 관리자문서Routes.로그(documentId);
}
