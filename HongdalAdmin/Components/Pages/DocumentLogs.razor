@page "/documents/logs"
@rendermode InteractiveServer
@inject I백오피스Service DataService
@inject 관리자인증세션Service 관리자인증세션Service
@inject NavigationManager NavigationManager

<PageTitle>문서 조회 로그</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">문서 조회 로그</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">문서 접근 이력을 확인합니다.</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
            <MudButton Href="@관리자문서Routes.목록" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.List">문서 목록</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@isLoading" OnClick="LoadAsync">새로고침</MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField T="string" Label="문서Id" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="documentIdText" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Disabled="@isLoading" FullWidth="true" OnClick="LoadAsync">조회</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@MessageSeverity">@message</MudAlert>
    }

    @if (isLoading)
    {
        <MudAlert Severity="Severity.Info">문서 조회 로그를 불러오는 중입니다...</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">조회 로그</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@logs.Count 건</MudChip>
                </MudStack>

                @if (logs.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">조회 로그가 없습니다.</MudAlert>
                }
                else
                {
                    <MudTable Items="@logs" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>시각</MudTh>
                            <MudTh>문서Id</MudTh>
                            <MudTh>행위</MudTh>
                            <MudTh>사용자</MudTh>
                            <MudTh>역할</MudTh>
                            <MudTh>IP</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="시각">@context.생성일시.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                            <MudTd DataLabel="문서Id">@context.문서Id</MudTd>
                            <MudTd DataLabel="행위">@context.행위</MudTd>
                            <MudTd DataLabel="사용자">@context.사용자명</MudTd>
                            <MudTd DataLabel="역할">@context.역할명</MudTd>
                            <MudTd DataLabel="IP">@context.ClientIp</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "documentId")]
    public long? DocumentId { get; set; }

    private bool isLoading = true;
    private bool isError;
    private string? message;
    private string? documentIdText;
    private IReadOnlyList<문서조회로그요약응답> logs = [];
    private Severity MessageSeverity => isError ? Severity.Error : Severity.Success;

    protected override async Task OnParametersSetAsync()
    {
        if (!관리자인증세션Service.서버관리자인가)
        {
            NavigationManager.NavigateTo(관리자문서Routes.로그인ReturnUrl(관리자문서Routes.로그목록));
            return;
        }

        documentIdText ??= DocumentId?.ToString();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        message = null;

        try
        {
            var documentId = long.TryParse(documentIdText, out var parsed) ? parsed : DocumentId;
            logs = await DataService.문서로그목록조회Async(documentId);
            isError = false;
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
            logs = [];
        }
        finally
        {
            isLoading = false;
        }
    }
}
