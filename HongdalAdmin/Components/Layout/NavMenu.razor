@using HongdalAdmin.Services
@using Hongdal.Ui.Common.Areas.App.Services
@implements IDisposable
@inject 관리자인증세션Service 관리자인증세션Service
@inject 관리자인증Service 관리자인증Service
@inject ViewPolicyService ViewPolicyService
@inject NavigationManager NavigationManager
@inject PlatformHomeModeStateService HomeModeState

<MudNavMenu Class="pa-3">
    <MudStack Spacing="0" Class="px-2 pb-3">
        <MudText Typo="Typo.subtitle1">HongdalAdmin</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">운영자 백오피스</MudText>
    </MudStack>
    <MudDivider Class="mb-3" />

    @if (!ViewPolicyService.IsLoaded)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mx-2 my-2" />
    }
    else
    {
        @foreach (var item in ViewPolicyService.VisibleItems.Where(x => x.EffectiveVisible))
        {
            <MudNavLink Href="@ToHref(item.Route)"
                        Match="@(item.Route == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                        Icon="@ResolveIcon(item.IconKey)">
                @item.DisplayName
            </MudNavLink>
        }
    }

    @if (관리자인증세션Service.서버관리자인가)
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-2">서버 관리자</MudText>
        <MudNavLink Href="revenue-policies" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Calculate">구독료 운영 정책</MudNavLink>
        <MudNavLink Href="common-contents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Image">공통콘텐츠 관리</MudNavLink>
        <MudNavLink Href="auxiliary-feature-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">부가 기능 설정</MudNavLink>
        <MudNavLink Href="restaurant-search-policy" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocationOn">음식점 반경 정책</MudNavLink>
        <MudNavLink Href="dispatch/ai-review" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Route">국내화물 AI 배차 검토</MudNavLink>
        <MudNavLink Href="dispatch/food-ai-review" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DeliveryDining">음식배달 AI 배차 검토</MudNavLink>
        <MudNavLink Href="dispatch-ai-judgment-cases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FactCheck">배차 AI 판단 사례</MudNavLink>
        <MudNavLink Href="contact-search" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContactPhone">연락처 통합 검색</MudNavLink>
    }

    <MudDivider Class="my-3" />

    @if (!관리자인증세션Service.로그인됨)
    {
        <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">관리자 로그인</MudNavLink>
    }
    else
    {
        <MudStack Spacing="1" Class="px-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@관리자인증세션Service.UserName</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Logout" OnClick="로그아웃">로그아웃</MudButton>
        </MudStack>
    }

    <MudDivider Class="my-3" />
    <MudStack Spacing="1" Class="px-2 pb-2">
        <MudText Typo="Typo.caption" Color="Color.Secondary">모드 전환</MudText>
        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
            <MudButton Variant="@CommunityModeVariant" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Forum" OnClick="@(() => SetMode(false))">커뮤니티</MudButton>
            <MudButton Variant="@WorkModeVariant" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Work" OnClick="@(() => SetMode(true))">업무</MudButton>
        </MudStack>
    </MudStack>
</MudNavMenu>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewPolicyService.Changed += HandleChanged;
        HomeModeState.Changed += HandleChanged;
        await ViewPolicyService.EnsureLoadedAsync();
    }

    private Variant CommunityModeVariant => HomeModeState.IsWorkMode ? Variant.Outlined : Variant.Filled;

    private Variant WorkModeVariant => HomeModeState.IsWorkMode ? Variant.Filled : Variant.Outlined;

    private void SetMode(bool isWorkMode)
    {
        HomeModeState.SetWorkMode(isWorkMode);
    }

    private void HandleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private static string ToHref(string route)
    {
        if (string.IsNullOrWhiteSpace(route) || route == "/")
        {
            return string.Empty;
        }

        return route.TrimStart('/');
    }

    private static string ResolveIcon(string iconKey) => iconKey switch
    {
        "home" => Icons.Material.Filled.Home,
        "settings" => Icons.Material.Filled.Settings,
        "add_box" => Icons.Material.Filled.AddBox,
        "view_list" => Icons.Material.Filled.ViewList,
        "inbox" => Icons.Material.Filled.Inbox,
        "dashboard" => Icons.Material.Filled.Dashboard,
        "inventory_2" => Icons.Material.Filled.Inventory2,
        "warehouse" => Icons.Material.Filled.Warehouse,
        "local_shipping" => Icons.Material.Filled.LocalShipping,
        "qr_code_scanner" => Icons.Material.Filled.QrCodeScanner,
        "person" => Icons.Material.Filled.Person,
        "storefront" => Icons.Material.Filled.Storefront,
        "sell" => Icons.Material.Filled.Sell,
        "outbox" => Icons.Material.Filled.Outbox,
        "public" => Icons.Material.Filled.Public,
        "fact_check" => Icons.Material.Filled.FactCheck,
        "calculate" => Icons.Material.Filled.Calculate,
        _ => Icons.Material.Filled.ChevronRight
    };

    private void 로그아웃()
    {
        관리자인증Service.로그아웃();
        NavigationManager.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        ViewPolicyService.Changed -= HandleChanged;
        HomeModeState.Changed -= HandleChanged;
    }
}
