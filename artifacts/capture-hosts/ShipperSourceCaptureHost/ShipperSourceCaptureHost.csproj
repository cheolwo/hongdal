<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SsalddelApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\SsalddelApp\Components\**\*.razor" LinkBase="Components" />
    <Content Include="..\..\..\SsalddelApp\wwwroot\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\..\SsalddelApp\Models\**\*.cs" LinkBase="Models" />
    <Compile Include="..\..\..\SsalddelApp\Options\**\*.cs" LinkBase="Options" />
    <Compile Include="..\..\..\SsalddelApp\Services\**\*.cs" LinkBase="Services" />
    <Compile Include="..\..\..\SsalddelApp\ViewModels\**\*.cs" LinkBase="ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Ssalddel.Contracts\Ssalddel.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Ssalddel.Client.Infrastructure\Ssalddel.Client.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Ssalddel.Ui.Common\Ssalddel.Ui.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>
</Project>
