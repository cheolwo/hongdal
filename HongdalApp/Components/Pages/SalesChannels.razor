@page "/shipper/sales/channels"
@using Hongdal.Contracts.Common.Sales
@using HongdalApp.Services
@using HongdalApp.Services.Commerce
@inject NavigationManager Navigation
@inject IShipperSalesService SalesService

<PageTitle>판매채널 연결</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">판매채널 연결</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">스마트스토어, 쿠팡 등 판매채널 계정을 연결해 입고상품 판매 흐름을 준비합니다.</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">새로고침</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.ProductListings))">출품 관리</MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">채널 계정 등록</MudText>
                <MudGrid Class="mt-2">
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" Label="채널종류" @bind-Value="channelType" Variant="Variant.Outlined">
                            @foreach (var channel in supportedChannels)
                            {
                                <MudSelectItem T="string" Value="@channel.ChannelKey">@channel.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4"><MudTextField Label="상점명" @bind-Value="storeName" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField Label="인증 메모" @bind-Value="authMemo" Variant="Variant.Outlined" /></MudItem>
                </MudGrid>
                <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Success" Disabled="isBusy" OnClick="CreateAccountAsync">채널 계정 등록</MudButton>
            </MudCardContent>
        </MudCard>

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">연결된 판매채널 계정</MudText>

                @if (isLoading)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                }
                else if (accounts.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">연결된 판매채널 계정이 없습니다.</MudAlert>
                }
                else
                {
                    <MudTable Items="accounts.OrderByDescending(x => x.Id)" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>ID</MudTh>
                            <MudTh>채널종류</MudTh>
                            <MudTh>외부 API</MudTh>
                            <MudTh>상점명</MudTh>
                            <MudTh>연결상태</MudTh>
                            <MudTh>마지막 동기화</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="ID">@context.Id</MudTd>
                            <MudTd DataLabel="채널종류">@context.채널종류</MudTd>
                            <MudTd DataLabel="외부 API">@ChannelStatus(context.채널종류)</MudTd>
                            <MudTd DataLabel="상점명">@context.상점명</MudTd>
                            <MudTd DataLabel="연결상태">@context.연결상태</MudTd>
                            <MudTd DataLabel="마지막 동기화">@context.마지막동기화일시?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private readonly List<판매채널계정항목응답> accounts = [];
    private readonly List<CommerceChannelDescriptor> supportedChannels = [];
    private bool isLoading;
    private bool isBusy;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    private string channelType = CommerceChannelKeys.SmartStore;
    private string storeName = string.Empty;
    private string authMemo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            accounts.Clear();
            supportedChannels.Clear();
            supportedChannels.AddRange(await SalesService.GetSupportedChannelsAsync());
            accounts.AddRange((await SalesService.GetAccountsAsync())?.Items ?? []);
            channelType = supportedChannels.FirstOrDefault()?.ChannelKey ?? channelType;
            messageSeverity = Severity.Info;
            message = $"판매채널 계정 {accounts.Count}건을 불러왔습니다.";
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAccountAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            var created = await SalesService.CreateAccountAsync(new 판매채널계정저장요청
            {
                채널종류 = channelType,
                상점명 = storeName,
                인증메모 = authMemo
            });

            storeName = string.Empty;
            authMemo = string.Empty;
            messageSeverity = Severity.Success;
            message = $"판매채널 계정 {created?.상점명} 을 등록했습니다.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private string ChannelStatus(string channelType)
        => supportedChannels.FirstOrDefault(x => string.Equals(x.ChannelKey, channelType, StringComparison.OrdinalIgnoreCase))?.IntegrationStatus ?? SalesStatusCodes.SyncManual;
}
