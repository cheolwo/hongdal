@page "/shipper/sales/fulfillment/picking"
@inherits MvvmComponentBase<OrderFulfillmentPageViewModel>

<PageTitle>Simulation 피킹 task 목록</PageTitle>

<OrderFulfillmentRouteFrame Title="피킹 task 목록"
                            Description="로컬 피킹 작업을 읽고 명령을 실행할 정확한 stable task ID를 선택합니다."
                            BackHref="@OrderFulfillmentSimulationPageRoutes.Root"
                            Read="@Read"
                            IsBusy="@ViewModel.처리중"
                            RefreshRequested="RefreshAsync">
    <OrderFulfillmentPickingListPanel Tasks="@Read.스냅샷.피킹작업"
                                      DetailHref="OrderFulfillmentSimulationPageRoutes.PickingTaskFor" />
</OrderFulfillmentRouteFrame>
