@page "/shipper/exploration/inbox"
@using Ssalddel.Contracts.Common.Exploration
@using SsalddelApp.Services
@inject IShipperExplorationInquiryService InquiryService

<PageTitle>받은 탐색 문의함</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">받은 탐색 문의함</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">기사님이 보낸 탐색 문의를 서버에서 확인하고 응답을 저장합니다.</MudText>
            </MudStack>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">문의 @($"{items.Count}건")</MudChip>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" md="5">
                <MudTable Items="items" Hover="true" Dense="true" OnRowClick="@((TableRowClickEventArgs<탐색문의목록항목응답> args) => OnRowClick(args))">
                    <HeaderContent>
                        <MudTh>개시자</MudTh>
                        <MudTh>탐색명</MudTh>
                        <MudTh>상태</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="개시자">@context.개시자명</MudTd>
                        <MudTd DataLabel="탐색명">
                            <MudText Typo="Typo.subtitle2">@context.탐색명</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.출발권역 → @context.희망도착권역</MudText>
                        </MudTd>
                        <MudTd DataLabel="상태">@context.대상상태</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <MudItem xs="12" md="7">
                @if (selectedDetail is null)
                {
                    <MudAlert Severity="Severity.Info">왼쪽 목록에서 받은 탐색 문의를 선택해 주세요.</MudAlert>
                }
                else
                {
                    <MudCard>
                        <MudCardContent>
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">@selectedDetail.탐색명</MudText>
                                <MudText Typo="Typo.body2">@selectedDetail.개시자명 · @selectedDetail.차량종류 · @selectedDetail.출발권역 → @selectedDetail.희망도착권역</MudText>
                                <MudAlert Severity="Severity.Info">@selectedDetail.발송메시지</MudAlert>

                                <MudGrid>
                                    <MudItem xs="12" md="4"><MudButton FullWidth="true" Variant="@ResponseVariant(운행문의응답유형.있음)" Color="Color.Success" OnClick="() => SelectResponse(운행문의응답유형.있음)">가능</MudButton></MudItem>
                                    <MudItem xs="12" md="4"><MudButton FullWidth="true" Variant="@ResponseVariant(운행문의응답유형.미정)" Color="Color.Warning" OnClick="() => SelectResponse(운행문의응답유형.미정)">미정</MudButton></MudItem>
                                    <MudItem xs="12" md="4"><MudButton FullWidth="true" Variant="@ResponseVariant(운행문의응답유형.없음)" Color="Color.Error" OnClick="() => SelectResponse(운행문의응답유형.없음)">불가</MudButton></MudItem>
                                </MudGrid>

                                <MudTextField Label="응답 메모" @bind-Value="memo" Variant="Variant.Outlined" Lines="3" />
                                <MudNumericField T="decimal?" Label="예상 중량 Kg" @bind-Value="weight" Variant="Variant.Outlined" />
                                <MudNumericField T="decimal?" Label="예상 부피 Cbm" @bind-Value="cbm" Variant="Variant.Outlined" />

                                @if (!string.IsNullOrWhiteSpace(statusMessage))
                                {
                                    <MudAlert Severity="@(hasError ? Severity.Error : Severity.Success)">@statusMessage</MudAlert>
                                }
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@(isBusy || selectedResponse is null)"
                                           OnClick="SaveResponseAsync">
                                    @(isBusy ? "저장 중" : "응답 보내기")
                                </MudButton>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                }
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    private IReadOnlyList<탐색문의목록항목응답> items = [];
    private 탐색문의상세응답? selectedDetail;
    private 운행문의응답유형? selectedResponse;
    private string? memo;
    private decimal? weight;
    private decimal? cbm;
    private bool isBusy;
    private bool hasError;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        items = await InquiryService.목록조회Async();
        if (items.Count > 0)
        {
            await LoadDetailAsync(items[0].탐색캠페인Id);
        }
    }

    private async Task OnRowClick(TableRowClickEventArgs<탐색문의목록항목응답> args)
    {
        if (args.Item is not null)
        {
            await LoadDetailAsync(args.Item.탐색캠페인Id);
        }
    }

    private async Task LoadDetailAsync(long campaignId)
    {
        selectedDetail = await InquiryService.상세조회Async(campaignId);
        if (selectedDetail is null)
        {
            selectedResponse = null;
            memo = null;
            weight = null;
            cbm = null;
            return;
        }

        selectedResponse = selectedDetail.기존응답유형;
        memo = selectedDetail.메모;
        weight = selectedDetail.최대적재중량Kg;
        cbm = selectedDetail.최대적재부피Cbm;
    }

    private async Task SaveResponseAsync()
    {
        if (selectedDetail is null || selectedResponse is null || isBusy)
        {
            return;
        }

        var campaignId = selectedDetail.탐색캠페인Id;
        isBusy = true;
        hasError = false;
        statusMessage = null;
        try
        {
            await InquiryService.응답Async(
                campaignId,
                new 탐색문의응답요청
                {
                    응답유형 = selectedResponse.Value,
                    예상중량Kg = weight,
                    예상부피Cbm = cbm,
                    메모 = memo
                });
            await LoadDetailAsync(campaignId);
            items = await InquiryService.목록조회Async();
            statusMessage = "탐색 문의 응답을 서버에 저장하고 같은 문의를 다시 조회했습니다.";
        }
        catch (Exception ex)
        {
            hasError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SelectResponse(운행문의응답유형 response)
    {
        selectedResponse = response;
        if (selectedDetail is not null)
        {
            selectedDetail.기존응답유형 = response;
            selectedDetail.기존응답일시 = DateTime.Now;
            selectedDetail.대상상태 = response switch
            {
                운행문의응답유형.있음 => 탐색캠페인대상상태값.있음응답,
                운행문의응답유형.없음 => 탐색캠페인대상상태값.없음응답,
                운행문의응답유형.미정 => 탐색캠페인대상상태값.미정응답,
                _ => 탐색캠페인대상상태값.나중응답
            };
        }
    }

    private Variant ResponseVariant(운행문의응답유형 response)
        => selectedResponse == response ? Variant.Filled : Variant.Outlined;
}
