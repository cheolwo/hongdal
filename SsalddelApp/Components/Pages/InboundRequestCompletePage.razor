@page "/shipper/inbound/requests/{InboundId:long}/complete"
@using Ssalddel.Contracts.Common.Inbound
@using Ssalddel.Contracts.Common.Sales
@inject InboundRequestPageViewModel ViewModel
@inject 판매상품조회ViewModel ProductSearchViewModel
@inject NavigationManager Navigation

<PageTitle>입고완료 #@InboundId</PageTitle>

<InboundRequestCompleteScreen State="@ViewModel.State"
                              Draft="@ViewModel.CompletionDraft"
                              Context="@Context"
                              InboundId="@InboundId"
                              HomeHref="@ShipperRoutes.WarehouseWorkspace"
                              ProductSearchViewModel="@ProductSearchViewModel"
                              SelectedSalesProduct="@ViewModel.SelectedSalesProduct"
                              CanComplete="@ViewModel.CanComplete"
                              RefreshRequested="RefreshAsync"
                              CompleteRequested="CompleteAsync"
                              SalesProductChanged="SelectSalesProductAsync" />

@code {
    [Parameter] public long InboundId { get; set; }

    private InboundRequestNavigationContext Context { get; set; } = new();
    private long loadedInboundId;

    protected override async Task OnParametersSetAsync()
    {
        Context = InboundRequestNavigationContext.Parse(Navigation.Uri);
        if (loadedInboundId == InboundId)
        {
            return;
        }

        loadedInboundId = InboundId;
        await ViewModel.LoadCompletionAsync(InboundId);
    }

    private Task RefreshAsync() => ViewModel.LoadCompletionAsync(InboundId);
    private Task CompleteAsync() => ViewModel.CompleteInboundAsync(InboundId);

    private Task SelectSalesProductAsync(판매상품항목응답? product)
    {
        ViewModel.SelectSalesProduct(product);
        return Task.CompletedTask;
    }
}
