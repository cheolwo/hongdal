@namespace SsalddelApp.Components.Pages
@using SsalddelApp.ViewModels.Shipper

<MudPaper Elevation="0" Outlined="true" Class="order-fulfillment-load-state">
    @if (Read.처리중)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.h6">Simulation 주문 이행 현황을 불러오고 있습니다.</MudText>
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h6">주문 이행 화면을 준비하지 못했습니다.</MudText>
        <MudText Typo="Typo.body2">@Read.오류메시지</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RetryRequested">다시 시도</MudButton>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public OrderFulfillmentReadViewModel Read { get; set; } = null!;

    [Parameter]
    public EventCallback RetryRequested { get; set; }
}
