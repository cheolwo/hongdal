@namespace SsalddelApp.Components.Pages
@using SsalddelApp.ViewModels.Shipper

<header class="order-fulfillment-header">
    <div>
        <MudText Typo="Typo.overline">SHIPPER · SALES · SIMULATION</MudText>
        <MudText Typo="Typo.h4">주문 출고 알림</MudText>
        <MudText Typo="Typo.body2">판매채널 샘플 주문을 국내·해외로 분류하고 로컬 재고·피킹·포장 상태를 검증합니다.</MudText>
    </div>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshRequested">
            새로고침
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.Science"
                   Disabled="@IsBusy"
                   OnClick="SimulationRequested">
            @(Simulation.처리중 ? "Simulation 반영 중" : "Simulation 샘플 반영")
        </MudButton>
    </MudStack>
</header>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="order-fulfillment-boundary">
    이 화면의 변경은 <strong>로컬 메모리 Simulation</strong>에만 남습니다. 외부 주문 수집, 실제 재고 예약·차감, 카카오톡 발송, 출고·운송·결제·정산을 실행하지 않습니다.
</MudAlert>

@if (Simulation.오류발생)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Simulation.오류메시지</MudAlert>
}
else if (Simulation.성공함)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
        @Simulation.성공메시지 처리한 샘플 @Simulation.처리건수.ToString("N0")건을 같은 Simulation 원장에서 다시 조회했습니다.
    </MudAlert>
}
else if (Read.초기화됨 && Read.오류발생)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        최신 상태를 불러오지 못해 직전 Simulation 화면을 유지합니다. @Read.오류메시지
    </MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public OrderFulfillmentReadViewModel Read { get; set; } = null!;

    [Parameter, EditorRequired]
    public OrderFulfillmentSimulationViewModel Simulation { get; set; } = null!;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback SimulationRequested { get; set; }
}
