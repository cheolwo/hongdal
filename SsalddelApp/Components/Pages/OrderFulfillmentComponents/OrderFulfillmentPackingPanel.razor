@namespace SsalddelApp.Components.Pages
@using SsalddelApp.Services.Warehouse.Fulfillment
@using SsalddelApp.ViewModels.Shipper

<MudPaper Elevation="0" Outlined="true" Class="packing-panel">
    <MudText Typo="Typo.overline">MANUAL PACKING COMMAND</MudText>
    <MudText Typo="Typo.h6">포장 작업</MudText>
    <MudText Typo="Typo.body2">피킹 완료 뒤 생성된 작업에서 시작과 완료를 각각 명시적으로 선택합니다.</MudText>

    @if (Packing.오류발생)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-3">@Packing.오류메시지</MudAlert>
    }
    else if (Packing.성공함)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">@(Packing.최근결과메시지 ?? Packing.성공메시지)</MudAlert>
    }

    @if (Tasks.Count == 0)
    {
        <div class="packing-empty">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.subtitle1">포장 작업이 없습니다.</MudText>
            <MudText Typo="Typo.body2">모든 피킹 라인이 완료된 뒤 포장 작업이 표시됩니다.</MudText>
        </div>
    }
    else
    {
        <div class="packing-list">
            @foreach (var task in Tasks.OrderByDescending(item => item.CreatedAt))
            {
                <article>
                    <div class="packing-heading">
                        <div>
                            <strong>@task.ChannelOrderNo</strong>
                            <span>@task.WarehouseName · @task.LineCount.ToString("N0")개 라인</span>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@task.Status</MudChip>
                    </div>
                    <div class="packing-actions">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" Disabled="@(IsBusy || task.Status != WarehousePackingStatusCodes.ReadyForPacking)" OnClick="@(() => StartRequested.InvokeAsync(task.Id))">포장 시작</MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Success" Disabled="@(IsBusy || task.Status != WarehousePackingStatusCodes.PackingInProgress)" OnClick="@(() => CompleteRequested.InvokeAsync(task.Id))">포장 완료</MudButton>
                    </div>
                </article>
            }
        </div>
    }

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
        수령인·주소는 포장 목록에 표시하지 않습니다. 포장 완료는 실제 출고·운송 인계를 자동 생성하지 않습니다.
    </MudAlert>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<WarehousePackingTask> Tasks { get; set; } = [];

    [Parameter, EditorRequired]
    public OrderFulfillmentPackingViewModel Packing { get; set; } = null!;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<long> StartRequested { get; set; }

    [Parameter]
    public EventCallback<long> CompleteRequested { get; set; }
}
