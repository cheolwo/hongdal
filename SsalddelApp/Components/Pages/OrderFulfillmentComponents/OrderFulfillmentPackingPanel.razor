@namespace SsalddelApp.Components.Pages
@using SsalddelApp.Services.Warehouse.Fulfillment
@using SsalddelApp.ViewModels.Shipper

<MudPaper Elevation="0" Outlined="true" Class="packing-panel">
    <MudText Typo="Typo.overline">MANUAL PACKING COMMAND</MudText>
    <MudText Typo="Typo.h6">포장 task 실행</MudText>
    <MudText Typo="Typo.body2">주소로 선택한 정확한 task ID에서 시작과 완료를 각각 명시적으로 실행합니다.</MudText>

    @if (Packing.오류발생)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-3">@Packing.오류메시지</MudAlert>
    }
    else if (Packing.성공함)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">@(Packing.최근결과메시지 ?? Packing.성공메시지)</MudAlert>
    }

    @if (SelectedTask is null)
    {
        <div class="packing-empty">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.subtitle1">포장 task를 찾을 수 없습니다.</MudText>
            <MudText Typo="Typo.body2">다른 task로 자동 대체하지 않았습니다. 목록에서 정확한 task를 다시 선택하세요.</MudText>
        </div>
    }
    else
    {
        <div class="packing-list">
            <article>
                <div class="packing-heading">
                    <div>
                        <strong>@SelectedTask.ChannelOrderNo</strong>
                        <span>@SelectedTask.WarehouseName · @SelectedTask.LineCount.ToString("N0")개 라인</span>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@SelectedTask.Status</MudChip>
                </div>
                <div class="packing-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(IsBusy || SelectedTask.Status != WarehousePackingStatusCodes.ReadyForPacking)" OnClick="@(() => StartRequested.InvokeAsync(SelectedTask.Id))">포장 시작</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(IsBusy || SelectedTask.Status != WarehousePackingStatusCodes.PackingInProgress)" OnClick="@(() => CompleteRequested.InvokeAsync(SelectedTask.Id))">포장 완료</MudButton>
                </div>
            </article>
        </div>
    }

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
        수령인·주소는 포장 화면에 표시하지 않습니다. 이 Command는 주소의 task ID에 해당하는 Simulation 작업만 바꾸고 같은 ID를 다시 조회하며 실제 출고·운송 인계를 만들지 않습니다.
    </MudAlert>
</MudPaper>

@code {
    [Parameter]
    public WarehousePackingTask? SelectedTask { get; set; }

    [Parameter, EditorRequired]
    public OrderFulfillmentPackingViewModel Packing { get; set; } = null!;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<long> StartRequested { get; set; }

    [Parameter]
    public EventCallback<long> CompleteRequested { get; set; }
}
