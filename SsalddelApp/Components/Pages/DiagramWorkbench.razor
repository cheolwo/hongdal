@page "/diagram"

<PageTitle>업무 다이어그램 작업대</PageTitle>

<CommunityDiagramWorkbenchScreen AppName="살뜰"
                                 RoleLabel="앱 사용자"
                                 AppKey="shipper"
                                 LedgerTemplateKey="@LedgerTemplateKey"
                                 SelectedNode="@SelectedNode"
                                 ZoomPercent="@ZoomPercent"
                                 Filter="@Filter"
                                 ReturnPath="@ReturnPath" />

@code {
    [Parameter, SupplyParameterFromQuery(Name = CommunityDiagramNavigationQueryNames.LedgerTemplate)]
    public string? LedgerTemplateKey { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CommunityDiagramNavigationQueryNames.SelectedNode)]
    public string? SelectedNode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CommunityDiagramNavigationQueryNames.Zoom)]
    public int? ZoomPercent { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CommunityDiagramNavigationQueryNames.Filter)]
    public string? Filter { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CommunityDiagramNavigationQueryNames.ReturnPath)]
    public string? ReturnPath { get; set; }
}
