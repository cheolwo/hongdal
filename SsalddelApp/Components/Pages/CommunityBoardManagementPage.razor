@page "/community/boards/manage"
@layout CommunityMobileLayout

<PageTitle>게시판 개설·관리 · 살뜰 커뮤니티</PageTitle>

<CommunityRoutePageFrame BackHref="@BackHref"
                         BackLabel="게시판 목록"
                         Eyebrow="공개 커뮤니티 · 01A.06"
                         Heading="게시판 관리"
                         Description="내가 운영하는 게시판의 공개 상태와 기본 정보를 관리합니다.">
    <CommunityBoardManagementScreen AppName="살뜰"
                                    RoleLabel="앱 사용자"
                                    AppKey="shipper" />
</CommunityRoutePageFrame>

@code {
    [Parameter, SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)]
    public string? QueryReturnPath { get; set; }

    private string BackHref
        => PageNavigationContext.ResolveReturnPath(QueryReturnPath, CommunityPageRoutes.Boards);
}
