@page "/shipper/sales/fulfillment"
@inherits MvvmComponentBase<OrderFulfillmentPageViewModel>

<PageTitle>판매 주문 이행 Simulation 허브</PageTitle>

<OrderFulfillmentRouteFrame Title="판매 주문 이행 Simulation"
                            Description="한 화면의 복합 탭 대신 주문, 재고, 피킹, 포장과 알림 정책을 목표별 화면으로 엽니다."
                            Read="@Read"
                            IsBusy="@ViewModel.처리중"
                            RefreshRequested="RefreshAsync">
    <OrderFulfillmentSummary Read="@Read" />

    <nav class="order-fulfillment-destinations" aria-label="판매 주문 이행 세부 화면">
        @foreach (var destination in Destinations)
        {
            <MudPaper Elevation="0" Outlined="true" Class="order-fulfillment-destination">
                <MudIcon Icon="@destination.Icon" Color="@destination.Color" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6">@destination.Title</MudText>
                    <MudText Typo="Typo.body2">@destination.Description</MudText>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="@destination.Color"
                           EndIcon="@Icons.Material.Filled.ChevronRight"
                           Href="@destination.Href">
                    화면 열기
                </MudButton>
            </MudPaper>
        }
    </nav>
</OrderFulfillmentRouteFrame>
