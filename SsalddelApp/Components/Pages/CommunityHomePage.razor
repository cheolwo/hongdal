@page "/community"
@layout CommunityMobileLayout

<PageTitle>살뜰 공개 커뮤니티</PageTitle>

<CommunityMobileBoardDirectoryScreen InitialWorkMode="@IsWorkMode" />

@code {
    [Parameter, SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private bool IsWorkMode
        => string.Equals(Mode, "work", StringComparison.OrdinalIgnoreCase);
}
