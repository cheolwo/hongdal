@page "/shipper/request/{RequestId}"
@inject ShipperRequestDetailPageViewModel PageModel
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>운송 의뢰 요약</PageTitle>

<ShipperRequestSummaryScreen State="@PageModel.State"
                             Context="@RouteContext"
                             HomeHref="@ShipperRoutes.ShipperHome"
                             NewRequestHref="@ShipperRoutes.Request"
                             RefreshRequested="RefreshAsync"
                             LookupRequested="OpenRequest" />

@code {
    [Parameter] public string? RequestId { get; set; }

    [SupplyParameterFromQuery(Name = "created")]
    public bool Created { get; set; }

    [SupplyParameterFromQuery(Name = "openFakePayment")]
    public bool OpenFakePaymentOnLoad { get; set; }

    [SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)]
    public string? ReturnPath { get; set; }

    private ShipperRequestDetailNavigationContext RouteContext
        => new() { ReturnPath = ReturnPath, Created = Created };

    protected override void OnInitialized()
        => PageModel.StateChanged += OnPageModelStateChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (OpenFakePaymentOnLoad && !string.IsNullOrWhiteSpace(RequestId))
        {
            Navigation.NavigateTo(
                RouteContext.PathFor(ShipperRequestDetailScreenKind.Payment, RequestId),
                replace: true);
            return;
        }

        await PageModel.InitializeAsync(RequestId, Created);
    }

    private Task RefreshAsync()
        => PageModel.LoadAsync(RequestId, Created);

    private void OpenRequest(string requestId)
    {
        if (!string.IsNullOrWhiteSpace(requestId))
        {
            Navigation.NavigateTo(RouteContext.PathFor(ShipperRequestDetailScreenKind.Summary, requestId));
        }
    }

    private void OnPageModelStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        PageModel.StateChanged -= OnPageModelStateChanged;
        PageModel.Dispose();
    }
}
