@namespace SsalddelApp.Components.Pages

<header class="product-listings-header">
    <div>
        <MudText Typo="Typo.overline">SHIPPER · SALES · SIMULATION</MudText>
        <MudText Typo="Typo.h4">출품 관리</MudText>
        <MudText Typo="Typo.body2">판매상품과 정확한 채널 계정을 연결해 외부 발행 전 payload와 로컬 원장을 검토합니다.</MudText>
    </div>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddBusiness"
                   Disabled="@IsBusy"
                   OnClick="SalesPageRequested">
            판매 페이지 만들기
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshRequested">
            새로고침
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Disabled="@IsBusy"
                   OnClick="ChannelsRequested">
            채널 연결
        </MudButton>
    </MudStack>
</header>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="product-listings-boundary">
    이 화면은 <strong>로컬 메모리 Simulation 출품 원장과 payload 검토 초안</strong>만 만듭니다. OAuth·API 자격증명 사용, 외부 상품 생성·수정·발행, 재고 동기화, 주문 수집, 비용 발생을 실행하지 않습니다.
</MudAlert>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback SalesPageRequested { get; set; }

    [Parameter]
    public EventCallback ChannelsRequested { get; set; }
}
