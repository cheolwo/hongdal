@page "/shipper/sales/fulfillment/picking/{TaskId:long}"
@inherits MvvmComponentBase<OrderFulfillmentPageViewModel>

<PageTitle>Simulation 피킹 task #@TaskId</PageTitle>

<OrderFulfillmentRouteFrame Title="@($"피킹 task #{TaskId}")"
                            Description="주소의 정확한 task ID에만 스캔·보류·취소 Command를 적용합니다."
                            BackHref="@OrderFulfillmentSimulationPageRoutes.Picking"
                            BackLabel="피킹 목록으로"
                            Read="@Read"
                            IsBusy="@ViewModel.처리중"
                            RefreshRequested="RefreshAndSelectAsync">
    <OrderFulfillmentPickingPanel Picking="@Picking"
                                  IsBusy="@ViewModel.처리중"
                                  ScanRequested="ScanPickingAsync"
                                  HoldRequested="HoldPickingAsync"
                                  CancelRequested="CancelPickingAsync" />
</OrderFulfillmentRouteFrame>
