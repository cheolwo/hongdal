@page "/community/ledgers/new"

<PageTitle>공동 원장 초안 · 살뜰 커뮤니티</PageTitle>

<CommunityRoutePageFrame BackHref="@BackHref"
                         BackLabel="업무·원장 공간"
                         Eyebrow="COMMUNITY LEDGER DRAFT"
                         Heading="공동 원장 초안"
                         Description="참여자와 조건을 합의하기 위한 원장 구조만 작성합니다. 실제 주문·운송·결제 실행은 별도 업무 화면에서 확인합니다.">
    <CommunityLedgerDraftScreen AppName="살뜰"
                                RoleLabel="앱 사용자"
                                AppKey="shipper"
                                LedgerTemplateKey="@QueryLedgerTemplateKey" />
</CommunityRoutePageFrame>

@code {
    [Parameter, SupplyParameterFromQuery(Name = CommunityDiagramNavigationQueryNames.LedgerTemplate)]
    public string? QueryLedgerTemplateKey { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)]
    public string? QueryReturnPath { get; set; }

    private string BackHref
        => PageNavigationContext.ResolveReturnPath(QueryReturnPath, CommunityPageRoutes.Workspace);
}
