@page "/shipper/sales/listings"
@layout ShipperMobileLayout
@inherits MvvmComponentBase<ProductListingsPageViewModel>

<PageTitle>상품 출품 후보</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <section class="product-listings-shell" aria-label="판매채널 출품 Simulation 작업공간">
        <ProductListingsHeader Eyebrow="화주 업무 · 03.16"
                               Title="상품 출품 후보"
                               Description="내부 상품 후보를 검토하고 판매채널 발행 전 초안을 확인합니다."
                               IsBusy="@ViewModel.처리중"
                               RefreshRequested="RefreshAsync"
                               SalesPageRequested="OpenSalesPageComposer"
                               ChannelsRequested="OpenSalesChannels" />

        <ProductListingFeedback Read="@Read" Draft="@Draft" Create="@Create" />

        @if (!Read.초기화됨)
        {
            <ProductListingsLoadState Read="@Read" RetryRequested="RefreshAsync" />
        }
        else
        {
            @if (Read.처리중)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }

            <ProductListingSummary Read="@Read" />

            <div class="product-listings-overview-grid">
                <ProductListingProductPanel Read="@Read"
                                            Draft="@Draft"
                                            IsBusy="@ViewModel.처리중"
                                            ProductSelected="SelectProductAsync" />
                <ProductListingLedgerPanel Read="@Read" />
            </div>

            <div class="product-listings-draft-grid">
                <ProductListingDraftPanel Read="@Read"
                                          Draft="@Draft"
                                          IsBusy="@ViewModel.처리중"
                                          ProductSelected="SelectProductAsync"
                                          AccountSelected="SelectAccountAsync"
                                          CreateRequested="CreateSimulationListingAsync" />
                <ProductListingResultPanel Read="@Read" Create="@Create" />
            </div>
        }
    </section>
</MudContainer>
