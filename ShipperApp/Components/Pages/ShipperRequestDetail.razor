@page "/shipper/request/{RequestId}"
@using ShipperApp.Models.Shipper
@using ShipperApp.Services
@inject IShipperOperationsService ShipperOperations
@inject NavigationManager Navigation

<PageTitle>운송 의뢰 상세</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">운송 의뢰 상세</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">결제, 배차, 수락, 상차, 하차, 정산 상태를 한 화면에서 확인합니다.</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.ShipperHome))">홈</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@isBusy" OnClick="LoadAsync">새로고침</MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        @if (isBusy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (request is null)
        {
            <MudAlert Severity="Severity.Warning">의뢰 정보를 찾지 못했습니다.</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" lg="4">
                    <MudPaper Elevation="0" Class="pa-4 shipper-panel">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">@request.의뢰Id</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@request.화물종류 · @request.운송방식</MudText>
                                </MudStack>
                                <MudChip T="string" Color="@ResolveOverallColor(request)" Variant="Variant.Filled">@ResolveOverallLabel(request)</MudChip>
                            </MudStack>

                            <MudDivider />

                            <MudGrid>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">의뢰 상태</MudText>
                                    <MudText Typo="Typo.body2">@Display(request.의뢰상태)</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">차량</MudText>
                                    <MudText Typo="Typo.body2">@Display(request.차량종류)</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">결제 예정</MudText>
                                    <MudText Typo="Typo.body2">@(request.결제예정금액?.ToString("N0") ?? "-")원</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">기사 지급 예정</MudText>
                                    <MudText Typo="Typo.body2">@(request.기사지급예정운임?.ToString("N0") ?? "-")원</MudText>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">상차지</MudText>
                                    <MudText Typo="Typo.body2">@Display(request.픽업지)</MudText>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">하차지</MudText>
                                    <MudText Typo="Typo.body2">@Display(request.하차지)</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="8">
                    <MudPaper Elevation="0" Class="pa-4 shipper-panel">
                        <MudStack Spacing="3">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">1.0 운송 워크플로 타임라인</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">화주가 검증해야 하는 핵심 상태를 진행 순서대로 표시합니다.</MudText>
                            </MudStack>

                            <MudGrid>
                                @foreach (var step in BuildTimeline(request))
                                {
                                    <MudItem xs="12" md="6">
                                        <MudPaper Elevation="0" Class="pa-3 shipper-panel" Style="@BuildStepStyle(step)">
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                                                <MudAvatar Color="@ResolveStepColor(step.State)" Variant="Variant.Filled" Size="Size.Medium">
                                                    <MudIcon Icon="@ResolveStepIcon(step.State)" Size="Size.Small" />
                                                </MudAvatar>
                                                <MudStack Spacing="1" Class="flex-grow-1">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                        <MudText Typo="Typo.subtitle2">@step.Title</MudText>
                                                        <MudChip T="string" Size="Size.Small" Color="@ResolveStepColor(step.State)" Variant="Variant.Outlined">@ResolveStepLabel(step.State)</MudChip>
                                                    </MudStack>
                                                    <MudText Typo="Typo.body2">@step.Status</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@step.Description</MudText>
                                                    <MudText Typo="Typo.caption">@step.Evidence</MudText>
                                                </MudStack>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>

                            <MudDivider />

                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">화주 확인 항목</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">증빙, 예외, 입금 알림, 관리자 확인 필요 여부를 화주 관점으로 다시 묶어 봅니다.</MudText>
                            </MudStack>

                            <MudGrid>
                                @foreach (var item in BuildReviewItems(request))
                                {
                                    <MudItem xs="12" md="6">
                                        <MudPaper Elevation="0" Class="pa-3 shipper-panel" Style="@BuildReviewItemStyle(item)">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                                                    <MudChip T="string" Size="Size.Small" Color="@ResolveStepColor(item.State)" Variant="Variant.Outlined">@ResolveStepLabel(item.State)</MudChip>
                                                </MudStack>
                                                <MudText Typo="Typo.body2">@item.Status</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                                                <MudText Typo="Typo.caption">@item.Detail</MudText>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string? RequestId { get; set; }

    private ShipperRequestItem? request;
    private bool isBusy;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (isBusy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(RequestId))
        {
            request = null;
            messageSeverity = Severity.Warning;
            message = "조회할 의뢰 ID가 없습니다.";
            return;
        }

        isBusy = true;
        message = null;

        try
        {
            request = await ShipperOperations.GetRequestAsync(RequestId);
            messageSeverity = Severity.Info;
            message = request is null ? "의뢰 정보를 찾지 못했습니다." : $"{request.의뢰Id} 상태를 서버에서 불러왔습니다.";
        }
        catch (Exception ex)
        {
            request = null;
            messageSeverity = Severity.Error;
            message = $"서버 API 조회 실패: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static IReadOnlyList<WorkflowTimelineStep> BuildTimeline(ShipperRequestItem item)
        =>
        [
            new(
                "결제",
                Display(item.결제상태),
                "화주 결제 또는 후불/현장 지급 조건이 확정되는 단계입니다.",
                $"결제수단 {Display(item.결제수단)} · 예정금액 {(item.결제예정금액?.ToString("N0") ?? "-")}원",
                ResolvePaymentState(item)),
            new(
                "배차",
                Display(item.배차상태),
                "서버 배차 엔진이 의뢰를 배차 대기 또는 기사 추천 대상으로 올리는 단계입니다.",
                $"차량 {Display(item.차량종류)} · 운송방식 {Display(item.운송방식)}",
                ResolveDispatchState(item)),
            new(
                "기사 수락",
                ResolveAcceptedStatusText(item),
                "추천받은 기사님이 의뢰를 수락해 실제 운송 후보가 확정되는 단계입니다.",
                $"상차지 {Display(item.픽업지)}",
                ResolveAcceptedState(item)),
            new(
                "상차",
                ResolvePickupStatusText(item),
                "기사님이 상차지에서 화물을 인수하고 상차 증빙을 남기는 단계입니다.",
                $"상차지 {Display(item.픽업지)}",
                ResolvePickupState(item)),
            new(
                "하차",
                ResolveDropoffStatusText(item),
                "기사님이 하차지에 도착해 하차 증빙과 인수 확인을 남기는 단계입니다.",
                $"하차지 {Display(item.하차지)}",
                ResolveDropoffState(item)),
            new(
                "정산",
                Display(item.정산상태),
                "운송 완료 이후 화주 결제금과 기사 지급·플랫폼 정산 상태를 맞추는 단계입니다.",
                $"기사 지급 예정 {(item.기사지급예정운임?.ToString("N0") ?? "-")}원 · 기준 운임 {(item.기준운임?.ToString("N0") ?? "-")}원",
                ResolveSettlementState(item))
        ];

    private static WorkflowStepState ResolvePaymentState(ShipperRequestItem item)
    {
        if (HasProblem(item.결제상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ContainsAny(item.결제상태, "결제완료", "승인", "완료", "입금확인"))
        {
            return WorkflowStepState.Completed;
        }

        if (ContainsAny(item.결제상태, "결제대기", "미결제", "대기", "입금대기", "청구"))
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static WorkflowStepState ResolveDispatchState(ShipperRequestItem item)
    {
        if (HasProblem(item.배차상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ContainsAny(item.배차상태, "배차확정", "기사배정", "수락", "상차", "운송", "하차", "인수", "완료"))
        {
            return WorkflowStepState.Completed;
        }

        if (ContainsAny(item.배차상태, "매칭", "배차대기", "추천", "대기"))
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static WorkflowStepState ResolveAcceptedState(ShipperRequestItem item)
    {
        if (HasProblem(item.배차상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ContainsAny(item.배차상태, "수락", "배차확정", "기사배정", "상차", "운송", "하차", "인수", "완료"))
        {
            return WorkflowStepState.Completed;
        }

        if (ContainsAny(item.배차상태, "추천", "매칭"))
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static WorkflowStepState ResolvePickupState(ShipperRequestItem item)
    {
        if (HasProblem(item.배차상태) || HasProblem(item.의뢰상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ContainsAny(item.배차상태, "상차완료", "운송", "하차", "인수", "완료") || ContainsAny(item.의뢰상태, "상차완료", "운송", "하차", "완료"))
        {
            return WorkflowStepState.Completed;
        }

        if (ContainsAny(item.배차상태, "상차지도착", "상차대기", "배차확정", "기사배정", "수락"))
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static WorkflowStepState ResolveDropoffState(ShipperRequestItem item)
    {
        if (HasProblem(item.배차상태) || HasProblem(item.의뢰상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ContainsAny(item.배차상태, "하차완료", "배송완료", "인수완료", "완료") || ContainsAny(item.의뢰상태, "하차완료", "배송완료", "완료"))
        {
            return WorkflowStepState.Completed;
        }

        if (ContainsAny(item.배차상태, "운송중", "하차지도착", "하차대기", "상차완료"))
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static WorkflowStepState ResolveSettlementState(ShipperRequestItem item)
    {
        if (HasProblem(item.정산상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ContainsAny(item.정산상태, "정산완료", "입금확인완료", "완료"))
        {
            return WorkflowStepState.Completed;
        }

        if (ContainsAny(item.정산상태, "정산대기", "입금대기", "청구대기", "입금요청", "대기"))
        {
            return WorkflowStepState.Active;
        }

        return ResolveDropoffState(item) == WorkflowStepState.Completed
            ? WorkflowStepState.Active
            : WorkflowStepState.Pending;
    }

    private static string ResolveAcceptedStatusText(ShipperRequestItem item)
        => ResolveAcceptedState(item) switch
        {
            WorkflowStepState.Completed => "기사 수락 완료",
            WorkflowStepState.Active => "기사 응답 대기",
            WorkflowStepState.Attention => "수락 흐름 확인 필요",
            _ => "수락 전"
        };

    private static string ResolvePickupStatusText(ShipperRequestItem item)
        => ResolvePickupState(item) switch
        {
            WorkflowStepState.Completed => "상차 완료",
            WorkflowStepState.Active => ContainsAny(item.배차상태, "상차지도착") ? "상차지 도착" : "상차 준비",
            WorkflowStepState.Attention => "상차 흐름 확인 필요",
            _ => "상차 전"
        };

    private static string ResolveDropoffStatusText(ShipperRequestItem item)
        => ResolveDropoffState(item) switch
        {
            WorkflowStepState.Completed => "하차 완료",
            WorkflowStepState.Active => ContainsAny(item.배차상태, "하차지도착") ? "하차지 도착" : "하차 진행",
            WorkflowStepState.Attention => "하차 흐름 확인 필요",
            _ => "하차 전"
        };

    private static string ResolveOverallLabel(ShipperRequestItem item)
    {
        if (ResolveSettlementState(item) == WorkflowStepState.Completed)
        {
            return "정산 완료";
        }

        if (ResolveDropoffState(item) == WorkflowStepState.Completed)
        {
            return "하차 완료";
        }

        if (ResolvePickupState(item) == WorkflowStepState.Completed)
        {
            return "운송 중";
        }

        if (ResolveAcceptedState(item) == WorkflowStepState.Completed)
        {
            return "기사 수락";
        }

        if (ResolveDispatchState(item) == WorkflowStepState.Active)
        {
            return "배차 진행";
        }

        return "접수";
    }

    private static Color ResolveOverallColor(ShipperRequestItem item)
    {
        if (BuildTimeline(item).Any(x => x.State == WorkflowStepState.Attention))
        {
            return Color.Error;
        }

        return ResolveSettlementState(item) == WorkflowStepState.Completed
            ? Color.Success
            : Color.Primary;
    }

    private static Color ResolveStepColor(WorkflowStepState state)
        => state switch
        {
            WorkflowStepState.Completed => Color.Success,
            WorkflowStepState.Active => Color.Primary,
            WorkflowStepState.Attention => Color.Error,
            _ => Color.Default
        };

    private static string ResolveStepIcon(WorkflowStepState state)
        => state switch
        {
            WorkflowStepState.Completed => Icons.Material.Filled.Check,
            WorkflowStepState.Active => Icons.Material.Filled.PlayArrow,
            WorkflowStepState.Attention => Icons.Material.Filled.PriorityHigh,
            _ => Icons.Material.Filled.HourglassEmpty
        };

    private static string ResolveStepLabel(WorkflowStepState state)
        => state switch
        {
            WorkflowStepState.Completed => "완료",
            WorkflowStepState.Active => "진행중",
            WorkflowStepState.Attention => "확인필요",
            _ => "대기"
        };

    private static string BuildStepStyle(WorkflowTimelineStep step)
        => step.State switch
        {
            WorkflowStepState.Completed => "border-color: var(--mud-palette-success);",
            WorkflowStepState.Active => "border-color: var(--mud-palette-primary);",
            WorkflowStepState.Attention => "border-color: var(--mud-palette-error);",
            _ => "border-color: var(--mud-palette-lines-default);"
        };

    private static IReadOnlyList<ShipperReviewItem> BuildReviewItems(ShipperRequestItem item)
        =>
        [
            new(
                "증빙/POD",
                ResolveProofStatusText(item),
                "상차/하차 사진, 인수증, 서명 또는 서명 생략 사유가 운송 기록으로 연결되는지 확인합니다.",
                ResolveProofDetailText(item),
                ResolveProofState(item)),
            new(
                "현장 예외",
                HasProblem(item.의뢰상태) || HasProblem(item.배차상태) ? "관리자 확인 필요" : "예외 없음",
                "상차지 물건 없음, 수량 불일치, 담당자 부재, 하차지 부재 같은 현장 변수가 있으면 이 영역이 먼저 바뀌어야 합니다.",
                $"의뢰 {Display(item.의뢰상태)} · 배차 {Display(item.배차상태)}",
                HasProblem(item.의뢰상태) || HasProblem(item.배차상태) ? WorkflowStepState.Attention : WorkflowStepState.Completed),
            new(
                "입금/정산 알림",
                ResolveSettlementNoticeStatusText(item),
                "운송완료후정산 또는 입금대기 건은 1일, 3일, 7일 알림 대상이 될 수 있습니다.",
                $"정산 {Display(item.정산상태)} · 결제 {Display(item.결제상태)} · 결제수단 {Display(item.결제수단)}",
                ResolveSettlementNoticeState(item)),
            new(
                "관리자 개입",
                BuildAdminReviewStatusText(item),
                "화주가 직접 해결하기 어려운 결제, 배차, 증빙, 정산 문제는 관리자 관제에서 이어서 처리합니다.",
                BuildAdminReviewDetailText(item),
                BuildAdminReviewState(item))
        ];

    private static WorkflowStepState ResolveProofState(ShipperRequestItem item)
    {
        if (HasProblem(item.의뢰상태) || HasProblem(item.배차상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ResolveDropoffState(item) == WorkflowStepState.Completed)
        {
            return WorkflowStepState.Active;
        }

        if (ResolvePickupState(item) == WorkflowStepState.Completed)
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static string ResolveProofStatusText(ShipperRequestItem item)
        => ResolveProofState(item) switch
        {
            WorkflowStepState.Active => ResolveDropoffState(item) == WorkflowStepState.Completed ? "하차 증빙 검수 대기" : "상차 증빙 생성 중",
            WorkflowStepState.Attention => "증빙 흐름 확인 필요",
            WorkflowStepState.Completed => "증빙 확인 완료",
            _ => "증빙 전"
        };

    private static string ResolveProofDetailText(ShipperRequestItem item)
    {
        if (ResolveDropoffState(item) == WorkflowStepState.Completed)
        {
            return "하차 사진/POD와 인수 확인 문서가 관리자 검수 대상으로 올라와야 합니다.";
        }

        if (ResolvePickupState(item) == WorkflowStepState.Completed)
        {
            return "상차 사진과 인수증 서명 여부가 기록되어야 합니다.";
        }

        return "기사 수락 이후 상차 단계부터 증빙이 생성됩니다.";
    }

    private static WorkflowStepState ResolveSettlementNoticeState(ShipperRequestItem item)
    {
        if (HasProblem(item.정산상태) || HasProblem(item.결제상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ResolveSettlementState(item) == WorkflowStepState.Completed)
        {
            return WorkflowStepState.Completed;
        }

        if (ContainsAny(item.정산상태, "입금대기", "정산대기", "청구대기") || ResolveDropoffState(item) == WorkflowStepState.Completed)
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static string ResolveSettlementNoticeStatusText(ShipperRequestItem item)
        => ResolveSettlementNoticeState(item) switch
        {
            WorkflowStepState.Completed => "정산 완료",
            WorkflowStepState.Active => "입금/정산 안내 필요",
            WorkflowStepState.Attention => "정산 문제 확인 필요",
            _ => "정산 전"
        };

    private static WorkflowStepState BuildAdminReviewState(ShipperRequestItem item)
    {
        if (HasProblem(item.의뢰상태) || HasProblem(item.배차상태) || HasProblem(item.결제상태) || HasProblem(item.정산상태))
        {
            return WorkflowStepState.Attention;
        }

        if (ResolveSettlementNoticeState(item) == WorkflowStepState.Active || ResolveProofState(item) == WorkflowStepState.Active)
        {
            return WorkflowStepState.Active;
        }

        return WorkflowStepState.Pending;
    }

    private static string BuildAdminReviewStatusText(ShipperRequestItem item)
        => BuildAdminReviewState(item) switch
        {
            WorkflowStepState.Attention => "관리자 개입 필요",
            WorkflowStepState.Active => "관리자 검수/알림 대기",
            WorkflowStepState.Completed => "확인 완료",
            _ => "개입 전"
        };

    private static string BuildAdminReviewDetailText(ShipperRequestItem item)
    {
        if (HasProblem(item.결제상태))
        {
            return "결제 실패, 환불, 미수 상태는 결제 관리 화면과 관제 상세에서 함께 확인합니다.";
        }

        if (HasProblem(item.배차상태) || HasProblem(item.의뢰상태))
        {
            return "배차 보류, 거절, 현장 예외 상태는 관리자 관제 상세에서 운송 이벤트와 함께 확인합니다.";
        }

        if (ResolveDropoffState(item) == WorkflowStepState.Completed)
        {
            return "하차 완료 이후 증빙 검수와 정산 안내가 관리자 관제 대상으로 이어집니다.";
        }

        return "아직 관리자 개입이 필요한 후속 단계는 없습니다.";
    }

    private static string BuildReviewItemStyle(ShipperReviewItem item)
        => item.State switch
        {
            WorkflowStepState.Completed => "border-color: var(--mud-palette-success);",
            WorkflowStepState.Active => "border-color: var(--mud-palette-primary);",
            WorkflowStepState.Attention => "border-color: var(--mud-palette-error);",
            _ => "border-color: var(--mud-palette-lines-default);"
        };

    private static bool ContainsAny(string? value, params string[] tokens)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return tokens.Any(token => value.Contains(token, StringComparison.OrdinalIgnoreCase));
    }

    private static bool HasProblem(string? value)
        => ContainsAny(value, "취소", "환불", "거절", "실패", "반려", "예외", "미수발생");

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "미확인" : value;

    private sealed record WorkflowTimelineStep(
        string Title,
        string Status,
        string Description,
        string Evidence,
        WorkflowStepState State);

    private sealed record ShipperReviewItem(
        string Title,
        string Status,
        string Description,
        string Detail,
        WorkflowStepState State);

    private enum WorkflowStepState
    {
        Pending,
        Active,
        Completed,
        Attention
    }
}
