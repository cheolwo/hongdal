@inject HongdalClientRoleService RoleService
@inject NavigationManager Navigation

<PlatformCommunityHome AppName="홍달 앱"
                       RoleLabel="공통 사용자"
                       AppKey="role-neutral"
                       ShowRealtimeBest="true"
                       ShowPrajnaUpayaNavigator="true">
    <CommunityModeContent>
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Primary">역할을 정하기 전의 공통 홈</MudText>
                <MudText Typo="Typo.h6">반야와 방편의 태극에서 시작합니다.</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    커뮤니티와 상점은 그대로 이용하고, 업무가 필요할 때 화주 또는 창고 관리자 역할을 선택할 수 있습니다.
                </MudText>
            </MudStack>
        </MudPaper>
    </CommunityModeContent>

    <WorkModeContent>
        <MudStack Spacing="3">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">업무 역할 선택</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    역할을 고르면 바깥 태극이 해당 역할의 사방괘로 바뀝니다.
                </MudText>
            </MudStack>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                        <MudStack Spacing="2" Class="h-100">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.h6">화주</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="flex-grow-1">
                                운송 의뢰와 판매·물류 흐름을 운영합니다.
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SelectRole(HongdalClientRole.Shipper))">
                                화주로 시작
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                        <MudStack Spacing="2" Class="h-100">
                            <MudIcon Icon="@Icons.Material.Filled.Warehouse" Color="Color.Success" Size="Size.Large" />
                            <MudText Typo="Typo.h6">창고 관리자</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="flex-grow-1">
                                입고·출고·판매·운송을 연결해 운영합니다.
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => SelectRole(HongdalClientRole.WarehouseManager))">
                                창고 관리로 시작
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudStack>
    </WorkModeContent>
</PlatformCommunityHome>

@code {
    private void SelectRole(HongdalClientRole role)
    {
        RoleService.SetRole(role);
        Navigation.NavigateTo(ShipperRoutes.Home);
    }
}
