@page "/learn/prajna"
@inject NavigationManager Navigation

<PageTitle>반야 강의 · 홍익학당</PageTitle>

<div class="prajna-page">
    <button type="button"
            class="prajna-page__back"
            aria-label="홍달 홈으로 돌아가기"
            @onclick="GoHome">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
        홍달 홈
    </button>

    <HongdalPrajnaLectureLibrary CommunityHref="@ShipperRoutes.Home"
                                  DecorationStoreHref="@ShipperRoutes.CommunityDecorations"
                                  InitialPlaylistId="@PlaylistId" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "playlist")]
    public string? PlaylistId { get; set; }

    private void GoHome()
        => Navigation.NavigateTo(ShipperRoutes.Home);
}
