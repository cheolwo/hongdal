    protected override async Task OnInitializedAsync()
    {
        await AuthSession.RestoreAsync();
        await ViewVisibilityService.EnsureLoadedAsync();
        await LoadCommonContentsAsync();
        await LoadRequestsAsync();
    }

    private async Task LoadCommonContentsAsync()
    {
        try
        {
            _혜택콘텐츠 = await 화주공통콘텐츠Service.혜택콘텐츠조회Async();
            _공지콘텐츠 = await 화주공통콘텐츠Service.공지콘텐츠조회Async();
        }
        catch
        {
            _혜택콘텐츠 = null;
            _공지콘텐츠 = null;
        }
    }

    private async Task LoginAsync()
    {
        if (isBusy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(loginId) || string.IsNullOrWhiteSpace(password))
        {
            statusSeverity = Severity.Warning;
            statusMessage = L.T("Home.Validation.LoginRequired");
            return;
        }

        isBusy = true;
        statusMessage = null;

        try
        {
            var result = await AuthApi.LoginAsync(loginId, password);
            if (!result.IsSuccess)
            {
                statusSeverity = Severity.Error;
                statusMessage = result.ErrorMessage;
                return;
            }

            statusSeverity = Severity.Success;
            statusMessage = L.T("Home.Message.LoginSucceeded", AuthSession.UserName);
            await ViewVisibilityService.ReloadAsync();
        }
        finally
        {
            isBusy = false;
        }

        await LoadRequestsAsync();
    }

    private async Task Logout()
    {
        await AuthApi.LogoutAsync();
        statusSeverity = Severity.Info;
        statusMessage = L.T("Home.Message.LoggedOut");
        await ViewVisibilityService.ReloadAsync();
        await LoadRequestsAsync();
    }

    private async Task LoadRequestsAsync()
    {
        requests = (await ShipperOperations.GetRequestsAsync()).ToList();
        warehouses = await ShipperOperations.GetWarehousesAsync();
        inbounds = await ShipperOperations.GetInboundsAsync();
        inventory = await ShipperOperations.GetInventoryAsync();
        RefreshWorkflow();
    }

    protected override void OnParametersSet()
    {
        RefreshWorkflow();
    }

    private void RefreshWorkflow()
    {
        var latest = requests.OrderByDescending(x => x.생성일시).FirstOrDefault();
        var currentState = latest is null
            ? L.T("Home.Workflow.NoRequest")
            : L.T("Home.Workflow.LatestRequest", latest.의뢰상태, latest.결제상태, latest.배차상태);

        var currentIndex = ResolveCurrentStepIndex(latest);
        Workflow.RoleTitle = L.T("Home.WorkflowTitle");
        Workflow.CurrentStateLabel = currentState;
        Workflow.NextActionLabel = ResolveNextActionLabel(currentIndex);
        Workflow.PrimaryActionKey = currentIndex == 0 ? "create-request" : "review-request";
        Workflow.Steps = new ObservableCollection<WorkflowStepItem>(BuildSteps(currentIndex));
    }

    private static int ResolveCurrentStepIndex(ShipperRequestItem? latest)
    {
        if (latest is null)
        {
            return 0;
        }

        if (IsMatch(latest.결제상태, "결제대기", "미결제", "대기"))
        {
            return 1;
        }

        if (IsMatch(latest.결제상태, "결제완료") && IsMatch(latest.배차상태, "매칭중", "배차대기", "대기"))
        {
            return 2;
        }

        if (IsMatch(latest.배차상태, "기사배정", "배차확정"))
        {
            return 3;
        }

        if (IsMatch(latest.배차상태, "운송중", "상차완료", "운송"))
        {
            return 4;
        }

        if (IsMatch(latest.배차상태, "배송완료", "하차완료", "완료"))
        {
            return 5;
        }

        if (IsMatch(latest.의뢰상태, "취소", "환불"))
        {
            return 5;
        }

        return 2;
    }

    private string ResolveNextActionLabel(int currentIndex)
    {
        return currentIndex switch
        {
            0 => L.T("Home.Action.NewRequest"),
            1 => L.T("Home.Action.Pay"),
            2 => L.T("Home.Action.CheckDispatch"),
            3 => L.T("Home.Action.TransportStatus"),
            4 => L.T("Home.Action.DeliveryComplete"),
            5 => L.T("Home.Action.AllRequests"),
            _ => L.T("Home.Action.CheckWork")
        };
    }

    private IReadOnlyList<WorkflowStepItem> BuildSteps(int currentIndex)
    {
        var labels = new[]
        {
            ("request", L.T("Home.Step.Request.Title"), L.T("Home.Step.Request.Description")),
            ("payment", L.T("Home.Step.Payment.Title"), L.T("Home.Step.Payment.Description")),
            ("dispatch", L.T("Home.Step.Dispatch.Title"), L.T("Home.Step.Dispatch.Description")),
            ("transport", L.T("Home.Step.Transport.Title"), L.T("Home.Step.Transport.Description")),
            ("complete", L.T("Home.Step.Complete.Title"), L.T("Home.Step.Complete.Description")),
            ("history", L.T("Home.Step.History.Title"), L.T("Home.Step.History.Description"))
        };

        var steps = new List<WorkflowStepItem>();
        for (var index = 0; index < labels.Length; index++)
        {
            var (key, title, description) = labels[index];
            steps.Add(new WorkflowStepItem
            {
                Key = key,
                Title = title,
                Description = description,
                IsCurrent = index == currentIndex,
                IsCompleted = index < currentIndex,
                IsAvailable = index <= currentIndex + 1,
                AccentColor = index == currentIndex ? "#0F766E" : index < currentIndex ? "#16A34A" : "#94A3B8"
            });
        }

        return steps;
    }

    private string StepStateLabel(WorkflowStepItem step)
    {
        return step.IsCurrent
            ? L.T("Home.CurrentStep")
            : step.IsCompleted
                ? L.T("Home.Completed")
                : L.T("Home.NextStep");
    }

    private static bool IsMatch(string? value, params string[] keywords)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return keywords.Any(keyword => value.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    private void HandlePrimaryAction()
    {
        if (string.Equals(Workflow.PrimaryActionKey, "create-request", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(ShipperRoutes.Request);
        }
    }

    private void GoToRequestWizard() => Navigation.NavigateTo(ShipperRoutes.Request);

    private void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private static string BuildRequestRelatedParties(ShipperRequestItem request)
    {
        var dispatchParty = string.IsNullOrWhiteSpace(request.배차상태)
            ? "기사 매칭 대상"
            : $"기사 {request.배차상태}";

        var dropoffParty = string.IsNullOrWhiteSpace(request.하차지)
            ? "하차지 담당자"
            : $"하차지 {request.하차지}";

        return $"화주 · {dispatchParty} · {dropoffParty}";
    }

    private static string BuildRequestNextCheck(ShipperRequestItem request)
    {
        if (IsMatch(request.결제상태, "결제대기", "미결제", "대기"))
        {
            return "결제 확인";
        }

        if (IsMatch(request.배차상태, "매칭중", "배차대기", "대기"))
        {
            return "기사 매칭";
        }

        if (IsMatch(request.배차상태, "기사배정", "배차확정"))
        {
            return "상차 대기";
        }

        if (IsMatch(request.배차상태, "운송중", "상차완료", "운송"))
        {
            return "하차 진행";
        }

        return "상세 확인";
    }

    private static string BuildPolicyLabel(ShipperRequestItem request)
    {
        if (request.정책위반)
        {
            return "정책확인";
        }

        if (request.재알선의심)
        {
            return "재알선의심";
        }

        return "정책정상";
    }

    private static string BuildFarePolicySummary(ShipperRequestItem request)
    {
        var baseFare = request.기준운임?.ToString("N0") ?? "-";
        var driverFare = request.기사지급예정운임?.ToString("N0") ?? "-";
        return $"기준 {baseFare}원 / 기사 {driverFare}원";
    }

    private static string BuildPolicyWarningText(ShipperRequestItem request)
    {
        return request.정책경고목록.Count == 0
            ? "경고 없음"
            : string.Join(" / ", request.정책경고목록);
    }

    private static Color ResolvePolicyColor(ShipperRequestItem request)
    {
        if (request.정책위반)
        {
            return Color.Warning;
        }

        if (request.재알선의심)
        {
            return Color.Error;
        }

        return Color.Success;
    }

    private static Color ResolvePaymentColor(string status)
    {
        if (IsMatch(status, "결제완료"))
        {
            return Color.Success;
        }

        if (IsMatch(status, "결제대기", "미결제", "대기"))
        {
            return Color.Warning;
        }

        return Color.Default;
    }

    private static Color ResolveDispatchColor(string status)
    {
        if (IsMatch(status, "배송완료", "하차완료", "완료"))
        {
            return Color.Success;
        }

        if (IsMatch(status, "운송중", "상차완료", "운송"))
        {
            return Color.Info;
        }

        if (IsMatch(status, "매칭중", "배차대기", "대기"))
        {
            return Color.Warning;
        }

        return Color.Primary;
    }

    private IReadOnlyList<WorkActionItem> BuildWorkActions()
    {
        var paymentWaitingCount = requests.Count(x => IsMatch(x.결제상태, "결제대기", "미결제", "대기"));
        var dispatchWaitingCount = requests.Count(x => IsMatch(x.배차상태, "매칭중", "배차대기", "대기"));
        var pendingInboundCount = inbounds.Count(x => string.Equals(x.상태, "입고예정", StringComparison.OrdinalIgnoreCase));
        var actionableInventoryCount = inventory.Count(x => x.가용수량 > 0);

        return
        [
            new WorkActionItem(
                L.T("Home.Console.Payment.Title"),
                L.T("Home.Console.Payment.Description"),
                paymentWaitingCount.ToString(),
                L.T("Home.Console.Payment.Action"),
                ShipperRoutes.Request,
                Icons.Material.Filled.Payments,
                Color.Primary),
            new WorkActionItem(
                L.T("Home.Console.Dispatch.Title"),
                L.T("Home.Console.Dispatch.Description"),
                dispatchWaitingCount.ToString(),
                L.T("Home.Console.Dispatch.Action"),
                ShipperRoutes.PublicCargo,
                Icons.Material.Filled.LocalShipping,
                Color.Info),
            new WorkActionItem(
                "FCL/LCL 판단",
                "해외 화물량과 혼재 가능 여부를 기준으로 배송대행 협의 방향을 잡습니다.",
                "국제",
                "판단하기",
                ShipperRoutes.FclLclPlanner,
                Icons.Material.Filled.Public,
                Color.Primary),
            new WorkActionItem(
                L.T("Home.Console.Inbound.Title"),
                L.T("Home.Console.Inbound.Description"),
                pendingInboundCount.ToString(),
                L.T("Home.Console.Inbound.Action"),
                ShipperRoutes.InboundRequests,
                Icons.Material.Filled.Warehouse,
                Color.Warning),
            new WorkActionItem(
                L.T("Home.Console.Inventory.Title"),
                L.T("Home.Console.Inventory.Description"),
                actionableInventoryCount.ToString(),
                L.T("Home.Console.Inventory.Action"),
                ShipperRoutes.WarehouseInventory,
                Icons.Material.Filled.Inventory2,
                Color.Success)
        ];
    }

    private async Task ShowPayMessage(ShipperRequestItem request)
    {
        var page = Application.Current?.Windows.FirstOrDefault()?.Page;
        if (page is null)
        {
            return;
        }

        await page.DisplayAlertAsync(
            L.T("Home.Alert.PaymentTitle"),
            L.T("Home.Alert.PaymentMessage", request.의뢰Id),
            L.T("Home.Alert.Confirm"));
    }

    private sealed record WorkActionItem(
        string Title,
        string Description,
        string Count,
        string ActionLabel,
        string Route,
        string Icon,
        Color Color);
}
