@page "/"
@page "/shipper"
@using System.Collections.ObjectModel
@using Hongdal.Contracts.Common.Inbound
@using Hongdal.Contracts.Common.Inventory
@using Hongdal.Contracts.Common.Warehouse
@using ShipperApp.Models.Shipper
@using ShipperApp.Models.Workflow
@using ShipperApp.Services
@inject AuthApiService AuthApi
@inject IAuthSession AuthSession
@inject IShipperOperationsService ShipperOperations
@inject NavigationManager Navigation
@inject ShipperViewVisibilityService ViewVisibilityService
@inject I화주공통콘텐츠Service 화주공통콘텐츠Service
@inject ShipperLocalizationService L

<PageTitle>@L.T("Home.PageTitle")</PageTitle>

<PlatformCommunityHome AppName="Hongdal Shipper"
                       RoleLabel="화주"
                       AppKey="shipper"
                       QuickActions="QuickActions">
    <CommunityModeContent>
        @if (_혜택콘텐츠 is not null || _공지콘텐츠 is not null)
        {
            <MudCard Elevation="0" Class="shipper-panel">
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@L.T("Home.CommonContent")</MudText>

                        @if (_혜택콘텐츠 is not null)
                        {
                            <MudPaper Elevation="0" Class="pa-3 shipper-panel" Style="border-color: var(--mud-palette-info);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Info">@L.T("Home.Benefit")</MudText>
                                <MudText Typo="Typo.body1" Class="fw-bold">@_혜택콘텐츠.제목</MudText>
                                @if (!string.IsNullOrWhiteSpace(_혜택콘텐츠.설명))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_혜택콘텐츠.설명</MudText>
                                }
                            </MudPaper>
                        }

                        @if (_공지콘텐츠 is not null)
                        {
                            <MudPaper Elevation="0" Class="pa-3 shipper-panel" Style="border-color: var(--mud-palette-warning);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Warning">@L.T("Home.Notice")</MudText>
                                <MudText Typo="Typo.body1" Class="fw-bold">@_공지콘텐츠.제목</MudText>
                                @if (!string.IsNullOrWhiteSpace(_공지콘텐츠.설명))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_공지콘텐츠.설명</MudText>
                                }
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    </CommunityModeContent>

    <WorkModeContent>
    <MudStack Spacing="3" Class="shipper-page">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="shipper-page-header">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">@L.T("Home.Title")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Home.Subtitle")</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2" Class="shipper-page-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadRequestsAsync">@L.T("Home.Refresh")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToRequestWizard">@L.T("Home.CreateRequest")</MudButton>
            </MudStack>
        </MudStack>

        @if (!isLoggedIn)
        {
            <MudCard Elevation="0" Class="shipper-panel">
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@L.T("Home.LoginTitle")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L.T("Home.LoginDescription")</MudText>
                        <MudTextField @bind-Value="loginId" Label='@L.T("Home.LoginId")' Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="password" Label='@L.T("Home.Password")' InputType="InputType.Password" Variant="Variant.Outlined" />
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="isBusy" OnClick="LoginAsync">@(isBusy ? L.T("Home.LoggingIn") : L.T("Home.Login"))</MudButton>
                        @if (!string.IsNullOrWhiteSpace(statusMessage))
                        {
                            <MudAlert Severity="@statusSeverity">@statusMessage</MudAlert>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudTabs Class="shipper-work-tabs" Rounded="true">
                <MudTabPanel Text="운송">
                    <MudStack Spacing="3" Class="pt-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">운송 업무</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">결제, 배차, 운송 의뢰 진행 상태를 먼저 확인합니다.</MudText>
                        </MudStack>

                        <MudGrid>
                            @foreach (var action in TransportActions)
                            {
                                <MudItem xs="12" sm="6" lg="3">
                                    <MudPaper Elevation="0" Class="pa-4 h-100 shipper-action-card">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@action.Icon" Color="@action.Color" />
                                                <MudChip T="string" Size="Size.Small" Color="@action.Color" Variant="Variant.Outlined">@action.Count</MudChip>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@action.Title</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                            </MudStack>
                                            <MudButton Variant="Variant.Text" Color="@action.Color" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="() => NavigateTo(action.Route)">
                                                @action.ActionLabel
                                            </MudButton>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudCard Elevation="0" Class="shipper-panel">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Class="mb-3">@L.T("Home.RequestList")</MudText>

                                @if (requests.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info">@L.T("Home.NoRequests")</MudAlert>
                                }
                                else
                                {
                                    <MudGrid>
                                        @foreach (var request in requests)
                                        {
                                            <MudItem xs="12" md="6">
                                                <MudPaper Elevation="0" Class="pa-0 shipper-panel">
                                                    <MudCardContent>
                                                        <MudStack Spacing="1">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                                                <MudStack Spacing="0">
                                                                    <MudText Typo="Typo.subtitle1">@request.의뢰Id</MudText>
                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@request.화물종류 · @request.의뢰상태</MudText>
                                                                </MudStack>
                                                                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                                                    <MudChip T="string" Size="Size.Small" Color="@ResolvePaymentColor(request.결제상태)" Variant="Variant.Outlined">@request.결제상태</MudChip>
                                                                    <MudChip T="string" Size="Size.Small" Color="@ResolveDispatchColor(request.배차상태)" Variant="Variant.Outlined">@request.배차상태</MudChip>
                                                                    <MudChip T="string" Size="Size.Small" Color="@ResolvePolicyColor(request)" Variant="Variant.Outlined">@BuildPolicyLabel(request)</MudChip>
                                                                </MudStack>
                                                            </MudStack>

                                                            <MudPaper Elevation="0" Class="pa-3 shipper-panel" Style="border-color: var(--mud-palette-primary);">
                                                                <MudGrid>
                                                                    <MudItem xs="6" md="4">
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">결제예정</MudText>
                                                                        <MudText Typo="Typo.body2">@(request.결제예정금액?.ToString("N0") ?? "-")원</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="6" md="4">
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">결제</MudText>
                                                                        <MudText Typo="Typo.body2">@request.결제상태</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="12" md="4">
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">다음 확인</MudText>
                                                                        <MudText Typo="Typo.body2">@BuildRequestNextCheck(request)</MudText>
                                                                    </MudItem>
                                                                    <MudItem xs="12" md="4">
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">요금 정책</MudText>
                                                                        <MudText Typo="Typo.body2">@BuildFarePolicySummary(request)</MudText>
                                                                    </MudItem>
                                                                </MudGrid>
                                                            </MudPaper>

                                                            <HongdalSensitiveDisclosureList Title="의뢰 상세"
                                                                                            Summary="@request.결제상태"
                                                                                            RelatedParties="@BuildRequestRelatedParties(request)"
                                                                                            Icon="@Icons.Material.Filled.LocalShipping"
                                                                                            Color="Color.Primary"
                                                                                            PrivacyHint="주소와 결제 정보는 필요한 순간에만 펼쳐 확인합니다.">
                                                                <MudExpansionPanel Text="화물 정보" Expanded="true">
                                                                    <HongdalSensitiveInfoRow Label='@L.T("Home.CargoType")' Value="@request.화물종류" />
                                                                    <HongdalSensitiveInfoRow Label="의뢰 상태" Value="@request.의뢰상태" />
                                                                    <HongdalSensitiveInfoRow Label='@L.T("Home.CreatedAt")' Value='@request.생성일시.ToLocalTime().ToString("yyyy-MM-dd HH:mm")' />
                                                                </MudExpansionPanel>
                                                                <MudExpansionPanel Text="운송 정보">
                                                                    <HongdalSensitiveInfoRow Label='@L.T("Home.Pickup")' Value='@(request.픽업지 ?? "-")' />
                                                                    <HongdalSensitiveInfoRow Label="하차지" Value='@(request.하차지 ?? "-")' />
                                                                    <HongdalSensitiveInfoRow Label='@L.T("Home.Dispatch")' Value="@request.배차상태" />
                                                                </MudExpansionPanel>
                                                                <MudExpansionPanel Text="결제 정보">
                                                                    <HongdalSensitiveInfoRow Label='@L.T("Home.Payment")' Value="@request.결제상태" />
                                                                    <HongdalSensitiveInfoRow Label='@L.T("Home.PaymentMethod")' Value="@request.결제수단" />
                                                                    <HongdalSensitiveInfoRow Label="예정 금액" Value='@(request.결제예정금액?.ToString("N0") ?? "-")' />
                                                                    <HongdalSensitiveInfoRow Label="기준 운임" Value='@(request.기준운임?.ToString("N0") ?? "-")' />
                                                                    <HongdalSensitiveInfoRow Label="기사 지급 예정" Value='@(request.기사지급예정운임?.ToString("N0") ?? "-")' />
                                                                </MudExpansionPanel>
                                                                <MudExpansionPanel Text="요금/알선 정책">
                                                                    <HongdalSensitiveInfoRow Label="알선 단계" Value='@($"{request.알선단계}단계")' />
                                                                    <HongdalSensitiveInfoRow Label="재알선 금지" Value='@(request.재알선금지 ? "적용" : "미적용")' />
                                                                    <HongdalSensitiveInfoRow Label="정책 상태" Value="@BuildPolicyLabel(request)" />
                                                                    <HongdalSensitiveInfoRow Label="경고" Value="@BuildPolicyWarningText(request)" />
                                                                </MudExpansionPanel>
                                                            </HongdalSensitiveDisclosureList>

                                                            @if (request.CanPay)
                                                            {
                                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => ShowPayMessage(request)">@L.T("Home.Pay")</MudButton>
                                                            }
                                                        </MudStack>
                                                    </MudCardContent>
                                                </MudPaper>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="창고">
                    <MudStack Spacing="3" Class="pt-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">창고 업무</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">입고 예정, 재고, 작업대 스캔 흐름을 창고 업무로 모아 확인합니다.</MudText>
                        </MudStack>

                        <MudGrid>
                            @foreach (var action in WarehouseActions)
                            {
                                <MudItem xs="12" sm="6" lg="3">
                                    <MudPaper Elevation="0" Class="pa-4 h-100 shipper-action-card">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@action.Icon" Color="@action.Color" />
                                                <MudChip T="string" Size="Size.Small" Color="@action.Color" Variant="Variant.Outlined">@action.Count</MudChip>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@action.Title</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                            </MudStack>
                                            <MudButton Variant="Variant.Text" Color="@action.Color" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="() => NavigateTo(action.Route)">
                                                @action.ActionLabel
                                            </MudButton>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }

                            @foreach (var action in WarehouseShortcutActions)
                            {
                                <MudItem xs="12" sm="6" lg="3">
                                    <MudPaper Elevation="0" Class="pa-4 h-100 shipper-action-card">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@action.Icon" Color="@action.Color" />
                                                <MudChip T="string" Size="Size.Small" Color="@action.Color" Variant="Variant.Outlined">@action.Count</MudChip>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@action.Title</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                            </MudStack>
                                            <MudButton Variant="Variant.Text" Color="@action.Color" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="() => NavigateTo(action.Route)">
                                                @action.ActionLabel
                                            </MudButton>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>

                        <ShipperOperationsWorkspace />
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="판매">
                    <MudStack Spacing="3" Class="pt-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">판매 업무</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">판매채널 연결, 상품 출품, 주문 출고 알림을 한 곳에서 시작합니다.</MudText>
                        </MudStack>

                        <MudGrid>
                            @foreach (var action in SalesActions)
                            {
                                <MudItem xs="12" sm="6" lg="4">
                                    <MudPaper Elevation="0" Class="pa-4 h-100 shipper-action-card">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@action.Icon" Color="@action.Color" />
                                                <MudChip T="string" Size="Size.Small" Color="@action.Color" Variant="Variant.Outlined">@action.Count</MudChip>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@action.Title</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                            </MudStack>
                                            <MudButton Variant="Variant.Text" Color="@action.Color" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="() => NavigateTo(action.Route)">
                                                @action.ActionLabel
                                            </MudButton>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="통관">
                    <MudStack Spacing="3" Class="pt-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">통관 업무</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">HS 코드 검토와 관세사 확인이 필요한 건을 분리해서 확인합니다.</MudText>
                        </MudStack>

                        <MudGrid>
                            @foreach (var action in CustomsActions)
                            {
                                <MudItem xs="12" sm="6" lg="4">
                                    <MudPaper Elevation="0" Class="pa-4 h-100 shipper-action-card">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@action.Icon" Color="@action.Color" />
                                                <MudChip T="string" Size="Size.Small" Color="@action.Color" Variant="Variant.Outlined">@action.Count</MudChip>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@action.Title</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                            </MudStack>
                                            <MudButton Variant="Variant.Text" Color="@action.Color" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="() => NavigateTo(action.Route)">
                                                @action.ActionLabel
                                            </MudButton>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        }
    </MudStack>
    </WorkModeContent>
</PlatformCommunityHome>

@code {
    [CascadingParameter]
    public string Language { get; set; } = string.Empty;

    private readonly WorkflowOverview Workflow = new();
    private List<ShipperRequestItem> requests = [];
    private IReadOnlyList<창고요약응답> warehouses = [];
    private IReadOnlyList<입고요청항목응답> inbounds = [];
    private IReadOnlyList<재고항목응답> inventory = [];
    private string loginId = string.Empty;
    private string password = string.Empty;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private bool isBusy;
    private 홍달위젯콘텐츠Dto? _혜택콘텐츠;
    private 홍달위젯콘텐츠Dto? _공지콘텐츠;
    private bool isLoggedIn => AuthSession.IsLoggedIn;
    private IReadOnlyList<WorkActionItem> WorkActions => BuildWorkActions();
    private IReadOnlyList<WorkActionItem> TransportActions => WorkActions
        .Where(x => x.Route == ShipperRoutes.Request || x.Route == ShipperRoutes.PublicCargo || x.Route == ShipperRoutes.FclLclPlanner)
        .ToArray();
    private IReadOnlyList<WorkActionItem> WarehouseActions => WorkActions
        .Where(x => x.Route == ShipperRoutes.InboundRequests || x.Route == ShipperRoutes.WarehouseInventory)
        .ToArray();
    private static readonly IReadOnlyList<WorkActionItem> WarehouseShortcutActions =
    [
        new(
            "창고 작업대",
            "입고, 출고, 포장 작업의 시작 화면으로 이동합니다.",
            "바로가기",
            "작업대 열기",
            ShipperRoutes.WarehouseWorkspace,
            Icons.Material.Filled.Warehouse,
            Color.Warning),
        new(
            "스캔 스테이션",
            "작업대 바코드와 상품 바코드를 스캔하는 화면으로 이동합니다.",
            "스캔",
            "스캔하기",
            ShipperRoutes.WarehouseScan,
            Icons.Material.Filled.QrCodeScanner,
            Color.Success)
    ];
    private static readonly IReadOnlyList<WorkActionItem> SalesActions =
    [
        new(
            "판매채널 연결",
            "마켓, 주문 채널, 상품 출품 연동 상태를 관리합니다.",
            "채널",
            "연결 관리",
            ShipperRoutes.SalesChannels,
            Icons.Material.Filled.Storefront,
            Color.Primary),
        new(
            "상품 출품",
            "재고를 판매 상품으로 전환하고 판매 정보를 관리합니다.",
            "상품",
            "상품 관리",
            ShipperRoutes.ProductListings,
            Icons.Material.Filled.Inventory,
            Color.Success),
        new(
            "주문 출고",
            "판매 주문 출고 알림과 창고 출고 연결 상태를 확인합니다.",
            "주문",
            "출고 확인",
            ShipperRoutes.OrderFulfillment,
            Icons.Material.Filled.Outbox,
            Color.Info)
    ];
    private static readonly IReadOnlyList<WorkActionItem> CustomsActions =
    [
        new(
            "FCL/LCL 판단",
            "화물량에 따라 FCL, LCL, 비교 견적 여부를 판단하고 배송대행 협의 항목을 정리합니다.",
            "협의",
            "판단하기",
            ShipperRoutes.FclLclPlanner,
            Icons.Material.Filled.Public,
            Color.Primary),
        new(
            "HS 코드 검토",
            "통관 대행이나 수입 대행 전에 HS 코드 검토 요청을 확인합니다.",
            "검토",
            "검토 보기",
            ShipperRoutes.CustomsHsReviews,
            Icons.Material.Filled.FactCheck,
            Color.Secondary)
    ];
    private static readonly IReadOnlyList<PlatformHomeQuickAction> QuickActions =
    [
        new("운송 의뢰", "화물 운송 의뢰를 새로 등록합니다.", ShipperRoutes.Request, Icons.Material.Filled.AddRoad, Color.Primary),
        new("FCL/LCL 판단", "해외 화물량 기준으로 FCL/LCL 협의 방향을 잡습니다.", ShipperRoutes.FclLclPlanner, Icons.Material.Filled.Public, Color.Primary),
        new("입고 현황", "입고 요청과 입고 예정 상태를 확인합니다.", ShipperRoutes.InboundRequests, Icons.Material.Filled.Warehouse, Color.Warning),
        new("재고 조회", "창고 재고와 재위탁 가능 수량을 확인합니다.", ShipperRoutes.WarehouseInventory, Icons.Material.Filled.Inventory2, Color.Success),
        new("판매 주문", "판매 채널 주문 출고 알림을 확인합니다.", ShipperRoutes.OrderFulfillment, Icons.Material.Filled.Storefront, Color.Info),
        new("HS 검토", "통관/HS 코드 검토 요청을 확인합니다.", ShipperRoutes.CustomsHsReviews, Icons.Material.Filled.FactCheck, Color.Secondary)
