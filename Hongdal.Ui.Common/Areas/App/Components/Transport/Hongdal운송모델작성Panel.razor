@using Hongdal.Ui.Common.Areas.App.Models
@using Hongdal.Contracts.Common.Community
@using Hongdal.Ui.Common.Areas.App.Services
@inject PlatformCommunityService CommunityService
@inject IJSRuntime JS

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">@제목</MudText>
        @if (!string.IsNullOrWhiteSpace(설명))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@설명</MudText>
        }
    </MudStack>

    @if (입력방식전환사용)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@InputModeDescription</MudText>
            <MudButtonGroup Color="Color.Primary" Size="Size.Small">
                <MudButton Variant="@InputModeButtonVariant(true)" OnClick="@(() => SetInputMode(true))">한 화면 입력</MudButton>
                <MudButton Variant="@InputModeButtonVariant(false)" OnClick="@(() => SetInputMode(false))">단계 입력</MudButton>
            </MudButtonGroup>
        </MudStack>
    }

    @if (!IsSinglePageMode)
    {
        <MudProgressLinear Value="@(StepProgress * 100)" Color="Color.Primary" />
    }

    <MudCard Elevation="2">
        <MudCardContent>
            <MudText Typo="Typo.h6">입력 요약</MudText>
            <MudText>@CargoSummary</MudText>
            <MudText>@TransportSummary</MudText>
            <MudText>@PricingSummary</MudText>
            <MudText>@PaymentSummary</MudText>
        </MudCardContent>
    </MudCard>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <MudAlert Severity="@StatusSeverity">@StatusMessage</MudAlert>
    }

    <MudCard Elevation="2">
        <MudCardContent>
            @if (IsSinglePageMode || CurrentStep == 1)
            {
                <MudText Typo="Typo.h6">@(IsSinglePageMode ? "화물 정보" : "1단계 - 화물 정보")</MudText>
                <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--cargo" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">화물 기본 정보</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">차량 종류와 상하차 난이도를 판단할 물품 조건입니다.</MudText>
                        </MudStack>
                        <MudGrid>
                            <MudItem xs="12" md="6"><MudTextField Label="화물종류" @bind-Value="CargoType" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Label="화물 적재 형태" @bind-Value="CargoLoadingForm" Variant="Variant.Outlined">
                                    @foreach (var loadingForm in CargoLoadingForms)
                                    {
                                        <MudSelectItem Value="@loadingForm">@loadingForm</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="설명" @bind-Value="CargoDescription" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="int?" Label="수량" @bind-Value="CargoQuantity" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="decimal?" Label="중량Kg" @bind-Value="CargoWeightKg" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="decimal?" Label="부피Cbm" @bind-Value="CargoVolumeCbm" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12"><MudTextField Label="온도조건" @bind-Value="CargoTemperatureCondition" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
            }
            @if (IsSinglePageMode || CurrentStep == 2)
            {
                <MudText Typo="Typo.h6" Class="@(IsSinglePageMode ? "mt-5" : null)">@(IsSinglePageMode ? "운송 정보" : "2단계 - 운송 정보")</MudText>
                <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--route" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">운송 조건</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">혼적 여부, 서비스 수준, 현장 요청사항을 먼저 구분합니다.</MudText>
                        </MudStack>
                        <Hongdal운송정보입력정책Panel 화물적재형태="@CargoLoadingForm" />
                        <MudGrid>
                            <MudItem xs="12" md="4"><MudTextField Label="운송방식" @bind-Value="TransportMode" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="서비스레벨" @bind-Value="ServiceLevel" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12"><MudTextField Label="요청사항" @bind-Value="RequestNotes" Variant="Variant.Outlined" Lines="3" HelperText="@RequestNotesHelperText" /></MudItem>
                        </MudGrid>
                        @if (TransportInfoWarnings.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                                @foreach (var warning in TransportInfoWarnings)
                                {
                                    <div>@warning</div>
                                }
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--pickup" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">상차 정보</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">기사님이 물건을 받을 장소와 담당자 정보입니다.</MudText>
                        </MudStack>
                        <MudGrid>
                            <MudItem xs="12" md="8"><MudTextField Label="픽업 도로명주소" @bind-Value="PickupRoadAddress" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="8"><MudTextField Label="픽업 상세주소" @bind-Value="PickupDetailAddress" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="픽업 연락처 이름" @bind-Value="PickupContactName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="픽업 연락처 전화번호" @bind-Value="PickupContactPhone" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--dropoff" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">하차 정보</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">기사님이 물건을 내려야 할 장소와 담당자 정보입니다.</MudText>
                        </MudStack>
                        <MudGrid>
                            <MudItem xs="12" md="8"><MudTextField Label="하차 도로명주소" @bind-Value="DropoffRoadAddress" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="8"><MudTextField Label="하차 상세주소" @bind-Value="DropoffDetailAddress" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="하차 연락처 이름" @bind-Value="DropoffContactName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="하차 연락처 전화번호" @bind-Value="DropoffContactPhone" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
            }
            @if (IsSinglePageMode || CurrentStep == 3)
            {
                <MudText Typo="Typo.h6" Class="@(IsSinglePageMode ? "mt-5" : null)">@(IsSinglePageMode ? "결제/요금 정보" : "3단계 - 결제/요금 정보")</MudText>
                <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--payment" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">결제 입력</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">결제수단, 차량, 예상 거리와 비용을 한 영역에서 확인합니다.</MudText>
                        </MudStack>
                        <MudGrid>
                            <MudItem xs="12">
                                <Hongdal결제수단선택Buttons @bind-Value="PaymentMethod"
                                                      결제수단목록="PaymentMethods"
                                                      Disabled="@IsActionBusy" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">차량 선택</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        화물 크기와 온도 조건을 떠올리기 쉽도록 차량 형태를 보고 선택합니다.
                                    </MudText>
                                    <div class="vehicle-option-grid">
                                        @foreach (var option in VehicleVisualOptions)
                                        {
                                            <MudPaper Elevation="0"
                                                      Outlined="true"
                                                      tabindex="0"
                                                      role="button"
                                                      Class="@GetVehicleOptionCardClass(option.Name)"
                                                      @onclick="@(() => SelectVehicleType(option.Name))">
                                                <img class="vehicle-option-image" src="@option.ImagePath" alt="@($"{option.Name} 차량 이미지")" />
                                                <MudStack Spacing="1" Class="pa-2">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                                        <MudText Typo="Typo.subtitle2">@option.Name</MudText>
                                                        @if (IsSelectedVehicle(option.Name))
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">선택됨</MudChip>
                                                        }
                                                    </MudStack>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@option.Description</MudText>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    </div>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="decimal?" Label="예상거리Km" @bind-Value="EstimatedDistanceKm" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="int?" Label="결제예정금액" @bind-Value="PaymentAmount" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="decimal?" Label="대기료" @bind-Value="WaitingFee" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="decimal?" Label="수작업비" @bind-Value="HandlingFee" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="decimal?" Label="할증" @bind-Value="Surcharge" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--fare" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">운임 확인</MudText>
                                <MudText Typo="Typo.subtitle1">@FareCheckTitle</MudText>
                            </MudStack>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Calculate" OnClick="RecalculateRateWarningAsync">기준운임 확인</MudButton>
                        </MudStack>
                        <MudGrid>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">차량</MudText>
                                <MudText Typo="Typo.body2">@(SelectedVehicleType ?? "-")</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">거리</MudText>
                                <MudText Typo="Typo.body2">@EstimatedDistanceDisplay km</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">결제예정</MudText>
                                <MudText Typo="Typo.body2">@PaymentAmountDisplay 원</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">부가비용</MudText>
                                <MudText Typo="Typo.body2">@AdditionalChargeDisplay 원</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">기사 지급 예정</MudText>
                                <MudText Typo="Typo.body2">@DriverFareDisplay 원</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">알선 단계</MudText>
                                <MudText Typo="Typo.body2">@BrokerageStage 단계</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--policy" Outlined="true">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1">요금/재알선 방지 정책</MudText>
                        <MudGrid>
                            <MudItem xs="12" md="4"><MudNumericField T="int?" Label="기사 지급 예정 운임" @bind-Value="DriverFareAmount" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="int" Label="알선 단계" @bind-Value="BrokerageStage" Min="1" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="알선소 ID" @bind-Value="BrokerOfficeId" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12">
                                <MudCheckBox T="bool" @bind-Value="ProhibitRebrokering" Label="재알선 금지 의뢰로 등록합니다." Color="Color.Warning" />
                            </MudItem>
                        </MudGrid>
                        @if (PolicyWarnings.Count == 0)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true">1.0 기준 요금/재알선 정책 경고가 없습니다.</MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @foreach (var warning in PolicyWarnings)
                                {
                                    <div>@warning</div>
                                }
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>

                @if (커뮤니티상담사용)
                {
                    <MudPaper Elevation="0" Class="pa-3 mt-3 transport-input-section transport-input-section--community" Outlined="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1">커뮤니티 게시글 작성 도우미</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        운임이나 차량 선택이 애매할 때 현재 조건을 개인정보 없이 정리해 게시글 초안을 만듭니다.
                                    </MudText>
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(커뮤니티보기Href))
                                {
                                    <MudButton Href="@커뮤니티보기Href"
                                               Variant="Variant.Text"
                                               Color="Color.Info"
                                               StartIcon="@Icons.Material.Filled.Forum">
                                        게시판 열기
                                    </MudButton>
                                }
                            </MudStack>

                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                초안에는 상세주소, 담당자 이름, 전화번호를 넣지 않고 지역과 운송 조건만 남깁니다. 복사한 뒤 게시판에서 직접 고쳐 쓸 수 있습니다.
                            </MudAlert>

                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="바로 등록용 닉네임" @bind-Value="CommunityNickname" Variant="Variant.Outlined" HelperText="초안 복사만 할 때는 입력하지 않아도 됩니다." />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="바로 등록용 글 비밀번호" @bind-Value="CommunityPassword" InputType="InputType.Password" Variant="Variant.Outlined" HelperText="현재 초안으로 바로 등록할 때만 사용합니다." />
                                </MudItem>
                            </MudGrid>

                            <MudPaper Elevation="0" Class="pa-3" Outlined="true">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">게시글 초안</MudText>
                                    <MudTextField T="string" Label="제목 초안" Value="@BuildCommunityConsultationTitle()" ReadOnly="true" Variant="Variant.Outlined" />
                                    <MudTextField T="string" Label="본문 초안" Value="@BuildCommunityConsultationBody()" ReadOnly="true" Lines="8" Variant="Variant.Outlined" />
                                </MudStack>
                            </MudPaper>

                            @if (!string.IsNullOrWhiteSpace(CommunityStatusMessage))
                            {
                                <MudAlert Severity="@CommunityStatusSeverity" Dense="true">@CommunityStatusMessage</MudAlert>
                            }

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.ContentCopy"
                                           Disabled="@IsActionBusy"
                                           OnClick="CopyCommunityDraftAsync">
                                    초안 복사
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.PostAdd"
                                           Disabled="@IsCommunityPosting"
                                           OnClick="SaveCommunityConsultationAsync">
                                    @(IsCommunityPosting ? "게시글 등록 중..." : "현재 초안으로 바로 등록")
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.Calculate"
                                           OnClick="RecalculateRateWarningAsync">
                                    기준운임 다시 확인
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            }
            @if (IsSinglePageMode || CurrentStep == 4)
            {
                <MudText Typo="Typo.h6" Class="@(IsSinglePageMode ? "mt-5" : null)">@(IsSinglePageMode ? "최종 확인/전송" : "4단계 - 최종 확인/전송")</MudText>
                <MudList T="string" Dense="true" Class="mb-3">
                    <MudListItem>@CargoSummary</MudListItem>
                    <MudListItem>@TransportSummary</MudListItem>
                    <MudListItem>@PricingSummary</MudListItem>
                    <MudListItem>@PaymentSummary</MudListItem>
                </MudList>
                <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="@IsActionBusy" OnClick="SubmitAsync">@전송버튼텍스트</MudButton>
            }
        </MudCardContent>
    </MudCard>

    @if (!IsSinglePageMode)
    {
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Disabled="@(CurrentStep == 1 || IsActionBusy)" OnClick="PreviousStep">이전</MudButton>
            <MudButton Variant="Variant.Filled" Disabled="@(CurrentStep == TotalSteps || IsActionBusy)" OnClick="NextStep">다음</MudButton>
        </MudStack>
    }
</MudStack>

<style>
    .transport-input-section {
        border-radius: 8px;
        background: var(--mud-palette-surface);
    }

    .transport-input-section--cargo {
        border-color: rgba(37, 99, 235, 0.35) !important;
    }

    .transport-input-section--route,
    .transport-input-section--pickup,
    .transport-input-section--dropoff {
        border-color: rgba(20, 184, 166, 0.35) !important;
    }

    .transport-input-section--payment,
    .transport-input-section--fare {
        border-color: rgba(245, 158, 11, 0.42) !important;
    }

    .transport-input-section--policy {
        border-color: var(--mud-palette-warning) !important;
    }

    .transport-input-section--community {
        border-color: var(--mud-palette-info) !important;
    }

    .vehicle-option-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
    }

    .vehicle-option-card {
        min-height: 210px;
        overflow: hidden;
        cursor: pointer;
        border-radius: 8px;
        transition: border-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
    }

    .vehicle-option-card:hover,
    .vehicle-option-card:focus-visible {
        border-color: var(--mud-palette-primary) !important;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);
        outline: none;
        transform: translateY(-1px);
    }

    .vehicle-option-card--selected {
        border-color: var(--mud-palette-primary) !important;
        box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.18);
    }

    .vehicle-option-image {
        display: block;
        width: 100%;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        background: #f8fafc;
        border-bottom: 1px solid rgba(148, 163, 184, 0.28);
    }
</style>

@code {
    private const int TotalSteps = 4;
