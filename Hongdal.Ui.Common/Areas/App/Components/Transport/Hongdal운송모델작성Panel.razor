    private decimal? EstimatedDistanceKm { get; set; }
    private string PaymentMethod { get; set; } = "카드";
    private int? PaymentAmount { get; set; }
    private string RateWarningMessage { get; set; } = string.Empty;
    private int? DriverFareAmount { get; set; }
