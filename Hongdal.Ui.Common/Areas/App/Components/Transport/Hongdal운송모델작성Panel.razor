    [Parameter] public Func<string, decimal, Task<decimal?>>? 기준운임조회Async { get; set; }
    [Parameter] public EventCallback<운송모델작성Draft> OnSubmit { get; set; }
    [Parameter] public bool 커뮤니티상담사용 { get; set; } = true;
