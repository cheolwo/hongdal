    private IReadOnlyList<string> VehicleTypeOptions => BuildVehicleTypeOptions();
    private IReadOnlyList<VehicleVisualOption> VehicleVisualOptions => VehicleTypeOptions.Select(CreateVehicleVisualOption).ToArray();
    private IReadOnlyList<string> CargoLoadingForms => 화물적재형태목록.Count == 0 ? ["일반 화물(박스/팔레트)"] : 화물적재형태목록;
    private IReadOnlyList<string> PaymentMethods => 결제수단목록.Count == 0 ? ["인수증", "현금영수증", "카드"] : 결제수단목록;
    private bool IsActionBusy => IsBusy || IsSubmitting;
    private bool IsSinglePageMode => SinglePageModeOverride ?? 한화면입력;
    private double StepProgress => CurrentStep / (double)TotalSteps;
    private string InputModeDescription => IsSinglePageMode
        ? "웹에서는 한 화면에서 화물, 운송, 결제 정보를 빠르게 입력합니다."
        : "작은 화면에서는 단계별로 나누어 같은 운송 모델을 작성합니다.";
    private bool HasRateWarning => !string.IsNullOrWhiteSpace(RateWarningMessage) && RateWarningMessage.StartsWith("경고:", StringComparison.Ordinal);
    private string CargoSummary => string.IsNullOrWhiteSpace(CargoType) ? "화물종류 미입력" : $"{CargoType} / {CargoLoadingForm} / 수량 {CargoQuantity?.ToString() ?? "-"} / {CargoWeightKg?.ToString() ?? "-"}kg";
    private string TransportSummary => string.IsNullOrWhiteSpace(PickupRoadAddress) ? "운송정보 미입력" : $"{PickupRoadAddress} → {DropoffRoadAddress}";
    private string PricingSummary => $"예상거리 {EstimatedDistanceDisplay}km / 부가비용 {AdditionalChargeDisplay}원";
    private string PaymentSummary => string.IsNullOrWhiteSpace(SelectedVehicleType) ? "결제정보 미입력" : $"{SelectedVehicleType} · {PaymentMethod} · 예정금액 {PaymentAmount?.ToString("N0") ?? "-"}원";
    private string FareCheckTitle => string.IsNullOrWhiteSpace(RateWarningMessage) ? "거리와 결제예정금액을 입력한 뒤 기준운임을 확인하세요." : RateWarningMessage;
    private string EstimatedDistanceDisplay => EstimatedDistanceKm?.ToString("0.0") ?? "-";
    private string PaymentAmountDisplay => PaymentAmount?.ToString("N0") ?? "-";
    private string DriverFareDisplay => DriverFareAmount?.ToString("N0") ?? "-";
    private string AdditionalChargeDisplay => ((WaitingFee ?? 0) + (HandlingFee ?? 0) + (Surcharge ?? 0)).ToString("N0");
    private string RequestNotesHelperText => 운송정보입력정책.Get요청사항힌트(CargoLoadingForm);
    private IReadOnlyList<string> TransportInfoWarnings =>
        운송정보입력정책.Get경고목록(CargoLoadingForm, PickupRoadAddress, DropoffRoadAddress, RequestNotes);
    private IReadOnlyList<string> PolicyWarnings => BuildPolicyWarnings()
        .Concat(TransportInfoWarnings.Select(x => $"운송정보확인: {x}"))
        .Distinct(StringComparer.Ordinal)
        .ToArray();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(TransportMode))
        {
            TransportMode = 기본운송방식;
        }

        if (string.IsNullOrWhiteSpace(PaymentMethod))
        {
            PaymentMethod = 기본결제수단;
        }

        SelectedVehicleType ??= VehicleTypeOptions.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(CargoLoadingForm))
        {
            CargoLoadingForm = CargoLoadingForms.FirstOrDefault() ?? "일반 화물(박스/팔레트)";
        }

        if (string.IsNullOrWhiteSpace(CommunityNickname))
        {
            CommunityNickname = 커뮤니티기본닉네임;
        }
    }

    private sealed record VehicleVisualOption(string Name, string ImagePath, string Description);

    private IReadOnlyList<string> BuildVehicleTypeOptions()
    {
        IReadOnlyList<string> baseOptions = 차량종류목록.Count == 0
            ? ["오토바이 퀵", "1톤", "1.4톤", "2.5톤", "5톤"]
            : 차량종류목록;

        if (baseOptions.Any(IsMotorcycleQuickVehicleName))
        {
            return baseOptions;
        }

        return new[] { "오토바이 퀵" }
            .Concat(baseOptions)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static VehicleVisualOption CreateVehicleVisualOption(string vehicleType)
    {
        var name = string.IsNullOrWhiteSpace(vehicleType) ? "1톤" : vehicleType.Trim();
        var normalized = name.Replace(" ", string.Empty, StringComparison.Ordinal);

        if (IsMotorcycleQuickVehicleName(name))
        {
            return new VehicleVisualOption(name, $"{VehicleImageBasePath}/vehicle-motorcycle-quick.svg", "소형 서류, 샘플, 긴급 퀵 배송");
        }

        if (normalized.Contains("냉장", StringComparison.Ordinal) || normalized.Contains("냉동", StringComparison.Ordinal))
        {
            return new VehicleVisualOption(name, $"{VehicleImageBasePath}/vehicle-refrigerated.svg", "온도 관리가 필요한 신선식품, 냉장/냉동 화물");
        }

        if (normalized.Contains("5톤", StringComparison.Ordinal) || normalized.Contains("대형", StringComparison.Ordinal))
        {
            return new VehicleVisualOption(name, $"{VehicleImageBasePath}/vehicle-5ton-truck.svg", "팔레트, 대량 박스, 중량 화물");
        }

        if (normalized.Contains("2.5톤", StringComparison.Ordinal) || normalized.Contains("2톤", StringComparison.Ordinal))
        {
            return new VehicleVisualOption(name, $"{VehicleImageBasePath}/vehicle-25ton-box.svg", "중형 화물, 다량 박스, 소형 설비");
        }

        if (normalized.Contains("1.4톤", StringComparison.Ordinal) || normalized.Contains("윙", StringComparison.Ordinal))
        {
            return new VehicleVisualOption(name, $"{VehicleImageBasePath}/vehicle-14ton-wing.svg", "박스형 화물, 우천 보호, 측면 상하차");
        }

        return new VehicleVisualOption(name, $"{VehicleImageBasePath}/vehicle-1ton-cargo.svg", "소형 화물, 일반 용달, 근거리 운송");
    }

    private static bool IsMotorcycleQuickVehicleName(string? vehicleType)
    {
        if (string.IsNullOrWhiteSpace(vehicleType))
        {
            return false;
        }

        var normalized = vehicleType.Replace(" ", string.Empty, StringComparison.Ordinal);
        return normalized.Contains("오토바이", StringComparison.Ordinal) ||
               normalized.Contains("퀵", StringComparison.Ordinal) ||
               normalized.Contains("이륜", StringComparison.Ordinal) ||
               normalized.Contains("바이크", StringComparison.Ordinal);
    }

    private void SelectVehicleType(string vehicleType)
    {
        SelectedVehicleType = vehicleType;
    }

    private bool IsSelectedVehicle(string vehicleType)
        => string.Equals(SelectedVehicleType, vehicleType, StringComparison.Ordinal);

    private string GetVehicleOptionCardClass(string vehicleType)
        => IsSelectedVehicle(vehicleType) ? "vehicle-option-card vehicle-option-card--selected" : "vehicle-option-card";

    private Variant InputModeButtonVariant(bool singlePageMode)
        => IsSinglePageMode == singlePageMode ? Variant.Filled : Variant.Outlined;

    private void SetInputMode(bool singlePageMode)
    {
        SinglePageModeOverride = singlePageMode;
        SetMessage(singlePageMode
            ? "한 화면에서 운송 의뢰 정보를 입력합니다."
            : CurrentStep switch
            {
                1 => "1단계에서 화물 정보를 입력하세요.",
                2 => "2단계에서 운송 정보를 입력하세요.",
                3 => "3단계에서 결제 정보를 입력하세요.",
                _ => "4단계에서 최종 내용을 확인하세요."
            }, Severity.Info);
    }

    private async Task NextStep()
    {
        if (CurrentStep == 1 && string.IsNullOrWhiteSpace(CargoType))
        {
            SetMessage("화물정보를 먼저 입력하세요.", Severity.Warning);
            return;
        }

        if (CurrentStep == 2 && (string.IsNullOrWhiteSpace(PickupRoadAddress) || string.IsNullOrWhiteSpace(DropoffRoadAddress)))
        {
            SetMessage("운송정보를 먼저 입력하세요.", Severity.Warning);
            return;
        }

        if (CurrentStep < TotalSteps)
        {
            CurrentStep++;
            if (CurrentStep == 4)
            {
                await RecalculateRateWarningAsync();
            }

            SetMessage(CurrentStep switch
            {
                2 => "2단계에서 운송 정보를 입력하세요.",
                3 => "3단계에서 결제 정보를 입력하세요.",
                _ => "4단계에서 최종 내용을 확인하세요."
            }, Severity.Info);
        }
    }

    private void PreviousStep()
    {
        if (CurrentStep <= 1)
        {
            return;
        }

        CurrentStep--;
        SetMessage(CurrentStep switch
        {
            1 => "1단계에서 화물 정보를 입력하세요.",
            2 => "2단계에서 운송 정보를 입력하세요.",
            3 => "3단계에서 결제 정보를 입력하세요.",
            _ => "4단계에서 최종 내용을 확인하세요."
        }, Severity.Info);
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(CargoType) || string.IsNullOrWhiteSpace(PickupRoadAddress) || string.IsNullOrWhiteSpace(DropoffRoadAddress))
        {
            SetMessage("필수 정보를 모두 입력해야 합니다.", Severity.Warning);
            return;
        }

        await RecalculateRateWarningAsync();

        IsSubmitting = true;
        SetMessage("운송 모델을 처리하는 중입니다.", Severity.Info);

        try
        {
            var draft = CreateDraft();
            if (OnSubmit.HasDelegate)
            {
                await OnSubmit.InvokeAsync(draft);
            }

            ClearForm();
            CurrentStep = 1;
            SetMessage("운송 모델 처리가 완료되었습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            SetMessage($"운송 모델 처리 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task RecalculateRateWarningAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedVehicleType) || !EstimatedDistanceKm.HasValue || 기준운임조회Async is null)
        {
            FareReferenceAmount = null;
            RateWarningMessage = string.Empty;
            return;
        }

        try
        {
            FareReferenceAmount = await 기준운임조회Async(SelectedVehicleType, EstimatedDistanceKm.Value);
        }
        catch (Exception ex)
        {
            FareReferenceAmount = null;
            RateWarningMessage = ex.Message;
            return;
        }

        if (FareReferenceAmount.HasValue && PaymentAmount.HasValue && PaymentAmount.Value < FareReferenceAmount.Value)
        {
            RateWarningMessage = $"경고: 입력한 결제예정금액이 예상 운임 {FareReferenceAmount:N0}원보다 낮습니다.";
            return;
        }

        RateWarningMessage = FareReferenceAmount.HasValue ? $"예상 운임 기준값: {FareReferenceAmount:N0}원" : string.Empty;
    }

    private 운송모델작성Draft CreateDraft()
    {
        return new 운송모델작성Draft
        {
            작성출처 = 작성출처,
            화물종류 = CargoType,
            화물설명 = CargoDescription,
            화물적재형태 = CargoLoadingForm,
            화물수량 = CargoQuantity,
            화물중량Kg = CargoWeightKg,
            화물부피Cbm = CargoVolumeCbm,
            온도조건 = CargoTemperatureCondition,
            운송방식 = TransportMode,
            픽업도로명주소 = PickupRoadAddress,
            픽업상세주소 = PickupDetailAddress,
            픽업연락처이름 = PickupContactName,
            픽업연락처전화번호 = PickupContactPhone,
            하차도로명주소 = DropoffRoadAddress,
            하차상세주소 = DropoffDetailAddress,
            하차연락처이름 = DropoffContactName,
            하차연락처전화번호 = DropoffContactPhone,
            서비스레벨 = ServiceLevel,
            요청사항 = RequestNotes,
            차량종류 = SelectedVehicleType,
            예상거리Km = EstimatedDistanceKm,
            결제수단 = PaymentMethod,
            결제예정금액 = PaymentAmount,
            기준운임 = FareReferenceAmount,
            기사지급예정운임 = DriverFareAmount,
            대기료 = WaitingFee,
            수작업비 = HandlingFee,
            할증 = Surcharge,
            알선단계 = BrokerageStage,
            재알선금지 = ProhibitRebrokering,
            알선소Id = BrokerOfficeId,
            정책경고목록 = PolicyWarnings,
            작성일시 = DateTime.Now
        };
    }

    private async Task CopyCommunityDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(CargoType))
        {
            SetCommunityMessage("화물종류를 먼저 입력해야 게시글 초안을 만들 수 있습니다.", Severity.Warning);
            return;
        }

        var text = $"{BuildCommunityConsultationTitle()}{Environment.NewLine}{Environment.NewLine}{BuildCommunityConsultationBody()}";

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            SetCommunityMessage("게시글 초안을 복사했습니다. 게시판에서 직접 붙여넣고 수정할 수 있습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            SetCommunityMessage($"초안 복사 실패: 화면의 제목/본문 초안을 직접 선택해 복사하세요. ({ex.Message})", Severity.Warning);
        }
    }

    private async Task SaveCommunityConsultationAsync()
    {
        if (string.IsNullOrWhiteSpace(CommunityNickname) || string.IsNullOrWhiteSpace(CommunityPassword))
        {
            SetCommunityMessage("현재 초안으로 바로 등록하려면 닉네임과 글 비밀번호를 입력하세요.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(CargoType))
        {
            SetCommunityMessage("화물종류를 먼저 입력해야 게시글 초안을 만들 수 있습니다.", Severity.Warning);
            return;
        }

        IsCommunityPosting = true;
        SetCommunityMessage("현재 초안으로 커뮤니티 게시글을 등록하는 중입니다.", Severity.Info);

        try
        {
            await CommunityService.CreatePostAsync(new PlatformCommunityPostCreateRequest
            {
                AppKey = 커뮤니티AppKey,
                Category = "업무 질문",
                WorkflowTag = "국내 화물 운송",
                RoleTag = 커뮤니티RoleTag,
                Title = BuildCommunityConsultationTitle(),
                Body = BuildCommunityConsultationBody(),
                Nickname = CommunityNickname.Trim(),
                Password = CommunityPassword,
                IsReportBoardPost = false
            });

            CommunityPassword = string.Empty;
            SetCommunityMessage("현재 초안으로 커뮤니티 게시글을 등록했습니다. 게시판에서 댓글과 유사 사례를 확인하세요.", Severity.Success);
        }
        catch (Exception ex)
        {
            SetCommunityMessage($"커뮤니티 게시글 등록 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsCommunityPosting = false;
        }
    }

    private string BuildCommunityConsultationTitle()
    {
        var cargo = string.IsNullOrWhiteSpace(CargoType) ? "화물" : CargoType.Trim();
        var vehicle = string.IsNullOrWhiteSpace(SelectedVehicleType) ? "차량 미정" : SelectedVehicleType.Trim();
        return $"[운송 단가 상담] {cargo} / {vehicle}";
    }

    private string BuildCommunityConsultationBody()
    {
        var lines = new List<string>
        {
            "운송 의뢰를 작성하다가 단가와 차량 선택이 애매해서 상담을 요청합니다.",
            string.Empty,
            "현재 입력한 조건:",
            $"- 화물: {CargoSummary}",
            $"- 운송방식: {TransportMode}",
            $"- 차량 후보: {Fallback(SelectedVehicleType, "미정")}",
            $"- 상차/하차 지역: {MaskAddress(PickupRoadAddress)} -> {MaskAddress(DropoffRoadAddress)}",
            $"- 예상거리: {EstimatedDistanceDisplay}km",
            $"- 결제예정금액: {PaymentAmountDisplay}원",
            $"- 기준운임: {(FareReferenceAmount?.ToString("N0") ?? "미확인")}원",
            $"- 기사 지급 예정 운임: {DriverFareDisplay}원",
            $"- 부가비용: {AdditionalChargeDisplay}원",
            string.Empty,
            "궁금한 점:",
            "- 이 조건에서 어느 차량을 선택하는 것이 적절한지 궁금합니다.",
            "- 결제예정금액과 기사 지급 예정 운임을 어느 정도로 잡는 것이 무리 없는지 궁금합니다.",
            "- 상하차 조건이나 대기/수작업비를 더 반영해야 할 부분이 있는지 궁금합니다."
        };

        if (PolicyWarnings.Count > 0)
        {
            lines.Add(string.Empty);
            lines.Add("현재 화면에서 표시된 정책 경고:");
            lines.AddRange(PolicyWarnings.Select(x => $"- {x}"));
        }

        lines.Add(string.Empty);
        lines.Add("개인정보 보호를 위해 상세주소, 담당자 이름, 전화번호는 제외했습니다.");
        return string.Join(Environment.NewLine, lines);
    }

    private static string MaskAddress(string? roadAddress)
    {
        if (string.IsNullOrWhiteSpace(roadAddress))
        {
            return "미입력";
        }

        var parts = roadAddress
            .Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length == 0)
        {
            return "미입력";
        }

        return string.Join(' ', parts.Take(Math.Min(parts.Length, 2)));
    }

    private static string Fallback(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private void ClearForm()
    {
        CargoType = string.Empty;
        CargoDescription = null;
        CargoLoadingForm = CargoLoadingForms.FirstOrDefault() ?? "일반 화물(박스/팔레트)";
        CargoQuantity = null;
        CargoWeightKg = null;
        CargoVolumeCbm = null;
        CargoTemperatureCondition = null;
        TransportMode = 기본운송방식;
        PickupRoadAddress = string.Empty;
        PickupDetailAddress = null;
        PickupContactName = string.Empty;
        PickupContactPhone = string.Empty;
        DropoffRoadAddress = string.Empty;
        DropoffDetailAddress = null;
        DropoffContactName = string.Empty;
        DropoffContactPhone = string.Empty;
        ServiceLevel = null;
        RequestNotes = null;
        WaitingFee = null;
        HandlingFee = null;
        Surcharge = null;
        SelectedVehicleType = VehicleTypeOptions.FirstOrDefault();
        EstimatedDistanceKm = null;
        PaymentMethod = 기본결제수단;
        PaymentAmount = null;
        DriverFareAmount = null;
        BrokerageStage = 1;
        ProhibitRebrokering = true;
        BrokerOfficeId = null;
        FareReferenceAmount = null;
        RateWarningMessage = string.Empty;
    }

    private IReadOnlyList<string> BuildPolicyWarnings()
    {
        var warnings = new List<string>();

        if (FareReferenceAmount.HasValue && PaymentAmount.HasValue && PaymentAmount.Value < FareReferenceAmount.Value)
        {
            warnings.Add($"기준운임미달: 결제예정금액이 기준운임 {FareReferenceAmount:N0}원보다 낮습니다.");
        }

        if (!DriverFareAmount.HasValue)
        {
            warnings.Add("기사 지급 예정 운임을 입력해야 재알선/수수료 구조를 확인할 수 있습니다.");
        }
        else if (FareReferenceAmount.HasValue && DriverFareAmount.Value < FareReferenceAmount.Value * 0.7m)
        {
            warnings.Add("기사 지급 예정 운임이 기준운임의 70%보다 낮아 알선 단계 확인이 필요합니다.");
        }

        if (ProhibitRebrokering && BrokerageStage > 1)
        {
            warnings.Add("재알선차단필요: 재알선 금지 의뢰인데 알선 단계가 2단계 이상입니다.");
        }

        if (!string.IsNullOrWhiteSpace(BrokerOfficeId) && BrokerageStage > 1)
        {
            warnings.Add($"재알선의심: 알선소 {BrokerOfficeId}를 통한 {BrokerageStage}단계 알선입니다.");
        }

        return warnings;
    }

    private void SetMessage(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }

    private void SetCommunityMessage(string message, Severity severity)
    {
        CommunityStatusMessage = message;
        CommunityStatusSeverity = severity;
    }
