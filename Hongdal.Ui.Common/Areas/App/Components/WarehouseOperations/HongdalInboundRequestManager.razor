@using Hongdal.Contracts.Common.Inbound
@using Hongdal.Contracts.Common.Warehouse
@using Hongdal.Ui.Common.Areas.App.Services
@inject IWarehouseWorkspaceService WarehouseService

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">@Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">새로고침</MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" lg="5">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">창고 빠른 등록</MudText>
                        <MudGrid Class="mt-2">
                            <MudItem xs="12"><MudTextField Label="창고명" @bind-Value="warehouseName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12">
                                <MudSelect T="string" Label="물류 대행지 분류" @bind-Value="warehouseProxySiteType" Variant="Variant.Outlined">
                                    @foreach (var siteType in proxySiteTypes)
                                    {
                                        <MudSelectItem T="string" Value="@siteType">@LogisticsProxySiteTypes.GetDisplayName(siteType)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12"><MudTextField Label="주소" @bind-Value="warehouseAddress" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="담당자명" @bind-Value="warehouseManager" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="연락처" @bind-Value="warehousePhone" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="isBusy" OnClick="CreateWarehouseAsync">창고 등록</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">입고 요청 등록</MudText>
                        <MudGrid Class="mt-2">
                            <MudItem xs="12" md="6">
                                <MudSelect T="long?" Label="창고" @bind-Value="selectedWarehouseId" Variant="Variant.Outlined">
                                    @foreach (var warehouse in warehouses)
                                    {
                                        <MudSelectItem T="long?" Value="@warehouse.Id">@warehouse.창고명 · @LogisticsProxySiteTypes.GetDisplayName(warehouse.물류대행지분류)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Label="입고 흐름" @bind-Value="inboundFlowType" Variant="Variant.Outlined">
                                    @foreach (var flowType in inboundFlowTypes)
                                    {
                                        <MudSelectItem T="string" Value="@flowType">@입고흐름유형코드.GetDisplayName(flowType)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudAlert Severity="@InboundFlowSeverity" Dense="true">
                                    @입고흐름유형코드.GetDescription(inboundFlowType)
                                </MudAlert>
                            </MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="공급처명" @bind-Value="supplierName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="원주문 참조번호" @bind-Value="orderReference" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudDatePicker Label="예정 도착일" @bind-Date="expectedArrivalDate" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="계약번호" @bind-Value="contractNo" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Label="입고 계약 유형" @bind-Value="contractType" Variant="Variant.Outlined">
                                    @foreach (var type in inboundContractTypes)
                                    {
                                        <MudSelectItem T="string" Value="@type">@입고계약유형코드.GetDisplayName(type)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="계약 상대방" @bind-Value="contractCounterpartyName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="정산방식" @bind-Value="contractSettlementType" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="3"><MudNumericField T="decimal" Label="판매수수료율(%)" @bind-Value="contractCommissionRate" Variant="Variant.Outlined" Min="0" Max="100" /></MudItem>
                            <MudItem xs="12" md="3"><MudNumericField T="decimal" Label="일 보관료" @bind-Value="contractDailyStorageFee" Variant="Variant.Outlined" Min="0" /></MudItem>
                            <MudItem xs="12"><MudTextField Label="비고" @bind-Value="inboundMemo" Variant="Variant.Outlined" Lines="2" /></MudItem>
                        </MudGrid>
                        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Success" Disabled="isBusy || warehouses.Count == 0" OnClick="CreateInboundAsync">입고 요청 등록</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">입고 요청 목록</MudText>

                @if (isLoading)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                }
                else if (inbounds.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">등록된 입고 요청이 없습니다.</MudAlert>
                }
                else
                {
                    <MudTable Items="inbounds.OrderByDescending(x => x.Id)" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>입고ID</MudTh>
                            <MudTh>창고ID</MudTh>
                            <MudTh>흐름</MudTh>
                            <MudTh>공급처</MudTh>
                            <MudTh>참조번호</MudTh>
                            <MudTh>계약</MudTh>
                            <MudTh>상태</MudTh>
                            <MudTh>예정일</MudTh>
                            <MudTh>처리</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="입고ID">@context.Id</MudTd>
                            <MudTd DataLabel="창고ID">@context.창고Id</MudTd>
                            <MudTd DataLabel="흐름">
                                <MudChip T="string" Size="Size.Small" Color="@GetInboundFlowColor(context.입고흐름유형)" Variant="Variant.Filled">
                                    @입고흐름유형코드.GetDisplayName(context.입고흐름유형)
                                </MudChip>
                                @if (!string.IsNullOrWhiteSpace(context.입고생성경로))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.입고생성경로</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="공급처">@context.공급처명</MudTd>
                            <MudTd DataLabel="참조번호">@context.원주문참조번호</MudTd>
                            <MudTd DataLabel="계약">
                                <MudText Typo="Typo.body2">@입고계약유형코드.GetDisplayName(context.계약정보.계약유형)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.계약정보.계약번호</MudText>
                            </MudTd>
                            <MudTd DataLabel="상태">@context.상태</MudTd>
                            <MudTd DataLabel="예정일">@context.예정도착일?.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="처리">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(isBusy || context.상태 == "입고완료")" OnClick="() => SelectInbound(context)">입고완료 준비</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>

        @if (selectedInbound is not null)
        {
            <MudCard>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">입고완료 처리 - @selectedInbound.원주문참조번호</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">현재 컴포넌트는 단일 상품 기준으로 입고완료를 처리합니다.</MudText>

                        <MudGrid>
                            <MudItem xs="12" md="4"><MudTextField Label="상품명" @bind-Value="itemName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="SKU" @bind-Value="itemSku" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="옵션명" @bind-Value="itemOption" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="int" Label="입고수량" @bind-Value="itemQuantity" Variant="Variant.Outlined" Min="1" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="int" Label="불량수량" @bind-Value="itemDefectQuantity" Variant="Variant.Outlined" Min="0" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="보관위치" @bind-Value="storageLocation" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>

                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="isBusy" OnClick="CompleteInboundAsync">입고완료 처리</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="isBusy" OnClick="ClearSelection">취소</MudButton>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public string Title { get; set; } = "입고 현황";
    [Parameter] public string Description { get; set; } = "창고를 만들고 입고 요청을 등록한 뒤, 도착 상품을 입고완료 처리해 재고로 전환합니다.";

    private List<창고요약응답> warehouses = [];
    private List<입고요청항목응답> inbounds = [];
    private 입고요청항목응답? selectedInbound;

    private bool isLoading;
    private bool isBusy;
    private string? message;
    private Severity messageSeverity = Severity.Info;
    private static readonly IReadOnlyList<string> proxySiteTypes =
    [
        LogisticsProxySiteTypes.DeliveryAgency,
        LogisticsProxySiteTypes.MarketFulfillment,
        LogisticsProxySiteTypes.OverseasCustomsAgency
    ];
    private static readonly IReadOnlyList<string> inboundContractTypes =
    [
        입고계약유형코드.보관대행,
        입고계약유형코드.위탁판매,
        입고계약유형코드.마켓풀필먼트,
        입고계약유형코드.수입통관풀필먼트
    ];
    private static readonly IReadOnlyList<string> inboundFlowTypes =
    [
        입고흐름유형코드.계약기반입고,
        입고흐름유형코드.현장임시입고,
        입고흐름유형코드.주문자동입고예정
    ];

    private string warehouseName = string.Empty;
    private string warehouseProxySiteType = LogisticsProxySiteTypes.DeliveryAgency;
    private string warehouseAddress = string.Empty;
    private string warehouseManager = string.Empty;
    private string warehousePhone = string.Empty;

    private long? selectedWarehouseId;
    private string inboundFlowType = 입고흐름유형코드.계약기반입고;
    private string supplierName = string.Empty;
    private string orderReference = string.Empty;
    private DateTime? expectedArrivalDate = DateTime.Today;
    private string inboundMemo = string.Empty;
    private string contractNo = string.Empty;
    private string contractType = 입고계약유형코드.보관대행;
    private string contractCounterpartyName = string.Empty;
    private string contractSettlementType = string.Empty;
    private decimal contractCommissionRate;
    private decimal contractDailyStorageFee;

    private string itemName = string.Empty;
    private string itemSku = string.Empty;
    private string itemOption = string.Empty;
    private int itemQuantity = 1;
    private int itemDefectQuantity;
    private string storageLocation = string.Empty;

    private Severity InboundFlowSeverity => 입고흐름유형코드.Normalize(inboundFlowType) switch
    {
        입고흐름유형코드.현장임시입고 => Severity.Warning,
        입고흐름유형코드.주문자동입고예정 => Severity.Info,
        _ => Severity.Success
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
            warehouses = ((await WarehouseService.GetWarehousesAsync())?.Items ?? []).ToList();
            inbounds = ((await WarehouseService.GetInboundsAsync())?.Items ?? []).ToList();
            if (!selectedWarehouseId.HasValue && warehouses.Count > 0)
            {
                selectedWarehouseId = warehouses[0].Id;
            }

            messageSeverity = Severity.Info;
            message = $"창고 {warehouses.Count}건, 입고 요청 {inbounds.Count}건을 불러왔습니다.";
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateWarehouseAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            await WarehouseService.CreateWarehouseAsync(new 창고저장요청
            {
                창고명 = warehouseName,
                물류대행지분류 = warehouseProxySiteType,
                주소 = warehouseAddress,
                담당자명 = warehouseManager,
                연락처 = warehousePhone
            });

            warehouseName = warehouseAddress = warehouseManager = warehousePhone = string.Empty;
            warehouseProxySiteType = LogisticsProxySiteTypes.DeliveryAgency;
            messageSeverity = Severity.Success;
            message = "창고를 등록했습니다.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task CreateInboundAsync()
    {
        if (isBusy || !selectedWarehouseId.HasValue)
        {
            return;
        }

        isBusy = true;
        try
        {
            await WarehouseService.CreateInboundAsync(new 입고요청저장요청
            {
                창고Id = selectedWarehouseId.Value,
                입고흐름유형 = 입고흐름유형코드.Normalize(inboundFlowType),
                입고생성경로 = BuildInboundSourceLabel(inboundFlowType),
                계약선행여부 = 입고흐름유형코드.RequiresExistingContract(inboundFlowType),
                자동생성여부 = 입고흐름유형코드.IsOrderGenerated(inboundFlowType),
                공급처명 = supplierName,
                원주문참조번호 = orderReference,
                예정도착일 = expectedArrivalDate,
                비고 = inboundMemo,
                계약정보 = new 입고계약스냅샷
                {
                    계약번호 = contractNo,
                    계약유형 = contractType,
                    계약상대방명 = string.IsNullOrWhiteSpace(contractCounterpartyName) ? supplierName : contractCounterpartyName,
                    정산방식 = contractSettlementType,
                    판매수수료율 = contractCommissionRate,
                    보관료일단가 = contractDailyStorageFee,
                    통관필요여부 = 입고계약유형코드.RequiresCustoms(contractType),
                    계약시작일 = DateTime.Today
                }.Normalize()
            });

            supplierName = orderReference = inboundMemo = string.Empty;
            inboundFlowType = 입고흐름유형코드.계약기반입고;
            contractNo = contractCounterpartyName = contractSettlementType = string.Empty;
            contractType = 입고계약유형코드.보관대행;
            contractCommissionRate = 0m;
            contractDailyStorageFee = 0m;
            expectedArrivalDate = DateTime.Today;
            messageSeverity = Severity.Success;
            message = "입고 요청을 등록했습니다.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SelectInbound(입고요청항목응답 inbound)
    {
        selectedInbound = inbound;
        itemName = inbound.공급처명;
        itemSku = inbound.원주문참조번호;
        itemOption = string.Empty;
        itemQuantity = 1;
        itemDefectQuantity = 0;
        storageLocation = string.Empty;
    }

    private void ClearSelection()
    {
        selectedInbound = null;
    }

    private static Color GetInboundFlowColor(string? flowType)
        => 입고흐름유형코드.Normalize(flowType) switch
        {
            입고흐름유형코드.현장임시입고 => Color.Warning,
            입고흐름유형코드.주문자동입고예정 => Color.Info,
            _ => Color.Success
        };

    private static string BuildInboundSourceLabel(string? flowType)
        => 입고흐름유형코드.Normalize(flowType) switch
        {
            입고흐름유형코드.현장임시입고 => "창고 관리자 수기 등록",
            입고흐름유형코드.주문자동입고예정 => "주문/구매 흐름 자동 생성",
            _ => "계약 DB 기반 등록"
        };

    private async Task CompleteInboundAsync()
    {
        if (isBusy || selectedInbound is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            await WarehouseService.CompleteInboundAsync(selectedInbound.Id, new 입고완료요청
            {
                Items =
                [
                    new 입고상품저장요청
                    {
                        상품명 = itemName,
                        SKU = itemSku,
                        옵션명 = itemOption,
                        입고수량 = itemQuantity,
                        불량수량 = itemDefectQuantity,
                        보관위치 = storageLocation
                    }
                ]
            });

            messageSeverity = Severity.Success;
            message = $"입고 요청 {selectedInbound.Id}를 재고로 전환했습니다.";
            ClearSelection();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
