@namespace Hongdal.Ui.Common.Areas.App.Components.Community

<span class="hongdal-wonbanggak-mark"
      style="@($"--wonbanggak-size: {Size}px")"
      role="img"
      aria-label="원방각, 하늘과 땅과 사람을 상징하는 원 네모 세모">
    <svg viewBox="0 0 96 96" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="wonbanggak-circle" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#6d5dfc" />
                <stop offset="1" stop-color="#4338ca" />
            </linearGradient>
            <linearGradient id="wonbanggak-square" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#38bdf8" />
                <stop offset="1" stop-color="#2563eb" />
            </linearGradient>
        </defs>
        <circle class="hongdal-wonbanggak-circle" cx="28" cy="30" r="21" fill="url(#wonbanggak-circle)" />
        <rect class="hongdal-wonbanggak-square" x="47" y="22" width="30" height="30" rx="6" fill="url(#wonbanggak-square)" />
        <path class="hongdal-wonbanggak-triangle" d="M47 42 L78 78 L16 78 Z" />
        <circle class="hongdal-wonbanggak-center" cx="47" cy="49" r="5" />
    </svg>
</span>

@code {
    [Parameter]
    public int Size { get; set; } = 56;
}

<style>
    .hongdal-wonbanggak-mark {
        display: inline-grid;
        flex: 0 0 auto;
        width: var(--wonbanggak-size);
        height: var(--wonbanggak-size);
        border: 1px solid rgba(99, 102, 241, 0.18);
        border-radius: 20px;
        place-items: center;
        background: linear-gradient(145deg, #ffffff, #eef2ff);
        box-shadow: 0 8px 18px rgba(79, 70, 229, 0.15);
    }

    .hongdal-wonbanggak-mark svg {
        display: block;
        width: 88%;
        height: 88%;
        overflow: visible;
    }

    .hongdal-wonbanggak-circle,
    .hongdal-wonbanggak-square,
    .hongdal-wonbanggak-triangle {
        transform-origin: 48px 48px;
    }

    .hongdal-wonbanggak-circle {
        opacity: 0.96;
    }

    .hongdal-wonbanggak-square {
        opacity: 0.92;
    }

    .hongdal-wonbanggak-triangle {
        fill: rgba(255, 255, 255, 0.12);
        stroke: #ff4f87;
        stroke-linejoin: round;
        stroke-width: 7;
    }

    .hongdal-wonbanggak-center {
        fill: #ffffff;
        stroke: rgba(67, 56, 202, 0.28);
        stroke-width: 2;
    }
</style>
