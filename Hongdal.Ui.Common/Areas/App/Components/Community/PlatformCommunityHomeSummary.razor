@namespace Hongdal.Ui.Common.Areas.App.Components.Community

<main class="common-home-summary" aria-label="홍달 공통 홈 요약">
    <header class="common-home-summary__intro">
        <div>
            <span>공통 홈</span>
            <h1>오늘의 홍달</h1>
        </div>
        <p>지금 오가는 이야기와 커뮤니티, 상점 소식을 한곳에서 확인합니다.</p>
    </header>

    <section class="common-home-summary__best" aria-labelledby="common-home-best-title">
        <header class="common-home-summary__section-heading">
            <div>
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                <strong id="common-home-best-title">실시간 베스트</strong>
            </div>
            <button type="button" @onclick="OpenCommunityAsync">
                전체 글
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </button>
        </header>

        @if (데이터로딩중 && 베스트글목록.Count == 0)
        {
            <div class="common-home-summary__loading" aria-live="polite">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>글을 불러오는 중입니다.</span>
            </div>
        }
        else if (베스트글목록.Count == 0)
        {
            <div class="common-home-summary__empty">아직 베스트 글이 없습니다.</div>
        }
        else
        {
            <ol>
                @for (var index = 0; index < 베스트글목록.Count; index++)
                {
                    var 글 = 베스트글목록[index];
                    <li>
                        <button type="button" @onclick="@(() => SelectBestPostAsync(글))">
                            <span class="common-home-summary__rank">@(index + 1)</span>
                            <span class="common-home-summary__best-main">
                                <small>@글.분류</small>
                                <strong>@글.제목</strong>
                            </span>
                            <span class="common-home-summary__best-author">@글.작성자</span>
                            <span class="common-home-summary__engagement">
                                <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                @글.추천수
                                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" />
                                @글.댓글수
                            </span>
                        </button>
                    </li>
                }
            </ol>
        }
    </section>

    <div class="common-home-summary__columns">
        <section class="common-home-summary__area common-home-summary__area--community" aria-labelledby="common-home-community-title">
            <header>
                <span class="common-home-summary__area-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Forum" />
                </span>
                <div>
                    <small>COMMUNITY</small>
                    <h2 id="common-home-community-title">살뜰 커뮤니티</h2>
                </div>
            </header>

            <dl>
                <div>
                    <dt>전체 글</dt>
                    <dd>@전체글수</dd>
                </div>
                <div>
                    <dt>게시판</dt>
                    <dd>@게시판수</dd>
                </div>
            </dl>

            <div class="common-home-summary__tags" aria-label="주요 게시판">
                @foreach (var 게시판명 in 게시판명목록.Take(4))
                {
                    <span>@게시판명</span>
                }
            </div>

            <div class="common-home-summary__commands">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ViewList"
                           OnClick="OpenCommunityAsync">
                    게시판 보기
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="OpenComposeAsync">
                    글쓰기
                </MudButton>
            </div>
        </section>

        <section class="common-home-summary__area common-home-summary__area--store" aria-labelledby="common-home-store-title">
            <header>
                <span class="common-home-summary__area-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Storefront" />
                </span>
                <div>
                    <small>STORE</small>
                    <h2 id="common-home-store-title">꾸미기 상점</h2>
                </div>
            </header>

            <dl>
                <div>
                    <dt>상품</dt>
                    <dd>@상점상품수</dd>
                </div>
                <div>
                    <dt>내 보유</dt>
                    <dd>@보유상품수</dd>
                </div>
            </dl>

            <div class="common-home-summary__theme">
                <span>현재 홈 테마</span>
                <strong>@현재테마명</strong>
            </div>

            @if (추천상품명목록.Count > 0)
            {
                <div class="common-home-summary__store-items" aria-label="상점 추천 상품">
                    @foreach (var 상품명 in 추천상품명목록.Take(2))
                    {
                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                            @상품명
                        </span>
                    }
                </div>
            }

            <div class="common-home-summary__commands">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Storefront"
                           OnClick="OpenStoreAsync">
                    상점 보기
                </MudButton>
            </div>
        </section>
    </div>
</main>

@code {
    [Parameter]
    public IReadOnlyList<공통홈베스트글요약> 베스트글목록 { get; set; } = [];

    [Parameter]
    public int 전체글수 { get; set; }

    [Parameter]
    public int 게시판수 { get; set; }

    [Parameter]
    public IReadOnlyList<string> 게시판명목록 { get; set; } = [];

    [Parameter]
    public int 상점상품수 { get; set; }

    [Parameter]
    public int 보유상품수 { get; set; }

    [Parameter]
    public string 현재테마명 { get; set; } = "기본 홈 테마";

    [Parameter]
    public IReadOnlyList<string> 추천상품명목록 { get; set; } = [];

    [Parameter]
    public bool 데이터로딩중 { get; set; }

    [Parameter]
    public EventCallback<공통홈베스트글요약> OnBestPostSelected { get; set; }

    [Parameter]
    public EventCallback OnCommunityOpen { get; set; }

    [Parameter]
    public EventCallback OnCompose { get; set; }

    [Parameter]
    public EventCallback OnStoreOpen { get; set; }

    private Task SelectBestPostAsync(공통홈베스트글요약 글)
        => OnBestPostSelected.InvokeAsync(글);

    private Task OpenCommunityAsync() => OnCommunityOpen.InvokeAsync();

    private Task OpenComposeAsync() => OnCompose.InvokeAsync();

    private Task OpenStoreAsync() => OnStoreOpen.InvokeAsync();
}
