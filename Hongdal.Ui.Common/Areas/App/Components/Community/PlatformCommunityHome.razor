            return "해외 구매/선적";
        }

        if (ContainsAny(stateLabel, "결정", "확정", "FCL", "LCL", "가격", "수량", "ImportDecision", "Cancelled"))
        {
            return "수입 결정";
        }

        return "수요 모집";
