                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="계약 상대방"
                                                          @bind-Value="warehouseProxyContractCounterpartyName"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="정산방식"
                                                          @bind-Value="warehouseProxyContractSettlementType"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="decimal"
                                                             Label="판매수수료율(%)"
                                                             @bind-Value="warehouseProxyContractCommissionRate"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="0"
                                                             Max="100" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="decimal"
                                                             Label="일 보관료"
                                                             @bind-Value="warehouseProxyContractDailyStorageFee"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="0" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudTextField Label="신청 메모"
                                                          @bind-Value="창고대행메모"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Lines="3" />
                                        </MudItem>
                                    </MudGrid>
                                }
                                @if (!string.IsNullOrWhiteSpace(창고대행신청알림문구))
                                {
                                    <MudAlert Severity="@창고대행신청알림수준" Dense="true" Variant="Variant.Outlined">
                                        @창고대행신청알림문구
                                    </MudAlert>
                                }
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.Send"
                                               Disabled="@(!창고대행입고신청가능한가)"
                                               OnClick="창고대행입고신청생성Async">
                                        @(창고대행신청제출중 ? "신청 중" : "다이어그램에서 신청")
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.OpenInNew"
                                               Disabled="@(현재선택창고대행후보 is null)"
                                               OnClick="창고대행신청으로이동">
                                        업무 화면에서 자세히 작성
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </aside>
                    }
