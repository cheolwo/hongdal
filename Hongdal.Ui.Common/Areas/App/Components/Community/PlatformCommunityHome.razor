    private static string? ResolveLocalSaleActiveNodeTitle(string stateLabel)
    {
        if (ContainsAny(stateLabel, "정산", "결제", "입금", "확인", "완료", "마감"))
        {
            return "정산/확인";
        }

        if (ContainsAny(stateLabel, "전달", "배송", "직거래", "택배", "수령"))
