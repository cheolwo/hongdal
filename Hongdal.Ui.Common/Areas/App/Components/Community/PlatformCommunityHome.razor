    private static string? ResolveErrandActiveNodeTitle(string stateLabel)
    {
        if (ContainsAny(stateLabel, "확인", "완료", "보류", "증빙", "마감"))
        {
            return "확인/마감";
        }

        return ContainsAny(stateLabel, "진행", "수행", "작업", "참여")
