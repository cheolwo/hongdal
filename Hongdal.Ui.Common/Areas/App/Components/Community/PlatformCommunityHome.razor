    private static double GetDiagramHeight(
        IReadOnlyList<원장블록노드> nodes,
        double minHeight = DefaultDiagramCanvasMinHeight)
        => Math.Max(
            minHeight,
            170 + ((GetDiagramRowCount(nodes.Count) - 1) * DiagramRowSpacing));

