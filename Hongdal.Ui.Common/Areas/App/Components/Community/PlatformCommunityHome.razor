        => handle is DiagramConnectionHandleKind.Left or DiagramConnectionHandleKind.Top;

    private static bool TryParseDiagramHandle(string? value, out DiagramConnectionHandleKind handle)
    {
        var normalized = value?.Trim().ToLowerInvariant();
        handle = normalized switch
        {
            "top" => DiagramConnectionHandleKind.Top,
            "right" => DiagramConnectionHandleKind.Right,
            "bottom" => DiagramConnectionHandleKind.Bottom,
            "left" => DiagramConnectionHandleKind.Left,
            _ => DiagramConnectionHandleKind.Right
        };

        return normalized is "top" or "right" or "bottom" or "left";
    }

    private bool CanMove선택원장블록노드(int offset)
    {
        var selectedNode = 선택원장블록노드;
        if (selectedNode is null)
        {
            return false;
        }

        _ = 정렬된원장블록노드목록가져오기(선택원장블록흐름도);
        var currentIndex = diagramNodeOrder.FindIndex(title =>
            string.Equals(title, selectedNode.Title, StringComparison.OrdinalIgnoreCase));
        var nextIndex = currentIndex + offset;
        return currentIndex >= 0 && nextIndex >= 0 && nextIndex < diagramNodeOrder.Count;
    }

    private void Move선택원장블록노드(int offset)
    {
        var selectedNode = 선택원장블록노드;
        if (selectedNode is null)
        {
            var firstNode = 정렬된원장블록노드목록가져오기(선택원장블록흐름도).FirstOrDefault();
            선택원장블록노드제목 = firstNode?.Title;
            return;
        }

        _ = 정렬된원장블록노드목록가져오기(선택원장블록흐름도);
        var currentIndex = diagramNodeOrder.FindIndex(title =>
            string.Equals(title, selectedNode.Title, StringComparison.OrdinalIgnoreCase));
        var nextIndex = currentIndex + offset;
        if (currentIndex < 0 || nextIndex < 0 || nextIndex >= diagramNodeOrder.Count)
        {
            return;
        }

        (diagramNodeOrder[currentIndex], diagramNodeOrder[nextIndex]) =
            (diagramNodeOrder[nextIndex], diagramNodeOrder[currentIndex]);
    }

