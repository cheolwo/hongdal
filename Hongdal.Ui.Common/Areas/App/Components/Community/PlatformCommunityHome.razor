                    </div>
                </div>

                @if (!isWorkMode)
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="platform-community-hero-actions">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="OpenCompose">
                            글쓰기
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Description"
                                   OnClick="OpenMyLedgerComposeAsync">
                            원장으로 글쓰기
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   OnClick="현재원장다이어그램열기">
                            다이어그램 모드
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Storefront"
                                   OnClick="OpenDecorationStore">
                            꾸미기 상점
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Success"
                                   EndIcon="@Icons.Material.Filled.ChevronRight"
