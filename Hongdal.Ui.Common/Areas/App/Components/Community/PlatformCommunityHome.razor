    private async Task LoadPostsAsync()
    {
        isLoading = true;
        try
        {
            var result = await CommunityService.GetPostsAsync(AppKey);
            posts.Clear();
            posts.AddRange(result.Items);
        }
        catch
        {
            statusSeverity = Severity.Info;
            statusMessage = "커뮤니티 API가 연결되면 글 작성과 조회가 활성화됩니다.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadBoardsAsync()
    {
        try
        {
            var approved = await CommunityService.GetBoardsAsync(AppKey, PlatformCommunityBoardRequestStatuses.Approved);
            approvedBoards.Clear();
            approvedBoards.AddRange(approved.Items);

            if (CanManageCommunityPosts)
            {
                var pending = await CommunityService.GetBoardsAsync(AppKey, PlatformCommunityBoardRequestStatuses.Pending);
                pendingBoardRequests.Clear();
                pendingBoardRequests.AddRange(pending.Items);
                foreach (var board in pendingBoardRequests)
                {
                    boardReviewMemo.TryAdd(board.Id, string.Empty);
                }
            }
        }
        catch
        {
            // Board requests are an enhancement; post loading should still work if this API is unavailable.
        }
    }

    private async Task SaveBoardRequestAsync()
    {
        statusMessage = null;
        if (string.IsNullOrWhiteSpace(boardForm.Title) ||
            string.IsNullOrWhiteSpace(boardForm.RequestedBy) ||
            string.IsNullOrWhiteSpace(boardForm.RequestReason))
        {
            statusSeverity = Severity.Warning;
            statusMessage = "게시판 이름, 신청자, 개설 이유를 입력하세요.";
            return;
        }

        isSavingBoardRequest = true;
        try
        {
            await CommunityService.CreateBoardRequestAsync(new PlatformCommunityBoardCreateRequest
            {
                AppKey = AppKey,
                Title = boardForm.Title,
                Description = boardForm.Description,
                RequestedBy = boardForm.RequestedBy,
                RequestReason = boardForm.RequestReason
            });

            boardForm.Title = string.Empty;
            boardForm.Description = string.Empty;
            boardForm.RequestReason = string.Empty;
            await LoadBoardsAsync();

            statusSeverity = Severity.Success;
            statusMessage = "게시판 개설 신청을 접수했습니다. 운영자 승인 후 게시판 목록에 표시됩니다.";
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"게시판 개설 신청에 실패했습니다: {ex.Message}";
        }
        finally
        {
            isSavingBoardRequest = false;
        }
    }

    private async Task ReviewBoardAsync(PlatformCommunityBoardResponse board, bool approve)
    {
        try
        {
            var memo = boardReviewMemo.TryGetValue(board.Id, out var value) ? value : string.Empty;
            if (approve)
            {
                await CommunityService.ApproveBoardAsync(board.Id, memo);
                statusMessage = $"'{board.Title}' 게시판을 승인했습니다.";
            }
            else
            {
                await CommunityService.RejectBoardAsync(board.Id, memo);
                statusMessage = $"'{board.Title}' 게시판 신청을 반려했습니다.";
            }

            statusSeverity = Severity.Success;
            await LoadBoardsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"게시판 검토 처리에 실패했습니다: {ex.Message}";
        }
    }

