                                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="1">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle2">창고 물류 대행 신청</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@창고대행신청노드.Title 블록에서 시작</MudText>
                                    </MudStack>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   OnClick="창고대행신청패널닫기"
                                                   aria-label="창고 물류 대행 신청 닫기" />
                                </MudStack>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
