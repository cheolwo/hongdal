    private bool MatchesLedgerPickerScope(PlatformCommunityPostLedgerChoiceResponse ledger)
        => ledgerPickerScope switch
        {
            "내 원장" => ledger.내접근원장여부,
            "공개 원장" => !ledger.내접근원장여부,
            _ => true
        };

    private bool MatchesLedgerPickerSearch(PlatformCommunityPostLedgerChoiceResponse ledger)
    {
        var searchText = ledgerPickerSearchText.Trim();
        return searchText.Length == 0
            || ContainsCommunitySearchText(ledger.제목, searchText)
            || ContainsCommunitySearchText(ledger.원장템플릿명, searchText)
            || ContainsCommunitySearchText(ledger.상태, searchText)
            || ContainsCommunitySearchText(ledger.WorkflowTag, searchText)
            || ContainsCommunitySearchText(ledger.참여역할, searchText)
            || ContainsCommunitySearchText(ledger.원장Id, searchText);
    }

