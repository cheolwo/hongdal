        {
            창고대행신청알림수준 = Severity.Warning;
            창고대행신청알림문구 = "물류 대행을 신청할 창고 후보를 먼저 선택하세요.";
            return;
        }

        var targetUrl = 창고대행신청Url생성(node, candidate);
