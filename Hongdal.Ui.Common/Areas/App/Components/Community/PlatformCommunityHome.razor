    private static string 다이어그램대화방아이콘텍스트(string displayName)
    {
        var text = string.IsNullOrWhiteSpace(displayName) ? "익명" : displayName.Trim();
        return text.Length <= 2 ? text : text[..1];
    }

    private static string 다이어그램대화방아이콘Style(string senderUserId)
    {
        var colors = new[] { "#2563eb", "#0891b2", "#7c3aed", "#16a34a", "#be123c", "#c2410c" };
        var hash = string.IsNullOrWhiteSpace(senderUserId)
            ? 0
            : senderUserId.Aggregate(0, (current, ch) => unchecked(current * 31 + ch));
        var index = Math.Abs(hash % colors.Length);
        return $"--diagram-room-avatar-color: {colors[index]};";
    }

    private static 다이어그램레이어정의? FindDiagramLayer(string key)
        => 다이어그램레이어정의s.FirstOrDefault(layer => string.Equals(layer.Key, key, StringComparison.OrdinalIgnoreCase));

    private bool IsDiagramLayerVisible(string key)
    {
        var layer = FindDiagramLayer(key);
        return layer?.IsLocked == true || !hiddenDiagramLayerKeys.Contains(key);
    }

    private void ToggleDiagramLayer(string key)
    {
        var layer = FindDiagramLayer(key);
        if (layer is null || layer.IsLocked)
        {
            return;
        }

        if (!hiddenDiagramLayerKeys.Add(key))
        {
            hiddenDiagramLayerKeys.Remove(key);
        }
    }

    private string BuildDiagramLayerToggleClass(다이어그램레이어정의 layer)
    {
        var active = IsDiagramLayerVisible(layer.Key)
            ? " platform-ledger-layer-toggle--active"
            : " platform-ledger-layer-toggle--hidden";
        var locked = layer.IsLocked ? " platform-ledger-layer-toggle--locked" : string.Empty;
        return $"platform-ledger-layer-toggle platform-ledger-layer-toggle--{layer.Key}{active}{locked}";
    }

    private string BuildDiagramLayerToggleTitle(다이어그램레이어정의 layer)
    {
        var state = IsDiagramLayerVisible(layer.Key) ? "표시 중" : "숨김";
        var lockText = layer.IsLocked ? " · 기준 레이어라 숨길 수 없습니다." : string.Empty;
        return $"{BuildDiagramLayerOrderLabel(layer)}순위 {layer.Label} 레이어 · {state} · {layer.Description}{lockText}";
    }

    private static string BuildDiagramLayerOrderLabel(다이어그램레이어정의 layer)
        => (layer.DisplayOrder / 10).ToString(CultureInfo.InvariantCulture);

    private string BuildDiagramCanvasClass(string baseClass)
    {
        var hiddenClasses = 다이어그램레이어정의s
            .Where(layer => !IsDiagramLayerVisible(layer.Key))
            .Select(layer => $"platform-ledger-flow-diagram--hide-layer-{layer.Key}");

        return string.Join(' ', hiddenClasses.Prepend(baseClass));
    }

