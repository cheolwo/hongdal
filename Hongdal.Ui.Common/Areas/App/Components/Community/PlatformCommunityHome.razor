    private async Task LoadMyLedgersAsync()
    {
        isMyLedgersLoading = true;
        myLedgerLoadMessage = null;
        myLedgers.Clear();
        var loginRequired = false;
        var sharedLoadFailed = false;
        try
        {
            var ledgers = await CommunityService.GetMyLedgersAsync();
            myLedgers.AddRange(ledgers);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            loginRequired = true;
        }
        catch (Exception)
        {
            loginRequired = true;
        }

        try
        {
            var sharedLedgers = await CommunityService.GetSharedLedgersAsync();
            foreach (var ledger in sharedLedgers)
            {
                if (!myLedgers.Any(x => string.Equals(x.원장Id, ledger.원장Id, StringComparison.OrdinalIgnoreCase)))
                {
                    myLedgers.Add(ledger);
                }
            }
        }
        catch (Exception)
        {
            sharedLoadFailed = true;
        }

        if (myLedgers.Count == 0)
        {
            myLedgerLoadMessage = sharedLoadFailed
                ? "원장 목록을 불러오지 못했습니다. 서버 연결 상태를 확인해 주세요."
                : loginRequired
                    ? "로그인하면 내 원장을 함께 볼 수 있습니다. 현재 재공유가 허용된 공개 원장은 없습니다."
                    : "내 원장과 재공유가 허용된 공개 원장이 아직 없습니다.";
        }

        isMyLedgersLoading = false;
    }

