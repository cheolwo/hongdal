                                    {
                                        <button type="button"
                                                class="@창고대행후보클래스생성(candidate)"
                                                title="@candidate.Description"
                                                @onclick="@(() => 창고대행후보선택(candidate.Key))">
                                            <span class="platform-diagram-warehouse-candidate-name">@candidate.Name</span>
                                            <span class="platform-diagram-warehouse-candidate-meta">@candidate.ScopeLabel · @candidate.ProxyTypeLabel</span>
                                            @if (!string.IsNullOrWhiteSpace(candidate.Address))
                                            {
                                                <span class="platform-diagram-warehouse-candidate-address">@candidate.Address</span>
                                            }
                                        </button>
                                    }
                                </div>
                                @if (현재선택창고대행후보 is not null)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                        @현재선택창고대행후보.Description
                                    </MudAlert>
                                    @if (현재선택창고대행후보.WarehouseId is null)
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                                            이 후보는 아직 실제 창고 ID가 없어 API 신청 대신 업무 화면에서 창고를 먼저 등록해야 합니다.
                                        </MudAlert>
                                    }
                                    <MudDivider />
                                    <MudText Typo="Typo.subtitle2">신청 입력</MudText>
                                    <MudGrid Class="platform-diagram-warehouse-request-form">
                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="공급처명"
                                                          @bind-Value="warehouseProxySupplierName"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="원주문 참조번호"
                                                          @bind-Value="warehouseProxyOrderReference"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudDatePicker Label="예정 도착일"
                                                           @bind-Date="warehouseProxyExpectedArrivalDate"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense" />
