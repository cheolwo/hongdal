                                                           PrajnaSelected="@PrajnaUpayaPrajnaSelectedCallback"
                                                           CommunitySelected="@BaguaTaegeukYangSelectedCallback"
                                                           StoreSelected="@BaguaTaegeukYinSelectedCallback" />
