        다이어그램대화방FeedScroll필요 = 다이어그램대화방패널열림;
        if (다이어그램대화방표시메시지목록.Count > 80)
        {
            다이어그램대화방표시메시지목록.RemoveRange(0, 다이어그램대화방표시메시지목록.Count - 80);
        }
    }

    private static string 다이어그램대화방메시지클래스(다이어그램대화방표시메시지 message)
