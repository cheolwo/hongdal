    private IReadOnlyList<PlatformCommunityPostLedgerChoiceResponse> FilteredLedgerPickerChoices
        => myLedgers
            .Where(MatchesLedgerPickerScope)
            .Where(MatchesLedgerPickerSearch)
            .OrderByDescending(ledger => ledger.내접근원장여부)
            .ThenByDescending(ledger => ledger.수정시각Utc)
