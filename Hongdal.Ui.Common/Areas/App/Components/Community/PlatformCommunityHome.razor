    private async Task SaveLedgerSharingSettingsAsync()
    {
        if (ledgerSharingSettings is null) return;
        isLedgerSharingSaving = true;
        try
        {
            ledgerSharingSettings = await CommunityService.UpdateLedgerSharingSettingsAsync(
                ledgerSharingSettings.원장Id,
                new 커뮤니티원장공개설정변경Request
                {
                    공개범위 = ledgerSharingSettings.공개범위,
                    재사용허용여부 = ledgerSharingSettings.재사용허용여부,
                    재공유허용여부 = ledgerSharingSettings.재공유허용여부,
                    기대Revision = ledgerSharingSettings.Revision,
                    공개항목Key목록 = ledgerSharingSettings.항목목록
                        .Where(x => x.공개여부)
                        .Select(x => x.항목Key)
                        .ToArray()
                });
            statusSeverity = Severity.Success;
            statusMessage = ledgerSharingSettings?.공개범위 == 커뮤니티원장공개범위.비공개
                ? "원장을 비공개로 전환했습니다."
                : "선택한 항목만 공개되도록 원장 공유 설정을 저장했습니다.";
            await LoadMyLedgersAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"원장 공개 설정 저장에 실패했습니다: {ex.Message}";
        }
        finally
        {
            isLedgerSharingSaving = false;
        }
    }

