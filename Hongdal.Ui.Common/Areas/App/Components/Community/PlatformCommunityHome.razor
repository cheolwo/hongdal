    private async Task 다이어그램대화방입장Async()
    {
        if (다이어그램대화방입장중 ||
            Diagram대화방Client.연결됨 &&
            string.Equals(연결된다이어그램대화방Id, 다이어그램대화방Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        다이어그램대화방입장중 = true;
        try
        {
            var connected = await Diagram대화방Client.방입장Async(new DiagramRoomJoinRequest
            {
                RoomId = 다이어그램대화방Id,
                CommunityId = AppKey,
                LedgerId = 선택현재원장Id,
                DiagramId = 다이어그램대화방Id,
                DiagramName = SelectedLedgerTemplate.DisplayName,
                LedgerTemplateKey = selectedLedgerTemplateKey,
                WorkContext = new DiagramWorkContextDto
                {
                    WorkType = selectedLedgerTemplateKey,
                    WorkLabel = SelectedLedgerTemplate.DisplayName,
                    AppKey = AppKey,
                    PrimaryRoute = "/community",
                    PrimaryActionLabel = "다이어그램 보기",
                    Parameters = new Dictionary<string, string>
                    {
                        ["ledgerTemplateKey"] = selectedLedgerTemplateKey,
                        ["roomId"] = 다이어그램대화방Id
                    }
                }
            });

            연결된다이어그램대화방Id = connected ? 다이어그램대화방Id : null;
        }
        finally
        {
            다이어그램대화방입장중 = false;
        }
