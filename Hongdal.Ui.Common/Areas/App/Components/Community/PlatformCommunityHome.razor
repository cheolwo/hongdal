    private void UpdateSelectedDiagramEdgeLabel(string value)
    {
        if (string.IsNullOrWhiteSpace(selectedDiagramEdgeId))
        {
            return;
        }

        var nextLabel = string.IsNullOrWhiteSpace(value) ? "다음 단계" : value.Trim();
        if (selectedDiagramEdgeId.StartsWith("default:", StringComparison.OrdinalIgnoreCase))
        {
            diagramEdgeLabels[selectedDiagramEdgeId] = nextLabel;
            return;
        }

        var index = customDiagramEdges.FindIndex(edge =>
            string.Equals(edge.Id, selectedDiagramEdgeId, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
        {
            return;
        }

        customDiagramEdges[index] = customDiagramEdges[index] with
        {
            Label = nextLabel
        };
    }

    private void UpdateSelectedDiagramEdgeStyle(DiagramEdgeStyleKind style)
    {
        if (string.IsNullOrWhiteSpace(selectedDiagramEdgeId))
        {
            return;
        }

        diagramEdgeStyles[selectedDiagramEdgeId] = style;

        var index = customDiagramEdges.FindIndex(edge =>
            string.Equals(edge.Id, selectedDiagramEdgeId, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            customDiagramEdges[index] = customDiagramEdges[index] with
            {
                Style = style
            };
        }
    }

    private void DeleteSelectedDiagramEdge()
    {
        if (string.IsNullOrWhiteSpace(selectedDiagramEdgeId))
        {
            return;
        }

        customDiagramEdges.RemoveAll(edge =>
            string.Equals(edge.Id, selectedDiagramEdgeId, StringComparison.OrdinalIgnoreCase));
        diagramEdgeLabels.Remove(selectedDiagramEdgeId);
        diagramEdgeStyles.Remove(selectedDiagramEdgeId);
        selectedDiagramEdgeId = null;
        isDiagramEdgeOptionDockCollapsed = true;
    }

