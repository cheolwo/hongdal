        statusMessage = $"다이어그램을 바탕으로 '{guide.BoardCategory}' 대분류까지만 추천했습니다. 워크플로우 태그와 역할 태그는 직접 선택해 주세요. {guide.Reason}";
    }

    private 다이어그램커뮤니티초안안내 다이어그램커뮤니티초안안내생성(
        IReadOnlyList<원장블록노드> flowNodes,
        IReadOnlyList<원장블록연결선> diagramEdges)
    {
        var analysis = CommunityLedgerFlowClassifier.Analyze(new()
        {
            Title = string.Join(" ", flowNodes.Select(node => node.Title)),
            Body = string.Join(Environment.NewLine, diagramEdges.Select(edge => $"{edge.FromTitle} -> {edge.ToTitle}: {edge.Label}")),
            UiSectionHints = flowNodes
                .SelectMany(node => new[] { node.Title, node.GroupLabel, node.Description, node.Kind })
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .ToArray(),
            ActionHints = diagramEdges
                .Select(edge => edge.Label)
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .ToArray(),
            Attributes = new Dictionary<string, string>
            {
                ["source"] = "diagram",
                ["app"] = AppName,
                ["role"] = RoleLabel,
                ["nodes"] = string.Join(", ", flowNodes.Select(node => node.Title)),
                ["edges"] = string.Join(", ", diagramEdges.Select(edge => $"{edge.FromTitle}->{edge.ToTitle}"))
            }
        });

        var templateKey = string.IsNullOrWhiteSpace(analysis.PrimaryCandidate.TemplateKey)
            ? selectedLedgerTemplateKey
            : analysis.PrimaryCandidate.TemplateKey;
        var template = CommunityLedgerTemplateCatalog.Find(templateKey);
        var boardCategory = 다이어그램초안게시판분류해결(template, flowNodes, diagramEdges);
        var reason = 다이어그램초안추천이유해결(template, flowNodes, diagramEdges, analysis);
        var body = 다이어그램커뮤니티초안본문생성(template, boardCategory, reason, flowNodes, diagramEdges);
        var title = 다이어그램커뮤니티초안제목생성(template, flowNodes);
        var isReportBoardPost = 다이어그램신호있는가(flowNodes, diagramEdges, "신고", "분쟁", "report", "dispute");

        return new(template, boardCategory, title, body, reason, isReportBoardPost);
    }

    private string 다이어그램초안게시판분류해결(
        CommunityLedgerTemplateResponse template,
        IReadOnlyList<원장블록노드> flowNodes,
        IReadOnlyList<원장블록연결선> diagramEdges)
    {
        if (다이어그램신호있는가(flowNodes, diagramEdges, "신고", "분쟁", "report", "dispute"))
        {
            return 게시판분류찾기("신고", "분쟁", "report", "dispute") ?? "신고/분쟁";
        }

        if (template.Key is CommunityLedgerTemplateKeys.CargoTransport
            or CommunityLedgerTemplateKeys.FoodDelivery)
        {
            return 게시판분류찾기("운송", "배송", "배달", "용달") ?? template.Category;
        }

        if (template.Key is CommunityLedgerTemplateKeys.HongdalMart
            or CommunityLedgerTemplateKeys.WarehouseOutbound
            or CommunityLedgerTemplateKeys.WarehouseInbound)
        {
            return 게시판분류찾기("창고", "재고", "입고", "출고", "업무", "기록") ?? template.Category;
        }

        if (template.Key is CommunityLedgerTemplateKeys.LocalSale
            or CommunityLedgerTemplateKeys.GroupPurchase
            or CommunityLedgerTemplateKeys.FoodOrder
            or CommunityLedgerTemplateKeys.Errand)
        {
            return 게시판분류찾기("생활", "원장") ?? template.Category;
        }

        if (flowNodes.Any(node => node.Kind.Equals("sales-channel", StringComparison.OrdinalIgnoreCase)) ||
            다이어그램신호있는가(flowNodes, diagramEdges, "판매", "판매채널", "스마트스토어", "쿠팡", "마켓", "commerce", "sales-channel"))
        {
            return 게시판분류찾기("판매", "채널", "커머스", "마켓", "스마트스토어", "쿠팡") ?? template.Category;
        }

        if (flowNodes.Any(node => node.Kind.Equals("warehouse", StringComparison.OrdinalIgnoreCase) ||
                                  node.Kind.Equals("work", StringComparison.OrdinalIgnoreCase)) ||
            다이어그램신호있는가(flowNodes, diagramEdges, "창고", "재고", "입고", "출고", "피킹", "포장", "warehouse", "inventory"))
        {
            return 게시판분류찾기("창고", "재고", "입고", "출고", "업무", "기록") ?? template.Category;
        }

        if (flowNodes.Any(node => node.Kind.Equals("delivery", StringComparison.OrdinalIgnoreCase)) ||
            다이어그램신호있는가(flowNodes, diagramEdges, "배송", "운송", "배달", "용달", "상차", "하차", "transport", "delivery"))
        {
            return 게시판분류찾기("운송", "배송", "배달", "용달") ?? template.Category;
        }

        return 게시판분류찾기(template.Category) ?? template.Category;
    }

    private string? 게시판분류찾기(params string[] keywords)
        => BoardCategoryOptions.FirstOrDefault(category =>
            keywords.Any(keyword => category.Contains(keyword, StringComparison.OrdinalIgnoreCase)));

    private static string 다이어그램초안추천이유해결(
        CommunityLedgerTemplateResponse template,
        IReadOnlyList<원장블록노드> flowNodes,
        IReadOnlyList<원장블록연결선> diagramEdges,
        CommunityLedgerFlowAnalysisResponse analysis)
    {
        var nodeCount = flowNodes.Count;
        var edgeCount = diagramEdges.Count;
        var reviewSuffix = analysis.RequiresHumanReview
            ? " 다만 신호가 약해서 대분류도 작성 전에 한 번 확인하는 편이 좋습니다."
            : string.Empty;

        return $"{nodeCount}개 블록과 {edgeCount}개 연결을 기준으로 '{template.DisplayName}' 흐름을 참고했습니다.{reviewSuffix}";
    }

    private string 다이어그램커뮤니티초안제목생성(
        CommunityLedgerTemplateResponse template,
        IReadOnlyList<원장블록노드> flowNodes)
    {
        var path = string.Join(" -> ", flowNodes.Take(3).Select(node => node.Title));
        if (string.IsNullOrWhiteSpace(path))
        {
            path = "다이어그램";
        }

        return $"[{template.DisplayName}] {path} 공유";
