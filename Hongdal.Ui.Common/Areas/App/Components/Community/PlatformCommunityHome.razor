    private void BeginBaguaDockDrag(PointerEventArgs args)
    {
        isBaguaDockDragging = true;
        hasBaguaDockDragMoved = false;
        baguaDockDragStartX = args.ClientX;
    }

    private void HandleBaguaDockDrag(PointerEventArgs args)
    {
        if (!isBaguaDockDragging)
        {
            return;
        }

        var deltaX = args.ClientX - baguaDockDragStartX;
        if (Math.Abs(deltaX) < 14)
        {
            return;
        }

        hasBaguaDockDragMoved = true;
        if (deltaX <= -28)
        {
            isBaguaNavigatorOpen = true;
        }
        else if (deltaX >= 28)
        {
            isBaguaNavigatorOpen = false;
        }
    }

    private void EndBaguaDockDrag()
    {
        if (!isBaguaDockDragging)
        {
            return;
        }

        isBaguaDockDragging = false;
        if (!hasBaguaDockDragMoved)
        {
            isBaguaNavigatorOpen = !isBaguaNavigatorOpen;
        }

        hasBaguaDockDragMoved = false;
    }

    private void CancelBaguaDockDrag()
    {
        isBaguaDockDragging = false;
        hasBaguaDockDragMoved = false;
    }

    private void HandleBaguaDockKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            isBaguaNavigatorOpen = !isBaguaNavigatorOpen;
        }
    }

