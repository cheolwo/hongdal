    private static string 다이어그램대화방시각라벨(DateTime sentAtUtc)
    {
        var local = sentAtUtc.Kind == DateTimeKind.Utc ? sentAtUtc.ToLocalTime() : sentAtUtc;
        return local.ToString("HH:mm", CultureInfo.CurrentCulture);
