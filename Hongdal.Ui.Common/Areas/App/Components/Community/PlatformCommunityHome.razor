    private void 다이어그램대화방메시지추가(다이어그램대화방표시메시지 message)
    {
        if (다이어그램대화방표시메시지목록.Any(item => string.Equals(item.Id, message.Id, StringComparison.OrdinalIgnoreCase)))
        {
