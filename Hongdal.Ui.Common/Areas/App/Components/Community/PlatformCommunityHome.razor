        if (ContainsAny(stateLabel, "포장"))
        {
            return "포장";
        }

        return ContainsAny(stateLabel, "피킹", "검수", "출고")
            ? "피킹/검수"
            : "출고 요청";
    }

    private static string? ResolveFoodActiveNodeTitle(string stateLabel)
    {
        if (ContainsAny(stateLabel, "전달", "수령", "정산", "완료"))
        {
            return "전달/정산";
        }

        if (ContainsAny(stateLabel, "픽업", "배달", "배송", "이동"))
        {
            return "픽업/배달";
        }

        if (ContainsAny(stateLabel, "조리", "주방"))
        {
            return "조리";
        }

        return "음식 주문";
