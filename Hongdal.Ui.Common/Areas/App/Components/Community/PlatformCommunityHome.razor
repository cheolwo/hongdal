@namespace Hongdal.Ui.Common.Areas.App.Components.Community
@inherits MvvmComponentBase<PlatformCommunityHomePageViewModel>
@using System.Globalization
@using Hongdal.Contracts.Common.Community
@using Hongdal.Contracts.Common.Inbound
@using Hongdal.Contracts.Common.Versioning
@using Hongdal.Contracts.Common.Warehouse
@using Hongdal.Ui.Common.Areas.App.ViewModels
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Hongdal.Ui.Common.Areas.App.Services
@inject PlatformCommunityService CommunityService
@inject PlatformHomeModeStateService HomeModeState
@inject PlatformDiagramPaletteStateService DiagramPalette
@inject PlatformCommunityDecorationStateService DecorationState
@inject PlatformCommunityPostDraftStateService CommunityPostDrafts
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<link rel="stylesheet" href="_content/Hongdal.Ui.Common/css/platform-community-home.css" />

<MudContainer MaxWidth="MaxWidth.False" Class="@HomeRootClass">
    <MudStack Spacing="3">
        @if (BoardIndexOnly)
        {
            <PlatformCommunityBoardIndex AllBoard="@AllBoardNavigationItem"
                                         Boards="@VisibleBoardIndexItems"
                                         SearchText="@boardIndexSearchText"
                                         SearchTextChanged="HandleBoardIndexSearchChanged" />
        }
        else if (ListOnly)
        {
            <PlatformCommunityPostIndex SelectedBoard="@selectedBoardFilter"
                                        Boards="@PostIndexBoardItems"
                                        IsLoading="@isLoading"
                                        FilterOptions="@ForumListFilterOptions"
                                        SelectedFilter="@selectedForumListFilter"
                                        SelectedFilterChanged="SelectForumListFilter"
                                        ViewMode="@communityPostViewMode"
                                        ViewModeChanged="SelectCommunityPostViewMode"
                                        ComposeRequested="OpenCommunityComposePage"
                                        Posts="@VisiblePosts"
                                        SeedPosts="@VisibleSeedPosts"
                                        VisiblePostCount="@ForumVisiblePostCount"
                                        PostSelected="OpenCommunityPostPage"
                                        SeedPostSelected="OpenCommunitySeedPostPage"
                                        SearchText="@communityPostSearchText"
                                        SearchTextChanged="HandleCommunityPostSearchChanged" />
        }
        else if (isLedgerDetailOpen)
        {
            <CommunityLedgerDiagramDetail Context="ledgerDetailContext"
                                          IsLoading="isLedgerDetailLoading"
                                          ErrorMessage="@ledgerDetailErrorMessage"
                                          OnBack="ReturnFromLedgerDetail"
                                          OnAttach="AttachPendingLedgerAndReturn"
                                          HideAttach="ledgerDetailOpenedFromHierarchy"
                                          OnRefreshRequested="RefreshLedgerDetailAsync" />
        }
        else if (isOrderLedgerHierarchyOpen)
        {
            <CommunityOrderLedgerHierarchyDetail Context="orderLedgerHierarchyContext"
                                                 OnBack="ReturnToLedgerPicker"
                                                 OnAttach="AttachPendingLedgerAndReturn"
                                                 OnOpenDiagram="OpenHierarchyLedgerDiagram" />
        }
        else if (isLedgerPickerOpen)
        {
            var filteredLedgers = FilteredLedgerPickerChoices;
            var pendingLedger = myLedgers.FirstOrDefault(ledger =>
                string.Equals(ledger.원장Id, pendingLedgerId, StringComparison.OrdinalIgnoreCase));

            <section class="platform-ledger-picker-page" aria-label="첨부할 원장 선택">
                <header class="platform-ledger-picker-header">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Default"
                                   OnClick="ReturnToComposeFromLedgerPicker"
                                   aria-label="글쓰기로 돌아가기" />
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Primary">살뜰 게시판 글쓰기</MudText>
                        <MudText Typo="Typo.h5">원장 목록</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">글에 첨부할 원장을 선택하세요.</MudText>
                    </div>
                </header>

                <div class="platform-ledger-picker-tools">
                    <MudTextField T="string"
                                  Label="원장 검색"
                                  @bind-Value="ledgerPickerSearchText"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="platform-ledger-picker-search" />
                    <div class="platform-ledger-picker-segments" role="group" aria-label="원장 범위">
                        @foreach (var scope in LedgerPickerScopes)
                        {
                            <button type="button"
                                    class="@BuildLedgerPickerScopeClass(scope)"
                                    aria-pressed="@string.Equals(ledgerPickerScope, scope, StringComparison.Ordinal)"
                                    @onclick="@(() => ledgerPickerScope = scope)">
                                @scope
                            </button>
                        }
                    </div>
                    <span class="platform-ledger-picker-count">@($"{filteredLedgers.Count}개 원장")</span>
                </div>

                <div class="platform-ledger-picker-content">
                    @if (isMyLedgersLoading)
                    {
                        <div class="platform-ledger-picker-state" aria-live="polite">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                            <span>원장을 불러오는 중입니다.</span>
                        </div>
                    }
                    else if (myLedgers.Count == 0)
                    {
                        <div class="platform-ledger-picker-state">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Default" Size="Size.Large" />
                            <strong>첨부할 수 있는 원장이 없습니다.</strong>
                            <span>@(myLedgerLoadMessage ?? "로그인 상태와 원장 공유 범위를 확인해 주세요.")</span>
                        </div>
                    }
                    else if (filteredLedgers.Count == 0)
                    {
                        <div class="platform-ledger-picker-state">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Default" Size="Size.Large" />
                            <strong>조건에 맞는 원장이 없습니다.</strong>
                            <button type="button" class="platform-ledger-picker-reset" @onclick="ResetLedgerPickerFilters">검색 조건 지우기</button>
                        </div>
                    }
                    else
                    {
                        <div class="platform-ledger-picker-list">
                            @foreach (var ledger in filteredLedgers)
                            {
                                <button type="button"
                                        class="@BuildLedgerPickerItemClass(ledger)"
                                        aria-pressed="@IsPendingLedger(ledger)"
                                        @onclick="@(() => HandleLedgerPickerItemClickAsync(ledger))">
                                    <span class="platform-ledger-picker-item-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                                    </span>
                                    <span class="platform-ledger-picker-item-main">
                                        <span class="platform-ledger-picker-item-heading">
                                            <strong>@ledger.제목</strong>
                                            <small>@(ledger.내접근원장여부 ? "내 원장" : "공개 원장")</small>
                                        </span>
                                        <span>@ledger.원장템플릿명 · @ledger.상태</span>
                                        <small>@ledger.참여역할 · @FormatDate(ledger.수정시각Utc)</small>
                                    </span>
                                    <MudIcon Icon="@(IsPendingLedger(ledger) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                             Color="@(IsPendingLedger(ledger) ? Color.Primary : Color.Default)" />
                                </button>
                            }
                        </div>
                    }
                </div>

                <footer class="platform-ledger-picker-actions">
                    <div>
                        <span>선택한 원장</span>
                        <strong>@(pendingLedger?.제목 ?? "아직 선택하지 않음")</strong>
                    </div>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   OnClick="ReturnToComposeFromLedgerPicker">
                            취소
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   Disabled="@(pendingLedger is null)"
                                   OnClick="OpenPendingLedgerDetailAsync">
                            다이어그램 보기
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AttachFile"
                                   Disabled="@(pendingLedger is null)"
                                   OnClick="AttachPendingLedgerAndReturn">
                            선택한 원장 첨부
                        </MudButton>
                    </MudStack>
                </footer>
            </section>
        }
        else if (IsDiagramMode)
        {
            var blockFlowDiagram = 선택원장블록흐름도;
            var flowNodes = 정렬된원장블록노드목록가져오기(blockFlowDiagram);
            var 선택흐름노드 = 선택원장블록노드;
            var diagramEdges = BuildDiagramEdges(flowNodes);
            var selectedDiagramEdge = diagramEdges.FirstOrDefault(edge =>
                string.Equals(edge.Id, selectedDiagramEdgeId, StringComparison.OrdinalIgnoreCase));

            <div class="platform-diagram-mode-stage">
                <div class="platform-ledger-diagram-workbench platform-ledger-diagram-workbench--stage" aria-label="원장 다이어그램 캔버스">
                    <PlatformCommunityDiagramToolbar Canvas="@DiagramCanvas"
                                                             Layers="@다이어그램레이어정의s"
                                                             FormNodes="@DiagramFormPaletteBlocks"
                                                             ShowClose="true"
                                                             UseResponsiveOrderActions="true"
                                                             CanMoveBackward="@CanMove선택원장블록노드(-1)"
                                                             CanMoveForward="@CanMove선택원장블록노드(1)"
                                                             CanBringToFront="@CanBringSelectedDiagramNodeToFront()"
                                                             CanSendToBack="@CanSendSelectedDiagramNodeToBack()"
                                                             CanStartConnection="@(선택흐름노드 is not null && CanStartDiagramConnection(선택흐름노드))"
                                                             OnClose="OpenCommunityMode"
                                                             OnMoveBackward="@(() => Move선택원장블록노드(-1))"
                                                             OnMoveForward="@(() => Move선택원장블록노드(1))"
                                                             OnBringToFront="BringSelectedDiagramNodeToFront"
                                                             OnSendToBack="SendSelectedDiagramNodeToBack"
                                                             OnFormNodeSelected="AddPaletteBlockToCanvas"
                                                             OnStartConnection="StartDiagramEdgeFromSelectedNode"
                                                             OnReset="원장블록흐름도배치초기화"
                                                             OnCancelConnection="CancelDiagramEdgeCreation" />
                    <div @ref="diagramCanvasElement"
                         class="@BuildDiagramCanvasClass("platform-ledger-flow-diagram platform-ledger-flow-diagram--canvas platform-ledger-flow-diagram--stage-canvas platform-ledger-desktop-canvas")"
                         style="@BuildDiagramCanvasStyle(flowNodes, DiagramModeCanvasMinHeight)"
                         data-active-connection="@activeDiagramHandleDrag?.NodeTitle"
                         data-active-handle="@(activeDiagramHandleDrag is null ? null : BuildDiagramHandleKey(activeDiagramHandleDrag.Handle))"
                         @onpointermove="HandleDiagramCanvasPointerMoveAsync"
                         @onpointerup="HandleDiagramCanvasPointerUpAsync">
                        <svg class="platform-ledger-edge-layer"
                             viewBox="@BuildDiagramViewBox(flowNodes, DiagramModeCanvasMinHeight)"
                             preserveAspectRatio="none"
                             aria-hidden="true">
                            <defs>
                                <marker id="platform-ledger-stage-edge-arrow"
                                        viewBox="0 0 10 10"
                                        refX="8"
                                        refY="5"
                                        markerWidth="7"
                                        markerHeight="7"
                                        orient="auto-start-reverse">
                                    <path d="M 0 0 L 10 5 L 0 10 z" />
                                </marker>
                            </defs>
                            @foreach (var edge in diagramEdges)
                            {
                                    var geometry = BuildDiagramEdgeGeometry(edge, flowNodes, DiagramModeCanvasMinHeight);
                                if (geometry is not null)
                                {
                                    <path class="platform-ledger-edge-hit-area"
                                          d="@geometry.Path"
                                          @onclick="@(() => SelectDiagramEdge(edge))"
                                          @onclick:stopPropagation="true" />
                                    <path class="@BuildDiagramEdgePathClass(edge)"
                                          d="@geometry.Path"
                                          marker-end="url(#platform-ledger-stage-edge-arrow)"
                                          @onclick="@(() => SelectDiagramEdge(edge))"
                                          @onclick:stopPropagation="true" />
                                }
                            }
                            @if (activeDiagramHandleDrag is not null && diagramDragPointer is not null)
                            {
                                var previewGeometry = BuildDiagramPreviewEdgeGeometry(activeDiagramHandleDrag, flowNodes, diagramDragPointer, DiagramModeCanvasMinHeight);
                                if (previewGeometry is not null)
                                {
                                    <path class="platform-ledger-edge-path platform-ledger-edge-path--preview"
                                          d="@previewGeometry.Path"
                                          marker-end="url(#platform-ledger-stage-edge-arrow)" />
                                }
                            }
                        </svg>
                        @foreach (var edge in diagramEdges)
                        {
                            var geometry = BuildDiagramEdgeGeometry(edge, flowNodes, DiagramModeCanvasMinHeight);
                            if (geometry is not null)
                            {
                                <button type="button"
                                        class="@BuildDiagramEdgeLabelClass(edge)"
                                        style="@BuildDiagramEdgeLabelStyle(geometry)"
                                        title="@edge.Label"
                                        @onclick="@(() => SelectDiagramEdge(edge))">
                                    @edge.Label
                                </button>
                            }
                        }
                        @for (var i = 0; i < flowNodes.Count; i++)
                        {
                            var node = flowNodes[i];
                            var nodeLayerBadges = 도형레이어배지목록생성(node, i, flowNodes);
                            var nodeInputFormFields = 도형입력항목해결(node);
                            var nodeSticker = 원장블록노드스티커해결(node);
                            var nodeReadiness = 노드입력준비도해결(node, 원장블록처리상태해결(i, flowNodes));
                            var nodePositionStyle = 원장블록노드스타일생성(i, flowNodes, DiagramModeCanvasMinHeight);
                            <div role="button"
                                 tabindex="0"
                                 class="@원장블록노드클래스생성(node, i, flowNodes)"
                                 style="@($"{nodePositionStyle} {BuildDiagramNodeStackStyle(node, flowNodes)} {BuildNodeReadinessStyle(nodeReadiness)}")"
                                 aria-pressed="@원장블록노드선택됨(node)"
                                 title="@node.Description"
                                 @onclick="@(() => 원장블록노드클릭처리(node))"
                                 @oncontextmenu="@((MouseEventArgs _) => 원장블록노드컨텍스트메뉴처리Async(node))"
                                 @oncontextmenu:preventDefault="true">
                                @if (IsDiagramLayerVisible(DiagramLayerRole))
                                {
                                    <span class="platform-ledger-flow-node-role">@흐름노드역할라벨해결(node)</span>
                                }
                                <span class="@(nodeSticker is null ? "platform-ledger-flow-node-icon" : "platform-ledger-flow-node-icon platform-ledger-flow-node-icon--sticker")">
                                    @if (nodeSticker is not null)
                                    {
                                        <img class="platform-ledger-flow-node-sticker"
                                             src="@nodeSticker.이미지Url"
                                             alt="@nodeSticker.대체Text"
                                             title="@nodeSticker.표시명" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@원장블록노드아이콘해결(node)" Color="@node.Color" />
                                    }
                                </span>
                                <span class="platform-ledger-flow-node-title">@node.Title</span>
                                <span class="platform-ledger-flow-node-form-summary"
                                      title="@도형입력요약제목생성(nodeInputFormFields)">
                                    @($"{nodeReadiness.Percent}% · {nodeReadiness.CountLabel}")
                                </span>
                                <span class="platform-ledger-flow-node-readiness" aria-label="@($"입력 준비도 {nodeReadiness.Percent}%")">
                                    <i></i>
                                </span>
                                @if (nodeLayerBadges.Count > 0)
                                {
                                    <span class="platform-ledger-flow-node-layer-stack" aria-label="노드 레이어 신호">
                                        @foreach (var badge in nodeLayerBadges)
                                        {
                                            <span class="@badge.CssClass" title="@badge.Description">
                                                <MudIcon Icon="@badge.Icon" Size="Size.Small" />
                                                <span>@badge.Label</span>
                                            </span>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        @for (var i = 0; i < flowNodes.Count; i++)
                        {
                            var node = flowNodes[i];
                            foreach (var handle in ResolveDiagramConnectionHandles(node))
                            {
                                <button type="button"
                                        class="@BuildDiagramHandleClass(handle)"
                                        style="@($"{BuildDiagramHandleStyle(i, handle, flowNodes, DiagramModeCanvasMinHeight)} {BuildDiagramHandleStackStyle(node, flowNodes)}")"
                                        title="@($"{node.Title} {BuildDiagramHandleLabel(handle)} 연결점")"
                                        aria-label="@($"{node.Title} {BuildDiagramHandleLabel(handle)} 연결점")"
                                        data-node-title="@node.Title"
                                        data-handle="@BuildDiagramHandleKey(handle)"
                                        draggable="false"
                                        @onpointerdown="@((PointerEventArgs eventArgs) => BeginDiagramHandlePointerDragAsync(node, handle, eventArgs))"
                                        @onpointerdown:stopPropagation="true"
                                        @onpointerup="@(() => CompleteDiagramHandleDrag(node, handle))"
                                        @onpointerup:stopPropagation="true"
                                        @onclick="@(() => HandleDiagramHandleClick(node, handle))"
                                        @onclick:stopPropagation="true"
                                        @ondragstart:preventDefault="true"></button>
                            }
                        }
                    </div>
                    <section class="platform-ledger-mobile-flow" aria-label="모바일 세로 다이어그램">
                        <header class="platform-ledger-mobile-flow-header">
                            <div>
                                <span>MOBILE FLOW</span>
                                <strong>위에서 아래로 한 단계씩 확인하세요</strong>
                                <small>노드를 누르면 현재 단계에 집중하고, 상세·순서·연결 작업을 이어갈 수 있습니다.</small>
                            </div>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@($"{flowNodes.Count}단계")</MudChip>
                                <PlatformDiagramFormNodeMenu FormNodes="@DiagramFormPaletteBlocks"
                                                             FormNodeSelected="AddPaletteBlockToCanvas" />
                            </MudStack>
                        </header>

                        @if (!string.IsNullOrWhiteSpace(connectionStartNodeTitle))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="platform-ledger-mobile-connect-guide">
                                <strong>@connectionStartNodeTitle</strong>에서 연결을 시작했습니다. 아래에서 연결할 노드를 선택하세요.
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" OnClick="CancelDiagramEdgeCreation">취소</MudButton>
                            </MudAlert>
                        }

                        <div class="platform-ledger-mobile-flow-list">
                            @for (var mobileIndex = 0; mobileIndex < flowNodes.Count; mobileIndex++)
                            {
                                var mobileNode = flowNodes[mobileIndex];
                                var mobileNodeInputFields = 도형입력항목해결(mobileNode);
                                var mobileNodeSticker = 원장블록노드스티커해결(mobileNode);
                                var mobileNodeState = 원장블록처리상태해결(mobileIndex, flowNodes);
                                var mobileNodeReadiness = 노드입력준비도해결(mobileNode, mobileNodeState);
                                var mobileNodeBadges = 도형레이어배지목록생성(mobileNode, mobileIndex, flowNodes);
                                var nextMobileNode = mobileIndex < flowNodes.Count - 1 ? flowNodes[mobileIndex + 1] : null;
                                var primaryMobileEdge = nextMobileNode is null
                                    ? null
                                    : diagramEdges.FirstOrDefault(edge =>
                                        string.Equals(edge.FromTitle, mobileNode.Title, StringComparison.OrdinalIgnoreCase) &&
                                        string.Equals(edge.ToTitle, nextMobileNode.Title, StringComparison.OrdinalIgnoreCase));
                                var extraMobileEdges = diagramEdges
                                    .Where(edge =>
                                        string.Equals(edge.FromTitle, mobileNode.Title, StringComparison.OrdinalIgnoreCase) &&
                                        (nextMobileNode is null || !string.Equals(edge.ToTitle, nextMobileNode.Title, StringComparison.OrdinalIgnoreCase)))
                                    .ToArray();

                                <article class="platform-ledger-mobile-step">
                                    <button type="button"
                                            class="@BuildMobileDiagramNodeClass(mobileNode, mobileIndex, flowNodes)"
                                            style="@BuildNodeReadinessStyle(mobileNodeReadiness)"
                                            aria-pressed="@원장블록노드선택됨(mobileNode)"
                                            @onclick="@(() => 원장블록노드클릭처리(mobileNode))">
                                        <span class="platform-ledger-mobile-node-fill" aria-hidden="true"></span>
                                        <span class="platform-ledger-mobile-step-number">@(mobileIndex + 1)</span>
                                        <span class="platform-ledger-mobile-node-icon">
                                            @if (mobileNodeSticker is not null)
                                            {
                                                <img src="@mobileNodeSticker.이미지Url" alt="@mobileNodeSticker.대체Text" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@원장블록노드아이콘해결(mobileNode)" Color="@mobileNode.Color" />
                                            }
                                        </span>
                                        <span class="platform-ledger-mobile-node-copy">
                                            <span class="platform-ledger-mobile-node-meta">
                                                <span>@흐름노드역할라벨해결(mobileNode)</span>
                                                <b>@BuildNodeProcessingStateLabel(mobileNodeState)</b>
                                            </span>
                                            <strong>@mobileNode.Title</strong>
                                            <small>@mobileNode.Description</small>
                                            <span class="platform-ledger-mobile-node-readiness">
                                                <span><i></i></span>
                                                <b>@($"{mobileNodeReadiness.Percent}%")</b>
                                                <em>@mobileNodeReadiness.CountLabel</em>
                                            </span>
                                        </span>
                                    </button>

                                    @if (원장블록노드선택됨(mobileNode))
                                    {
                                        <div class="platform-ledger-mobile-node-focus">
                                            <p class="platform-ledger-mobile-readiness-guidance">
                                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                                                <span>@mobileNodeReadiness.GuidanceLabel</span>
                                            </p>
                                            @if (mobileNodeBadges.Count > 0)
                                            {
                                                <div class="platform-ledger-mobile-node-badges">
                                                    @foreach (var badge in mobileNodeBadges)
                                                    {
                                                        <span class="@badge.CssClass" title="@badge.Description">
                                                            <MudIcon Icon="@badge.Icon" Size="Size.Small" />
                                                            <span>@badge.Label</span>
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            <div class="platform-ledger-mobile-node-actions">
                                                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="@(() => OpenNodeDetailPanel(mobileNode))">상세</MudButton>
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AccountTree" Disabled="@(!CanStartDiagramConnection(mobileNode))" OnClick="StartDiagramEdgeFromSelectedNode">연결</MudButton>
                                                <MudIconButton Icon="@Icons.Material.Filled.FlipToFront" Size="Size.Small" Color="Color.Secondary" Disabled="@(!CanBringSelectedDiagramNodeToFront())" OnClick="BringSelectedDiagramNodeToFront" aria-label="선택 노드를 맨 앞으로 보내기" />
                                                <MudIconButton Icon="@Icons.Material.Filled.FlipToBack" Size="Size.Small" Color="Color.Secondary" Disabled="@(!CanSendSelectedDiagramNodeToBack())" OnClick="SendSelectedDiagramNodeToBack" aria-label="선택 노드를 맨 뒤로 보내기" />
