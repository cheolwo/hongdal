    private async Task 다이어그램대화방이력조회Async()
    {
        var roomId = 다이어그램대화방Id;
        if (string.Equals(다이어그램대화방이력조회완료방Id, roomId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        다이어그램대화방이력로딩중 = true;
        다이어그램대화방알림문구 = "저장된 대화 이력을 먼저 불러오고 있습니다.";
        try
        {
            await InvokeAsync(StateHasChanged);
            var messages = await Diagram대화방Client.메시지목록조회Async(roomId, 40);
            if (messages.Count > 0)
            {
                다이어그램대화방표시메시지목록.Clear();
                foreach (var message in messages.OrderBy(item => item.SentAtUtc == default ? DateTime.MinValue : item.SentAtUtc))
                {
                    다이어그램대화방메시지추가(To다이어그램대화방표시메시지(message));
                }

                다이어그램대화방알림문구 = $"최근 대화 {messages.Count}개를 먼저 불러왔습니다.";
            }
            else
            {
                다이어그램대화방알림문구 = "저장된 대화가 아직 없어 로컬 미리보기 메시지를 유지합니다.";
            }

            다이어그램대화방이력조회완료방Id = roomId;
        }
        finally
        {
            다이어그램대화방이력로딩중 = false;
        }
    }

    private async Task 다이어그램대화방메시지전송Async()
    {
        var message = 다이어그램대화방메시지입력.Trim();
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        다이어그램대화방메시지입력 = string.Empty;
        var sent = await Diagram대화방Client.메시지전송Async(new DiagramChatMessageRequest
        {
            RoomId = 다이어그램대화방Id,
            Message = message,
            DiagramId = 다이어그램대화방Id,
            DiagramName = SelectedLedgerTemplate.DisplayName,
            MessageKind = DiagramCollaborationMessageKinds.Text
        });

        if (!sent)
        {
            다이어그램대화방메시지추가(new(
                Guid.NewGuid().ToString("N"),
                다이어그램대화방로컬사용자Id,
                "나",
                message,
                DiagramCollaborationMessageKinds.Text,
                DateTime.UtcNow,
                true,
                false));
        }
    }

    private Task Handle다이어그램대화방메시지수신Async(DiagramChatMessageResponse message)
    {
        다이어그램대화방메시지추가(To다이어그램대화방표시메시지(message));

        return InvokeAsync(StateHasChanged);
    }

    private 다이어그램대화방표시메시지 To다이어그램대화방표시메시지(DiagramChatMessageResponse message)
    {
        var senderUserId = string.IsNullOrWhiteSpace(message.SenderUserId)
            ? Guid.NewGuid().ToString("N")
            : message.SenderUserId.Trim();
        var currentUserId = Diagram대화방Client.현재사용자Id;
        var isMine = !string.IsNullOrWhiteSpace(currentUserId) &&
                     string.Equals(senderUserId, currentUserId, StringComparison.OrdinalIgnoreCase);

        return new(
            string.IsNullOrWhiteSpace(message.MessageId) ? Guid.NewGuid().ToString("N") : message.MessageId,
            senderUserId,
            string.IsNullOrWhiteSpace(message.SenderDisplayName) ? "익명 참여자" : message.SenderDisplayName,
            message.Message,
            message.MessageKind,
            message.SentAtUtc == default ? DateTime.UtcNow : message.SentAtUtc,
            isMine,
            string.Equals(message.MessageKind, DiagramCollaborationMessageKinds.System, StringComparison.OrdinalIgnoreCase));
    }

