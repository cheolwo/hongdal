@code {
    [Parameter]
    public string AppName { get; set; } = "Hongdal";

    [Parameter]
    public string RoleLabel { get; set; } = "플랫폼 구성원";

    [Parameter]
    public string AppKey { get; set; } = "platform";

    [Parameter]
    public IReadOnlyList<PlatformHomeQuickAction> QuickActions { get; set; } = [];

    [Parameter]
    public bool CanManageCommunityPosts { get; set; }

    [Parameter]
    public RenderFragment? CommunityModeContent { get; set; }

    [Parameter]
    public RenderFragment? WorkModeContent { get; set; }

    private readonly List<PlatformCommunityPostResponse> posts = [];
    private readonly List<PlatformCommunityBoardResponse> approvedBoards = [];
    private readonly List<PlatformCommunityBoardResponse> pendingBoardRequests = [];
    private readonly List<IBrowserFile> selectedFiles = [];
    private readonly PlatformCommunityPostForm form = new();
    private readonly PlatformCommunityBoardForm boardForm = new();
    private readonly Dictionary<long, PlatformCommunityCommentForm> commentForms = [];
    private readonly Dictionary<long, PlatformCommunityCommentForm> attachmentCommentForms = [];
    private readonly Dictionary<long, string> boardReviewMemo = [];
    private readonly string recommendationSessionKey = Guid.NewGuid().ToString("N");
    private long? editingPostId;
    private bool isLoading = true;
    private bool isSaving;
    private bool isSavingBoardRequest;
    private bool isWorkMode;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private const long MaxUploadFileBytes = 5 * 1024 * 1024;

    private string HomeRootClass => isWorkMode
        ? "py-4 platform-community-home platform-home--work"
        : "py-4 platform-community-home platform-home--community";

    private string CommunityGridClass => isWorkMode
        ? "platform-community-main-grid platform-home-section-hidden"
        : "platform-community-main-grid";

    private string WorkPanelClass => isWorkMode
        ? "pa-4 platform-work-panel"
        : "pa-4 platform-work-panel platform-home-section-hidden";

    private string CurrentModeLabel => isWorkMode ? "업무 모드" : "커뮤니티 모드";

    private Color CurrentModeColor => isWorkMode ? Color.Success : Color.Primary;

    protected override async Task OnInitializedAsync()
    {
        HomeModeState.Changed += HandleModeChanged;
        isWorkMode = HomeModeState.IsWorkMode;
        await LoadBoardsAsync();
        await LoadPostsAsync();
    }

    private void PrepareWorkCommunityDraft(WorkCommunityDraftKind kind)
    {
        editingPostId = null;
        selectedFiles.Clear();
        form.Category = ResolveDraftCategory(kind);
        form.WorkflowTag = ResolveDraftWorkflowTag(kind);
        form.RoleTag = ResolveRoleTag(RoleLabel);
        form.Title = ResolveDraftTitle(kind);
        form.Body = ResolveDraftBody(kind);
        form.SharedLinkUrl = string.Empty;
        form.IsReportBoardPost = false;
        form.ReporterDisplayName = string.Empty;
        form.ReportedDisplayName = string.Empty;
        HomeModeState.SetWorkMode(false);
        statusSeverity = Severity.Info;
        statusMessage = "업무 맥락을 커뮤니티 글 초안으로 옮겼습니다. 닉네임과 비밀번호를 입력한 뒤 필요한 내용을 보완해 등록하세요.";
    }

    private void HandleModeChanged()
    {
        isWorkMode = HomeModeState.IsWorkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        HomeModeState.Changed -= HandleModeChanged;
    }

    private async Task LoadPostsAsync()
    {
        isLoading = true;
        try
        {
            var result = await CommunityService.GetPostsAsync(AppKey);
            posts.Clear();
            posts.AddRange(result.Items);
        }
        catch
        {
            statusSeverity = Severity.Info;
            statusMessage = "커뮤니티 API가 연결되면 글 작성과 조회가 활성화됩니다.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadBoardsAsync()
    {
        try
        {
            var approved = await CommunityService.GetBoardsAsync(AppKey, PlatformCommunityBoardRequestStatuses.Approved);
            approvedBoards.Clear();
            approvedBoards.AddRange(approved.Items);

            if (CanManageCommunityPosts)
            {
                var pending = await CommunityService.GetBoardsAsync(AppKey, PlatformCommunityBoardRequestStatuses.Pending);
                pendingBoardRequests.Clear();
                pendingBoardRequests.AddRange(pending.Items);
                foreach (var board in pendingBoardRequests)
                {
                    boardReviewMemo.TryAdd(board.Id, string.Empty);
                }
            }
        }
        catch
        {
            // Board requests are an enhancement; post loading should still work if this API is unavailable.
        }
    }

    private async Task SaveBoardRequestAsync()
    {
        statusMessage = null;
        if (string.IsNullOrWhiteSpace(boardForm.Title) ||
            string.IsNullOrWhiteSpace(boardForm.RequestedBy) ||
            string.IsNullOrWhiteSpace(boardForm.RequestReason))
        {
            statusSeverity = Severity.Warning;
            statusMessage = "게시판 이름, 신청자, 개설 이유를 입력하세요.";
            return;
        }

        isSavingBoardRequest = true;
        try
        {
            await CommunityService.CreateBoardRequestAsync(new PlatformCommunityBoardCreateRequest
            {
                AppKey = AppKey,
                Title = boardForm.Title,
                Description = boardForm.Description,
                RequestedBy = boardForm.RequestedBy,
                RequestReason = boardForm.RequestReason
            });

            boardForm.Title = string.Empty;
            boardForm.Description = string.Empty;
            boardForm.RequestReason = string.Empty;
            await LoadBoardsAsync();

            statusSeverity = Severity.Success;
            statusMessage = "게시판 개설 신청을 접수했습니다. 운영자 승인 후 게시판 목록에 표시됩니다.";
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"게시판 개설 신청에 실패했습니다: {ex.Message}";
        }
        finally
        {
            isSavingBoardRequest = false;
        }
    }

    private async Task ReviewBoardAsync(PlatformCommunityBoardResponse board, bool approve)
    {
        try
        {
            var memo = boardReviewMemo.TryGetValue(board.Id, out var value) ? value : string.Empty;
            if (approve)
            {
                await CommunityService.ApproveBoardAsync(board.Id, memo);
                statusMessage = $"'{board.Title}' 게시판을 승인했습니다.";
            }
            else
            {
                await CommunityService.RejectBoardAsync(board.Id, memo);
                statusMessage = $"'{board.Title}' 게시판 신청을 반려했습니다.";
            }

            statusSeverity = Severity.Success;
            await LoadBoardsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"게시판 검토 처리에 실패했습니다: {ex.Message}";
        }
    }

    private void SelectBoard(string title)
    {
        form.Category = title;
        statusSeverity = Severity.Info;
        statusMessage = $"'{title}' 게시판으로 글 분류를 선택했습니다.";
    }

    private async Task SavePostAsync()
    {
        statusMessage = null;
        if (string.IsNullOrWhiteSpace(form.Nickname) ||
            string.IsNullOrWhiteSpace(form.Password) ||
            string.IsNullOrWhiteSpace(form.Title) ||
            (string.IsNullOrWhiteSpace(form.Body) && string.IsNullOrWhiteSpace(form.SharedLinkUrl)))
        {
            statusSeverity = Severity.Warning;
            statusMessage = "닉네임, 비밀번호, 제목, 본문 또는 링크를 입력하세요.";
            return;
        }

        isSaving = true;
        try
        {
            var wasEditing = editingPostId is not null;
            PlatformCommunityPostResponse? saved;

            if (editingPostId is long postId)
            {
                saved = await CommunityService.UpdatePostAsync(postId, new PlatformCommunityPostUpdateRequest
                {
                    Category = form.Category,
                    WorkflowTag = form.WorkflowTag,
                    RoleTag = form.RoleTag,
                    Title = form.Title,
                    Body = form.Body,
                    SharedLinkUrl = form.SharedLinkUrl,
                    Nickname = form.Nickname,
                    IsReportBoardPost = form.IsReportBoardPost,
                    ReporterDisplayName = form.ReporterDisplayName,
                    ReportedDisplayName = form.ReportedDisplayName,
                    Password = form.Password
                });
            }
            else
            {
                saved = await CommunityService.CreatePostAsync(new PlatformCommunityPostCreateRequest
                {
                    AppKey = AppKey,
                    Category = form.Category,
                    WorkflowTag = form.WorkflowTag,
                    RoleTag = form.RoleTag,
                    Title = form.Title,
                    Body = form.Body,
                    SharedLinkUrl = form.SharedLinkUrl,
                    Nickname = form.Nickname,
                    IsReportBoardPost = form.IsReportBoardPost,
                    ReporterDisplayName = form.ReporterDisplayName,
                    ReportedDisplayName = form.ReportedDisplayName,
                    Password = form.Password
                });
            }

            if (saved is not null)
            {
                foreach (var file in selectedFiles)
                {
                    await CommunityService.UploadAttachmentAsync(saved.Id, form.Password, file, MaxUploadFileBytes);
                }

                ResetForm();
                await LoadPostsAsync();
            }

            statusSeverity = Severity.Success;
            statusMessage = wasEditing ? "글을 수정했습니다." : "글을 등록했습니다.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            statusSeverity = Severity.Error;
            statusMessage = "비밀번호가 맞지 않아 수정할 수 없습니다.";
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"저장에 실패했습니다: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RecommendPostAsync(PlatformCommunityPostResponse post)
    {
        try
        {
            await CommunityService.RecommendAsync(post.Id, recommendationSessionKey);
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"추천 처리에 실패했습니다: {ex.Message}";
        }
    }

    private async Task ToggleOperatorPinAsync(PlatformCommunityPostResponse post)
    {
        try
        {
            await CommunityService.SetOperatorPinAsync(post.Id, !post.IsOperatorPinned);
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"상단 고정 처리에 실패했습니다: {ex.Message}";
        }
    }

    private async Task SaveCommentAsync(PlatformCommunityPostResponse post)
    {
        var commentForm = GetCommentForm(post.Id);
        if (string.IsNullOrWhiteSpace(commentForm.Nickname) ||
            string.IsNullOrWhiteSpace(commentForm.Password) ||
            string.IsNullOrWhiteSpace(commentForm.Body))
        {
            statusSeverity = Severity.Warning;
            statusMessage = "댓글 닉네임, 비밀번호, 내용을 입력하세요.";
            return;
        }

        try
        {
            await CommunityService.CreateCommentAsync(post.Id, new PlatformCommunityPostCommentCreateRequest
            {
                Nickname = commentForm.Nickname,
                Password = commentForm.Password,
                Body = commentForm.Body
            });

            commentForms.Remove(post.Id);
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"댓글 등록에 실패했습니다: {ex.Message}";
        }
    }

    private async Task DeleteCommentAsync(PlatformCommunityPostResponse post, PlatformCommunityPostCommentResponse comment)
    {
        var commentForm = GetCommentForm(post.Id);
        if (string.IsNullOrWhiteSpace(commentForm.Password))
        {
            statusSeverity = Severity.Warning;
            statusMessage = "Enter the comment password before deleting.";
            return;
        }

        try
        {
            await CommunityService.DeleteCommentAsync(post.Id, comment.Id, commentForm.Password);
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"Comment delete failed: {ex.Message}";
        }
    }

    private async Task ReportCommentAsync(PlatformCommunityPostCommentResponse comment)
    {
        try
        {
            await CommunityService.ReportCommentAsync(comment.Id);
            statusSeverity = Severity.Info;
            statusMessage = "Comment report received.";
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"Comment report failed: {ex.Message}";
        }
    }

    private PlatformCommunityCommentForm GetCommentForm(long postId)
    {
        if (!commentForms.TryGetValue(postId, out var commentForm))
        {
            commentForm = new PlatformCommunityCommentForm();
            commentForms[postId] = commentForm;
        }

        return commentForm;
    }

    private async Task SaveAttachmentCommentAsync(PlatformCommunityPostAttachmentResponse attachment)
    {
        var commentForm = GetAttachmentCommentForm(attachment.Id);
        if (string.IsNullOrWhiteSpace(commentForm.Nickname) ||
            string.IsNullOrWhiteSpace(commentForm.Password) ||
            string.IsNullOrWhiteSpace(commentForm.Body))
        {
            statusSeverity = Severity.Warning;
            statusMessage = "Image comment nickname, password, and body are required.";
            return;
        }

        try
        {
            await CommunityService.CreateAttachmentCommentAsync(attachment.Id, new PlatformCommunityPostAttachmentCommentCreateRequest
            {
                Nickname = commentForm.Nickname,
                Password = commentForm.Password,
                Body = commentForm.Body
            });

            attachmentCommentForms.Remove(attachment.Id);
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"Image comment failed: {ex.Message}";
        }
    }

    private async Task DeleteAttachmentCommentAsync(
        PlatformCommunityPostAttachmentResponse attachment,
        PlatformCommunityPostAttachmentCommentResponse comment)
    {
        var commentForm = GetAttachmentCommentForm(attachment.Id);
        if (string.IsNullOrWhiteSpace(commentForm.Password))
        {
            statusSeverity = Severity.Warning;
            statusMessage = "Enter the image comment password before deleting.";
            return;
        }

        try
        {
            await CommunityService.DeleteAttachmentCommentAsync(attachment.Id, comment.Id, commentForm.Password);
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"Image comment delete failed: {ex.Message}";
        }
    }

    private async Task ReportAttachmentCommentAsync(PlatformCommunityPostAttachmentCommentResponse comment)
    {
        try
        {
            await CommunityService.ReportAttachmentCommentAsync(comment.Id);
            statusSeverity = Severity.Info;
            statusMessage = "Image comment report received.";
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"Image comment report failed: {ex.Message}";
        }
    }

    private PlatformCommunityCommentForm GetAttachmentCommentForm(long attachmentId)
    {
        if (!attachmentCommentForms.TryGetValue(attachmentId, out var commentForm))
        {
            commentForm = new PlatformCommunityCommentForm();
            attachmentCommentForms[attachmentId] = commentForm;
        }

        return commentForm;
    }

    private void BeginEdit(PlatformCommunityPostResponse post)
    {
        editingPostId = post.Id;
        selectedFiles.Clear();
        form.Nickname = post.Nickname;
        form.Password = string.Empty;
        form.Category = post.Category;
        form.WorkflowTag = post.WorkflowTag;
        form.RoleTag = post.RoleTag;
        form.Title = post.Title;
        form.Body = post.Body;
        form.SharedLinkUrl = post.SharedLinkUrl ?? string.Empty;
        form.IsReportBoardPost = IsReportPost(post);
        form.ReporterDisplayName = post.ReporterDisplayName;
        form.ReportedDisplayName = post.ReportedDisplayName;
        statusMessage = "작성할 때 입력한 비밀번호를 넣고 수정 저장을 누르세요.";
        statusSeverity = Severity.Info;
    }

    private void CancelEdit()
    {
        ResetForm();
        statusMessage = null;
    }

    private void ResetForm()
    {
        editingPostId = null;
        selectedFiles.Clear();
        form.Nickname = string.Empty;
        form.Password = string.Empty;
        form.Category = "자유";
        form.WorkflowTag = "국내 화물 운송";
        form.RoleTag = ResolveRoleTag(RoleLabel);
        form.Title = string.Empty;
        form.Body = string.Empty;
        form.SharedLinkUrl = string.Empty;
    }

    private IReadOnlyList<string> BoardCategoryOptions
    {
        get
        {
            var categories = new List<string>
            {
                "자유",
                "운송 실무",
                "업무 질문",
                "업무 기록",
                "개선 제안",
                "신고/분쟁"
            };

            foreach (var board in approvedBoards)
            {
                if (!categories.Contains(board.Title, StringComparer.OrdinalIgnoreCase))
                {
                    categories.Add(board.Title);
                }
            }

            return categories;
        }
    }

