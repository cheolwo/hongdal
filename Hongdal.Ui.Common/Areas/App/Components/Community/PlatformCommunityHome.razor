            WorkCommunityDraftKind.WorkDone => $"[{RoleLabel}] 오늘 처리한 업무 공유",
            WorkCommunityDraftKind.Suggestion => $"[{RoleLabel}] 업무 개선 제안",
            WorkCommunityDraftKind.InternationalCoordination => $"[{RoleLabel}] 국제 소통 확인 요청",
            _ => $"[{RoleLabel}] 업무 공유"
        };
    }

