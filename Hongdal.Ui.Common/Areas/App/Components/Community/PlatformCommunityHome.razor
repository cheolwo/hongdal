    private IReadOnlyList<CommunityLedgerBlockResponse> 흐름노드관련블록해결(원장블록노드 node)
        => SelectedLedgerTemplate.LedgerBlocks
            .Where(block => 흐름노드가블록과맞는가(node, block))
