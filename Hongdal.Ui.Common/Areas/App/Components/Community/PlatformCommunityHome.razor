                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="계약번호"
                                                          @bind-Value="warehouseProxyContractNo"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudSelect T="string"
                                                       Label="입고 계약 유형"
                                                       @bind-Value="창고대행계약유형"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense">
                                                @foreach (var type in 창고대행입고계약유형목록)
