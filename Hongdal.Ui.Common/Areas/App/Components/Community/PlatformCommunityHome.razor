                                                               AccentColor="@DecorationState.BaguaAccentColor"
                                                               CenterSymbol="@EffectiveBaguaCenterSymbol"
                                                               CenterTrigramName="@BaguaCenterTrigramName"
                                                               CenterDestinationLabel="@BaguaCenterDestinationLabel"
                                                               CenterSelected="@BaguaCenterSelectedCallback"
                                                               ShowTaegeukCenter="@BaguaCenterShowsTaegeuk"
                                                               TaegeukYangDestinationLabel="커뮤니티"
                                                               TaegeukYinDestinationLabel="상점"
                                                               TaegeukYangSelected="@BaguaTaegeukYangSelectedCallback"
                                                               TaegeukYinSelected="@BaguaTaegeukYinSelectedCallback"
                                                               ShowTrigramSymbols="@DecorationState.IsBaguaDecorationEnabled"
                                                               CenterTransferTrigramKey="zhen"
                                                               CenterTransferDestinationLabel="공동구매"
                                                               CenterTransferCompleted="HandleBaguaCenterTransferCompletedAsync"
                                                               DestinationSelected="HandleBaguaDestinationSelectedAsync" />
                        }
                    }
                </div>
            </MudStack>
        </MudPaper>

        @if (!isWorkMode && ShowRealtimeBest && 실시간베스트글.Count > 0)
        {
            <section class="platform-community-realtime-best" aria-label="실시간 베스트 글">
                <header>
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                        <strong>실시간 베스트</strong>
                    </div>
                    <span>추천과 댓글이 모인 글</span>
                </header>
                <ol>
                    @for (var index = 0; index < 실시간베스트글.Count; index++)
                    {
                        var 베스트글 = 실시간베스트글[index];
                        <li>
                            <a href="#community-forum-list"
                               @onclick="@(() => 실시간베스트글열기(베스트글))">
                                <span class="platform-community-realtime-best-rank">@(index + 1)</span>
                                <span class="platform-community-realtime-best-category">@베스트글.분류</span>
                                <strong>@베스트글.제목</strong>
                                <span class="platform-community-realtime-best-author">@베스트글.작성자</span>
                                <span class="platform-community-realtime-best-meta">
                                    <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                    @베스트글.추천수
                                    <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" />
                                    @베스트글.댓글수
                                </span>
                            </a>
                        </li>
                    }
                </ol>
            </section>
        }

        @if (!isWorkMode)
        {
            <section id="community-board-list" class="platform-community-board-shelf" aria-label="커뮤니티 게시판 목록">
                <div class="platform-community-section-heading">
                    <div>
                        <span>BOARD INDEX</span>
                        <strong>게시판</strong>
                    </div>
                    <span>@($"{CommunityBoardOptions.Count:N0}개 게시판")</span>
                </div>
                <div class="platform-community-board-scroll">
                    @foreach (var board in CommunityBoardOptions)
                    {
                        <button type="button"
                                class="@BuildCommunityBoardClass(board)"
                                @onclick="@(() => SelectBoardFilter(board))">
                            <span class="platform-community-board-icon">
                                <MudIcon Icon="@ResolveCommunityBoardIcon(board)" Size="Size.Small" />
                            </span>
                            <span class="platform-community-board-copy">
                                <strong>@board</strong>
                                <small>@ResolveCommunityBoardDescription(board)</small>
                            </span>
                            <span class="platform-community-board-count">@GetCommunityBoardPostCount(board)</span>
                        </button>
                    }
                </div>
            </section>

        }

        <MudGrid Class="@CommunityGridClass">
            <MudItem xs="12">
                <MudStack Spacing="2">
                    @if (!isLoading)
                    {
                        <PlatformCommunityPostList BoardName="@selectedBoardFilter"
                                                   FilterOptions="@ForumListFilterOptions"
                                                   SelectedFilter="@selectedForumListFilter"
                                                   SelectedFilterChanged="SelectForumListFilter"
                                                   ViewMode="@communityPostViewMode"
                                                   ViewModeChanged="SelectCommunityPostViewMode"
                                                   ComposeRequested="OpenCompose"
                                                   Posts="@VisiblePosts"
                                                   SeedPosts="@VisibleSeedPosts"
                                                   VisiblePostCount="@ForumVisiblePostCount"
                                                   SelectedPostId="@selectedForumPostId"
                                                   SelectedSeedPostTitle="@selectedForumSeedPostTitle"
                                                   PostSelected="ToggleForumPostAsync"
                                                   SeedPostSelected="ToggleForumSeedPost"
                                                   SearchText="@communityPostSearchText"
                                                   SearchTextChanged="HandleCommunityPostSearchChanged" />
                    }

                    @if (isLoading)
                    {
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">커뮤니티 글을 불러오는 중입니다.</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    @if (!isLoading && VisiblePosts.Count > 0)
                    {
                        @foreach (var post in VisiblePosts)
                        {
                            @if (IsForumPostSelected(post))
                            {
                                var commentForm = GetCommentForm(post.Id);
                                var isReportPost = IsReportPost(post);

                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 platform-community-post platform-community-post--expanded">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@(post.IsSystemGenerated ? Icons.Material.Filled.Verified : Icons.Material.Filled.Forum)" Color="@(post.IsSystemGenerated ? Color.Success : Color.Primary)" />
                                            <MudText Typo="Typo.subtitle1">@post.Title</MudText>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                            @if (post.IsOperatorPinned)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">운영 고정</MudChip>
                                            }
                                            else if (post.IsTrending)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">활동 글</MudChip>
                                            }
                                             @if (post.IsSystemGenerated)
                                             {
                                                 <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">자동 성립 기록</MudChip>
                                             }
                                             @if (post.IsCommunityMomentumPromoted)
                                             {
                                                 <MudChip T="string"
                                                          Size="Size.Small"
                                                          Color="Color.Warning"
                                                          Variant="Variant.Outlined"
                                                          Icon="@Icons.Material.Filled.Hub">
                                                     @CommunityMomentumLabel(post.CommunityMomentumCode)
                                                 </MudChip>
                                             }
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@post.Category</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@post.WorkflowTag</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@post.RoleTag</MudChip>
                                            @if (isReportPost)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">신고 게시판</MudChip>
                                            }
                                        </MudStack>
                                     </MudStack>

                                     @if (post.SalesOffer is not null)
                                     {
                                         <PlatformCommunitySalesOfferPanel Post="@post"
                                                                           InquiryRequested="@(async (string message) => await BeginSalesInquiryAsync(post, message))" />
                                     }

                                     <CommunityPostTranslationContent @key="post.Id"
                                                                      Post="@post"
                                                                      IsReportPost="@isReportPost" />

                                     @if (post.IsCommunityMomentumPromoted
                                          && !string.IsNullOrWhiteSpace(post.CommunityMomentumMessage))
                                     {
                                         <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Hub">
                                             @post.CommunityMomentumMessage
                                         </MudAlert>
                                     }

                                     @if (postOpportunities.TryGetValue(post.Id, out var postOpportunity))
                                    {
                                        var participation = postOpportunity.Participation;
                                        <CommunityActionJourneySummary Journey="@postOpportunity.Journey" />
                                        <section class="platform-community-participation" aria-label="게시글 참여 관심 모집">
                                            <header>
                                                <div>
                                                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                                                    <strong>@participation.Title</strong>
                                                </div>
                                                @if (participation.ParticipantCount > 0)
                                                {
                                                    <span>@($"{participation.ParticipantCount:N0}명 관심")</span>
                                                }
                                            </header>
                                            <p>@participation.Summary</p>

                                            @if (participation.CanJoin && participation.InterestVoteId.HasValue)
                                            {
                                                <div class="platform-community-participation-roles" role="group" aria-label="가능한 참여 역할">
                                                    @foreach (var role in participation.RoleOptions)
                                                    {
                                                        <button type="button"
                                                                class="@BuildParticipationRoleClass(post.Id, role.OptionId)"
                                                                title="@role.Summary"
                                                                aria-pressed="@IsParticipationRoleSelected(post.Id, role.OptionId)"
                                                                disabled="@(IsPostParticipationPending(post.Id) || string.IsNullOrWhiteSpace(role.OptionId))"
                                                                @onclick="@(async () => await ToggleParticipationRoleAsync(post, role))">
                                                            <span>@role.Label</span>
                                                            @if (role.InterestCount > 0)
                                                            {
                                                                <b>@role.InterestCount</b>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (participation.CanStart)
                                            {
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.GroupAdd"
                                                           Disabled="@IsPostParticipationPending(post.Id)"
                                                           OnClick="@(async () => await StartPostParticipationAsync(post))">
                                                    비구속적 관심 모으기
                                                </MudButton>
                                            }
                                            else if (participation.StateCode != CommunityPostParticipationStateCodes.ProvisionalLedgerCreated)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">이 게시글의 관심 모집은 마감되었습니다.</MudText>
                                            }

                                            @if (participation.CanPromoteToProvisionalLedger && participation.InterestVoteId.HasValue)
                                            {
                                                <div class="platform-community-provisional-actions">
                                                    <MudButton Variant="Variant.Filled"
                                                               Color="Color.Primary"
                                                               Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.Description"
                                                               Disabled="@IsPostParticipationPending(post.Id)"
                                                               OnClick="@(async () => await PromotePostParticipationAsync(post, CommunityCollectiveIntentTypeCodes.GroupPurchase))">
                                                        공동구매 가원장
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Outlined"
                                                               Color="Color.Info"
                                                               Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.Public"
                                                               Disabled="@IsPostParticipationPending(post.Id)"
                                                               OnClick="@(async () => await PromotePostParticipationAsync(post, CommunityCollectiveIntentTypeCodes.GroupImportCandidate))">
                                                        공동수입 검토 가원장
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Outlined"
                                                               Color="Color.Secondary"
                                                               Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.Public"
                                                               Disabled="@IsPostParticipationPending(post.Id)"
                                                               OnClick="@(async () => await PromotePostParticipationAsync(post, CommunityCollectiveIntentTypeCodes.GroupExportCandidate))">
                                                        공동수출 검토 가원장
                                                    </MudButton>
                                                </div>
                                            }
                                            else if (participation.StateCode == CommunityPostParticipationStateCodes.ProvisionalLedgerCreated)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Description">
                                                    비구속적 가원장 생성됨
                                                </MudChip>
                                            }

                                            @if (participation.PartyFormation.IsAvailable)
                                            {
                                                var formation = participation.PartyFormation;
                                                <section class="platform-community-party-formation" aria-label="거래 참여팀 역할 구성">
                                                    <header>
                                                        <div>
                                                            <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" />
                                                            <strong>거래 참여팀</strong>
                                                        </div>
                                                        <span>@($"필수 역할 {formation.RepresentedRequiredRoleSlotCount}/{formation.RequiredRoleSlotCount}")</span>
                                                    </header>
                                                    <div class="platform-community-party-route">
                                                        <span>@TradeDirectionLabel(formation.TradeDirectionCode)</span>
                                                        @if (!string.IsNullOrWhiteSpace(formation.OriginCountryCode)
                                                             || !string.IsNullOrWhiteSpace(formation.DestinationCountryCode))
                                                        {
                                                            <span>@($"{CountryCodeLabel(formation.OriginCountryCode)} → {CountryCodeLabel(formation.DestinationCountryCode)}")</span>
                                                        }
                                                        @if (formation.TransportModeCodes.Count > 0)
                                                        {
                                                            <span>@string.Join(" · ", formation.TransportModeCodes.Select(TransportModeLabel))</span>
                                                        }
                                                    </div>
                                                    <div class="platform-community-party-slots">
                                                        @foreach (var slot in formation.RoleSlots)
                                                        {
                                                            var opening = participation.ProfessionalParticipation.RoleOpenings.FirstOrDefault(candidate =>
                                                                string.Equals(candidate.RoleCode, slot.RoleCode, StringComparison.OrdinalIgnoreCase));
                                                            <div class="@BuildPartySlotClass(slot)">
                                                                <MudIcon Icon="@PartySlotIcon(slot)" Size="Size.Small" />
                                                                <div>
                                                                    <strong>@slot.Label</strong>
                                                                    <small>@slot.Summary</small>
                                                                </div>
                                                                <div class="platform-community-party-slot-meta">
                                                                    <span>@(slot.IsRequired ? "필수" : slot.IsRecommended ? "권장" : "선택")</span>
                                                                    @if (slot.ConfirmedParticipantCount > 0)
                                                                    {
                                                                        <b>@($"확인 {slot.ConfirmedParticipantCount}")</b>
                                                                    }
                                                                    else if (slot.InterestCount > 0)
                                                                    {
                                                                        <b>@($"관심 {slot.InterestCount}")</b>
                                                                    }
                                                                    @if (slot.ExternalCredentialVerificationRequired && !slot.ExternalCredentialVerified)
                                                                    {
                                                                        <MudTooltip Text="관할기관 면허·등록 또는 운송 권한을 별도로 확인해야 합니다.">
                                                                            <MudIcon Icon="@Icons.Material.Filled.GppMaybe"
                                                                                     Size="Size.Small"
                                                                                     Color="Color.Warning"
                                                                                     aria-label="외부 자격 확인 필요" />
                                                                        </MudTooltip>
                                                                    }
                                                                    @if (CommunityPostPartyRoleCodes.IsCommercialParty(slot.RoleCode))
                                                                    {
                                                                        <MudTooltip Text="가원장 검토 단계에서 당사자 역할을 명시적으로 수락합니다. 주문·계약·결제 또는 법적 책임은 확정되지 않습니다.">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.HowToReg"
                                                                                           Size="Size.Small"
                                                                                           Color="Color.Primary"
                                                                                           Disabled="@IsPostParticipationPending(post.Id)"
                                                                                           aria-label="@($"{slot.Label} 역할을 비구속적으로 수락")"
                                                                                           OnClick="@(async () => await JoinPostPartyRoleAsync(post, slot.RoleCode))" />
                                                                        </MudTooltip>
                                                                    }
                                                                    else if (opening is not null)
                                                                    {
                                                                        <MudTooltip Text="플랫폼 프로필에서 역할이 확인된 계정만 참여할 수 있으며 외부 면허·등록은 별도 확인 대상입니다.">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.PersonAdd"
                                                                                           Size="Size.Small"
                                                                                           Color="Color.Primary"
                                                                                           Disabled="@IsPostParticipationPending(post.Id)"
                                                                                           aria-label="@($"{slot.Label} 역할로 자발적 참여")"
                                                                                           OnClick="@(async () => await JoinPostProfessionalRoleAsync(post, slot.RoleCode))" />
                                                                        </MudTooltip>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <p class="platform-community-party-readiness">@formation.ReadinessMessage</p>
                                                </section>
                                            }

                                            <small>관심만 표시하며 주문·계약·배차·운송 주선은 시작되지 않습니다.</small>
                                        </section>
                                    }

                                    @if (post.IsSystemGenerated && !string.IsNullOrWhiteSpace(post.PrivacyNotice))
                                    {
                                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.PrivacyTip">
                                            <strong>비식별 공개본</strong><br />
                                            @post.PrivacyNotice
                                        </MudAlert>
                                    }

                                    @if (post.원장Context is { } 원장Context)
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                                                        <strong>@(post.IsSystemGenerated ? "완료된 공개 절차" : "현재 원장") · @원장Context.원장템플릿명</strong>
                                                    </MudStack>
                                                    <MudStack Row="true" Spacing="1">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@원장Context.상태</MudChip>
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="@(원장Context.기능활성화여부 ? Color.Success : Color.Warning)"
                                                                 Variant="Variant.Outlined">
                                                            @(원장Context.기능활성화여부 ? "업무 기능 사용" : "업무 기능 준비 중")
                                                        </MudChip>
                                                    </MudStack>
                                                </MudStack>
                                                <MudText Typo="Typo.body2">@원장Context.제목</MudText>
                                                @if (!string.IsNullOrWhiteSpace(원장Context.현재단계))
                                                {
                                                    <MudText Typo="Typo.caption">현재 단계 · @원장Context.현재단계</MudText>
                                                }
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @원장Context.처리체계명 · @(post.IsSystemGenerated ? "개인정보를 제거한 절차 구조" : 원장Context.원장Id)
                                                </MudText>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                                    @foreach (var 행동 in 원장Context.가능한행동목록.Take(5))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@행동</MudChip>
                                                    }
                                                </MudStack>
                                                @if (원장Context.참여요청필요여부)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Warning">원장 상세와 업무 처리는 참여 승인 후 열립니다.</MudText>
                                                }
                                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                    @if (원장Context.다이어그램 is not null)
                                                    {
                                                        <MudButton Variant="Variant.Outlined"
                                                                   Color="Color.Info"
                                                                   Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                                                   OnClick="@(() => OpenSharedLedgerDiagram(원장Context))">
                                                            다이어그램 같이 보기
                                                        </MudButton>
                                                    }
                                                    @if (post.IsSystemGenerated)
                                                    {
                                                        <MudButton Variant="Variant.Filled"
                                                                   Color="Color.Success"
                                                                   Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.AddTask"
                                                                   OnClick="@(() => StartFromCompletionCase(원장Context))">
                                                            이 절차로 시작하기
                                                        </MudButton>
                                                    }
                                                    @if (원장Context.재공유허용여부)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">재공유 허용</MudChip>
                                                    }
                                                    @if (원장Context.재사용허용여부)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">재사용 허용</MudChip>
                                                    }
                                                    @if (!원장Context.상세조회가능여부 && 원장Context.재사용허용여부)
                                                    {
                                                        <MudButton Variant="Variant.Filled"
                                                                   Color="Color.Primary"
                                                                   Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                                                   Disabled="@isSharedLedgerReusing"
                                                                   OnClick="@(() => ReuseSharedLedgerAsync(원장Context))">
                                                            내 원장으로 가져오기
                                                        </MudButton>
                                                    }
                                                </MudStack>
                                            </MudStack>
                                        </MudAlert>
                                    }

                                    @if (IsDiagramBoardPost(post.Category, post.Body))
                                    {
                                        var diagramNodes = BuildCommunityDiagramPreviewNodes(post.Body, post.WorkflowTag);
                                        <div class="platform-community-readme-card" aria-label="게시글 다이어그램 미리보기">
                                            <div class="platform-community-readme-header">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                                    <strong>README.md</strong>
                                                </MudStack>
                                                <span>업무 흐름 다이어그램</span>
                                            </div>
                                            <div class="platform-community-mini-diagram">
                                                @for (var diagramIndex = 0; diagramIndex < diagramNodes.Count; diagramIndex++)
                                                {
                                                    <span class="platform-community-diagram-node">@diagramNodes[diagramIndex]</span>
                                                    @if (diagramIndex < diagramNodes.Count - 1)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (isReportPost)
                                    {
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                            관찰자에게는 신고자와 피신고자가 익명으로 표시됩니다. 당사자와 운영자는 별도 권한 확인 후 필요한 범위의 정보만 확인합니다.
                                        </MudAlert>
                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                <MudPaper Elevation="0" Outlined="true" Class="pa-3 platform-community-report-subject">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">신고한 자</MudText>
                                                    <MudText Typo="Typo.subtitle2">@ReportReporterLabel(post)</MudText>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudPaper Elevation="0" Outlined="true" Class="pa-3 platform-community-report-subject">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">신고받는 자</MudText>
                                                    <MudText Typo="Typo.subtitle2">@ReportReportedLabel(post)</MudText>
                                                </MudPaper>
                                            </MudItem>
                                        </MudGrid>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(post.SharedLinkUrl))
                                    {
                                        @if (IsYouTubeSharedLink(post.SharedLinkUrl))
                                        {
                                            <div class="platform-community-lecture-share-card">
                                                <span class="platform-community-lecture-share-icon">
                                                    <MudIcon Icon="@(IsFoodYouTubeSharedPost(post) ? Icons.Material.Filled.Restaurant : Icons.Material.Filled.PlayCircle)" Size="Size.Medium" />
                                                </span>
                                                <span class="platform-community-lecture-share-copy">
                                                    <small>@ResolveSharedVideoEyebrow(post)</small>
                                                    <strong>@ResolveSharedVideoTitle(post.Title)</strong>
                                                </span>
                                                <MudButton Href="@post.SharedLinkUrl"
                                                           Target="_blank"
                                                           Rel="noopener noreferrer"
                                                           Variant="Variant.Filled"
                                                           Color="Color.Info"
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.PlayCircleOutline">
                                                    YouTube에서 보기
                                                </MudButton>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudButton Href="@post.SharedLinkUrl"
                                                       Target="_blank"
                                                       Rel="noopener noreferrer"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Link">
                                                공유 링크 열기
                                            </MudButton>
                                        }
                                    }

                                    @if (post.Attachments.Count > 0)
                                    {
                                        <div class="platform-community-attachments">
                                            @foreach (var attachment in post.Attachments)
                                            {
                                                var attachmentCommentForm = GetAttachmentCommentForm(attachment.Id);

                                                <div class="platform-community-attachment-item">
                                                    <a href="@attachment.Url" target="_blank" rel="noopener noreferrer">
                                                        <img src="@attachment.Url" alt="@attachment.OriginalFileName" />
                                                    </a>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Image comments @attachment.CommentCount</MudText>
                                                    @if (attachment.RecentComments.Count > 0)
                                                    {
                                                        <MudStack Spacing="1" Class="platform-community-comments">
                                                            @foreach (var comment in attachment.RecentComments)
                                                            {
                                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                                                    <HongdalCommunityRoleProfileBadge DisplayName="@DisplayCommentNickname(post, comment.Nickname)"
                                                                                                      ContextKey="@post.AppKey"
                                                                                                      Category="@post.Category"
                                                                                                      IsMasked="@IsReportPost(post)"
                                                                                                      Compact="true" />
                                                                    <MudText Typo="Typo.caption">@comment.Body</MudText>
                                                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => ReportAttachmentCommentAsync(comment))">
                                                                        Report
                                                                    </MudButton>
                                                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAttachmentCommentAsync(attachment, comment))">
                                                                        Delete
                                                                    </MudButton>
                                                                </MudStack>
                                                            }
                                                        </MudStack>
                                                    }
                                                    <MudStack Spacing="1" Class="platform-community-image-comment-form">
                                                        <MudTextField T="string" Placeholder="Nickname" @bind-Value="attachmentCommentForm.Nickname" MaxLength="40" Margin="Margin.Dense" />
                                                        <MudTextField T="string" Placeholder="Password" @bind-Value="attachmentCommentForm.Password" InputType="InputType.Password" MaxLength="100" Margin="Margin.Dense" />
                                                        <MudTextField T="string" Placeholder="Image comment" @bind-Value="attachmentCommentForm.Body" MaxLength="1000" Margin="Margin.Dense" />
                                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="@(() => SaveAttachmentCommentAsync(attachment))">
                                                            Comment
                                                        </MudButton>
                                                    </MudStack>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (post.RecentComments.Count > 0 && IsPostCommentsExpanded(post.Id))
                                    {
                                        <MudStack Spacing="1" Class="platform-community-comments">
                                            @foreach (var comment in post.RecentComments)
                                            {
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                                    <HongdalCommunityRoleProfileBadge DisplayName="@DisplayCommentNickname(post, comment.Nickname)"
                                                                                      ContextKey="@post.AppKey"
                                                                                      Category="@post.Category"
                                                                                      IsMasked="@IsReportPost(post)"
                                                                                      Compact="true" />
                                                    <MudText Typo="Typo.caption">@comment.Body</MudText>
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => ReportCommentAsync(comment))">
                                                        Report
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteCommentAsync(post, comment))">
                                                        Delete
                                                    </MudButton>
                                                </MudStack>
                                            }
                                        </MudStack>
                                    }

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="platform-community-meta">
                                            <HongdalCommunityRoleProfileBadge DisplayName="@DisplayPostNickname(post)"
                                                                              ContextKey="@post.AppKey"
                                                                              Category="@post.Category"
                                                                              IsMasked="@IsReportPost(post)"
                                                                              Compact="true" />
                                            @if (HasPublicAuthorCountry(post))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Public">
                                                    활동 국가 @post.AuthorDisplayCountryCode · @post.AuthorDisplayCountryName
                                                </MudChip>
                                            }
                                            <MudText Typo="Typo.caption">추천 @post.RecommendationCount</MudText>
                                            <MudText Typo="Typo.caption">댓글 @post.CommentCount</MudText>
                                            <MudText Typo="Typo.caption">· @FormatDate(post.CreatedAtUtc)</MudText>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ThumbUp" OnClick="@(() => RecommendPostAsync(post))">
                                                추천
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.ChatBubbleOutline" OnClick="@(() => TogglePostComments(post.Id))">
                                                댓글 @post.CommentCount
                                            </MudButton>
                                            @if (CanManageCommunityPosts)
                                            {
                                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.PushPin" OnClick="@(() => ToggleOperatorPinAsync(post))">
                                                    @(post.IsOperatorPinned ? "고정 해제" : "상단 고정")
                                                </MudButton>
                                            }
                                            @if (!post.IsSystemGenerated)
                                            {
                                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => BeginEdit(post))">
                                                    수정
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    @if (IsPostCommentsExpanded(post.Id))
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="platform-community-comment-form">
                                            <MudTextField T="string" Placeholder="닉네임" @bind-Value="commentForm.Nickname" MaxLength="40" Margin="Margin.Dense" />
                                            <MudTextField T="string" Placeholder="비밀번호" @bind-Value="commentForm.Password" InputType="InputType.Password" MaxLength="100" Margin="Margin.Dense" />
                                            <MudTextField T="string" Placeholder="댓글" @bind-Value="commentForm.Body" MaxLength="1000" Margin="Margin.Dense" />
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="@(() => SaveCommentAsync(post))">
                                                댓글 등록
                                            </MudButton>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    }
                    }

                    @if (!isLoading && VisiblePosts.Count == 0 && VisibleSeedPosts.Count == 0)
                    {
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">선택한 게시판에 아직 글이 없습니다. 첫 글을 남겨 보세요.</MudText>
                        </MudPaper>
                    }

                    @if (VisibleSeedPosts.Count > 0)
                    {
                        @foreach (var post in VisibleSeedPosts)
                        {
                            @if (IsForumSeedPostSelected(post))
                            {
                            <MudPaper Elevation="0" Class="pa-4 platform-community-post platform-community-seed-post platform-community-post--expanded">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudAvatar Color="@post.Color" Variant="Variant.Filled" Size="Size.Small">
                                                <MudIcon Icon="@post.Icon" Size="Size.Small" />
                                            </MudAvatar>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle2">@post.Author</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@post.Category · @post.Meta</MudText>
                                            </MudStack>
                                        </MudStack>
                                        <MudChip T="string" Size="Size.Small" Color="@post.Color" Variant="Variant.Outlined">@post.Category</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@post.Title</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="platform-community-post-body">@post.Body</MudText>

                                    @if (post.HasDiagramPreview)
                                    {
                                        var diagramNodes = BuildCommunityDiagramPreviewNodes(post.Body, post.Category);
                                        <div class="platform-community-readme-card" aria-label="README 다이어그램 예시">
                                            <div class="platform-community-readme-header">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                                    <strong>README.md</strong>
                                                </MudStack>
                                                <span>게시판에서 바로 보는 다이어그램</span>
                                            </div>
                                            <div class="platform-community-mini-diagram">
                                                @for (var diagramIndex = 0; diagramIndex < diagramNodes.Count; diagramIndex++)
                                                {
                                                    <span class="platform-community-diagram-node">@diagramNodes[diagramIndex]</span>
                                                    @if (diagramIndex < diagramNodes.Count - 1)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="platform-community-meta">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                            <MudText Typo="Typo.caption">@post.RecommendationCount</MudText>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" />
                                            <MudText Typo="Typo.caption">@post.CommentCount</MudText>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                            <MudText Typo="Typo.caption">@post.Meta</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                            }
                        }
                    }

                    @if (CommunityModeContent is not null &&
                         string.Equals(selectedBoardFilter, "전체", StringComparison.OrdinalIgnoreCase))
                    {
                        <section class="platform-community-app-notice" aria-label="앱 공지">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.subtitle2">앱 공지</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">PINNED</MudChip>
                            </MudStack>
                            @CommunityModeContent
                        </section>
                    }
                </MudStack>
            </MudItem>

            <MudItem xs="12" Class="platform-community-secondary-flow">
                <MudStack Spacing="2">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">개설된 게시판</MudText>
                            @if (isBoardLoading && approvedBoards.Count == 0)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">게시판 목록을 불러오는 중입니다.</MudText>
                                </MudStack>
                            }
                            else if (approvedBoards.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">아직 승인된 추가 게시판이 없습니다.</MudText>
                            }
                            else
                            {
                                <MudStack Spacing="1">
                                    @foreach (var board in approvedBoards)
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Forum"
                                                   OnClick="@(() => SelectBoard(board.Title))">
                                            <MudStack Spacing="0" AlignItems="AlignItems.Start">
                                                <MudText Typo="Typo.body2">@board.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@board.Description</MudText>
                                            </MudStack>
                                        </MudButton>
                                    }
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">게시판 개설 신청</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                사용자가 필요한 게시판을 신청하면, 운영자가 승인한 뒤 모든 사용자에게 보입니다.
                            </MudText>
                            <MudTextField T="string" Label="게시판 이름" @bind-Value="boardForm.Title" MaxLength="60" />
                            <MudTextField T="string" Label="신청자" @bind-Value="boardForm.RequestedBy" MaxLength="40" />
                            <MudTextField T="string" Label="게시판 설명" @bind-Value="boardForm.Description" MaxLength="500" />
                            <MudTextField T="string" Label="개설 이유" @bind-Value="boardForm.RequestReason" Lines="3" MaxLength="1000" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@isSavingBoardRequest"
                                       StartIcon="@Icons.Material.Filled.AddCircleOutline"
                                       OnClick="SaveBoardRequestAsync">
                                개설 신청
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @if (CanManageCommunityPosts)
                    {
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">게시판 승인 대기</MudText>
                                @if (isBoardLoading && pendingBoardRequests.Count == 0)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">승인 대기 목록을 확인하는 중입니다.</MudText>
                                    </MudStack>
                                }
                                else if (pendingBoardRequests.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">승인 대기 중인 게시판 신청이 없습니다.</MudText>
                                }
                                else
                                {
                                    @foreach (var board in pendingBoardRequests)
                                    {
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.subtitle2">@board.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">신청자: @board.RequestedBy · @FormatDate(board.CreatedAtUtc)</MudText>
                                                <MudText Typo="Typo.body2">@board.RequestReason</MudText>
                                                <MudTextField T="string" Label="운영 메모" @bind-Value="boardReviewMemo[board.Id]" MaxLength="1000" Margin="Margin.Dense" />
                                                <MudStack Row="true" Spacing="1">
                                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@(() => ReviewBoardAsync(board, true))">
                                                        승인
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => ReviewBoardAsync(board, false))">
                                                        반려
                                                    </MudButton>
                                                </MudStack>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                }
                            </MudStack>
                        </MudPaper>
                    }

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1">통합 업무 허브</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    커뮤니티에서 시작한 일을 원장 유형과 처리 체계 기준으로 정리합니다.
                                </MudText>
                            </MudStack>
                            <MudGrid>
                                @foreach (var workspace in UnifiedWorkspaces)
                                {
                                    <MudItem xs="12" sm="6">
                                        <div class="platform-unified-workspace">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                                    <MudIcon Icon="@workspace.Icon" Color="@workspace.Color" />
                                                    <MudChip T="string" Size="Size.Small" Color="@workspace.Color" Variant="Variant.Outlined">@원장처리체계표시명(workspace.OperatingSystemName)</MudChip>
                                                </MudStack>
                                                <MudText Typo="Typo.subtitle2">@workspace.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@workspace.Description</MudText>
                                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                    <MudButton Variant="Variant.Outlined"
                                                               Size="Size.Small"
                                                               Color="@workspace.Color"
                                                               StartIcon="@Icons.Material.Filled.Assignment"
                                                               OnClick="@(() => PrepareLedgerCommunityDraft(workspace.LedgerTemplateKey))">
                                                        원장 초안
                                                    </MudButton>
                                                    @if (!string.IsNullOrWhiteSpace(workspace.EntryHref))
                                                    {
                                                        <MudButton Href="@workspace.EntryHref"
                                                                   Variant="Variant.Text"
                                                                   Size="Size.Small"
                                                                   Color="@workspace.Color"
                                                                   EndIcon="@Icons.Material.Filled.ChevronRight">
                                                            열기
                                                        </MudButton>
                                                    }
                                                </MudStack>
                                            </MudStack>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 platform-ledger-draft-paper">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">생활 원장 초안</MudText>
                            <MudStack Spacing="2" Class="platform-wish-intake">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">원함 먼저 묻기</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        바로 원장을 쓰기 전에 사용자가 원하는 일과 조건을 적으면, 홍달이 어떤 원장으로 정리할 수 있는지 대략 안내합니다.
                                    </MudText>
                                </MudStack>
                                <MudTextField T="string"
                                              Label="무엇을 원하나요?"
                                              Placeholder="예: 동네에서 같이 장을 보고 포장한 뒤 가까운 기사님에게 전달하고 싶어요."
                                              @bind-Value="원함입력"
                                              Lines="3"
                                              Immediate="true"
                                              Variant="Variant.Outlined" />
                                <MudTextField T="string"
                                              Label="참여자, 장소, 시간, 조건"
                                              Placeholder="예: 주문자, 피킹할 사람, 포장 완료 시간, 전달 장소, 결제 표시나 사진 증빙이 필요한지"
                                              @bind-Value="원함조건입력"
                                              Lines="2"
                                              Immediate="true"
                                              Variant="Variant.Outlined" />
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Psychology"
                                               Disabled="@(!원함입력됨)"
                                               OnClick="원함분석하기">
                                        홍달이 도울 수 있는 범위 보기
                                    </MudButton>
                                    @if (원함분석결과 is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@원장화판정Color" Variant="Variant.Filled">@원장화판정</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@원함추천템플릿.DisplayName</MudChip>
                                    }
                                </MudStack>
                            </MudStack>
                            @{
                                var contextTemplate = SelectedLedgerTemplate;
                                var contextDiagram = 선택원장블록흐름도;
                                var 컨텍스트흐름노드목록 = 정렬된원장블록노드목록가져오기(contextDiagram);
                                var 컨텍스트다이어그램연결선목록 = BuildDiagramEdges(컨텍스트흐름노드목록);
                                var 컨텍스트업무공간 = 현재원장업무공간해결(contextTemplate);
                                var 컨텍스트보완항목목록 = 현재원장컨텍스트보완항목생성(contextTemplate, 컨텍스트흐름노드목록, 컨텍스트다이어그램연결선목록);
                                var 선택컨텍스트원장 = 선택현재원장;
                                var activeWorkflowModeLabel = ResolveDiagramWorkflowModeLabel(DiagramPalette.WorkflowModeKey);
                            }
                            <div id="community-current-ledger" class="platform-ledger-context-panel" aria-label="현재 원장 컨텍스트">
                                <div class="platform-current-ledger-picker">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="1">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle2">내 원장 불러오기</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">기존 원장을 선택하면 원함, 원장 유형, 블록 입력, 다이어그램 연결이 현재 컨텍스트로 로드됩니다.</MudText>
                                        </MudStack>
                                        @if (선택컨텍스트원장 is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@선택컨텍스트원장.StateLabel</MudChip>
                                        }
                                    </MudStack>
                                    <div class="platform-current-ledger-list">
                                        @foreach (var ledger in 현재원장스냅샷목록)
                                        {
                                            <button type="button"
                                                    class="@현재원장스냅샷클래스생성(ledger)"
                                                    title="@ledger.Summary"
                                                    @onclick="@(() => 현재원장컨텍스트불러오기(ledger.Id))">
                                                <span class="platform-current-ledger-title">@ledger.Title</span>
                                                <span class="platform-current-ledger-meta">@($"{CommunityLedgerTemplateCatalog.Find(ledger.TemplateKey).DisplayName} · {ledger.StateLabel}")</span>
                                                <span class="platform-current-ledger-meta">@ledger.LastUpdatedLabel</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle2">현재 원장 컨텍스트</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@현재원장컨텍스트요약생성(contextTemplate)</MudText>
                                    </MudStack>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @if (선택컨텍스트원장 is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@선택컨텍스트원장.Title</MudChip>
                                        }
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">@activeWorkflowModeLabel</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="@원장화판정Color" Variant="Variant.Filled">@원장화판정</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@원장처리체계표시명(contextTemplate.TargetOperatingSystemName)</MudChip>
                                    </MudStack>
                                </MudStack>

                                <div class="platform-ledger-context-grid">
                                    <div class="platform-ledger-context-cell">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">원함</MudText>
                                        <MudText Typo="Typo.subtitle2">@현재원장원함제목생성(contextTemplate)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@현재원장원함상세생성(contextTemplate)</MudText>
                                    </div>
                                    <div class="platform-ledger-context-cell">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">추천 원장</MudText>
                                        <MudText Typo="Typo.subtitle2">@contextTemplate.DisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@contextTemplate.Summary</MudText>
                                    </div>
                                    <div class="platform-ledger-context-cell">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">다이어그램</MudText>
                                        <MudText Typo="Typo.subtitle2">@($"{컨텍스트흐름노드목록.Count}개 블록 · {컨텍스트다이어그램연결선목록.Count}개 연결")</MudText>
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-1">
                                            @foreach (var gap in 컨텍스트보완항목목록)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@gap</MudChip>
                                            }
                                        </MudStack>
                                    </div>
                                    <div class="platform-ledger-context-cell">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">관련 메뉴</MudText>
                                        @if (컨텍스트업무공간 is not null)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@컨텍스트업무공간.Icon" Color="@컨텍스트업무공간.Color" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">@컨텍스트업무공간.Title</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@컨텍스트업무공간.Description</MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.subtitle2">커뮤니티 원장</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">관련 업무 메뉴를 원장 정보로 더 연결할 수 있습니다.</MudText>
                                        }
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@($"{contextTemplate.ProcessingSurfaces.Count}개 API/업무 후보")</MudText>
                                    </div>
                                </div>

                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.AccountTree"
                                               OnClick="현재원장다이어그램열기">
                                        다이어그램으로 보기
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               OnClick="PrepareLedgerCommunityDraft">
                                        커뮤니티 초안
                                    </MudButton>
                                    @if (컨텍스트업무공간 is not null && !string.IsNullOrWhiteSpace(컨텍스트업무공간.EntryHref))
                                    {
                                        <MudButton Href="@컨텍스트업무공간.EntryHref"
                                                   Variant="Variant.Text"
                                                   Color="@컨텍스트업무공간.Color"
                                                   Size="Size.Small"
                                                   EndIcon="@Icons.Material.Filled.ChevronRight">
                                            관련 업무 열기
                                        </MudButton>
                                    }
                                </MudStack>
                            </div>
                            <MudDivider />
                            <MudSelect T="string" Label="원장 유형" @bind-Value="selectedLedgerTemplateKey" Variant="Variant.Outlined">
                                @foreach (var template in LedgerTemplates)
                                {
                                    <MudSelectItem Value="@template.Key">@template.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                            @{
                                var blockFlowDiagram = 선택원장블록흐름도;
                                var flowNodes = 정렬된원장블록노드목록가져오기(blockFlowDiagram);
                                var 선택흐름노드 = 선택원장블록노드;
                                var 선택흐름노드관련블록목록 = 선택흐름노드 is null
                                    ? Array.Empty<CommunityLedgerBlockResponse>()
                                    : 흐름노드관련블록해결(선택흐름노드);
                                var 선택흐름노드처리표면목록 = 선택흐름노드 is null
                                    ? Array.Empty<CommunityLedgerProcessingSurfaceResponse>()
                                    : 흐름노드처리표면해결(선택흐름노드);
                                var diagramEdges = BuildDiagramEdges(flowNodes);
                                var selectedDiagramEdge = diagramEdges.FirstOrDefault(edge =>
                                    string.Equals(edge.Id, selectedDiagramEdgeId, StringComparison.OrdinalIgnoreCase));
                            }
                            <div class="platform-ledger-diagram-workbench">
                                <PlatformCommunityDiagramToolbar Canvas="@DiagramCanvas"
                                                                         Layers="@다이어그램레이어정의s"
                                                                         FormNodes="@DiagramFormPaletteBlocks"
                                                                         CanMoveBackward="@CanMove선택원장블록노드(-1)"
                                                                         CanMoveForward="@CanMove선택원장블록노드(1)"
                                                                         CanBringToFront="@CanBringSelectedDiagramNodeToFront()"
                                                                         CanSendToBack="@CanSendSelectedDiagramNodeToBack()"
                                                                         CanStartConnection="@(선택흐름노드 is not null && CanStartDiagramConnection(선택흐름노드))"
                                                                         OnMoveBackward="@(() => Move선택원장블록노드(-1))"
                                                                         OnMoveForward="@(() => Move선택원장블록노드(1))"
                                                                         OnBringToFront="BringSelectedDiagramNodeToFront"
                                                                         OnSendToBack="SendSelectedDiagramNodeToBack"
                                                                         OnFormNodeSelected="AddPaletteBlockToCanvas"
                                                                         OnStartConnection="StartDiagramEdgeFromSelectedNode"
                                                                         OnReset="원장블록흐름도배치초기화"
                                                                         OnCancelConnection="CancelDiagramEdgeCreation" />
                                <div class="@BuildDiagramCanvasClass("platform-ledger-flow-diagram platform-ledger-flow-diagram--canvas")" style="@BuildDiagramCanvasStyle(flowNodes)">
                                    <svg class="platform-ledger-edge-layer"
                                         viewBox="@BuildDiagramViewBox(flowNodes)"
                                         preserveAspectRatio="none"
                                         aria-hidden="true">
                                        <defs>
                                            <marker id="platform-ledger-edge-arrow"
                                                    viewBox="0 0 10 10"
                                                    refX="8"
                                                    refY="5"
                                                    markerWidth="7"
                                                    markerHeight="7"
                                                    orient="auto-start-reverse">
                                                <path d="M 0 0 L 10 5 L 0 10 z" />
                                            </marker>
                                        </defs>
                                        @foreach (var edge in diagramEdges)
                                        {
                                            var geometry = BuildDiagramEdgeGeometry(edge, flowNodes);
                                            if (geometry is not null)
                                            {
                                                <path class="platform-ledger-edge-hit-area"
                                                      d="@geometry.Path"
                                                      @onclick="@(() => SelectDiagramEdge(edge))"
                                                      @onclick:stopPropagation="true" />
                                                <path class="@BuildDiagramEdgePathClass(edge)"
                                                      d="@geometry.Path"
                                                      marker-end="url(#platform-ledger-edge-arrow)"
                                                      @onclick="@(() => SelectDiagramEdge(edge))"
                                                      @onclick:stopPropagation="true" />
                                            }
                                        }
                                    </svg>
                                    @foreach (var edge in diagramEdges)
                                    {
                                        var geometry = BuildDiagramEdgeGeometry(edge, flowNodes);
                                        if (geometry is not null)
                                        {
                                            <button type="button"
                                                    class="@BuildDiagramEdgeLabelClass(edge)"
                                                    style="@BuildDiagramEdgeLabelStyle(geometry)"
                                                    title="@edge.Label"
                                                    @onclick="@(() => SelectDiagramEdge(edge))">
                                                @edge.Label
                                            </button>
                                        }
                                    }
                                    @for (var i = 0; i < flowNodes.Count; i++)
                                    {
                                        var node = flowNodes[i];
                                        var nodeLayerBadges = 도형레이어배지목록생성(node, i, flowNodes);
                                        var nodeInputFormFields = 도형입력항목해결(node);
                                        var nodeSticker = 원장블록노드스티커해결(node);
                                        var nodeReadiness = 노드입력준비도해결(node, 원장블록처리상태해결(i, flowNodes));
                                        var nodePositionStyle = 원장블록노드스타일생성(i, flowNodes);
                                        <button type="button"
                                                class="@원장블록노드클래스생성(node, i, flowNodes)"
                                                style="@($"{nodePositionStyle} {BuildDiagramNodeStackStyle(node, flowNodes)} {BuildNodeReadinessStyle(nodeReadiness)}")"
                                                aria-pressed="@원장블록노드선택됨(node)"
                                                title="@node.Description"
                                                @onclick="@(() => 원장블록노드클릭처리(node))"
                                                @oncontextmenu="@((MouseEventArgs _) => 원장블록노드컨텍스트메뉴처리Async(node))"
                                                @oncontextmenu:preventDefault="true">
                                            @if (IsDiagramLayerVisible(DiagramLayerRole))
                                            {
                                                <span class="platform-ledger-flow-node-role">@흐름노드역할라벨해결(node)</span>
                                            }
                                            <span class="@(nodeSticker is null ? "platform-ledger-flow-node-icon" : "platform-ledger-flow-node-icon platform-ledger-flow-node-icon--sticker")">
                                                @if (nodeSticker is not null)
                                                {
                                                    <img class="platform-ledger-flow-node-sticker"
                                                         src="@nodeSticker.이미지Url"
                                                         alt="@nodeSticker.대체Text"
                                                         title="@nodeSticker.표시명" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@원장블록노드아이콘해결(node)" Color="@node.Color" />
                                                }
                                            </span>
                                            <span class="platform-ledger-flow-node-title">@node.Title</span>
                                            <span class="platform-ledger-flow-node-form-summary"
                                                  title="@도형입력요약제목생성(nodeInputFormFields)">
                                                @($"{nodeReadiness.Percent}% · {nodeReadiness.CountLabel}")
                                            </span>
                                            <span class="platform-ledger-flow-node-readiness" aria-label="@($"입력 준비도 {nodeReadiness.Percent}%")">
                                                <i></i>
                                            </span>
                                            @if (nodeLayerBadges.Count > 0)
                                            {
                                                <span class="platform-ledger-flow-node-layer-stack" aria-label="노드 레이어 신호">
                                                    @foreach (var badge in nodeLayerBadges)
                                                    {
                                                        <span class="@badge.CssClass" title="@badge.Description">
                                                            <MudIcon Icon="@badge.Icon" Size="Size.Small" />
                                                            <span>@badge.Label</span>
                                                        </span>
                                                    }
                                                </span>
                                            }
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Variant="@(원장블록노드선택됨(node) ? Variant.Filled : Variant.Outlined)"
                                                     Color="@(원장블록노드선택됨(node) ? Color.Success : Color.Secondary)"
                                                     Class="platform-ledger-flow-node-select-hint">
                                                @(원장블록노드선택됨(node) ? "선택됨" : "선택")
                                            </MudChip>
                                        </button>
                                    }
                                </div>
                                @if (selectedDiagramEdge is not null)
                                {
                                    <div class="platform-ledger-edge-editor">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                                            @($"{selectedDiagramEdge.FromTitle} -> {selectedDiagramEdge.ToTitle}")
                                        </MudChip>
                                        @if (selectedDiagramEdge.IsCustom)
                                        {
                                            <MudTextField T="string"
                                                          Value="@selectedDiagramEdge.Label"
                                                          ValueChanged="@((string value) => UpdateSelectedDiagramEdgeLabel(value))"
                                                          Placeholder="화살표 의미"
                                                          Immediate="true"
                                                          Variant="Variant.Outlined"
                                                          Class="platform-ledger-edge-label-input" />
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="DeleteSelectedDiagramEdge">
                                                연결 삭제
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">기본 연결</MudChip>
                                        }
                                    </div>
                                }
                                @if (선택흐름노드 is not null)
                                {
                                    <div class="platform-ledger-diagram-inspector">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@선택흐름노드.Color">@선택흐름노드.Title</MudChip>
                                        @foreach (var block in 선택흐름노드관련블록목록.Take(4))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@block.DisplayName</MudChip>
                                        }
                                        @foreach (var surface in 선택흐름노드처리표면목록.Take(3))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="@ResolveSurfaceStatusColor(surface)" Variant="Variant.Outlined" Class="platform-ledger-diagram-route-chip">
                                                @($"{ResolveSurfaceMethod(surface)} {BuildResolvedApiRoute(surface)}")
                                            </MudChip>
                                        }
                                    </div>
                                }
                            </div>
                            @if (SelectedLedgerTemplate.LedgerBlocks.Count > 0)
                            {
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">동적 원장 블록 입력</MudText>
                                    <MudGrid Spacing="2">
                                        @foreach (var block in SelectedLedgerTemplate.LedgerBlocks)
                                        {
                                            <MudItem xs="12" md="6">
                                                <div class="platform-ledger-block-input">
                                                    <MudStack Spacing="1">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="1">
                                                            <MudText Typo="Typo.body2">@block.DisplayName</MudText>
                                                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                                @if (block.RequiredForAiJudgment)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">AI 판단 필요</MudChip>
                                                                }
                                                                @if (block.OpensApiHandoff)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">API handoff</MudChip>
                                                                }
                                                            </MudStack>
                                                        </MudStack>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@block.Purpose</MudText>
                                                        <MudTextField T="string"
                                                                      Label="@($"{block.DisplayName} 내용")"
                                                                      Value="@Get원장블록입력값(block.Code)"
                                                                      ValueChanged="@((string value) => Set원장블록입력값(block.Code, value))"
                                                                      Lines="2"
                                                                      Immediate="true"
                                                                      Variant="Variant.Outlined" />
                                                    </MudStack>
                                                </div>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudStack>
                            }
                            @if (SelectedLedgerTemplate.ProcessingSurfaces.Count > 0)
                            {
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">API 경로 메타데이터 후보</MudText>
                                    @if (SelectedApiRouteParameterNames.Count > 0)
                                    {
                                        <MudGrid Spacing="2">
                                            @foreach (var parameterName in SelectedApiRouteParameterNames)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField T="string"
                                                                  Label="@($"{parameterName} 경로 값")"
                                                                  Value="@Get원장Api경로변수값(parameterName)"
                                                                  ValueChanged="@((string value) => Set원장Api경로변수값(parameterName, value))"
                                                                  Immediate="true"
                                                                  Variant="Variant.Outlined" />
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    }
                                    @foreach (var surface in SelectedLedgerTemplate.ProcessingSurfaces)
                                    {
                                        <div class="platform-ledger-api-send">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="1">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@ResolveSurfaceMethod(surface)</MudChip>
                                                        <MudChip T="string" Size="Size.Small" Color="@ResolveSurfaceStatusColor(surface)" Variant="Variant.Outlined">
                                                            @ResolveSurfaceStatusLabel(surface)
                                                        </MudChip>
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@surface.HandoffMode</MudChip>
                                                    </MudStack>
                                                    <MudButton Variant="Variant.Outlined"
                                                               Color="Color.Primary"
                                                               Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.Route"
                                                               Disabled="@(HasUnresolvedApiMetadata(surface) || HasMissingApiRouteParameters(surface))"
                                                               OnClick="@(() => 원장Api경로준비(surface))">
                                                        이 경로로 준비
                                                    </MudButton>
                                                </MudStack>
                                                <MudText Typo="Typo.caption" Class="platform-ledger-api-route">@BuildResolvedApiRoute(surface)</MudText>
                                                @if (surface.IsExistingSurface && !string.IsNullOrWhiteSpace(surface.ApiEndpointKey))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@surface.ApiEndpointKey</MudText>
                                                }
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@surface.Purpose</MudText>
                                                @if (HasUnresolvedApiMetadata(surface))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Warning">기존 API 메타데이터를 아직 불러오지 못했습니다.</MudText>
                                                }
                                                @if (HasMissingApiRouteParameters(surface))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Warning">경로 변수 값을 먼저 입력해야 전송할 수 있습니다.</MudText>
                                                }
                                            </MudStack>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(원장전송결과메시지))
                                    {
                                        <MudAlert Severity="@원장전송결과Severity" Dense="true" Variant="Variant.Outlined">
                                            @원장전송결과메시지
                                        </MudAlert>
                                    }
                                </MudStack>
                            }
                            @if (SelectedLedgerTemplate.CompositionRules.Count > 0)
                            {
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">원장 구성 규칙</MudText>
                                    @foreach (var rule in SelectedLedgerTemplate.CompositionRules)
                                    {
                                        <div class="platform-ledger-rule">
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.body2">@rule.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@rule.Description</MudText>
                                                @if (rule.RequiredLedgerTemplateKeys.Count > 0)
                                                {
                                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">선행 원장</MudText>
                                                        @foreach (var prerequisite in ResolveLedgerTemplateNames(rule.RequiredLedgerTemplateKeys))
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@prerequisite</MudChip>
                                                        }
                                                    </MudStack>
                                                }
                                                @if (rule.RequiredUiSectionHints.Count > 0)
                                                {
                                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">먼저 필요한 UI</MudText>
                                                        @foreach (var section in rule.RequiredUiSectionHints)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@section</MudChip>
                                                        }
                                                    </MudStack>
                                                }
                                                @if (rule.GatedActionHints.Count > 0)
                                                {
                                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">이후 행동</MudText>
                                                        @foreach (var action in rule.GatedActionHints)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@action</MudChip>
                                                        }
                                                    </MudStack>
                                                }
                                            </MudStack>
                                        </div>
                                    }
                                </MudStack>
                            }
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">저장/반영 방식</MudText>
                                <div class="platform-ledger-rule">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                                                @SelectedLedgerTemplate.PersistencePolicy.PrimaryStoreKind
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                @SelectedLedgerTemplate.PersistencePolicy.PrimaryStoreName
                                            </MudChip>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@SelectedLedgerTemplate.PersistencePolicy.RelationalProjectionPolicy</MudText>
                                        @if (SelectedLedgerTemplate.PersistencePolicy.RelationalProjectionTargets.Count > 0)
                                        {
                                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                                @foreach (var target in SelectedLedgerTemplate.PersistencePolicy.RelationalProjectionTargets)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@target.TargetName</MudChip>
                                                }
                                            </MudStack>
                                        }
                                    </MudStack>
                                </div>
                            </MudStack>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">커뮤니티 소통 질문</MudText>
                                @foreach (var prompt in SelectedLedgerTemplate.CommunityDiscussionPrompts.Take(2))
                                {
                                    <MudText Typo="Typo.caption">· @prompt</MudText>
                                }
                            </MudStack>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Assignment"
                                       OnClick="PrepareLedgerCommunityDraft">
                                원함을 원장 초안으로 정리
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    <PlatformCommunityPostComposer ViewModel="@Composer"
                                                       BoardCategories="@BoardCategoryOptions"
                                                       RoleTags="@RoleTagOptions"
                                                       SelectedWorkClassification="@SelectedWorkClassification"
                                                       SelectedWorkFeatureEnabled="@SelectedWorkFeatureEnabled"
                                                       LedgerPickerLoading="@isMyLedgersLoading"
                                                       ExternalStatusMessage="@statusMessage"
                                                       ExternalStatusSeverity="@statusSeverity"
                                                       LedgerPickerRequested="OpenLedgerPickerAsync"
                                                       Closed="CloseCompose"
                                                       CancelEditRequested="CancelEdit"
                                                       Saved="HandleComposerSavedAsync">
                        <LedgerSettings>
                                    <section class="platform-community-compose-ledger-shortcut" aria-label="원장 연결">
                                        <div class="platform-community-compose-setting-heading">
                                            <div>
                                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                                                <strong>원장 연결</strong>
                                            </div>
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@isMyLedgersLoading"
                                                       OnClick="OpenLedgerPickerAsync">
                                                원장 선택
                                            </MudButton>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(form.커뮤니티원장Id))
                                        {
                                            var selectedMyLedger = myLedgers.FirstOrDefault(x =>
                                                string.Equals(x.원장Id, form.커뮤니티원장Id, StringComparison.OrdinalIgnoreCase));
                                            <div class="platform-community-compose-selected-ledger">
                                                <span>
                                                    <strong>@(selectedMyLedger?.제목 ?? "선택한 원장")</strong>
                                                    <small>@form.커뮤니티원장Id</small>
                                                </span>
                                                <div>
                                                    @if (selectedMyLedger?.내가만든원장 == true)
                                                    {
                                                        <MudIconButton Icon="@Icons.Material.Filled.Public"
                                                                       Size="Size.Small"
                                                                       Color="Color.Primary"
                                                                       OnClick="OpenLedgerSharingSettingsAsync"
                                                                       aria-label="원장 공개 설정" />
                                                    }
                                                    <MudIconButton Icon="@Icons.Material.Filled.LinkOff"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   OnClick="ClearSelectedLedger"
                                                                   aria-label="원장 첨부 해제" />
                                                </div>
                                            </div>
                                        }

                                        @if (ledgerSharingSettings is not null)
                                        {
                                            <div class="platform-community-ledger-sharing-settings">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.subtitle2">원장 공개 설정</MudText>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseLedgerSharingSettings" aria-label="공개 설정 닫기" />
                                                </MudStack>
                                                <MudSelect T="string" Label="원장 공개 범위" @bind-Value="ledgerSharingSettings.공개범위" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem Value="@커뮤니티원장공개범위.비공개">비공개</MudSelectItem>
                                                    <MudSelectItem Value="@커뮤니티원장공개범위.커뮤니티">홍달 커뮤니티 공개</MudSelectItem>
                                                    <MudSelectItem Value="@커뮤니티원장공개범위.전체공개">링크 전체 공개</MudSelectItem>
                                                </MudSelect>
                                                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                                    <MudSwitch T="bool" Label="재사용 허용" @bind-Value="ledgerSharingSettings.재사용허용여부" Color="Color.Primary" Disabled="@(ledgerSharingSettings.공개범위 == 커뮤니티원장공개범위.비공개)" />
                                                    <MudSwitch T="bool" Label="재공유 허용" @bind-Value="ledgerSharingSettings.재공유허용여부" Color="Color.Primary" Disabled="@(ledgerSharingSettings.공개범위 == 커뮤니티원장공개범위.비공개)" />
                                                </MudStack>
                                                <div class="platform-community-ledger-sharing-item-list">
                                                    @foreach (var item in ledgerSharingSettings.항목목록)
                                                    {
                                                        <MudCheckBox T="bool"
                                                                     @bind-Value="item.공개여부"
                                                                     Label="@item.표시명"
                                                                     Color="Color.Primary"
                                                                     Disabled="@(ledgerSharingSettings.공개범위 == 커뮤니티원장공개범위.비공개)" />
                                                    }
                                                </div>
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.Save"
                                                           Disabled="@isLedgerSharingSaving"
                                                           OnClick="SaveLedgerSharingSettingsAsync">
                                                    공개 설정 저장
                                                </MudButton>
                                            </div>
                                        }
                                    </section>
                        </LedgerSettings>
                    </PlatformCommunityPostComposer>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">업무 바로가기</MudText>
                            @foreach (var action in QuickActions)
                            {
                                <MudButton Href="@action.Href"
                                           Variant="Variant.Outlined"
                                           Color="@action.Color"
                                           StartIcon="@action.Icon"
                                           EndIcon="@Icons.Material.Filled.ChevronRight"
                                           Class="platform-community-action">
                                    <MudStack Spacing="0" AlignItems="AlignItems.Start">
                                        <MudText Typo="Typo.body2">@action.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@action.Description</MudText>
                                    </MudStack>
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">운영 흐름</MudText>
                            @foreach (var item in OperatingNotes)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@item</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudPaper id="community-work-panel" Elevation="0" Outlined="true" Class="@WorkPanelClass">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5">업무 모드</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            커뮤니티 흐름은 잠시 접고, 지금 처리할 업무 화면으로 바로 진입합니다.
                        </MudText>
                    </MudStack>
                    <MudChip T="string" Color="@CurrentModeColor" Variant="Variant.Outlined">@RoleLabel</MudChip>
                </MudStack>

                <MudPaper Elevation="0" Outlined="true" Class="pa-3 platform-work-community-draft">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">업무에서 커뮤니티 글쓰기</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                업무 중 궁금한 점이나 처리한 일을 바로 커뮤니티 글 초안으로 옮깁니다.
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.HelpOutline"
                                       OnClick="@(() => PrepareWorkCommunity초안(WorkCommunityDraftKind.Question))">
                                궁금한 점
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.TaskAlt"
                                       OnClick="@(() => PrepareWorkCommunity초안(WorkCommunityDraftKind.WorkDone))">
                                처리한 일
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Lightbulb"
                                       OnClick="@(() => PrepareWorkCommunity초안(WorkCommunityDraftKind.Suggestion))">
                                개선 제안
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Public"
                                       OnClick="@(() => PrepareWorkCommunity초안(WorkCommunityDraftKind.InternationalCoordination))">
                                국제 소통
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Assignment"
                                       OnClick="PrepareLedgerCommunityDraft">
                                원장 초안
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudStack Spacing="2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1">통합 업무 흐름</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            앱별 화면을 따로 외우지 않아도, 같은 원장 템플릿에서 업무 초안과 실행 화면으로 이어집니다.
                        </MudText>
                    </MudStack>
                    <MudGrid>
                        @foreach (var workspace in UnifiedWorkspaces)
                        {
                            <MudItem xs="12" sm="6" lg="3">
                                <div class="platform-unified-workspace platform-unified-workspace--compact">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                            <MudIcon Icon="@workspace.Icon" Color="@workspace.Color" />
                                            <MudChip T="string" Size="Size.Small" Color="@workspace.Color" Variant="Variant.Outlined">@workspace.Title</MudChip>
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@원장처리체계표시명(workspace.OperatingSystemName)</MudText>
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       Color="@workspace.Color"
                                                       StartIcon="@Icons.Material.Filled.Assignment"
                                                       OnClick="@(() => PrepareLedgerCommunityDraft(workspace.LedgerTemplateKey))">
                                                초안
                                            </MudButton>
                                            @if (!string.IsNullOrWhiteSpace(workspace.EntryHref))
                                            {
                                                <MudButton Href="@workspace.EntryHref"
                                                           Variant="Variant.Text"
                                                           Size="Size.Small"
                                                           Color="@workspace.Color"
                                                           EndIcon="@Icons.Material.Filled.ChevronRight">
                                                    열기
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                </MudStack>

                @if (WorkModeContent is not null)
                {
                    @WorkModeContent
                }
                else if (QuickActions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        이 앱에는 아직 업무 바로가기가 등록되어 있지 않습니다.
                    </MudAlert>
                }
                else
                {
                    <MudGrid>
                        @foreach (var action in QuickActions)
                        {
                            <MudItem xs="12" sm="6" lg="4">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 platform-work-action-card">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudIcon Icon="@action.Icon" Color="@action.Color" Size="Size.Large" />
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="@action.Color" />
                                        </MudStack>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold">@action.Title</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                        </MudStack>
                                        <MudButton Href="@action.Href"
                                                   Variant="Variant.Filled"
                                                   Color="@action.Color"
                                                   StartIcon="@action.Icon">
                                            열기
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudStack>
        </MudPaper>
        }

        @if (!BoardIndexOnly && !ListOnly && !IsDiagramMode && !isComposeOpen)
        {
            <nav class="platform-community-mobile-nav" aria-label="커뮤니티 모바일 내비게이션">
                @if (UseCompactHomeSummary)
                {
                    <button type="button" class="@BuildMobileNavigationClass(IsCompactHomeSummaryVisible)" @onclick="OpenCompactHomeSummary">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                        <span>홈</span>
                    </button>
                    <button type="button" class="@BuildMobileNavigationClass(!isWorkMode && !IsCompactHomeSummaryVisible)" @onclick="공통홈게시판열기Async">
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" />
                        <span>게시판</span>
                    </button>
                }
                else
                {
                    <button type="button" class="@BuildMobileNavigationClass(!isWorkMode)" @onclick="OpenCommunityMode">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                        <span>커뮤니티</span>
                    </button>
                    <a href="#community-board-list" class="platform-community-mobile-nav-item">
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" />
                        <span>게시판</span>
                    </a>
                }
                <button type="button" class="platform-community-mobile-nav-item platform-community-mobile-nav-compose" @onclick="OpenCompose">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />
                    <span>글쓰기</span>
                </button>
                <button type="button" class="@BuildMobileNavigationClass(isWorkMode)" @onclick="OpenWorkMode">
                    <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Small" />
                    <span>업무</span>
                </button>
            </nav>
        }

        @if (nodeDetailPanelNode is not null)
        {
            var nodeDetailState = ResolveNodeDetailProcessingState(nodeDetailPanelNode);
            var nodeDetailContextValues = ResolveNodeDetailContextValues(nodeDetailPanelNode);
            var nodeDetailAction = BuildNodeDetailAction(nodeDetailPanelNode);
            var nodeDetailInputFormFields = 도형입력항목해결(nodeDetailPanelNode);
            var nodeDetailReadiness = 노드입력준비도해결(nodeDetailPanelNode, nodeDetailState);

            <aside class="platform-diagram-node-detail-panel"
                   role="dialog"
                   aria-label="노드 상세 정보"
                   @onclick:stopPropagation="true"
                   @onpointerdown:stopPropagation="true"
                   @onpointerup:stopPropagation="true">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Spacing="1">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.overline" Color="Color.Secondary">노드 상세</MudText>
                            <MudText Typo="Typo.subtitle1">@nodeDetailPanelNode.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@nodeDetailPanelNode.GroupLabel</MudText>
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       OnClick="CloseNodeDetailPanel"
                                       aria-label="노드 상세 닫기" />
                    </MudStack>

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudChip T="string" Size="Size.Small" Color="@BuildNodeProcessingStateColor(nodeDetailState)" Variant="Variant.Filled">
                            @BuildNodeProcessingStateLabel(nodeDetailState)
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@nodeDetailPanelNode.Color" Variant="Variant.Outlined">
                            @BuildNodeKindLabel(nodeDetailPanelNode.Kind)
                        </MudChip>
                        @if (IsDiagramMode)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Secondary"
                                     Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Layers">
                                @BuildDiagramNodeStackLabel(nodeDetailPanelNode)
                            </MudChip>
                        }
                        @if (nodeDetailPanelNode.Kind.Equals("form", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                @ResolveDiagramFormKindLabel(nodeDetailPanelNode.FormKind)
                            </MudChip>
                        }
                    </MudStack>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">@nodeDetailPanelNode.Description</MudText>

                    <div class="@(nodeDetailReadiness.Percent >= 100 ? "platform-diagram-node-readiness-card platform-diagram-node-readiness-card--complete" : "platform-diagram-node-readiness-card")"
                         style="@BuildNodeReadinessStyle(nodeDetailReadiness)">
                        <div>
                            <strong>
                                @if (nodeDetailReadiness.Percent >= 100)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                }
                                입력 준비도 @($"{nodeDetailReadiness.Percent}%")
                            </strong>
                            <span>@nodeDetailReadiness.CountLabel</span>
                        </div>
                        <span class="platform-diagram-node-readiness-track"><i></i></span>
                        <small>@nodeDetailReadiness.GuidanceLabel</small>
                        @if (nodeDetailReadiness.TrackedBlocks.Count > 0)
                        {
                            <div class="platform-diagram-node-quick-inputs">
                                <div class="platform-diagram-node-quick-input-heading">
                                    <strong>필수 정보 바로 입력</strong>
                                    <span>입력하면 준비도가 즉시 반영됩니다.</span>
                                </div>
                                @foreach (var trackedBlock in nodeDetailReadiness.TrackedBlocks)
                                {
                                    <MudTextField T="string"
                                                  Label="@trackedBlock.DisplayName"
                                                  Value="@Get원장블록입력값(trackedBlock.Code)"
                                                  ValueChanged="@((string value) => Set원장블록입력값(trackedBlock.Code, value))"
                                                  Placeholder="@trackedBlock.Purpose"
                                                  Immediate="true"
                                                  Lines="2"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Class="platform-diagram-node-quick-input" />
                                }
                            </div>
                        }
                    </div>

                    @if (선택현재원장 is { } currentLedger)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                            @currentLedger.Title · @currentLedger.StateLabel
                        </MudAlert>
                    }

                    @if (nodeDetailContextValues.Count > 0)
                    {
                        <div class="platform-diagram-node-context-list">
                            @foreach (var pair in nodeDetailContextValues)
                            {
                                <div class="platform-diagram-node-context-item">
                                    <span>@pair.Key</span>
                                    <strong>@pair.Value</strong>
                                </div>
                            }
                        </div>
                    }

                    @if (nodeDetailInputFormFields.Count > 0)
                    {
                        <div class="platform-diagram-node-form-list">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">@(nodeDetailPanelNode.Kind == "form" ? "업무 폼 입력" : "단계별 입력 가이드")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(nodeDetailPanelNode.Kind == "form" ? "입력값은 이 폼 노드의 준비도에 바로 반영됩니다." : "업무를 구체화할 때 참고하는 체크 항목입니다.")
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                    @($"{nodeDetailInputFormFields.Count}개 {(nodeDetailPanelNode.Kind == "form" ? "입력" : "참고")}")
                                </MudChip>
                            </MudStack>
                            @if (nodeDetailPanelNode.Kind == "form")
                            {
                                @foreach (var field in nodeDetailInputFormFields)
                                {
                                    <MudTextField T="string"
                                                  Label="@($"{field.Label} · {(field.IsRequired ? "필수" : "선택")}")"
                                                  Value="@GetDiagramFormValue(nodeDetailPanelNode, field)"
                                                  ValueChanged="@((string value) => SetDiagramFormValue(nodeDetailPanelNode, field, value))"
                                                  Placeholder="@field.InputType"
                                                  HelperText="@field.Description"
                                                  Required="@field.IsRequired"
                                                  Immediate="true"
                                                  Lines="@(field.InputType.Contains("텍스트", StringComparison.OrdinalIgnoreCase) ? 2 : 1)"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined" />
                                }
                            }
                            else
                            {
                                @foreach (var field in nodeDetailInputFormFields)
                                {
                                    <div class="platform-diagram-node-form-field">
                                        <div>
                                            <strong>@field.Label</strong>
                                            <span>@field.Description</span>
                                        </div>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@(field.IsRequired ? Color.Warning : Color.Default)"
                                                 Variant="Variant.Outlined">
                                            @(field.IsRequired ? "필수" : "선택") · @field.InputType
                                        </MudChip>
                                    </div>
                                }
                            }
                        </div>
                    }

                    <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined">
                        @nodeDetailAction.Description
                    </MudAlert>

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled"
                                   Color="@nodeDetailAction.Color"
                                   StartIcon="@nodeDetailAction.Icon"
                                   OnClick="NavigateToNodeDetailPage">
                            상세 정보 확인
                        </MudButton>
                        @if (IsDiagramMode)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.FlipToFront"
                                       Disabled="@(!CanBringSelectedDiagramNodeToFront())"
                                       OnClick="BringSelectedDiagramNodeToFront">
                                맨 앞으로
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.FlipToBack"
                                       Disabled="@(!CanSendSelectedDiagramNodeToBack())"
                                       OnClick="SendSelectedDiagramNodeToBack">
                                맨 뒤로
                            </MudButton>
                        }
                        @if (창고대행신청노드인가(nodeDetailPanelNode))
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Warehouse"
                                       OnClick="노드에서창고대행신청패널열기Async">
                                물류 대행 신청
                            </MudButton>
                        }
                    </MudStack>
                </MudStack>
            </aside>
        }
    </MudStack>
</MudContainer>
