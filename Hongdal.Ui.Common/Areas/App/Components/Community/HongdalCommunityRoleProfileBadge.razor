@namespace Hongdal.Ui.Common.Areas.App.Components.Community

<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Spacing="1"
          Class="@RootClass">
    <MudAvatar Size="@AvatarSize"
               Color="@ResolvedRole.Color"
               Variant="Variant.Filled"
               Class="@AvatarClass">
        @InitialText
    </MudAvatar>
    <MudStack Spacing="0" Class="hongdal-role-profile__text">
        <MudText Typo="@NameTypo" Class="hongdal-role-profile__name">@ResolvedDisplayName</MudText>
        @if (ShowRole)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@ResolvedRole.Color"
                     Variant="Variant.Outlined"
                     Class="hongdal-role-profile__chip">
                @ResolvedRole.Label
            </MudChip>
        }
    </MudStack>
</MudStack>

<style>
    .hongdal-role-profile {
        min-width: 0;
    }

    .hongdal-role-profile__avatar {
        box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 20%, transparent);
        border: 2px solid var(--mud-palette-surface);
        flex: 0 0 auto;
    }

    .hongdal-role-profile__text {
        min-width: 0;
    }

    .hongdal-role-profile__name {
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.15;
    }

    .hongdal-role-profile__chip {
        width: fit-content;
        max-width: 160px;
    }

    .hongdal-role-profile--compact .hongdal-role-profile__name {
        max-width: 140px;
    }
</style>

@code {
    [Parameter]
    public string? DisplayName { get; set; }

    [Parameter]
    public string? RoleLabel { get; set; }

    [Parameter]
    public string? ContextKey { get; set; }

    [Parameter]
    public string? Category { get; set; }

    [Parameter]
    public bool IsMasked { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool ShowRole { get; set; } = true;

    private CommunityRoleBadge ResolvedRole => ResolveRole();

    private string ResolvedDisplayName => IsMasked
        ? "익명 참여자"
        : string.IsNullOrWhiteSpace(DisplayName)
            ? "참여자"
            : DisplayName.Trim();

    private string InitialText
    {
        get
        {
            var source = IsMasked ? "익" : ResolvedDisplayName;
            return string.IsNullOrWhiteSpace(source)
                ? "?"
                : source.Trim()[0].ToString();
        }
    }

    private string RootClass => Compact
        ? "hongdal-role-profile hongdal-role-profile--compact"
        : "hongdal-role-profile";

    private string AvatarClass => $"hongdal-role-profile__avatar hongdal-role-profile__avatar--{ResolvedRole.Code}";

    private Size AvatarSize => Compact ? Size.Small : Size.Medium;

    private Typo NameTypo => Compact ? Typo.caption : Typo.body2;

    private CommunityRoleBadge ResolveRole()
    {
        if (IsMasked)
        {
            return new("anonymous", "익명 참여", Color.Default);
        }

        var explicitRole = Normalize(RoleLabel);
        if (!string.IsNullOrWhiteSpace(explicitRole))
        {
            return ResolveFromText(explicitRole, fallbackLabel: RoleLabel!.Trim());
        }

        var text = Normalize($"{ContextKey} {Category} {DisplayName}");
        return ResolveFromText(text, fallbackLabel: "플랫폼 참여자");
    }

    private static CommunityRoleBadge ResolveFromText(string text, string fallbackLabel)
    {
        if (ContainsAny(text, "관리자", "admin", "operator", "운영자"))
        {
            return new("operator", "운영자", Color.Error);
        }

        if (ContainsAny(text, "기사", "driver", "rider", "용달", "배달"))
        {
            return new("driver", "기사", Color.Primary);
        }

        if (ContainsAny(text, "화주", "shipper", "운송의뢰", "수입", "해외"))
        {
            return new("shipper", "화주", Color.Secondary);
        }

        if (ContainsAny(text, "창고", "warehouse", "입고", "출고", "포장", "피킹", "검수", "마트"))
        {
            return new("warehouse", "창고 운영", Color.Warning);
        }

        if (ContainsAny(text, "주문자", "orderer", "고객", "customer"))
        {
            return new("orderer", "주문자", Color.Success);
        }

        if (ContainsAny(text, "판매자", "seller", "스토어", "상점", "음식점", "restaurant"))
        {
            return new("seller", "판매자", Color.Info);
        }

        if (ContainsAny(text, "관세", "customs", "hs", "통관"))
        {
            return new("customs", "관세사", Color.Tertiary);
        }

        if (ContainsAny(text, "hr", "인력", "근무", "교육"))
        {
            return new("hr", "인력 관리자", Color.Dark);
        }

        return new("participant", string.IsNullOrWhiteSpace(fallbackLabel) ? "플랫폼 참여자" : fallbackLabel, Color.Default);
    }

    private static bool ContainsAny(string text, params string[] candidates)
    {
        return candidates.Any(candidate => text.Contains(candidate, StringComparison.OrdinalIgnoreCase));
    }

    private static string Normalize(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();
    }

    private sealed record CommunityRoleBadge(string Code, string Label, Color Color);
}
