@using System.Globalization
@using Hongdal.Ui.Common.Areas.App.Services
@implements IDisposable
@inject PlatformCommunityDecorationStateService DecorationState

<section class="bagua-motion-card"
         style="@BuildRootStyle()"
         data-animation-slot="@Scene.AssetSlotKey"
         data-animation-profile="@EffectiveRendererProfile"
         aria-labelledby="bagua-motion-title">
    <header class="bagua-motion-header">
        <div>
            <span>MOTION STORY · @ActiveMotionLabel</span>
            <h2 id="bagua-motion-title">@Scene.Title</h2>
            <p>@Scene.Storyboard</p>
        </div>
        <div class="bagua-motion-controls" aria-label="애니메이션 재생 제어">
            <button type="button" @onclick="TogglePause" aria-pressed="@isPaused">
                @(isPaused ? "▶ 계속" : "Ⅱ 멈춤")
            </button>
            <button type="button" @onclick="Replay">↻ 다시</button>
        </div>
    </header>

    <div @key="animationRunId"
         class="@BuildStageClass()"
         style="@BuildStageStyle()"
         role="img"
         aria-label="@BuildAnimationAriaLabel()">
        <svg class="bagua-motion-route"
             viewBox="0 0 100 100"
             preserveAspectRatio="none"
             focusable="false"
             aria-hidden="true">
            <path d="@BuildPathData()" />
        </svg>

        @if (IsSameArea)
        {
            <div class="bagua-motion-node bagua-motion-node--same"
                 style="@BuildNodeStyle(sourcePoint)">
                <strong>@SourceArea.TrigramSymbol</strong>
                <small>@SourceArea.BusinessName</small>
            </div>
        }
        else
        {
            <div class="bagua-motion-node bagua-motion-node--source"
                 style="@BuildNodeStyle(sourcePoint)">
                <strong>@SourceArea.TrigramSymbol</strong>
                <small>@SourceArea.BusinessName</small>
            </div>
            <div class="bagua-motion-node bagua-motion-node--target"
                 style="@BuildNodeStyle(targetPoint)">
                <strong>@TargetArea.TrigramSymbol</strong>
                <small>@TargetArea.BusinessName</small>
            </div>
        }

        @if (Scene.MotionKind == "gather")
        {
            <div class="bagua-motion-gathering" style="@BuildNodeStyle(targetPoint)" aria-hidden="true">
                <i></i><i></i><i></i>
            </div>
        }

        <div class="bagua-motion-actor">
            <span class="bagua-motion-payload" aria-hidden="true">@Scene.PayloadSymbol</span>
            <span class="bagua-motion-style-mark" aria-hidden="true">@ActiveMotionSymbol</span>
            <svg class="bagua-motion-runner"
                 viewBox="0 0 64 72"
                 focusable="false"
                 aria-hidden="true">
                <circle class="bagua-motion-runner-head" cx="35" cy="12" r="8" />
                <path class="bagua-motion-runner-body" d="M33 21 L28 43" />
                <g class="bagua-motion-runner-arm bagua-motion-runner-arm--front">
                    <path d="M31 27 L46 35 L54 28" />
                </g>
                <g class="bagua-motion-runner-arm bagua-motion-runner-arm--back">
                    <path d="M31 27 L17 34 L10 43" />
                </g>
                <g class="bagua-motion-runner-leg bagua-motion-runner-leg--front">
                    <path d="M28 42 L43 54 L54 55" />
                </g>
                <g class="bagua-motion-runner-leg bagua-motion-runner-leg--back">
                    <path d="M28 42 L19 57 L8 64" />
                </g>
            </svg>
            <span class="bagua-motion-role-label">@Role.RoleName</span>
        </div>

        <div class="bagua-motion-arrival" style="@BuildNodeStyle(targetPoint)" aria-hidden="true">
            <span>✓</span>
        </div>

        <span class="bagua-motion-reduced-note">동작 줄이기 설정에서는 도착 상태만 표시됩니다.</span>
    </div>

    <details class="bagua-motion-creator-brief">
        <summary>전문 애니메이션 제작으로 확장할 수 있는 장면입니다</summary>
        <p>@Scene.CreativeBrief</p>
        <div>
            @foreach (var discipline in Scene.ContributorDisciplines)
            {
                <span>@discipline</span>
            }
        </div>
    </details>
</section>

<style>
    .bagua-motion-card {
        overflow: hidden;
        border: 1px solid #d8e2ef;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 12px 34px rgba(15, 23, 42, .06);
    }

    .bagua-motion-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        padding: 22px 24px 17px;
    }

    .bagua-motion-header span {
        color: var(--motion-accent);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .09em;
    }

    .bagua-motion-header h2 {
        margin: 4px 0 6px;
        color: #172033;
        font-size: 21px;
        line-height: 1.3;
    }

    .bagua-motion-header p,
    .bagua-motion-creator-brief p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
    }

    .bagua-motion-controls {
        display: flex;
        flex: 0 0 auto;
        gap: 7px;
    }

    .bagua-motion-controls button {
        min-height: 36px;
        padding: 7px 11px;
        border: 1px solid #d7e1ec;
        border-radius: 10px;
        background: #f8fafc;
        color: #334155;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .bagua-motion-controls button:hover,
    .bagua-motion-controls button:focus-visible {
        border-color: var(--motion-accent);
        color: var(--motion-accent);
        outline: none;
    }

    .bagua-motion-stage {
        position: relative;
        height: clamp(230px, 31vw, 350px);
        min-height: 230px;
        overflow: hidden;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        background:
            radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--motion-accent) 10%, transparent), transparent 34%),
            linear-gradient(180deg, #f8fbff 0%, #eef4fa 72%, #e4edf5 72%, #edf3f7 100%);
    }

    .bagua-motion-stage::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: 22%;
        left: 0;
        height: 2px;
        background: repeating-linear-gradient(90deg, #b5c4d4 0 12px, transparent 12px 24px);
        opacity: .62;
    }

    .bagua-motion-route {
        position: absolute;
        z-index: 1;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;
    }

    .bagua-motion-route path {
        fill: none;
        stroke: var(--motion-accent);
        stroke-width: 2.2;
        stroke-dasharray: 5 5;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
        opacity: .34;
        animation: bagua-motion-route-flow 1.1s linear infinite;
    }

    .bagua-motion-node {
        position: absolute;
        z-index: 3;
        display: grid;
        place-items: center;
        width: 76px;
        height: 76px;
        transform: translate(-50%, -50%);
        border: 2px solid rgba(255, 255, 255, .9);
        border-radius: 22px;
        background: rgba(255, 255, 255, .91);
        box-shadow: 0 11px 28px rgba(30, 64, 105, .15);
    }

    .bagua-motion-node strong {
        margin-top: 6px;
        color: #172033;
        font-size: 30px;
        line-height: 1;
    }

    .bagua-motion-node small {
        margin-bottom: 7px;
        color: #52657d;
        font-size: 11px;
        font-weight: 900;
    }

    .bagua-motion-node--target,
    .bagua-motion-node--same {
        border-color: color-mix(in srgb, var(--motion-accent) 34%, white);
    }

    .bagua-motion-actor {
        position: absolute;
        z-index: 6;
        left: var(--motion-from-x);
        top: var(--motion-from-y);
        display: grid;
        place-items: center;
        width: 70px;
        height: 94px;
        transform: translate(-50%, -70%);
        animation: bagua-motion-journey var(--motion-duration) cubic-bezier(.45, .05, .25, 1) infinite;
        filter: drop-shadow(0 7px 5px rgba(15, 23, 42, .18));
    }

    .bagua-motion-runner {
        width: 62px;
        height: 72px;
        overflow: visible;
    }

    .bagua-motion-runner-head {
        fill: #ffd4b5;
        stroke: #8a4f32;
        stroke-width: 1.5;
    }

    .bagua-motion-runner-body,
    .bagua-motion-runner path {
        fill: none;
        stroke: var(--motion-accent);
        stroke-width: 7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .bagua-motion-runner-arm,
    .bagua-motion-runner-leg {
        transform-box: fill-box;
        transform-origin: center;
    }

    .bagua-motion-runner-arm--front,
    .bagua-motion-runner-leg--back {
        animation: bagua-motion-limb-front .42s ease-in-out infinite alternate;
    }

    .bagua-motion-runner-arm--back,
    .bagua-motion-runner-leg--front {
        animation: bagua-motion-limb-back .42s ease-in-out infinite alternate;
    }

    .bagua-motion-payload {
        position: absolute;
        z-index: 2;
        top: 22px;
        right: -4px;
        display: grid;
        place-items: center;
        width: 27px;
        height: 27px;
        border: 2px solid var(--motion-accent);
        border-radius: 9px;
        background: #fff;
        color: var(--motion-accent);
        font-size: 16px;
        font-weight: 900;
        animation: bagua-motion-payload-bounce .42s ease-in-out infinite alternate;
    }

    .bagua-motion-style-mark {
        position: absolute;
        z-index: 3;
        top: 26px;
        left: 4px;
        display: grid;
        width: 24px;
        height: 24px;
        place-items: center;
        border: 2px solid #fff;
        border-radius: 9px;
        background: var(--motion-accent);
        color: #fff;
        font-size: 12px;
        box-shadow: 0 4px 10px rgba(15, 23, 42, .18);
    }

    .bagua-motion-stage--profile-courier-sprint-v1 .bagua-motion-style-mark {
        width: 29px;
        height: 29px;
        border-radius: 7px;
        transform: rotate(-7deg);
    }

    .bagua-motion-stage--profile-courier-sprint-v1 .bagua-motion-route path {
        stroke-width: 3.2;
        stroke-dasharray: 9 5;
    }

    .bagua-motion-stage--profile-light-trail-v1 .bagua-motion-route path {
        stroke-width: 4;
        filter: drop-shadow(0 0 5px var(--motion-accent));
        opacity: .72;
    }

    .bagua-motion-stage--profile-light-trail-v1 .bagua-motion-actor {
        filter: drop-shadow(0 0 11px var(--motion-accent));
    }

    .bagua-motion-role-label {
        position: absolute;
        top: 76px;
        padding: 3px 7px;
        border-radius: 999px;
        background: rgba(23, 32, 51, .87);
        color: #fff;
        font-size: 9px;
        font-weight: 800;
        white-space: nowrap;
    }

    .bagua-motion-arrival {
        position: absolute;
        z-index: 7;
        left: var(--motion-to-x);
        top: var(--motion-to-y);
        width: 28px;
        height: 28px;
        transform: translate(-50%, -145%) scale(.3);
        opacity: 0;
        animation: bagua-motion-arrival var(--motion-duration) ease-out infinite;
    }

    .bagua-motion-arrival span {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: var(--motion-accent);
        color: #fff;
        font-weight: 900;
        box-shadow: 0 5px 15px color-mix(in srgb, var(--motion-accent) 35%, transparent);
    }

    .bagua-motion-gathering {
        position: absolute;
        z-index: 4;
        width: 100px;
        height: 100px;
        transform: translate(-50%, -50%);
        pointer-events: none;
    }

    .bagua-motion-gathering i {
        position: absolute;
        width: 13px;
        height: 13px;
        border: 3px solid #fff;
        border-radius: 50%;
        background: var(--motion-accent);
        box-shadow: 0 3px 8px rgba(15, 23, 42, .17);
        animation: bagua-motion-gather 1.8s ease-in-out infinite alternate;
    }

    .bagua-motion-gathering i:nth-child(1) { top: 4px; left: 43px; }
    .bagua-motion-gathering i:nth-child(2) { right: 3px; bottom: 14px; animation-delay: -.6s; }
    .bagua-motion-gathering i:nth-child(3) { bottom: 14px; left: 3px; animation-delay: -1.2s; }

    .bagua-motion-reduced-note { display: none; }

    .bagua-motion-stage.is-paused .bagua-motion-actor,
    .bagua-motion-stage.is-paused .bagua-motion-route path,
    .bagua-motion-stage.is-paused .bagua-motion-runner-arm,
    .bagua-motion-stage.is-paused .bagua-motion-runner-leg,
    .bagua-motion-stage.is-paused .bagua-motion-payload,
    .bagua-motion-stage.is-paused .bagua-motion-arrival,
    .bagua-motion-stage.is-paused .bagua-motion-gathering i {
        animation-play-state: paused !important;
    }

    .bagua-motion-creator-brief {
        padding: 14px 24px 18px;
        background: #fbfdff;
    }

    .bagua-motion-creator-brief summary {
        color: #42566f;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
    }

    .bagua-motion-creator-brief p { margin-top: 10px; }

    .bagua-motion-creator-brief div {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    .bagua-motion-creator-brief div span {
        padding: 4px 8px;
        border: 1px solid #d8e2ed;
        border-radius: 999px;
        background: #fff;
        color: #52657d;
        font-size: 11px;
        font-weight: 700;
    }

    @@keyframes bagua-motion-journey {
        0%, 10% { left: var(--motion-from-x); top: var(--motion-from-y); transform: translate(-50%, -70%) scale(.94); }
        48% { left: var(--motion-mid-x); top: var(--motion-mid-y); transform: translate(-50%, -74%) scale(1.03); }
        78%, 100% { left: var(--motion-to-x); top: var(--motion-to-y); transform: translate(-50%, -70%) scale(.96); }
    }

    @@keyframes bagua-motion-route-flow { to { stroke-dashoffset: -20; } }
    @@keyframes bagua-motion-limb-front { from { transform: rotate(-13deg); } to { transform: rotate(16deg); } }
    @@keyframes bagua-motion-limb-back { from { transform: rotate(14deg); } to { transform: rotate(-15deg); } }
    @@keyframes bagua-motion-payload-bounce { from { transform: translateY(0) rotate(-3deg); } to { transform: translateY(-3px) rotate(4deg); } }
    @@keyframes bagua-motion-arrival {
        0%, 67% { opacity: 0; transform: translate(-50%, -145%) scale(.3); }
        78%, 91% { opacity: 1; transform: translate(-50%, -145%) scale(1); }
        100% { opacity: 0; transform: translate(-50%, -145%) scale(.7); }
    }
    @@keyframes bagua-motion-gather { from { transform: translateY(0) scale(.9); } to { transform: translateY(-6px) scale(1.08); } }

    @@media (max-width: 720px) {
        .bagua-motion-header { flex-direction: column; padding: 18px; }
        .bagua-motion-controls { align-self: stretch; }
        .bagua-motion-controls button { flex: 1; }
        .bagua-motion-node { width: 64px; height: 64px; border-radius: 18px; }
        .bagua-motion-node strong { font-size: 25px; }
        .bagua-motion-actor { transform: translate(-50%, -66%) scale(.88); }
        .bagua-motion-creator-brief { padding-inline: 18px; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .bagua-motion-route path,
        .bagua-motion-runner-arm,
        .bagua-motion-runner-leg,
        .bagua-motion-payload,
        .bagua-motion-arrival,
        .bagua-motion-gathering i {
            animation: none !important;
        }

        .bagua-motion-actor {
            left: var(--motion-to-x);
            top: var(--motion-to-y);
            animation: none !important;
        }

        .bagua-motion-arrival {
            opacity: 1;
            transform: translate(-50%, -145%) scale(1);
        }

        .bagua-motion-reduced-note {
            position: absolute;
            right: 12px;
            bottom: 8px;
            display: block;
            color: #64748b;
            font-size: 10px;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public BaguaRoleTransitionAnimationModel Scene { get; set; } = default!;

    [Parameter, EditorRequired]
    public BaguaActorRoleDefinition Role { get; set; } = default!;

    [Parameter, EditorRequired]
    public BaguaBusinessAreaDefinition SourceArea { get; set; } = default!;

    [Parameter, EditorRequired]
    public BaguaBusinessAreaDefinition TargetArea { get; set; } = default!;

    private int animationRunId;
    private bool isPaused;
    private BaguaTransitionMotionManifest? activeManifest;
    private MotionPoint sourcePoint = new(10, 50);
    private MotionPoint targetPoint = new(50, 85);
    private MotionPoint middlePoint = new(34, 62);

    private bool IsSameArea
        => string.Equals(SourceArea.TrigramKey, TargetArea.TrigramKey, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
        => DecorationState.Changed += HandleDecorationChanged;

    protected override void OnParametersSet()
    {
        ResolveActiveManifest();
        sourcePoint = ResolvePoint(SourceArea.TrigramKey);
        targetPoint = ResolvePoint(TargetArea.TrigramKey);
        middlePoint = ResolveMiddlePoint(sourcePoint, targetPoint, IsSameArea);
        isPaused = false;
        animationRunId++;
    }

    private void TogglePause() => isPaused = !isPaused;

    private void Replay()
    {
        isPaused = false;
        animationRunId++;
    }

    private string BuildRootStyle()
        => $"--motion-accent: {EffectiveAccentColor};";

    private string BuildStageClass()
    {
        var classes = new List<string>
        {
            "bagua-motion-stage",
            $"bagua-motion-stage--{Scene.MotionKind}",
            $"bagua-motion-stage--profile-{EffectiveRendererProfile}"
        };

        if (isPaused)
        {
            classes.Add("is-paused");
        }

        if (IsSameArea)
        {
            classes.Add("is-same-area");
        }

        return string.Join(' ', classes);
    }

    private string BuildStageStyle()
        => FormattableString.Invariant(
            $"--motion-from-x: {sourcePoint.X:0.##}%; --motion-from-y: {sourcePoint.Y:0.##}%; --motion-mid-x: {middlePoint.X:0.##}%; --motion-mid-y: {middlePoint.Y:0.##}%; --motion-to-x: {targetPoint.X:0.##}%; --motion-to-y: {targetPoint.Y:0.##}%; --motion-duration: {EffectiveDurationMilliseconds}ms;");

    private string EffectiveAccentColor
        => activeManifest is { UseRoleAccent: false } ? activeManifest.AccentColor : Scene.AccentColor;

    private int EffectiveDurationMilliseconds
        => activeManifest is null
            ? Scene.DurationMilliseconds
            : (int)Math.Clamp(
                Scene.DurationMilliseconds * activeManifest.DurationScale,
                2400,
                9000);

    private string EffectiveRendererProfile
        => activeManifest?.RendererProfile switch
        {
            "courier-sprint-v1" => "courier-sprint-v1",
            "light-trail-v1" => "light-trail-v1",
            _ => "runner-v1"
        };

    private string ActiveMotionLabel
        => activeManifest?.CharacterLabel ?? "내장 기본 장면";

    private string ActiveMotionSymbol
        => activeManifest?.PreviewSymbol ?? "●";

    private void ResolveActiveManifest()
        => activeManifest = DecorationState.ResolveBaguaMotion(Scene.AssetSlotKey, Scene.MotionKind);

    private void HandleDecorationChanged()
    {
        ResolveActiveManifest();
        animationRunId++;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string BuildNodeStyle(MotionPoint point)
        => FormattableString.Invariant($"left: {point.X:0.##}%; top: {point.Y:0.##}%;");

    private string BuildPathData()
        => FormattableString.Invariant(
            $"M {sourcePoint.X:0.##} {sourcePoint.Y:0.##} Q {middlePoint.X:0.##} {middlePoint.Y:0.##} {targetPoint.X:0.##} {targetPoint.Y:0.##}");

    private string BuildAnimationAriaLabel()
        => $"{Role.RoleName} 인물이 {SourceArea.BusinessName} {SourceArea.TrigramName}에서 " +
           $"{TargetArea.BusinessName} {TargetArea.TrigramName}까지 이동하는 애니메이션";

    private static MotionPoint ResolvePoint(string trigramKey)
        => trigramKey switch
        {
            BaguaTrigramKeys.Zhen => new MotionPoint(12, 50),
            BaguaTrigramKeys.Li => new MotionPoint(50, 16),
            BaguaTrigramKeys.Dui => new MotionPoint(88, 50),
            BaguaTrigramKeys.Kan => new MotionPoint(50, 84),
            _ => new MotionPoint(50, 50)
        };

    private static MotionPoint ResolveMiddlePoint(
        MotionPoint source,
        MotionPoint target,
        bool isSameArea)
    {
        if (isSameArea)
        {
            return new MotionPoint(
                Math.Clamp(source.X + 13, 10, 90),
                Math.Clamp(source.Y - 15, 10, 90));
        }

        var deltaX = target.X - source.X;
        var deltaY = target.Y - source.Y;
        var distance = Math.Sqrt(deltaX * deltaX + deltaY * deltaY);
        var curve = distance <= 0 ? 0 : 8;

        return new MotionPoint(
            Math.Clamp((source.X + target.X) / 2 - deltaY / distance * curve, 8, 92),
            Math.Clamp((source.Y + target.Y) / 2 + deltaX / distance * curve, 8, 92));
    }

    private sealed record MotionPoint(double X, double Y);

    public void Dispose()
        => DecorationState.Changed -= HandleDecorationChanged;
}
