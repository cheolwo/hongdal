@implements IDisposable
@inject YouTube공개콘텐츠Service YouTubeContent
@inject PlatformCommunityPostDraftStateService CommunityPostDrafts
@inject NavigationManager Navigation

<section class="prajna-library" aria-labelledby="prajna-library-title">
    <header class="prajna-library__hero">
        <div>
            <span class="prajna-library__eyebrow">般若 · PRAJNA</span>
            <h1 id="prajna-library-title">@ChannelName 강의</h1>
            <p>지혜를 익히고 삶에서 살펴볼 수 있도록 주제별 강의 재생목록을 모았습니다.</p>
        </div>
        <a class="prajna-library__channel-link"
           href="@ChannelUrl"
           target="_blank"
           rel="noopener noreferrer">
            YouTube 채널
            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
        </a>
    </header>

    @if (isLoading)
    {
        <div class="prajna-library__state" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <strong>강의 재생목록을 불러오고 있습니다.</strong>
            <span>홍달 서버가 YouTube의 현재 공개 목록을 확인합니다.</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="prajna-library__state prajna-library__state--error" role="alert">
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" />
            <strong>강의 목록을 불러오지 못했습니다.</strong>
            <span>@errorMessage</span>
            <button type="button" @onclick="LoadAsync">다시 불러오기</button>
        </div>
    }
    else
    {
        <div class="prajna-library__summary">
            <span><b>@playlists.Count</b>개 재생목록</span>
            <span><b>@playlists.Sum(x => x.영상수)</b>개 공개 영상</span>
            <label>
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                <input type="search"
                       placeholder="주제나 강의 이름 검색"
                       aria-label="홍익학당 재생목록 검색"
                       @bind="searchText"
                       @bind:event="oninput" />
            </label>
        </div>

        <div class="prajna-library__workspace">
            <aside class="prajna-library__playlists" aria-label="강의 재생목록">
                @if (FilteredPlaylists.Count == 0)
                {
                    <div class="prajna-library__empty">검색 결과가 없습니다.</div>
                }
                else
                {
                    @foreach (var playlist in FilteredPlaylists)
                    {
                        <button type="button"
                                class="@BuildPlaylistClass(playlist)"
                                aria-pressed="@IsSelected(playlist)"
                                @onclick="@(() => SelectPlaylistAsync(playlist))">
                            <span class="prajna-library__playlist-thumb">
                                @if (!string.IsNullOrWhiteSpace(playlist.썸네일Url))
                                {
                                    <img src="@playlist.썸네일Url" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" />
                                }
                            </span>
                            <span class="prajna-library__playlist-copy">
                                <strong>@playlist.제목</strong>
                                <small>@($"영상 {playlist.영상수}개 · {FormatDate(playlist.게시일시Utc)}")</small>
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </button>
                    }
                }
            </aside>

            <main class="prajna-library__viewer">
                @if (selectedPlaylist is null)
                {
                    <div class="prajna-library__state">
                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" />
                        <strong>왼쪽에서 강의 재생목록을 선택하세요.</strong>
                    </div>
                }
                else
                {
                    <header class="prajna-library__playlist-header">
                        <div>
                            <span>선택한 재생목록</span>
                            <h2>@selectedPlaylist.제목</h2>
                            <p>@PlaylistDescription</p>
                        </div>
                        <a href="@selectedPlaylist.재생목록Url" target="_blank" rel="noopener noreferrer">
                            전체 목록
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                        </a>
                    </header>

                    @if (isVideosLoading)
                    {
                        <div class="prajna-library__state prajna-library__state--compact" aria-live="polite">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                            <strong>영상 목록을 불러오는 중입니다.</strong>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(videoErrorMessage))
                    {
                        <div class="prajna-library__state prajna-library__state--error prajna-library__state--compact" role="alert">
                            <strong>@videoErrorMessage</strong>
                            <button type="button" @onclick="@(() => SelectPlaylistAsync(selectedPlaylist, true))">다시 시도</button>
                        </div>
                    }
                    else if (selectedVideo is null)
                    {
                        <div class="prajna-library__state prajna-library__state--compact">
                            <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Size="Size.Large" />
                            <strong>이 재생목록에는 현재 표시할 영상이 없습니다.</strong>
                        </div>
                    }
                    else
                    {
                        <div class="prajna-library__player">
                            <iframe src="@SelectedVideoEmbedUrl"
                                    title="@($"{selectedVideo.제목} 영상 재생")"
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen></iframe>
                        </div>
                        <div class="prajna-library__now-playing">
                            <div>
                                <span>지금 선택한 강의</span>
                                <h3>@selectedVideo.제목</h3>
                                <small>@FormatDate(selectedVideo.게시일시Utc)</small>
                            </div>
                            <a href="@selectedVideo.시청Url" target="_blank" rel="noopener noreferrer">
                                YouTube에서 보기
                                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                            </a>
                        </div>

                        <section class="prajna-library__community-share" aria-label="강의 글귀 커뮤니티 공유">
                            <div class="prajna-library__community-share-intro">
                                <span class="prajna-library__community-share-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Medium" />
                                </span>
                                <div>
                                    <strong>마음에 남은 글귀가 있나요?</strong>
                                    <p>강의 출처와 함께 내 커뮤니티 게시판에서 생각을 나눌 수 있습니다.</p>
                                </div>
                                <button type="button"
                                        class="prajna-library__community-share-open"
                                        aria-expanded="@isShareComposerOpen"
                                        @onclick="ToggleShareComposer">
                                    @(isShareComposerOpen ? "접기" : "글귀 나누기")
                                </button>
                            </div>

                            @if (isShareComposerOpen)
                            {
                                <div class="prajna-library__community-share-form">
                                    <label class="prajna-library__community-share-field prajna-library__community-share-field--wide">
                                        <span>마음에 남은 글귀 <b>필수</b></span>
                                        <textarea rows="3"
                                                  maxlength="800"
                                                  placeholder="영상에서 마음에 남은 말을 짧게 적어 주세요."
                                                  @bind="shareQuote"
                                                  @bind:event="oninput"></textarea>
                                    </label>
                                    <label class="prajna-library__community-share-field prajna-library__community-share-field--wide">
                                        <span>나의 생각 <small>선택</small></span>
                                        <textarea rows="3"
                                                  maxlength="1800"
                                                  placeholder="왜 마음에 남았는지, 삶에서 어떻게 살펴보고 싶은지 적어 보세요."
                                                  @bind="shareReflection"
                                                  @bind:event="oninput"></textarea>
                                    </label>
                                    <label class="prajna-library__community-share-field">
                                        <span>영상 위치 <small>선택</small></span>
                                        <input type="text"
                                               inputmode="numeric"
                                               maxlength="8"
                                               placeholder="예: 12:34"
                                               @bind="shareTimestamp"
                                               @bind:event="oninput" />
                                    </label>
                                    <div class="prajna-library__community-share-source">
                                        <MudIcon Icon="@Icons.Material.Filled.PlayCircleOutline" Size="Size.Small" />
                                        <span>
                                            <small>함께 공유되는 강의</small>
                                            <strong>@selectedVideo.제목</strong>
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(shareValidationMessage))
                                    {
                                        <p class="prajna-library__community-share-error" role="alert">@shareValidationMessage</p>
                                    }

                                    <div class="prajna-library__community-share-actions">
                                        <span>게시판에서 익명 닉네임과 공개할 내용을 확인한 뒤 등록합니다.</span>
                                        <button type="button"
                                                class="prajna-library__community-share-continue"
                                                @onclick="ContinueToCommunity">
                                            커뮤니티 글로 이어쓰기
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                        </button>
                                    </div>
                                </div>
                            }
                        </section>

                        <div class="prajna-library__videos" aria-label="재생목록 영상">
                            @foreach (var video in videos)
                            {
                                <button type="button"
                                        class="@BuildVideoClass(video)"
                                        aria-pressed="@IsSelected(video)"
                                        @onclick="@(() => SelectVideo(video))">
                                    <span class="prajna-library__video-thumb">
                                        @if (!string.IsNullOrWhiteSpace(video.썸네일Url))
                                        {
                                            <img src="@video.썸네일Url" alt="" loading="lazy" />
                                        }
                                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Medium" />
                                    </span>
                                    <span>
                                        <strong>@video.제목</strong>
                                        <small>@FormatDate(video.게시일시Utc)</small>
                                    </span>
                                </button>
                            }
                        </div>
                    }
                }
            </main>
        </div>
    }
</section>

@code {
    [Parameter]
    public string ChannelId { get; set; } = YouTube공개콘텐츠Service.홍익학당ChannelId;

    [Parameter]
    public string ChannelName { get; set; } = "홍익학당";

    [Parameter]
    public string CommunityHref { get; set; } = "/";

    private readonly CancellationTokenSource lifetimeCancellation = new();
    private IReadOnlyList<YouTube재생목록Dto> playlists = [];
    private IReadOnlyList<YouTube재생목록영상Dto> videos = [];
    private YouTube재생목록Dto? selectedPlaylist;
    private YouTube재생목록영상Dto? selectedVideo;
    private string searchText = string.Empty;
    private string? errorMessage;
    private string? videoErrorMessage;
    private string shareQuote = string.Empty;
    private string shareReflection = string.Empty;
    private string shareTimestamp = string.Empty;
    private string? shareValidationMessage;
    private bool isLoading = true;
    private bool isVideosLoading;
    private bool isShareComposerOpen;
    private int videoLoadVersion;

    private string ChannelUrl => $"https://www.youtube.com/channel/{Uri.EscapeDataString(ChannelId)}";

    private string SelectedVideoEmbedUrl => selectedVideo is null
        ? string.Empty
        : $"https://www.youtube-nocookie.com/embed/{Uri.EscapeDataString(selectedVideo.VideoId)}?rel=0";

    private string PlaylistDescription => string.IsNullOrWhiteSpace(selectedPlaylist?.설명)
        ? "재생목록의 강의를 차례로 살펴보세요."
        : selectedPlaylist.설명;

    private IReadOnlyList<YouTube재생목록Dto> FilteredPlaylists
        => string.IsNullOrWhiteSpace(searchText)
            ? playlists
            : playlists.Where(playlist =>
                    playlist.제목.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    playlist.설명.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToArray();

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        selectedPlaylist = null;
        selectedVideo = null;
        videos = [];
        ResetShareComposer();

        try
        {
            playlists = await YouTubeContent.재생목록조회Async(ChannelId, lifetimeCancellation.Token);
            var firstPlaylist = playlists.FirstOrDefault(x => x.영상수 > 0) ?? playlists.FirstOrDefault();
            if (firstPlaylist is not null)
            {
                await SelectPlaylistAsync(firstPlaylist);
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch
        {
            playlists = [];
            errorMessage = "서버 연결과 YouTube Data API 설정을 확인한 뒤 다시 시도해 주세요.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectPlaylistAsync(YouTube재생목록Dto playlist, bool forceReload = false)
    {
        if (!forceReload && IsSelected(playlist) && videos.Count > 0)
        {
            return;
        }

        selectedPlaylist = playlist;
        selectedVideo = null;
        videos = [];
        ResetShareComposer();
        videoErrorMessage = null;
        isVideosLoading = true;
        var currentVersion = ++videoLoadVersion;

        try
        {
            var loadedVideos = await YouTubeContent.재생목록영상조회Async(
                playlist.PlaylistId,
                50,
                lifetimeCancellation.Token);
            if (currentVersion != videoLoadVersion)
            {
                return;
            }

            videos = loadedVideos;
            selectedVideo = videos.FirstOrDefault();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch
        {
            if (currentVersion == videoLoadVersion)
            {
                videoErrorMessage = "이 재생목록의 영상을 불러오지 못했습니다.";
            }
        }
        finally
        {
            if (currentVersion == videoLoadVersion)
            {
                isVideosLoading = false;
            }
        }
    }

    private void SelectVideo(YouTube재생목록영상Dto video)
    {
        if (!IsSelected(video))
        {
            ResetShareComposer();
        }

        selectedVideo = video;
    }

    private void ToggleShareComposer()
    {
        isShareComposerOpen = !isShareComposerOpen;
        shareValidationMessage = null;
    }

    private void ContinueToCommunity()
    {
        if (selectedPlaylist is null || selectedVideo is null)
        {
            shareValidationMessage = "공유할 강의를 먼저 선택해 주세요.";
            return;
        }

        try
        {
            var draft = PrajnaLectureCommunityShareDraftFactory.Create(
                ChannelName,
                selectedPlaylist.제목,
                selectedVideo.제목,
                selectedVideo.시청Url,
                shareQuote,
                shareReflection,
                shareTimestamp);
            CommunityPostDrafts.Prepare(draft);
            Navigation.NavigateTo(CommunityHref);
        }
        catch (ArgumentException ex)
        {
            shareValidationMessage = ex.Message;
        }
        catch (OverflowException)
        {
            shareValidationMessage = "영상 위치가 너무 큽니다. 시:분:초 형식을 확인해 주세요.";
        }
    }

    private void ResetShareComposer()
    {
        isShareComposerOpen = false;
        shareQuote = string.Empty;
        shareReflection = string.Empty;
        shareTimestamp = string.Empty;
        shareValidationMessage = null;
    }

    private bool IsSelected(YouTube재생목록Dto playlist)
        => string.Equals(selectedPlaylist?.PlaylistId, playlist.PlaylistId, StringComparison.Ordinal);

    private bool IsSelected(YouTube재생목록영상Dto video)
        => string.Equals(selectedVideo?.VideoId, video.VideoId, StringComparison.Ordinal);

    private string BuildPlaylistClass(YouTube재생목록Dto playlist)
        => IsSelected(playlist)
            ? "prajna-library__playlist prajna-library__playlist--selected"
            : "prajna-library__playlist";

    private string BuildVideoClass(YouTube재생목록영상Dto video)
        => IsSelected(video)
            ? "prajna-library__video prajna-library__video--selected"
            : "prajna-library__video";

    private static string FormatDate(DateTime value)
        => value.ToLocalTime().ToString("yyyy.MM.dd");

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
