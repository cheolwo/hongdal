<MudContainer MaxWidth="MaxWidth.False" Class="@ContainerClass">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@Title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">상차지 주소</MudText>
                        <HongdalAddressInput Value="@PickupAddress" ValueChanged="SetPickupAddressAsync" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">하차지 주소</MudText>
                        <HongdalAddressInput Value="@DropoffAddress" ValueChanged="SetDropoffAddressAsync" />
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">사업자등록번호</MudText>
                        <BusinessNumberInput Value="@BusinessNumber" ValueChanged="SetBusinessNumberAsync" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Saving">
                @(Saving ? SavingText : SaveText)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetAsync" Disabled="@Saving">
                @ResetText
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudAlert Severity="@MessageSeverity">@Message</MudAlert>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string Title { get; set; } = "상차/하차 주소 입력 폼";

    [Parameter]
    public string Subtitle { get; set; } = "공통 주소 컴포넌트(HongdalAddressInput)와 사업자등록번호 컴포넌트(BusinessNumberInput) 적용 예시다.";

    [Parameter]
    public string ContainerClass { get; set; } = "py-4";

    [Parameter]
    public 주소입력값Dto PickupAddress { get; set; } = new();

    [Parameter]
    public EventCallback<주소입력값Dto> PickupAddressChanged { get; set; }

    [Parameter]
    public 주소입력값Dto DropoffAddress { get; set; } = new();

    [Parameter]
    public EventCallback<주소입력값Dto> DropoffAddressChanged { get; set; }

    [Parameter]
    public 사업자등록번호입력값Dto BusinessNumber { get; set; } = new();

    [Parameter]
    public EventCallback<사업자등록번호입력값Dto> BusinessNumberChanged { get; set; }

    [Parameter]
    public bool Saving { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public Severity MessageSeverity { get; set; } = Severity.Info;

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public string SaveText { get; set; } = "저장";

    [Parameter]
    public string SavingText { get; set; } = "저장 중...";

    [Parameter]
    public string ResetText { get; set; } = "초기화";

    private Task SetPickupAddressAsync(주소입력값Dto value)
        => PickupAddressChanged.InvokeAsync(value);

    private Task SetDropoffAddressAsync(주소입력값Dto value)
        => DropoffAddressChanged.InvokeAsync(value);

    private Task SetBusinessNumberAsync(사업자등록번호입력값Dto value)
        => BusinessNumberChanged.InvokeAsync(value);

    private Task SaveAsync()
        => OnSave.InvokeAsync();

    private Task ResetAsync()
        => OnReset.InvokeAsync();
}
