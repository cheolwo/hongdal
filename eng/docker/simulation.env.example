# 이 파일의 값을 저장소 루트 .env에 옮겨 로컬에서만 사용한다.
# 실제 비밀번호나 운영 연결 문자열을 이 예시 파일에 기록하지 않는다.
SSALDDEL_MYSQL_ROOT_PASSWORD=replace-with-local-root-password
SSALDDEL_SIMULATION_PUBLIC_DATA_USER=ssalddel_simulation_reader
SSALDDEL_SIMULATION_PUBLIC_DATA_PASSWORD=replace-with-local-reader-password
SSALDDEL_SIMULATION_PUBLIC_DATA_DATABASE=ssalddel_dev
SSALDDEL_SIMULATION_WORLD_USER=ssalddel_simulation_world
SSALDDEL_SIMULATION_WORLD_PASSWORD=replace-with-local-world-password
SSALDDEL_SIMULATION_SESSION_USER=ssalddel_simulation_session
SSALDDEL_SIMULATION_SESSION_PASSWORD=replace-with-local-session-password
SSALDDEL_SIMULATION_BIND_ADDRESS=127.0.0.1
SSALDDEL_SIMULATION_PORT=5204
SSALDDEL_SIMULATION_PUBLIC_DATA_MAX_ITEMS=50
SSALDDEL_SIMULATION_SESSION_DATABASE_ENABLED=true
