    "delegationAndDelegatedActionAreSeparateResponsibilities": true,
    "automaticTaskPhaseIsNotWorldInteraction": true,
    "actorWorkCannotRemainWorldAutomatic": true,
    "legacyInlineFlowHintsAreNonAuthoritative": true
  },
