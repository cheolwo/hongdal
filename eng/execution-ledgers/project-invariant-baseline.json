    {
      "id": "INV-COMPAT-01",
      "category": "Compatibility",
      "koreanName": "공개 계약과 저장 호환",
      "owners": ["Integration", "Simulation", "Operations", "Unity"],
      "rule": "공개 Stable ID, API, 직렬화, Save와 Replay hash 의미는 명시적인 Migration과 소비자 회귀 없이 변경하지 않는다.",
      "changePolicy": "AcceptedDecisionAndCompatibilityPlan",
      "guardReferences": [
        "docs/Architecture/E9하향식수직구현체계.md",
        "Ssalddel.Simulation.Contracts/UnityPackage/Runtime/SimulationSaveReplayContracts.cs"
      ]
    }
  ]
}
