      ]
    },
    {
      "id": "INV-WORLD-01",
      "category": "World",
      "koreanName": "단일 공식 Scene과 독립 영역 폐루프",
      "owners": ["Simulation", "Unity"],
      "rule": "SimulationWorldShell을 단일 공식 진입점으로 유지하고 Nature와 업무 영역의 기준 왕복 및 각 업무 영역의 독립 폐루프를 먼저 검증한다.",
      "changePolicy": "AcceptedDecisionAndCompatibilityPlan",
      "guardReferences": [
        "docs/Architecture/FarmHubCity독립영역우선개발정책.md",
        "docs/AI/authority-maps/00_GAME_DESIGN_TREE.md"
      ]
