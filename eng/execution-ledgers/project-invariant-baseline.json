    {
      "id": "INV-CORE-01",
      "category": "Execution",
      "koreanName": "Solo·Hosted 공통 Simulation Core",
      "owners": ["Simulation", "Unity"],
      "rule": "Solo LocalProcess와 Hosted RemoteHost는 같은 Simulation Core를 실행하며 Unity GameObject는 권위가 아니다.",
      "changePolicy": "AcceptedDecisionAndCompatibilityPlan",
      "guardReferences": [
        "docs/Architecture/SoloFirstSimulationRuntime.md",
        "Ssalddel.Simulation.Application/RuntimeCore/SimulationRuntime.cs"
      ]
    },
    {
