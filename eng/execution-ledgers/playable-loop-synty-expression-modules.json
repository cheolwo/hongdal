{
  "schemaVersion": "playable-loop-synty-expression-modules.v1",
  "revision": "playable-loop-synty-expression-modules.r1",
  "playableLoopCatalogPath": "eng/execution-ledgers/playable-loops.json",
  "worldInteractionCatalogPath": "eng/execution-ledgers/world-interactions.json",
  "principles": {
    "playableUnitOwnsExpressionModule": true,
    "loopMomentAndPlacementRoleReplaceForcedVariantTriples": true,
    "assetFamilyPrecedesPrefabSelection": true,
    "selectionIsDeterministic": true,
    "presentationDoesNotMutateSimulationAuthority": true,
    "missingCandidateIsExplicitInsteadOfForced": true,
    "legacyCompositionKeysAreReadOnlyCompatibilityInputs": true
  },
  "allowedLoopMomentCodes": [
    "Entry",
    "Choice",
    "Progress",
    "Success",
    "FailureRecovery",
    "Return"
  ],
  "allowedPlacementRoleCodes": [
    "spatial-base",
    "functional-anchor",
    "state-overlay",
    "ambient-detail",
    "interior-fixture",
    "interior-loose-item",
    "feedback-fx",
    "actor"
  ],
  "legacyCompositionPolicy": {
    "statusCode": "LegacyGenerated",
    "canonicalForNewWork": false,
    "newGenerationAllowed": false,
    "readCompatibilityRequired": true,
    "forcedVariantCompletenessRequired": false,
    "cleanupGateCodes": [
      "NoActivePlayableLoopModuleReadsLegacyCompositionKey",
      "NoCanonicalSceneOrSeedbedReferencesGeneratedPrefab",
      "UsefulTopologyAndClearanceRulesMigrated",
      "CompatibilityTestsPassed"
    ]
  },
  "packPolicies": [
    {
      "packCode": "nature",
      "usagePolicyCode": "ProductionPrimary",
      "defaultRoles": ["spatial-base", "ambient-detail", "feedback-fx"]
    },
    {
      "packCode": "farm",
      "usagePolicyCode": "ProductionPrimary",
      "defaultRoles": ["functional-anchor", "interior-fixture", "interior-loose-item"]
    },
    {
      "packCode": "town",
      "usagePolicyCode": "ProductionPrimary",
      "defaultRoles": ["interior-fixture", "interior-loose-item", "functional-anchor"]
    },
    {
      "packCode": "city",
      "usagePolicyCode": "ProductionPrimary",
      "defaultRoles": ["spatial-base", "functional-anchor", "ambient-detail"]
    },
    {
      "packCode": "construction",
      "usagePolicyCode": "SharedStateLayer",
      "defaultRoles": ["state-overlay", "functional-anchor", "interior-loose-item"]
    },
    {
      "packCode": "generic",
      "usagePolicyCode": "SharedBasePendingInventory",
      "defaultRoles": ["spatial-base", "functional-anchor"]
    },
    {
      "packCode": "starter",
      "usagePolicyCode": "PrototypeFallbackOnly",
      "defaultRoles": []
    }
  ],
