  "admissionRules": {
    "interactionH1RequiresExistingWiOrAnticipatedGameplay": true,
    "packExpressionH1RequiresCompatibleInteractionH1": true,
    "h2RequiresChildH1AndGamePlan": true,
    "h1RecognitionIsSufficientForH2Composition": true,
    "h1OfficialSimulationApprovalIsNotRequiredForH2Composition": true,
    "h2IsFirstSpatialCompositionJudgmentSurface": true,
