  "compositionMaturityModel": {
    "h1RecognizedPart": "H1은 공간 부품의 의미·표현 후보·게임 맥락이 식별된 상태다. H2 조합 입력이 되기 위해 별도 Simulation 승인을 요구하지 않는다.",
    "h2Composable": "필수 H1 두 개 이상이 모두 존재하고 게임 기획 묶음 안에서 조합 목적을 설명할 수 있는 상태다.",
    "h2ReviewReady": "결정적인 상대 배치·위상·내부 관계·외부 연결구·크기 제약과 Unity 조합 Root·표준 5시점 촬영이 준비된 상태다.",
    "h2Approved": "사람이 H2 조합물 자체를 검토해 승인한 위치 독립 블록 정의다. 실제 AreaSet 배치나 WI E단계는 별도다.",
    "h2TheoryQualified": "게임 맥락·위상·상대 배치·충돌·연결·입출구·결정성 관문을 통과한 자동 생산 블록이다. 사람 검토 없이 H3 입력으로 사용할 수 있다.",
    "h3TheoryQualified": "필수 H2의 이론 적격 상태와 블록 이동 폐루프를 통과한 자동 생산 경관이다.",
    "e5TheoryQualified": "명시적 H4 세계 의도에서 특정 Theory AreaSet·Graph 인스턴스와 관계를 결정적으로 만든 상태다. E6 공공데이터와 E7 실제 플레이는 주장하지 않는다."
  },
  "humanReviewPolicy": {
    "blocking": false,
    "modeCode": "DeferredBatchReview",
    "automaticHumanApprovalClaimForbidden": true,
    "theoryFactoryMayContinueThroughH3AndE5": true
  },
