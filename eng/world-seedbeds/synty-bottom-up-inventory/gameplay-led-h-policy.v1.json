    "h3TheoryQualificationDoesNotRequireHumanReview": true,
    "e5TheoryQualificationDoesNotRequireHumanReview": true,
    "h3RequiresChildH2AndGamePlan": true,
    "packNativeH2MayStageBeforeH3": true,
    "h4RequiresGamePlanRole": true,
    "publicDataFieldsForbiddenInHDefinitions": true,
    "orphanDispositionCode": "QuarantineAsIdeaInventory",
