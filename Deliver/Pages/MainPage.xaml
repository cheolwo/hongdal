<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Deliver.PageModels"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             x:Class="Deliver.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             Title="{Binding AppName}">

    <pullToRefresh:SfPullToRefresh
        IsRefreshing="{Binding IsRefreshing}"
        RefreshCommand="{Binding RefreshCommand}">
        <pullToRefresh:SfPullToRefresh.PullableContent>
            <ScrollView>
                <Grid Padding="18" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding AppName}" FontSize="24" FontAttributes="Bold" />
                                <Label Text="{Binding DriverRole}" FontSize="13" TextColor="#6B7280" />
                                <Label Text="{Binding CurrentArea}" FontSize="15" />
                                <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="#374151" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                <Label Text="{Binding Today}" FontSize="12" TextColor="#6B7280" HorizontalTextAlignment="End" />
                                <Label Text="{Binding PendingDeliveryTickets, StringFormat='대기 {0}건'}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                <Label Text="{Binding RecommendedTickets, StringFormat='추천 {0}건'}" FontSize="13" TextColor="#2563EB" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#F9FAFB" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="오늘 예상 정산" FontSize="13" TextColor="#6B7280" />
                                <Label Text="{Binding TodayExpectedPayout, StringFormat='{0:N0}원'}" FontSize="22" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#F9FAFB" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="운영 기준" FontSize="13" TextColor="#6B7280" />
                                <Label Text="권역 우선" FontSize="20" FontAttributes="Bold" />
                                <Label Text="근거리 후 거리 정렬" FontSize="12" TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <Label Text="추천 배달권" FontSize="18" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding RecommendedTicketItems}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="pageModels:DeliveryTicketPreview">
                                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="14" Margin="0,0,0,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding OrderSummary}" FontSize="16" FontAttributes="Bold" />
                                                <Label Text="{Binding RestaurantName}" FontSize="13" TextColor="#374151" />
                                                <Label Text="{Binding DropoffAddress}" FontSize="13" TextColor="#6B7280" />
                                                <Label Text="{Binding RecommendationReason}" FontSize="12" TextColor="#2563EB" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                                <Label Text="{Binding DistanceText}" FontSize="13" HorizontalTextAlignment="End" />
                                                <Label Text="{Binding DriverPayoutText}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                                <Button Text="선택"
                                                        Padding="12,6"
                                                        Command="{Binding BindingContext.SelectTicketCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Border Grid.Row="3" Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="#EFF6FF" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="선택된 배달권" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding SelectedTicket.TicketId, TargetNullValue='선택된 배달권 없음'}" FontSize="13" />
                            <Button Text="배달권 수락"
                                    Command="{Binding AcceptSelectedTicketCommand}"
                                    BackgroundColor="#2563EB"
                                    TextColor="#FFFFFF" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ScrollView>
        </pullToRefresh:SfPullToRefresh.PullableContent>
    </pullToRefresh:SfPullToRefresh>
</ContentPage>
