<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:HongdalRestaurantDesktop.ViewModels"
		mc:Ignorable="d"
		x:Class="HongdalRestaurantDesktop.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Width="1100" Height="700"
		Title="홍달 음식점 Desktop">
  <Grid RowDefinitions="Auto,*" Margin="24">
	<StackPanel Spacing="8">
	  <TextBlock Text="홍달 음식점 Desktop" FontSize="30" FontWeight="Bold" />
	  <TextBlock Text="Avalonia MVVM 템플릿 기반 시작 화면" Opacity="0.7" />
	</StackPanel>

	<Border Grid.Row="1" Margin="0,24,0,0" Padding="24" CornerRadius="12" Background="#F5F5F7">
	  <StackPanel Spacing="16">
		<TextBlock Text="대시보드" FontSize="22" FontWeight="SemiBold" />
		<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
		  <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,12">
			<StackPanel>
			  <TextBlock Text="오늘 주문" Opacity="0.7" />
			  <TextBlock Text="128건" FontSize="26" FontWeight="Bold" />
			</StackPanel>
		  </Border>
		  <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,12">
			<StackPanel>
			  <TextBlock Text="활성 테이블" Opacity="0.7" />
			  <TextBlock Text="24개" FontSize="26" FontWeight="Bold" />
			</StackPanel>
		  </Border>
		  <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
			<StackPanel>
			  <TextBlock Text="대기 중 결제" Opacity="0.7" />
			  <TextBlock Text="7건" FontSize="26" FontWeight="Bold" />
			</StackPanel>
		  </Border>
		</Grid>

		<TextBlock Text="{Binding Greeting}" FontSize="16" />
	  </StackPanel>
	</Border>
  </Grid>
</Window>
