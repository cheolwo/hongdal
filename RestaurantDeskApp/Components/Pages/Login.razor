@page "/login"
@inject RestaurantAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>음식점 로그인</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="1" Class="pa-6">
        <MudStack Spacing="3">
            <div>
                <MudText Typo="Typo.h4">살뜰 식당 로그인</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    음식점 권한과 서버에 연결된 음식점 범위가 있는 계정으로 로그인합니다.
                </MudText>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="Severity.Error">@message</MudAlert>
            }

            <MudTextField T="string"
                          @bind-Value="userName"
                          Label="아이디 또는 이메일"
                          Variant="Variant.Outlined"
                          Disabled="@isBusy" />
            <MudTextField T="string"
                          @bind-Value="password"
                          Label="비밀번호"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Disabled="@isBusy" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@isBusy"
                       OnClick="LoginAsync">
                @(isBusy ? "로그인 확인 중" : "로그인")
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string userName = string.Empty;
    private string password = string.Empty;
    private string? message;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        var result = await AuthService.EnsureAccessTokenAsync();
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task LoginAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        message = null;
        try
        {
            var result = await AuthService.LoginAsync(userName, password);
            if (!result.IsSuccess)
            {
                message = result.ErrorMessage;
                return;
            }

            Navigation.NavigateTo("/");
        }
        finally
        {
            isBusy = false;
        }
    }
}
