@page "/restaurants/popular"
@inject RestaurantDeskSampleService SampleService

<PageTitle>인기 음식점 흐름</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-1">평점과 리뷰 수 기반 인기 음식점</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">평점이 높고 리뷰 수가 많은 음식점을 우선 노출하는 흐름 예시다.</MudText>

    <MudTable Items="items" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>음식점</MudTh>
            <MudTh>카테고리</MudTh>
            <MudTh>평균평점</MudTh>
            <MudTh>리뷰수</MudTh>
            <MudTh>주문 가능</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="음식점">@context.상호명</MudTd>
            <MudTd DataLabel="카테고리">@context.카테고리</MudTd>
            <MudTd DataLabel="평균평점">@context.평균평점</MudTd>
            <MudTd DataLabel="리뷰수">@context.리뷰수</MudTd>
            <MudTd DataLabel="주문 가능">@(context.주문가능여부 ? "가능" : "중지")</MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private IReadOnlyList<음식점요약응답> items = [];

    protected override void OnInitialized()
    {
        items = SampleService.Get인기음식점목록();
    }
}
