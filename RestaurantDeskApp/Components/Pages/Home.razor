@page "/"

<PageTitle>음식점 운영 홈</PageTitle>

<PlatformCommunityHome AppName="Restaurant Desk"
                       RoleLabel="음식점 운영"
                       AppKey="restaurant-desk"
                       QuickActions="QuickActions">
    <WorkModeContent>
        <MudStack Spacing="3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">음식점 운영 홈</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    이 화면은 업무 진입점만 제공합니다. 주문 조회와 주문 수락은 서로 분리된 전용 화면에서 처리합니다.
                </MudText>
            </MudStack>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                3.0 미리보기는 <strong>Simulation</strong> 경계입니다. 신규 주문은 서버 실시간 알림으로만 수신하며
                샘플 주문을 운영 데이터처럼 대체하지 않습니다.
            </MudAlert>

            <MudGrid>
                @foreach (var action in QuickActions)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                            <MudStack Spacing="2" Class="h-100">
                                <MudIcon Icon="@action.Icon" Color="@action.Color" Size="Size.Large" />
                                <MudStack Spacing="0" Class="flex-grow-1">
                                    <MudText Typo="Typo.h6">@action.Title</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                </MudStack>
                                <MudButton Href="@action.Href"
                                           Variant="Variant.Filled"
                                           Color="@action.Color"
                                           EndIcon="@Icons.Material.Filled.ChevronRight">
                                    화면 열기
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudStack>
    </WorkModeContent>
</PlatformCommunityHome>

<AppContextImageWall AppPackId="restaurant-desk"
                     Title="음식점과 식재료 이야기" />

@code {
    private static readonly IReadOnlyList<PlatformHomeQuickAction> QuickActions =
    [
        new("신규 주문 수신함", "실시간으로 받은 주문을 조회하고 정확한 주문번호의 상세 화면으로 이동합니다.", "/orders", Icons.Material.Filled.ReceiptLong, Color.Primary),
        new("조리시간 기본값", "음식점 전체 기본시간과 상품별 조리시간을 저장해 신규 주문 추천값으로 사용합니다.", "/settings/preparation-times", Icons.Material.Filled.Timer, Color.Info),
        new("식재료 공급 요청", "국내 산지와 수입 공동공급 조건을 비교합니다.", "/ingredients/supply-request", Icons.Material.Filled.Inventory2, Color.Warning),
        new("가까운 음식점", "근거리 공개 노출 흐름을 읽기 전용으로 점검합니다.", "/restaurants/nearby", Icons.Material.Filled.NearMe, Color.Info),
        new("리뷰 운영", "저평점 사진 리뷰와 게시 정책을 별도 화면에서 관리합니다.", "/reviews/moderation", Icons.Material.Filled.RateReview, Color.Secondary)
    ];
}
