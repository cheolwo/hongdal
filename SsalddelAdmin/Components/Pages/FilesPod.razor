@page "/files/pod"
@inject I백오피스Service DataService

<PageTitle>08. 파일/POD</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">08. 파일/POD</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">상차·하차 증빙 파일을 업로드하고 검수 상태를 확인합니다.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync">
            새로고침
        </MudButton>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">파일 업로드</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="3">
                    <MudTextField Label="파일 타입" Variant="Variant.Outlined" @bind-Value="uploadFileType" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="의뢰ID" Variant="Variant.Outlined" @bind-Value="uploadRequestId" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">파일</MudText>
                        <InputFile OnChange="OnFileSelected" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       Disabled="@isUploading"
                       OnClick="UploadAsync">
                업로드
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="@MessageSeverity">@message</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">POD 파일 목록</MudText>
            @if (items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">등록된 POD 파일이 없습니다.</MudAlert>
            }
            else
            {
                <MudTable Items="@items" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>업로드시각</MudTh>
                        <MudTh>파일타입</MudTh>
                        <MudTh>의뢰ID</MudTh>
                        <MudTh>파일명</MudTh>
                        <MudTh>상태</MudTh>
                        <MudTh>작업</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="업로드시각">@context.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd DataLabel="파일타입">@context.FileType</MudTd>
                        <MudTd DataLabel="의뢰ID">@context.RequestId</MudTd>
                        <MudTd DataLabel="파일명">@context.OriginalFileName</MudTd>
                        <MudTd DataLabel="상태">
                            <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.UploadStatus)" Variant="Variant.Filled">
                                @context.UploadStatus
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="작업">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       OnClick="@(() => ChangeStatusAsync(context.Id, 검수완료상태))">
                                검수완료
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private const string 검수완료상태 = "검수완료";

    private bool isUploading;
    private bool isError;
    private string? message;
    private string uploadFileType = "첨부파일";
    private string? uploadRequestId;
    private IBrowserFile? selectedFile;
    private IReadOnlyList<파일POD응답> items = [];
    private Severity MessageSeverity => isError ? Severity.Error : Severity.Success;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => items = await DataService.파일POD목록조회Async();

    private void OnFileSelected(InputFileChangeEventArgs e) => selectedFile = e.File;

    private async Task UploadAsync()
    {
        if (selectedFile is null)
        {
            isError = true;
            message = "파일을 선택하세요.";
            return;
        }

        isUploading = true;
        await using var stream = selectedFile.OpenReadStream(50_000_000);
        await DataService.파일POD업로드Async(stream, selectedFile.Name, selectedFile.ContentType, uploadFileType, uploadRequestId);
        selectedFile = null;
        isUploading = false;
        isError = false;
        message = "파일을 업로드했습니다.";
        await LoadAsync();
    }

    private async Task ChangeStatusAsync(Guid id, string status)
    {
        await DataService.파일POD상태변경Async(id, status);
        isError = false;
        message = "상태를 변경했습니다.";
        await LoadAsync();
    }
}
