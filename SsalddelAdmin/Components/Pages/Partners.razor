@page "/partners"
@inject I백오피스Service DataService

<PageTitle>11. 업체/화주 관리</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">11. 업체/화주 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">업체 상태와 화주 계정을 함께 확인합니다.</MudText>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField Label="업체 상태" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="statusFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" OnClick="LoadAsync">조회</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">업체 목록</MudText>
                    @if (companies.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">조회된 업체가 없습니다.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@companies" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>업체명</MudTh>
                                <MudTh>상태</MudTh>
                                <MudTh>연락처</MudTh>
                                <MudTh>담당자</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="업체명">@context.업체명</MudTd>
                                <MudTd DataLabel="상태">
                                    <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.상태)" Variant="Variant.Filled">@context.상태</MudChip>
                                </MudTd>
                                <MudTd DataLabel="연락처">@context.대표연락처</MudTd>
                                <MudTd DataLabel="담당자">@context.담당자</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">화주 계정</MudText>
                    @if (shippers.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">조회된 화주 계정이 없습니다.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@shippers" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>사용자명</MudTh>
                                <MudTh>이메일</MudTh>
                                <MudTh>연락처</MudTh>
                                <MudTh>의뢰건수</MudTh>
                                <MudTh>상태</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="사용자명">@context.사용자명</MudTd>
                                <MudTd DataLabel="이메일">@context.이메일</MudTd>
                                <MudTd DataLabel="연락처">@context.연락처</MudTd>
                                <MudTd DataLabel="의뢰건수">@context.의뢰건수</MudTd>
                                <MudTd DataLabel="상태">
                                    <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.거래상태)" Variant="Variant.Filled">@context.거래상태</MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private string? statusFilter;
    private IReadOnlyList<업체관리응답> companies = [];
    private IReadOnlyList<화주관리응답> shippers = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        companies = await DataService.업체목록조회Async(statusFilter);
        shippers = await DataService.화주목록조회Async();
    }
}
