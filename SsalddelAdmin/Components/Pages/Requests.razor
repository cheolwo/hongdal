@page "/requests"
@inject I백오피스Service DataService

<PageTitle>04. 의뢰 관리</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">04. 의뢰 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">화주 의뢰의 결제, 배차, 관제 연결 상태를 확인합니다.</MudText>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField Label="결제상태" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="paymentFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField Label="배차상태" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="dispatchFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Disabled="@isLoading" FullWidth="true" OnClick="LoadAsync">조회</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudAlert Severity="Severity.Info">의뢰 목록을 불러오는 중입니다...</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">의뢰 목록</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@items.Count 건</MudChip>
                </MudStack>

                @if (items.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">조회된 의뢰가 없습니다.</MudAlert>
                }
                else
                {
                    <MudTable Items="@items" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>의뢰ID</MudTh>
                            <MudTh>확인</MudTh>
                            <MudTh>결제</MudTh>
                            <MudTh>배차</MudTh>
                            <MudTh>픽업</MudTh>
                            <MudTh>하차</MudTh>
                            <MudTh>의뢰</MudTh>
                            <MudTh>관제</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="의뢰ID">@context.의뢰Id</MudTd>
                            <MudTd DataLabel="확인">
                                <MudChip T="string" Size="Size.Small" Color="@ReviewColor(context)" Variant="Variant.Filled">@ReviewLabel(context)</MudChip>
                            </MudTd>
                            <MudTd DataLabel="결제">
                                <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.결제상태)" Variant="Variant.Outlined">@context.결제상태</MudChip>
                            </MudTd>
                            <MudTd DataLabel="배차">
                                <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.배차상태)" Variant="Variant.Outlined">@context.배차상태</MudChip>
                            </MudTd>
                            <MudTd DataLabel="픽업">@(context.요약?.픽업지 ?? context.픽업지)</MudTd>
                            <MudTd DataLabel="하차">@(context.요약?.하차지 ?? context.하차지)</MudTd>
                            <MudTd DataLabel="의뢰">
                                <MudButton Href="@RequestDetailHref(context.의뢰Id)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">상세</MudButton>
                            </MudTd>
                            <MudTd DataLabel="관제">
                                <MudButton Href="@WorkflowDetailHref(context.의뢰Id)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">관제</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private bool isLoading;
    private string? paymentFilter;
    private string? dispatchFilter;
    private IReadOnlyList<화주운송의뢰응답> items = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            items = await DataService.의뢰목록조회Async(paymentFilter, dispatchFilter);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string ReviewLabel(화주운송의뢰응답 item)
    {
        if (IsMatch(item.의뢰상태, "취소", "환불"))
        {
            return "취소/환불";
        }

        if (IsMatch(item.결제상태, "결제대기", "미결제", "대기"))
        {
            return "결제확인";
        }

        if (IsMatch(item.배차상태, "매칭중", "배차대기", "대기"))
        {
            return "배차확인";
        }

        return "정상";
    }

    private static Color ReviewColor(화주운송의뢰응답 item)
        => ReviewLabel(item) switch
        {
            "취소/환불" => Color.Error,
            "결제확인" => Color.Warning,
            "배차확인" => Color.Info,
            _ => Color.Success
        };

    private static bool IsMatch(string? value, params string[] candidates)
    {
        return candidates.Any(candidate => string.Equals(value, candidate, StringComparison.OrdinalIgnoreCase));
    }

    private static string RequestDetailHref(string requestId)
        => $"/requests/{Uri.EscapeDataString(requestId)}";

    private static string WorkflowDetailHref(string requestId)
        => $"/transports/{Uri.EscapeDataString(requestId)}";
}
