@page "/dashboard"
@page "/admin/order-warehouse/dashboard"
@inject I백오피스Service DataService

<PageTitle>01. 업무 안내판</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Class="mb-3" Style="flex-wrap: wrap;">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">01. 업무 안내판</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">1.0 운송 흐름에서 막히는 운영 항목을 먼저 봅니다.</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="@isLoading"
               OnClick="LoadAsync">
        새로고침
    </MudButton>
</MudStack>

@if (isLoading)
{
    <MudAlert Severity="Severity.Info">집계 데이터를 불러오는 중입니다...</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var item in cards)
        {
            <MudItem xs="12" sm="6" md="4" xl="3">
                <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Title</MudText>
                    <MudText Typo="Typo.h4">@item.Value</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">1.0 운영 확인</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">화주-기사-수령자 운송 흐름을 막는 항목만 먼저 봅니다.</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@operationIssues.Count 건</MudChip>
                    </MudStack>

                    @if (operationIssues.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">현재 즉시 확인할 1.0 운영 항목이 없습니다.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@operationIssues" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>구분</MudTh>
                                <MudTh>대상</MudTh>
                                <MudTh>확인 내용</MudTh>
                                <MudTh>우선도</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="구분">
                                    <MudChip T="string" Size="Size.Small" Color="@IssueColor(context.Kind)" Variant="Variant.Filled">@context.Kind</MudChip>
                                </MudTd>
                                <MudTd DataLabel="대상">
                                    <MudLink Href="@WorkflowDetailHref(context.Target)">@context.Target</MudLink>
                                </MudTd>
                                <MudTd DataLabel="확인 내용">@context.Message</MudTd>
                                <MudTd DataLabel="우선도">@context.Priority</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">운송 상태 레인</MudText>
                    @foreach (var lane in statusLanes)
                    {
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2">@lane.Label</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@lane.Count</MudText>
                            </MudStack>
                            <MudProgressLinear Value="@lane.Percent" Color="@lane.Color" Rounded="true" />
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool isLoading = true;
    private 관리자대시보드요약응답 summary = new();
    private IReadOnlyList<(string Title, int Value)> cards = [];
    private IReadOnlyList<OperationIssue> operationIssues = [];
    private IReadOnlyList<StatusLane> statusLanes = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        summary = await DataService.대시보드조회Async();
        var requests = await DataService.의뢰목록조회Async();
        var dispatchWait = await DataService.배차대기목록조회Async();
        var transports = await DataService.운송진행목록조회Async();

        cards =
        [
            ("오늘 의뢰", summary.오늘의뢰수),
            ("결제 대기", summary.결제대기수),
            ("결제 완료", summary.결제완료수),
            ("배차 대기", summary.배차대기수),
            ("운송 중", summary.운송중수),
            ("관리자 확인", summary.관리자확인필요수),
            ("운송 예외", summary.운송예외수),
            ("완료", summary.완료수)
        ];

        operationIssues = BuildOperationIssues(requests, dispatchWait, transports);
        statusLanes = BuildStatusLanes(summary);
        isLoading = false;
    }

    private static IReadOnlyList<OperationIssue> BuildOperationIssues(
        IReadOnlyList<화주운송의뢰응답> requests,
        IReadOnlyList<배차대기응답> dispatchWait,
        IReadOnlyList<운송진행응답> transports)
    {
        var issues = new List<OperationIssue>();

        issues.AddRange(transports
            .Where(x => x.관리자확인필요)
            .Select(x => new OperationIssue(
                "관리자확인",
                x.운송번호,
                BuildExceptionMessage(x),
                "높음")));

        issues.AddRange(transports
            .Where(x => x.예외신고됨 && !x.관리자확인필요)
            .Select(x => new OperationIssue(
                "예외신고",
                x.운송번호,
                BuildExceptionMessage(x),
                "보통")));

        issues.AddRange(requests
            .Where(x => IsMatch(x.결제상태, "결제대기", "미결제", "대기"))
            .Select(x => new OperationIssue("결제확인", x.의뢰Id, $"{x.결제수단} 결제/후불 조건 확인", "높음")));

        issues.AddRange(dispatchWait
            .Where(x => !IsMatch(x.상태, "확정"))
            .Select(x => new OperationIssue("배차확인", x.의뢰Id, $"{x.픽업_도로명주소} → {x.하차_도로명주소}", IsMatch(x.상태, "보류") ? "높음" : "보통")));

        issues.AddRange(transports
            .Where(x => IsMatch(x.상태, "배차확정", "운송중") && x.UpdatedAt < DateTime.UtcNow.AddHours(-2))
            .Select(x => new OperationIssue("지연확인", x.운송번호, $"{x.상태} 상태가 2시간 이상 갱신되지 않았습니다.", "높음")));

        issues.AddRange(requests
            .Where(x => IsMatch(x.의뢰상태, "취소") || IsMatch(x.결제상태, "환불됨", "환불"))
            .Select(x => new OperationIssue("취소환불", x.의뢰Id, "취소/환불 후 배차와 정산 상태 확인", "높음")));

        return issues
            .OrderByDescending(x => x.Priority == "높음")
            .ThenBy(x => x.Kind)
            .Take(8)
            .ToArray();
    }

    private static IReadOnlyList<StatusLane> BuildStatusLanes(관리자대시보드요약응답 summary)
    {
        var total = Math.Max(1, summary.오늘의뢰수 + summary.배차대기수 + summary.운송중수 + summary.완료수);
        return
        [
            new("결제 대기", summary.결제대기수, Percent(summary.결제대기수, total), Color.Warning),
            new("배차 대기", summary.배차대기수, Percent(summary.배차대기수, total), Color.Info),
            new("운송 중", summary.운송중수, Percent(summary.운송중수, total), Color.Primary),
            new("관리자 확인", summary.관리자확인필요수, Percent(summary.관리자확인필요수, total), Color.Error),
            new("운송 예외", summary.운송예외수, Percent(summary.운송예외수, total), Color.Warning),
            new("완료", summary.완료수, Percent(summary.완료수, total), Color.Success),
            new("취소/환불", summary.취소환불수, Percent(summary.취소환불수, total), Color.Error)
        ];
    }

    private static string BuildExceptionMessage(운송진행응답 item)
    {
        var code = string.IsNullOrWhiteSpace(item.최근예외코드) ? "예외코드 없음" : item.최근예외코드;
        var stage = string.IsNullOrWhiteSpace(item.최근예외단계) ? "단계 미확인" : item.최근예외단계;
        var message = string.IsNullOrWhiteSpace(item.최근예외메시지) ? "기사님 예외 신고 내용을 확인하세요." : item.최근예외메시지;
        return $"{stage} · {code} · {message}";
    }

    private static int Percent(int value, int total)
        => Math.Clamp((int)Math.Round(value / (double)total * 100), 0, 100);

    private static Color IssueColor(string kind)
        => kind switch
        {
            "결제확인" => Color.Warning,
            "배차확인" => Color.Info,
            "관리자확인" => Color.Error,
            "예외신고" => Color.Warning,
            "지연확인" => Color.Error,
            "취소환불" => Color.Dark,
            _ => Color.Default
        };

    private static bool IsMatch(string? value, params string[] candidates)
        => candidates.Any(candidate => string.Equals(value, candidate, StringComparison.OrdinalIgnoreCase));

    private static string WorkflowDetailHref(string requestId)
        => $"/transports/{Uri.EscapeDataString(requestId)}";

    private sealed record OperationIssue(string Kind, string Target, string Message, string Priority);

    private sealed record StatusLane(string Label, int Count, int Percent, Color Color);
}
