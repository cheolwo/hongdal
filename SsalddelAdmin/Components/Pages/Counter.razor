@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">Counter</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">MudBlazor 동작 확인용 샘플 화면입니다.</MudText>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6" role="status">Current count: @currentCount</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="IncrementCount">Click me</MudButton>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
