@page "/drivers/operating"

<PageTitle>기사 운행 현황</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">기사 운행 현황</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">운행 중인 기사, 최근 위치, 배차 이력을 연결할 운영 화면입니다.</MudText>
    </MudStack>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        빌드 복구를 위해 기사 운행 현황 화면을 기본 운영 화면으로 정리했습니다.
    </MudAlert>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="4">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">현재 운행</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">운행 중인 기사 목록과 상태를 연결할 영역입니다.</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">위치 확인</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">기사의 최근 위치와 갱신 시각을 확인할 영역입니다.</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">배차 이력</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">선택한 기사의 최근 배차 이력을 표시할 영역입니다.</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>
