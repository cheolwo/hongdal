@page "/common-contents"
@inject I백오피스Service DataService

<PageTitle>15. 공통콘텐츠 관리</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Style="flex-wrap: wrap;">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">15. 공통콘텐츠 관리</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">기사, 화주, 운영자 화면에 공통 노출되는 콘텐츠를 관리합니다.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync">
            새로고침
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="Severity.Info">@message</MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">콘텐츠 목록</MudText>

                    @if (contents.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">등록된 공통콘텐츠가 없습니다.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@contents" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>ID</MudTh>
                                <MudTh>제목</MudTh>
                                <MudTh>유형</MudTh>
                                <MudTh>노출위치</MudTh>
                                <MudTh>활성</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="ID">@context.Id</MudTd>
                                <MudTd DataLabel="제목">@context.제목</MudTd>
                                <MudTd DataLabel="유형">@context.콘텐츠유형</MudTd>
                                <MudTd DataLabel="노출위치">@context.노출위치</MudTd>
                                <MudTd DataLabel="활성">
                                    <MudSwitch T="bool"
                                               Value="@context.활성화여부"
                                               ValueChanged="@((bool enabled) => ToggleActiveAsync(context.Id, enabled))"
                                               Color="Color.Primary" />
                                </MudTd>
                                <MudTd>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => SelectAsync(context.Id))">편집</MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">콘텐츠 등록/수정</MudText>

                    <MudTextField Label="제목" Variant="Variant.Outlined" @bind-Value="model.제목" />
                    <MudTextField Label="설명" Variant="Variant.Outlined" Lines="2" @bind-Value="model.설명" />

                    <MudSelect T="계약살뜰콘텐츠유형" Label="콘텐츠 유형" Variant="Variant.Outlined" @bind-Value="model.콘텐츠유형">
                        @foreach (var type in Enum.GetValues<계약살뜰콘텐츠유형>())
                        {
                            <MudSelectItem T="계약살뜰콘텐츠유형" Value="@type">@type</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField Label="이미지 URL" Variant="Variant.Outlined" @bind-Value="model.이미지Url" />
                    <MudTextField Label="영상 URL" Variant="Variant.Outlined" @bind-Value="model.영상Url" />
                    <MudTextField Label="외부링크 URL" Variant="Variant.Outlined" @bind-Value="model.외부링크Url" />

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">노출위치</MudText>
                        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                            @foreach (var placement in Enum.GetValues<계약살뜰노출위치>().Where(x => x != 계약살뜰노출위치.없음))
                            {
                                <MudCheckBox T="bool"
                                             Value="@HasPlacement(placement)"
                                             ValueChanged="@((bool enabled) => SetPlacement(placement, enabled))"
                                             Label="@placement.ToString()"
                                             Color="Color.Primary" />
                            }
                        </MudStack>
                    </MudStack>

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2">노출대상</MudText>
                        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                            <MudCheckBox T="bool" @bind-Value="model.기사노출" Label="기사" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="model.화주노출" Label="화주" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="model.운영자노출" Label="운영자" Color="Color.Primary" />
                        </MudStack>
                    </MudStack>

                    <MudSelect T="string" Label="보상정책" Variant="Variant.Outlined" @bind-Value="rewardPolicyIdText">
                        <MudSelectItem T="string" Value="@EmptyValue">없음</MudSelectItem>
                        @foreach (var policy in rewardPolicies)
                        {
                            <MudSelectItem T="string" Value="@policy.Id.ToString()">@policy.Id - @policy.보상유형</MudSelectItem>
                        }
                    </MudSelect>

                    <MudCheckBox T="bool" @bind-Value="model.활성화여부" Label="활성화" Color="Color.Primary" />

                    <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">
                            @(selectedId.HasValue ? "수정" : "등록")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="ResetForm">
                            신규
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private const string EmptyValue = "";

    private IReadOnlyList<관리자공통콘텐츠요약응답> contents = [];
    private IReadOnlyList<공통콘텐츠보상정책Dto> rewardPolicies = [];
    private 관리자공통콘텐츠저장요청 model = new();
    private long? selectedId;
    private string? rewardPolicyIdText;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        rewardPolicies = await DataService.공통콘텐츠보상정책목록조회Async();
        contents = await DataService.공통콘텐츠목록조회Async();
    }

    private async Task SelectAsync(long id)
    {
        var detail = await DataService.공통콘텐츠상세조회Async(id);
        if (detail is null)
        {
            return;
        }

        selectedId = detail.Id;
        model = new 관리자공통콘텐츠저장요청
        {
            제목 = detail.제목,
            설명 = detail.설명,
            콘텐츠유형 = detail.콘텐츠유형,
            이미지Url = detail.이미지Url,
            영상Url = detail.영상Url,
            외부링크Url = detail.외부링크Url,
            노출위치 = detail.노출위치,
            기사노출 = detail.기사노출,
            화주노출 = detail.화주노출,
            운영자노출 = detail.운영자노출,
            활성화여부 = detail.활성화여부,
            노출시작시각 = detail.노출시작시각,
            노출종료시각 = detail.노출종료시각,
            보상정책Id = detail.보상정책?.Id
        };

        rewardPolicyIdText = detail.보상정책?.Id.ToString();
    }

    private async Task SaveAsync()
    {
        model.보상정책Id = long.TryParse(rewardPolicyIdText, out var policyId) ? policyId : null;

        if (selectedId.HasValue)
        {
            await DataService.공통콘텐츠수정Async(selectedId.Value, model);
            message = "콘텐츠를 수정했습니다.";
        }
        else
        {
            await DataService.공통콘텐츠등록Async(model);
            message = "콘텐츠를 등록했습니다.";
        }

        await LoadAsync();
    }

    private async Task ToggleActiveAsync(long id, bool enabled)
    {
        await DataService.공통콘텐츠활성화변경Async(id, enabled);
        await LoadAsync();
    }

    private bool HasPlacement(계약살뜰노출위치 placement)
        => (model.노출위치 & placement) == placement;

    private void SetPlacement(계약살뜰노출위치 placement, bool enabled)
    {
        if (enabled)
        {
            model.노출위치 |= placement;
            return;
        }

        model.노출위치 &= ~placement;
    }

    private void ResetForm()
    {
        selectedId = null;
        rewardPolicyIdText = null;
        model = new 관리자공통콘텐츠저장요청
        {
            활성화여부 = true
        };
    }
}
