@page "/dispatch/wait"
@page "/admin/freight-delivery/dispatch-wait"
@inject I백오피스Service DataService

<PageTitle>02. 유입/배차대기</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2" Class="mb-3" Style="flex-wrap: wrap;">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">02. 유입/배차대기</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">배차 확정 전 의뢰를 확인하고 수동 조치를 남깁니다.</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="@isLoading"
               OnClick="LoadAsync">
        새로고침
    </MudButton>
</MudStack>

@if (!string.IsNullOrWhiteSpace(message))
{
    <MudAlert Severity="@MessageSeverity" Class="mb-3">@message</MudAlert>
}

<MudPaper Elevation="1" Class="pa-4">
    <MudStack Spacing="2">
        @if (isLoading)
        {
            <MudAlert Severity="Severity.Info" Dense="true">배차대기 목록을 불러오는 중입니다...</MudAlert>
        }
        else if (items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">배차대기 항목이 없습니다.</MudAlert>
        }
        else
        {
            <MudTable Items="@items" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>의뢰ID</MudTh>
                    <MudTh>유형</MudTh>
                    <MudTh>업무 범위</MudTh>
                    <MudTh>픽업 요약</MudTh>
                    <MudTh>하차 요약</MudTh>
                    <MudTh>확인</MudTh>
                    <MudTh>상태</MudTh>
                    <MudTh>작업</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.Id</MudTd>
                    <MudTd DataLabel="의뢰ID">@context.의뢰Id</MudTd>
                    <MudTd DataLabel="유형">
                        <MudChip T="string" Size="Size.Small" Color="@TransportTypeColor(context)" Variant="Variant.Filled">@TransportTypeLabel(context)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="업무 범위">@WorkScopeLabel(context)</MudTd>
                    <MudTd DataLabel="픽업 요약">@context.픽업_도로명주소</MudTd>
                    <MudTd DataLabel="하차 요약">@context.하차_도로명주소</MudTd>
                    <MudTd DataLabel="확인">
                        <MudChip T="string" Size="Size.Small" Color="@ReviewColor(context.상태)" Variant="Variant.Outlined">@ReviewLabel(context.상태)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="상태">
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.상태)" Variant="Variant.Filled">@context.상태</MudChip>
                    </MudTd>
                    <MudTd DataLabel="작업">
                        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => ChangeAsync(context.Id, 확정상태))">수동 배차</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => ChangeAsync(context.Id, 보류상태))">보류</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))">제거</MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudPaper>

@code {
    private const string 확정상태 = "확정";
    private const string 보류상태 = "보류";

    private bool isLoading;
    private bool isError;
    private string? message;
    private IReadOnlyList<배차대기응답> items = [];
    private Severity MessageSeverity => isError ? Severity.Error : Severity.Success;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        items = await DataService.배차대기목록조회Async();
        isLoading = false;
    }

    private async Task ChangeAsync(long id, string status)
    {
        await DataService.배차대기상태변경Async(id, status);
        isError = false;
        message = $"배차대기를 {status} 처리했습니다.";
        await LoadAsync();
    }

    private async Task DeleteAsync(long id)
    {
        await DataService.배차대기삭제Async(id);
        isError = false;
        message = "배차대기를 제거했습니다.";
        await LoadAsync();
    }

    private static string ReviewLabel(string? status)
    {
        if (IsMatch(status, "보류"))
        {
            return "보류확인";
        }

        if (IsMatch(status, "확정"))
        {
            return "확정됨";
        }

        return "대기확인";
    }

    private static Color ReviewColor(string? status)
    {
        if (IsMatch(status, "보류"))
        {
            return Color.Warning;
        }

        if (IsMatch(status, "확정"))
        {
            return Color.Success;
        }

        return Color.Info;
    }

    private static Color StatusColor(string? status)
    {
        if (IsMatch(status, "확정"))
        {
            return Color.Success;
        }

        if (IsMatch(status, "보류"))
        {
            return Color.Warning;
        }

        return Color.Default;
    }

    private static string TransportTypeLabel(배차대기응답 item)
        => IsGroupPurchaseTransport(item) ? "공동구매" : "일반";

    private static Color TransportTypeColor(배차대기응답 item)
        => IsGroupPurchaseTransport(item)
            ? Color.Warning
            : Color.Primary;

    private static string WorkScopeLabel(배차대기응답 item)
    {
        if (!IsGroupPurchaseTransport(item))
        {
            return "상하차";
        }

        if (item.공동구매도착지유형코드 == "ThreePlWarehouse")
        {
            return "상하차 + 3PL 입고";
        }

        if (item.공동구매기사세대배송여부 == true)
        {
            var count = item.공동구매세대배송건수.HasValue ? $" {item.공동구매세대배송건수.Value:N0}건" : string.Empty;
            return $"상하차 + 세대 문앞 배송{count}";
        }

        if (item.공동구매도착지유형코드 == "OrdererGroupRepresentativeDropoff")
        {
            return "상하차 + 집단 대표 인계";
        }

        return "상하차 + 공동주택 거점 하차";
    }

    private static bool IsGroupPurchaseTransport(배차대기응답 item)
        => item.원본의뢰유형 is "ImportCargoTransport" or "FclCargoTransport" or "LclCargoTransport";

    private static bool IsMatch(string? value, params string[] candidates)
    {
        return candidates.Any(candidate => string.Equals(value, candidate, StringComparison.OrdinalIgnoreCase));
    }
}
