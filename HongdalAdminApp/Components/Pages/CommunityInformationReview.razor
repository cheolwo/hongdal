@page "/information-review"
@inherits MvvmComponentBase<CommunityInformationReviewPageViewModel>
@using Hongdal.Contracts.Common.Community
@inject AdminAuthSession Session
@inject NavigationManager Navigation

<PageTitle>자료 검토 · 커뮤니티 글쓰기</PageTitle>

<main class="information-review-page">
    <header class="information-review-header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">SOURCE REVIEW</MudText>
            <MudText Typo="Typo.h4">자료 검토 · 글쓰기</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                수집된 공개 자료의 출처와 기준을 확인하고 커뮤니티 글 초안으로 정리합니다.
            </MudText>
        </div>
        @if (Session.IsServerAdmin)
        {
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">
                서버관리자 전용
            </MudChip>
        }
    </header>

    @if (!Session.IsServerAdmin)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            서버관리자 로그인이 필요합니다.
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="OpenLogin">로그인</MudButton>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
            자료 수집만으로 글이 게시되거나 공동행동이 시작되지 않습니다. 원문과 주의사항을 확인한 뒤 최종 내용을 직접 등록합니다.
        </MudAlert>

        <section class="information-review-filters" aria-label="자료 후보 검색 조건">
            <MudSelect T="string"
                       Label="원천"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       @bind-Value="ViewModel.SelectedSourceKey">
                <MudSelectItem T="string" Value="@AllValue">전체 원천</MudSelectItem>
                @foreach (var source in ViewModel.Sources)
                {
                    <MudSelectItem T="string" Value="@source.SourceKey">@source.DisplayName</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       Label="국가"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       @bind-Value="ViewModel.CountryCode">
                <MudSelectItem T="string" Value="@AllValue">전체 국가</MudSelectItem>
                <MudSelectItem T="string" Value="@KrValue">KR · 대한민국</MudSelectItem>
                <MudSelectItem T="string" Value="@UsValue">US · 미국</MudSelectItem>
                <MudSelectItem T="string" Value="@UnknownCountryValue">ZZ · 미분류</MudSelectItem>
            </MudSelect>

            <MudSelect T="string"
                       Label="검토 상태"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       @bind-Value="ViewModel.ReviewState">
                <MudSelectItem T="string" Value="@AllValue">전체 상태</MudSelectItem>
                @foreach (var state in ReviewStates)
                {
                    <MudSelectItem T="string" Value="@state.Code">@state.Label</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string"
                          Label="제목·내용·태그 검색"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          @bind-Value="ViewModel.SearchText" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterAlt"
                       Disabled="@ViewModel.IsLoading"
                       OnClick="RefreshAsync">
                조회
            </MudButton>
        </section>

        @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@ViewModel.ErrorMessage</MudAlert>
        }

        @foreach (var failure in ViewModel.Failures)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @SourceName(failure.SourceKey): @failure.Message
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
        {
            <MudAlert Severity="@(ViewModel.PublishedPostId.HasValue ? Severity.Success : Severity.Info)" Dense="true">
                @ViewModel.StatusMessage
            </MudAlert>
        }

        @if (ViewModel.IsLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (ViewModel.Candidates.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">조건에 맞는 수집 자료가 없습니다.</MudAlert>
        }
        else
        {
            <section aria-labelledby="information-candidate-list-title">
                <div class="information-review-section-heading">
                    <div>
                        <MudText id="information-candidate-list-title" Typo="Typo.h6">수집 자료</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">최근 후보 @ViewModel.Candidates.Count.ToString("N0")건</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   Disabled="@ViewModel.IsLoading"
                                   OnClick="RefreshAsync"
                                   aria-label="수집 자료 새로고침" />
                </div>

                <MudTable Items="ViewModel.Candidates"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Md"
                          Class="information-candidate-table">
                    <HeaderContent>
                        <MudTh>자료</MudTh>
                        <MudTh>원천</MudTh>
                        <MudTh>기준</MudTh>
                        <MudTh>검토</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="candidate">
                        <MudTd DataLabel="자료">
                            <div class="information-candidate-title-cell">
                                @if (!string.IsNullOrWhiteSpace(candidate.ThumbnailUrl))
                                {
                                    <img src="@candidate.ThumbnailUrl" alt="" loading="lazy" />
                                }
                                <span>
                                    <strong>@candidate.Title</strong>
                                    <small>@candidate.Summary</small>
                                </span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="원천">
                            <MudText Typo="Typo.body2">@candidate.Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@candidate.CountryCode · @SourceTypeLabel(candidate.SourceType)</MudText>
                        </MudTd>
                        <MudTd DataLabel="기준">
                            <MudText Typo="Typo.body2">@FormatReferenceDate(candidate)</MudText>
                            @if (!string.IsNullOrWhiteSpace(candidate.CurrencyCode) || !string.IsNullOrWhiteSpace(candidate.Unit))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@DisplayMeasurement(candidate)</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="검토">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="@ReviewStateColor(candidate.ReviewState)"
                                     Variant="Variant.Outlined">
                                @ReviewStateLabel(candidate.ReviewState)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="선택">
                            <MudTooltip Text="자료 확인">
                                <MudIconButton Icon="@Icons.Material.Filled.Article"
                                               Color="Color.Primary"
                                               OnClick="@(() => SelectCandidate(candidate))"
                                               aria-label="자료 확인" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </section>
        }

        @if (ViewModel.SelectedCandidate is { } selected)
        {
            <section class="information-candidate-detail" aria-labelledby="information-candidate-detail-title">
                <header>
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Primary">SELECTED SOURCE</MudText>
                        <MudText id="information-candidate-detail-title" Typo="Typo.h5">@selected.Title</MudText>
                    </div>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   Href="@selected.OriginalUrl"
                                   Target="_blank">
                            원문
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.EditNote"
                                   OnClick="@(() => PrepareDraft(selected))">
                            글 초안 만들기
                        </MudButton>
                    </MudStack>
                </header>

                <MudText Typo="Typo.body1">@selected.Summary</MudText>
                <div class="information-candidate-meta">
                    <span><strong>출처</strong>@selected.Provider</span>
                    <span><strong>기준</strong>@FormatReferenceDate(selected)</span>
                    <span><strong>수집</strong>@selected.CollectedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    <span><strong>국가·언어</strong>@selected.CountryCode · @selected.LanguageCode</span>
                </div>

                @if (selected.TopicTags.Count > 0)
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var tag in selected.TopicTags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                        }
                    </MudStack>
                }

                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">@selected.SourceNotice</MudAlert>
                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Text">@selected.Limitations</MudAlert>
            </section>
        }

        @if (ViewModel.HasDraftConflict && ViewModel.PendingDraftCandidate is { } pending)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="information-draft-conflict">
                <MudText Typo="Typo.body2">기존 초안을 유지할지, @pending.Title 자료로 바꿀지 선택해 주세요.</MudText>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="ContinueExistingDraft">기존 초안 계속</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Inherit" OnClick="ReplaceDraft">이 자료로 바꾸기</MudButton>
                </MudStack>
            </MudAlert>
        }

        @if (ViewModel.Composer.IsOpen)
        {
            <section class="information-community-composer" aria-label="커뮤니티 글 초안 편집">
                <div class="information-review-section-heading">
                    <MudText Typo="Typo.h6">커뮤니티 글 초안</MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteOutline"
                               OnClick="ViewModel.ClearDraft">
                        초안 비우기
                    </MudButton>
                </div>
                <PlatformCommunityPostComposer ViewModel="@ViewModel.Composer"
                                               BoardCategories="BoardCategories"
                                               RoleTags="RoleTags"
                                               Saved="HandleComposerSaved" />
            </section>
        }
    }
</main>

@code {
    private const string AllValue = "";
    private const string KrValue = "KR";
    private const string UsValue = "US";
    private const string UnknownCountryValue = "ZZ";

    private static readonly IReadOnlyList<(string Code, string Label)> ReviewStates =
    [
        (CommunityInformationReviewStates.PendingReview, "검토 대기"),
        (CommunityInformationReviewStates.Approved, "승인"),
        (CommunityInformationReviewStates.OfficialObservation, "공식 관측값"),
        (CommunityInformationReviewStates.Baseline, "기준선"),
        (CommunityInformationReviewStates.Excluded, "제외")
    ];

    private static readonly IReadOnlyList<string> BoardCategories = CommunityBoardCatalog.PublicBoards
        .Select(board => board.DisplayName)
        .ToArray();

    private static readonly IReadOnlyList<string> RoleTags =
    [
        "운영자 정보 공유",
        "자료 정리",
        "공동체 안내"
    ];

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (Session.IsServerAdmin)
        {
            await ViewModel.InitializeAsync();
        }
    }

    private void OpenLogin() => Navigation.NavigateTo("/login");

    private Task RefreshAsync() => ViewModel.RefreshAsync();

    private void SelectCandidate(CommunityInformationCandidateDto candidate)
        => ViewModel.SelectCandidate(candidate);

    private void PrepareDraft(CommunityInformationCandidateDto candidate)
        => ViewModel.PrepareDraft(candidate, Session.UserName);

    private void ContinueExistingDraft()
        => ViewModel.ContinueExistingDraft(Session.UserName);

    private void ReplaceDraft()
        => ViewModel.ReplaceDraft(Session.UserName);

    private void HandleComposerSaved(CommunityPostComposerSaveResult result)
        => ViewModel.HandleComposerSaved(result);

    private string SourceName(string sourceKey)
        => ViewModel.Sources.FirstOrDefault(source =>
               string.Equals(source.SourceKey, sourceKey, StringComparison.OrdinalIgnoreCase))?.DisplayName
           ?? sourceKey;

    private static string SourceTypeLabel(string sourceType)
        => sourceType switch
        {
            CommunityInformationSourceTypes.Video => "영상",
            CommunityInformationSourceTypes.PublicData => "공공데이터",
            _ => sourceType
        };

    private static string FormatReferenceDate(CommunityInformationCandidateDto candidate)
        => candidate.ReferenceDate?.ToString("yyyy-MM-dd")
           ?? candidate.PublishedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd")
           ?? "기준일 없음";

    private static string DisplayMeasurement(CommunityInformationCandidateDto candidate)
        => string.Join(
            " · ",
            new[] { candidate.CurrencyCode, candidate.Unit }
                .Where(value => !string.IsNullOrWhiteSpace(value)));

    private static string ReviewStateLabel(string state)
        => ReviewStates.FirstOrDefault(item =>
               string.Equals(item.Code, state, StringComparison.OrdinalIgnoreCase)).Label
           ?? state;

    private static Color ReviewStateColor(string state)
        => state switch
        {
            CommunityInformationReviewStates.PendingReview => Color.Warning,
            CommunityInformationReviewStates.Approved => Color.Success,
            CommunityInformationReviewStates.OfficialObservation => Color.Info,
            CommunityInformationReviewStates.Excluded => Color.Error,
            _ => Color.Default
        };
}
