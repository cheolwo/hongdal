  },
  "CommunityPostStorage": {
    "Folder": "community/posts",
    "MaxImageBytes": 5242880,
    "MaxAttachmentsPerPost": 5,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif"
    ]
  },
  "KieAi": {
    "ApiKey": "",
    "BaseUrl": "https://api.kie.ai",
    "CreateTaskPath": "/api/v1/jobs/createTask",
    "GetTaskPathTemplate": "/api/v1/jobs/{taskId}",
    "Model": "gpt-image-2-text-to-image",
    "CallbackBaseUrl": "",
    "PollingIntervalSeconds": 15,
    "MaxPollingMinutes": 15
  },
  "NaverCloudDirections": {
    "BaseUrl": "https://maps.apigw.ntruss.com",
    "Path": "/map-direction/v1/driving",
    "ApiKeyId": "",
    "ApiKey": "",
    "DefaultOption": "trafast"
  },
  "Opinet": {
    "BaseUrl": "https://www.opinet.co.kr",
    "AveragePricePath": "/api/avgAllPrice.do",
    "CertKey": "",
    "OutputFormat": "xml"
  },
  "NtsBusinessRegistration": {
    "BaseUrl": "https://api.odcloud.kr/api/nts-businessman/v1",
    "StatusPath": "/status",
    "ServiceKey": ""
  },
  "수입식품제품조회": {
    "BaseUrl": "http://apis.data.go.kr/1471000/IprtFoodPrdtDBService02",
    "Path": "/getIprtFoodPrdtDBInfo2",
    "ServiceKey": "",
