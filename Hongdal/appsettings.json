  "VersionFeatureFlags": {
    "CargoYongdalV1": true,
    "WarehouseV15": false,
    "CustomsHsV20": false,
    "OrdererGroupOrderV25": false,
    "FoodDeliveryV30": false,
    "HongdalMartV35": false
  },
  "DriverUsagePolicy": {
    "무료배차": true,
    "기본이용료": 500,
    "추가이용료": 5000
  },
  "SalesChannelOrderSync": {
    "Enabled": true,
    "DomesticSyncIntervalSeconds": 300,
    "OverseasSyncIntervalSeconds": 600,
    "LookbackMinutes": 120,
    "BatchSize": 100
  },
  "WorkRelationshipSnapshots": {
    "Enabled": true
  },
  "CommandProcessing": {
    "Defaults": {
      "AuditLogEnabled": true,
      "WorkRelationshipSnapshotEnabled": false,
      "SmsEnabled": false,
      "SnsEnabled": false,
      "PushEnabled": false,
      "EventName": "CommandHandled",
      "Target": ""
    },
    "Commands": {
      "배차수락Command": {
        "AuditLogEnabled": true,
        "WorkRelationshipSnapshotEnabled": false,
        "PushEnabled": true,
        "EventName": "DispatchAccepted",
        "Target": "Driver"
      },
      "배차거절Command": {
        "AuditLogEnabled": true,
        "EventName": "DispatchRejected",
        "Target": "Driver"
      },
      "운송상차지도착Command": {
        "AuditLogEnabled": true,
        "EventName": "TransportArrivedPickup",
        "Target": "Driver"
      },
      "운송상차완료Command": {
        "AuditLogEnabled": true,
        "PushEnabled": true,
        "EventName": "TransportPickupCompleted",
        "Target": "Driver"
      },
      "운송하차지도착Command": {
        "AuditLogEnabled": true,
        "EventName": "TransportArrivedDropoff",
        "Target": "Driver"
      },
      "운송인수완료Command": {
        "AuditLogEnabled": true,
        "SmsEnabled": true,
        "PushEnabled": true,
        "EventName": "TransportCompleted",
        "Target": "Driver"
      },
      "운송문제신고Command": {
        "AuditLogEnabled": true,
        "SmsEnabled": true,
        "SnsEnabled": true,
        "EventName": "TransportIssueReported",
        "Target": "Admin"
      }
    }
  },
  "CommandFileStorage": {
    "RootFolder": "uploads",
    "DefaultCommand": {
      "Folder": "commands",
      "IncludeRequestIdSegment": true
    },
    "AdminFilePod": {
      "Folder": "admin/files-pod",
      "IncludeRequestIdSegment": true
    },
    "Commands": {
      "배차수락Command": {
        "Folder": "driver/dispatch/accepted"
      },
      "배차거절Command": {
        "Folder": "driver/dispatch/rejected"
      },
      "운송상차완료Command": {
        "Folder": "driver/transport/pickup-completed"
      },
      "TransportPickupComplete": {
        "Folder": "driver/transport/pickup-completed"
      },
      "운송인수완료Command": {
        "Folder": "driver/transport/completed"
      },
      "TransportDropoffComplete": {
        "Folder": "driver/transport/completed"
      },
      "운송문제신고Command": {
        "Folder": "driver/transport/issues"
      }
    }
  }
}
