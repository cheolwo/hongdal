{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:16379"
  },
  "MongoDb": {
    "ConnectionString": "",
    "Database": "hongdal_dev"
  },
  "CustomsBrokerCors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "Hongdal",
    "Audience": "Hongdal.Client",
    "SecretKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "TossPayments": {
    "ClientKey": "",
    "SecretKey": "",
    "BaseUrl": "https://api.tosspayments.com"
  },
  "GoogleCloudStorage": {
    "BucketName": "your-bucket-name",
    "ServiceAccountJsonPath": "",
