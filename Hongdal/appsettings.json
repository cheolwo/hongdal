  },
  "해외제조업소조회": {
    "BaseUrl": "https://apis.data.go.kr/1471000/IprtFoodOvseaMnftBsshInfoService02",
    "Endpoint": "/getIprtFoodOvseaMnftBsshInfoInq02",
    "ServiceKey": "",
    "DefaultType": "xml"
  },
  "PublicData": {
    "ServiceKey": "",
    "DataGoKrServiceKey": "",
    "TimeoutSeconds": 20,
    "RoadAddress": {
      "ConfirmKey": "",
      "BaseUrl": "https://business.juso.go.kr",
      "SearchPath": "/addrlink/addrLinkApi.do"
    },
    "ApartmentComplex": {
      "ServiceKey": "",
      "BaseUrl": "https://apis.data.go.kr",
      "ListPath": "/1613000/AptListService3/getLegaldongAptList",
      "BasicInfoPath": "/1613000/AptBasisInfoServiceV4/getAphusBassInfo"
