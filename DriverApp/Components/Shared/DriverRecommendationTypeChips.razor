@using DriverApp.Models.Driver

<MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="@Class">
    <MudChip T="string" Size="Size.Small" Color="@RequestTypeColor" Variant="Variant.Filled">@Request.운송의뢰유형표시</MudChip>
    @if (Request.세대배송포함여부)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@Request.세대배송범위표시</MudChip>
    }
</MudStack>

@code {
    [Parameter]
    public DriverRequestItem Request { get; set; } = new();

    [Parameter]
    public string Class { get; set; } = "mt-1";

    private Color RequestTypeColor => Request.공동주문운송여부 ? Color.Warning : Color.Primary;
}
