@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Routing

<MudLayout>
    <MudAppBar Dense="true" Fixed="false" Elevation="0" Color="Color.Default" Class="driver-topbar px-4 py-2">
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   Disabled="@(!CanGoBack)"
                   OnClick="GoBack"
                   Class="back-nav-button">← 뒤로가기</MudButton>
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle1">기사 홈</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">운행 중 지금 봐야 할 화면만 먼저 확인한다.</MudText>
        </MudStack>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                       Color="Color.Primary"
                       Class="driver-quick-action"
                       Size="Size.Medium"
                       OnClick="GoToMenuPage"
                       aria-label="메뉴 페이지 열기" />
    </MudAppBar>

    <MudMainContent Class="driver-main-content pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly Stack<string> _navigationHistory = new();
    private string? _currentUri;
    private bool _isNavigatingBack;

    private bool CanGoBack => _navigationHistory.Count > 0;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        _currentUri = NavigationManager.Uri;
    }

    private void GoToMenuPage()
    {
        NavigationManager.NavigateTo(DriverRoutes.Menu);
    }

    private void GoBack()
    {
        if (_navigationHistory.Count == 0)
        {
            return;
        }

        var previousUri = _navigationHistory.Pop();
        _isNavigatingBack = true;
        NavigationManager.NavigateTo(previousUri);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_isNavigatingBack)
        {
            _isNavigatingBack = false;
            _currentUri = args.Location;
            InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_currentUri) && !string.Equals(_currentUri, args.Location, StringComparison.OrdinalIgnoreCase))
        {
            _navigationHistory.Push(_currentUri);
        }

        _currentUri = args.Location;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
