@page "/driver/account/bank"
@using DriverApp.ViewModels.Driver.Settlement
@inherits DriverApp.Components.MvvmComponentBase<기사계좌정보PageViewModel>

<PageTitle>계좌 정보</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">계좌 정보</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">정산금을 받을 계좌와 이번 달 정산 상태를 확인합니다.</MudText>
            </MudStack>
        </MudPaper>

        <SsalddelBankAccountPanel Account="@Account"
                                 PanelClass="driver-recommendation-card pa-4"
                                 IdentityVerified="@_identityVerified"
                                 IdentityVerifiedChanged="@(value => _identityVerified = value)">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@DriverRoutes.CurrentMonthSettlement">정산 정보</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Menu">사용자 메뉴로</MudButton>
        </SsalddelBankAccountPanel>
    </MudStack>
</MudContainer>

@code {
    private bool _identityVerified;

    private SsalddelBankAccountSummary Account => new(
        "국민은행",
        "홍길동 기사님",
        "123-45-678901",
        "확인 완료",
        ViewModel.정산.DispatchCount,
        ViewModel.정산.UsageFee);

    protected override Task OnInitializedAsync() => ViewModel.초기화Async();
}
