@page "/driver/notifications/settings"
@inject IDriverSampleDataService Samples

<PageTitle>알림설정</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">알림 설정</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">추천콜과 운송 알림을 어떻게 받을지 확인하는 설정 화면이다.</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">현재 샘플 알림</MudText>
                <MudText Typo="Typo.body1">@알림요약</MudText>
                <MudAlert Severity="Severity.Info">나중에 푸시 토큰 등록, 권한 확인, 알림 수신 범위를 여기서 연결한다.</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/driver/notifications/push">푸시 설정으로</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/driver/notifications">알림함으로</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/driver/home">기사 홈으로</MudButton>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private string 알림요약 => string.Format("안읽은 알림 {0}건 / 전체 {1}건", Samples.알림목록.Count(x => !x.읽음), Samples.알림목록.Count);
}
