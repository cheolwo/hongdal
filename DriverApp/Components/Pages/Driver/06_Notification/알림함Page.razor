@page "/driver/notifications"
@using DriverApp.ViewModels.Driver.Notification
@inherits DriverApp.Components.MvvmComponentBase<기사알림함PageViewModel>

<PageTitle>알림함</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">알림함</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">배차추천, 운행, 정산 알림을 한곳에서 확인합니다.</MudText>
            </MudStack>
        </MudPaper>

        <MudStack Spacing="2">
            @foreach (var item in ViewModel.알림목록)
            {
                <MudPaper Class="pa-3" Elevation="1" Outlined="true">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">@item.제목</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.내용</MudText>
                            <MudText Typo="Typo.caption">@item.발생시각.ToString("MM-dd HH:mm")</MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@item.종류</MudChip>
                            <MudChip T="string" Color="@(item.읽음 ? Color.Default : Color.Warning)" Variant="Variant.Filled">@(item.읽음 ? "읽음" : "안읽음")</MudChip>
                            @if (!item.읽음)
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Disabled="@ViewModel.처리중"
                                           OnClick="@(() => ViewModel.읽음처리Async(item.Id))">
                                    읽음 처리
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/driver/notifications/settings">알림 설정</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/driver/home">기사 홈으로</MudButton>
        </MudStack>
    </MudStack>
</MudContainer>

@code {
    protected override Task OnInitializedAsync() => ViewModel.초기화Async();
}
