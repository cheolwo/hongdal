@page "/driver/work/start"
@using Hongdal.Contracts.Driver.Work
@using Microsoft.Maui.ApplicationModel
@using Microsoft.Maui.Devices.Sensors
@implements IDisposable
@inject IDriverSampleDataService Samples
@inject IDriverWorkApiService WorkApi
@inject I기사위치송신Service 위치송신

<PageTitle>운행 시작</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">운행 시작</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">운행을 시작하면 현재 위치를 서버에 등록하고 Android 백그라운드 위치 송신을 시작한다.</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">운행 시작 기준</MudText>
                <MudText Typo="Typo.body1">시작 모드: @Samples.근무상태.시작모드</MudText>
                <MudText Typo="Typo.body1">기본 시작 위치: @Samples.근무상태.시작위치</MudText>
                <MudText Typo="Typo.body1">복귀지: @(Samples.근무상태.복귀지 ?? "미설정")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">위치 송신 간격: 서버 권장값 기준, 기본 5분</MudText>

                @if (!string.IsNullOrWhiteSpace(_상태문구))
                {
                    <MudAlert Severity="@_상태종류">@_상태문구</MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Disabled="_처리중 || 위치송신.IsRunning"
                           OnClick="운행시작Async">
                    @(_처리중 ? "처리 중" : 위치송신.IsRunning ? "위치 송신 중" : "운행 시작")
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           Disabled="_처리중 || !위치송신.IsRunning"
                           OnClick="운행종료Async">
                    운행 종료
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/driver/work/status">근무 상태 보기</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/driver/home">기사 홈으로</MudButton>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private bool _처리중;
    private string? _상태문구;
    private Severity _상태종류 = Severity.Info;

    protected override void OnInitialized()
    {
        위치송신.Changed += 위치송신상태변경;
    }

    private async Task 운행시작Async()
    {
        _처리중 = true;
        _상태문구 = null;

        try
        {
            if (!await 위치권한확보Async())
            {
                SetStatus(Severity.Warning, "위치 권한이 필요합니다. 권한을 허용한 뒤 다시 운행을 시작해 주세요.");
                return;
            }

            await 알림권한확보Async();

            var location = await 현재위치조회Async();
            if (location is null)
            {
                SetStatus(Severity.Warning, "현재 위치를 확인하지 못했습니다. GPS 상태를 확인한 뒤 다시 시도해 주세요.");
                return;
            }

            var startResponse = await WorkApi.운행시작Async(new 기사운행시작요청
            {
                시작모드 = Samples.근무상태.시작모드,
                시작시각 = DateTime.UtcNow,
                시작위치 = 현재위치문구(location),
                복귀지 = Samples.근무상태.복귀지
            });

            await 위치송신.StartAsync(new 기사위치송신시작요청
            {
                권장위치전송간격초 = 300,
                상차접근허용반경Km = 10m,
                운행상태 = startResponse?.Status ?? "운행중"
            });

            SetStatus(Severity.Success, "운행을 시작했고, 백그라운드 위치 송신을 시작했습니다.");
        }
        catch (PermissionException)
        {
            SetStatus(Severity.Warning, "위치 권한이 필요합니다. 앱 설정에서 위치 권한을 허용해 주세요.");
        }
        catch (Exception ex)
        {
            SetStatus(Severity.Error, $"운행 시작 실패: {ex.Message}");
        }
        finally
        {
            _처리중 = false;
        }
    }

    private async Task 운행종료Async()
    {
        _처리중 = true;
        _상태문구 = null;

        try
        {
            await 위치송신.StopAsync();
            await WorkApi.운행종료Async();
            SetStatus(Severity.Info, "운행을 종료했고, 위치 송신을 중지했습니다.");
        }
        catch (Exception ex)
        {
            SetStatus(Severity.Error, $"운행 종료 실패: {ex.Message}");
        }
        finally
        {
            _처리중 = false;
        }
    }

    private static async Task<bool> 위치권한확보Async()
    {
        var status = await Permissions.CheckStatusAsync<Permissions.LocationWhenInUse>();
        if (status != PermissionStatus.Granted)
        {
            status = await Permissions.RequestAsync<Permissions.LocationWhenInUse>();
        }

        return status == PermissionStatus.Granted;
    }

    private static async Task 알림권한확보Async()
    {
#if ANDROID
        if (OperatingSystem.IsAndroidVersionAtLeast(33))
        {
            var status = await Permissions.CheckStatusAsync<Permissions.PostNotifications>();
            if (status != PermissionStatus.Granted)
            {
                await Permissions.RequestAsync<Permissions.PostNotifications>();
            }
        }
#else
        await Task.CompletedTask;
#endif
    }

    private static async Task<Location?> 현재위치조회Async()
    {
        return await Geolocation.Default.GetLocationAsync(
            new GeolocationRequest(GeolocationAccuracy.Medium, TimeSpan.FromSeconds(20)));
    }

    private static string 현재위치문구(Location location)
    {
        return FormattableString.Invariant($"{location.Latitude:F6},{location.Longitude:F6}");
    }

    private void SetStatus(Severity severity, string message)
    {
        _상태종류 = severity;
        _상태문구 = message;
    }

    private void 위치송신상태변경()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        위치송신.Changed -= 위치송신상태변경;
    }
}
