@page "/driver/transports/current"
@inject IDriverSampleDataService Samples

<PageTitle>진행중 운송</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">진행 중 운송</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">현재 운송과 다음 행동을 샘플데이터로 확인한다.</MudText>
            </MudStack>
        </MudPaper>

        @if (현재운송 is not null)
        {
            <MudPaper Class="pa-4" Elevation="3">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">다음 행동</MudText>
                            <MudText Typo="Typo.h5">@현재운송.다음행동</MudText>
                        </MudStack>
                        <MudChip T="string" Color="@CurrentStageColor" Variant="Variant.Filled">@현재운송.현재단계</MudChip>
                    </MudStack>

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">상차</MudText>
                                <MudText Typo="Typo.subtitle1">@현재운송.픽업지</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">하차</MudText>
                                <MudText Typo="Typo.subtitle1">@현재운송.하차지</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">예정시각</MudText>
                            <MudText Typo="Typo.body1">@현재운송.예정시각.ToString("HH:mm")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">운송거리</MudText>
                            <MudText Typo="Typo.body1">@현재운송.운송거리Km.ToString("0.0")km</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">예상수익</MudText>
                            <MudText Typo="Typo.body1">@현재운송.예상수익.ToString("N0")원</MudText>
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="@NextActionColor" Href="@NextActionHref" StartIcon="@NextActionIcon">@NextActionLabel</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@SecondaryActionHref">@SecondaryActionLabel</MudButton>
                    </MudStack>

                    <MudAlert Severity="Severity.Info" Class="mb-0">주소와 결제 정보는 아래 운행 상세에서 필요한 순간에만 펼쳐 확인합니다.</MudAlert>

                    <MudPaper Elevation="0" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">운송 상태 타임라인</MudText>
                            <MudGrid>
                                @foreach (var step in TransportTimeline)
                                {
                                    <MudItem xs="6" sm="4" md="2">
                                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@step.Icon" Color="@step.Color" Size="Size.Medium" />
                                            <MudText Typo="Typo.caption" Align="Align.Center">@step.Label</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="@step.Color" Variant="@step.Variant">@step.Status</MudChip>
                                        </MudStack>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">수령자 최소 정보</MudText>
                                    <MudText Typo="Typo.subtitle1">@RecipientName</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@RecipientPaymentMethod</MudChip>
                            </MudStack>
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">하차 위치</MudText>
                                    <MudText Typo="Typo.body2">@현재운송.하차지</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">연락처</MudText>
                                    <MudText Typo="Typo.body2">@RecipientMaskedPhone</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">인수 확인</MudText>
                                    <MudText Typo="Typo.body2">@RecipientProofHint</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <HongdalSensitiveDisclosureList Title="운행 상세"
                                                    Summary="@현재운송.현재단계"
                                                    RelatedParties='@($"기사님 · 화주 · 하차지 담당자 / 의뢰 {현재운송.의뢰Id}")'
                                                    Icon="@Icons.Material.Filled.LocalShipping"
                                                    Color="Color.Primary"
                                                    PrivacyHint="운행 중 필요한 정보만 펼쳐 확인합니다.">
                        <MudExpansionPanel Text="화물 정보">
                            <HongdalSensitiveInfoRow Label="화물 종류" Value="@현재운송.화물종류" />
                            <HongdalSensitiveInfoRow Label="의뢰 번호" Value="@현재운송.의뢰Id" />
                            <HongdalSensitiveInfoRow Label="작업 메모" Value="상차 전 화물 상태와 수량을 확인합니다." />
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="운송 정보">
                            <HongdalSensitiveInfoRow Label="상차지" Value="@현재운송.픽업지" />
                            <HongdalSensitiveInfoRow Label="하차지" Value="@현재운송.하차지" />
                            <HongdalSensitiveInfoRow Label="현재 단계" Value="@현재운송.현재단계" />
                            <HongdalSensitiveInfoRow Label="예정 시각" Value='@현재운송.예정시각.ToString("HH:mm")' />
                            <HongdalSensitiveInfoRow Label="운송 거리" Value='@($"{현재운송.운송거리Km:0.0}km")' />
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="결제 정보">
                            <HongdalSensitiveInfoRow Label="예상 수익" Value='@($"{현재운송.예상수익:0}원")' />
                            <HongdalSensitiveInfoRow Label="정산 기준" Value="하차 완료 후 정산 확인" />
                            <HongdalSensitiveInfoRow Label="인수증" Value="하차 현장에서 필요 여부 확인" />
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="전달받는자 정보">
                            <HongdalSensitiveInfoRow Label="전달 위치" Value="@현재운송.하차지" />
                            <HongdalSensitiveInfoRow Label="담당자" Value="하차지 담당자" />
                            <HongdalSensitiveInfoRow Label="연락처" Value="상세 API 연결 시 표시" />
                            <HongdalSensitiveInfoRow Label="전달 요청" Value="도착 전 연락 후 하차 완료 사진을 남깁니다." />
                        </MudExpansionPanel>
                    </HongdalSensitiveDisclosureList>
                </MudStack>
            </MudPaper>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Home">기사 홈으로</MudButton>
    </MudStack>
</MudContainer>

@code {
    private 기사운송샘플항목? 현재운송 => Samples.현재운송조회();

    private bool ShouldPickup => 현재운송?.다음행동.Contains("상차", StringComparison.OrdinalIgnoreCase) == true;

    private string NextActionLabel => ShouldPickup ? "상차 처리하기" : "하차 처리하기";

    private string SecondaryActionLabel => ShouldPickup ? "하차 화면 확인" : "상차 화면 확인";

    private string NextActionHref => 현재운송 is null
        ? DriverRoutes.Home
        : ShouldPickup
            ? DriverRoutes.TransportPickup(현재운송.Id)
            : DriverRoutes.TransportDropoff(현재운송.Id);

    private string SecondaryActionHref => 현재운송 is null
        ? DriverRoutes.Home
        : ShouldPickup
            ? DriverRoutes.TransportDropoff(현재운송.Id)
            : DriverRoutes.TransportPickup(현재운송.Id);

    private string NextActionIcon => ShouldPickup
        ? Icons.Material.Filled.FileUpload
        : Icons.Material.Filled.TaskAlt;

    private Color NextActionColor => ShouldPickup ? Color.Primary : Color.Success;

    private Color CurrentStageColor => ShouldPickup ? Color.Primary : Color.Success;

    private string RecipientName => 현재운송 is null ? "-" : $"{현재운송.하차지} 담당자";

    private string RecipientMaskedPhone => "010-****-2401";

    private string RecipientPaymentMethod => "인수증 또는 현장 결제 확인";

    private string RecipientProofHint => "하차 사진 + 수령자 확인";

    private IReadOnlyList<TransportTimelineStep> TransportTimeline =>
    [
        BuildTimelineStep("접수", Icons.Material.Filled.AssignmentTurnedIn, IsStepReached("접수")),
        BuildTimelineStep("배차중", Icons.Material.Filled.ManageSearch, IsStepReached("배차중")),
        BuildTimelineStep("배차확정", Icons.Material.Filled.LocalShipping, IsStepReached("배차확정")),
        BuildTimelineStep("상차완료", Icons.Material.Filled.FileUpload, IsStepReached("상차완료")),
        BuildTimelineStep("운송중", Icons.Material.Filled.Route, IsStepReached("운송중")),
        BuildTimelineStep("하차완료", Icons.Material.Filled.TaskAlt, IsStepReached("하차완료"))
    ];

    private TransportTimelineStep BuildTimelineStep(string label, string icon, bool reached)
    {
        var isCurrent = IsCurrentTimelineStep(label);
        return new TransportTimelineStep(
            label,
            icon,
            isCurrent ? "현재" : reached ? "완료" : "대기",
            isCurrent ? Color.Primary : reached ? Color.Success : Color.Default,
            isCurrent || reached ? Variant.Filled : Variant.Outlined);
    }

    private bool IsCurrentTimelineStep(string label)
    {
        var stage = 현재운송?.현재단계 ?? string.Empty;
        return label switch
        {
            "상차완료" => stage.Contains("상차", StringComparison.OrdinalIgnoreCase),
            "운송중" => stage.Contains("하차지 이동", StringComparison.OrdinalIgnoreCase) || stage.Contains("운송", StringComparison.OrdinalIgnoreCase),
            "하차완료" => stage.Contains("하차완료", StringComparison.OrdinalIgnoreCase) || stage.Contains("인수", StringComparison.OrdinalIgnoreCase),
            _ => false
        };
    }

    private bool IsStepReached(string label)
    {
        var stage = 현재운송?.현재단계 ?? string.Empty;
        var order = label switch
        {
            "접수" => 0,
            "배차중" => 1,
            "배차확정" => 2,
            "상차완료" => 3,
            "운송중" => 4,
            "하차완료" => 5,
            _ => 0
        };

        var currentOrder = stage switch
        {
            var s when s.Contains("하차완료", StringComparison.OrdinalIgnoreCase) || s.Contains("인수", StringComparison.OrdinalIgnoreCase) => 5,
            var s when s.Contains("하차지 이동", StringComparison.OrdinalIgnoreCase) || s.Contains("운송", StringComparison.OrdinalIgnoreCase) => 4,
            var s when s.Contains("상차", StringComparison.OrdinalIgnoreCase) => 3,
            _ => 2
        };

        return order <= currentOrder;
    }

    private sealed record TransportTimelineStep(
        string Label,
        string Icon,
        string Status,
        Color Color,
        Variant Variant);
}
