@page "/driver/transports/history"
@inject IDriverSampleDataService Samples

<PageTitle>배달 내역</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">배달 내역</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">최근 운송 기록과 예상 수익을 확인합니다.</MudText>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="2">
            @foreach (var item in Samples.운송목록.OrderByDescending(x => x.예정시각))
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="driver-recommendation-card pa-4 h-100" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1">@item.화물종류 운송</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@item.의뢰Id</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@item.현재단계</MudChip>
                            </MudStack>

                            <DriverRoutePaymentSummary PickupTitle="@item.픽업지"
                                                       PickupSubtitle="@PickupScheduleText(item)"
                                                       DropoffTitle="@item.하차지"
                                                       DropoffSubtitle="@TransportDistanceText(item)"
                                                       PaymentLabel="수익"
                                                       PaymentItems="@HistoryPaymentItems(item)" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Menu">사용자 메뉴로</MudButton>
    </MudStack>
</MudContainer>

@code {
    private static string PickupScheduleText(기사운송샘플항목 item)
        => $"예정 {item.예정시각:MM-dd HH:mm}";

    private static string TransportDistanceText(기사운송샘플항목 item)
        => $"운송 {item.운송거리Km:0.0}km";

    private static IReadOnlyList<string> HistoryPaymentItems(기사운송샘플항목 item)
        => [$"{item.예상수익:N0}원", $"다음 처리 {item.다음행동}"];
}
