@page "/login"
@inject IAuthSession AuthSession
@inject AuthApiService AuthApi
@inject I기사푸시토큰등록Service 푸시토큰등록Service
@inject NavigationManager NavigationManager

<PageTitle>로그인</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">기사 로그인</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">지금은 선택적으로 로그인해 배차신청 같은 동작만 확인하고, 홈 화면은 비로그인 상태에서도 바로 볼 수 있다.</MudText>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <MudAlert Severity="@_statusSeverity">@_statusMessage</MudAlert>
        }

        <Ssalddel공통로그인Panel 제목="기사 로그인"
                         설명="기사 앱은 카카오, 구글, 네이버 로그인 버튼을 같은 위치에 두고, 실제 OAuth 연결은 서버 설정이 준비된 뒤 활성화합니다."
                         초기아이디="@_loginId"
                         현재사용자표시="@CurrentUserLabel"
                         상태메시지="@_statusMessage"
                         상태Severity="@_statusSeverity"
                         일반로그인버튼텍스트="@(_isLoggedIn ? "세션 갱신" : "로그인")"
                         개발힌트목록="DriverLoginHints"
                         IsBusy="@_isBusy"
                         OnPasswordLogin="LoginAsync"
                         OnSocialLogin="SocialLoginAsync">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       FullWidth="true"
                       OnClick="GoHome">
                홈으로 이동
            </MudButton>

            @if (_isLoggedIn)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           FullWidth="true"
                           OnClick="Logout">
                    로그아웃
                </MudButton>
            }
        </Ssalddel공통로그인Panel>
    </MudStack>
</MudContainer>

@code {
    private string _loginId = string.Empty;
    private bool _isBusy;
    private bool _isLoggedIn;
    private string? _statusMessage = "개발 단계에서는 홈을 바로 볼 수 있고, 필요할 때만 여기서 로그인하면 된다.";
    private Severity _statusSeverity = Severity.Info;
    private static readonly IReadOnlyList<string> DriverLoginHints =
    [
        "개발용 계정은 서버의 로컬 IdentitySeed 설정에서 명시적으로 활성화해야 합니다."
    ];

    private string CurrentUserLabel => AuthSession.UserName ?? "미로그인";

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.RestoreAsync();
        _isLoggedIn = !string.IsNullOrWhiteSpace(AuthSession.UserId);
        _loginId = AuthSession.UserName ?? string.Empty;
    }

    private async Task LoginAsync(공통로그인요청 request)
    {
        if (_isBusy)
        {
            return;
        }

        _loginId = request.UserNameOrEmail;
        _isBusy = true;

        try
        {
            var result = await AuthApi.LoginAsync(request.UserNameOrEmail, request.Password);
            if (!result.IsSuccess)
            {
                _statusSeverity = Severity.Error;
                _statusMessage = result.ErrorMessage;
                return;
            }
        }
        catch
        {
            _statusSeverity = Severity.Error;
            _statusMessage = "Ssalddel 서버에 연결하지 못했습니다. 서버 실행 상태와 HTTPS 포트를 확인해 주세요.";
            return;
        }
        finally
        {
            _isBusy = false;
        }

        _isLoggedIn = true;
        await 푸시토큰등록Service.저장토큰등록Async();
        _statusSeverity = Severity.Success;
        _statusMessage = $"{AuthSession.UserName ?? _loginId} 님, 서버 로그인되었습니다.";
    }

    private Task SocialLoginAsync(공통소셜로그인요청 request)
    {
        _statusSeverity = Severity.Info;
        _statusMessage = $"{request.ProviderDisplayName} 요청을 받았습니다. ProviderId={request.ProviderId}. 서버 OAuth 설정이 준비되면 이 버튼에서 인증 흐름을 시작합니다.";
        return Task.CompletedTask;
    }

    private async Task Logout()
    {
        await AuthSession.ClearAsync();
        _isLoggedIn = false;
        _statusSeverity = Severity.Info;
        _statusMessage = "로그아웃했습니다.";
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo(DriverRoutes.Home);
    }
}
