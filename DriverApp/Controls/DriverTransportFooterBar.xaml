<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DriverApp.Controls.DriverTransportFooterBar">
    <Border Padding="14"
            BackgroundColor="#ffffff"
            Stroke="#dbe4ef"
            StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18,18,8,8" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#33000000"
                    Offset="0,-4"
                    Radius="18"
                    Opacity="0.22" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="10">
            <BoxView HeightRequest="4"
                     WidthRequest="44"
                     CornerRadius="2"
                     Color="#cbd5e1"
                     HorizontalOptions="Center" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border WidthRequest="34"
                        HeightRequest="34"
                        BackgroundColor="#eef4ff"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label Text="🚚"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label x:Name="TitleLabel"
                           Text="운송요약"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#111827" />
                    <Label x:Name="SummaryLabel"
                           Text="진행 중인 운송 정보를 확인합니다."
                           FontSize="13"
                           TextColor="#475569"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Button x:Name="ToggleButton"
                        Grid.Column="2"
                        Text="⌃"
                        WidthRequest="42"
                        HeightRequest="38"
                        Padding="0"
                        CornerRadius="19"
                        FontSize="18"
                        BackgroundColor="#eef4ff"
                        TextColor="#2563eb"
                        Clicked="OnToggleClicked" />
            </Grid>

            <VerticalStackLayout x:Name="CollapsedSummaryLayout" Spacing="3">
                <Border BackgroundColor="#ecfdf5"
                        Stroke="#86efac"
                        StrokeThickness="1"
                        Padding="10,7"
                        Margin="0,0,0,3">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label x:Name="NextActionLabel"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#166534"
                           LineBreakMode="TailTruncation" />
                </Border>
                <Label x:Name="CollapsedPickupLabel"
                       FontSize="13"
                       TextColor="#111827"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="CollapsedDropoffLabel"
                       FontSize="13"
                       TextColor="#111827"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="CollapsedFareLabel"
                       FontSize="13"
                       TextColor="#111827"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ExpandedDetailsLayout"
                                 Spacing="0"
                                 IsVisible="False">
                <BoxView HeightRequest="1" Color="#e5e7eb" Margin="0,2,0,6" />
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="7"
                      ColumnSpacing="10">
                    <Label Text="📍" Grid.Row="0" TextColor="#2563eb" />
                    <Label x:Name="PickupLabel" Grid.Row="0" Grid.Column="1" FontSize="13" TextColor="#111827" />

                    <Label Text="📍" Grid.Row="1" TextColor="#2563eb" />
                    <Label x:Name="DropoffLabel" Grid.Row="1" Grid.Column="1" FontSize="13" TextColor="#111827" />

                    <Label Text="📦" Grid.Row="2" TextColor="#2563eb" />
                    <Label x:Name="CargoLabel" Grid.Row="2" Grid.Column="1" FontSize="13" TextColor="#111827" />

                    <Label Text="🛣" Grid.Row="3" TextColor="#2563eb" />
                    <Label x:Name="DistanceLabel" Grid.Row="3" Grid.Column="1" FontSize="13" TextColor="#111827" />

                    <Label Text="💳" Grid.Row="4" TextColor="#2563eb" />
                    <Label x:Name="FareLabel" Grid.Row="4" Grid.Column="1" FontSize="13" TextColor="#111827" />

                    <Label Text="👤" Grid.Row="5" TextColor="#2563eb" />
                    <Label x:Name="ReceiverLabel" Grid.Row="5" Grid.Column="1" FontSize="13" TextColor="#111827" />

                    <Label Text="ⓘ" Grid.Row="6" TextColor="#2563eb" />
                    <Label x:Name="RequestLabel" Grid.Row="6" Grid.Column="1" FontSize="13" TextColor="#111827" />
                </Grid>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button Text="목록"
                        BackgroundColor="#eef4ff"
                        TextColor="#2563eb"
                        CornerRadius="8"
                        Clicked="OnOpenMenuClicked" />
                <Button Grid.Column="1"
                        Text="운송 보기"
                        BackgroundColor="#2563eb"
                        TextColor="#ffffff"
                        CornerRadius="8"
                        Clicked="OnOpenTransportClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
