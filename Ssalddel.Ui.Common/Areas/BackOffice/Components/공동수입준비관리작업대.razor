    private static DateTime? DateValue(DateTimeOffset value)
        => value == default ? null : value.ToLocalTime().Date;

    private static DateTime? DateValue(DateTimeOffset? value)
        => value.HasValue ? value.Value.ToLocalTime().Date : null;

    private static DateTimeOffset OffsetValue(DateTime? value, bool endOfDay = false)
    {
        if (!value.HasValue)
        {
            return default;
        }

        var local = endOfDay ? value.Value.Date.AddDays(1).AddTicks(-1) : value.Value.Date.AddHours(12);
        return new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local)).ToUniversalTime();
    }

    private static DateTimeOffset? NullableOffsetValue(DateTime? value, bool endOfDay = false)
        => value.HasValue ? OffsetValue(value, endOfDay) : null;

    private static string Display(string? primary, string? fallback = null)
        => !string.IsNullOrWhiteSpace(primary)
            ? primary.Trim()
            : !string.IsNullOrWhiteSpace(fallback)
                ? fallback.Trim()
                : "-";

    private void HandlePropertyChanged(object? sender, PropertyChangedEventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
        => ViewModel.PropertyChanged -= HandlePropertyChanged;
