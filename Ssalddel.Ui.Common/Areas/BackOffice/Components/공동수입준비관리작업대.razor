@using System.ComponentModel
@using Ssalddel.Contracts.Common.Metadata
@using Ssalddel.Contracts.Common.Orderer
@using Ssalddel.Ui.Common.Areas.BackOffice.ViewModels
@attribute [SsalddelCodeMetadata(SsalddelCodeFeatureKeys.GroupImportTradeReadiness, SsalddelCodeLayer.View, "1.0 인계 대상과 1.5 공급·가격·무역 준비 근거·차단 사유를 한 작업대에서 보여 줍니다.", ContractType = typeof(공동수입준비관리ViewModel), FlowOrder = 60, Effects = SsalddelCodeEffect.UiStateMutation, Boundary = "사람의 승인과 전문 검토를 요구하며 계약·결제·신고·운송 실행 버튼을 제공하지 않습니다.")]
@inject 공동수입준비관리ViewModel ViewModel
@implements IDisposable

<MudStack Spacing="3" Class="trade-readiness-workbench">
    <header class="trade-readiness-workbench__header">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">GROUP IMPORT · 1.5</MudText>
            <MudText Typo="Typo.h4">공급·가격·무역 준비 작업대</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                1.0에서 사람이 승인한 수요 집단에 공급자 근거, 견적, 예상 원가, HS·HTS와 국가별 검토 자료를 연결합니다.
            </MudText>
        </div>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">의사결정 지원 · 실행 없음</MudChip>
    </header>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        이 작업대는 계약 서명, 결제, 수입 신고, 공급자 자동 선정, 운송·창고 지시를 실행하지 않습니다.
        완료 표시는 자격 있는 담당자에게 검토 자료를 인계할 수 있다는 뜻입니다.
    </MudAlert>

    @if (!IsServerAdmin)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            서버관리자 로그인이 필요합니다.
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="RequestLoginAsync">로그인</MudButton>
        </MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(ViewModel.메시지))
        {
            <MudAlert Severity="@(ViewModel.오류메시지 ? Severity.Error : Severity.Info)"
                      Variant="Variant.Outlined"
                      Dense="true">
                @ViewModel.메시지
            </MudAlert>
        }

        @if (ViewModel.처리중 && !ViewModel.초기화됨)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" />
        }
        else
        {
            <section class="trade-readiness-summary" aria-label="1.5 준비 작업 요약">
                <div><span>관리 대상</span><strong>@ViewModel.작업대목록.Count.ToString("N0")</strong></div>
                <div class="is-warning"><span>인계 승인 필요</span><strong>@ViewModel.인계승인필요건수.ToString("N0")</strong></div>
                <div class="is-info"><span>확정 집단</span><strong>@ViewModel.확정집단건수.ToString("N0")</strong></div>
                <div class="is-success"><span>현재 검토 완료</span><strong>@ViewModel.완료검토항목수 / 9</strong></div>
            </section>

            <MudGrid Spacing="3">
                <MudItem xs="12" lg="4">
                    <MudPaper Elevation="0" Outlined="true" Class="trade-readiness-queue pa-3">
                        <div class="trade-readiness-section-title">
                            <div>
                                <MudText Typo="Typo.h6">1.0 인계 대기열</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">확정 검토 또는 확정 상태의 수요 집단</MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                           Color="Color.Primary"
                                           Disabled="@ViewModel.처리중"
                                           OnClick="RefreshAsync"
                                           aria-label="대기열 새로고침" />
                        </div>

                        <MudTextField T="string"
                                      Label="상품·HS·배송권 검색"
                                      Value="@ViewModel.검색어"
                                      ValueChanged="SetSearch"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                        <MudSelect T="string"
                                   Label="단계"
                                   Value="@ViewModel.목록필터"
                                   ValueChanged="SetQueueFilter"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@공동수입준비작업대필터코드.전체">전체</MudSelectItem>
                            <MudSelectItem T="string" Value="@공동수입준비작업대필터코드.인계승인필요">인계 승인 필요</MudSelectItem>
                            <MudSelectItem T="string" Value="@공동수입준비작업대필터코드.인계후보">확정 집단</MudSelectItem>
                        </MudSelect>

                        <div class="trade-readiness-queue__items">
                            @if (ViewModel.필터된작업대목록.Count == 0)
                            {
                                <div class="trade-readiness-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Secondary" />
                                    <span>조건에 맞는 인계 대상이 없습니다.</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var item in ViewModel.필터된작업대목록)
                                {
                                    <button type="button"
                                            class="@QueueItemClass(item)"
                                            aria-pressed="@(ViewModel.선택집단?.자동집단Id == item.자동집단Id)"
                                            @onclick="() => SelectAsync(item)">
                                        <span class="trade-readiness-queue__topline">
                                            <strong>@Display(item.상품명)</strong>
                                            <span class="trade-readiness-state @GroupStateClass(item.현재상태)">@GroupStateLabel(item.현재상태)</span>
                                        </span>
                                        <span>@TransactionTypeLabel(item.거래유형) · @PriceBasisLabel(item.가격표시기준) · @Display(item.HS코드)</span>
                                        <span>@item.총희망수량.ToString("N2") @Display(item.수량단위) · @item.참여자수.ToString("N0")명</span>
                                    </button>
                                }
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="8">
                    @if (ViewModel.선택집단 is null)
                    {
                        <MudPaper Elevation="0" Outlined="true" Class="trade-readiness-empty trade-readiness-empty--detail pa-6">
                            <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheckCircle" Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.h6">왼쪽에서 준비 대상을 선택해 주세요.</MudText>
                        </MudPaper>
                    }
                    else
                    {
                        <section class="trade-readiness-detail" @oninput="ViewModel.초안변경됨">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                                <div class="trade-readiness-detail__header">
                                    <div>
                                        <MudText Typo="Typo.h5">@Display(ViewModel.선택집단.상품명)</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@ViewModel.선택집단.자동집단Id</MudText>
                                    </div>
                                    <div class="trade-readiness-detail__chips">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@TransactionTypeLabel(ViewModel.선택집단.거래유형)</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="@GroupStateColor(ViewModel.선택집단.현재상태)">@GroupStateLabel(ViewModel.선택집단.현재상태)</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="@(ViewModel.인계승인됨 ? Color.Success : Color.Warning)">@HandoffLabel()</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(ViewModel.운영상태?.실행모드 ?? "확인 중")</MudChip>
                                    </div>
                                </div>

                                <dl class="trade-readiness-facts">
                                    <div><dt>거래 문맥</dt><dd>@TransactionTypeLabel(ViewModel.선택집단.거래유형) · @PriceBasisLabel(ViewModel.선택집단.가격표시기준)</dd></div>
                                    <div><dt>HS 기준</dt><dd>@Display(ViewModel.선택집단.HS코드)</dd></div>
                                    <div><dt>모인 수요</dt><dd>@ViewModel.선택집단.총희망수량.ToString("N2") @Display(ViewModel.선택집단.수량단위)</dd></div>
                                    <div><dt>배송권</dt><dd>@Display(ViewModel.선택집단.배송권명)</dd></div>
                                    <div><dt>원장</dt><dd>@(ViewModel.저장원장 is null ? "아직 없음" : $"Rev. {ViewModel.저장원장.Revision}")</dd></div>
                                </dl>
                            </MudPaper>

                            @if (!ViewModel.후속기능활성)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                    1.5 기능 플래그가 꺼져 있습니다. 입력 내용은 서버에 저장되지 않으며 운영 승인 후 사용할 수 있습니다.
                                </MudAlert>
                            }
                            else if (!ViewModel.인계승인됨)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4 trade-readiness-approval">
                                    <MudText Typo="Typo.h6">사람의 1.5 인계 승인</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        모집 목표, 수요 근거와 인계 필요성을 확인한 관리자가 승인 사유를 남깁니다.
                                    </MudText>
                                    <MudTextField T="string"
                                                  Label="승인 사유"
                                                  @bind-Value="ViewModel.승인사유"
                                                  Lines="2"
                                                  Variant="Variant.Outlined"
                                                  Required="true" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Approval"
                                               Disabled="@(!ViewModel.인계승인가능)"
                                               OnClick="ApproveHandoffAsync">
                                        1.5 준비 인계 승인
                                    </MudButton>
                                </MudPaper>
                            }

                            <MudExpansionPanels MultiExpansion="true" Class="trade-readiness-editors">
                                <MudExpansionPanel Text="1. 재료 묶음·기본 조건" Expanded="true">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                        한 구매 준비 묶음에 같은 거래 문맥의 여러 재료를 넣을 수 있습니다. B2B와 B2C 또는 부가세 표시 기준이 다르면 별도 원장으로 나누며, LCL/FCL은 포워더·물류대행업체의 회신으로 기록합니다.
                                    </MudText>
                                    @foreach (var material in ViewModel.초안.재료품목목록.ToArray())
                                    {
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3 trade-readiness-editor-card">
                                            <div class="trade-readiness-editor-card__header">
                                                <div>
                                                    <MudText Typo="Typo.subtitle1">@Display(material.재료명, material.재료키)</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@material.원천자동집단Id</MudText>
                                                </div>
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                               Color="Color.Error"
                                                               Disabled="@(ViewModel.선택집단?.자동집단Id == material.원천자동집단Id)"
                                                               OnClick="() => ViewModel.재료삭제(material)"
                                                               aria-label="재료 품목 삭제" />
                                            </div>
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="재료·상품 키" Value="@material.재료키" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="재료·상품명" Value="@material.재료명" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="참고 HS" Value="@material.원천Hs코드" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" md="6"><MudNumericField T="decimal" Label="모인 수요" Value="@material.모인수요수량" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" md="6"><MudTextField T="string" Label="수량 단위" Value="@material.수량단위" ReadOnly="true" Variant="Variant.Outlined" /></MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                    <MudGrid Spacing="2" Class="mb-3">
                                        <MudItem xs="12" md="9">
                                            <MudSelect T="string" Label="같이 준비할 승인 수요 재료" @bind-Value="ViewModel.추가재료집단Id" Variant="Variant.Outlined" Clearable="true">
                                                @foreach (var candidate in ViewModel.추가가능재료집단목록)
                                                {
                                                    <MudSelectItem T="string" Value="@candidate.자동집단Id">@candidate.상품명 · @candidate.총희망수량.ToString("N2") @candidate.수량단위</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="3" Class="d-flex align-center">
                                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddShoppingCart" Disabled="@(string.IsNullOrWhiteSpace(ViewModel.추가재료집단Id) || ViewModel.처리중)" OnClick="AddMaterialAsync">재료 추가</MudButton>
                                        </MudItem>
                                    </MudGrid>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="4"><MudTextField T="string" Label="출발 국가 ISO 2자리" @bind-Value="ViewModel.초안.출발국가코드" Variant="Variant.Outlined" Required="true" /></MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudSelect T="string" Label="도착 국가" Value="@ViewModel.초안.도착국가코드" ValueChanged="ViewModel.도착국가변경" Variant="Variant.Outlined" Required="true">
                                                <MudSelectItem T="string" Value="@공동수입준비국가코드.대한민국">한국 (KR)</MudSelectItem>
                                                <MudSelectItem T="string" Value="@공동수입준비국가코드.미국">미국 (US)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="4"><MudTextField T="string" Label="비교 기준 통화" @bind-Value="ViewModel.초안.기준통화코드" Variant="Variant.Outlined" Required="true" /></MudItem>
                                    </MudGrid>
                                </MudExpansionPanel>

                                <MudExpansionPanel Text="2. 공급자·기업 근거" Expanded="true">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">플랫폼이 공급자를 자동 선정하지 않습니다. 원출처와 검토자를 남긴 후보만 기록합니다.</MudText>
                                    @foreach (var supplier in ViewModel.초안.공급자근거목록.ToArray())
                                    {
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3 trade-readiness-editor-card">
                                            <div class="trade-readiness-editor-card__header">
                                                <MudText Typo="Typo.subtitle1">@Display(supplier.조직명, supplier.공급자후보키)</MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => ViewModel.공급자삭제(supplier)" aria-label="공급자 근거 삭제" />
                                            </div>
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="후보 키" @bind-Value="supplier.공급자후보키" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="5"><MudTextField T="string" Label="조직명" @bind-Value="supplier.조직명" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="3"><MudTextField T="string" Label="국가 코드" @bind-Value="supplier.국가코드" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="관계" Placeholder="생산자·수출자·유통사" @bind-Value="supplier.관계코드" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="8"><MudTextField T="string" Label="공식 식별자" Placeholder="사업자·법인·등록 번호 또는 공식 명칭" @bind-Value="supplier.공식식별자" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12"><MudTextField T="string" Label="식별·선정 근거 요약" @bind-Value="supplier.근거요약" Lines="2" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="원출처명" @bind-Value="supplier.원출처명" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="8"><MudTextField T="string" Label="원출처 URL" @bind-Value="supplier.원출처Url" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="4"><MudDatePicker Label="확인일" Date="@DateValue(supplier.확인시각Utc)" DateChanged="@(date => supplier.확인시각Utc = OffsetValue(date))" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="검토자" @bind-Value="supplier.검토자표시명" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="4"><MudDatePicker Label="검토일" Date="@DateValue(supplier.검토시각Utc)" DateChanged="@(date => supplier.검토시각Utc = NullableOffsetValue(date))" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" md="6"><MudCheckBox T="bool" @bind-Value="supplier.최신상태재확인필요" Label="거래 전 최신 영업·등록 상태 재확인" /></MudItem>
                                                <MudItem xs="12" md="6"><MudCheckBox T="bool" @bind-Value="supplier.플랫폼자동선정여부" Label="플랫폼 자동 선정" Color="Color.Error" /></MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="ViewModel.공급자추가">공급자 후보 추가</MudButton>
                                </MudExpansionPanel>

                                <MudExpansionPanel Text="3. 견적·MOQ·납기·포장">
                                    @foreach (var quote in ViewModel.초안.견적목록.ToArray())
                                    {
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3 trade-readiness-editor-card">
                                            <div class="trade-readiness-editor-card__header">
                                                <MudText Typo="Typo.subtitle1">@Display(quote.견적키)</MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => ViewModel.견적삭제(quote)" aria-label="견적 삭제" />
                                            </div>
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" md="4"><MudTextField T="string" Label="견적 키" @bind-Value="quote.견적키" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="4">
                                                    <MudSelect T="string" Label="대상 재료" @bind-Value="quote.재료키" Variant="Variant.Outlined" Required="true">
                                                        @foreach (var material in ViewModel.초안.재료품목목록)
                                                        {
