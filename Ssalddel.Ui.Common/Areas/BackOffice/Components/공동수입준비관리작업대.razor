                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12"><MudTextField T="string" Label="공식 원출처 URL" @bind-Value="review.공식원출처Url" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12" md="4"><MudDatePicker Label="확인일" Date="@DateValue(review.확인시각Utc)" DateChanged="@(date => review.확인시각Utc = OffsetValue(date))" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" md="8"><MudTextField T="string" Label="미확인 사유" @bind-Value="review.미확인사유" Variant="Variant.Outlined" /></MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="ViewModel.국가검토추가">국가별 검토 항목 추가</MudButton>
                                </MudExpansionPanel>

                                <MudExpansionPanel Text="8. 책임 초안·미확인 항목">
                                    @foreach (var responsibility in ViewModel.초안.책임초안목록.ToArray())
                                    {
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3 trade-readiness-editor-card">
                                            <div class="trade-readiness-editor-card__header">
                                                <MudText Typo="Typo.subtitle1">@RoleLabel(responsibility.역할코드)</MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => ViewModel.책임삭제(responsibility)" aria-label="책임 초안 삭제" />
                                            </div>
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" md="4">
                                                    <MudSelect T="string" Label="역할" @bind-Value="responsibility.역할코드" Variant="Variant.Outlined">
                                                        @foreach (var role in ResponsibilityRoles)
                                                        {
                                                            <MudSelectItem T="string" Value="@role">@RoleLabel(role)</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12" md="8"><MudTextField T="string" Label="당사자 표시명" @bind-Value="responsibility.당사자표시명" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12"><MudTextField T="string" Label="책임 범위" @bind-Value="responsibility.책임요약" Lines="2" Variant="Variant.Outlined" Required="true" /></MudItem>
                                                <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="responsibility.당사자확인여부" Label="당사자 확인 완료" /></MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="ViewModel.책임추가">책임 역할 추가</MudButton>
                                    <MudTextField T="string"
                                                  Label="미확인 규제·계약 항목 (한 줄에 하나)"
                                                  Value="@ViewModel.미확인항목Text"
                                                  ValueChanged="value => ViewModel.미확인항목Text = value"
                                                  Lines="5"
                                                  Variant="Variant.Outlined"
                                                  Class="mt-4" />
                                </MudExpansionPanel>
                            </MudExpansionPanels>

                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 trade-readiness-evaluation">
                                <div class="trade-readiness-section-title">
                                    <div>
                                        <MudText Typo="Typo.h6">준비 상태 판정</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">저장 전 미리보기로 최신 판정을 확인합니다.</MudText>
                                    </div>
                                    <strong>@ViewModel.완료검토항목수 / 9</strong>
                                </div>
                                <MudProgressLinear Value="@(ViewModel.완료검토항목수 / 9d * 100d)" Color="Color.Primary" Rounded="true" Class="mb-3" />
                                @if (ViewModel.현재평가 is not null)
                                {
                                    <div class="trade-readiness-checks">
                                        @foreach (var item in EvaluationItems(ViewModel.현재평가))
                                        {
                                            <div class="@(item.Ready ? "is-ready" : "is-blocked")">
                                                <MudIcon Icon="@(item.Ready ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" />
                                                <span>@item.Label</span>
                                            </div>
                                        }
                                    </div>
                                    @if (ViewModel.현재평가.차단사유목록.Count > 0)
                                    {
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                                            <strong>차단 사유</strong>
                                            <ul>
                                                @foreach (var blocker in ViewModel.현재평가.차단사유목록)
                                                {
                                                    <li>@blocker</li>
                                                }
                                            </ul>
                                        </MudAlert>
                                    }
                                    @if (ViewModel.현재평가.경고목록.Count > 0)
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                                            <strong>재확인 안내</strong>
                                            <ul>
                                                @foreach (var warning in ViewModel.현재평가.경고목록)
                                                {
                                                    <li>@warning</li>
                                                }
                                            </ul>
                                        </MudAlert>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">미리보기를 실행하면 여덟 준비 영역의 차단 사유를 표시합니다.</MudText>
                                }

                                <div class="trade-readiness-actions">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Preview"
                                               Disabled="@(!ViewModel.미리보기가능)"
                                               OnClick="PreviewAsync">
                                        준비 상태 미리보기
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               Disabled="@(!ViewModel.저장가능)"
                                               OnClick="SaveAsync">
                                        공동수입 원장 준비 블록 저장
                                    </MudButton>
                                </div>
                                <div class="trade-readiness-boundary" aria-label="실행 차단 상태">
                                    <span>계약 불가</span><span>결제 불가</span><span>신고 불가</span><span>운송 지시 불가</span>
                                </div>
                            </MudPaper>

                            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                                <div class="trade-readiness-section-title">
                                    <div>
                                        <MudText Typo="Typo.h6">1.5 공동수입 준비 OS</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">저장된 원장의 근거·최신성·사람 인계를 정기 점검하고 실행 이력을 남깁니다.</MudText>
                                    </div>
                                    @if (ViewModel.준비Os상태 is not null)
                                    {
                                        <div class="trade-readiness-detail__chips">
                                            <MudChip T="string" Size="Size.Small" Color="@OsStateColor(ViewModel.준비Os상태.상태코드)">@OsStateLabel(ViewModel.준비Os상태.상태코드)</MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(ViewModel.준비Os상태.OsWorker활성여부 ? "worker 활성" : "worker 비활성")</MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@ViewModel.준비Os상태.실행모드</MudChip>
                                        </div>
                                    }
                                </div>

                                @if (ViewModel.저장원장 is null)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                        공동수입 원장에 준비 블록을 저장하면 OS가 작업 상태와 공유 배치 등록 현황을 표시합니다.
                                    </MudAlert>
                                }
                                else if (ViewModel.준비Os상태 is null)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                        저장된 원장의 1.5 OS 상태를 불러오지 못했습니다. 기능 플래그와 원장 상태를 확인해 주세요.
                                    </MudAlert>
                                }
                                else
                                {
                                    @if (ViewModel.초안저장후변경됨)
                                    {
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                            화면의 편집 내용은 아직 저장되지 않았습니다. 원장을 먼저 저장해야 OS가 새 자료를 점검합니다.
                                        </MudAlert>
                                    }

                                    <MudGrid Spacing="2" Class="mb-3">
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">마지막 조율</MudText>
                                            <MudText Typo="Typo.body2">@DisplayOsTime(ViewModel.준비Os상태.마지막조율시각Utc)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">다음 점검</MudText>
                                            <MudText Typo="Typo.body2">@DisplayOsTime(ViewModel.준비Os상태.다음점검시각Utc)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">원장 Revision</MudText>
                                            <MudText Typo="Typo.body2">Rev. @ViewModel.준비Os상태.원장Revision</MudText>
                                        </MudItem>
                                    </MudGrid>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Sync"
                                               Disabled="@(!ViewModel.Os작업실행가능)"
                                               OnClick="RunAllOsChecksAsync"
                                               Class="mb-3">
                                        전체 준비 작업 점검
                                    </MudButton>

                                    <MudStack Spacing="2">
                                        @foreach (var workload in ViewModel.준비Os상태.작업목록)
                                        {
                                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                                <div class="trade-readiness-editor-card__header">
                                                    <div>
                                                        <MudText Typo="Typo.subtitle1">@workload.작업명</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@workload.작업코드 · 시도 @(workload.시도횟수)회</MudText>
                                                    </div>
                                                    <div class="trade-readiness-detail__chips">
                                                        <MudChip T="string" Size="Size.Small" Color="@OsWorkloadColor(workload.상태코드)">@OsWorkloadLabel(workload.상태코드)</MudChip>
                                                        @if (workload.수동실행가능여부)
                                                        {
                                                            <MudButton Variant="Variant.Text"
                                                                       Size="Size.Small"
                                                                       Color="Color.Primary"
                                                                       Disabled="@(!ViewModel.Os작업실행가능)"
                                                                       OnClick="() => RunOsWorkloadAsync(workload)">
                                                                @(workload.재시도가능여부 ? "재시도" : "점검")
                                                            </MudButton>
                                                        }
                                                    </div>
                                                </div>
                                                <MudText Typo="Typo.body2">@workload.상태안내</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@workload.데이터출처 · @workload.실행경계</MudText>
                                                @if (workload.차단사유목록.Count > 0)
                                                {
                                                    <ul class="mb-0">
                                                        @foreach (var blocker in workload.차단사유목록)
                                                        {
                                                            <li>@blocker</li>
                                                        }
                                                    </ul>
                                                }
                                                @if (workload.경고목록.Count > 0)
                                                {
                                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-2">
                                                        @string.Join(" ", workload.경고목록)
                                                    </MudAlert>
                                                }
                                            </MudPaper>
                                        }
                                    </MudStack>

                                    <MudExpansionPanels Class="mt-3">
                                        <MudExpansionPanel Text="공유 공공데이터 배치 등록 현황">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                                KAMIS·USDA·기업 근거 수집과 가격 브리프 작업은 기존 공유 Quartz 스케줄을 재사용합니다. 여기서는 등록 상태만 확인하며 즉시 외부 호출하지 않습니다.
                                            </MudText>
                                            <MudStack Spacing="2">
                                                @foreach (var batch in ViewModel.준비Os상태.공유배치목록)
                                                {
                                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                                        <div class="trade-readiness-editor-card__header">
                                                            <div>
                                                                <MudText Typo="Typo.subtitle2">@batch.작업명</MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@batch.데이터출처 · @batch.스케줄</MudText>
                                                            </div>
                                                            <MudChip T="string" Size="Size.Small" Color="@(batch.Os사용활성여부 ? Color.Success : Color.Default)">
                                                                @(batch.Os사용활성여부 ? "OS 사용" : batch.등록여부 ? "등록됨·OS 비활성" : "설정 비활성")
                                                            </MudChip>
                                                        </div>
                                                        <MudText Typo="Typo.body2">@batch.상태안내</MudText>
                                                    </MudPaper>
                                                }
                                            </MudStack>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>

                                    <MudDivider Class="my-4" />
                                    @if (ViewModel.준비Os상태.전문검토인계기록 is not null)
                                    {
                                        var handoff = ViewModel.준비Os상태.전문검토인계기록;
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                            <strong>@handoff.검토수신자표시명</strong>에게 @DisplayOsTime(handoff.인계시각Utc)에 전문 검토 자료를 인계했습니다.<br />
                                            @handoff.검토범위 · @handoff.인계메모
                                        </MudAlert>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.h6">사람 전문 검토 인계</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                            OS가 구조와 최신성을 통과시킨 뒤 관리자가 실제 검토 수신자와 범위를 확인해 인계합니다. 인계 기록만으로 전문 판단이 완료되지는 않습니다.
                                        </MudText>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" md="4"><MudTextField T="string" Label="검토 수신자" @bind-Value="ViewModel.전문검토수신자" Variant="Variant.Outlined" Required="true" /></MudItem>
                                            <MudItem xs="12" md="8"><MudTextField T="string" Label="검토 범위" @bind-Value="ViewModel.전문검토범위" Variant="Variant.Outlined" Required="true" /></MudItem>
                                            <MudItem xs="12"><MudTextField T="string" Label="인계 메모" @bind-Value="ViewModel.전문검토인계메모" Lines="2" Variant="Variant.Outlined" Required="true" /></MudItem>
                                        </MudGrid>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.AssignmentInd"
                                                   Disabled="@(!ViewModel.전문검토인계가능)"
                                                   OnClick="HandoffQualifiedReviewAsync">
                                            전문 검토로 인계
                                        </MudButton>
                                    }

                                    <div class="trade-readiness-boundary mt-4" aria-label="1.5 OS 실행 차단 상태">
                                        <span>계약 실행 없음</span><span>결제 실행 없음</span><span>신고 실행 없음</span><span>운송 실행 없음</span>
                                    </div>
                                }
                            </MudPaper>
                        </section>
                    }
                </MudItem>
            </MudGrid>
        }
    }
</MudStack>

@code {
    [Parameter] public bool IsServerAdmin { get; set; }
    [Parameter] public string? AdministratorDisplayName { get; set; }
    [Parameter] public EventCallback LoginRequested { get; set; }

    private static readonly IReadOnlyList<string> CostCategories = 공동수입준비비용범주코드.필수목록;
    private static readonly IReadOnlyList<string> ReviewStatuses = 공동수입준비검토상태코드.지원목록.OrderBy(value => value).ToArray();
    private static readonly IReadOnlyList<string> ResponsibilityRoles =
    [
        공동수입준비책임역할코드.판매자수출자,
        공동수입준비책임역할코드.수입자,
        공동수입준비책임역할코드.관세사,
        공동수입준비책임역할코드.플랫폼,
        공동수입준비책임역할코드.운송수행자
    ];

    protected override void OnInitialized()
        => ViewModel.PropertyChanged += HandlePropertyChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (IsServerAdmin)
        {
            await ViewModel.초기화Async(AdministratorDisplayName);
        }
    }

    private Task RequestLoginAsync() => LoginRequested.InvokeAsync();
    private Task RefreshAsync() => ViewModel.새로고침Async();
    private Task SelectAsync(공동구매자동집단요약응답 item) => ViewModel.선택Async(item);
    private Task ApproveHandoffAsync() => ViewModel.인계승인Async();
    private Task AddMaterialAsync() => ViewModel.재료집단추가Async();
    private Task PreviewAsync() => ViewModel.미리보기Async();
    private Task SaveAsync() => ViewModel.저장Async();
    private Task RunAllOsChecksAsync()
        => ViewModel.Os작업실행Async(공동수입준비Os작업코드.전체준비점검, 재시도여부: false);
    private Task RunOsWorkloadAsync(공동수입준비Os작업응답 workload)
        => ViewModel.Os작업실행Async(workload.작업코드, workload.재시도가능여부);
    private Task HandoffQualifiedReviewAsync() => ViewModel.전문검토인계Async();
    private void SetSearch(string value) => ViewModel.검색어 = value;
    private void SetQueueFilter(string value) => ViewModel.목록필터 = value;

    private string QueueItemClass(공동구매자동집단요약응답 item)
        => ViewModel.선택집단?.자동집단Id == item.자동집단Id
            ? "trade-readiness-queue__item is-selected"
            : "trade-readiness-queue__item";

    private string HandoffLabel()
        => ViewModel.운영상태 is null
            ? "OS 상태 없음"
            : ViewModel.인계승인됨
                ? "1.5 인계 승인됨"
                : "인계 승인 필요";

    private static string GroupStateLabel(string? state)
        => state switch
        {
            공동구매자동집단상태코드.확정대기 => "확정 검토",
            공동구매자동집단상태코드.확정 => "확정",
            공동구매자동집단상태코드.모집종료목표미달 => "목표 미달 종료",
            _ => "모집 중"
        };

    private static string GroupStateClass(string? state)
        => state == 공동구매자동집단상태코드.확정대기 ? "is-warning" : "is-confirmed";

    private static Color GroupStateColor(string? state)
        => state == 공동구매자동집단상태코드.확정대기 ? Color.Warning : Color.Success;

    private static string TransactionTypeLabel(string? value)
        => 공동구매거래유형코드.정규화(value) == 공동구매거래유형코드.B2B ? "B2B" : "B2C";

    private static string PriceBasisLabel(string? value)
        => string.Equals(
            value,
            공동구매가격표시기준코드.부가세별도,
