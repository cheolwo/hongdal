@inherits MvvmComponentBase<OfficialFoodIngredientJourneyViewModel>
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inject NavigationManager Navigation

<section class="ingredient-journey" aria-labelledby="ingredient-journey-title">
    <header class="ingredient-journey__header">
        <div>
            <span class="ingredient-journey__eyebrow">FOOD CULTURE → OFFICIAL DATA → COMMUNITY → OPTIONAL CHOICE</span>
            <h2 id="ingredient-journey-title">세계 식문화를 둘러보고, 원할 때 다음 선택으로</h2>
            <p>국가별 음식·재료·가격·기업·품목분류 자료를 함께 해석합니다. 먼저 혼자 구매·수입 조건을 알아보고, 부담스러울 때는 이웃과 역할·비용·위험을 나눌 수 있습니다.</p>
        </div>
        <div class="ingredient-journey__steps" aria-label="이용 순서">
            <span><b>1</b>나라·음식</span>
            <span><b>2</b>공식 근거</span>
            <span><b>3</b>문화 교류</span>
            <span><b>4</b>여기서 마쳐도 됨</span>
            <span><b>5</b>부담되면 함께</span>
        </div>
    </header>

    <OfficialFoodDishBrowsePanel Countries="OfficialFoodIngredientJourneyViewModel.CountryOptions"
                                 SelectedCountryCode="@ViewModel.SelectedCountryCode"
                                 CountryChanged="SelectCountryAsync"
                                 SearchText="@ViewModel.DishSearchText"
                                 SearchTextChanged="OnDishSearchTextChanged"
                                 SearchRequested="SearchDishesAsync"
                                 Dishes="@ViewModel.Dishes"
                                 SelectedDish="@ViewModel.SelectedDish"
                                 SelectedIngredientKey="@ViewModel.SelectedDishIngredientKey"
                                 SelectedIngredient="@ViewModel.SelectedDishIngredient"
                                 DishSelected="SelectDishAsync"
                                 IngredientSelected="SelectDishIngredient"
                                 PurchaseRequested="StartDishIngredientPurchase"
                                 Busy="@ViewModel.DishDetailBusy"
                                 ErrorMessage="@ViewModel.DishErrorMessage"
                                 CompanyResearch="@ViewModel.CompanyResearch"
                                 CompanyResearchBusy="@ViewModel.CompanyResearchBusy"
                                 CompanyResearchErrorMessage="@ViewModel.CompanyResearchErrorMessage"
                                 CompanyResearchRequested="ResearchSelectedIngredientCompaniesAsync"
                                 HsMapping="@ViewModel.HsMapping"
                                 HsMappingBusy="@ViewModel.HsMappingBusy"
                                 HsMappingErrorMessage="@ViewModel.HsMappingErrorMessage"
                                 HsMappingRequested="LoadSelectedIngredientHsCodesAsync" />

    <div class="ingredient-journey__catalog-heading">
        <span>재료명을 알고 있다면</span>
        <h3>공식 재료·가격에서 바로 찾기</h3>
    </div>

    <OfficialFoodIngredientSearchPanel SearchText="@ViewModel.SearchText"
                                       SearchTextChanged="OnSearchTextChanged"
                                       Busy="@ViewModel.처리중"
                                       SearchRequested="SearchAsync"
                                       ClearRequested="ClearSearchAsync" />

    <p class="ingredient-journey__notice">
        가격은 국가·지역·통화·단위·유통단계와 기준일을 함께 봐야 하며, 서로 다른 기준의 수치를 같은 구매 가격으로 직접 비교하지 않습니다.
    </p>

    @if (ViewModel.처리중)
    {
        <div class="ingredient-journey__state" role="status">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
            <span>재료와 연결된 공공 가격·레시피를 불러오고 있습니다.</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ViewModel.오류메시지))
    {
        <div class="ingredient-journey__state ingredient-journey__state--error" role="alert">
            <strong>재료 정보를 불러오지 못했습니다.</strong>
            <span>@ViewModel.오류메시지</span>
            <button type="button" @onclick="SearchAsync">다시 시도</button>
        </div>
    }
    else if (!ViewModel.HasIngredients)
    {
        <div class="ingredient-journey__state">
            <strong>조건에 맞는 재료가 아직 없습니다.</strong>
            <span>다른 이름으로 검색하거나 공식 레시피 재료 색인이 갱신된 뒤 다시 확인해 주세요.</span>
        </div>
    }
    else
    {
        <OfficialFoodIngredientResultList Ingredients="ViewModel.Ingredients"
                                          PurchaseRequested="StartGroupPurchase" />
    }
</section>

@if (_selectedPurchaseSeeds.Count > 0)
{
    <section class="ingredient-purchase-basket" aria-labelledby="ingredient-purchase-basket-title">
        <div>
            <span>선택한 재료 @(_selectedPurchaseSeeds.Count)개</span>
            <h3 id="ingredient-purchase-basket-title">여러 재료를 한 번에 수요 등록하기</h3>
            <p>재료별 수량과 온도는 다음 화면에서 따로 정합니다. LCL/FCL은 수요 합산 정보를 받은 포워더·물류대행업체의 회신 단계에서 검토합니다.</p>
        </div>
        <div class="ingredient-purchase-basket__items">
            @foreach (var seed in _selectedPurchaseSeeds)
            {
                <span @key="seed.SuggestedProductKey">
                    <strong>@seed.IngredientName</strong>
                    <small>@seed.SourcingModeLabel</small>
                    <button type="button" @onclick="() => RemovePurchaseSeed(seed.SuggestedProductKey)" aria-label="@($"{seed.IngredientName} 선택 해제")">×</button>
                </span>
            }
        </div>
        <div class="ingredient-purchase-basket__actions">
            <button type="button" class="secondary" @onclick="ClearPurchaseSeeds">모두 비우기</button>
            <button type="button" class="primary" @onclick="ContinuePurchase">선택한 재료 수요 설정</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_selectionNotice))
        {
            <p class="ingredient-purchase-basket__notice" role="status">@_selectionNotice</p>
        }
    </section>
}

@code {
    private readonly List<CommunityGroupPurchaseIngredientSeed> _selectedPurchaseSeeds = [];
    private string? _selectionNotice;

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.초기화Async();
    }

    private async Task SearchAsync()
        => await ViewModel.SearchAsync();

    private async Task ClearSearchAsync()
        => await ViewModel.ClearSearchAsync();

    private void OnSearchTextChanged(string value)
        => ViewModel.SearchText = value;

    private void OnDishSearchTextChanged(string value)
        => ViewModel.DishSearchText = value;

    private Task SelectCountryAsync(string countryCode)
        => ViewModel.SelectCountryAsync(countryCode);

    private Task SearchDishesAsync()
        => ViewModel.SearchDishesAsync();

    private Task SelectDishAsync(string dishKey)
        => ViewModel.SelectDishAsync(dishKey);

    private void SelectDishIngredient(string ingredientKey)
        => ViewModel.SelectDishIngredient(ingredientKey);

    private Task ResearchSelectedIngredientCompaniesAsync()
        => ViewModel.ResearchSelectedIngredientCompaniesAsync();

    private Task LoadSelectedIngredientHsCodesAsync()
        => ViewModel.LoadSelectedIngredientHsCodesAsync();

    private void StartGroupPurchase(OfficialFoodIngredientPurchaseSelection selection)
    {
        var seed = OfficialFoodIngredientPresentation.CreatePurchaseSeed(selection);
        if (seed is not null)
        {
            AddPurchaseSeed(seed);
        }
    }

    private void StartDishIngredientPurchase(OfficialFoodDishIngredientPurchaseSelection selection)
    {
        var seed = OfficialFoodIngredientPresentation.CreatePurchaseSeed(selection);
        if (seed is not null)
        {
            AddPurchaseSeed(seed);
        }
    }

    private void AddPurchaseSeed(CommunityGroupPurchaseIngredientSeed seed)
    {
        var existingIndex = _selectedPurchaseSeeds.FindIndex(item => string.Equals(
            item.SuggestedProductKey,
            seed.SuggestedProductKey,
            StringComparison.Ordinal));
        if (existingIndex >= 0)
        {
            _selectedPurchaseSeeds[existingIndex] = seed;
            _selectionNotice = $"{seed.IngredientName}의 조달 방향을 갱신했습니다.";
            return;
        }
        if (_selectedPurchaseSeeds.Count >= CommunityGroupPurchaseIngredientSeed.MaxBundleItems)
        {
            _selectionNotice = $"한 번에 최대 {CommunityGroupPurchaseIngredientSeed.MaxBundleItems}개 재료까지 선택할 수 있습니다.";
            return;
        }

        _selectedPurchaseSeeds.Add(seed);
        _selectionNotice = $"{seed.IngredientName}을 구매 준비 묶음에 담았습니다.";
    }

    private void RemovePurchaseSeed(string productKey)
    {
        _selectedPurchaseSeeds.RemoveAll(seed => string.Equals(
            seed.SuggestedProductKey,
            productKey,
            StringComparison.Ordinal));
        _selectionNotice = _selectedPurchaseSeeds.Count == 0 ? null : "선택한 재료를 묶음에서 뺐습니다.";
    }

    private void ClearPurchaseSeeds()
    {
        _selectedPurchaseSeeds.Clear();
        _selectionNotice = null;
    }

    private void ContinuePurchase()
    {
        if (_selectedPurchaseSeeds.Count > 0)
        {
            Navigation.NavigateTo(CommunityGroupPurchaseIngredientSeed.ToDemandNavigationUri(_selectedPurchaseSeeds));
        }
    }
}
