@inherits MvvmComponentBase<농산물지역가격비교ViewModel>
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="produce-price">
    <header class="produce-price__hero">
        <div>
            <a class="produce-price__back" href="@BackHref">← @BackLabel</a>
            <span>과일·채소 · 지역별 가격 비교</span>
            <h1>같은 농산물도 지역마다 얼마가 다를까?</h1>
            <p>품목과 지역을 고르면 공식 관측값을 같은 중량과 접속자 통화로 환산합니다.</p>
        </div>
        <div class="produce-price__emoji" aria-hidden="true">@ViewModel.SelectedProduct.Emoji</div>
    </header>

    <section class="produce-price__catalog" aria-label="농산물 품목 선택">
        <div class="produce-price__category" role="group" aria-label="과일 또는 채소">
            @foreach (var category in Enum.GetValues<농산물가격분류>())
            {
                <button type="button"
                        class="@(ViewModel.SelectedCategory == category ? "is-selected" : null)"
                        aria-pressed="@(ViewModel.SelectedCategory == category)"
                        @onclick="() => ViewModel.SelectedCategory = category">
                    @(category == 농산물가격분류.과일 ? "과일" : "채소")
                </button>
            }
        </div>

        <div class="produce-price__products">
            @foreach (var product in ViewModel.AvailableProducts)
            {
                <button type="button"
                        class="@(ViewModel.SelectedProductKey == product.Key ? "is-selected" : null)"
                        aria-pressed="@(ViewModel.SelectedProductKey == product.Key)"
                        @onclick="() => ViewModel.SelectedProductKey = product.Key">
                    <span aria-hidden="true">@product.Emoji</span>
                    <strong>@product.Name</strong>
                    <small>@product.DefaultWeightGrams.ToString("0")g 기준</small>
                </button>
            }
        </div>
    </section>

    <section class="produce-price__controls" aria-label="가격 비교 조건">
        <label>
            <span>비교 중량</span>
            <div>
                <input type="range"
                       min="100"
                       max="1000"
                       step="10"
                       @bind="ViewModel.ComparisonWeightGrams" />
                <output>@ViewModel.WeightLabel</output>
            </div>
        </label>
        <label>
            <span>내가 보는 통화</span>
            <select @bind="ViewModel.DisplayCurrency">
                <option value="@농산물가격표시통화.KRW">원화 · KRW</option>
                <option value="@농산물가격표시통화.CNY">위안 · CNY</option>
                <option value="@농산물가격표시통화.USD">달러 · USD</option>
            </select>
        </label>
        <label>
            <span>국가</span>
            <select @bind="ViewModel.SelectedCountryCode">
                @foreach (var option in ViewModel.AvailableCountries)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </label>
        <label>
            <span>지역</span>
            <select @bind="ViewModel.SelectedRegionCode">
                @foreach (var option in ViewModel.AvailableRegions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </label>
    </section>

    <section class="produce-price__summary" aria-label="@($"{ViewModel.SelectedProduct.Name} 지역 가격 비교")">
        <div>
            <span>선택 품목</span>
            <strong>@ViewModel.SelectedProduct.Emoji @ViewModel.SelectedProduct.Name</strong>
        </div>
        <div>
            <span>비교 기준</span>
            <strong>@ViewModel.WeightLabel · @ViewModel.DisplayCurrencyLabel</strong>
        </div>
        <div>
            <span>연결된 관측값</span>
            <strong>@(ViewModel.Items.Count)개 지역</strong>
        </div>
    </section>

    <section class="produce-price__view-options" aria-label="가격 비교 보기 방식">
        <div>
            <span>보기 방식</span>
            <strong>가격 차이는 표로, 세부 근거는 카드로 확인하세요.</strong>
        </div>
        <div class="produce-price__view-toggle" role="group">
            <button type="button"
                    class="@(ViewModel.ViewMode == 농산물가격보기방식.비교표 ? "is-selected" : null)"
                    aria-pressed="@(ViewModel.ViewMode == 농산물가격보기방식.비교표)"
                    @onclick="() => ViewModel.ViewMode = 농산물가격보기방식.비교표">
                비교표
            </button>
            <button type="button"
                    class="@(ViewModel.ViewMode == 농산물가격보기방식.카드 ? "is-selected" : null)"
                    aria-pressed="@(ViewModel.ViewMode == 농산물가격보기방식.카드)"
                    @onclick="() => ViewModel.ViewMode = 농산물가격보기방식.카드">
                가로 카드
            </button>
        </div>
    </section>

    @if (ViewModel.Items.Count == 0)
    {
        <div class="produce-price__empty">
            선택한 조건에 연결된 공식 지역 관측값이 없습니다. 국가 또는 지역 범위를 넓혀 주세요.
        </div>
    }
    else if (ViewModel.ViewMode == 농산물가격보기방식.비교표)
    {
        <div class="produce-price__table-wrap">
            <table class="produce-price__table">
                <caption>
                    @ViewModel.SelectedProduct.Name @ViewModel.WeightLabel 환산 가격 · 낮은 가격 순
                </caption>
                <thead>
                    <tr>
                        <th scope="col">순서</th>
                        <th scope="col">국가·지역</th>
                        <th scope="col">@ViewModel.WeightLabel 가격</th>
                        <th scope="col">kg 가격</th>
                        <th scope="col">최저 관측값과 차이</th>
                        <th scope="col">시장 단계·기준일</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < ViewModel.Items.Count; index++)
                    {
                        var item = ViewModel.Items[index];
                        <tr>
                            <td><span class="produce-price__rank">@(index + 1)</span></td>
                            <th scope="row">
                                <strong>@item.Observation.RegionName</strong>
                                <small>@item.Observation.CountryName · @item.Observation.Variety</small>
                            </th>
                            <td class="produce-price__table-price">
                                @ViewModel.FormatDisplayPrice(item.DisplayWeightPrice)
                            </td>
                            <td>@ViewModel.FormatDisplayPrice(item.DisplayKilogramPrice)</td>
                            <td>
                                @if (item.DisplayDifferenceFromLowest == 0m)
                                {
                                    <span class="produce-price__gap is-lowest">최저 관측값</span>
                                }
                                else
                                {
                                    <span class="produce-price__gap">
                                        +@ViewModel.FormatDisplayPrice(item.DisplayDifferenceFromLowest)
                                        <small>+@item.DifferencePercentFromLowest.ToString("N1")%</small>
                                    </span>
                                }
                            </td>
                            <td>
                                <span>@item.Observation.MarketStage</span>
                                <small>@item.Observation.ReferenceDate · @item.Observation.RegionCode</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="produce-price__swipe-hint">카드를 좌우로 넘겨 지역별 세부 근거를 확인하세요. →</p>
        <div class="produce-price__cards">
            @foreach (var item in ViewModel.Items)
            {
                <article class="produce-price__card">
                    <header>
                        <span>@item.Observation.CountryCode</span>
                        <div>
                            <h2>@item.Observation.RegionName</h2>
                            <p>@item.Observation.CountryName · @item.Observation.Variety</p>
                        </div>
                    </header>

                    <div class="produce-price__primary">
                        <span>@ViewModel.WeightLabel 환산</span>
                        <strong>@ViewModel.FormatDisplayPrice(item.DisplayWeightPrice)</strong>
                        <small>@ViewModel.DisplayCurrencyLabel 기준</small>
                    </div>

                    <dl>
                        <div>
                            <dt>원문 가격</dt>
                            <dd>@item.Observation.NativePrice.ToString("N2") @item.Observation.NativeCurrency / @item.Observation.NativeUnit</dd>
                        </div>
                        <div>
                            <dt>동일 단위</dt>
                            <dd>@ViewModel.FormatDisplayPrice(item.DisplayKilogramPrice) / kg</dd>
                        </div>
                        <div>
                            <dt>시장 단계</dt>
                            <dd>@item.Observation.MarketStage</dd>
                        </div>
                        <div>
                            <dt>지역 코드</dt>
                            <dd>@item.Observation.RegionCode</dd>
                        </div>
                        <div>
                            <dt>기준일</dt>
                            <dd>@item.Observation.ReferenceDate</dd>
                        </div>
                    </dl>

                    <p class="produce-price__limitation">@item.Observation.Limitation</p>
                    <a href="@item.Observation.SourceUrl" target="_blank" rel="noreferrer">
                        @item.Observation.SourceName 원문 보기
                    </a>
                </article>
            }
        </div>
    }

    <aside class="produce-price__method">
        <div>
            <span>환산 기준</span>
            <strong>@ViewModel.ExchangeRateReference</strong>
        </div>
        <p>
            원문 가격을 kg으로 맞춘 뒤 @(ViewModel.WeightLabel)로 계산했습니다.
            지역·품종·등급·시장 단계와 조사일이 다르므로 구매가나 지역 순위로 해석할 수 없습니다.
            배송비·세금·할인은 포함하지 않습니다.
        </p>
    </aside>
</section>

@code {
    [Parameter]
    public string BackHref { get; set; } = "/information/public-data";

    [Parameter]
    public string BackLabel { get; set; } = "공공데이터 가격";
}
