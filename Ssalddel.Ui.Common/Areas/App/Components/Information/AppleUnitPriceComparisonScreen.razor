@inherits MvvmComponentBase<사과한개가격비교ViewModel>
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="apple-price">
    <header class="apple-price__hero">
        <div>
            <a class="apple-price__back" href="/information/public-data">← 공공데이터 가격</a>
            <span>한 개 가격 · 동일 중량 비교</span>
            <h1>사과 한 개, 세 나라에서는 얼마일까?</h1>
            <p>한국·미국·중국의 공식 관측값을 같은 중량과 접속자 통화로 환산합니다.</p>
        </div>
        <div class="apple-price__apple" aria-hidden="true">🍎</div>
    </header>

    <section class="apple-price__controls" aria-label="비교 기준">
        <label>
            <span>사과 한 개 중량</span>
            <div>
                <input type="range"
                       min="100"
                       max="500"
                       step="10"
                       @bind="ViewModel.AppleWeightGrams" />
                <output>@ViewModel.WeightLabel</output>
            </div>
        </label>
        <label>
            <span>내가 보는 통화</span>
            <select @bind="ViewModel.DisplayCurrency">
                <option value="@사과가격표시통화.KRW">원화 · KRW</option>
                <option value="@사과가격표시통화.CNY">위안 · CNY</option>
                <option value="@사과가격표시통화.USD">달러 · USD</option>
            </select>
        </label>
        <p>
            접속 언어에 따라 원화·위안·달러를 먼저 선택합니다.
            비교 통화는 언제든 바꿀 수 있습니다.
        </p>
    </section>

    <section class="apple-price__summary" aria-label="@($"{ViewModel.WeightLabel} 사과 가격 비교")">
        <div>
            <span>비교 기준</span>
            <strong>@ViewModel.WeightLabel 한 개</strong>
        </div>
        <div>
            <span>표시 통화</span>
            <strong>@ViewModel.DisplayCurrencyLabel</strong>
        </div>
        <div>
            <span>자료 성격</span>
            <strong>정보용 환산</strong>
        </div>
    </section>

    <div class="apple-price__cards">
        @foreach (var item in ViewModel.Items)
        {
            <article class="apple-price__card">
                <header>
                    <span>@item.Observation.CountryCode</span>
                    <div>
                        <h2>@item.Observation.CountryName</h2>
                        <p>@item.Observation.Variety</p>
                    </div>
                </header>

                <div class="apple-price__primary">
                    <span>@ViewModel.WeightLabel 한 개 환산</span>
                    <strong>@ViewModel.FormatDisplayPrice(item.DisplayApplePrice)</strong>
                    <small>@ViewModel.DisplayCurrencyLabel 기준</small>
                </div>

                <dl>
                    <div>
                        <dt>원문 가격</dt>
                        <dd>@item.Observation.NativePrice.ToString("N2") @item.Observation.NativeCurrency / @item.Observation.NativeUnit</dd>
                    </div>
                    <div>
                        <dt>동일 단위</dt>
                        <dd>@ViewModel.FormatDisplayPrice(item.DisplayKilogramPrice) / kg</dd>
                    </div>
                    <div>
                        <dt>시장 단계</dt>
                        <dd>@item.Observation.MarketStage</dd>
                    </div>
                    <div>
                        <dt>지역</dt>
                        <dd>@item.Observation.Region</dd>
                    </div>
                    <div>
                        <dt>기준일</dt>
                        <dd>@item.Observation.ReferenceDate</dd>
                    </div>
                </dl>

                <p class="apple-price__limitation">@item.Observation.Limitation</p>
                <a href="@item.Observation.SourceUrl" target="_blank" rel="noreferrer">
                    @item.Observation.SourceName 원문 보기
                </a>
            </article>
        }
    </div>

    <aside class="apple-price__method">
        <div>
            <span>환산 기준</span>
            <strong>@ViewModel.ExchangeRateReference</strong>
        </div>
        <p>
            가격 ÷ 원문 중량 × @(ViewModel.WeightLabel)로 계산했습니다.
            품종·등급·지역·시장 단계와 조사일이 서로 달라 구매가나 국가 순위로 해석할 수 없습니다.
            배송비·세금·할인도 포함하지 않습니다.
        </p>
    </aside>
</section>
