@inherits MvvmComponentBase<OfficialFoodIngredientDemandViewModel>

<main class="ingredient-demand" aria-labelledby="ingredient-demand-title">
    <header class="ingredient-demand__hero">
        <div>
            <a href="@BackHref" class="ingredient-demand__back">← 음식·재료 탐색</a>
            <span>NONBINDING GROUP-BUY DEMAND</span>
            <h1 id="ingredient-demand-title">재료 수요 조건 확인</h1>
            <p>탐색에서 고른 재료 문맥을 유지한 채 수령 권역과 희망 수량을 직접 정하고, 서버 집단화 결과를 미리 확인합니다.</p>
        </div>
        <ol aria-label="수요 등록 순서">
            <li><b>1</b>재료 근거 확인</li>
            <li><b>2</b>수령 조건 입력</li>
            <li><b>3</b>집단화 미리보기</li>
            <li><b>4</b>비구속 저장·철회</li>
        </ol>
    </header>

    @if (ViewModel.Seed is not { } seed)
    {
        <section class="ingredient-demand__state" role="alert">
            <strong>선택한 재료 문맥이 없습니다.</strong>
            <span>음식·재료 탐색 화면에서 필요한 재료를 선택한 뒤 다시 들어와 주세요.</span>
            <a href="@BackHref">탐색으로 돌아가기</a>
        </section>
    }
    else
    {
        <section class="ingredient-demand__context" aria-labelledby="ingredient-demand-context-title">
            <div>
                <span>선택 재료</span>
                <h2 id="ingredient-demand-context-title">@seed.IngredientName</h2>
                <code>@seed.SuggestedProductKey</code>
            </div>
            <dl>
                @if (!string.IsNullOrWhiteSpace(seed.FoodName))
                {
                    <div><dt>둘러본 음식</dt><dd>@seed.FoodName</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(seed.RecipeTitle))
                {
                    <div><dt>참고 레시피</dt><dd>@seed.RecipeTitle</dd></div>
                }
                <div><dt>조달 검토 방향</dt><dd>@seed.SourcingModeLabel</dd></div>
                @if (!string.IsNullOrWhiteSpace(seed.FoodCountryCode))
                {
                    <div><dt>음식 문화 국가</dt><dd>@seed.FoodCountryCode · 상품 원산지나 배송국으로 자동 사용하지 않음</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(seed.PriceReference))
                {
                    <div><dt>공개 가격 참고</dt><dd>@seed.PriceReference</dd></div>
                }
            </dl>
            @if (!string.IsNullOrWhiteSpace(seed.RecipeUrl))
            {
                <a href="@seed.RecipeUrl" target="_blank" rel="noreferrer">공식 레시피 원문</a>
            }
        </section>

        <section class="ingredient-demand__boundary" aria-label="비구속 수요 경계">
            <strong>이 단계는 구매 주문이 아닙니다.</strong>
            <span>수요 저장만으로 결제·계약·수입 신고·공급자 선정·운송 의뢰·창고 입고를 실행하지 않습니다.</span>
        </section>

        @if (!ViewModel.IsAuthenticated)
        {
            <section class="ingredient-demand__login" role="status">
                <div>
                    <strong>탐색은 공개, 수요 저장은 로그인 후</strong>
                    <span>사용자 소유 수요와 철회 권한을 확인하기 위해 로그인한 계정이 필요합니다.</span>
                </div>
                <a href="@LoginHref">로그인하고 이 수요로 돌아오기</a>
            </section>
        }

        <section class="ingredient-demand__form" aria-labelledby="ingredient-demand-form-title">
            <header>
                <span>YOUR CONDITIONS</span>
                <h2 id="ingredient-demand-form-title">수령·수량 조건</h2>
                <p>상세 주소는 받지 않습니다. 공개 집단화에는 국가와 우편번호·생활권 수준의 권역만 사용합니다.</p>
            </header>

            <div class="ingredient-demand__fields">
                <label>
                    <span>수령 국가</span>
                    <select @bind="ViewModel.DeliveryCountryCode" disabled="@ViewModel.ActionBusy">
                        <option value="KR">대한민국</option>
                        <option value="US">미국</option>
                        <option value="JP">일본</option>
                        <option value="GB">영국</option>
                        <option value="CA">캐나다</option>
                        <option value="FR">프랑스</option>
                    </select>
                </label>
                <label>
                    <span>우편번호·생활권 코드</span>
                    <input value="@ViewModel.DeliveryAreaCode"
                           @oninput="OnDeliveryAreaInput"
                           maxlength="24"
                           autocomplete="postal-code"
                           placeholder="예: 06236 또는 10001"
                           disabled="@ViewModel.ActionBusy" />
                </label>
                <label>
                    <span>수령 방식</span>
                    <select @bind="ViewModel.ReceiptMethodCode" disabled="@ViewModel.ActionBusy">
                        <option value="@OfficialFoodIngredientReceiptMethodCodes.SharedPickup">공동 수령</option>
                        <option value="@OfficialFoodIngredientReceiptMethodCodes.LocalHub">생활권 거점 수령</option>
                        <option value="@OfficialFoodIngredientReceiptMethodCodes.Parcel">택배 수령</option>
                    </select>
                </label>
                <label>
                    <span>보관 온도</span>
                    <select @bind="ViewModel.TemperatureCode" disabled="@ViewModel.ActionBusy">
                        <option value="상온">상온</option>
                        <option value="냉장">냉장</option>
                        <option value="냉동">냉동</option>
                    </select>
                </label>
                <label>
                    <span>희망 수량</span>
                    <input type="number"
                           min="0.1"
                           step="0.1"
                           @bind="ViewModel.DesiredQuantity"
                           disabled="@ViewModel.ActionBusy" />
                </label>
                <label>
                    <span>수량 단위</span>
                    <input value="@ViewModel.QuantityUnit"
                           @oninput="OnQuantityUnitInput"
                           maxlength="20"
                           disabled="@ViewModel.ActionBusy" />
                </label>
            </div>

            <div class="ingredient-demand__actions">
                <button type="button"
                        class="secondary"
                        disabled="@(!ViewModel.CanPreview)"
                        @onclick="PreviewAsync">
                    @(ViewModel.ActionBusy ? "확인 중" : "집단화 미리보기")
                </button>
                <button type="button"
                        class="primary"
                        disabled="@(!ViewModel.CanRegister)"
                        @onclick="RegisterAsync">
                    @(ViewModel.HasActiveDemand ? "비구속 수요 변경 저장" : "비구속 수요 저장")
                </button>
                @if (ViewModel.CanWithdraw)
                {
                    <button type="button" class="warning" @onclick="WithdrawAsync">내 수요 철회</button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(ViewModel.ActionError))
            {
                <div class="ingredient-demand__message is-error" role="alert">
                    <strong>처리하지 못했습니다.</strong>
                    <span>@ViewModel.ActionError</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(ViewModel.ActionNotice))
            {
                <div class="ingredient-demand__message" role="status">@ViewModel.ActionNotice</div>
            }
        </section>

        @if (ViewModel.PlacementPreview is { } preview)
        {
            <section class="ingredient-demand__result" aria-labelledby="ingredient-demand-preview-title">
                <header>
                    <span>SERVER PREVIEW · @preview.정책버전</span>
                    <h2 id="ingredient-demand-preview-title">@(preview.배치유형 == 공동구매자동집단배치유형코드.기존집단 ? "기존 모집에 참여" : "새 모집 후보")</h2>
                    <p>@preview.안내</p>
                </header>
                <div class="ingredient-demand__metrics">
                    <div><span>예상 참여자</span><strong>@preview.예상진행.참여자수.ToString("N0")명</strong></div>
                    <div><span>예상 수량</span><strong>@preview.예상진행.총희망수량.ToString("N1") @preview.예상진행.수량단위</strong></div>
                    <div><span>추가 필요</span><strong>@NumberOrDash(preview.예상진행.추가필요참여자수)명</strong></div>
                    <div><span>모집 마감</span><strong>@DateLabel(preview.예상진행.모집종료시각Utc)</strong></div>
                </div>
                <ul>
                    @foreach (var criterion in preview.적용기준목록)
                    {
                        <li><span>@criterion.기준코드</span><strong>@criterion.기준값</strong></li>
                    }
                </ul>
                <small>@preview.비구속안내</small>
            </section>
        }

        @if (ViewModel.RegisteredGroup is { } group)
        {
            <section class="ingredient-demand__saved" aria-labelledby="ingredient-demand-saved-title">
                <div>
                    <span>SAVED NONBINDING DEMAND</span>
                    <h2 id="ingredient-demand-saved-title">모집 현황에 반영됨</h2>
                    <p>@group.상품명 · @group.배송권명</p>
                </div>
                <div class="ingredient-demand__metrics">
                    <div><span>현재 참여자</span><strong>@group.참여자수.ToString("N0")명</strong></div>
                    <div><span>총 희망 수량</span><strong>@group.총희망수량.ToString("N1") @group.수량단위</strong></div>
                    <div><span>모집 상태</span><strong>@StatusLabel(group.현재상태)</strong></div>
                    <div><span>모집 마감</span><strong>@DateLabel(group.모집종료시각Utc)</strong></div>
                </div>
            </section>
        }
    }
</main>

@code {
    [Parameter, EditorRequired]
    public CommunityGroupPurchaseIngredientSeed? IngredientSeed { get; set; }

    [Parameter]
    public string BackHref { get; set; } = "/information/food-ingredients";

    [Parameter]
    public string LoginHref { get; set; } = "/";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ViewModel.ApplySeed(IngredientSeed);
    }

    private void OnDeliveryAreaInput(ChangeEventArgs args)
        => ViewModel.DeliveryAreaCode = args.Value?.ToString() ?? string.Empty;

    private void OnQuantityUnitInput(ChangeEventArgs args)
        => ViewModel.QuantityUnit = args.Value?.ToString() ?? string.Empty;

    private Task PreviewAsync() => ViewModel.PreviewAsync();
    private Task RegisterAsync() => ViewModel.RegisterAsync();
    private Task WithdrawAsync() => ViewModel.WithdrawAsync();

    private static string NumberOrDash(int? value) => value?.ToString("N0") ?? "-";

    private static string DateLabel(DateTime value)
        => value == default ? "미정" : value.ToLocalTime().ToString("yyyy.MM.dd HH:mm");

    private static string StatusLabel(string value)
        => value switch
        {
            공동구매자동집단상태코드.확정대기 => "조건 충족 · 확인 대기",
            공동구매자동집단상태코드.확정 => "확정",
            공동구매자동집단상태코드.모집종료목표미달 => "모집 종료 · 목표 미달",
            _ => "수요 모집 중"
        };
}
