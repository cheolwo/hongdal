@inherits MvvmComponentBase<농수산가격비교PageViewModel>
@using Ssalddel.Contracts.Common.PublicData
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="public-data-workspace">
    <header class="public-data-workspace__header">
        <div>
            <span>공식 공공데이터</span>
            <h1>@(DomesticOnly ? "한국 농수산물 가격" : "한국·미국·호주 농수산물 가격")</h1>
            <p>
                @(DomesticOnly
                    ? "KAMIS 조사값을 원문 품목·거래 단위·유통단계와 함께 확인합니다."
                    : "각 국가의 조사값을 통화·단위·유통단계와 함께 비교합니다.")
            </p>
            <div class="public-data-workspace__related-links">
                <a class="public-data-workspace__produce-link" href="@RegionalAgriculturalMapRoutes.ForCountry(RegionalAgriculturalMapCountryCodes.Korea)">
                    한국·미국 지도 · 지역별 가격 관측
                </a>
                <a class="public-data-workspace__produce-link" href="information/kamis-domestic-price-comparison">
                    KAMIS · 국내 유통단계 가격 비교
                </a>
                @if (!DomesticOnly)
                {
                    <a class="public-data-workspace__produce-link" href="information/usda-us-price-comparison">
                        USDA · 미국 국내 농가가격 비교
                    </a>
                    <a class="public-data-workspace__produce-link" href="information/produce-price-comparison">
                        과일·채소 · 국가·지역별 가격 비교
                    </a>
                }
            </div>
        </div>
        <div class="public-data-workspace__market-status" aria-label="지원 시장">
            <span>KR</span>
            @if (!DomesticOnly)
            {
                <span>US</span>
                <span>AU</span>
            }
        </div>
    </header>

    <nav class="public-data-workspace__section-nav" aria-label="농수산물 가격 화면 선택">
        @foreach (var item in SectionNavigationItems)
        {
            <button type="button"
                    class="@BuildSectionButtonClass(item.Section)"
                    aria-current="@(ViewModel.ActiveSection == item.Section ? "page" : null)"
                    @onclick="@(() => ViewModel.SelectSection(item.Section))">
                <span>@item.Eyebrow</span>
                <strong>@item.Label</strong>
            </button>
        }
    </nav>

    <main class="public-data-workspace__content">
            <header class="public-data-workspace__section-header">
                <div>
                    <span>@ViewModel.CurrentSectionEyebrow</span>
                    <h2>@ViewModel.CurrentSectionTitle</h2>
                </div>
                @if (ViewModel.IsLoading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
                }
            </header>

            @if (!string.IsNullOrWhiteSpace(ViewModel.InitializationMessage))
            {
                <MudAlert Severity="Severity.Info" Dense="true">@ViewModel.InitializationMessage</MudAlert>
            }

            @switch (ViewModel.ActiveSection)
            {
                case 농수산가격비교Section.국내:
                    <section class="public-data-workspace__query-section public-data-workspace__query-section--domestic">
                        <label class="public-data-workspace__field">
                            <span>국내 품목</span>
                            <select @bind="ViewModel.국내.선택HsCode">
                                @foreach (var item in ViewModel.국내.품목)
                                {
                                    <option value="@item.HsPrefix">@item.CategoryLabel · @item.ProductName</option>
                                }
                            </select>
                        </label>
                        <데이터조회Button ButtonColor="Color.Success"
                                        StartIcon="@Icons.Material.Filled.Search"
                                        IsLoading="ViewModel.IsLoading"
                                        LoadingText="한국 가격 불러오는 중"
                                        OnClick="@(() => ViewModel.LoadDomesticAsync())">
                            한국 가격 조회
                        </데이터조회Button>
                    </section>
                    <국내농수산가격Result ViewModel="@ViewModel.국내" />
                    break;

                case 농수산가격비교Section.미국:
                    <section class="public-data-workspace__query-section">
                        <label class="public-data-workspace__field">
                            <span>미국 공식 품목명</span>
                            <input list="usda-commodity-examples"
                                   @bind="ViewModel.미국.품목명"
                                   autocomplete="off" />
                        </label>
                        <datalist id="usda-commodity-examples">
                            @foreach (var commodity in 미국농수산가격조회ViewModel.품목예시)
                            {
                                <option value="@commodity"></option>
                            }
                        </datalist>
                        <label class="public-data-workspace__field public-data-workspace__field--small">
                            <span>조사</span>
                            <select @bind="ViewModel.미국.조사Program">
                                <option value="SURVEY">SURVEY</option>
                                <option value="CENSUS">CENSUS</option>
                            </select>
                        </label>
                        <데이터조회Button ButtonColor="Color.Error"
                                        StartIcon="@Icons.Material.Filled.Search"
                                        IsLoading="ViewModel.IsLoading"
                                        LoadingText="미국 가격 불러오는 중"
                                        OnClick="@(() => ViewModel.LoadUnitedStatesAsync())">
                            미국 가격 조회
                        </데이터조회Button>
                    </section>
                    <미국농수산가격Result ViewModel="@ViewModel.미국" />
                    break;

                case 농수산가격비교Section.호주:
                    <section class="public-data-workspace__query-section public-data-workspace__query-section--australia">
                        <label class="public-data-workspace__field">
                            <span>호주 식품 분류</span>
                            <select @bind="ViewModel.호주.선택IndexCode">
                                @foreach (var index in ViewModel.호주.Catalog.Indexes)
                                {
                                    <option value="@index.Code">@index.Label</option>
                                }
                            </select>
                        </label>
                        <label class="public-data-workspace__field">
                            <span>측정 기준</span>
                            <select @bind="ViewModel.호주.선택MeasureCode">
                                @foreach (var measure in ViewModel.호주.Catalog.Measures)
                                {
                                    <option value="@measure.Code">@measure.Label</option>
                                }
                            </select>
                        </label>
                        <label class="public-data-workspace__field">
                            <span>지역</span>
                            <select @bind="ViewModel.호주.선택RegionCode">
                                @foreach (var region in ViewModel.호주.Catalog.Regions)
                                {
                                    <option value="@region.Code">@region.Label</option>
                                }
                            </select>
                        </label>
                        <데이터조회Button ButtonColor="Color.Info"
                                        StartIcon="@Icons.Material.Filled.Search"
                                        IsLoading="ViewModel.IsLoading"
                                        LoadingText="호주 지수 불러오는 중"
                                        OnClick="@(() => ViewModel.LoadAustraliaAsync())">
                            호주 지수 조회
                        </데이터조회Button>
                    </section>
                    <호주농수산가격Result Response="@ViewModel.호주.응답"
                                          ErrorMessage="@ViewModel.호주.오류메시지" />
                    break;

                case 농수산가격비교Section.출처:
                    <농수산가격SourceList Sources="ViewModel.VisibleSources" />
                    break;

                default:
                    <농수산가격ComparisonWorkspace ViewModel="ViewModel" />
                    break;
            }
    </main>
</section>

@code {
    [Parameter]
    public 농수산가격비교Section InitialSection { get; set; } = 농수산가격비교Section.비교;

    [Parameter]
    public bool DomesticOnly { get; set; }

    private static readonly IReadOnlyList<PriceSectionNavigationItem> DomesticSectionNavigationItems =
    [
        new(농수산가격비교Section.국내, "KR", "한국 aT")
    ];

    private static readonly IReadOnlyList<PriceSectionNavigationItem> AllSectionNavigationItems =
    [
        new(농수산가격비교Section.비교, "COMPARE", "3개국 비교"),
        new(농수산가격비교Section.국내, "KR", "한국 aT"),
        new(농수산가격비교Section.미국, "US", "USDA NASS"),
        new(농수산가격비교Section.호주, "AU", "호주 ABS"),
        new(농수산가격비교Section.출처, "SOURCE", "공식 데이터 출처")
    ];

    private IReadOnlyList<PriceSectionNavigationItem> SectionNavigationItems
        => DomesticOnly
            ? DomesticSectionNavigationItems
            : AllSectionNavigationItems;

    private string BuildSectionButtonClass(농수산가격비교Section section)
        => ViewModel.ActiveSection == section
            ? "public-data-workspace__section-nav-item public-data-workspace__section-nav-item--active"
            : "public-data-workspace__section-nav-item";

    protected override async Task OnInitializedAsync()
    {
        ViewModel.SelectSection(DomesticOnly
            ? 농수산가격비교Section.국내
            : InitialSection);
        await ViewModel.초기화Async();
    }

    private sealed record PriceSectionNavigationItem(
        농수산가격비교Section Section,
        string Eyebrow,
        string Label);
}
