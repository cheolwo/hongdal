@using System.Globalization
@using Ssalddel.Contracts.Common.AgriculturalFisheries
@inject I농수산공공데이터Client PublicDataClient

<article class="hs-country-card" aria-labelledby="@TitleId">
    <header class="hs-country-card__header">
        <div>
            <span>HS @NormalizedHsCode</span>
            <h6 id="@TitleId">@(_card?.ProductName ?? ProductName ?? "국가별 가격 자료")</h6>
        </div>
        @if (_card is not null)
        {
            <small>@StatusLabel(_card.StatusCode)</small>
        }
    </header>

    @if (_card is null && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="hs-country-card__request">
            <p>한국·미국·일본·중국의 공개 가격 관측을 한 카드에서 확인합니다.</p>
            <데이터조회Button IsLoading="@_loading"
                             Disabled="@(!HasValidHsCode)"
                             LoadingText="국가 가격 불러오는 중"
                             StartIcon="@Icons.Material.Filled.Public"
                             OnClick="LoadAsync">
                국가별 가격 보기
            </데이터조회Button>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="hs-country-card__state hs-country-card__state--error" role="alert">
            <strong>국가 가격 자료를 불러오지 못했습니다.</strong>
            <span>@_errorMessage</span>
            <데이터조회Button IsLoading="@_loading"
                             LoadingText="다시 불러오는 중"
                             StartIcon="@Icons.Material.Filled.Refresh"
                             OnClick="LoadAsync">
                다시 시도
            </데이터조회Button>
        </div>
    }
    else if (_card is { } card)
    {
        @if (card.StatusCode == Hs식품국가가격Card상태Codes.품목없음)
        {
            <div class="hs-country-card__state" role="status">
                <strong>이 HS6의 가격 카드는 준비 중입니다.</strong>
                <span>분류 후보는 유지하되 대표 이미지와 국가별 관측이 연결되기 전까지 가격값을 표시하지 않습니다.</span>
            </div>
        }
        else
        {
            var domesticObservations = DomesticPriceObservations(card);
            var comparableImports = ComparableImportPrices(card);
            var imageUrl = SafeImageUrl(card.RepresentativeImageUrl);

            <div class="hs-country-card__product">
                @if (imageUrl is not null)
                {
                    <figure class="hs-country-card__image">
                        <img src="@imageUrl" alt="@card.ProductName 대표 이미지" loading="lazy" decoding="async" />
                        <figcaption>AI 생성 대표 이미지 · @ImageReviewLabel(card.ImageReviewStatusCode)</figcaption>
                    </figure>
                }
                <section class="hs-country-card__classification" aria-label="상품과 HS 분류 정보">
                    <span>PRODUCT CLASSIFICATION</span>
                    <strong>@card.ProductName</strong>
                    <div>
                        <code>@card.HsCodeScheme @card.HsCode</code>
                        <small>@ReferenceMonthLabel(card.ReferenceMonth) 기준 · 최근 @(card.LookbackMonths)개월</small>
                    </div>
                    <p>HS6은 국제 공통 6단위 품목 분류입니다. 실제 한국 수입신고 코드는 성분·가공상태·용도에 따라 HSK 10단위 확인이 필요합니다.</p>
                </section>
            </div>

            @if (domesticObservations.Count > 0 || comparableImports.Count > 0)
            {
                <div class="hs-country-card__visuals" aria-label="상품의 유통단계와 국가별 가격 그래프">
                    @if (domesticObservations.Count > 0)
                    {
                        var domesticMaximum = PriceScaleMaximum(domesticObservations.Select(item => item.Observation));
                        <section class="hs-country-card__visual hs-country-card__range-chart">
                            <header>
                                <div>
                                    <span>유통단계별 가격</span>
                                    <strong>한국 도매·소매 조사 범위</strong>
                                </div>
                                <small>@domesticObservations[0].Observation.Unit</small>
                            </header>
                            <div class="hs-country-card__chart-rows">
                                @foreach (var item in domesticObservations)
                                {
                                    <div class="hs-country-card__range-row">
                                        <span>@item.Observation.MarketStageLabel</span>
                                        <div class="hs-country-card__range-track"
                                             style="@RangeStyle(item.Observation, domesticMaximum)"
                                             role="img"
                                             aria-label="@RangeAriaLabel(item.Observation)">
                                            <i></i>
                                            <b></b>
                                        </div>
                                        <strong>@FormatAverage(item.Observation)</strong>
                                    </div>
                                }
                            </div>
                            <p>막대는 최저~최고, 점은 평균입니다. 도매와 소매는 서로 다른 유통단계입니다.</p>
                        </section>
                    }

                    @if (comparableImports.Count > 0)
                    {
                        var importMaximum = comparableImports.Max(item => item.Observation.AveragePrice ?? 0m);
                        <section class="hs-country-card__visual hs-country-card__country-comparison">
                            <header>
                                <div>
                                    <span>국가별 한눈에 보기</span>
                                    <strong>원산국별 한국 수입신고 단가</strong>
                                </div>
                                <small>@comparableImports[0].Observation.Unit</small>
                            </header>
                            <div class="hs-country-card__chart-rows">
                                @foreach (var item in comparableImports)
                                {
                                    <div class="hs-country-card__bar-row">
                                        <span>@CountryFlag(item.CountryCode) @item.CountryName</span>
                                        <div class="hs-country-card__bar-track"
                                             style="@BarStyle(item.Observation.AveragePrice ?? 0m, importMaximum)"
                                             role="img"
                                             aria-label="@($"{item.CountryName} {FormatAverage(item.Observation)}")">
                                            <i></i>
                                        </div>
                                        <strong>@FormatAverage(item.Observation)</strong>
                                    </div>
                                }
                            </div>
                            <p>국가 순위가 아니라 동일 HS6·기간·통화·중량 산식의 공개 통계단가 비교입니다.</p>
                        </section>
                    }
                </div>
            }

            <div class="hs-country-card__countries">
                @foreach (var country in card.Countries.OrderBy(item => item.DisplayOrder))
                {
                    <section class="hs-country-card__country">
                        <header>
                            <strong>@CountryFlag(country.CountryCode) @country.CountryName</strong>
                            <span>@ObservationStatusLabel(country.DataStatusCode)</span>
                        </header>
                        @if (country.PriceObservations.Count == 0)
                        {
                            <p>@country.Summary</p>
                        }
                        else
                        {
                            @foreach (var observation in country.PriceObservations)
                            {
                                <article class="hs-country-card__observation">
                                    <div class="hs-country-card__price">
                                        <span>@observation.MarketStageLabel</span>
                                        <strong>@FormatAverage(observation)</strong>
                                        <small>@FormatRange(observation)</small>
                                    </div>
                                    @if (observation.TrendPoints is { Count: > 1 } trendPoints)
                                    {
                                        var sparkPoints = TrendChartPoints(trendPoints);
                                        <figure class="hs-country-card__trend">
                                            <figcaption>
                                                <strong>월별 추세</strong>
                                                <span>@PeriodLabel(trendPoints[0].Period)~@PeriodLabel(trendPoints[^1].Period)</span>
                                            </figcaption>
                                            <svg viewBox="0 0 240 84"
                                                 preserveAspectRatio="none"
                                                 role="img"
                                                 aria-label="@($"{country.CountryName} {observation.MarketStageLabel} 월별 가격 추세")">
                                                <polyline points="@SparklinePoints(sparkPoints)" />
                                                @foreach (var point in sparkPoints)
                                                {
                                                    <circle cx="@SvgNumber(point.X)" cy="@SvgNumber(point.Y)" r="3">
                                                        <title>@($"{PeriodLabel(point.Period)} {point.Value:N2} {observation.Unit}")</title>
                                                    </circle>
                                                }
                                            </svg>
                                        </figure>
                                    }
                                    <dl>
                                        <div><dt>기준</dt><dd>@observation.ReferencePeriod</dd></div>
                                        <div><dt>표본</dt><dd>@observation.ObservationCount.ToString("N0")건</dd></div>
                                    </dl>
                                    <p>@observation.Note</p>
                                    @if (SafeImageUrl(observation.SourceUrl) is string sourceUrl)
                                    {
                                        <a href="@sourceUrl" target="_blank" rel="noreferrer">@observation.SourceName 원문</a>
                                    }
                                </article>
                            }
                        }
                    </section>
                }
            </div>

            <footer class="hs-country-card__boundaries" role="note">
                <strong>비교 경계</strong>
                <ul>
                    @foreach (var boundary in card.ComparisonBoundaries)
                    {
                        <li>@boundary</li>
                    }
                </ul>
            </footer>
        }
    }
</article>

@code {
    [Parameter, EditorRequired]
    public string HsCode { get; set; } = string.Empty;

    [Parameter]
    public string? ProductName { get; set; }

    private Hs식품국가가격Card응답? _card;
    private bool _loading;
    private string? _errorMessage;

    private string NormalizedHsCode
        => new(HsCode.Where(char.IsDigit).Take(6).ToArray());

    private bool HasValidHsCode => NormalizedHsCode.Length == 6;
    private string TitleId => $"hs-country-price-{NormalizedHsCode}";

    private async Task LoadAsync(MouseEventArgs _)
    {
        if (!HasValidHsCode || _loading)
        {
            return;
        }

        _loading = true;
        _errorMessage = null;
        try
        {
            _card = await PublicDataClient.Hs식품국가가격Card조회Async(
                NormalizedHsCode,
                lookbackMonths: 6);
        }
        catch (Exception)
        {
            _card = null;
            _errorMessage = "공개 데이터 연결 상태를 확인한 뒤 다시 시도해 주세요.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatAverage(Hs식품국가가격관측응답 observation)
    {
        if (observation.AveragePrice is not { } average)
        {
            return ObservationStatusLabel(observation.DataStatusCode);
        }

        return $"{average:N2} {observation.Unit}";
    }

    private static string FormatRange(Hs식품국가가격관측응답 observation)
        => observation.MinimumPrice is { } minimum
           && observation.MaximumPrice is { } maximum
           && (minimum != observation.AveragePrice || maximum != observation.AveragePrice)
            ? $"관측 범위 {minimum:N2}~{maximum:N2} {observation.Unit}"
            : $"{observation.ReferencePeriod} 관측";

    private static IReadOnlyList<PriceChartItem> DomesticPriceObservations(
        Hs식품국가가격Card응답 card)
        => card.Countries
            .Where(country => country.CountryCode == "KR")
            .SelectMany(country => country.PriceObservations.Select(observation => new PriceChartItem(
                country.CountryCode,
                country.CountryName,
                observation)))
            .Where(item => item.Observation.PriceContextCode == Hs식품국가가격맥락Codes.국내시장조사가격
                           && item.Observation.AveragePrice.HasValue)
            .ToArray();

    private static IReadOnlyList<PriceChartItem> ComparableImportPrices(
        Hs식품국가가격Card응답 card)
    {
        var candidates = card.Countries
            .Where(country => country.CountryCode != "KR")
            .SelectMany(country => country.PriceObservations.Select(observation => new PriceChartItem(
                country.CountryCode,
                country.CountryName,
                observation)))
            .Where(item => item.Observation.PriceContextCode == Hs식품국가가격맥락Codes.수입통계단가
                           && item.Observation.AllowsComparisonWithinGroup
                           && item.Observation.AveragePrice.HasValue)
            .ToArray();
        if (candidates.Length == 0)
        {
            return [];
        }

        var anchor = candidates[0].Observation;
        return candidates
            .Where(item => item.Observation.ComparisonGroupCode == anchor.ComparisonGroupCode
                           && item.Observation.CurrencyCode == anchor.CurrencyCode
                           && item.Observation.Unit == anchor.Unit)
            .ToArray();
    }

    private static decimal PriceScaleMaximum(IEnumerable<Hs식품국가가격관측응답> observations)
        => observations
            .Select(observation => observation.MaximumPrice
                ?? observation.AveragePrice
                ?? 0m)
            .DefaultIfEmpty(1m)
            .Max();

    private static string RangeStyle(
        Hs식품국가가격관측응답 observation,
        decimal maximum)
    {
        var average = observation.AveragePrice ?? 0m;
        var minimum = observation.MinimumPrice ?? average;
        var observedMaximum = observation.MaximumPrice ?? average;
        return $"--range-start:{Percent(minimum, maximum)};"
               + $"--range-end:{Percent(observedMaximum, maximum)};"
               + $"--average:{Percent(average, maximum)}";
    }

    private static string BarStyle(decimal value, decimal maximum)
        => $"--bar-size:{Percent(value, maximum)}";

    private static string Percent(decimal value, decimal maximum)
        => maximum <= 0
            ? "0%"
            : $"{Math.Clamp(value / maximum * 100m, 0m, 100m).ToString("0.##", CultureInfo.InvariantCulture)}%";

    private static string RangeAriaLabel(Hs식품국가가격관측응답 observation)
        => $"{observation.MarketStageLabel} 평균 {FormatAverage(observation)}, {FormatRange(observation)}";

    private static IReadOnlyList<SparkChartPoint> TrendChartPoints(
        IReadOnlyList<Hs식품가격시계열Point응답> source)
    {
        var points = source.OrderBy(point => point.Period, StringComparer.Ordinal).ToArray();
        if (points.Length == 0)
        {
            return [];
        }

        var minimum = points.Min(point => point.Value);
        var maximum = points.Max(point => point.Value);
        var span = maximum - minimum;
        return points.Select((point, index) => new SparkChartPoint(
                point.Period,
                point.Value,
                points.Length == 1 ? 120d : 8d + index * (224d / (points.Length - 1)),
                span == 0m
                    ? 42d
                    : 8d + (double)((maximum - point.Value) / span) * 68d))
            .ToArray();
    }

    private static string SparklinePoints(IReadOnlyList<SparkChartPoint> points)
        => string.Join(" ", points.Select(point => $"{SvgNumber(point.X)},{SvgNumber(point.Y)}"));

    private static string SvgNumber(double value)
        => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string PeriodLabel(string value)
        => value.Length == 6
           && int.TryParse(value[..4], out var year)
           && int.TryParse(value[4..], out var month)
            ? $"{year}.{month:00}"
            : value;

    private static string ReferenceMonthLabel(string value)
        => PeriodLabel(value);

    private static string ObservationStatusLabel(string statusCode)
        => statusCode switch
        {
            Hs식품국가가격관측상태Codes.관측됨 => "관측됨",
            Hs식품국가가격관측상태Codes.자료없음 => "자료 없음",
            _ => "조회 불가"
        };

    private static string StatusLabel(string statusCode)
        => statusCode switch
        {
            Hs식품국가가격Card상태Codes.완료 => "자료 연결",
            Hs식품국가가격Card상태Codes.품목없음 => "준비 중",
            _ => "일부 자료"
        };

    private static string ImageReviewLabel(string statusCode)
        => string.Equals(statusCode, "Available", StringComparison.Ordinal)
           || string.Equals(statusCode, "사용가능", StringComparison.Ordinal)
            ? "검토 완료"
            : "검토 중";

    private static string CountryFlag(string countryCode)
        => countryCode switch
        {
            "KR" => "🇰🇷",
            "US" => "🇺🇸",
            "JP" => "🇯🇵",
            "CN" => "🇨🇳",
            _ => "🌐"
        };

    private static string? SafeImageUrl(string? value)
        => Uri.TryCreate(value, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
                ? uri.ToString()
                : null;

    private sealed record PriceChartItem(
        string CountryCode,
        string CountryName,
        Hs식품국가가격관측응답 Observation);

    private sealed record SparkChartPoint(
        string Period,
        decimal Value,
        double X,
        double Y);
}
