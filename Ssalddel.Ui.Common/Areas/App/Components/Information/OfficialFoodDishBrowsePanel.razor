@using Ssalddel.Contracts.Common.Community
@using Ssalddel.Ui.Common.Areas.App.Services
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inject NavigationManager Navigation
@inject ICommunityPostComposerDraftStore ComposerDraftStore

<section class="food-dish-browser" aria-labelledby="food-dish-browser-title">
    <header class="food-dish-browser__header">
        <div>
            <span>문화교통 · 음식에서 이동 준비까지</span>
            <h3 id="food-dish-browser-title">여러 나라의 음식부터 둘러보기</h3>
            <p>국가기관의 음식·레시피·가격 자료를 출발점으로 서로의 경험을 나눕니다. 구해보고 싶은 마음이 생겼을 때만 다음 선택지를 엽니다.</p>
        </div>
        <span class="food-dish-browser__boundary">음식 국가 ≠ 상품 출발국</span>
    </header>

    <div class="food-dish-browser__countries" aria-label="음식 국가 선택">
        @foreach (var country in Countries)
        {
            <button type="button"
                    class="@CountryClass(country.CountryCode)"
                    aria-pressed="@(country.CountryCode == SelectedCountryCode)"
                    @onclick="@(() => CountryChanged.InvokeAsync(country.CountryCode))">
                @country.DisplayName
            </button>
        }
    </div>

    <form class="food-dish-browser__search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label for="food-dish-search">음식 이름 검색</label>
        <div>
            <input id="food-dish-search"
                   value="@SearchText"
                   @oninput="OnSearchTextChanged"
                   placeholder="예: 전골, rice, curry" />
            <데이터조회Button ButtonType="ButtonType.Submit"
                             IsLoading="@Busy"
                             Disabled="@Busy"
                             LoadingText="음식 찾는 중"
                             StartIcon="@Icons.Material.Filled.Search">
                음식 찾기
            </데이터조회Button>
        </div>
    </form>

    @if (Busy)
    {
        <div class="food-dish-browser__state" role="status">선택한 나라의 음식과 재료를 불러오고 있습니다.</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="food-dish-browser__state food-dish-browser__state--error" role="alert">@ErrorMessage</div>
    }
    else if (Dishes.Count == 0)
    {
        <div class="food-dish-browser__state">
            이 국가에는 공개 가능한 공식 음식 자료가 아직 없습니다. 다른 국가를 선택하거나 자료 수집 상태를 확인해 주세요.
        </div>
    }
    else
    {
        <div class="food-dish-browser__workspace">
            <div class="food-dish-browser__list" aria-label="공식 음식 목록">
                @foreach (var dish in Dishes)
                {
                    <button type="button"
                            class="@DishClass(dish.DishKey)"
                            @onclick="@(() => SelectDishAsync(dish.DishKey))">
                        <span>@OfficialFoodIngredientPresentation.CountryName(dish.CountryCode) · @dish.RegionName</span>
                        <strong>@dish.Name</strong>
                        <small>@dish.Category · 공식 변형 @dish.VariantCount.ToString("N0")건</small>
                    </button>
                }
            </div>

            @if (SelectedDish is { } detail)
            {
                <article class="food-dish-browser__detail">
                    <header>
                        <div>
                            <span>@OfficialFoodIngredientPresentation.CountryName(detail.Dish.CountryCode) · @detail.Provider</span>
                            <h4>@detail.Dish.Name</h4>
                            <p>@detail.Dish.Summary</p>
                        </div>
                        <span class="food-dish-browser__review">@OfficialFoodIngredientPresentation.ReviewStateLabel(detail.Dish.ReviewState)</span>
                    </header>

                    <div class="food-dish-browser__ingredients" aria-label="선택 음식의 재료">
                        <h5>이 음식에 들어가는 재료</h5>
                        <div>
                            @foreach (var dishIngredient in detail.Ingredients)
                            {
                                <button type="button"
                                        class="@IngredientClass(dishIngredient.IngredientKey)"
                                        aria-pressed="@(dishIngredient.IngredientKey == SelectedIngredientKey)"
                                        @onclick="@(() => SelectIngredientAsync(dishIngredient.IngredientKey))">
                                    <strong>@dishIngredient.CanonicalName</strong>
                                    <span>@dishIngredient.QuantityText</span>
                                </button>
                            }
                        </div>
                    </div>

                    @if (SelectedIngredient is { } selectedIngredient)
                    {
                        <section class="food-dish-browser__decision" aria-label="선택 재료 조달 방향">
                            <div>
                                <span>선택 재료</span>
                                <h5>@selectedIngredient.CanonicalName</h5>
                                <p>@OfficialFoodIngredientPresentation.BuildRecipeIngredientText(selectedIngredient)</p>
                            </div>

                            @if ((selectedIngredient.PublicPrices ?? []).Count > 0)
                            {
                                <div class="food-dish-browser__prices" aria-label="선택 재료 공공 가격">
                                    @foreach (var price in (selectedIngredient.PublicPrices ?? []).Take(3))
                                    {
                                        <span>
                                            <strong>@price.CountryName @price.MarketStageName</strong>
                                            @OfficialFoodIngredientPresentation.FormatPrice(price) · @price.ReferenceDate.ToString("yyyy.MM.dd")
                                        </span>
                                    }
                                </div>
                            }

                            <OfficialFoodIngredientCompanyPanel IngredientName="@selectedIngredient.CanonicalName"
                                                                Research="@CompanyResearch"
                                                                Busy="@CompanyResearchBusy"
                                                                ErrorMessage="@CompanyResearchErrorMessage"
                                                                ResearchRequested="@CompanyResearchRequested" />

                            <OfficialFoodIngredientHsPanel IngredientName="@selectedIngredient.CanonicalName"
                                                           Mapping="@HsMapping"
                                                           Busy="@HsMappingBusy"
                                                           ErrorMessage="@HsMappingErrorMessage"
                                                           MappingRequested="@HsMappingRequested" />

                            <OfficialFoodCultureTransportPanel Dish="@detail"
                                                              Ingredient="@selectedIngredient"
                                                              CompanyResearch="@CompanyResearch"
                                                              HsMapping="@HsMapping"
                                                              DiscussionRequested="StartDiscussionAsync"
                                                              IndividualImportDiscussionRequested="StartIndividualImportDiscussionAsync"
                                                              PurchaseRequested="@PurchaseRequested"
                                                              DiscussionStatusMessage="@_discussionStatusMessage" />
                        </section>
                    }

                    <footer>
                        <div>
                            <span>레시피 출처와 재료 정보는 구매·수입 계약을 자동 확정하지 않습니다.</span>
                            <small>@detail.AttributionText</small>
                        </div>
                        @if (OfficialFoodIngredientPresentation.SafeHttpUrl(detail.OriginalUrl) is string recipeUrl)
                        {
                            <a href="@recipeUrl" target="_blank" rel="noreferrer">공식 원문</a>
                        }
                    </footer>
                </article>
            }
        </div>
    }
</section>

@code {
    private const string CommunityComposerAppKey = "shipper";
    private string? _discussionStatusMessage;

    [Parameter, EditorRequired]
    public IReadOnlyList<OfficialFoodCountryOption> Countries { get; set; } = [];

    [Parameter]
    public string SelectedCountryCode { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> CountryChanged { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    [Parameter]
    public EventCallback SearchRequested { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<OfficialFoodRecipeDishDto> Dishes { get; set; } = [];

    [Parameter]
    public OfficialFoodDishDetailDto? SelectedDish { get; set; }

    [Parameter]
    public string SelectedIngredientKey { get; set; } = string.Empty;

    [Parameter]
    public OfficialFoodRecipeIngredientDto? SelectedIngredient { get; set; }

    [Parameter]
    public EventCallback<string> DishSelected { get; set; }

    [Parameter]
    public EventCallback<string> IngredientSelected { get; set; }

    [Parameter]
    public EventCallback<OfficialFoodDishIngredientPurchaseSelection> PurchaseRequested { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public OfficialFoodIngredientCompanyResearchResponse? CompanyResearch { get; set; }

    [Parameter]
    public bool CompanyResearchBusy { get; set; }

    [Parameter]
    public string? CompanyResearchErrorMessage { get; set; }

    [Parameter]
    public EventCallback CompanyResearchRequested { get; set; }

    [Parameter]
    public OfficialFoodIngredientHsMappingResponse? HsMapping { get; set; }

    [Parameter]
    public bool HsMappingBusy { get; set; }

    [Parameter]
    public string? HsMappingErrorMessage { get; set; }

    [Parameter]
    public EventCallback HsMappingRequested { get; set; }

    private string CountryClass(string countryCode)
        => countryCode == SelectedCountryCode ? "is-selected" : string.Empty;

    private string DishClass(string dishKey)
        => SelectedDish?.Dish.DishKey == dishKey ? "is-selected" : string.Empty;

    private string IngredientClass(string ingredientKey)
        => ingredientKey == SelectedIngredientKey ? "is-selected" : string.Empty;

    private Task SearchAsync()
        => SearchRequested.InvokeAsync();

    private Task OnSearchTextChanged(ChangeEventArgs args)
        => SearchTextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private Task SelectDishAsync(string dishKey)
    {
        _discussionStatusMessage = null;
        return DishSelected.InvokeAsync(dishKey);
    }

    private Task SelectIngredientAsync(string ingredientKey)
    {
        _discussionStatusMessage = null;
        return IngredientSelected.InvokeAsync(ingredientKey);
    }

    private async Task StartDiscussionAsync(OfficialFoodDishIngredientPurchaseSelection selection)
        => await PrepareCommunityDraftAsync(
            () => OfficialFoodIngredientPresentation.CreateCultureTransportDraft(
                selection,
                CompanyResearch,
                HsMapping,
                DateTime.UtcNow),
            CommunityBoardCatalog.Food);

    private async Task StartIndividualImportDiscussionAsync(OfficialFoodDishIngredientPurchaseSelection selection)
        => await PrepareCommunityDraftAsync(
            () => OfficialFoodIngredientPresentation.CreateIndividualImportReviewDraft(
                selection,
                CompanyResearch,
                HsMapping,
                DateTime.UtcNow),
            CommunityBoardCatalog.InformationPrices);

    private async Task PrepareCommunityDraftAsync(
        Func<CommunityPostComposerSnapshot> createDraft,
        CommunityBoardDefinition board)
    {
        _discussionStatusMessage = null;
        try
        {
            var existingDraft = await ComposerDraftStore.LoadAsync(CommunityComposerAppKey);
            if (HasDraftContent(existingDraft))
            {
                _discussionStatusMessage = "작성 중인 커뮤니티 글 초안이 있어 덮어쓰지 않았습니다. 기존 초안을 등록하거나 비운 뒤 다시 시도해 주세요.";
                return;
            }

            var draft = createDraft();
            await ComposerDraftStore.SaveAsync(CommunityComposerAppKey, draft);
            Navigation.NavigateTo(CommunityPageRoutes.ComposeFor(
                board.DisplayName,
                board.Key,
                "/information/food-ingredients"));
        }
        catch (Exception)
        {
            _discussionStatusMessage = "공식 근거를 글 초안으로 옮기지 못했습니다. 잠시 후 다시 시도해 주세요.";
        }
    }

    private static bool HasDraftContent(CommunityPostComposerSnapshot? draft)
        => draft is not null
           && (!string.IsNullOrWhiteSpace(draft.Title)
               || !string.IsNullOrWhiteSpace(draft.Body)
               || !string.IsNullOrWhiteSpace(draft.SharedLinkUrl)
               || !string.IsNullOrWhiteSpace(draft.커뮤니티원장Id)
               || draft.IsSalesPost);

}
