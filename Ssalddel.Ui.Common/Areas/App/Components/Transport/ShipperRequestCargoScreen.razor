@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<ShipperRequestScreenFrame ViewModel="ViewModel"
                           NavigationContext="NavigationContext"
                           Step="ShipperRequestAuthoringStep.Cargo"
                           ScreenCode="@ScreenCode"
                           Title="@Title"
                           Description="@Description"
                           ShowNavigation="ShowNavigation"
                           RootBackHref="@RootBackHref"
                           RootBackLabel="@RootBackLabel"
                           Changed="Changed">
    @if (BeforeContent is not null)
    {
        @BeforeContent
    }

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="ViewModel.화물종류"
                              Label="화물 종류"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="ViewModel.화물적재형태"
                           Label="화물 적재 형태"
                           Variant="Variant.Outlined">
                    @foreach (var loadingForm in 운송의뢰작성ViewModel.화물적재형태목록)
                    {
                        <MudSelectItem Value="@loadingForm">@loadingForm</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="ViewModel.온도조건"
                           Label="온도 조건"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@("상온")">상온</MudSelectItem>
                    <MudSelectItem Value="@("냉장")">냉장</MudSelectItem>
                    <MudSelectItem Value="@("냉동")">냉동</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="ViewModel.화물설명"
                              Label="화물 설명"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Placeholder="예: 삼겹살 3kg 단위 묶음, 파손 주의 상품 등" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="int?"
                                 @bind-Value="ViewModel.화물수량"
                                 Label="수량"
                                 Variant="Variant.Outlined"
                                 Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal?"
                                 @bind-Value="ViewModel.화물중량Kg"
                                 Label="중량 kg"
                                 Variant="Variant.Outlined"
                                 Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal?"
                                 @bind-Value="ViewModel.화물부피Cbm"
                                 Label="부피 cbm"
                                 Variant="Variant.Outlined"
                                 Immediate="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudAlert Severity="@(ViewModel.화물정보입력됨 ? Severity.Success : Severity.Info)"
              Variant="Variant.Outlined"
              Dense="true">
        @(ViewModel.화물정보입력됨
            ? "화물 기본 조건이 입력되었습니다. 다음 단계에서 실제 상하차 구간을 확인하세요."
            : "화물 종류와 수량·중량·부피 중 하나를 입력하면 다음 단계의 차량 후보를 판단할 수 있습니다.")
    </MudAlert>

    @if (!string.IsNullOrWhiteSpace(BulkHref))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            여러 의뢰를 한 번에 준비한다면 단건 작성과 분리된 CSV 일괄등록 화면을 사용하세요.
            <MudButton Href="@BulkHref"
                       Variant="Variant.Text"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.UploadFile">
                CSV 일괄등록
            </MudButton>
        </MudAlert>
    }
</ShipperRequestScreenFrame>

@code {
    [Parameter, EditorRequired] public 운송의뢰작성ViewModel ViewModel { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestNavigationContext NavigationContext { get; set; } = new();
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter] public string Title { get; set; } = "화물 정보";
    [Parameter] public string Description { get; set; } = "차량과 상하차 난이도를 판단할 물품 조건만 입력합니다.";
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public string RootBackHref { get; set; } = ShipperRequestPageRoutes.Root;
    [Parameter] public string RootBackLabel { get; set; } = "한 화면 입력";
    [Parameter] public string? BulkHref { get; set; }
    [Parameter] public RenderFragment? BeforeContent { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
}
