@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<section class="shipper-request-screen"
         data-step="@Step.ToString().ToLowerInvariant()"
         @onfocusout="@(_ => NotifyChangedAsync())">
    <header class="shipper-request-screen__header">
        <span>STEP @((int)Step + 1) · TRANSPORT REQUEST</span>
        <h2>@Title</h2>
        <p>@Description</p>
    </header>

    @if (ShowNavigation)
    {
        <ShipperRequestStepNavigation ViewModel="ViewModel"
                                      NavigationContext="NavigationContext"
                                      CurrentStep="Step"
                                      ShowFooter="false"
                                      RootBackHref="@RootBackHref"
                                      RootBackLabel="@RootBackLabel"
                                      BeforeNavigate="Changed" />
    }

    <div class="shipper-request-screen__body">
        @ChildContent
    </div>

    @if (ShowNavigation)
    {
        <ShipperRequestStepNavigation ViewModel="ViewModel"
                                      NavigationContext="NavigationContext"
                                      CurrentStep="Step"
                                      ShowSteps="false"
                                      RootBackHref="@RootBackHref"
                                      RootBackLabel="@RootBackLabel"
                                      BeforeNavigate="Changed" />
    }
</section>

@code {
    [Parameter, EditorRequired] public 운송의뢰작성ViewModel ViewModel { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestNavigationContext NavigationContext { get; set; } = new();
    [Parameter] public ShipperRequestAuthoringStep Step { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public string RootBackHref { get; set; } = ShipperRequestPageRoutes.Root;
    [Parameter] public string RootBackLabel { get; set; } = "한 화면 입력";
    [Parameter] public EventCallback Changed { get; set; }

    private Task NotifyChangedAsync()
        => Changed.HasDelegate ? Changed.InvokeAsync() : Task.CompletedTask;
}
