@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<ShipperRequestDetailScreenFrame State="@State"
                                 Context="@Context"
                                 CurrentScreen="ShipperRequestDetailScreenKind.Summary"
                                 ScreenCode="@ScreenCode"
                                 Eyebrow="요약"
                                 Title="@Title"
                                 Description="@Description"
                                 HomeHref="@HomeHref"
                                 NewRequestHref="@NewRequestHref"
                                 LoginHref="@LoginHref"
                                 RefreshRequested="RefreshRequested">
    <EmptyContent>
        <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6">의뢰 ID로 조회</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">등록 결과에 표시된 운송 의뢰 ID를 입력해 주세요.</MudText>
        <div class="shipper-summary__lookup">
            <MudTextField @bind-Value="State.LookupRequestId"
                          Label="운송 의뢰 ID"
                          Placeholder="예: HD-WEB-001"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       Disabled="@string.IsNullOrWhiteSpace(State.LookupRequestId)"
                       OnClick="LookupAsync">
                의뢰 조회
            </MudButton>
        </div>
    </EmptyContent>
    <ChildContent>
        @if (State.Request is { } item)
        {
            <div class="shipper-summary">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-summary__hero">
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">REQUEST ID</MudText>
                        <MudText Typo="Typo.h5">@item.RequestId</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @ShipperRequestDetailPresentation.Display(item.CargoType) · @ShipperRequestDetailPresentation.Display(item.TransportMethod) · @ShipperRequestDetailPresentation.Display(item.VehicleType)
                        </MudText>
                    </div>
                    <MudChip T="string" Color="@ResolveStateColor(ShipperRequestDetailPresentation.ResolveOverallState(item))" Variant="Variant.Filled">
                        @ShipperRequestDetailPresentation.ResolveOverallLabel(item)
                    </MudChip>
                </MudPaper>

                <div class="shipper-summary__grid">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-summary__card">
                        <MudText Typo="Typo.h6">현재 상태</MudText>
                        <dl>
                            <div><dt>의뢰</dt><dd>@ShipperRequestDetailPresentation.Display(item.RequestStatus)</dd></div>
                            <div><dt>배차</dt><dd>@ShipperRequestDetailPresentation.Display(item.DispatchStatus)</dd></div>
                            <div><dt>운송</dt><dd>@ShipperRequestDetailPresentation.Display(item.TransportStatus)</dd></div>
                            <div><dt>결제</dt><dd>@ShipperRequestDetailPresentation.Display(item.PaymentStatus)</dd></div>
                            <div><dt>정산</dt><dd>@ShipperRequestDetailPresentation.Display(item.SettlementStatus)</dd></div>
                        </dl>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-summary__card">
                        <MudText Typo="Typo.h6">배정 기사·현재 위치</MudText>
                        <dl>
                            <div><dt>기사</dt><dd>@AssignedDriver(item)</dd></div>
                            <div><dt>차량</dt><dd>@ShipperRequestDetailPresentation.Display(item.AssignedDriverVehicle)</dd></div>
                            <div><dt>최근 위치</dt><dd>@DriverLocation(item)</dd></div>
                            <div><dt>위치 시각</dt><dd>@DisplayDateTime(item.DriverLocationRecordedAtUtc)</dd></div>
                            <div><dt>위치 상태</dt><dd>@ShipperRequestDetailPresentation.ResolveDriverLocationFreshness(item)</dd></div>
                            <div><dt>예상 도착</dt><dd>@ShipperRequestDetailPresentation.ResolveEtaStatus(item)</dd></div>
                        </dl>
                        @if (string.IsNullOrWhiteSpace(item.AssignedDriverId))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">기사가 수락하면 배정 정보가 표시됩니다.</MudText>
                        }
                        else if (!item.DriverLocationRecordedAtUtc.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">위치가 아직 수신되지 않았거나 운송 종료 정책에 따라 비공개 상태입니다.</MudText>
                        }
                        else if (ShipperRequestDetailPresentation.IsDriverLocationStale(item))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                                최근 위치가 10분 이상 갱신되지 않았습니다. 기사 위치를 현재 위치로 단정하지 마세요.
                            </MudAlert>
                        }
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-summary__card">
                        <MudText Typo="Typo.h6">경로</MudText>
                        <div class="shipper-summary__route">
                            <span><MudIcon Icon="@Icons.Material.Filled.TripOrigin" Color="Color.Primary" Size="Size.Small" /> 상차</span>
                            <strong>@ShipperRequestDetailPresentation.Display(item.PickupAddress)</strong>
                            <span><MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Secondary" Size="Size.Small" /> 하차</span>
                            <strong>@ShipperRequestDetailPresentation.Display(item.DropoffAddress)</strong>
                        </div>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-summary__card">
                        <MudText Typo="Typo.h6">비용·조건</MudText>
                        <dl>
                            <div><dt>결제 예정</dt><dd>@ShipperRequestDetailPresentation.Money(item.ExpectedPaymentAmount)</dd></div>
                            <div><dt>최종 운임</dt><dd>@ShipperRequestDetailPresentation.Money(item.FinalFare)</dd></div>
                            <div><dt>결제 수단</dt><dd>@ShipperRequestDetailPresentation.Display(item.PaymentMethod)</dd></div>
                            <div><dt>정산 시점</dt><dd>@ShipperRequestDetailPresentation.Display(item.SettlementTiming)</dd></div>
                        </dl>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-summary__card">
                        <MudText Typo="Typo.h6">화물·등록</MudText>
                        <dl>
                            <div><dt>화물</dt><dd>@ShipperRequestDetailPresentation.Display(item.CargoType)</dd></div>
                            <div><dt>규격</dt><dd>@ShipperRequestDetailPresentation.Display(item.CargoDimensions)</dd></div>
                            <div><dt>팔레트</dt><dd>@(item.PalletCount?.ToString("N0") ?? "-")</dd></div>
                            <div><dt>등록 시각</dt><dd>@DisplayDateTime(item.CreatedAt)</dd></div>
                        </dl>
                    </MudPaper>
                </div>
            </div>
        }
    </ChildContent>
</ShipperRequestDetailScreenFrame>

@code {
    [Parameter, EditorRequired] public ShipperRequestDetailPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestDetailNavigationContext Context { get; set; } = new();
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter] public string Title { get; set; } = "운송 의뢰 요약";
    [Parameter] public string Description { get; set; } = "화물, 경로, 비용과 현재 상태를 한 번에 확인합니다.";
    [Parameter, EditorRequired] public string HomeHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NewRequestHref { get; set; } = string.Empty;
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public EventCallback<string> LookupRequested { get; set; }

    private Task LookupAsync()
        => LookupRequested.HasDelegate
            ? LookupRequested.InvokeAsync(State.LookupRequestId)
            : Task.CompletedTask;

    private static Color ResolveStateColor(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => Color.Success,
            ShipperRequestProgressState.Active => Color.Primary,
            ShipperRequestProgressState.Attention => Color.Error,
            _ => Color.Default
        };

    private static string DisplayDateTime(DateTime value)
        => value == default ? "-" : value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string DisplayDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";

    private static string AssignedDriver(ShipperRequestDetailSnapshot item)
        => string.IsNullOrWhiteSpace(item.AssignedDriverName)
            ? ShipperRequestDetailPresentation.Display(item.AssignedDriverId)
            : item.AssignedDriverName;

    private static string DriverLocation(ShipperRequestDetailSnapshot item)
        => item.DriverLatitude.HasValue && item.DriverLongitude.HasValue
            ? $"{item.DriverLatitude.Value:F5}, {item.DriverLongitude.Value:F5}"
            : "-";
}
