@using Ssalddel.Contracts.Common.Sales
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@namespace Ssalddel.Ui.Common.Areas.App.Components.Sales

<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudSelect T="string"
                   Label="판매채널"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Required="true"
                   RequiredError="판매채널을 선택해 주세요."
                   Disabled="@ChannelLocked"
                   @bind-Value="Model.채널종류">
            @foreach (var channel in ChannelOptions)
            {
                <MudSelectItem T="string" Value="@channel.값">
                    @channel.표시명
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12">
        <MudTextField T="string"
                      Label="상점명"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Required="true"
                      RequiredError="상점명을 입력해 주세요."
                      MaxLength="100"
                      @bind-Value="Model.상점명" />
    </MudItem>
    @foreach (var field in CurrentCredentialFields)
    {
        <MudItem xs="12" @key="field.Key">
            <MudTextField T="string"
                          Value="@CredentialValue(field.Key)"
                          ValueChanged="@((string value) => SetCredentialValue(field.Key, value))"
                          Label="@field.표시명"
                          HelperText="@($"{field.전달위치} · {field.도움말}")"
                          Placeholder="@field.Placeholder"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="@field.필수"
                          InputType="@(field.비밀값 ? InputType.Password : InputType.Text)"
                          MaxLength="2000" />
        </MudItem>
    }
    <MudItem xs="12">
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
            자격증명은 서버에서 암호화되며 조회 응답에는 마스킹된 설정 여부만 포함됩니다.
        </MudAlert>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public 판매채널계정저장요청 Model { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<업무선택항목<string>> ChannelOptions { get; set; } = [];

    [Parameter]
    public bool ChannelLocked { get; set; }

    private IReadOnlyList<판매채널인증필드정의> CurrentCredentialFields
        => 판매채널인증SchemaCatalog.찾기(Model.채널종류)?.Fields ?? [];

    private string CredentialValue(string key)
        => Model.인증정보.GetValueOrDefault(key, string.Empty);

    private void SetCredentialValue(string key, string? value)
        => Model.인증정보[key] = value ?? string.Empty;
}
