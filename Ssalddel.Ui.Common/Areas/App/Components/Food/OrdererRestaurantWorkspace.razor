@inherits MvvmComponentBase<음식점탐색PageViewModel>
@using Ssalddel.Contracts.Restaurants
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="restaurant-workspace" aria-label="공개 음식점과 메뉴 탐색">
    @if (Access.처리중 && Access.화면상태 == 음식배달페이지접근상태.확인전)
    {
        <MudPaper Elevation="0" Outlined="true" Class="restaurant-state">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1">음식 배달 기능 상태를 확인하고 있습니다.</MudText>
        </MudPaper>
    }
    else if (Access.화면상태 == 음식배달페이지접근상태.오류)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle2">음식점 탐색 화면을 준비하지 못했습니다.</MudText>
            <MudText Typo="Typo.body2">@ErrorMessage(Access.오류메시지)</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="InitializeAsync" Class="mt-3">다시 확인</MudButton>
        </MudAlert>
    }
    else if (Access.기능비활성)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle2">음식 배달 공개 조회가 현재 비활성입니다.</MudText>
            <MudText Typo="Typo.body2"><code>FoodDeliveryWorkflow</code>가 활성화되기 전에는 음식점·메뉴 원장을 조회하지 않습니다.</MudText>
        </MudAlert>
    }
    else if (Access.사용가능)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="restaurant-boundary">
            사용자가 고른 공개 행정권역 기준점으로만 거리를 계산합니다. 현재 위치와 주소를 자동 수집하지 않으며, 이 화면은 주문·결제·조리 접수·기사 배차를 생성하지 않습니다.
        </MudAlert>

        <div class="restaurant-layout">
            <div class="restaurant-main">
                <MudPaper Elevation="0" Outlined="true" Class="restaurant-panel restaurant-search-panel">
                    <div class="restaurant-panel-heading">
                        <div>
                            <MudText Typo="Typo.overline">PUBLIC RESTAURANT DIRECTORY</MudText>
                            <MudText Typo="Typo.h6">조회 기준 직접 선택</MudText>
                        </div>
                        @if (Criteria.선택권역 is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@Criteria.선택권역.표시명</MudChip>
                        }
                    </div>

                    @if (Criteria.처리중)
                    {
                        <div class="restaurant-state restaurant-state--compact">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">서버 탐색 정책과 공개 권역을 불러오고 있습니다.</MudText>
                        </div>
                    }
                    else if (Criteria.오류발생)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                            @ErrorMessage(Criteria.오류메시지)
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="PrepareCriteriaAsync">다시 시도</MudButton>
                        </MudAlert>
                    }
                    else if (Criteria.정책 is not null)
                    {
                        <div class="restaurant-search-grid">
                            <MudSelect T="string"
                                       @bind-Value="Criteria.선택배달권키"
                                       Label="공개 행정권역"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true">
                                @foreach (var scope in Criteria.권역목록)
                                {
                                    <MudSelectItem T="string" Value="@scope.배달권키">@scope.표시명 · @scope.기준지명</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string"
                                          @bind-Value="List.검색어"
                                          Label="상호·카테고리·소개"
                                          Placeholder="예: 분식, 국밥"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </div>

                        <div class="restaurant-radius-row">
                            <div>
                                <MudText Typo="Typo.subtitle2">조회 반경 @($"{Criteria.반경Km:0.#}km")</MudText>
                                <MudText Typo="Typo.caption">선택한 행정기관 공개 기준점으로부터의 직선거리입니다.</MudText>
                            </div>
                            <MudSlider T="double"
                                       @bind-Value="Criteria.반경Km"
                                       Min="@Criteria.정책.MinRadiusKm"
                                       Max="@Criteria.정책.MaxRadiusKm"
                                       Step="@Criteria.정책.RadiusStepKm"
                                       ValueLabel="true"
                                       Color="Color.Primary" />
                        </div>

                        <div class="restaurant-search-actions">
                            <div class="restaurant-quick-radius">
                                @foreach (var radius in Criteria.정책.QuickRadiusOptions)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="@(Math.Abs(Criteria.반경Km - radius) < 0.01 ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               OnClick="@(() => SetRadius(radius))">
                                        @($"{radius:0.#}km")
                                    </MudButton>
                                }
                            </div>
                            <MudCheckBox T="bool" @bind-Value="List.주문가능만" Color="Color.Primary">주문 가능한 곳만</MudCheckBox>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.TravelExplore"
                                       Disabled="@(!Criteria.조회가능 || List.처리중)"
                                       OnClick="SearchAsync">
                                음식점 조회
                            </MudButton>
                        </div>

                        @if (Criteria.선택권역 is not null)
                        {
                            <MudText Typo="Typo.caption" Class="restaurant-basis">@Criteria.선택권역.거리기준안내</MudText>
                        }
                    }
                </MudPaper>

                <MudPaper Elevation="0" Outlined="true" Class="restaurant-panel restaurant-list-panel">
                    <div class="restaurant-panel-heading">
                        <div>
                            <MudText Typo="Typo.overline">SERVER RESULTS</MudText>
                            <MudText Typo="Typo.h6">공개 음식점</MudText>
                        </div>
                        @if (List.초기화됨)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@List.처리중" OnClick="ReloadListAsync">새로고침</MudButton>
                        }
                    </div>

                    @if (List.처리중)
                    {
                        <div class="restaurant-state restaurant-state--compact">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">공개 음식점 원장을 조회하고 있습니다.</MudText>
                        </div>
                    }
                    else if (List.오류발생)
                    {
                        <div class="restaurant-state restaurant-state--compact">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                            <MudText Typo="Typo.subtitle2">음식점 목록을 불러오지 못했습니다.</MudText>
                            <MudText Typo="Typo.body2">@ErrorMessage(List.오류메시지)</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReloadListAsync">다시 시도</MudButton>
                        </div>
                    }
                    else if (!List.초기화됨)
                    {
                        <div class="restaurant-state restaurant-state--compact">
                            <MudIcon Icon="@Icons.Material.Filled.LocationCity" Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.subtitle2">조회할 공개 행정권역을 선택해 주세요.</MudText>
                            <MudText Typo="Typo.body2">첫 음식점이나 임의 위치를 자동 선택하지 않습니다.</MudText>
                        </div>
                    }
                    else if (List.결과없음)
                    {
                        <div class="restaurant-state restaurant-state--compact">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
                            <MudText Typo="Typo.subtitle2">선택한 기준에 공개된 음식점이 없습니다.</MudText>
                            <MudText Typo="Typo.body2">@EmptyMessage</MudText>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">@($"전체 {List.전체건수:N0}곳 · {List.현재페이지}/{List.총페이지수}페이지")</MudText>
                        <div class="restaurant-card-grid">
                            @foreach (var restaurant in List.음식점목록)
                            {
                                <article class="restaurant-card @(Detail.요청RestaurantId == restaurant.Id ? "restaurant-card--selected" : string.Empty)">
                                    <div class="restaurant-card-heading">
                                        <div>
                                            <MudText Typo="Typo.h6">@restaurant.상호명</MudText>
                                            <MudText Typo="Typo.caption">@restaurant.카테고리 · @DistanceLabel(restaurant.거리Km)</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="@(restaurant.주문가능여부 ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                                            @(restaurant.주문가능여부 ? "주문 가능" : "현재 준비 중")
                                        </MudChip>
                                    </div>
                                    <MudText Typo="Typo.body2">@ValueOrDash(restaurant.소개)</MudText>
                                    <MudText Typo="Typo.caption">@ValueOrDash(restaurant.공개주소)</MudText>
                                    <div class="restaurant-card-meta">
                                        <span>메뉴 @restaurant.공개메뉴수.ToString("N0")개</span>
                                        <span>최소 @restaurant.최소주문금액.ToString("N0")원</span>
                                        <span>예상 조리 @(restaurant.예상조리분)분</span>
                                    </div>
                                    <MudButton Variant="@(Detail.요청RestaurantId == restaurant.Id ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.RestaurantMenu"
                                               OnClick="@(() => SelectRestaurantAsync(restaurant.Id))">
                                        공개 메뉴 보기
                                    </MudButton>
                                </article>
                            }
                        </div>

                        @if (List.총페이지수 > 1)
                        {
                            <div class="restaurant-pagination">
                                <MudPagination Count="@List.총페이지수"
                                               Selected="@List.현재페이지"
                                               SelectedChanged="ChangePageAsync"
                                               Disabled="@List.처리중"
                                               ShowFirstButton="true"
                                               ShowLastButton="true" />
                            </div>
                        }
                    }
                </MudPaper>
            </div>

            <MudPaper Elevation="0" Outlined="true" Class="restaurant-panel restaurant-detail-panel">
                @if (Detail.처리중)
                {
                    <div class="restaurant-state restaurant-state--detail">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">정확한 음식점과 공개 메뉴를 불러오고 있습니다.</MudText>
                    </div>
                }
                else if (Detail.오류발생)
                {
                    <div class="restaurant-state restaurant-state--detail">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle2">음식점 상세를 불러오지 못했습니다.</MudText>
                        <MudText Typo="Typo.body2">@ErrorMessage(Detail.오류메시지)</MudText>
                        @if (Detail.요청RestaurantId is long retryId)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => SelectRestaurantAsync(retryId, false))">다시 시도</MudButton>
                        }
                    </div>
                }
                else if (Detail.찾을수없음)
                {
                    <div class="restaurant-state restaurant-state--detail">
                        <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle2">공개된 음식점을 찾을 수 없습니다.</MudText>
                        <MudText Typo="Typo.body2">비공개·삭제된 ID를 다른 음식점으로 대체하지 않습니다.</MudText>
                    </div>
                }
                else if (Detail.상세 is { } detail)
                {
                    <div class="restaurant-detail-heading">
                        <div>
                            <MudText Typo="Typo.overline">EXACT RESTAURANT #{detail.음식점.Id}</MudText>
                            <MudText Typo="Typo.h5">@detail.음식점.상호명</MudText>
                            <MudText Typo="Typo.body2">@detail.음식점.카테고리 · @ValueOrDash(detail.음식점.공개주소)</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClearSelectionAsync" aria-label="음식점 상세 닫기" />
                    </div>
                    <MudText Typo="Typo.body2">@ValueOrDash(detail.음식점.소개)</MudText>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1">공개 메뉴 @detail.메뉴목록.Count.ToString("N0")개</MudText>
                    @if (detail.메뉴목록.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">현재 공개된 메뉴가 없습니다.</MudAlert>
                    }
                    else
                    {
                        <div class="restaurant-menu-list">
                            @foreach (var menu in detail.메뉴목록)
                            {
                                <div class="restaurant-menu-item">
                                    <div>
                                        <MudText Typo="Typo.subtitle2">@menu.메뉴명</MudText>
                                        <MudText Typo="Typo.caption">@ValueOrDash(menu.설명)</MudText>
                                    </div>
                                    <div class="restaurant-menu-price">
                                        <strong>@menu.판매가.ToString("N0")원</strong>
                                        @if (menu.품절여부)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default">품절</MudChip>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mt-3">
                        메뉴 선택과 주문 상세 생성은 다음 P1 페이지에서 연결합니다. 현재 메뉴 조회는 주문 의향이나 결제를 저장하지 않습니다.
                    </MudAlert>
                }
                else
                {
                    <div class="restaurant-state restaurant-state--detail">
                        <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle2">음식점을 선택하면 공개 메뉴를 확인할 수 있습니다.</MudText>
                        <MudText Typo="Typo.body2">선택 전에는 첫 음식점이나 샘플 메뉴를 대신 표시하지 않습니다.</MudText>
                    </div>
                }
            </MudPaper>
        </div>
    }
</section>
