@inherits MvvmComponentBase<음식점탐색PageViewModel>
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="restaurant-workspace" aria-label="공개 음식점과 메뉴 탐색">
    @if (!Access.사용가능)
    {
        <OrdererRestaurantAccessState Access="@Access"
                                      RetryRequested="InitializeAsync" />
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="restaurant-boundary">
            사용자가 고른 공개 행정권역 기준점으로만 거리를 계산합니다. 현재 위치와 주소를 자동 수집하지 않으며, 이 화면은 주문·결제·조리 접수·기사 배차를 생성하지 않습니다.
        </MudAlert>

        <div class="restaurant-layout">
            <div class="restaurant-main">
                <OrdererRestaurantSearchPanel Criteria="@Criteria"
                                               List="@List"
                                               RetryRequested="PrepareCriteriaAsync"
                                               SearchRequested="SearchAsync"
                                               RadiusSelected="SetRadius" />
                <OrdererRestaurantResultList List="@List"
                                             SelectedRestaurantId="@Detail.요청RestaurantId"
                                             ReloadRequested="ReloadListAsync"
                                             PageChanged="ChangePageAsync"
                                             RestaurantSelected="SelectRestaurantFromListAsync" />
            </div>

            <OrdererRestaurantDetailPanel Detail="@Detail"
                                          RetryRequested="RetryRestaurantAsync"
                                          ClearRequested="ClearSelectionAsync" />
        </div>
    }
</section>
