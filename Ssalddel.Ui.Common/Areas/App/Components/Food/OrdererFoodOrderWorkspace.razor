@inherits MvvmComponentBase<주문자음식주문PageViewModel>
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="food-order-workspace" aria-label="내 음식 주문 내역">
    @if (!Access.사용가능 || (Authentication.처리중 && !Authentication.초기화됨))
    {
        <OrdererFoodOrderAccessState Access="Access"
                                     Authentication="Authentication"
                                     RetryRequested="InitializeAsync" />
    }
    else if (Access.사용가능 && !Authentication.로그인됨)
    {
        <OrdererFoodOrderLoginPanel Authentication="Authentication"
                                    LoginRequested="LoginAsync" />
    }
    else if (Access.사용가능)
    {
        <OrdererFoodOrderHeader Authentication="Authentication"
                                LogoutRequested="LogoutAsync" />

        <div class="food-order-layout">
            <div class="food-order-main">
                <OrdererFoodOrderSearchPanel List="List"
                                             SearchRequested="@(() => ViewModel.목록검색Async())"
                                             ReloadRequested="@(() => ViewModel.목록새로고침Async())"
                                             ResetRequested="@(() => ViewModel.검색조건초기화Async())" />
                <OrdererFoodOrderListPanel List="List"
                                           SelectedOrderNo="Detail.요청OrderNo"
                                           OrderSelected="SelectOrderAsync"
                                           PageChanged="@(page => ViewModel.페이지변경Async(page))"
                                           ReloadRequested="@(() => ViewModel.목록새로고침Async())"
                                           ResetRequested="@(() => ViewModel.검색조건초기화Async())" />
            </div>

            <OrdererFoodOrderDetailPanel Detail="Detail"
                                         RetryRequested="RetryOrderAsync"
                                         CloseRequested="ClearSelectionAsync" />
        </div>
    }
</section>
