@namespace Ssalddel.Ui.Common.Areas.App.Components.Community
@implements IDisposable
@using Ssalddel.Contracts.Common.Community
@inject PlatformDiagramPaletteStateService DiagramPalette
@inject NavigationManager Navigation

<section class="community-diagram-screen"
         data-ledger-template="@ActiveLedgerTemplate.Key"
         data-selected-node="@selectedNode"
         data-zoom="@diagramZoomPercent"
         data-filter="@paletteFilter">
    <header class="community-diagram-screen-header">
        <div>
            <span>WORKFLOW DIAGRAM</span>
            <h1>업무 다이어그램 작업대</h1>
            <p>관계와 상태를 살펴보고, 구체 처리·입력·승인은 각 업무 화면에서 이어갑니다.</p>
        </div>
        <div class="community-diagram-screen-actions">
            <a class="community-diagram-return" href="@normalizedReturnPath">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                <span>출발 화면으로</span>
            </a>
            <div class="community-diagram-zoom" aria-label="다이어그램 확대 비율">
                <button type="button"
                        title="축소"
                        aria-label="다이어그램 축소"
                        disabled="@(diagramZoomPercent <= CommunityDiagramNavigationContext.MinimumZoomPercent)"
                        @onclick="ZoomOut">−</button>
                <strong>@($"{diagramZoomPercent}%")</strong>
                <button type="button"
                        title="확대"
                        aria-label="다이어그램 확대"
                        disabled="@(diagramZoomPercent >= CommunityDiagramNavigationContext.MaximumZoomPercent)"
                        @onclick="ZoomIn">+</button>
            </div>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">2단계 · 관계 탐색</MudChip>
        </div>
    </header>

    <button type="button"
            class="community-diagram-mobile-palette-trigger"
            aria-haspopup="dialog"
            aria-expanded="@isMobilePaletteOpen"
            @onclick="OpenMobilePalette">
        <MudIcon Icon="@Icons.Material.Filled.DashboardCustomize" Size="Size.Small" />
        <span>노드 팔레트</span>
        <strong>@ActiveLedgerPaletteGroup.Title</strong>
    </button>

    @if (isMobilePaletteOpen)
    {
        <button type="button"
                class="community-diagram-mobile-backdrop"
                aria-label="노드 팔레트 닫기"
                @onclick="CloseMobilePalette"></button>
    }

<div class="community-diagram-workbench">
    <MudPaper Elevation="0"
              Outlined="true"
              Class="@PaletteCssClass"
              role="@(isMobilePaletteOpen ? "dialog" : "complementary")"
              aria-modal="@(isMobilePaletteOpen ? "true" : null)"
              aria-label="원장별 노드 팔레트">
        <MudStack Class="platform-block-palette" Spacing="2">
            <div class="community-diagram-mobile-sheet-header">
                <div>
                    <span>노드 팔레트</span>
                    <strong>@ActiveLedgerPaletteGroup.Title</strong>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Medium"
                               OnClick="CloseMobilePalette"
                               aria-label="노드 팔레트 닫기" />
            </div>
            <MudStack Spacing="0" Class="platform-block-palette-header">
                <MudText Typo="Typo.overline" Color="Color.Secondary">원장별 노드 팔레트</MudText>
                <MudText Typo="Typo.subtitle2">@ActiveLedgerPaletteGroup.Title</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@($"{ActiveLedgerTemplate.WorkflowTag} · {원장처리체계표시명(ActiveLedgerTemplate.TargetOperatingSystemName)}")</MudText>
            </MudStack>

            <MudTextField T="string"
                          Value="@paletteFilter"
                          ValueChanged="UpdatePaletteFilter"
                          Placeholder="노드 이름·설명 필터"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Clearable="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            <div class="platform-ledger-palette-group-grid" aria-label="원장별 노드 묶음">
                @foreach (var group in LedgerPaletteGroups)
                {
                    <button type="button"
                            class="@BuildLedgerPaletteGroupClass(group)"
                            title="@group.Description"
                            @onclick="@(() => SetLedgerPaletteGroup(group.WorkflowModeKey))">
                        <span class="platform-ledger-palette-group-title">@group.Title</span>
                        <span class="platform-ledger-palette-group-count">@($"{CountPaletteBlocks(group.WorkflowModeKey)}개 노드")</span>
                    </button>
                }
            </div>

            @if (ActiveWorkflowPreset is not null)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.AccountTree"
                           OnClick="DrawActiveWorkflowPreset">
                    @ActiveWorkflowPreset.Title 그리기
                </MudButton>
            }

            @foreach (var section in ActivePaletteSections)
            {
                <section class="platform-block-palette-section" aria-label="@section.Title">
                    <div class="platform-block-palette-section-header">
                        <span>@section.Title</span>
                        <small>@($"{section.Blocks.Count}개")</small>
                    </div>
                    <div class="platform-block-palette-grid">
                        @foreach (var block in section.Blocks)
                        {
                            <button type="button"
                                    class="@BuildPaletteItemClass(block)"
                                    title="@block.Description"
                                    @onclick="@(() => AddBlockToCanvas(block))">
                                <span class="platform-block-palette-icon">
                                    <MudIcon Icon="@block.Icon" Color="@block.Color" />
                                </span>
                                <span class="platform-block-palette-title">@block.Title</span>
                                <span class="platform-block-palette-tag">@block.GroupLabel</span>
                            </button>
                        }
                    </div>
                </section>
            }

            @if (ActivePaletteSections.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    입력한 필터와 맞는 노드가 없습니다. 필터를 지우고 다시 확인해 주세요.
                </MudAlert>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="community-diagram-canvas">
        <PlatformCommunityHome AppName="@AppName"
                               RoleLabel="@RoleLabel"
                               AppKey="@AppKey"
                               UseBaguaRoleTransitionPages="true"
                               QueryLedgerTemplateKey="@ActiveLedgerTemplate.Key"
                               QueryDiagramMode="true"
                               QueryDiagramSelectedNode="@selectedNode"
                               QueryDiagramZoomPercent="@diagramZoomPercent"
                               DiagramCloseHref="@normalizedReturnPath"
                               DiagramReturnHref="@CurrentDiagramPath"
                               DiagramSelectedNodeChanged="HandleSelectedNodeChanged" />
    </MudPaper>
</div>

</section>

<style>
    .community-diagram-screen {
        display: grid;
        gap: 16px;
        min-width: 0;
        padding: 16px;
    }

    .community-diagram-screen-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        border: 1px solid rgba(var(--mud-palette-secondary-rgb), 0.18);
        border-radius: 16px;
        background: color-mix(in srgb, var(--mud-palette-secondary) 5%, var(--mud-palette-surface));
    }

    .community-diagram-screen-header > div:first-child {
        display: grid;
        gap: 4px;
        min-width: 0;
    }

    .community-diagram-screen-header span {
        color: var(--mud-palette-secondary);
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.12em;
    }

    .community-diagram-screen-header h1,
    .community-diagram-screen-header p {
        margin: 0;
    }

    .community-diagram-screen-header h1 {
        font-size: clamp(1.35rem, 2.4vw, 2rem);
        letter-spacing: -0.04em;
    }

    .community-diagram-screen-header p {
        max-width: 720px;
        color: var(--mud-palette-text-secondary);
        font-size: 0.88rem;
        line-height: 1.55;
    }

    .community-diagram-screen-actions,
    .community-diagram-return,
    .community-diagram-zoom {
        display: flex;
        align-items: center;
    }

    .community-diagram-screen-actions {
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .community-diagram-return {
        gap: 6px;
        min-height: 44px;
        padding: 8px 12px;
        border: 1px solid rgba(var(--mud-palette-primary-rgb), 0.2);
        border-radius: 999px;
        color: var(--mud-palette-primary);
        text-decoration: none;
    }

    .community-diagram-return span {
        color: inherit;
        font-size: 0.78rem;
        letter-spacing: 0;
    }

    .community-diagram-zoom {
        gap: 2px;
        min-height: 44px;
        padding: 3px;
        border: 1px solid rgba(var(--mud-palette-secondary-rgb), 0.18);
        border-radius: 999px;
        background: var(--mud-palette-surface);
    }

    .community-diagram-zoom button {
        appearance: none;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--mud-palette-secondary);
        cursor: pointer;
        font: inherit;
        font-size: 1.1rem;
        font-weight: 900;
    }

    .community-diagram-zoom button:disabled {
        cursor: default;
        opacity: 0.34;
    }

    .community-diagram-zoom strong {
        min-width: 48px;
        color: var(--mud-palette-text-primary);
        font-size: 0.74rem;
        text-align: center;
    }

    .community-diagram-mobile-palette-trigger,
    .community-diagram-mobile-backdrop,
    .community-diagram-mobile-sheet-header {
        display: none;
    }

    .community-diagram-workbench {
        display: grid;
        grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
        gap: 12px;
        align-items: start;
    }

    .community-diagram-palette {
        position: sticky;
        top: 12px;
        max-height: calc(100vh - 24px);
        overflow: auto;
    }

    .community-diagram-canvas {
        min-height: 70vh;
        overflow: auto;
    }

    .platform-ledger-palette-group-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .platform-ledger-palette-group {
        appearance: none;
        display: grid;
        gap: 3px;
        width: 100%;
        min-height: 58px;
        padding: 8px;
        border: 1px solid rgba(var(--mud-palette-primary-rgb), 0.16);
        border-radius: 8px;
        background: var(--mud-palette-surface);
        color: inherit;
        cursor: pointer;
        font: inherit;
        text-align: left;
        transition: border-color 140ms ease, background 140ms ease, box-shadow 140ms ease;
    }

    .platform-ledger-palette-group:hover,
    .platform-ledger-palette-group:focus-visible {
        border-color: rgba(var(--mud-palette-secondary-rgb), 0.48);
        outline: none;
        box-shadow: 0 0 0 3px rgba(var(--mud-palette-secondary-rgb), 0.12);
    }

    .platform-ledger-palette-group--selected {
        border-color: var(--mud-palette-secondary);
        background: color-mix(in srgb, var(--mud-palette-secondary) 10%, var(--mud-palette-surface));
    }

    .platform-ledger-palette-group-title {
        overflow: hidden;
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1.2;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .platform-ledger-palette-group-count {
        color: var(--mud-palette-text-secondary);
        font-size: 0.68rem;
        line-height: 1.2;
    }

    .platform-block-palette-section {
        display: grid;
        gap: 8px;
    }

    .platform-block-palette-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        color: var(--mud-palette-text-secondary);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0;
    }

    .platform-block-palette-section-header small {
        font-size: 0.68rem;
        font-weight: 700;
    }

    .platform-block-palette-grid {
        display: grid;
        gap: 10px;
    }

    .platform-block-palette-item {
        appearance: none;
        display: grid;
        justify-items: start;
        gap: 6px;
        width: 100%;
        min-height: 96px;
        padding: 12px;
        border: 1px solid rgba(var(--mud-palette-primary-rgb), 0.18);
        border-left-width: 4px;
        border-radius: 8px;
        background: var(--mud-palette-surface);
        color: inherit;
        cursor: pointer;
        font: inherit;
        text-align: left;
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }

    .platform-block-palette-item:hover,
    .platform-block-palette-item:focus-visible {
        border-color: rgba(var(--mud-palette-primary-rgb), 0.42);
        box-shadow: 0 10px 22px rgba(var(--mud-palette-primary-rgb), 0.12);
        outline: none;
        transform: translateY(-1px);
    }

    .platform-block-palette-item--product {
        border-left-color: #2563eb;
    }

    .platform-block-palette-item--sales-channel {
        border-left-color: #db2777;
    }

    .platform-block-palette-item--warehouse {
        border-left-color: #16a34a;
    }

    .platform-block-palette-item--place {
        border-left-color: #0891b2;
    }

    .platform-block-palette-item--work {
        border-left-color: #d97706;
    }

    .platform-block-palette-item--delivery {
        border-left-color: #7c3aed;
    }

    .platform-block-palette-item--confirm {
        border-left-color: #0f766e;
    }

    .platform-block-palette-item--form {
        border-left-color: #0284c7;
    }

    .platform-block-palette-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--mud-palette-primary) 8%, var(--mud-palette-surface));
    }

    .platform-block-palette-title {
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .platform-block-palette-tag {
        max-width: 100%;
        overflow: hidden;
        color: var(--mud-palette-text-secondary);
        font-size: 0.72rem;
        line-height: 1.2;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @@media (max-width: 760px) {
        .community-diagram-screen {
            gap: 10px;
            padding: 8px 8px 92px;
        }

        .community-diagram-screen-header {
            display: grid;
            gap: 12px;
            padding: 14px;
            border-radius: 14px;
        }

        .community-diagram-screen-header h1 {
            font-size: 1.35rem;
        }

        .community-diagram-screen-actions {
            justify-content: flex-start;
        }

        .community-diagram-screen-actions > .mud-chip,
        .community-diagram-zoom {
            display: none;
        }

        .community-diagram-workbench {
            display: block;
        }

        .community-diagram-palette {
            display: none;
        }

        .community-diagram-palette--open {
            display: block;
            position: fixed;
            z-index: 1302;
            top: auto;
            right: 0;
            bottom: 0;
            left: 0;
            width: 100%;
            max-height: min(82vh, 720px);
            overflow: auto;
            border-radius: 22px 22px 0 0;
            box-shadow: 0 -18px 48px rgba(15, 23, 42, 0.24);
        }

        .community-diagram-mobile-palette-trigger {
            display: grid;
            position: fixed;
            z-index: 1100;
            right: auto;
            bottom: 16px;
            left: 14px;
            grid-template-columns: auto auto;
            align-items: center;
            gap: 2px 8px;
            min-height: 52px;
            padding: 8px 14px;
            border: 0;
            border-radius: 999px;
            background: var(--mud-palette-secondary);
            color: var(--mud-palette-secondary-text);
            box-shadow: 0 14px 32px rgba(15, 23, 42, 0.24);
            cursor: pointer;
            font: inherit;
            text-align: left;
        }

        .community-diagram-mobile-palette-trigger > .mud-icon-root {
            grid-row: 1 / span 2;
        }

        .community-diagram-mobile-palette-trigger span,
        .community-diagram-mobile-palette-trigger strong {
            color: inherit;
            letter-spacing: 0;
        }

        .community-diagram-mobile-palette-trigger span {
            font-size: 0.66rem;
            font-weight: 700;
            opacity: 0.82;
        }

        .community-diagram-mobile-palette-trigger strong {
            font-size: 0.8rem;
        }

        .community-diagram-mobile-backdrop {
            display: block;
            position: fixed;
            z-index: 1301;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
            background: rgba(15, 23, 42, 0.48);
        }

        .community-diagram-mobile-sheet-header {
            display: flex;
            position: sticky;
            z-index: 2;
            top: -12px;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: -12px -12px 0;
            padding: 12px 14px 10px;
            border-bottom: 1px solid rgba(var(--mud-palette-secondary-rgb), 0.14);
            background: var(--mud-palette-surface);
        }

        .community-diagram-mobile-sheet-header > div {
            display: grid;
            gap: 2px;
        }

        .community-diagram-mobile-sheet-header span {
            color: var(--mud-palette-secondary);
            font-size: 0.66rem;
            font-weight: 900;
            letter-spacing: 0.08em;
        }

        .community-diagram-mobile-sheet-header strong {
            font-size: 0.96rem;
        }

        .community-diagram-canvas {
            min-height: 100vh;
            overflow: visible;
            border: 0;
        }

        .platform-ledger-palette-group,
        .platform-block-palette-item {
            min-height: 48px;
        }

        .community-diagram-screen .platform-ledger-diagram-toolbar .mud-icon-button,
        .community-diagram-screen .platform-ledger-mobile-node-actions .mud-icon-button,
        .community-diagram-screen .platform-ledger-mobile-node-actions .mud-button,
        .community-diagram-screen .platform-ledger-layer-toggle,
        .community-diagram-screen .platform-ledger-mobile-dock-close {
            min-width: 44px;
            min-height: 44px;
        }

        .community-diagram-palette--open .mud-button,
        .community-diagram-palette--open .mud-icon-button,
        .community-diagram-palette--open .mud-input-slot {
            min-height: 44px;
        }

        .community-diagram-palette--open .mud-icon-button {
            min-width: 44px;
        }

        .platform-block-palette-item {
            grid-template-columns: auto 1fr;
            align-items: center;
        }

        .platform-block-palette-item .platform-block-palette-tag {
            grid-column: 2;
        }
    }
</style>

@code {
    [Parameter]
    public string AppName { get; set; } = "살뜰";

    [Parameter]
    public string RoleLabel { get; set; } = "사용자";

    [Parameter]
    public string AppKey { get; set; } = "shipper";

    [Parameter]
    public string? LedgerTemplateKey { get; set; }

    [Parameter]
    public string? SelectedNode { get; set; }

    [Parameter]
    public int? ZoomPercent { get; set; }

    [Parameter]
    public string? Filter { get; set; }

    [Parameter]
    public string? ReturnPath { get; set; }

    private bool isMobilePaletteOpen;
    private string paletteFilter = string.Empty;
    private string? selectedNode;
    private int diagramZoomPercent = CommunityDiagramNavigationContext.DefaultZoomPercent;

    private string normalizedReturnPath
        => CommunityDiagramNavigationContext.NormalizeReturnPath(ReturnPath);

    private string CurrentDiagramPath
        => CommunityPageRoutes.DiagramFor(
            ActiveLedgerTemplate.Key,
            selectedNode,
            diagramZoomPercent,
            paletteFilter,
            normalizedReturnPath);

    private string PaletteCssClass
        => isMobilePaletteOpen
            ? "pa-3 community-diagram-palette community-diagram-palette--open"
            : "pa-3 community-diagram-palette";

    private LedgerPaletteGroupItem ActiveLedgerPaletteGroup
        => LedgerPaletteGroups.FirstOrDefault(group =>
            string.Equals(group.WorkflowModeKey, DiagramPalette.WorkflowModeKey, StringComparison.OrdinalIgnoreCase))
           ?? LedgerPaletteGroups[0];

    private CommunityLedgerTemplateResponse ActiveLedgerTemplate
        => CommunityLedgerTemplateCatalog.Find(ActiveLedgerPaletteGroup.LedgerTemplateKey);

    private WorkflowPresetItem? ActiveWorkflowPreset
        => WorkflowPresets.FirstOrDefault(preset =>
            string.Equals(preset.WorkflowModeKey, ActiveLedgerPaletteGroup.WorkflowModeKey, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<PaletteBlockSectionItem> ActivePaletteSections
        => BuildPaletteSections(ActiveLedgerPaletteGroup, paletteFilter);

    private static readonly IReadOnlyList<LedgerPaletteGroupItem> LedgerPaletteGroups =
    [
        new("cargo-v1", CommunityLedgerTemplateKeys.CargoTransport, "화물 운송 원장", "화주 의뢰, 기사 추천, 상차, 하차, 인수 확인 워크플로우입니다."),
        new("warehouse-inbound", CommunityLedgerTemplateKeys.WarehouseInbound, "창고 입고 원장", "입고 발생, 작업대, 바코드, 입고 예정 매칭, 검수 워크플로우입니다."),
        new("warehouse-outbound", CommunityLedgerTemplateKeys.WarehouseOutbound, "창고 출고 원장", "주문/운송 요청, 재고 확인, 피킹, 포장, 운송 인계 워크플로우입니다."),
        new("food-delivery", CommunityLedgerTemplateKeys.FoodDelivery, "음식 배달 원장", "음식 주문, 조리, 픽업, 기사 배차, 배송 완료 워크플로우입니다."),
        new("mart-instant", CommunityLedgerTemplateKeys.SsalddelMart, "알뜰살뜰 마트 원장", "도심 재고, 피킹/포장, 사전 배차, 픽업 가능 상태 워크플로우입니다."),
