    protected override void OnInitialized()
    {
        DiagramPalette.Changed += HandlePaletteChanged;
        DiagramPalette.SetDiagramMode(true);
        if (!IsKnownLedgerPaletteGroup(DiagramPalette.WorkflowModeKey))
        {
            DiagramPalette.SetWorkflowMode(
                LedgerPaletteGroups[0].WorkflowModeKey,
                LedgerPaletteGroups[0].LedgerTemplateKey);
        }
    }

    protected override void OnParametersSet()
    {
        diagramZoomPercent = CommunityDiagramNavigationContext.NormalizeZoom(ZoomPercent);
        paletteFilter = Filter?.Trim() ?? string.Empty;
        selectedNode = string.IsNullOrWhiteSpace(SelectedNode)
            ? null
            : SelectedNode.Trim();

        var requestedGroup = string.IsNullOrWhiteSpace(LedgerTemplateKey)
            ? null
            : LedgerPaletteGroups.FirstOrDefault(group =>
                IsSameKey(group.LedgerTemplateKey, LedgerTemplateKey));
        if (requestedGroup is not null)
        {
            DiagramPalette.SetWorkflowMode(
                requestedGroup.WorkflowModeKey,
                requestedGroup.LedgerTemplateKey);
        }

        DiagramPalette.SetDiagramMode(true);
    }

    private void SetLedgerPaletteGroup(string workflowModeKey)
    {
        var group = LedgerPaletteGroups.FirstOrDefault(item =>
            IsSameKey(item.WorkflowModeKey, workflowModeKey))
            ?? LedgerPaletteGroups[0];

        DiagramPalette.SetDiagramMode(true);
        DiagramPalette.SetWorkflowMode(group.WorkflowModeKey, group.LedgerTemplateKey);
        selectedNode = null;
        CloseMobilePalette();
        ReplaceRouteContext(group.LedgerTemplateKey);
    }

    private void AddBlockToCanvas(PaletteBlockItem block)
    {
        DiagramPalette.SetDiagramMode(true);
        DiagramPalette.RequestBlock(ToDiagramPaletteBlock(block));
        CloseMobilePalette();
    }

    private void DrawActiveWorkflowPreset()
    {
        var preset = ActiveWorkflowPreset;
        if (preset is null)
        {
            return;
        }

        DiagramPalette.SetDiagramMode(true);
        DiagramPalette.SetWorkflowMode(preset.WorkflowModeKey, preset.LedgerTemplateKey);
        DiagramPalette.RequestWorkflowPreset(new PlatformDiagramWorkflowPreset(
            preset.Key,
            preset.Title,
            preset.LedgerTemplateKey,
            preset.Nodes.Select(ToDiagramPaletteBlock).ToArray(),
            preset.Connections
                .Select(connection => new PlatformDiagramWorkflowConnection(
                    connection.FromTitle,
                    connection.ToTitle,
                    connection.Label))
                .ToArray()));
        selectedNode = preset.Nodes.FirstOrDefault()?.Title;
        CloseMobilePalette();
        ReplaceRouteContext(preset.LedgerTemplateKey);
    }

    private static int CountPaletteBlocks(string workflowModeKey)
        => PaletteBlocks.Count(block =>
            IsSameKey(block.WorkflowModeKey, PlatformDiagramPaletteStateService.CommonWorkflowModeKey) ||
            IsSameKey(block.WorkflowModeKey, workflowModeKey));

    private static IReadOnlyList<PaletteBlockSectionItem> BuildPaletteSections(
        LedgerPaletteGroupItem group,
        string? filter)
    {
        var sections = new List<PaletteBlockSectionItem>();
        var commonBlocks = PaletteBlocks
            .Where(block => IsSameKey(block.WorkflowModeKey, PlatformDiagramPaletteStateService.CommonWorkflowModeKey))
            .Where(block => MatchesPaletteFilter(block, filter))
            .ToArray();
        if (commonBlocks.Length > 0)
        {
            sections.Add(new("공통 노드", commonBlocks));
        }

        var ledgerBlocks = PaletteBlocks
            .Where(block => IsSameKey(block.WorkflowModeKey, group.WorkflowModeKey))
            .Where(block => MatchesPaletteFilter(block, filter))
            .ToArray();
        if (ledgerBlocks.Length > 0)
        {
            sections.Add(new($"{group.Title} 노드", ledgerBlocks));
        }

        return sections;
    }

    private static bool MatchesPaletteFilter(PaletteBlockItem block, string? filter)
        => string.IsNullOrWhiteSpace(filter)
           || block.Title.Contains(filter, StringComparison.OrdinalIgnoreCase)
           || block.GroupLabel.Contains(filter, StringComparison.OrdinalIgnoreCase)
           || block.Description.Contains(filter, StringComparison.OrdinalIgnoreCase);

    private static bool IsKnownLedgerPaletteGroup(string workflowModeKey)
        => LedgerPaletteGroups.Any(group => IsSameKey(group.WorkflowModeKey, workflowModeKey));

    private static PaletteBlockItem FindPaletteBlock(string workflowModeKey, string key)
        => PaletteBlocks.First(block =>
            IsSameKey(block.WorkflowModeKey, workflowModeKey) &&
            IsSameKey(block.Key, key));

    private static PlatformDiagramPaletteBlock ToDiagramPaletteBlock(PaletteBlockItem block)
        => new(
            block.Key,
            block.Title,
            block.GroupLabel,
            block.Description,
            block.Kind,
            block.FormKind);

    private string BuildLedgerPaletteGroupClass(LedgerPaletteGroupItem group)
    {
        var selected = IsSameKey(group.WorkflowModeKey, ActiveLedgerPaletteGroup.WorkflowModeKey)
            ? " platform-ledger-palette-group--selected"
            : string.Empty;

        return $"platform-ledger-palette-group{selected}";
    }

    private static string BuildPaletteItemClass(PaletteBlockItem block)
        => $"platform-block-palette-item platform-block-palette-item--{block.Kind}";

    private void HandlePaletteChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DiagramPalette.Changed -= HandlePaletteChanged;
        DiagramPalette.SetDiagramMode(false);
    }

    private void OpenMobilePalette()
        => isMobilePaletteOpen = true;

    private void CloseMobilePalette()
        => isMobilePaletteOpen = false;

    private void UpdatePaletteFilter(string? value)
    {
        paletteFilter = value?.Trim() ?? string.Empty;
        ReplaceRouteContext();
    }

    private void ZoomIn()
    {
        diagramZoomPercent = CommunityDiagramNavigationContext.NormalizeZoom(diagramZoomPercent + 10);
        ReplaceRouteContext();
    }

    private void ZoomOut()
    {
        diagramZoomPercent = CommunityDiagramNavigationContext.NormalizeZoom(diagramZoomPercent - 10);
        ReplaceRouteContext();
    }

    private void HandleSelectedNodeChanged(string? nodeTitle)
    {
        selectedNode = string.IsNullOrWhiteSpace(nodeTitle) ? null : nodeTitle.Trim();
        ReplaceRouteContext();
    }

    private void ReplaceRouteContext(string? ledgerTemplateKey = null)
    {
        var target = CommunityPageRoutes.DiagramFor(
            ledgerTemplateKey ?? ActiveLedgerTemplate.Key,
            selectedNode,
            diagramZoomPercent,
            paletteFilter,
            normalizedReturnPath);
        var current = $"/{Navigation.ToBaseRelativePath(Navigation.Uri)}";
        if (!string.Equals(current, target, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(target, replace: true);
        }
    }

    private static bool IsSameKey(string left, string right)
        => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private static string 원장처리체계표시명(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "처리 체계";
        }

        return value.Trim().Replace(" OS", " 처리 체계", StringComparison.OrdinalIgnoreCase);
    }

