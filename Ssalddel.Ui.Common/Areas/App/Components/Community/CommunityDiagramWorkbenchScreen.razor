        string WorkflowModeKey,
        string LedgerTemplateKey,
        string Title,
        string Description);

    private sealed record PaletteBlockSectionItem(
        string Title,
        IReadOnlyList<PaletteBlockItem> Blocks);

    private sealed record WorkflowPresetItem(
        string WorkflowModeKey,
        string Key,
        string Title,
        string? LedgerTemplateKey,
        IReadOnlyList<PaletteBlockItem> Nodes,
        IReadOnlyList<WorkflowPresetConnectionItem> Connections);

    private sealed record WorkflowPresetConnectionItem(
        string FromTitle,
        string ToTitle,
        string Label);

    private sealed record PaletteBlockItem(
        string WorkflowModeKey,
        string Key,
        string Title,
        string GroupLabel,
        string Description,
        string Kind,
        string Icon,
        Color Color,
        string? FormKind = null);
