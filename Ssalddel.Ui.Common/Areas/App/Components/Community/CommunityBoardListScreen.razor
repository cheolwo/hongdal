@namespace Ssalddel.Ui.Common.Areas.App.Components.Community
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inherits MvvmComponentBase<CommunityBoardPageViewModel>
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PlatformCommunityReadingThemeFrame>
<main class="community-board-page platform-home--classic-forum"
      data-board-key="@ViewModel.CurrentBoard?.BoardKey"
      data-search="@ViewModel.SearchText"
      data-filter="@ViewModel.SelectedFilter"
      data-view="@ViewModeCode"
      data-focus="@normalizedFocusTarget">
    <header class="community-board-page__header">
        <a href="@BackHref">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            @BackLabel
        </a>
        <div>
            <span>COMMUNITY BOARD</span>
            <h1>@ViewModel.CurrentBoardName</h1>
            <p>@ViewModel.CurrentBoardDescription</p>
        </div>
        @if (ViewModel.CanCompose)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="OpenCompose">
                글쓰기
            </MudButton>
        }
    </header>

    <nav class="community-board-page__navigation" aria-label="게시판 선택">
        @foreach (var board in ViewModel.VisibleBoardTabs)
        {
            <a class="@BuildBoardLinkClass(board.BoardKey)"
               href="@BoardHref(board.BoardKey)">
                <span>@board.DisplayName</span>
                <b>@board.PostCount</b>
            </a>
        }
    </nav>

    @if (RelatedPeriodicDataBoards.Count > 0)
    {
        <section class="community-board-page__data-guides"
                 data-periodic-data-guides="true"
                 aria-label="관련 주기성 데이터 대표 안내">
            <div class="community-board-page__data-guides-heading">
                <span>대표 안내</span>
                <strong>관련 주기성 데이터</strong>
                <p>원천 글은 전용 게시판에 한 번만 저장합니다. 아래 안내를 따라 최신 누적 자료를 확인하세요.</p>
            </div>
            <div class="community-board-page__data-guide-grid">
                @foreach (var dataBoard in RelatedPeriodicDataBoards)
                {
                    <a class="community-board-page__data-guide"
                       data-periodic-data-board="@dataBoard.BoardKey"
                       href="@PeriodicDataBoardHref(dataBoard.BoardKey)">
                        <span>@dataBoard.Provider</span>
                        <strong>@dataBoard.RepresentativeTitle</strong>
                        <p>@dataBoard.RepresentativeSummary</p>
                        <b>
                            주기성 데이터 보기
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </b>
                    </a>
                }
            </div>
        </section>
    }

    @if (ShowsImportedFoodCountryFilters)
    {
        <section class="community-board-page__country-filter"
                 data-country-filter="imported-food"
                 aria-label="수입식품 국가별 보기">
            <div class="community-board-page__country-filter-copy">
                <strong>수입식품 국가별 보기</strong>
                <span>제조업소 소재 근거를 중국과 미국으로 나눠 봅니다.</span>
            </div>
            <nav class="community-board-page__country-filter-options">
                <a class="@BuildCountryFilterLinkClass(null)"
                   aria-current="@(IsCountryFilterSelected(null) ? "page" : null)"
                   href="@ImportedFoodCountryHref(null)">
                    전체 정보
                </a>
                @foreach (var country in CommunityImportedFoodCountryFilterCatalog.All)
                {
                    <a class="@BuildCountryFilterLinkClass(country.WorkflowTag)"
                       data-country-code="@country.CountryCode"
                       aria-current="@(IsCountryFilterSelected(country.WorkflowTag) ? "page" : null)"
                       href="@ImportedFoodCountryHref(country.WorkflowTag)">
                        @country.DisplayName
                    </a>
                }
            </nav>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(WorkflowTag) || !string.IsNullOrWhiteSpace(RoleTag))
    {
        <div class="community-board-page__filters" aria-label="적용된 업무 필터">
            <span>적용된 필터</span>
            @if (!string.IsNullOrWhiteSpace(WorkflowTag))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@DisplayWorkflowFilter(WorkflowTag)</MudChip>
            }
            @if (!string.IsNullOrWhiteSpace(RoleTag))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">@RoleTag</MudChip>
            }
            <MudButton Href="@BoardHref(ViewModel.CurrentBoard?.BoardKey)" Variant="Variant.Text" Size="Size.Small">필터 지우기</MudButton>
        </div>
    }

    @if (ShowsPeriodicTopicFilters)
    {
        <section class="community-board-page__periodic-topic"
                 data-periodic-topic-filter="true"
                 aria-label="게시판 주제분류">
            <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" />
            <div>
                <strong>주제분류 · 주기성</strong>
                <span>`전체글`은 서버 정기 자료를 포함하고, `일반글`은 정기 자료를 숨기며, `주기성`은 정기 자료만 보여줍니다.</span>
            </div>
        </section>
    }

    @if (ViewModel.IsLoading)
    {
        <div class="community-board-page__state" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <span>글 목록을 불러오는 중입니다.</span>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <section class="community-board-page__error" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Color="Color.Error" />
                <div>
                    <strong>새 글을 불러오지 못했습니다.</strong>
                    <span>@ViewModel.ErrorMessage 기존 게시판 구조는 계속 사용할 수 있습니다.</span>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@ViewModel.IsLoading"
                           OnClick="ReloadAsync">
                    재시도
                </MudButton>
            </section>
        }

        <PlatformCommunityPostList BoardName="@ViewModel.CurrentBoardName"
                                   FilterOptions="@ListFilters"
                                   SelectedFilter="@ViewModel.SelectedFilter"
                                   SelectedFilterChanged="HandleListFilterChanged"
                                   ViewMode="@ViewModel.ViewMode"
                                   ViewModeChanged="HandleViewModeChanged"
                                   ComposeRequested="OpenCompose"
                                   Posts="@ViewModel.VisiblePosts"
                                   SeedPosts="@NoSeedPosts"
                                   VisiblePostCount="@ViewModel.VisiblePosts.Count"
                                   SelectedPostId="@FocusedPostId"
                                   PostSelected="OpenPost"
                                   DeleteRequested="BeginDeleteAsync"
                                   SearchText="@ViewModel.SearchText"
                                   SearchTextChanged="HandleSearchChanged" />

        @if (ViewModel.Result.Page > 1 || ViewModel.Result.Page * ViewModel.Result.PageSize < ViewModel.Result.TotalCount)
        {
            <nav class="community-board-page__pagination" aria-label="글 목록 페이지">
                <MudButton Disabled="@(ViewModel.Result.Page <= 1)"
                           Href="@PageHref(ViewModel.Result.Page - 1)"
                           Variant="Variant.Outlined">
                    이전
                </MudButton>
                <span>@ViewModel.Result.Page / @ViewModel.TotalPages</span>
                <MudButton Disabled="@(ViewModel.Result.Page >= ViewModel.TotalPages)"
                           Href="@PageHref(ViewModel.Result.Page + 1)"
                           Variant="Variant.Outlined">
                    다음
                </MudButton>
            </nav>
        }
    }
</main>
</PlatformCommunityReadingThemeFrame>

@code {
    [Parameter] public string AppKey { get; set; } = "shipper";
    [Parameter] public string BackHref { get; set; } = CommunityPageRoutes.Home;
    [Parameter] public string BackLabel { get; set; } = "공개 커뮤니티";
    [Parameter] public string? BoardKey { get; set; }
    [Parameter] public string? BoardName { get; set; }
    [Parameter] public string? WorkflowTag { get; set; }
    [Parameter] public string? RoleTag { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public string? SearchText { get; set; }
    [Parameter] public string? ListFilter { get; set; }
    [Parameter] public string? ViewMode { get; set; }
    [Parameter] public string? FocusTarget { get; set; }

    private static readonly IReadOnlyList<string> GeneralListFilters = ["전체글", "공지", "추천글"];
    private static readonly IReadOnlyList<string> WorkBoardListFilters =
    [
        "전체글",
        CommunityPeriodicPostTopicCatalog.GeneralListFilter,
        CommunityPeriodicPostTopicCatalog.PeriodicListFilter,
        "공지",
        "추천글"
    ];
    private static readonly IReadOnlyList<CommunitySeedPost> NoSeedPosts = [];
    private string? lastDataRequestKey;
    private string? normalizedFocusTarget;
    private string? pendingFocusTarget;
    private string? scrolledFocusTarget;
    private IJSObjectReference? navigationModule;

    private long? FocusedPostId
        => CommunityBoardNavigationContext.PostIdFromFocus(normalizedFocusTarget);

    private string ViewModeCode
        => ViewModel.ViewMode == CommunityPostViewMode.Cards
            ? CommunityBoardNavigationContext.CardViewMode
            : CommunityBoardNavigationContext.ListViewMode;

    private bool ShowsImportedFoodCountryFilters
        => string.Equals(
            ViewModel.CurrentBoard?.BoardKey,
            CommunityBoardKeys.PeriodicDataMfds,
            StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<CommunityPeriodicDataBoardDefinition> RelatedPeriodicDataBoards
        => CommunityPeriodicDataBoardCatalog.ForRelatedBoard(
            ViewModel.CurrentBoard?.BoardKey ?? BoardKey ?? BoardName);

    private bool ShowsPeriodicTopicFilters
        => CommunityPeriodicPostTopicCatalog.SupportsBoard(
            ViewModel.CurrentBoard?.BoardKey ?? BoardKey ?? BoardName);

    private IReadOnlyList<string> ListFilters
        => ShowsPeriodicTopicFilters ? WorkBoardListFilters : GeneralListFilters;

    protected override async Task OnParametersSetAsync()
    {
        ViewModel.Configure(AppKey);
        normalizedFocusTarget = PageNavigationContext.NormalizeFocusTarget(FocusTarget);
        var request = CurrentRequest();
        var periodicVisibility = CommunityPeriodicPostTopicCatalog.SupportsBoard(
            request.BoardKey ?? request.LegacyBoardName)
            ? CommunityPeriodicPostTopicCatalog.VisibilityFor(request.ListFilter)
            : CommunityPeriodicPostVisibilityModes.All;
        var dataRequestKey =
            $"{request.BoardKey}|{request.LegacyBoardName}|{request.WorkflowTag}|{request.RoleTag}|{periodicVisibility}|{request.Page}";
        if (!string.Equals(lastDataRequestKey, dataRequestKey, StringComparison.Ordinal))
        {
            lastDataRequestKey = dataRequestKey;
            await ViewModel.LoadAsync(request);
        }
        else
        {
            ViewModel.RestoreListState(request.SearchText, request.ListFilter, request.ViewMode);
        }

        if (!string.Equals(scrolledFocusTarget, normalizedFocusTarget, StringComparison.Ordinal))
        {
            pendingFocusTarget = normalizedFocusTarget;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ViewModel.IsLoading || string.IsNullOrWhiteSpace(pendingFocusTarget))
        {
            return;
        }

        navigationModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Ssalddel.Ui.Common/js/pageNavigation.js");
        var target = pendingFocusTarget;
        pendingFocusTarget = null;
        if (await navigationModule.InvokeAsync<bool>("scrollToFocusTarget", target))
        {
            scrolledFocusTarget = target;
        }
    }

    private Task ReloadAsync()
        => ViewModel.LoadAsync(CurrentRequest());

    private CommunityBoardPageRequest CurrentRequest()
        => new(
            BoardKey,
            BoardName,
            WorkflowTag,
            RoleTag,
            CommunityBoardNavigationContext.NormalizePage(Page),
            SearchText,
            ListFilter,
            ViewMode);

    private void OpenPost(PlatformCommunityPostResponse post)
    {
        var returnPath = CurrentBoardPath(CommunityBoardNavigationContext.FocusForPost(post.Id));
        Navigation.NavigateTo(
            CommunityPageRoutes.PostDetailFor(
                post.Id,
                ViewModel.CurrentBoard is null ? post.Category : null,
                ViewModel.CurrentBoard?.BoardKey,
                returnPath));
    }

    private async Task BeginDeleteAsync(PlatformCommunityPostResponse post)
    {
        if (!post.CanDelete)
        {
            Snackbar.Add("관리자나 원작성자만 이 글을 삭제할 수 있습니다.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(PlatformCommunityPostDeleteDialog.PostTitle)] = post.Title,
            [nameof(PlatformCommunityPostDeleteDialog.RequiresPassword)] = post.DeleteRequiresPassword
        };
        var dialog = await DialogService.ShowAsync<PlatformCommunityPostDeleteDialog>(
            "게시글 삭제",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            });
        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled)
        {
            return;
        }

        try
        {
            await ViewModel.DeletePostAsync(post.Id, dialogResult.Data as string);
            Snackbar.Add("게시글을 삭제했습니다.", Severity.Success);
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private void OpenCompose()
        => Navigation.NavigateTo(
            CommunityPageRoutes.ComposeFor(
                ViewModel.CurrentBoard?.DisplayName,
                ViewModel.CurrentBoard?.BoardKey,
                CurrentBoardPath()));

    private void HandleListFilterChanged(string value)
    {
        ViewModel.SelectListFilter(value);
        normalizedFocusTarget = null;
        Navigation.NavigateTo(CurrentBoardPath(page: 1), replace: true);
    }

    private void HandleViewModeChanged(CommunityPostViewMode value)
    {
        ViewModel.SelectViewMode(value);
        ReplaceRouteState();
    }

    private void HandleSearchChanged(string value)
    {
        ViewModel.SetSearchText(value);
        ReplaceRouteState();
    }

    private void ReplaceRouteState()
    {
        normalizedFocusTarget = null;
        Navigation.NavigateTo(CurrentBoardPath(), replace: true);
    }

    private string BuildBoardLinkClass(string? boardKey)
        => string.Equals(ViewModel.CurrentBoard?.BoardKey, boardKey, StringComparison.OrdinalIgnoreCase)
            || (ViewModel.CurrentBoard is null && boardKey is null)
                ? "community-board-page__board-link community-board-page__board-link--active"
                : "community-board-page__board-link";

    private static string BoardHref(string? boardKey)
        => CommunityPageRoutes.BoardsFor(boardKey: boardKey);

    private static string PeriodicDataBoardHref(string boardKey)
        => CommunityPageRoutes.BoardsFor(
            boardKey: boardKey,
            listFilter: CommunityPeriodicPostTopicCatalog.PeriodicListFilter);

    private string ImportedFoodCountryHref(string? workflowTag)
        => CommunityPageRoutes.BoardsFor(
            ViewModel.CurrentBoard is null ? BoardName : null,
            ViewModel.CurrentBoard?.BoardKey ?? BoardKey,
            workflowTag,
            RoleTag,
            page: 1,
            search: ViewModel.SearchText,
            listFilter: ViewModel.SelectedFilter,
            viewMode: ViewModeCode);

    private bool IsCountryFilterSelected(string? workflowTag)
        => string.IsNullOrWhiteSpace(workflowTag)
            ? string.IsNullOrWhiteSpace(WorkflowTag)
            : string.Equals(
                WorkflowTag?.Trim(),
                workflowTag,
                StringComparison.OrdinalIgnoreCase);

    private string BuildCountryFilterLinkClass(string? workflowTag)
        => IsCountryFilterSelected(workflowTag)
            ? "community-board-page__country-filter-link community-board-page__country-filter-link--active"
            : "community-board-page__country-filter-link";

    private static string DisplayWorkflowFilter(string workflowTag)
    {
        var country = CommunityImportedFoodCountryFilterCatalog.FindByWorkflowTag(workflowTag);
        return country is null ? workflowTag : $"수입식품 · {country.DisplayName}";
    }

    private string PageHref(int page)
        => CurrentBoardPath(page: page);

    private string CurrentBoardPath(string? focusTarget = null, int? page = null)
        => CommunityPageRoutes.BoardsFor(
            ViewModel.CurrentBoard is null ? BoardName : null,
            ViewModel.CurrentBoard?.BoardKey ?? BoardKey,
            WorkflowTag,
            RoleTag,
            page ?? CommunityBoardNavigationContext.NormalizePage(Page),
            ViewModel.SearchText,
            ViewModel.SelectedFilter,
            ViewModeCode,
            focusTarget);

    public async ValueTask DisposeAsync()
    {
        if (navigationModule is not null)
        {
            try
            {
                await navigationModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 앱 또는 브라우저 종료 중에는 JS 정리 실패를 무시합니다.
            }
        }

        Dispose();
    }
}
