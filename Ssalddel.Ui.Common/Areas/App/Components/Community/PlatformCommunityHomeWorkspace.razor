@namespace Ssalddel.Ui.Common.Areas.App.Components.Community

<MudItem xs="12" Class="platform-community-secondary-flow">
    <MudStack Spacing="2">
        @if (Surface is CommunityWorkspaceSurfaceKind.Full or CommunityWorkspaceSurfaceKind.BoardManagement)
        {
            <section class="platform-community-workspace-section">
                <PlatformCommunityBoardManagementPanel IsLoading="@Context.IsBoardLoading"
                                                       IsSaving="@Context.IsSavingBoardRequest"
                                                       CanManage="@Context.CanManagePosts"
                                                       ApprovedBoards="@Context.ApprovedBoards"
                                                       PendingBoards="@Context.PendingBoards"
                                                       Form="@Context.BoardForm"
                                                       ReviewMemos="@Context.BoardReviewMemos"
                                                       BoardSelected="@Context.SelectBoard"
                                                       SaveRequested="@Context.SaveBoardRequestAsync"
                                                       ApproveRequested="@Context.ApproveBoardAsync"
                                                       RejectRequested="@Context.RejectBoardAsync" />
            </section>
        }

        @if (Surface is CommunityWorkspaceSurfaceKind.Full or CommunityWorkspaceSurfaceKind.Hub)
        {
            <section class="platform-community-workspace-section">
                <PlatformCommunityWorkspaceHub Workspaces="@Context.Workspaces"
                                               LedgerDraftRequested="@Context.PrepareLedgerDraft" />
            </section>
        }

        @if (Surface is CommunityWorkspaceSurfaceKind.Full or CommunityWorkspaceSurfaceKind.LedgerDraft)
        {
            <PlatformCommunityHomeLedgerDraft Context="@Context.LedgerDraft" />
        }

        @if (Surface == CommunityWorkspaceSurfaceKind.Full)
        {
            <PlatformCommunityHomeComposer Context="@Context" />
        }

        @if (Surface is CommunityWorkspaceSurfaceKind.Full or CommunityWorkspaceSurfaceKind.Hub)
        {
            <section class="platform-community-workspace-section">
                <PlatformCommunitySupportPanels QuickActions="@Context.QuickActions"
                                                OperatingNotes="@Context.OperatingNotes" />
            </section>
        }
    </MudStack>
</MudItem>

@code {
    [Parameter, EditorRequired]
    public PlatformCommunityHome.WorkspaceSurface Context { get; set; } = null!;

    [Parameter]
    public CommunityWorkspaceSurfaceKind Surface { get; set; }
        = CommunityWorkspaceSurfaceKind.Full;
}
