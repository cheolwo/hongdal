@namespace Ssalddel.Ui.Common.Areas.App.Components.Community

<PlatformCommunityHome @key="ScreenKey"
                       AppName="@AppName"
                       RoleLabel="@RoleLabel"
                       AppKey="@AppKey"
                       UseDedicatedCommunityRoutes="true"
                       WorkspaceOnly="true"
                       WorkspaceSection="CommunityWorkspaceSurfaceKind.LedgerDraft"
                       QueryLedgerTemplateKey="@LedgerTemplateKey" />

@code {
    [Parameter] public string AppName { get; set; } = "살뜰";
    [Parameter] public string RoleLabel { get; set; } = "사용자";
    [Parameter] public string AppKey { get; set; } = "shipper";
    [Parameter] public string? LedgerTemplateKey { get; set; }

    private string ScreenKey => $"ledger-draft-{LedgerTemplateKey}";
}
