@namespace Ssalddel.Ui.Common.Areas.App.Components.Community

<PlatformCommunityPostComposer ViewModel="@Context.Composer"
                               BoardCategories="@Context.BoardCategories"
                               RoleTags="@Context.RoleTags"
                               SelectedWorkClassification="@Context.SelectedWorkClassification"
                               SelectedWorkFeatureEnabled="@Context.SelectedWorkFeatureEnabled"
                               LedgerPickerLoading="@Context.IsLedgerPickerLoading"
                               ExternalStatusMessage="@Context.StatusMessage"
                               ExternalStatusSeverity="@Context.StatusSeverity"
                               LedgerPickerRequested="@Context.OpenLedgerPickerAsync"
                               EvidenceToolsRequested="@Context.OpenEvidenceChart"
                               AuthoringToolVisible="@Context.IsEvidenceChartOpen"
                               Closed="@Context.CloseComposer"
                               CancelEditRequested="@Context.CancelEdit"
                               Saved="@Context.HandleSavedAsync">
    <LedgerSettings>
        <PlatformCommunityLedgerComposerSettings SelectedLedgerId="@Context.SelectedLedgerId"
                                                  Ledgers="@Context.Ledgers"
                                                  SharingSettings="@Context.SharingSettings"
                                                  IsPickerLoading="@Context.IsLedgerPickerLoading"
                                                  IsSharingSettingsSaving="@Context.IsLedgerSharingSaving"
                                                  PickerRequested="@Context.OpenLedgerPickerAsync"
                                                  SharingSettingsRequested="@Context.OpenLedgerSharingSettingsAsync"
                                                  ClearRequested="@Context.ClearSelectedLedger"
                                                  CloseSharingSettingsRequested="@Context.CloseLedgerSharingSettings"
                                                  SaveSharingSettingsRequested="@Context.SaveLedgerSharingSettingsAsync" />
    </LedgerSettings>
    <AuthoringTool>
        @if (Context.IsEvidenceChartOpen)
        {
            <CommunityAuthoringEvidenceChartTool ViewModel="@Context.EvidenceChart"
                                                  CloseRequested="@Context.CloseEvidenceChart"
                                                  ApplyToDraftRequested="@Context.ApplyEvidenceChart" />
        }
    </AuthoringTool>
</PlatformCommunityPostComposer>

@code {
    [Parameter, EditorRequired]
    public PlatformCommunityHome.WorkspaceSurface Context { get; set; } = null!;
}
