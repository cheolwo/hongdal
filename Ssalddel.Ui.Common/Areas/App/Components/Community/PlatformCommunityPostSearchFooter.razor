@using Ssalddel.Contracts.Common.Localization
@namespace Ssalddel.Ui.Common.Areas.App.Components.Community

<footer class="platform-community-forum-footer">
    <label>
        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
        <input type="search"
               aria-label="@UiText("게시글 검색", "Search posts")"
               placeholder="@UiText("제목, 내용, 작성자 검색", "Search title, content or author")"
               value="@SearchText"
               @oninput="HandleSearchInput" />
        @if (!string.IsNullOrWhiteSpace(SearchText))
        {
            <button type="button"
                    title="@UiText("검색어 지우기", "Clear search")"
                    aria-label="@UiText("검색어 지우기", "Clear search")"
                    @onclick="ClearSearchAsync">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>
        }
    </label>
    <span>@UiText("게시글 제목을 누르면 본문과 업무 흐름을 확인할 수 있습니다.", "Select a post title to read the original content and its workflow.")</span>
</footer>

@code {
    [Parameter]
    public string DisplayLanguageCode { get; set; } = DisplayLanguageCodes.Korean;

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    private string UiText(string korean, string english)
        => PlatformCommunityPostListPresentation.UiText(DisplayLanguageCode, korean, english);

    private Task HandleSearchInput(ChangeEventArgs args)
        => SearchTextChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private Task ClearSearchAsync()
        => SearchTextChanged.InvokeAsync(string.Empty);
}
