@if (IsLoading)
{
    <div class="group-purchase-empty group-purchase-empty--detail">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Typo="Typo.body2">선택한 공동구매를 불러오는 중입니다.</MudText>
    </div>
}
else if (HasError)
{
    <div class="group-purchase-empty group-purchase-empty--detail">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" />
        <MudText Typo="Typo.h6">공동구매 상세를 불러오지 못했습니다.</MudText>
        <MudText Typo="Typo.body2">@ErrorMessage</MudText>
        @if (RequestedCampaignId is Guid retryCampaignId)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="@(() => RetryRequested.InvokeAsync(retryCampaignId))">
                다시 시도
            </MudButton>
        }
    </div>
}
else if (IsNotFound)
{
    <div class="group-purchase-empty group-purchase-empty--detail">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
        <MudText Typo="Typo.h6">공개된 공동구매를 찾을 수 없습니다.</MudText>
        <MudText Typo="Typo.body2">주소의 campaignId를 확인하거나 목록에서 다른 모집을 선택해 주세요.</MudText>
    </div>
}
else if (Campaign is null)
{
    <div class="group-purchase-empty group-purchase-empty--detail">
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Large" />
        <MudText Typo="Typo.h6">공동구매를 선택해 절차를 확인하세요.</MudText>
        <MudText Typo="Typo.body2">각 단계에서 참여, 이의제기, 검토와 서명을 이어갈 수 있습니다.</MudText>
    </div>
}
else if (ChildContent is not null)
{
    @ChildContent(Campaign)
}

@code {
    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool HasError { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool IsNotFound { get; set; }

    [Parameter]
    public Guid? RequestedCampaignId { get; set; }

    [Parameter]
    public CommunityVoteResponse? Campaign { get; set; }

    [Parameter]
    public EventCallback<Guid> RetryRequested { get; set; }

    [Parameter]
    public RenderFragment<CommunityVoteResponse>? ChildContent { get; set; }
}
