@namespace Ssalddel.Ui.Common.Areas.App.Components.Community
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inject Ssalddel.Ui.Common.Areas.App.Services.ISsalddelAccessTokenProvider AccessTokenProvider

@if (Post.Attachments.Count > 0)
{
    <section class="platform-community-attachments" aria-label="게시글 첨부 이미지">
        @foreach (var attachment in Post.Attachments)
        {
            var isCommentPanelExpanded = IsAttachmentCommentExpanded(attachment.Id);

            <div class="platform-community-attachment-item">
                <button type="button"
                        class="platform-community-attachment-image-button"
                        aria-expanded="@isCommentPanelExpanded"
                        aria-controls="@GetCommentPanelId(attachment.Id)"
                        aria-label="@GetImageToggleLabel(attachment.OriginalFileName, attachment.CommentCount, isCommentPanelExpanded)"
                        @onclick="@(() => ToggleAttachmentComment(attachment.Id))">
                    <img src="@attachment.Url" alt="@attachment.OriginalFileName" loading="lazy" />
                </button>

                <div class="platform-community-attachment-meta">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        사진 댓글 @attachment.CommentCount · @(isCommentPanelExpanded ? "댓글 입력 닫기" : "이미지를 눌러 댓글 남기기")
                    </MudText>
                    <a class="platform-community-attachment-original-link"
                       href="@attachment.Url"
                       target="_blank"
                       rel="noopener noreferrer">
                        원본 이미지 보기
                    </a>
                </div>

                @if (attachment.RecentComments.Count > 0)
                {
                    <MudStack Spacing="1" Class="platform-community-comments">
                        @foreach (var comment in attachment.RecentComments)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                <SsalddelCommunityRoleProfileBadge DisplayName="@DisplayCommentNickname(comment.Nickname)"
                                                                  ContextKey="@Post.AppKey"
                                                                  Category="@Post.Category"
                                                                  IsMasked="@IsReportPost"
                                                                  Compact="true" />
                                <MudText Typo="Typo.caption">@comment.Body</MudText>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="@(() => ReportAttachmentCommentAsync(comment.Id))">
                                    신고
                                </MudButton>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteAttachmentCommentAsync(attachment.Id, comment.Id))">
                                    삭제
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                }

                @if (isCommentPanelExpanded)
                {
                    var attachmentCommentForm = ViewModel.GetAttachmentCommentForm(attachment.Id);

                    <div id="@GetCommentPanelId(attachment.Id)"
                         class="platform-community-attachment-comment-panel">
                        <MudStack Spacing="1" Class="platform-community-image-comment-form">
                            @if (UsesAutomaticAnonymousNickname)
                            {
                                <MudTextField T="string" Label="자동 익명 닉네임" Value="@AutomaticAnonymousNicknameDisplay" ReadOnly="true" Margin="Margin.Dense" />
                            }
                            else
                            {
                                <MudTextField T="string" Placeholder="닉네임" @bind-Value="attachmentCommentForm.Nickname" Immediate="true" MaxLength="40" Margin="Margin.Dense" />
                            }
                            <MudTextField T="string" Placeholder="비밀번호" @bind-Value="attachmentCommentForm.Password" InputType="InputType.Password" Immediate="true" MaxLength="100" Margin="Margin.Dense" />
                            <MudTextField T="string" Placeholder="사진 댓글" @bind-Value="attachmentCommentForm.Body" Immediate="true" MaxLength="1000" Margin="Margin.Dense" />
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => SaveAttachmentCommentAsync(attachment.Id))">
                                댓글 등록
                            </MudButton>
                        </MudStack>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public PlatformCommunityPostResponse Post { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlatformCommunityPostEngagementViewModel ViewModel { get; set; } = null!;

    [Parameter]
    public EventCallback<PlatformCommunityCommandResult> CommandCompleted { get; set; }

    private long? _expandedAttachmentId;

    private bool IsReportPost
        => Post.IsReportBoardPost
           || Post.Category.Contains("신고", StringComparison.OrdinalIgnoreCase)
           || Post.Category.Contains("분쟁", StringComparison.OrdinalIgnoreCase);

    private bool UsesAutomaticAnonymousNickname
        => CommunityBoardCatalog.Find(Post.Category)?.AllowsAnonymousPosting == true
           && string.IsNullOrWhiteSpace(AccessTokenProvider.AccessToken);

    private string AutomaticAnonymousNicknameDisplay
        => CommunityAnonymousNicknameCatalog.Preview(Post.Category);

    private string DisplayCommentNickname(string nickname)
        => IsReportPost ? "익명 참여자" : nickname;

    protected override void OnParametersSet()
    {
        if (_expandedAttachmentId is long attachmentId
            && Post.Attachments.All(attachment => attachment.Id != attachmentId))
        {
            _expandedAttachmentId = null;
        }
    }

    private bool IsAttachmentCommentExpanded(long attachmentId)
        => _expandedAttachmentId == attachmentId;

    private void ToggleAttachmentComment(long attachmentId)
        => _expandedAttachmentId = _expandedAttachmentId == attachmentId
            ? null
            : attachmentId;

    private static string GetCommentPanelId(long attachmentId)
        => $"attachment-comment-panel-{attachmentId}";

    private static string GetImageToggleLabel(
        string originalFileName,
        int commentCount,
        bool isExpanded)
        => $"{originalFileName}, 사진 댓글 {commentCount}개. 댓글 입력창 {(isExpanded ? "닫기" : "열기")}";

    private async Task SaveAttachmentCommentAsync(long attachmentId)
    {
        if (UsesAutomaticAnonymousNickname)
        {
            ViewModel.GetAttachmentCommentForm(attachmentId).Nickname = AutomaticAnonymousNicknameDisplay;
        }

        await CompleteAsync(await ViewModel.SaveAttachmentCommentAsync(attachmentId));
    }

    private async Task DeleteAttachmentCommentAsync(long attachmentId, long commentId)
        => await CompleteAsync(await ViewModel.DeleteAttachmentCommentAsync(attachmentId, commentId));

    private async Task ReportAttachmentCommentAsync(long commentId)
        => await CompleteAsync(await ViewModel.ReportAttachmentCommentAsync(commentId));

    private async Task CompleteAsync(PlatformCommunityCommandResult result)
        => await CommandCompleted.InvokeAsync(result);
}
