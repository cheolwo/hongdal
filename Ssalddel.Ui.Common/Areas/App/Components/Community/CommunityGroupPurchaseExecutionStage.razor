<div class="group-purchase-execution-stage">
    <MudText Typo="Typo.h6">실행 준비 상태</MudText>
    <div class="group-purchase-execution-status mt-3">
        <div><span>최소 조건</span><strong>@(Campaign.GroupPurchase?.IsMinimumReached == true ? "충족" : "미충족")</strong></div>
        <div><span>전자서명</span><strong>@CommunityGroupPurchasePresentation.SignatureProgress(Campaign)</strong></div>
        <div><span>수요 전달 대기</span><strong>@(Campaign.GroupPurchase?.DemandHandoffPendingCount ?? 0)</strong></div>
        <div><span>전달 실패</span><strong>@(Campaign.GroupPurchase?.DemandHandoffFailedCount ?? 0)</strong></div>
    </div>
    <MudAlert Severity="@CommunityGroupPurchasePresentation.ExecutionSeverity(Campaign)" Dense="true" Class="mt-3">
        @CommunityGroupPurchasePresentation.ExecutionMessage(Campaign)
    </MudAlert>
</div>

@code {
    [Parameter, EditorRequired]
    public CommunityVoteResponse Campaign { get; set; } = new();
}
