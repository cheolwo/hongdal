@namespace Ssalddel.Ui.Common.Areas.App.Components.Community

<section class="community-individual-order" aria-labelledby="community-individual-order-title">
    <div class="community-individual-order__copy">
        <span>0.0 둘러보기 → 0.5 내 주문 → 1.0 함께 주문</span>
        <h2 id="community-individual-order-title">둘러보다 필요해졌다면, 내 주문부터 시작하세요</h2>
        <p>
            커뮤니티의 음식·재료·가격 근거를 먼저 살펴보고 필요한 상품만 내 개별주문 의향으로 남깁니다.
            공동주문 할인 후보에는 별도로 동의한 주문만 연결됩니다.
        </p>
    </div>

    <ol class="community-individual-order__steps" aria-label="커뮤니티에서 공동주문까지의 순서">
        <li><b>0.0</b><span>정보와 이야기 둘러보기</span></li>
        <li><b>0.5</b><span>상품·수량·수령 조건 기록</span></li>
        <li><b>1.0</b><span>동의한 주문끼리 공동 조건 확인</span></li>
        <li><b>효과</b><span>견적이 모이면 예상 절감 근거 확인</span></li>
    </ol>

    <div class="community-individual-order__actions">
        <a class="primary" href="@StartHref">
            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small" />
            개별주문 시작
        </a>
        <a class="secondary" href="@OrdersHref">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
            내 개별주문 보기
        </a>
    </div>

    <aside>
        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
        <span>개별주문 의향은 수정·철회할 수 있으며, 결제·계약·수입·운송을 자동 실행하지 않습니다.</span>
    </aside>
</section>

@code {
    [Parameter]
    public string StartHref { get; set; } = "/information/food-ingredients";

    [Parameter]
    public string OrdersHref { get; set; } = CommunityPageRoutes.IndividualOrders;
}
