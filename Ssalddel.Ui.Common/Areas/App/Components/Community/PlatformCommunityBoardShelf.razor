@namespace Ssalddel.Ui.Common.Areas.App.Components.Community
@using Ssalddel.Contracts.Common.Localization

<section id="community-board-list" class="platform-community-board-shelf" aria-label="@UiText("커뮤니티 게시판 목록", "Community board list")">
    <div class="platform-community-section-heading">
        <div>
            <span>BOARD INDEX</span>
            <strong>@UiText("게시판", "Boards")</strong>
        </div>
        <span>@($"{Items.Count:N0}{UiText("개 게시판", " boards")}")</span>
    </div>
    <div class="platform-community-board-scroll">
        @foreach (var item in Items)
        {
            <button type="button"
                    class="@BuildItemClass(item)"
                    @onclick="@(() => ItemSelected.InvokeAsync(item.Name))">
                <span class="platform-community-board-icon">
                    <MudIcon Icon="@item.Icon" Size="Size.Small" />
                </span>
                <span class="platform-community-board-copy">
                    <strong>@DisplayBoardName(item.Name)</strong>
                    <small>@DisplayBoardDescription(item.Name, item.Description)</small>
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Text"
                             Color="@item.PostingAccessColor">
                        @DisplayAccessLabel(item.PostingAccessLabel)
                    </MudChip>
                </span>
                <span class="platform-community-board-count">@item.PostCount</span>
            </button>
        }
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<CommunityBoardNavigationItem> Items { get; set; } = [];

    [Parameter]
    public EventCallback<string> ItemSelected { get; set; }

    [Parameter]
    public string DisplayLanguageCode { get; set; } = DisplayLanguageCodes.Korean;

    private bool IsKorean
        => DisplayLanguageCodes.Normalize(DisplayLanguageCode) == DisplayLanguageCodes.Korean;

    private string UiText(string korean, string english)
        => DisplayLanguageCodes.Select(DisplayLanguageCode, korean, english);

    private string DisplayBoardName(string name)
        => IsKorean
            ? name
            : name switch
            {
                "공지·안내" => "Notices & Guides",
                "서원·발원" => "Vows & Intentions",
                "자유·생활" => "Life & Community",
                "질문·도움" => "Questions & Help",
                "정보·시세" or "농수산물 가격" => "Agricultural Prices",
                "참여·모집" => "Participation",
                "판매·공급" => "Sales & Supply",
                "원장·진행" => "Ledgers & Progress",
                "완료·후기" => "Results & Reviews",
                "반야" => "Prajna",
                "음식·맛집" => "Food & Places",
                "화물" => "Cargo",
                "전체" => "All boards",
                "시스템 다이어그램" => "System Diagrams",
                "운송 실무" => "Transport Operations",
                "업무 질문" => "Work Questions",
                "업무 기록" => "Work Records",
                "생활 원장" => "Community Ledgers",
                "개선 제안" => "Improvement Proposals",
                "신고/분쟁" => "Reports & Disputes",
                _ => name
            };

    private string DisplayBoardDescription(string name, string description)
        => IsKorean
            ? description
            : name switch
            {
                "서원·발원" => "Share an intention before turning it into a practical commitment.",
                "자유·생활" => "Talk freely about everyday life with neighbors.",
                "질문·도움" => "Ask questions and offer practical help.",
                "정보·시세" or "농수산물 가격" => "Compare agricultural prices with source units and dates.",
                "참여·모집" => "Invite voluntary participation without automatic enrollment.",
                "판매·공급" => "Discuss transparent sales and supply conditions.",
                "원장·진행" => "Review shared ledgers and agreed progress.",
                "완료·후기" => "Record results, costs, lessons and reviews.",
                "공지·안내" => "Read service notices and operating guidance.",
                _ => description
            };

    private string DisplayAccessLabel(string label)
        => IsKorean
            ? label
            : label switch
            {
                "익명 가능" => "Anonymous allowed",
                "로그인" => "Sign-in required",
                "운영자" => "Operators only",
                _ => label
            };

    private static string BuildItemClass(CommunityBoardNavigationItem item)
        => item.IsSelected
            ? "platform-community-board-card platform-community-board-card--selected"
            : "platform-community-board-card";
}
