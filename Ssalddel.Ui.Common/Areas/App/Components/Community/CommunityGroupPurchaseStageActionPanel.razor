<section class="group-purchase-panel">
    @if (!IsAuthenticated && CommunityGroupPurchasePresentation.RequiresAuthenticatedCommand(State.SelectedStageCode))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
            공개 내용은 그대로 볼 수 있습니다. 이 단계의 서버 저장은 로그인 후 이용해 주세요.
            <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">로그인</MudButton>
        </MudAlert>
    }

    @if (State.SelectedStageCode == CommunityGroupPurchasePresentation.StageRecruitment)
    {
        <CommunityGroupPurchaseRecruitmentStage Campaign="@Campaign"
                                                Draft="@State.Participation"
                                                IsAuthenticated="@IsAuthenticated"
                                                IsBusy="@IsBusy"
                                                DemandSubmitted="DemandSubmitted" />
    }
    else if (State.SelectedStageCode == CommunityGroupPurchasePresentation.StageResolution)
    {
        <CommunityGroupPurchaseResolutionStage Campaign="@Campaign"
                                               State="@State"
                                               IsAuthenticated="@IsAuthenticated"
                                               IsBusy="@IsBusy"
                                               CampaignClosed="CampaignClosed"
                                               ResolutionCreated="ResolutionCreated"
                                               ResolutionReadyToSign="ResolutionReadyToSign" />
    }
    else if (State.SelectedStageCode == CommunityGroupPurchasePresentation.StageSignature)
    {
        <CommunityGroupPurchaseSignatureStage Campaign="@Campaign"
                                              State="@State"
                                              IsAuthenticated="@IsAuthenticated"
                                              IsBusy="@IsBusy"
                                              SignatureSubmitted="SignatureSubmitted" />
    }
    else if (State.SelectedStageCode == CommunityGroupPurchasePresentation.StageExecution)
    {
        <CommunityGroupPurchaseExecutionStage Campaign="@Campaign" />
    }
    else
    {
        <CommunityGroupPurchaseProposalStage Campaign="@Campaign" />
    }
</section>

@code {
    [Parameter, EditorRequired]
    public CommunityVoteResponse Campaign { get; set; } = new();

    [Parameter, EditorRequired]
    public CommunityGroupPurchaseWorkspaceState State { get; set; } = new();

    [Parameter]
    public bool IsAuthenticated { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback DemandSubmitted { get; set; }

    [Parameter]
    public EventCallback CampaignClosed { get; set; }

    [Parameter]
    public EventCallback ResolutionCreated { get; set; }

    [Parameter]
    public EventCallback ResolutionReadyToSign { get; set; }

    [Parameter]
    public EventCallback<SsalddelSignatureCaptureResult> SignatureSubmitted { get; set; }
}
