@using Ssalddel.Ui.Common.Areas.App.ViewModels

<div class="group-purchase-workspace">
    <CommunityGroupPurchaseHeader Heading="@SurfaceHeading"
                                  Description="@SurfaceDescription"
                                  BackHref="@BackHref"
                                  BackLabel="@BackLabel"
                                  IsAuthenticated="@IsAuthenticated"
                                  IsBusy="@IsBusy"
                                  ShowRefreshAction="@(Surface != CommunityGroupPurchaseSurfaceKind.Create)"
                                  ShowCreateAction="@(Surface != CommunityGroupPurchaseSurfaceKind.Create)"
                                  StatusMessage="@State.StatusMessage"
                                  StatusSeverity="@State.StatusSeverity"
                                  RefreshRequested="RefreshCurrentSurfaceAsync" />

    @if (Surface == CommunityGroupPurchaseSurfaceKind.List)
    {
        <CommunityGroupPurchaseCampaignList Campaigns="@Campaigns"
                                            IsLoading="@목록ViewModel.처리중"
                                            HasError="@목록ViewModel.오류발생"
                                            ErrorMessage="@목록ViewModel.오류메시지"
                                            RetryRequested="LoadCampaignsAsync"
                                            CampaignSelected="OpenCampaignAsync" />
    }
    else if (Surface == CommunityGroupPurchaseSurfaceKind.Create)
    {
        @if (!IsAuthenticated)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                제안 조건은 미리 작성할 수 있지만 서버 저장은 로그인 후 가능합니다.
                <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">로그인</MudButton>
            </MudAlert>
        }
        <CommunityGroupPurchaseProposalForm Visible="true"
                                            Draft="@State.Proposal"
                                            IngredientSeed="@ActiveIngredientSeed"
                                            CanSubmit="@IsAuthenticated"
                                            IsBusy="@IsBusy"
                                            CloseRequested="CancelCreateAsync"
                                            SubmitRequested="CreateCampaignAsync" />
    }
    else
    {
        <main class="group-purchase-detail">
            <CommunityGroupPurchaseDetailState IsLoading="@상세ViewModel.처리중"
                                               HasError="@상세ViewModel.오류발생"
                                               ErrorMessage="@상세ViewModel.오류메시지"
                                               IsNotFound="@상세ViewModel.찾을수없음"
                                               RequestedCampaignId="@상세ViewModel.요청CampaignId"
                                               Campaign="@SelectedCampaign"
                                               RetryRequested="RetryCampaignAsync">
                <ChildContent Context="campaign">
                    <CommunityGroupPurchaseSummary Campaign="@campaign"
                                                   ObjectionCount="@CommunityGroupPurchasePresentation.ObjectionCount(Comments)" />

                    <CommunityGroupPurchaseProcess Campaign="@campaign"
                                                   Comments="@Comments"
                                                   SelectedStageCode="@ActiveStageCode" />

                    <CommunityGroupPurchaseRouteNavigation CampaignId="@campaign.Id"
                                                           ActiveSurface="@Surface" />

                    @if (RequiresAuthenticatedCommand && !IsAuthenticated)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                            공개 내용은 그대로 볼 수 있습니다. 이 화면의 서버 저장은 로그인 후 이용해 주세요.
                            <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">로그인</MudButton>
                        </MudAlert>
                    }

                    @if (Surface == CommunityGroupPurchaseSurfaceKind.Overview)
                    {
                        <CommunityGroupPurchaseProposalStage Campaign="@campaign" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.Participation)
                    {
                        <CommunityGroupPurchaseRecruitmentStage Campaign="@campaign"
                                                                Draft="@State.Participation"
                                                                IsAuthenticated="@IsAuthenticated"
                                                                IsBusy="@IsBusy"
                                                                DemandSubmitted="CastDemandAsync" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.Suppliers)
                    {
                        <CommunityGroupPurchaseProducerDirectory CampaignId="@campaign.Id"
                                                                 CampaignTitle="@campaign.Title" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.Negotiation)
                    {
                        <CommunityGroupPurchaseNegotiationTimeline CampaignId="@campaign.Id" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.Objections)
                    {
                        <CommunityGroupPurchaseObjectionPanel Campaign="@campaign"
                                                             StageCode="@EffectiveObjectionStageCode"
                                                             Comments="@Comments"
                                                             Draft="@State.Objection"
                                                             IsBusy="@IsBusy"
                                                             ObjectionSubmitted="SubmitObjectionAsync" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.Resolution)
                    {
                        <CommunityGroupPurchaseResolutionStage Campaign="@campaign"
                                                               State="@State"
                                                               IsAuthenticated="@IsAuthenticated"
                                                               IsBusy="@IsBusy"
                                                               CampaignClosed="CloseCampaignAsync"
                                                               ResolutionCreated="CreateResolutionAsync"
                                                               ResolutionReadyToSign="MarkReadyToSignAsync" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.Signature)
                    {
                        <CommunityGroupPurchaseSignatureStage Campaign="@campaign"
                                                              State="@State"
                                                              IsAuthenticated="@IsAuthenticated"
                                                              IsBusy="@IsBusy"
                                                              SignatureSubmitted="SubmitSignatureAsync" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.DeliveryOptions)
                    {
                        <CommunityDriverAvailabilityBoard SourceGroupPurchaseCampaignId="@campaign.Id"
                                                          SourceContextLabel="@campaign.Title"
                                                          SuggestedCargoSummary="@CommunityGroupPurchasePresentation.ProductSummary(campaign)"
                                                          SuggestedQuantitySummary="@CommunityGroupPurchasePresentation.QuantitySummary(campaign)" />
                    }
                    else if (Surface == CommunityGroupPurchaseSurfaceKind.FulfillmentDraft)
                    {
                        <CommunityGroupPurchaseExecutionStage Campaign="@campaign" />
                        <CommunityGroupPurchaseFulfillmentRoutePlanner CampaignId="@campaign.Id"
                                                                      CampaignTitle="@campaign.Title"
                                                                      SuggestedProductSummary="@CommunityGroupPurchasePresentation.ProductSummary(campaign)"
                                                                      SuggestedQuantitySummary="@CommunityGroupPurchasePresentation.QuantitySummary(campaign)"
                                                                      SuggestedPlannedQuantity="@(campaign.GroupPurchase?.TotalRequestedQuantity ?? 0)"
                                                                      SuggestedQuantityUnit="@(campaign.GroupPurchase?.QuantityUnit ?? "개")"
                                                                      SuggestedDestinationLabel="@CommunityGroupPurchasePresentation.DestinationLabel(campaign)" />
                    }
                </ChildContent>
            </CommunityGroupPurchaseDetailState>
        </main>
    }
</div>
