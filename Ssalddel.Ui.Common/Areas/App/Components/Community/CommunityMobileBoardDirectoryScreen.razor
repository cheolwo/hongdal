@namespace Ssalddel.Ui.Common.Areas.App.Components.Community
@inherits MvvmComponentBase<CommunityMobileBoardDirectoryViewModel>

<main class="community-mobile-directory" data-community-mode="life">
    <header class="community-mobile-directory__heading">
        <div>
            <span>공개 커뮤니티 · 01A.01</span>
            <h1>게시판 모음</h1>
            <p>서원과 생활 이야기, 지역 문화, 농수산물 가격을 간결하게 둘러봅니다.</p>
        </div>
    </header>

    <label class="community-mobile-directory__search">
        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
        <input type="search"
               aria-label="게시판 이름 또는 관심 주제 검색"
               placeholder="게시판 이름 또는 관심 주제 검색"
               value="@ViewModel.SearchText"
               @oninput="HandleSearchInput" />
    </label>

    @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
    {
        <section class="community-mobile-directory__status" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" />
            <span>@ViewModel.StatusMessage</span>
            <button type="button" disabled="@ViewModel.IsLoading" @onclick="ReloadAsync">재시도</button>
        </section>
    }

    <section class="community-mobile-directory__section" aria-labelledby="life-board-heading">
            <header>
                <div>
                    <h2 id="life-board-heading">생활 게시판</h2>
                    <span>@(ViewModel.VisibleLifeBoards.Count)개 게시판</span>
                </div>
            </header>

            @if (ViewModel.VisibleLifeBoards.Count == 0)
            {
                <CommunityMobileDirectoryEmptyState />
            }
            else
            {
                <div class="community-mobile-directory__board-list">
                    @foreach (var board in ViewModel.VisibleLifeBoards)
                    {
                        <a href="@CommunityPageRoutes.BoardsFor(boardKey: board.BoardKey)"
                           class="community-mobile-directory__board">
                            <span class="@($"community-mobile-directory__board-icon community-mobile-directory__board-icon--{board.Tone}")">
                                <MudIcon Icon="@board.Icon" Size="Size.Small" />
                            </span>
                            <span>
                                <strong>@board.DisplayName</strong>
                                <small>@board.Description</small>
                            </span>
                            @if (ViewModel.HasLivePostCounts)
                            {
                                <b>@ViewModel.PostCountFor(board.BoardKey)</b>
                            }
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </a>
                    }
                </div>
            }

        <aside class="community-mobile-directory__safety">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
            <span>
                <strong>신고·분쟁은 안전센터에서 보호합니다.</strong>
                민감한 내용은 공개 게시판과 분리됩니다.
            </span>
        </aside>
    </section>

</main>

@code {
    [Parameter]
    public bool InitialWorkMode { get; set; }

    [Parameter]
    public string AppKey { get; set; } = "shipper";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel.Configure(AppKey, InitialWorkMode);
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.초기화Async();
    }

    private void HandleSearchInput(ChangeEventArgs args)
        => ViewModel.UpdateSearch(args.Value?.ToString());

    private async Task ReloadAsync()
    {
        await ViewModel.LoadAsync();
    }
}
