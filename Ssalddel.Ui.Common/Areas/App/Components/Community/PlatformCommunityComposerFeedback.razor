@if (!string.IsNullOrWhiteSpace(Status.Message))
{
    <MudAlert Severity="@Status.Severity"
              Dense="true"
              Variant="Variant.Text"
              Class="platform-community-compose-status">
        @Status.Message
    </MudAlert>
}

@if (DiscardConfirmationVisible)
{
    <MudAlert Severity="Severity.Warning"
              Dense="true"
              Variant="Variant.Outlined"
              Class="platform-community-compose-discard-confirmation">
        <div class="platform-community-compose-discard-confirmation__content">
            <span>현재 작성 내용과 이 브라우저에 저장된 임시 초안을 모두 비웁니다.</span>
            <span class="platform-community-compose-discard-confirmation__actions">
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           OnClick="CancelDiscardRequested">
                    계속 작성
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="ConfirmDiscardRequested">
                    비우기
                </MudButton>
            </span>
        </div>
    </MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public PlatformCommunityComposerStatus Status { get; set; } = default!;

    [Parameter]
    public bool DiscardConfirmationVisible { get; set; }

    [Parameter]
    public EventCallback CancelDiscardRequested { get; set; }

    [Parameter]
    public EventCallback ConfirmDiscardRequested { get; set; }
}
