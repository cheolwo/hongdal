@namespace Ssalddel.Ui.Common.Areas.App.Components.Inputs

@if (IsOpen)
{
    <div class="ssalddel-action-sheet-backdrop"
         role="presentation"
         @onclick="CancelAsync">
        <section class="ssalddel-action-sheet"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleAriaId"
                 aria-describedby="@DescriptionAriaId"
                 tabindex="-1"
                 @onkeydown="HandleKeyDownAsync"
                 @onclick:stopPropagation="true">
            <div class="ssalddel-action-sheet__group">
                @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description))
                {
                    <header class="ssalddel-action-sheet__header">
                        @if (!string.IsNullOrWhiteSpace(Title))
                        {
                            <h2 id="@TitleId">@Title</h2>
                        }
                        @if (!string.IsNullOrWhiteSpace(Description))
                        {
                            <p id="@DescriptionId">@Description</p>
                        }
                    </header>
                }

                @foreach (var action in Actions)
                {
                    <button type="button"
                            class="@ActionClass(action)"
                            disabled="@action.IsDisabled"
                            @onclick="() => SelectAsync(action)">
                        @action.Label
                    </button>
                }
            </div>

            <button type="button"
                    class="ssalddel-action-sheet__cancel"
                    @onclick="CancelAsync">
                @CancelLabel
            </button>
        </section>
    </div>
}

@code {
    private readonly string _instanceId = Guid.NewGuid().ToString("N");

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public IReadOnlyList<SsalddelActionSheetAction> Actions { get; set; } = [];

    [Parameter]
    public string CancelLabel { get; set; } = "취소";

    [Parameter]
    public EventCallback<SsalddelActionSheetAction> OnActionSelected { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string TitleId => $"ssalddel-action-sheet-title-{_instanceId}";

    private string DescriptionId => $"ssalddel-action-sheet-description-{_instanceId}";

    private string? TitleAriaId => string.IsNullOrWhiteSpace(Title) ? null : TitleId;

    private string? DescriptionAriaId => string.IsNullOrWhiteSpace(Description) ? null : DescriptionId;

    private static string ActionClass(SsalddelActionSheetAction action)
        => action.Style == SsalddelActionSheetActionStyle.Destructive
            ? "ssalddel-action-sheet__action ssalddel-action-sheet__action--destructive"
            : "ssalddel-action-sheet__action";

    private Task SelectAsync(SsalddelActionSheetAction action)
        => action.IsDisabled ? Task.CompletedTask : OnActionSelected.InvokeAsync(action);

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
        => args.Key == "Escape" ? CancelAsync() : Task.CompletedTask;
}
