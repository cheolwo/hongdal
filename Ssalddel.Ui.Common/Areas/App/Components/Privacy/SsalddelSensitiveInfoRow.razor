@namespace Ssalddel.Ui.Common.Areas.App.Components.Privacy

<div class="ssalddel-sensitive-info-row">
    <span>@Label</span>
    <strong>@Value</strong>
</div>

<style>
    .ssalddel-sensitive-info-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding: 7px 0;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .ssalddel-sensitive-info-row:last-child {
        border-bottom: 0;
    }

    .ssalddel-sensitive-info-row span {
        flex: 0 0 96px;
        color: var(--mud-palette-text-secondary);
        font-size: 0.875rem;
    }

    .ssalddel-sensitive-info-row strong {
        flex: 1 1 auto;
        text-align: right;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 520px) {
        .ssalddel-sensitive-info-row {
            display: block;
        }

        .ssalddel-sensitive-info-row span,
        .ssalddel-sensitive-info-row strong {
            display: block;
            text-align: left;
        }
    }
</style>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = "-";
}
