@using Ssalddel.Contracts.Common.Inventory
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inherits MvvmComponentBase<출고인계준비PageViewModel>

<MudStack Spacing="3" Class="handoff-workspace">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.LocalShipping">
        <MudText Typo="Typo.subtitle2">포장된 공동 물품을 출고예정 원장의 인계 준비 상태로 연결합니다.</MudText>
        <MudText Typo="Typo.body2">포장 근거와 전체 가용수량을 확인한 뒤 같은 입고상품 ID에 출고예정 한 건만 기록합니다.</MudText>
    </MudAlert>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Science">
        <MudText Typo="Typo.subtitle2">Simulation 인계 준비 경계</MudText>
        <MudText Typo="Typo.body2">출고예정 원장만 준비합니다. 재고 예약·차감, 하차지·차량 확정, 운송의뢰·배차·결제·정산은 실행하지 않습니다.</MudText>
    </MudAlert>
    <MudPaper Class="pa-4" Elevation="0" Outlined="true"><MudGrid>
        <MudItem xs="12" md="6"><MudTextField T="string" Label="상품·SKU·주문 참조·보관 위치 검색" Value="@ViewModel.목록.검색어" ValueChanged="SetSearch" OnKeyDown="SearchKeyDownAsync" Immediate="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Disabled="@ViewModel.처리중" /></MudItem>
        <MudItem xs="12" sm="7" md="3"><MudSelect T="string" Label="인계 준비 상태" Value="@ViewModel.목록.조회상태" ValueChanged="StatusChangedAsync" Variant="Variant.Outlined" Disabled="@ViewModel.처리중">@foreach(var status in ViewModel.목록.조회상태목록){<MudSelectItem T="string" Value="@status">@status</MudSelectItem>}</MudSelect></MudItem>
        <MudItem xs="12" sm="5" md="3"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@ViewModel.처리중" OnClick="SearchAsync">서버 인계 목록 조회</MudButton></MudItem>
    </MudGrid></MudPaper>
    @if(ViewModel.목록.오류발생){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.목록.오류메시지</MudAlert>}
    <MudGrid>
        <MudItem xs="12" lg="5"><MudPaper Class="pa-4 handoff-panel" Elevation="0" Outlined="true"><MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"><MudStack Spacing="0"><MudText Typo="Typo.h6">출고 인계 대상</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">서버 조회 @ViewModel.목록.응답.TotalCount.ToString("N0")건</MudText></MudStack>@if(ViewModel.목록.처리중){<MudProgressCircular Indeterminate="true" Size="Size.Small" />}</MudStack>
            @if(ViewModel.목록.비어있음){<div class="handoff-empty"><MudIcon Icon="@Icons.Material.Filled.Outbox" Size="Size.Large" Color="Color.Secondary" /><MudText Typo="Typo.subtitle1">조건에 맞는 인계 작업이 없습니다.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">포장 완료 재고가 없으면 샘플 항목을 표시하지 않습니다.</MudText></div>}
            else{<div class="handoff-list">@foreach(var item in ViewModel.목록.항목목록){<button type="button" class="handoff-item @(ViewModel.상세.조회대상Id==item.InboundItemId?"is-selected":null)" disabled="@ViewModel.처리중" @onclick="@(()=>SelectAsync(item.InboundItemId))"><span class="handoff-title-row"><span class="handoff-title">@Display(item.ProductName)</span><span class="handoff-status">@(item.IsHandoffReady?"인계 준비 완료":"인계 준비 대기")</span></span><span class="handoff-meta">@Display(item.Sku) · @Display(item.WarehouseName)</span><span class="handoff-meta">@Display(item.PackagingType) · @item.HandoffQuantity.ToString("N0")개 · @Display(item.StorageLocation)</span><span class="handoff-meta">@FormatDateTime(item.UpdatedAtUtc)</span></button>}</div>}
            <MudStack Row="true" Justify="Justify.SpaceBetween"><MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.이전페이지있음||ViewModel.처리중)" OnClick="PreviousAsync">이전</MudButton><MudText Typo="Typo.caption">@(ViewModel.목록.응답.Page+1)페이지</MudText><MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.다음페이지있음||ViewModel.처리중)" OnClick="NextAsync">다음</MudButton></MudStack>
        </MudStack></MudPaper></MudItem>
        <MudItem xs="12" lg="7"><MudPaper Class="pa-4 handoff-panel" Elevation="0" Outlined="true">
            @if(ViewModel.상세.처리중){<div class="handoff-empty"><MudProgressCircular Indeterminate="true" /><MudText>같은 입고상품 ID를 확인하고 있습니다.</MudText></div>}
            else if(ViewModel.상세.오류발생){<div class="handoff-empty"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" /><MudText>@ViewModel.상세.오류메시지</MudText></div>}
            else if(ViewModel.상세.대상없음){<div class="handoff-empty"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Warning" Size="Size.Large" /><MudText Typo="Typo.subtitle1">인계 준비 대상을 찾을 수 없습니다.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">다른 작업으로 자동 대체하지 않습니다.</MudText><MudButton Variant="Variant.Outlined" OnClick="ClearAsync">선택 해제</MudButton></div>}
            else if(ViewModel.상세.항목 is not{} task){<div class="handoff-empty"><MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" /><MudText Typo="Typo.subtitle1">인계 준비할 포장 재고를 선택해 주세요.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">목록에서 선택한 한 건의 포장 근거만 서버에서 조회합니다.</MudText></div>}
            else{<MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap"><MudStack Spacing="0"><MudText Typo="Typo.h5">@Display(task.ProductName)</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">입고상품 #@task.InboundItemId · @Display(task.Sku)</MudText></MudStack><MudChip T="string" Color="@(task.CanConfirmHandoff?Color.Warning:Color.Success)" Variant="Variant.Outlined">@(task.CanConfirmHandoff?"인계 준비 대기":Display(task.OutboundStatus))</MudChip></MudStack>
                <MudGrid><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="창고" Value="@Display(task.WarehouseName)" /></MudItem><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="보관 조건" Value="@Display(task.StorageCondition)" /></MudItem><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="보관 위치" Value="@Display(task.StorageLocation)" /></MudItem><MudItem xs="4"><SsalddelSensitiveInfoRow Label="가용" Value="@($"{task.AvailableQuantity:N0}개")" /></MudItem><MudItem xs="4"><SsalddelSensitiveInfoRow Label="예약" Value="@($"{task.ReservedQuantity:N0}개")" /></MudItem><MudItem xs="4"><SsalddelSensitiveInfoRow Label="불량" Value="@($"{task.DefectiveQuantity:N0}개")" /></MudItem><MudItem xs="12"><SsalddelSensitiveInfoRow Label="주문 참조" Value="@Display(task.OrderReference)" /></MudItem></MudGrid>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined"><MudText Typo="Typo.subtitle2">포장 근거</MudText><MudText Typo="Typo.body2">@Display(task.PackagingType) · @FormatDateTime(task.PackedAtUtc)</MudText><MudText Typo="Typo.caption">@Display(task.PackingMemo)</MudText></MudAlert>
                @if(task.CanConfirmHandoff){<MudTextField T="string" Label="인계 준비 수량 (전체 가용수량)" Value="@ViewModel.작성.인계수량.ToString("N0")" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="개" /><MudTextField T="string" Label="출고 인계 메모 (선택)" Value="@ViewModel.작성.메모" ValueChanged="SetMemo" Variant="Variant.Outlined" Lines="2" MaxLength="400" Immediate="true" Disabled="@ViewModel.처리중" /><div class="handoff-checklist"><MudCheckBox T="bool" Value="@ViewModel.작성.포장봉인확인" ValueChanged="SetPackageSealConfirmed" Label="포장 봉인과 상품·수량 표찰을 확인했습니다." Disabled="@ViewModel.처리중" /><MudCheckBox T="bool" Value="@ViewModel.작성.운송조건확인" ValueChanged="SetTransportConditionsConfirmed" Label="보관 조건을 운송 담당자에게 인계할 준비를 확인했습니다." Disabled="@ViewModel.처리중" /></div><MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Outbox" Disabled="@(!ViewModel.작성.완료가능||ViewModel.처리중)" OnClick="CompleteAsync">출고 인계 준비 확정</MudButton>}
                else{<MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.TaskAlt"><MudText Typo="Typo.subtitle2">서버 출고예정 원장을 확인했습니다.</MudText><MudText Typo="Typo.body2">출고예정 #@task.OutboundPlanId · @Display(task.OutboundStatus) · @task.AvailableQuantity.ToString("N0")개</MudText><MudText Typo="Typo.caption">운송의뢰 생성에서 하차지·차량·결제 조건을 별도로 확인합니다.</MudText><MudButton Href="@($"/warehouse/general/outbound-plan-review?outboundPlanId={task.OutboundPlanId}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FactCheck">출고예정 운송 전 검토</MudButton></MudAlert>}
                @if(ViewModel.작성.오류발생){<MudAlert Severity="Severity.Error">@ViewModel.작성.오류메시지</MudAlert>}
            </MudStack>}
        </MudPaper></MudItem>
    </MudGrid>
</MudStack>

@code{
    [Parameter]public long? InboundItemId{get;set;} [Parameter]public EventCallback<long?> OnTaskSelected{get;set;} private bool _initialized;private long? _loadedId;
    protected override async Task OnParametersSetAsync(){var id=InboundItemId is>0?InboundItemId:null;if(!_initialized){_initialized=true;_loadedId=id;await ViewModel.초기화Async(id);}else if(id!=_loadedId){_loadedId=id;if(id is>0)await ViewModel.대상선택Async(id.Value);else ViewModel.선택해제();}}
    private void SetSearch(string value)=>ViewModel.목록.검색어=value??string.Empty;private void SetMemo(string value)=>ViewModel.작성.메모=value??string.Empty;private void SetPackageSealConfirmed(bool value)=>ViewModel.작성.포장봉인확인=value;private void SetTransportConditionsConfirmed(bool value)=>ViewModel.작성.운송조건확인=value;
    private async Task SearchKeyDownAsync(KeyboardEventArgs args){if(args.Key is"Enter"or"NumpadEnter")await SearchAsync();}private async Task StatusChangedAsync(string value){ViewModel.목록.조회상태=출고인계준비조회상태코드.Normalize(value);await SearchAsync();}
    private Task SearchAsync()=>ViewModel.검색Async();private Task PreviousAsync()=>ViewModel.목록.이전페이지Async();private Task NextAsync()=>ViewModel.목록.다음페이지Async();private async Task SelectAsync(long id){if(await ViewModel.대상선택Async(id)){_loadedId=id;await OnTaskSelected.InvokeAsync(id);}}private async Task ClearAsync(){ViewModel.선택해제();_loadedId=null;await OnTaskSelected.InvokeAsync(null);}private Task CompleteAsync()=>ViewModel.완료후재조회Async();
    private static string Display(string? value)=>string.IsNullOrWhiteSpace(value)?"-":value;private static string FormatDateTime(DateTime? value)=>value.HasValue?value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"):"-";
}
