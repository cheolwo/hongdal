@using Ssalddel.Contracts.Common.Inventory
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inherits MvvmComponentBase<입고검수PageViewModel>

<MudStack Spacing="3" Class="inbound-inspection-workspace">
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Science">
        <MudText Typo="Typo.subtitle2">Simulation 검수 범위</MudText>
        <ul class="inspection-boundary-list">
            <li>서버에 입고 완료되어 <strong>보관중</strong>인 한 상품의 수량과 불량 수량만 갱신합니다.</li>
            <li>검수 완료는 적재·출고·운송 인계·결제·정산이나 실제 보관 계약을 자동 실행하지 않습니다.</li>
            <li>검수 후에는 응답을 화면에 덮어쓰지 않고 같은 입고상품 ID를 서버에서 다시 조회합니다.</li>
        </ul>
    </MudAlert>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="상품명·SKU·입고상품 ID 검색"
                              Value="@ViewModel.목록.검색어"
                              ValueChanged="SetSearch"
                              OnKeyDown="SearchKeyDownAsync"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Disabled="@ViewModel.처리중" />
            </MudItem>
            <MudItem xs="12" sm="7" md="3">
                <MudSelect T="string"
                           Label="검수 상태"
                           Value="@ViewModel.목록.조회상태"
                           ValueChanged="InspectionStatusChangedAsync"
                           Variant="Variant.Outlined"
                           Disabled="@ViewModel.처리중">
                    @foreach (var status in ViewModel.목록.조회상태목록)
                    {
                        <MudSelectItem T="string" Value="@status">@StatusLabel(status)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="5" md="3">
                <MudButton FullWidth="true"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@ViewModel.처리중"
                           OnClick="SearchAsync">
                    서버 목록 조회
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (ViewModel.상태 is PageViewModel상태.대기 or PageViewModel상태.불러오는중)
    {
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">접근 가능한 입고 검수 대상을 서버에서 조회하고 있습니다.</MudText>
            </MudStack>
        </MudPaper>
    }
    else if (ViewModel.상태 == PageViewModel상태.실패)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText>@ViewModel.오류메시지</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@ViewModel.처리중" OnClick="RetryPageAsync">
                    다시 조회
                </MudButton>
            </MudStack>
        </MudAlert>
    }
    else
    {
        @if (ViewModel.목록.오류발생)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText>@ViewModel.목록.오류메시지</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@ViewModel.처리중" OnClick="SearchAsync">다시 조회</MudButton>
                </MudStack>
            </MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" lg="5">
                <MudPaper Class="pa-4 inspection-panel" Elevation="0" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">검수 대상</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    서버 조회 @ViewModel.목록.응답.TotalCount.ToString("N0")건
                                </MudText>
                            </MudStack>
                            @if (ViewModel.목록.처리중)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                            }
                        </MudStack>

                        @if (ViewModel.목록.비어있음)
                        {
                            <div class="inspection-empty">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.subtitle1">조건에 맞는 검수 대상이 없습니다.</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                    입고 완료로 재고가 생성된 상품만 검수 대기에 나타납니다. 샘플 항목으로 대신 표시하지 않습니다.
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <div class="inspection-target-list">
                                @foreach (var item in ViewModel.목록.항목목록)
                                {
                                    <button type="button"
                                            class="@TargetClass(item.InboundItemId)"
                                            disabled="@ViewModel.처리중"
                                            @onclick="() => SelectTargetAsync(item.InboundItemId)">
                                        <span class="inspection-target-title-row">
                                            <span class="inspection-target-title">@Display(item.ProductName)</span>
                                            <span class="inspection-target-status @StatusClass(item.CanInspect)">@InspectionLabel(item)</span>
                                        </span>
                                        <span class="inspection-target-meta">@Display(item.Sku) · #@item.InboundItemId</span>
                                        <span class="inspection-target-meta">@Display(item.WarehouseName) · 입고 @item.ReceivedQuantity.ToString("N0")개</span>
                                        <span class="inspection-target-meta">@FormatDateTime(item.ReceivedAtUtc)</span>
                                    </button>
                                }
                            </div>
                        }

                        @if (ViewModel.목록.응답.TotalCount > 0)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudButton Variant="Variant.Text"
                                           Disabled="@(!ViewModel.목록.이전페이지있음 || ViewModel.처리중)"
                                           OnClick="PreviousPageAsync">
                                    이전
                                </MudButton>
                                <MudText Typo="Typo.caption">@(ViewModel.목록.응답.Page + 1)페이지</MudText>
                                <MudButton Variant="Variant.Text"
                                           Disabled="@(!ViewModel.목록.다음페이지있음 || ViewModel.처리중)"
                                           OnClick="NextPageAsync">
                                    다음
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudPaper Class="pa-4 inspection-panel" Elevation="0" Outlined="true">
                    @if (ViewModel.상세.처리중)
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">선택한 입고상품을 정확한 ID로 조회하고 있습니다.</MudText>
                        </MudStack>
                    }
                    else if (ViewModel.상세.오류발생)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            <MudStack Spacing="2">
                                <MudText>@ViewModel.상세.오류메시지</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@ViewModel.처리중" OnClick="RetryDetailAsync">같은 ID 다시 조회</MudButton>
                            </MudStack>
                        </MudAlert>
                    }
                    else if (ViewModel.상세.대상없음)
                    {
                        <div class="inspection-empty">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" />
                            <MudText Typo="Typo.subtitle1">검수 대상을 찾을 수 없습니다.</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                주소의 입고상품 ID가 없거나 현재 계정의 창고 범위 밖입니다. 다른 상품으로 자동 대체하지 않습니다.
                            </MudText>
                            <MudButton Variant="Variant.Outlined" Disabled="@ViewModel.처리중" OnClick="ClearSelectionAsync">선택 해제</MudButton>
                        </div>
                    }
                    else if (ViewModel.상세.항목 is not { } selected)
                    {
                        <div class="inspection-empty">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Color="Color.Secondary" />
                            <MudText Typo="Typo.subtitle1">검수할 상품을 선택해 주세요.</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                목록에서 한 건을 선택할 때만 정확한 상세와 검수 입력을 표시합니다.
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h5">@Display(selected.ProductName)</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Display(selected.Sku) · 입고상품 #@selected.InboundItemId</MudText>
                                </MudStack>
                                <MudChip T="string" Color="@StatusColor(selected.CanInspect)" Variant="Variant.Filled" Size="Size.Small">
                                    @(selected.CanInspect ? "검수 대기" : selected.InventoryStatus)
                                </MudChip>
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="창고" Value="@Display(selected.WarehouseName)" /></MudItem>
                                <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="입고 요청" Value="@($"#{selected.InboundId}")" /></MudItem>
                                <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="입고 수량" Value="@($"{selected.ReceivedQuantity:N0}개")" /></MudItem>
                                <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="현재 가용" Value="@($"{selected.AvailableQuantity:N0}개")" /></MudItem>
                                <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="현재 불량" Value="@($"{selected.DefectiveQuantity:N0}개")" /></MudItem>
                                <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="보관 조건" Value="@Display(selected.StorageCondition)" /></MudItem>
                                <MudItem xs="12" sm="6"><SsalddelSensitiveInfoRow Label="공급처" Value="@Display(selected.SupplierName)" /></MudItem>
                                <MudItem xs="12" sm="6"><SsalddelSensitiveInfoRow Label="보관 위치" Value="@Display(selected.StorageLocation)" /></MudItem>
                            </MudGrid>

                            @if (selected.CanInspect)
                            {
                                <MudDivider />
                                <MudText Typo="Typo.h6">검수 결과 입력</MudText>
                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int"
                                                         Label="실제 검수 수량"
                                                         Value="@ViewModel.작성.검수수량"
                                                         ValueChanged="SetInspectedQuantity"
                                                         Min="1"
                                                         Max="100000"
                                                         Variant="Variant.Outlined"
                                                         Disabled="@ViewModel.처리중" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int"
                                                         Label="불량 수량"
                                                         Value="@ViewModel.작성.불량수량"
                                                         ValueChanged="SetDefectiveQuantity"
                                                         Min="0"
                                                         Max="@Math.Max(0, ViewModel.작성.검수수량)"
                                                         Variant="Variant.Outlined"
                                                         Disabled="@ViewModel.처리중" />
                                    </MudItem>
                                </MudGrid>

                                <div class="inspection-checklist">
                                    <MudCheckBox T="bool" Value="@ViewModel.작성.수량대조확인" ValueChanged="SetQuantityChecked" Label="입고 예정 또는 인계 기록과 실제 수량을 대조했습니다." Disabled="@ViewModel.처리중" />
                                    <MudCheckBox T="bool" Value="@ViewModel.작성.포장파손확인" ValueChanged="SetPackagingChecked" Label="포장 파손·누락·오염 여부를 확인했습니다." Disabled="@ViewModel.처리중" />
                                    <MudCheckBox T="bool" Value="@ViewModel.작성.품질기한확인" ValueChanged="SetQualityChecked" Label="해당 상품의 품질·유통기한 또는 사용기한을 확인했습니다." Disabled="@ViewModel.처리중" />
                                    <MudCheckBox T="bool" Value="@ViewModel.작성.보관조건확인" ValueChanged="SetStorageChecked" Label="표시된 보관 조건과 현재 상태를 확인했습니다." Disabled="@ViewModel.처리중" />
                                </div>

                                <MudTextField T="string"
                                              Label="검수 메모 (선택)"
                                              Value="@ViewModel.작성.검수메모"
                                              ValueChanged="SetInspectionMemo"
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              MaxLength="400"
                                              Counter="400"
                                              Immediate="true"
                                              Disabled="@ViewModel.처리중" />

                                @if (ViewModel.작성.오류발생)
                                {
                                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.작성.오류메시지</MudAlert>
                                }

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.FactCheck"
                                           Disabled="@(!ViewModel.작성.제출가능 || ViewModel.처리중)"
                                           OnClick="SubmitInspectionAsync">
                                    검수 결과 저장
                                </MudButton>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.TaskAlt">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle2">서버 검수 완료 상태를 다시 확인했습니다.</MudText>
                                        <MudText Typo="Typo.body2">완료 시각: @FormatDateTime(selected.InspectedAtUtc)</MudText>
                                        <MudText Typo="Typo.body2">검수 기록: @Display(selected.InspectionMemo)</MudText>
                                        <MudText Typo="Typo.caption">적재나 출고는 별도 페이지의 서버 상태 전이로 진행합니다.</MudText>
                                    </MudStack>
                                </MudAlert>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    [Parameter] public long? InboundItemId { get; set; }
    [Parameter] public EventCallback<long?> OnInboundItemSelected { get; set; }

    private bool _initialized;
    private long? _loadedInboundItemId;

    protected override async Task OnParametersSetAsync()
    {
        var normalizedId = InboundItemId is > 0 ? InboundItemId : null;
        if (!_initialized)
        {
            _initialized = true;
            _loadedInboundItemId = normalizedId;
            await ViewModel.초기화Async(normalizedId);
            return;
        }

        if (normalizedId == _loadedInboundItemId)
        {
            return;
        }

        _loadedInboundItemId = normalizedId;
        await ViewModel.경로대상변경Async(normalizedId);
    }

    private void SetSearch(string value) => ViewModel.목록.검색어 = value ?? string.Empty;
    private void SetInspectedQuantity(int value) => ViewModel.작성.검수수량 = value;
    private void SetDefectiveQuantity(int value) => ViewModel.작성.불량수량 = value;
    private void SetInspectionMemo(string value) => ViewModel.작성.검수메모 = value ?? string.Empty;
    private void SetQuantityChecked(bool value) => ViewModel.작성.수량대조확인 = value;
    private void SetPackagingChecked(bool value) => ViewModel.작성.포장파손확인 = value;
    private void SetQualityChecked(bool value) => ViewModel.작성.품질기한확인 = value;
    private void SetStorageChecked(bool value) => ViewModel.작성.보관조건확인 = value;

    private async Task SearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await SearchAsync();
        }
    }

    private async Task InspectionStatusChangedAsync(string value)
    {
        ViewModel.목록.조회상태 = 입고검수조회상태코드.Normalize(value);
        await SearchAsync();
    }

    private async Task RetryPageAsync() => await ViewModel.새로고침Async();
    private async Task SearchAsync() => await ViewModel.검색Async();
    private async Task PreviousPageAsync() => await ViewModel.목록.이전페이지Async();
    private async Task NextPageAsync() => await ViewModel.목록.다음페이지Async();

    private async Task RetryDetailAsync()
    {
        if (ViewModel.상세.조회대상Id is { } id)
        {
            await ViewModel.대상선택Async(id);
        }
    }

    private async Task SelectTargetAsync(long inboundItemId)
    {
        if (!await ViewModel.대상선택Async(inboundItemId))
        {
            return;
        }

        _loadedInboundItemId = inboundItemId;
        await OnInboundItemSelected.InvokeAsync(inboundItemId);
    }

    private async Task ClearSelectionAsync()
    {
        ViewModel.선택해제();
        _loadedInboundItemId = null;
        await OnInboundItemSelected.InvokeAsync(null);
    }

    private async Task SubmitInspectionAsync()
    {
        if (!await ViewModel.검수후재조회Async())
        {
            return;
        }

        if (ViewModel.상세.항목 is { } item)
        {
            _loadedInboundItemId = item.InboundItemId;
            await OnInboundItemSelected.InvokeAsync(item.InboundItemId);
        }
    }

    private string TargetClass(long inboundItemId)
        => ViewModel.상세.조회대상Id == inboundItemId
            ? "inspection-target is-selected"
            : "inspection-target";

    private static string StatusClass(bool canInspect) => canInspect ? "is-pending" : "is-complete";
    private static Color StatusColor(bool canInspect) => canInspect ? Color.Warning : Color.Success;
    private static string InspectionLabel(입고검수대상목록항목응답 item)
        => item.CanInspect ? "검수 대기" : item.InventoryStatus;
    private static string StatusLabel(string status)
        => status == 입고검수조회상태코드.대기 ? "검수 대기" : status == 입고검수조회상태코드.완료 ? "검수 완료" : "전체";
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? $"{value.Value.ToLocalTime():yyyy-MM-dd HH:mm} (기기 시각)" : "-";
}
