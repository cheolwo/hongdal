@using Ssalddel.Contracts.Mart
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<MudStack Spacing="3" data-testid="ssalddel-mart-picking-packing-workflow">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">영속 주문 피킹/포장 조회</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                현재 계정이 담당하거나 접근할 수 있는 창고의 마트 주문과 피킹·포장 작업만 표시합니다.
            </MudText>
        </MudStack>
        <MudButton Href="@WorkBoardUrl"
                   Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.ViewKanban">
            작업 보드
        </MudButton>
    </MudStack>

    <MudPaper Class="pa-3" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Wrap="Wrap.Wrap">
            <MudTextField T="string"
                          Label="주문·상품·SKU 검색"
                          Placeholder="주문 참조번호 또는 상품명"
                          @bind-Value="Model.목록.검색어"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="min-width: 240px; flex: 1 1 320px;" />
            <MudSelect T="string"
                       Label="작업 상태"
                       @bind-Value="Model.목록.작업상태"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="min-width: 160px;">
                <MudSelectItem T="string" Value="@string.Empty">전체 상태</MudSelectItem>
                <MudSelectItem T="string" Value="@마트피킹작업상태코드.대기">대기</MudSelectItem>
                <MudSelectItem T="string" Value="@마트피킹작업상태코드.진행중">진행 중</MudSelectItem>
                <MudSelectItem T="string" Value="@마트피킹작업상태코드.완료">완료</MudSelectItem>
                <MudSelectItem T="string" Value="@마트피킹작업상태코드.취소">취소</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@Model.목록.처리중"
                       OnClick="SearchAsync"
                       StartIcon="@Icons.Material.Filled.Search">
                조회
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@(!Model.목록.검색조건사용중 || Model.목록.처리중)"
                       OnClick="ResetFiltersAsync">
                조건 초기화
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudGrid>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">전체 검색 결과</MudText>
                <MudText Typo="Typo.h5">@($"{Model.목록.전체건수:N0}건")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">서버 페이징 기준</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">현재 페이지 작업</MudText>
                <MudText Typo="Typo.h5">@($"{CurrentPageTaskCount:N0}건")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">접근 가능한 작업만</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">현재 페이지 완료</MudText>
                <MudText Typo="Typo.h5">@($"{CurrentPageCompletedTaskCount:N0}건")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Success">서버 완료 상태 기준</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">상태 변경</MudText>
                <MudText Typo="Typo.h5">없음</MudText>
                <MudText Typo="Typo.caption" Color="Color.Info">Beta · ReadOnly</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (Model.목록.처리중)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" />
    }
    else if (!string.IsNullOrWhiteSpace(Model.목록.오류메시지))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText>@Model.목록.오류메시지</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RefreshListAsync">다시 조회</MudButton>
            </MudStack>
        </MudAlert>
    }
    else if (!Model.목록.초기화됨)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">마트 피킹 주문 목록을 준비하고 있습니다.</MudAlert>
    }
    else if (Model.목록.결과없음)
    {
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">조회 가능한 피킹 주문이 없습니다.</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    현재 계정의 창고 범위에 작업이 없거나 검색 조건과 일치하지 않습니다.
                </MudText>
                @if (Model.목록.검색조건사용중)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ResetFiltersAsync">전체 조건으로 다시 조회</MudButton>
                }
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" lg="4">
                <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">마트 주문</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @($"{Model.목록.전체건수:N0}건")
                            </MudChip>
                        </MudStack>

                        @foreach (var order in Model.목록.주문목록)
                        {
                            <MudPaper Class="@OrderPanelClass(order)"
                                      Elevation="0"
                                      Outlined="true"
                                      data-testid="@($"mart-order-{order.주문Id}")">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle2">@ValueOrFallback(order.주문참조번호)</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @WarehouseSummary(order.창고목록)
                                            </MudText>
                                        </MudStack>
                                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(order.주문상태)" Variant="Variant.Outlined">
                                            @ValueOrFallback(order.현재단계 ?? order.주문상태)
                                        </MudChip>
                                    </MudStack>

                                    <MudText Typo="Typo.body2">
                                        상품 @(order.상품종류수)종 · 주문 @order.주문수량.ToString("N0")개 · 작업 @(order.작업수)건
                                    </MudText>
                                    <MudProgressLinear Color="@ProgressColor(order)" Value="@Progress(order)" Rounded="true" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        완료 @order.완료작업수 / @order.작업수 · @DateTimeText(order.최근수정일시Utc)
                                    </MudText>

                                    <MudButton FullWidth="true"
                                               Variant="@(IsSelected(order) ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => SelectOrderAsync(order.주문Id))">
                                        정확한 주문 상세 열기
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        }

                        @if (Model.목록.총페이지수 > 1)
                        {
                            <MudPagination Count="@Model.목록.총페이지수"
                                           Selected="@Model.목록.현재페이지"
                                           SelectedChanged="ChangePageAsync"
                                           Color="Color.Primary"
                                           Size="Size.Small" />
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudPaper Class="pa-4 h-100" Elevation="0" Outlined="true">
                    @if (!Model.상세.요청OrderId.HasValue)
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Color="Color.Secondary" />
                            <MudText Typo="Typo.h6">확인할 주문을 선택해 주세요.</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                목록의 주문 ID를 그대로 서버에 요청하며 다른 주문이나 첫 주문으로 대체하지 않습니다.
                            </MudText>
                        </MudStack>
                    }
                    else if (Model.상세.처리중)
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">주문 #@Model.상세.요청OrderId 상세를 조회하고 있습니다.</MudText>
                        </MudStack>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.상세.오류메시지))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText>@Model.상세.오류메시지</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RetryDetailAsync">상세 다시 조회</MudButton>
                            </MudStack>
                        </MudAlert>
                    }
                    else if (Model.상세.찾을수없음)
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" />
                            <MudText Typo="Typo.h6">마트 주문을 찾을 수 없습니다.</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                주문 #@Model.상세.요청OrderId 이(가) 없거나 현재 계정의 창고 조회 범위에 없습니다.
                            </MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearSelectionAsync">목록으로 돌아가기</MudButton>
                        </MudStack>
                    }
                    else if (Model.상세.상세 is { } detail)
                    {
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">@ValueOrFallback(detail.주문참조번호)</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        주문 #@detail.주문Id · 수정 @DateTimeText(detail.수정일시Utc)
                                    </MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudChip T="string" Color="@StatusColor(detail.주문상태)" Variant="Variant.Outlined">
                                        @ValueOrFallback(detail.현재단계 ?? detail.주문상태)
                                    </MudChip>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Color="Color.Default"
                                                   OnClick="ClearSelectionAsync"
                                                   aria-label="주문 상세 닫기" />
                                </MudStack>
                            </MudStack>

                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Visibility">
                                서버 원본을 읽는 Beta/ReadOnly 상세입니다. 피킹 수량·포장·출고 상태를 이 화면에서 변경하지 않습니다.
                            </MudAlert>

                            <MudGrid>
                                <MudItem xs="6" md="3">
                                    <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">주문 상품</MudText>
                                        <MudText Typo="Typo.h6">@($"{detail.상품목록.Count}종")</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">피킹 작업</MudText>
                                        <MudText Typo="Typo.h6">@($"{detail.작업목록.Count(task => task.작업유형 == "피킹")}건")</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">포장 작업</MudText>
                                        <MudText Typo="Typo.h6">@($"{detail.작업목록.Count(task => task.작업유형 == "포장")}건")</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="6" md="3">
                                    <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">완료 작업</MudText>
                                        <MudText Typo="Typo.h6">@($"{detail.작업목록.Count(task => task.상태 == 마트피킹작업상태코드.완료)}건")</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            <MudText Typo="Typo.subtitle1">주문 상품</MudText>
                            <MudTable Items="detail.상품목록" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>상품</MudTh>
                                    <MudTh>SKU</MudTh>
                                    <MudTh>수량</MudTh>
                                    <MudTh>상태</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="상품">@context.상품명</MudTd>
                                    <MudTd DataLabel="SKU">@ValueOrFallback(context.SKU)</MudTd>
                                    <MudTd DataLabel="수량">@context.수량.ToString("N0")개</MudTd>
                                    <MudTd DataLabel="상태">@ValueOrFallback(context.상태)</MudTd>
                                </RowTemplate>
                            </MudTable>

                            <MudText Typo="Typo.subtitle1">접근 가능한 피킹·포장 작업</MudText>
                            @if (detail.작업목록.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">이 주문에 조회 가능한 작업이 없습니다.</MudAlert>
                            }
                            else
                            {
                                <MudTable Items="detail.작업목록" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                    <HeaderContent>
                                        <MudTh>작업</MudTh>
                                        <MudTh>상품</MudTh>
                                        <MudTh>창고·위치</MudTh>
                                        <MudTh>담당</MudTh>
                                        <MudTh>상태</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="작업">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2">@context.작업유형 · @context.처리방식</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.작업Key</MudText>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="상품">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2">@context.상품명</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.SKU · @context.수량.ToString("N0")개</MudText>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="창고·위치">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2">@ValueOrFallback(context.창고명)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@LocationText(context)</MudText>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="담당">@ValueOrFallback(context.작업자표시명)</MudTd>
                                        <MudTd DataLabel="상태">
                                            <MudChip T="string" Size="Size.Small" Color="@TaskStatusColor(context.상태)" Variant="Variant.Outlined">
                                                @ValueOrFallback(context.상태)
                                            </MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public 마트피킹작업PageViewModel Model { get; set; } = default!;

    [Parameter]
    public string WorkBoardUrl { get; set; } = "/warehouse/mart/work-board";

    [Parameter]
    public EventCallback<long?> OnOrderSelected { get; set; }

    private int CurrentPageTaskCount => Model.목록.주문목록.Sum(order => order.작업수);
    private int CurrentPageCompletedTaskCount => Model.목록.주문목록.Sum(order => order.완료작업수);

    private Task SearchAsync() => Model.목록.조회Async();
    private Task ResetFiltersAsync() => Model.목록.조건초기화후조회Async();
    private Task RefreshListAsync() => Model.목록.새로고침Async();
    private Task ChangePageAsync(int page) => Model.목록.페이지조회Async(page);
    private Task SelectOrderAsync(long orderId) => OnOrderSelected.InvokeAsync(orderId);
    private Task ClearSelectionAsync() => OnOrderSelected.InvokeAsync(null);

    private Task RetryDetailAsync()
        => Model.상세.요청OrderId is > 0
            ? Model.상세.조회Async(Model.상세.요청OrderId.Value)
            : Task.CompletedTask;

    private bool IsSelected(마트피킹주문요약응답 order)
        => Model.상세.요청OrderId == order.주문Id;

    private string OrderPanelClass(마트피킹주문요약응답 order)
        => IsSelected(order) ? "pa-3 mud-theme-primary" : "pa-3";

    private static double Progress(마트피킹주문요약응답 order)
        => order.작업수 <= 0 ? 0 : Math.Clamp(order.완료작업수 * 100d / order.작업수, 0, 100);

    private static Color ProgressColor(마트피킹주문요약응답 order)
        => order.작업수 > 0 && order.완료작업수 == order.작업수 ? Color.Success : Color.Primary;

    private static Color StatusColor(string? status)
        => status switch
        {
            "완료" or "출고 완료" => Color.Success,
            "취소" => Color.Error,
            "출고 예정" => Color.Warning,
            _ => Color.Info
        };

    private static Color TaskStatusColor(string? status)
        => status switch
        {
            마트피킹작업상태코드.완료 => Color.Success,
            마트피킹작업상태코드.진행중 => Color.Info,
            마트피킹작업상태코드.취소 => Color.Error,
            _ => Color.Warning
        };

    private static string WarehouseSummary(IReadOnlyList<string> warehouses)
        => warehouses.Count == 0 ? "창고 연결 정보 없음" : string.Join(" · ", warehouses);

    private static string LocationText(마트피킹작업응답 task)
    {
        var values = new[] { task.적재대코드, task.보관위치코드 }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .ToArray();
        return values.Length == 0 ? $"창고 #{task.창고Id}" : string.Join(" · ", values);
    }

    private static string DateTimeText(DateTime value)
        => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string ValueOrFallback(string? value)
        => string.IsNullOrWhiteSpace(value) ? "정보 없음" : value.Trim();
}
