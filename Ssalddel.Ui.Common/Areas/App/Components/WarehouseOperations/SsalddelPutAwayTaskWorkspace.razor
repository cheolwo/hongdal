@using Ssalddel.Contracts.Common.Inventory
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inherits MvvmComponentBase<적재작업PageViewModel>

<MudStack Spacing="3" Class="put-away-workspace">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Hub">
        <MudText Typo="Typo.subtitle2">검수된 공동 물품을 확인된 보관 위치로 연결합니다.</MudText>
        <MudText Typo="Typo.body2">검수 결과와 주문 참조를 유지한 채 위치 표찰을 확인하고, 결과는 재고 현황과 후속 원장 문맥에서 같은 입고상품 ID로 읽습니다.</MudText>
    </MudAlert>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Science">
        <MudText Typo="Typo.subtitle2">Simulation 적재 경계</MudText>
        <MudText Typo="Typo.body2">검수 완료 재고 한 건의 보관 위치만 확정합니다. 위치 이동·재고 차감·판매·출고·운송·결제·정산은 자동 실행하지 않습니다.</MudText>
    </MudAlert>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField T="string" Label="상품·SKU·주문 참조·보관 위치 검색" Value="@ViewModel.목록.검색어" ValueChanged="SetSearch" OnKeyDown="SearchKeyDownAsync" Immediate="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Disabled="@ViewModel.처리중" /></MudItem>
            <MudItem xs="12" sm="7" md="3"><MudSelect T="string" Label="적재 상태" Value="@ViewModel.목록.조회상태" ValueChanged="StatusChangedAsync" Variant="Variant.Outlined" Disabled="@ViewModel.처리중">@foreach (var status in ViewModel.목록.조회상태목록) { <MudSelectItem T="string" Value="@status">@status</MudSelectItem> }</MudSelect></MudItem>
            <MudItem xs="12" sm="5" md="3"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@ViewModel.처리중" OnClick="SearchAsync">서버 적재 목록 조회</MudButton></MudItem>
        </MudGrid>
    </MudPaper>

    @if (ViewModel.목록.오류발생)
    { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.목록.오류메시지</MudAlert> }

    <MudGrid>
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4 put-away-panel" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"><MudStack Spacing="0"><MudText Typo="Typo.h6">적재 대상</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">서버 조회 @ViewModel.목록.응답.TotalCount.ToString("N0")건</MudText></MudStack>@if (ViewModel.목록.처리중) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }</MudStack>
                    @if (ViewModel.목록.비어있음)
                    { <div class="put-away-empty"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Secondary" /><MudText Typo="Typo.subtitle1">조건에 맞는 적재 작업이 없습니다.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">검수 완료 재고가 없으면 샘플 항목을 표시하지 않습니다.</MudText></div> }
                    else
                    {
                        <div class="put-away-list">
                            @foreach (var item in ViewModel.목록.항목목록)
                            {
                                <button type="button" class="put-away-item @(ViewModel.상세.조회대상Id == item.InboundItemId ? "is-selected" : null)" disabled="@ViewModel.처리중" @onclick="@(() => SelectAsync(item.InboundItemId))">
                                    <span class="put-away-title-row"><span class="put-away-title">@Display(item.ProductName)</span><span class="put-away-status">@(item.CanPutAway ? "적재 대기" : "적재 완료")</span></span>
                                    <span class="put-away-meta">@Display(item.Sku) · @Display(item.WarehouseName)</span>
                                    <span class="put-away-meta">가용 @item.AvailableQuantity.ToString("N0")개 · 불량 @item.DefectiveQuantity.ToString("N0")개</span>
                                    <span class="put-away-meta">위치 @Display(item.StorageLocation) · @FormatDateTime(item.UpdatedAtUtc)</span>
                                </button>
                            }
                        </div>
                    }
                    <MudStack Row="true" Justify="Justify.SpaceBetween"><MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.이전페이지있음 || ViewModel.처리중)" OnClick="PreviousAsync">이전</MudButton><MudText Typo="Typo.caption">@(ViewModel.목록.응답.Page + 1)페이지</MudText><MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.다음페이지있음 || ViewModel.처리중)" OnClick="NextAsync">다음</MudButton></MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-4 put-away-panel" Elevation="0" Outlined="true">
                @if (ViewModel.상세.처리중) { <div class="put-away-empty"><MudProgressCircular Indeterminate="true" /><MudText>같은 입고상품 ID를 확인하고 있습니다.</MudText></div> }
                else if (ViewModel.상세.오류발생) { <div class="put-away-empty"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" /><MudText>@ViewModel.상세.오류메시지</MudText></div> }
                else if (ViewModel.상세.대상없음) { <div class="put-away-empty"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Warning" Size="Size.Large" /><MudText Typo="Typo.subtitle1">적재 대상을 찾을 수 없습니다.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">다른 작업으로 자동 대체하지 않습니다.</MudText><MudButton Variant="Variant.Outlined" OnClick="ClearAsync">선택 해제</MudButton></div> }
                else if (ViewModel.상세.항목 is not { } task) { <div class="put-away-empty"><MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" /><MudText Typo="Typo.subtitle1">적재할 재고를 선택해 주세요.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">목록에서 선택한 한 건의 검수 근거만 서버에서 조회합니다.</MudText></div> }
                else
                {
                    <MudStack Spacing="3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap"><MudStack Spacing="0"><MudText Typo="Typo.h5">@Display(task.ProductName)</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">입고상품 #@task.InboundItemId · @Display(task.Sku)</MudText></MudStack><MudChip T="string" Color="@(task.CanPutAway ? Color.Warning : Color.Success)" Variant="Variant.Outlined">@Display(task.InventoryStatus)</MudChip></MudStack>
                        <MudGrid>
                            <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="창고" Value="@Display(task.WarehouseName)" /></MudItem><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="보관 조건" Value="@Display(task.StorageCondition)" /></MudItem><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="현재 위치" Value="@Display(task.StorageLocation)" /></MudItem>
                            <MudItem xs="6" sm="3"><SsalddelSensitiveInfoRow Label="입고" Value="@($"{task.ReceivedQuantity:N0}개")" /></MudItem><MudItem xs="6" sm="3"><SsalddelSensitiveInfoRow Label="가용" Value="@($"{task.AvailableQuantity:N0}개")" /></MudItem><MudItem xs="6" sm="3"><SsalddelSensitiveInfoRow Label="예약" Value="@($"{task.ReservedQuantity:N0}개")" /></MudItem><MudItem xs="6" sm="3"><SsalddelSensitiveInfoRow Label="불량" Value="@($"{task.DefectiveQuantity:N0}개")" /></MudItem>
                            <MudItem xs="12"><SsalddelSensitiveInfoRow Label="주문 참조" Value="@Display(task.OrderReference)" /></MudItem>
                        </MudGrid>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined"><MudText Typo="Typo.subtitle2">검수 근거</MudText><MudText Typo="Typo.body2">검수 @FormatDateTime(task.InspectedAtUtc)</MudText><MudText Typo="Typo.caption">@Display(task.InspectionMemo)</MudText></MudAlert>
                        @if (task.CanPutAway)
                        {
                            <MudTextField T="string" Label="확정 보관 위치" Value="@ViewModel.작성.보관위치" ValueChanged="SetLocation" Variant="Variant.Outlined" MaxLength="100" Immediate="true" Disabled="@ViewModel.처리중" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Warehouse" />
                            <MudTextField T="string" Label="적재 메모 (선택)" Value="@ViewModel.작성.메모" ValueChanged="SetMemo" Variant="Variant.Outlined" Lines="2" MaxLength="400" Immediate="true" Disabled="@ViewModel.처리중" />
                            <div class="put-away-checklist"><MudCheckBox T="bool" Value="@ViewModel.작성.검수결과확인" ValueChanged="SetInspectionConfirmed" Label="표시된 검수 수량과 불량 수량을 확인했습니다." Disabled="@ViewModel.처리중" /><MudCheckBox T="bool" Value="@ViewModel.작성.위치표찰확인" ValueChanged="SetLabelConfirmed" Label="실제 보관 위치의 표찰과 입력 코드를 확인했습니다." Disabled="@ViewModel.처리중" /></div>
                            <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Inventory" Disabled="@(!ViewModel.작성.완료가능 || ViewModel.처리중)" OnClick="CompleteAsync">적재 위치 확정</MudButton>
                        }
                        else
                        { <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.TaskAlt"><MudText Typo="Typo.subtitle2">서버 적재 완료 상태를 확인했습니다.</MudText><MudText Typo="Typo.body2">보관 위치 @Display(task.StorageLocation) · @FormatDateTime(task.PutAwayAtUtc)</MudText><MudText Typo="Typo.caption">재고 현황에서 가용·예약 수량을 확인하고 후속 출고는 별도 작업에서 진행합니다.</MudText></MudAlert> }
                        @if (ViewModel.작성.오류발생) { <MudAlert Severity="Severity.Error">@ViewModel.작성.오류메시지</MudAlert> }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    [Parameter] public long? InboundItemId { get; set; }
    [Parameter] public EventCallback<long?> OnTaskSelected { get; set; }
    private bool _initialized; private long? _loadedId;
    protected override async Task OnParametersSetAsync() { var id = InboundItemId is > 0 ? InboundItemId : null; if (!_initialized) { _initialized = true; _loadedId = id; await ViewModel.초기화Async(id); } else if (id != _loadedId) { _loadedId = id; if (id is > 0) await ViewModel.대상선택Async(id.Value); else ViewModel.선택해제(); } }
    private void SetSearch(string value) => ViewModel.목록.검색어 = value ?? string.Empty;
    private void SetLocation(string value) => ViewModel.작성.보관위치 = value ?? string.Empty;
    private void SetMemo(string value) => ViewModel.작성.메모 = value ?? string.Empty;
    private void SetInspectionConfirmed(bool value) => ViewModel.작성.검수결과확인 = value;
    private void SetLabelConfirmed(bool value) => ViewModel.작성.위치표찰확인 = value;
    private async Task SearchKeyDownAsync(KeyboardEventArgs args) { if (args.Key is "Enter" or "NumpadEnter") await SearchAsync(); }
    private async Task StatusChangedAsync(string value) { ViewModel.목록.조회상태 = 적재작업조회상태코드.Normalize(value); await SearchAsync(); }
    private Task SearchAsync() => ViewModel.검색Async(); private Task PreviousAsync() => ViewModel.목록.이전페이지Async(); private Task NextAsync() => ViewModel.목록.다음페이지Async();
    private async Task SelectAsync(long id) { if (await ViewModel.대상선택Async(id)) { _loadedId = id; await OnTaskSelected.InvokeAsync(id); } }
    private async Task ClearAsync() { ViewModel.선택해제(); _loadedId = null; await OnTaskSelected.InvokeAsync(null); }
    private Task CompleteAsync() => ViewModel.완료후재조회Async();
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDateTime(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";
}
