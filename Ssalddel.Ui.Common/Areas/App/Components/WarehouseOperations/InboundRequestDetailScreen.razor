@using Ssalddel.Contracts.Common.Inbound

<InboundRequestScreenFrame State="@State"
                           Context="@Context"
                           CurrentScreen="InboundRequestScreenKind.Detail"
                           InboundId="@InboundId"
                           Eyebrow="상세"
                           Title="입고 요청 상세"
                           Description="한 건의 입고 예정 원장과 계약 스냅샷을 같은 ID로 확인합니다."
                           HomeHref="@HomeHref"
                           RefreshRequested="RefreshRequested">
    @if (!State.IsBusy && State.Current is null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-5">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.h6" Class="mt-2">입고 요청을 표시할 수 없습니다</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">ID와 로그인·창고 역할 범위를 확인한 뒤 다시 조회해 주세요.</MudText>
        </MudPaper>
    }
    else if (State.Current is { } item)
    {
        <article class="inbound-detail">
            <header>
                <div>
                    <span>INBOUND REQUEST</span>
                    <h2>#@item.Id · @Display(item.공급처명)</h2>
                    <p>@입고흐름유형코드.GetDisplayName(item.입고흐름유형) · @Display(item.입고생성경로)</p>
                </div>
                <MudChip T="string" Color="@StatusColor(item.상태)" Variant="Variant.Filled">@Display(item.상태)</MudChip>
            </header>

            <div class="inbound-detail__grid">
                <section>
                    <h3>입고 기준</h3>
                    <dl>
                        <div><dt>창고 ID</dt><dd>#@item.창고Id</dd></div>
                        <div><dt>예정 도착일</dt><dd>@FormatDate(item.예정도착일)</dd></div>
                        <div><dt>공급처 코드</dt><dd>@Display(item.공급처코드)</dd></div>
                        <div><dt>원주문 참조</dt><dd>@Display(item.원주문참조번호)</dd></div>
                        <div><dt>예정 품목</dt><dd>@Display(item.예정상품명)</dd></div>
                        <div><dt>예정 SKU·수량</dt><dd>@DisplaySkuQuantity(item)</dd></div>
                    </dl>
                </section>

                <section>
                    <h3>계약 스냅샷</h3>
                    <dl>
                        <div><dt>계약번호</dt><dd>@Display(item.계약정보.계약번호)</dd></div>
                        <div><dt>계약유형</dt><dd>@입고계약유형코드.GetDisplayName(item.계약정보.계약유형)</dd></div>
                        <div><dt>계약 상대방</dt><dd>@Display(item.계약정보.계약상대방명)</dd></div>
                        <div><dt>정산방식</dt><dd>@Display(item.계약정보.정산방식)</dd></div>
                        <div><dt>판매수수료율</dt><dd>@FormatPercent(item.계약정보.판매수수료율)</dd></div>
                        <div><dt>일 보관료</dt><dd>@FormatMoney(item.계약정보.보관료일단가)</dd></div>
                    </dl>
                </section>

                <section>
                    <h3>연결 원장</h3>
                    <dl>
                        <div><dt>커뮤니티 원장</dt><dd>@Display(item.커뮤니티원장Id)</dd></div>
                        <div><dt>원장 상태</dt><dd>@Display(item.커뮤니티원장상태)</dd></div>
                        <div><dt>주문 참조</dt><dd>@Display(item.주문참조번호)</dd></div>
                        <div><dt>운송 의뢰</dt><dd>@Display(item.운송의뢰Id)</dd></div>
                        <div><dt>입고 완료 시각</dt><dd>@FormatDateTime(item.입고완료일시)</dd></div>
                        <div><dt>통관 필요</dt><dd>@(item.계약정보.통관필요여부 ? "필요" : "불필요")</dd></div>
                    </dl>
                </section>
            </div>

            <footer>
                <MudButton Href="@Context.PathFor(InboundRequestScreenKind.List)"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ListAlt">
                    목록
                </MudButton>
                @if (CanComplete(item))
                {
                    <MudButton Href="@Context.PathFor(InboundRequestScreenKind.Complete, item.Id)"
                               Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Inventory">
                        입고완료 화면
                    </MudButton>
                }
            </footer>
        </article>
    }
</InboundRequestScreenFrame>

@code {
    [Parameter, EditorRequired] public InboundRequestPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public InboundRequestNavigationContext Context { get; set; } = new();
    [Parameter, EditorRequired] public long InboundId { get; set; }
    [Parameter, EditorRequired] public string HomeHref { get; set; } = string.Empty;
    [Parameter] public EventCallback RefreshRequested { get; set; }

    private static bool CanComplete(입고요청항목응답 item)
        => !string.Equals(item.상태, 입고상태코드.완료, StringComparison.OrdinalIgnoreCase)
           && !string.Equals(item.상태, 입고상태코드.취소, StringComparison.OrdinalIgnoreCase);

    private static Color StatusColor(string? status)
        => status switch
        {
            입고상태코드.완료 => Color.Success,
            입고상태코드.운송중 => Color.Info,
            입고상태코드.취소 => Color.Default,
            _ => Color.Warning
        };

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";
    private static string FormatDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";
    private static string FormatPercent(decimal value) => value > 0 ? $"{value:N2}%" : "-";
    private static string FormatMoney(decimal value) => value > 0 ? $"{value:N0}원" : "-";

    private static string DisplaySkuQuantity(입고요청항목응답 item)
        => string.IsNullOrWhiteSpace(item.예정SKU) && item.예정수량 is null
            ? "-"
            : $"{Display(item.예정SKU)} · {(item.예정수량 is > 0 ? $"{item.예정수량:N0}개" : "수량 미정")}";
}
