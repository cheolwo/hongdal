@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inherits MvvmComponentBase<입고상품수령PageViewModel>

<section class="inbound-receiving-region" aria-label="입고상품 수령">
    <MudStack Spacing="3" Class="inbound-receiving-workspace">
        <InboundReceivingBoundaryNotice />

        <InboundReceivingPageState PageState="@ViewModel.상태"
                                   PageError="@ViewModel.오류메시지"
                                   Warehouses="@ViewModel.창고"
                                   IsBusy="@ViewModel.처리중"
                                   RetryRequested="RetryWarehousesAsync" />

        @if (IsWorkflowReady)
        {
            <InboundReceivingSearchPanel Warehouses="@ViewModel.창고"
                                         Search="@ViewModel.검색"
                                         IsBusy="@ViewModel.처리중"
                                         ExpectedInboundPath="@ExpectedInboundPath"
                                         WarehouseChanged="WarehouseChangedAsync"
                                         BarcodeChanged="ProductBarcodeChangedAsync"
                                         SearchRequested="SearchAsync"
                                         ClearRequested="ClearSearchAsync" />

            <InboundReceivingCandidatePanel Search="@ViewModel.검색"
                                             Writer="@ViewModel.작성"
                                             IsBusy="@ViewModel.처리중"
                                             InboundSelected="SelectInboundAsync"
                                             UnplannedRequested="StartUnplannedInbound" />

            @if (ViewModel.작성.폼표시)
            {
                <InboundReceivingUnplannedRequestForm Writer="@ViewModel.작성"
                                                      IsBusy="@ViewModel.처리중"
                                                      SubmitRequested="SaveUnplannedInboundAsync"
                                                      CancelRequested="CancelUnplannedInbound" />
            }

            <InboundReceivingPersistedResult Detail="@ViewModel.상세"
                                              WorkBoardHref="@WorkBoardHref" />
        }
    </MudStack>
</section>
