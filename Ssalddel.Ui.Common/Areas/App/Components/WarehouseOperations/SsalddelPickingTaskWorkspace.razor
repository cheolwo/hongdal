@using Ssalddel.Contracts.Common.Warehouse
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inherits MvvmComponentBase<피킹작업PageViewModel>

<MudStack Spacing="3" Class="picking-task-workspace">
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Science">
        <MudText Typo="Typo.subtitle2">Simulation 피킹 범위</MudText>
        <ul class="picking-boundary-list">
            <li>서버에 이미 배정된 <strong>피킹 작업</strong> 한 건의 대기·진행중·완료 상태만 변경합니다.</li>
            <li>화면에서 창고 운영 옵션이나 작업자 배정을 새로 만들지 않습니다.</li>
            <li>완료는 재고 차감·포장 완료·기사 인계·운송·결제·정산을 자동 실행하지 않습니다.</li>
            <li>각 Command 뒤에는 응답을 덮어쓰지 않고 같은 작업 Key를 서버에서 다시 조회합니다.</li>
        </ul>
    </MudAlert>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Hub">
        <MudText Typo="Typo.subtitle2">커뮤니티에서 실행으로, 결과는 다시 같은 문맥으로</MudText>
        <MudText Typo="Typo.body2">
            공동의 필요에서 만들어진 주문 참조와 작업 Key를 유지해 현장 피킹만 처리합니다. 완료 결과는 후속 원장·다이어그램이 같은 Key를 이어받을 수 있도록 서버에 남깁니다.
        </MudText>
    </MudAlert>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="작업 Key·주문참조·상품·SKU·적재대 검색"
                              Value="@ViewModel.목록.검색어"
                              ValueChanged="SetSearch"
                              OnKeyDown="SearchKeyDownAsync"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Disabled="@ViewModel.처리중" />
            </MudItem>
            <MudItem xs="12" sm="7" md="3">
                <MudSelect T="string"
                           Label="작업 상태"
                           Value="@ViewModel.목록.조회상태"
                           ValueChanged="StatusChangedAsync"
                           Variant="Variant.Outlined"
                           Disabled="@ViewModel.처리중">
                    @foreach (var status in ViewModel.목록.조회상태목록)
                    {
                        <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="5" md="3">
                <MudButton FullWidth="true"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@ViewModel.처리중"
                           OnClick="SearchAsync">
                    서버 목록 조회
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (ViewModel.목록.오류발생)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText>@ViewModel.목록.오류메시지</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@ViewModel.처리중" OnClick="SearchAsync">다시 시도</MudButton>
            </MudStack>
        </MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4 picking-panel" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">피킹 작업</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">서버 조회 @ViewModel.목록.응답.TotalCount.ToString("N0")건</MudText>
                        </MudStack>
                        @if (ViewModel.목록.처리중)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                        }
                    </MudStack>

                    @if (ViewModel.목록.비어있음)
                    {
                        <div class="picking-empty">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Secondary" />
                            <MudText Typo="Typo.subtitle1">조건에 맞는 피킹 작업이 없습니다.</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                출고 배치가 영속 피킹 작업을 만들기 전에는 샘플 항목으로 대신 표시하지 않습니다.
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <div class="picking-task-list">
                            @foreach (var item in ViewModel.목록.항목목록)
                            {
                                var selected = string.Equals(ViewModel.상세.조회대상Key, item.TaskKey, StringComparison.Ordinal);
                                <button type="button"
                                        class="picking-task @(selected ? "is-selected" : null)"
                                        disabled="@ViewModel.처리중"
                                        @onclick="@(() => SelectTaskAsync(item.TaskKey))">
                                    <span class="picking-task-title-row">
                                        <span class="picking-task-title">@Display(item.ProductName)</span>
                                        <span class="picking-task-status @StatusClass(item.Status)">@Display(item.Status)</span>
                                    </span>
                                    <span class="picking-task-meta">@Display(item.TaskKey) · @Display(item.Sku)</span>
                                    <span class="picking-task-meta">@Display(item.WarehouseName) · @Display(item.RackCode) · @item.Quantity.ToString("N0")개</span>
                                    <span class="picking-task-meta">담당 @Display(item.WorkerDisplayName) · @FormatDateTime(item.UpdatedAtUtc)</span>
                                </button>
                            }
                        </div>
                    }

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.이전페이지있음 || ViewModel.처리중)" OnClick="PreviousPageAsync">이전</MudButton>
                        <MudText Typo="Typo.caption">@(ViewModel.목록.응답.Page + 1)페이지</MudText>
                        <MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.다음페이지있음 || ViewModel.처리중)" OnClick="NextPageAsync">다음</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-4 picking-panel" Elevation="0" Outlined="true">
                @if (ViewModel.상세.처리중)
                {
                    <div class="picking-empty">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">같은 작업 Key를 서버에서 확인하고 있습니다.</MudText>
                    </div>
                }
                else if (ViewModel.상세.오류발생)
                {
                    <div class="picking-empty">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                        <MudText Typo="Typo.subtitle1">피킹 작업 상세를 조회하지 못했습니다.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@ViewModel.상세.오류메시지</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@ViewModel.처리중" OnClick="RetryDetailAsync">다시 조회</MudButton>
                    </div>
                }
                else if (ViewModel.상세.대상없음)
                {
                    <div class="picking-empty">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle1">피킹 작업을 찾을 수 없습니다.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            주소의 작업 Key가 없거나 현재 계정의 창고 범위 밖입니다. 다른 작업으로 자동 대체하지 않습니다.
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Disabled="@ViewModel.처리중" OnClick="ClearSelectionAsync">선택 해제</MudButton>
                    </div>
                }
                else if (ViewModel.상세.항목 is not { } task)
                {
                    <div class="picking-empty">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.subtitle1">처리할 피킹 작업을 선택해 주세요.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">목록에서 한 건을 선택할 때만 정확한 상세와 상태 전이 버튼을 표시합니다.</MudText>
                    </div>
                }
                else
                {
                    <MudStack Spacing="3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h5">@Display(task.ProductName)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Display(task.TaskKey) · @Display(task.Sku)</MudText>
                            </MudStack>
                            <MudChip T="string" Color="@StatusColor(task.Status)" Variant="Variant.Filled" Size="Size.Small">@Display(task.Status)</MudChip>
                        </MudStack>

                        <MudGrid>
                            <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="창고" Value="@Display(task.WarehouseName)" /></MudItem>
                            <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="담당" Value="@Display(task.WorkerDisplayName)" /></MudItem>
                            <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="수량" Value="@($"{task.Quantity:N0}개")" /></MudItem>
                            <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="적재대" Value="@Display(task.RackCode)" /></MudItem>
                            <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="보관 위치" Value="@Display(task.StorageLocationCode)" /></MudItem>
                            <MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="처리 방식" Value="@Display(task.ProcessingMode)" /></MudItem>
                            <MudItem xs="12" sm="6"><SsalddelSensitiveInfoRow Label="주문 참조" Value="@Display(task.OrderReference)" /></MudItem>
                            <MudItem xs="12" sm="6"><SsalddelSensitiveInfoRow Label="작업 묶음" Value="@Display(task.BundleBarcode)" /></MudItem>
                        </MudGrid>

                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            <MudText Typo="Typo.subtitle2">다음 단계</MudText>
                            <MudText Typo="Typo.body2">@Display(task.NextStep)</MudText>
                            @if (!string.IsNullOrWhiteSpace(task.AssignmentReason))
                            {
                                <MudText Typo="Typo.caption">배정 근거: @task.AssignmentReason</MudText>
                            }
                        </MudAlert>

                        @if (task.CanStart)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Disabled="@(!ViewModel.처리.시작가능 || ViewModel.처리중)"
                                       OnClick="StartTaskAsync">
                                피킹 작업 시작
                            </MudButton>
                        }
                        else if (task.CanComplete)
                        {
                            <MudDivider />
                            <MudText Typo="Typo.h6">현장 완료 확인</MudText>
                            <MudTextField T="string"
                                          Label="적재대 확인 코드"
                                          Value="@ViewModel.처리.적재대확인코드"
                                          ValueChanged="SetRackCode"
                                          Variant="Variant.Outlined"
                                          MaxLength="120"
                                          Immediate="true"
                                          Disabled="@ViewModel.처리중"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.QrCodeScanner" />
                            <div class="picking-checklist">
                                <MudCheckBox T="bool" Value="@ViewModel.처리.상품확인" ValueChanged="SetProductConfirmed" Label="표시된 상품과 SKU가 실제 피킹 상품과 일치합니다." Disabled="@ViewModel.처리중" />
                                <MudCheckBox T="bool" Value="@ViewModel.처리.전체수량확인" ValueChanged="SetQuantityConfirmed" Label="표시된 전체 수량을 한 번에 피킹했습니다." Disabled="@ViewModel.처리중" />
                            </div>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       Size="Size.Large"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.DoneAll"
                                       Disabled="@(!ViewModel.처리.완료가능 || ViewModel.처리중)"
                                       OnClick="CompleteTaskAsync">
                                피킹 작업 완료
                            </MudButton>
                        }
                        else if (string.Equals(task.Status, "완료", StringComparison.Ordinal))
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.TaskAlt">
                                <MudText Typo="Typo.subtitle2">서버 피킹 완료 상태를 다시 확인했습니다.</MudText>
                                <MudText Typo="Typo.body2">완료 시각: @FormatDateTime(task.CompletedAtUtc)</MudText>
                                <MudText Typo="Typo.caption">포장·출고·운송 인계는 각 후속 서버 작업에서 진행합니다.</MudText>
                            </MudAlert>
                        }

                        @if (ViewModel.처리.오류발생)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.처리.오류메시지</MudAlert>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    [Parameter] public string? TaskKey { get; set; }
    [Parameter] public EventCallback<string?> OnTaskSelected { get; set; }

    private bool _initialized;
    private string? _loadedTaskKey;

    protected override async Task OnParametersSetAsync()
    {
        var normalizedKey = string.IsNullOrWhiteSpace(TaskKey) ? null : TaskKey.Trim();
        if (!_initialized)
        {
            _initialized = true;
            _loadedTaskKey = normalizedKey;
            await ViewModel.초기화Async(normalizedKey);
            return;
        }

        if (string.Equals(normalizedKey, _loadedTaskKey, StringComparison.Ordinal))
        {
            return;
        }

        _loadedTaskKey = normalizedKey;
        if (normalizedKey is not null)
        {
            await ViewModel.대상선택Async(normalizedKey);
        }
        else
        {
            ViewModel.선택해제();
        }
    }

    private void SetSearch(string value) => ViewModel.목록.검색어 = value ?? string.Empty;
    private void SetRackCode(string value) => ViewModel.처리.적재대확인코드 = value ?? string.Empty;
    private void SetProductConfirmed(bool value) => ViewModel.처리.상품확인 = value;
    private void SetQuantityConfirmed(bool value) => ViewModel.처리.전체수량확인 = value;

    private async Task SearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await SearchAsync();
        }
    }

    private async Task StatusChangedAsync(string value)
    {
        ViewModel.목록.조회상태 = 피킹작업조회상태코드.Normalize(value);
        await SearchAsync();
    }

    private Task SearchAsync() => ViewModel.검색Async();
    private Task PreviousPageAsync() => ViewModel.목록.이전페이지Async();
    private Task NextPageAsync() => ViewModel.목록.다음페이지Async();

    private async Task SelectTaskAsync(string taskKey)
    {
        if (!await ViewModel.대상선택Async(taskKey))
        {
            return;
        }

        _loadedTaskKey = taskKey;
        await OnTaskSelected.InvokeAsync(taskKey);
    }

    private async Task RetryDetailAsync()
    {
        if (ViewModel.상세.조회대상Key is { Length: > 0 } taskKey)
        {
            await ViewModel.대상선택Async(taskKey);
        }
    }

    private async Task ClearSelectionAsync()
    {
        ViewModel.선택해제();
        _loadedTaskKey = null;
        await OnTaskSelected.InvokeAsync(null);
    }

    private Task StartTaskAsync() => ViewModel.시작후재조회Async();
    private Task CompleteTaskAsync() => ViewModel.완료후재조회Async();

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";

    private static Color StatusColor(string status)
        => status switch
        {
            "완료" => Color.Success,
            "진행중" => Color.Info,
            "취소" => Color.Default,
            _ => Color.Warning
        };

    private static string StatusClass(string status)
        => status switch
        {
            "완료" => "is-complete",
            "진행중" => "is-progress",
            _ => "is-pending"
        };
}
