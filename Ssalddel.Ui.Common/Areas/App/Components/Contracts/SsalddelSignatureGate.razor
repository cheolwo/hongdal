@if (Requirement?.IsRequired == true)
{
    <MudPaper Class="ssalddel-signature-gate" Elevation="0">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2">@Requirement.SignerRole</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Requirement.Reason</MudText>
                </MudStack>

                <MudChip T="string" Size="Size.Small" Color="@ChipColor" Variant="Variant.Outlined">
                    @ChipText
                </MudChip>
            </MudStack>

            <SsalddelSignaturePad Title="@Requirement.Title"
                                 Description="@Requirement.Description"
                                 SignerName="@SignerName"
                                 SignerNameChanged="@OnSignerNameChangedAsync"
                                 Required="true"
                                 Disabled="@Disabled"
                                 SignatureCaptured="@OnSignatureCapturedAsync" />
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public SsalddelSignatureRequirement? Requirement { get; set; }

    [Parameter]
    public string SignerName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SignerNameChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<SsalddelSignatureGateResult> SignatureCaptured { get; set; }

    private Color ChipColor => Requirement?.IsContractSignature == true
        ? Color.Primary
        : Color.Secondary;

    private string ChipText => Requirement?.IsContractSignature == true
        ? "계약 서명"
        : "업무 확인 서명";

    private async Task OnSignerNameChangedAsync(string value)
    {
        SignerName = value;
        await SignerNameChanged.InvokeAsync(value);
    }

    private async Task OnSignatureCapturedAsync(SsalddelSignatureCaptureResult signature)
    {
        if (Requirement is null)
        {
            return;
        }

        await SignatureCaptured.InvokeAsync(new SsalddelSignatureGateResult(Requirement, signature));
    }
}
