@implements IAsyncDisposable

<MudPaper Class="ssalddel-signature-pad" Elevation="0">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="ssalddel-signature-pad__header">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">@Title</MudText>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
                }
            </MudStack>

            @if (Required)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">필수 서명</MudChip>
            }
        </MudStack>

        <MudTextField T="string"
                      Label="@SignerNameLabel"
                      Value="@SignerName"
                      ValueChanged="OnSignerNameChangedAsync"
                      Disabled="@Disabled"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true" />

        <div class="ssalddel-signature-pad__canvas-wrap">
            <canvas id="@CanvasId"
                    class="ssalddel-signature-pad__canvas"
                    width="@CanvasWidth"
                    height="@CanvasHeight"
                    aria-label="@CanvasAriaLabel"></canvas>
            @if (Disabled)
            {
                <div class="ssalddel-signature-pad__disabled">서명 입력이 비활성화되어 있습니다.</div>
            }
        </div>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @HintText
            </MudText>

            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           Disabled="@Disabled"
                           OnClick="ClearAsync">
                    지우기
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@Disabled"
                           OnClick="CaptureAsync">
                    서명 확인
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(ValidationMessage))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@ValidationMessage</MudAlert>
        }
    </MudStack>
</MudPaper>

@code {
    private readonly string CanvasId = $"ssalddel-signature-{Guid.NewGuid():N}";
    private IJSObjectReference? module;
    private string ValidationMessage = string.Empty;

    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "전자서명";

    [Parameter]
    public string Description { get; set; } = "화면에 손가락이나 펜으로 서명하고 이름을 입력합니다.";

    [Parameter]
    public string SignerNameLabel { get; set; } = "서명자 이름";

    [Parameter]
    public string SignerName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SignerNameChanged { get; set; }

    [Parameter]
    public bool Required { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public int CanvasWidth { get; set; } = 640;

    [Parameter]
    public int CanvasHeight { get; set; } = 220;

    [Parameter]
    public string StrokeColor { get; set; } = "#111827";

    [Parameter]
    public decimal StrokeWidth { get; set; } = 2.4m;

    [Parameter]
    public EventCallback<SsalddelSignatureCaptureResult> SignatureCaptured { get; set; }

    [Parameter]
    public EventCallback Cleared { get; set; }

    private string CanvasAriaLabel => $"{Title} 입력 영역";

    private string HintText => Disabled
        ? "현재 서명 입력을 받을 수 없습니다."
        : "서명은 전자서명 증적 생성 전 단계의 입력값입니다.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Ssalddel.Ui.Common/Areas/App/js/ssalddel-signature-pad.js");
        await module.InvokeVoidAsync(
            "initialize",
            CanvasId,
            new
            {
                strokeColor = StrokeColor,
                strokeWidth = StrokeWidth,
                disabled = Disabled
            });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("setDisabled", CanvasId, Disabled);
        }
    }

    private async Task OnSignerNameChangedAsync(string value)
    {
        SignerName = value;
        ValidationMessage = string.Empty;
        await SignerNameChanged.InvokeAsync(value);
    }

    private async Task ClearAsync()
    {
        if (module is null)
        {
            return;
        }

        await module.InvokeVoidAsync("clear", CanvasId);
        ValidationMessage = string.Empty;
        await Cleared.InvokeAsync();
    }

    private async Task CaptureAsync()
    {
        if (module is null)
        {
            return;
        }

        ValidationMessage = string.Empty;
        var state = await module.InvokeAsync<SsalddelSignatureCanvasState>("capture", CanvasId);

        if (Required && string.IsNullOrWhiteSpace(SignerName))
        {
            ValidationMessage = "서명자 이름을 입력해야 합니다.";
            return;
        }

        if (Required && state.IsEmpty)
        {
            ValidationMessage = "서명을 입력해야 합니다.";
            return;
        }

        var result = new SsalddelSignatureCaptureResult(
            SignerName.Trim(),
            state.DataUrl,
            DateTimeOffset.UtcNow,
            state.StrokeCount,
            state.Width,
            state.Height);

        await SignatureCaptured.InvokeAsync(result);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.InvokeVoidAsync("dispose", CanvasId);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
