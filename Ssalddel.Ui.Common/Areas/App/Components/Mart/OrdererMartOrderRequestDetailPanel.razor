@namespace Ssalddel.Ui.Common.Areas.App.Components.Mart
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<MudPaper Elevation="0" Outlined="true" Class="mart-order-panel">
    @if (RequestDetail.처리중)
    {
        <div class="mart-order-state mart-order-state--detail">
            <MudProgressCircular Indeterminate="true" Color="Color.Success" />
            <MudText Typo="Typo.body2">저장된 주문 요청을 같은 ID로 다시 조회하고 있습니다.</MudText>
        </div>
    }
    else if (RequestDetail.오류발생)
    {
        <div class="mart-order-state mart-order-state--detail">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2">주문 요청을 다시 조회하지 못했습니다.</MudText>
            <MudText Typo="Typo.body2">@OrdererMartOrderRequestPresentation.ErrorMessage(RequestDetail.오류메시지)</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => RetryRequested.InvokeAsync(RequestId))">다시 시도</MudButton>
        </div>
    }
    else if (RequestDetail.찾을수없음)
    {
        <div class="mart-order-state mart-order-state--detail">
            <MudIcon Icon="@Icons.Material.Filled.NoAccounts" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2">이 계정의 주문 요청을 찾을 수 없습니다.</MudText>
            <MudText Typo="Typo.body2">없는 ID와 다른 사용자의 요청 ID는 동일하게 처리하며 다른 요청으로 대체하지 않습니다.</MudText>
        </div>
    }
    else if (RequestDetail.상세 is { } request)
    {
        <div class="mart-order-request-heading">
            <div>
                <MudText Typo="Typo.overline">PERSISTED REQUEST</MudText>
                <MudText Typo="Typo.h5">@request.상품명</MudText>
                <MudText Typo="Typo.caption">요청 ID @OrdererMartOrderRequestPresentation.ShortId(request.주문요청Id)</MudText>
            </div>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">@request.상태명</MudChip>
        </div>
        <div class="mart-order-receipt">
            <div><span>수량</span><strong>@($"{request.수량:N0} {OrdererMartOrderRequestPresentation.ValueOrDash(request.판매단위)}")</strong></div>
            <div><span>서버 확인 단가</span><strong>@($"{request.단가:N0}원")</strong></div>
            <div><span>서버 계산 합계</span><strong>@($"{request.합계:N0}원")</strong></div>
            <div><span>제출 시 판매 가능 수량</span><strong>@($"{request.제출시판매가능수량:N0}")</strong></div>
            <div><span>재고 기준</span><strong>@OrdererMartOrderRequestPresentation.FormatDate(request.재고기준시각Utc)</strong></div>
            <div><span>제출 시각</span><strong>@OrdererMartOrderRequestPresentation.FormatDate(request.제출일시Utc)</strong></div>
        </div>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
            저장 완료는 재고 예약이나 결제를 뜻하지 않습니다. 현재 응답의 재고 예약: @(request.재고예약됨 ? "예" : "아니요"), 결제: @(request.결제됨 ? "예" : "아니요").
        </MudAlert>
        <div class="mart-order-actions">
            <MudButton Href="@CatalogHref" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Storefront">
                다른 상품 보기
            </MudButton>
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public Guid RequestId { get; set; }

    [Parameter, EditorRequired]
    public 마트주문요청상세ViewModel RequestDetail { get; set; } = null!;

    [Parameter, EditorRequired]
    public string CatalogHref { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<Guid> RetryRequested { get; set; }
}
