@inherits MvvmComponentBase<마트공개상품PageViewModel>
@using Ssalddel.Contracts.Mart
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="mart-workspace" aria-label="알뜰살뜰 마트 공개 상품">
    @if (Access.처리중 && Access.화면상태 == 마트페이지접근상태.확인전)
    {
        <MudPaper Elevation="0" Outlined="true" Class="mart-state">
            <MudProgressCircular Indeterminate="true" Color="Color.Success" />
            <MudText Typo="Typo.body1">알뜰살뜰 마트 기능 상태를 확인하고 있습니다.</MudText>
        </MudPaper>
    }
    else if (Access.화면상태 == 마트페이지접근상태.오류)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle2">마트 상품 화면을 준비하지 못했습니다.</MudText>
            <MudText Typo="Typo.body2">@ErrorMessage(Access.오류메시지)</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="InitializeAsync" Class="mt-3">다시 확인</MudButton>
        </MudAlert>
    }
    else if (Access.기능비활성)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle2">마트 공개 조회가 현재 비활성입니다.</MudText>
            <MudText Typo="Typo.body2"><code>SsalddelMartWorkflow</code>가 활성화되기 전에는 공개 상품 원장을 조회하지 않습니다.</MudText>
        </MudAlert>
    }
    else if (Access.사용가능)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mart-boundary">
            공개 상품과 마지막 투영 시각 기준의 판매 가능 수량만 표시합니다. 내부 창고 위치·소유자·계약·정산 정보는 노출하지 않으며, 조회로 장바구니·주문·피킹·포장·배송을 생성하지 않습니다.
        </MudAlert>

        <div class="mart-layout">
            <div class="mart-main">
                <MudPaper Elevation="0" Outlined="true" Class="mart-panel mart-search-panel">
                    <div class="mart-panel-heading">
                        <div>
                            <MudText Typo="Typo.overline">PUBLIC MART CATALOG</MudText>
                            <MudText Typo="Typo.h6">공개 판매 상품 찾기</MudText>
                        </div>
                        @if (List.초기화됨)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                @($"{List.전체건수:N0}개 공개")
                            </MudChip>
                        }
                    </div>

                    <div class="mart-search-controls">
                        <MudTextField T="string"
                                      @bind-Value="List.검색어"
                                      Label="상품명·카테고리·설명"
                                      Placeholder="예: 생수, 생활용품"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnKeyDown="HandleSearchKeyAsync" />
                        <MudCheckBox T="bool" @bind-Value="List.판매가능만" Color="Color.Success">판매 가능한 상품만</MudCheckBox>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.TravelExplore"
                                   Disabled="@List.처리중"
                                   OnClick="SearchAsync">
                            상품 조회
                        </MudButton>
                    </div>
                </MudPaper>

                <MudPaper Elevation="0" Outlined="true" Class="mart-panel mart-list-panel">
                    <div class="mart-panel-heading">
                        <div>
                            <MudText Typo="Typo.overline">SERVER RESULTS</MudText>
                            <MudText Typo="Typo.h6">마트 공개 상품</MudText>
                        </div>
                        @if (List.초기화됨)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Disabled="@List.처리중"
                                       OnClick="ReloadListAsync">새로고침</MudButton>
                        }
                    </div>

                    @if (List.처리중)
                    {
                        <div class="mart-state mart-state--compact">
                            <MudProgressCircular Indeterminate="true" Color="Color.Success" />
                            <MudText Typo="Typo.body2">영속된 공개 상품 원장을 조회하고 있습니다.</MudText>
                        </div>
                    }
                    else if (List.오류발생)
                    {
                        <div class="mart-state mart-state--compact">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                            <MudText Typo="Typo.subtitle2">마트 상품 목록을 불러오지 못했습니다.</MudText>
                            <MudText Typo="Typo.body2">@ErrorMessage(List.오류메시지)</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="ReloadListAsync">다시 시도</MudButton>
                        </div>
                    }
                    else if (List.결과없음)
                    {
                        <div class="mart-state mart-state--compact">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" />
                            <MudText Typo="Typo.subtitle2">공개된 마트 상품이 없습니다.</MudText>
                            <MudText Typo="Typo.body2">@EmptyMessage</MudText>
                        </div>
                    }
                    else if (List.초기화됨)
                    {
                        <MudText Typo="Typo.caption">@($"전체 {List.전체건수:N0}개 · {List.현재페이지}/{List.총페이지수}페이지")</MudText>
                        <div class="mart-card-grid">
                            @foreach (var product in List.상품목록)
                            {
                                <article class="mart-card @(Detail.요청ProductId == product.Id ? "mart-card--selected" : string.Empty)">
                                    <div class="mart-card-visual">
                                        @if (!string.IsNullOrWhiteSpace(product.대표이미지Url))
                                        {
                                            <img src="@product.대표이미지Url" alt="@($"{product.상품명} 공개 이미지")" loading="lazy" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Success" Size="Size.Large" />
                                        }
                                    </div>
                                    <div class="mart-card-heading">
                                        <div>
                                            <MudText Typo="Typo.h6">@product.상품명</MudText>
                                            <MudText Typo="Typo.caption">@ValueOrDash(product.카테고리) · @ValueOrDash(product.판매단위)</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="@(product.판매가능여부 ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                                            @(product.판매가능여부 ? "판매 가능" : "품절·준비 중")
                                        </MudChip>
                                    </div>
                                    <MudText Typo="Typo.body2">@ValueOrDash(product.짧은설명)</MudText>
                                    <div class="mart-card-meta">
                                        <strong>@product.판매가.ToString("N0")원</strong>
                                        <span>판매 가능 @product.판매가능수량.ToString("N0")</span>
                                        <span>@ProjectionTime(product.재고기준시각Utc)</span>
                                    </div>
                                    <MudButton Variant="@(Detail.요청ProductId == product.Id ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.FindInPage"
                                               OnClick="@(() => SelectProductAsync(product.Id))">
                                        공개 상세 보기
                                    </MudButton>
                                </article>
                            }
                        </div>

                        @if (List.총페이지수 > 1)
                        {
                            <div class="mart-pagination">
                                <MudPagination Count="@List.총페이지수"
                                               Selected="@List.현재페이지"
                                               SelectedChanged="ChangePageAsync"
                                               Disabled="@List.처리중"
                                               ShowFirstButton="true"
                                               ShowLastButton="true" />
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(List.응답.재고기준안내))
                        {
                            <MudText Typo="Typo.caption" Class="mart-basis">@List.응답.재고기준안내</MudText>
                        }
                    }
                </MudPaper>
            </div>

            <MudPaper Elevation="0" Outlined="true" Class="mart-panel mart-detail-panel">
                @if (Detail.처리중)
                {
                    <div class="mart-state mart-state--detail">
                        <MudProgressCircular Indeterminate="true" Color="Color.Success" />
                        <MudText Typo="Typo.body2">정확한 공개 상품을 불러오고 있습니다.</MudText>
                    </div>
                }
                else if (Detail.오류발생)
                {
                    <div class="mart-state mart-state--detail">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle2">상품 상세를 불러오지 못했습니다.</MudText>
                        <MudText Typo="Typo.body2">@ErrorMessage(Detail.오류메시지)</MudText>
                        @if (Detail.요청ProductId is long retryId)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => SelectProductAsync(retryId, false))">다시 시도</MudButton>
                        }
                    </div>
                }
                else if (Detail.찾을수없음)
                {
                    <div class="mart-state mart-state--detail">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle2">공개된 마트 상품을 찾을 수 없습니다.</MudText>
                        <MudText Typo="Typo.body2">비공개·삭제된 ID를 다른 상품이나 샘플 상품으로 대체하지 않습니다.</MudText>
                    </div>
                }
                else if (Detail.상세 is { } detail)
                {
                    <div class="mart-detail-heading">
                        <div>
                            <MudText Typo="Typo.overline">EXACT PUBLIC PRODUCT #@detail.Id</MudText>
                            <MudText Typo="Typo.h5">@detail.상품명</MudText>
                            <MudText Typo="Typo.body2">@ValueOrDash(detail.카테고리) · @ValueOrDash(detail.판매단위)</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClearSelectionAsync" aria-label="마트 상품 상세 닫기" />
                    </div>

                    <div class="mart-detail-price">
                        <MudText Typo="Typo.h5" Color="Color.Success">@detail.판매가.ToString("N0")원</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(detail.판매가능여부 ? Color.Success : Color.Default)">
                            @(detail.판매가능여부 ? $"판매 가능 {detail.판매가능수량:N0}" : "품절·판매 준비 중")
                        </MudChip>
                    </div>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1">상품 공개 설명</MudText>
                    <MudText Typo="Typo.body2">@ValueOrDash(detail.설명)</MudText>
                    <MudText Typo="Typo.caption" Class="mt-3">재고 기준 @ProjectionTime(detail.재고기준시각Utc)</MudText>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-3">
                        @detail.재고기준안내
                    </MudAlert>
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        이 상세 조회만으로 구매 의향이나 재고 예약을 저장하지 않습니다. 주문 요청 작성은 별도 페이지에서 로그인·서버 검증·멱등 저장으로 처리합니다.
                    </MudAlert>
                    @if (!string.IsNullOrWhiteSpace(OrderRequestBasePath))
                    {
                        <MudButton Href="@OrderRequestHref(detail.Id)"
                                   Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                   Disabled="@(!detail.판매가능여부)"
                                   Class="mt-3">
                            주문 요청 작성
                        </MudButton>
                    }
                }
                else
                {
                    <div class="mart-state mart-state--detail">
                        <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle2">상품을 선택하면 공개 상세를 확인할 수 있습니다.</MudText>
                        <MudText Typo="Typo.body2">선택 전에는 첫 상품이나 정적 샘플을 대신 표시하지 않습니다.</MudText>
                    </div>
                }
            </MudPaper>
        </div>
    }
</section>
