@page "/"
@namespace Ssalddel.BusinessPackages.AdminUi
@using Ssalddel.Contracts.Admin.BusinessPackages
@using Microsoft.Extensions.Options
@inject IOptions<BusinessPackageAdminOptions> Options

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Definition.DisplayName 관리자</title>
    <base href="/" />
</head>
<body>
    <main style="font-family:system-ui,sans-serif;max-width:920px;margin:48px auto;padding:0 24px">
        <p style="color:#52606d">살뜰 업무 패키지 관리자</p>
        <h1>@Definition.DisplayName 관리자</h1>
        <p>@Definition.Description</p>
        @if (!string.IsNullOrWhiteSpace(Definition.CompletedOutboundHandoffPackageCode))
        {
            <aside style="border-left:4px solid #1976d2;padding:12px 16px;background:#f4f8fc">
                완료 출고는 <strong>@BusinessPackageCatalog.GetRequired(Definition.CompletedOutboundHandoffPackageCode).DisplayName</strong> 패키지에 인계됩니다. 인계 전에는 운송 배정이나 상태 확정을 수행하지 않습니다.
            </aside>
        }
        <h2 style="margin-top:32px">운영 작업</h2>
        <ul>
            @foreach (var workflow in Definition.Workflows)
            {
                <li style="margin:16px 0">
                    <a href="@ToAdminUrl(workflow.AdminPath)"><strong>@workflow.Label</strong></a><br />
                    <span>@workflow.Description</span>
                </li>
            }
        </ul>
        <p style="margin-top:32px;color:#52606d">기존 관리자 URL은 변경하지 않았습니다. 이 앱은 분리된 업무 진입점이며, 인증·권한·조직 문맥과 공통 계약은 기존 공통 계층을 그대로 사용합니다.</p>
    </main>
</body>
</html>

@code {
    private BusinessPackageDefinition Definition => BusinessPackageCatalog.GetRequired(Options.Value.PackageCode);

    private string ToAdminUrl(string path)
        => $"{Options.Value.LegacyAdminBaseUrl.TrimEnd('/')}/{path.TrimStart('/')}";
}
