@inject WebAuthSessionService AuthSession

@if (AuthSession.IsLoggedIn)
{
    @ChildContent
}
else
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="ma-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">원장을 만들려면 로그인이 필요합니다.</MudText>
            <MudText Typo="Typo.body2">
                로그인 뒤 원천 주문 원장에 대한 권한을 서버가 다시 확인합니다. 서버관리자도 이 화면에서 점검할 수 있습니다.
            </MudText>
            <MudButton Href="@LoginHref"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Login">
                로그인하고 계속하기
            </MudButton>
        </MudStack>
    </MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public string ReturnUrl { get; set; } = "/";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string LoginHref => $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
