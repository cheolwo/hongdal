@implements IDisposable
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession
@inject CommunityPersonalPreferenceService PersonalPreferences
@inject WebLocalePreferenceService Locale

<div class="web-navigation-shell">
    <div class="web-navigation-main">
        <MudStack Spacing="0" Class="px-4 pt-3 pb-2">
            <MudText Typo="Typo.overline" Color="Color.Secondary">
                @(IsCommunityMode
                    ? Locale.Text("통합 베타 · 커뮤니티", "Integrated Beta · Community")
                    : Locale.Text("통합 베타 · 업무", "Integrated Beta · Work"))
            </MudText>
            <MudText Typo="Typo.subtitle2">@NavigationIdentityLabel</MudText>
        </MudStack>

        <MudNavMenu Class="platform-navigation-menu">
            @foreach (var item in CurrentItems)
            {
                var pageState = IntegratedBetaCatalog.Resolve(item.Href);
                <MudNavLink Href="@EffectiveHref(item)"
                            Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                            Icon="@item.Icon">
                    <span class="web-navigation-item-copy">
                        <span>@NavigationTitle(item)</span>
                        <small class="@IntegratedBetaCatalog.StageCssClass(pageState.Stage)">@StageLabel(pageState.StageLabel)</small>
                    </span>
                </MudNavLink>
            }
        </MudNavMenu>
    </div>

    <MudPaper Square="true" Elevation="0" Class="web-navigation-mode-switch pa-2">
        @if (IsCommunityMode)
        {
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Forum"
                           OnClick="OpenCommunityMode">
                    @Locale.Text("게시판", "Boards")
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="OpenCommunityCompose">
                    @Locale.Text("글쓰기", "Write")
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="@BusinessModeVariant"
                           Color="Color.Primary"
                           Size="Size.Small"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Work"
                           OnClick="OpenBusinessMode">
                    @Locale.Text("업무", "Work")
                </MudButton>
                <MudButton Variant="@CommunityModeVariant"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Forum"
                           OnClick="OpenCommunityMode">
                    @Locale.Text("커뮤니티", "Community")
                </MudButton>
            </MudStack>
        }
    </MudPaper>
</div>

<style>
    .web-navigation-shell {
        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

    .web-navigation-main {
        flex: 1 1 auto;
    }

    .platform-navigation-menu {
        padding-bottom: 12px;
    }

    .web-navigation-item-copy {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
        min-width: 0;
    }

    .web-navigation-item-copy > span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .web-navigation-item-copy small {
        flex: 0 0 auto;
        padding: 2px 6px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #64748b;
        font-size: 0.64rem;
        font-weight: 800;
        line-height: 1.35;
    }

    .web-navigation-item-copy small.integrated-stage--live {
        background: #f0fdf4;
        color: #15803d;
    }

    .web-navigation-item-copy small.integrated-stage--beta {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .web-navigation-item-copy small.integrated-stage--experience {
        background: #f0f9ff;
        color: #0369a1;
    }

    .web-navigation-item-copy small.integrated-stage--preparing {
        background: #fefce8;
        color: #a16207;
    }

    .web-navigation-mode-switch {
        position: sticky;
        bottom: 0;
        z-index: 2;
        border-top: 1px solid rgba(var(--mud-palette-primary-rgb), 0.12);
        background: var(--mud-palette-drawer-background);
    }

    .web-navigation-mode-switch .mud-button-root {
        min-width: 0;
    }
</style>

@code {
    private bool IsCommunityMode
        => WebNavigationCatalog.IsCommunityRoute(Navigation.ToBaseRelativePath(Navigation.Uri));

    private IReadOnlyList<WebNavigationItem> CurrentItems
        => WebNavigationCatalog.IntegratedItems
            .Concat(ContextualItems)
            .DistinctBy(item => item.Href, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<WebNavigationItem> ContextualItems
        => IsCommunityMode
            ? PersonalPreferences.Current.UseCompactPersonalMenu
                ? WebNavigationCatalog.CommunityItems
                    .Where(item => item.Href is "/community/me"
                        or "/community/me/posts"
                        or "/community/me/actions"
                        or "/community/decorations"
                        or "/community/me/settings")
                    .ToArray()
                : WebNavigationCatalog.CommunityItems
            : WebNavigationCatalog.GetBusinessItems(AuthSession.CurrentTheme.ThemeCode);

    private string NavigationIdentityLabel
        => IsCommunityMode
            ? AuthSession.UserName ?? LocalizedRoleLabel
            : LocalizedRoleLabel;

    private string LocalizedRoleLabel
        => !Locale.IsEnglish
            ? AuthSession.CurrentTheme.RoleLabel
            : AuthSession.CurrentTheme.RoleLabel switch
            {
                "방문자" => "Visitor",
                "회원" => "Member",
                "운영자" => "Operator",
                "관리자" => "Administrator",
                _ => AuthSession.CurrentTheme.RoleLabel
            };

    private string StageLabel(string label)
        => !Locale.IsEnglish
            ? label
            : label switch
            {
                "운영" => "Live",
                "베타" => "Beta",
                "체험" => "Preview",
                "준비" => "Planned",
                _ => label
            };

    private string EffectiveHref(WebNavigationItem item)
        => string.Equals(item.Href, "/community", StringComparison.OrdinalIgnoreCase)
            ? WebLocalePolicy.LocalizedCommunityHome(Locale.LanguageCode)
            : item.Href;

    private string NavigationTitle(WebNavigationItem item)
    {
        if (!Locale.IsEnglish)
        {
            return item.Title;
        }

        return item.Title switch
        {
            "공개 커뮤니티" => "Public Community",
            "내 정보" => "My Profile",
            "내 글" => "My Posts",
            "참여 중" => "My Participation",
            "역할 지원" => "Role Applications",
            "내 원장" => "My Ledgers",
            "알림" => "Notifications",
            "꾸미기" => "Decorations",
            "사용 설정" => "Preferences",
            _ => item.Title
        };
    }

    private Variant BusinessModeVariant => IsCommunityMode ? Variant.Outlined : Variant.Filled;

    private Variant CommunityModeVariant => IsCommunityMode ? Variant.Filled : Variant.Outlined;

    protected override void OnInitialized()
    {
        AuthSession.Changed += HandleStateChanged;
        PersonalPreferences.Changed += HandleStateChanged;
        Locale.Changed += HandleStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PersonalPreferences.LoadAsync(AuthSession.UserId);
        await InvokeAsync(StateHasChanged);
    }

    private void OpenBusinessMode()
        => Navigation.NavigateTo(WebNavigationCatalog.GetBusinessHome(AuthSession.CurrentTheme.ThemeCode));

    private void OpenCommunityMode()
        => Navigation.NavigateTo(WebLocalePolicy.LocalizedCommunityHome(Locale.LanguageCode));

    private void OpenCommunityCompose()
        => Navigation.NavigateTo("/community/write");

    private void HandleStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthSession.Changed -= HandleStateChanged;
        PersonalPreferences.Changed -= HandleStateChanged;
        Locale.Changed -= HandleStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
