@inherits LayoutComponentBase
@implements IDisposable
@inject WebAuthSessionService AuthSession
@inject WebLocalePreferenceService Locale
@inject NavigationManager Navigation

<MudLayout Class="@CurrentTheme.ShellClass">
    <MudAppBar Elevation="1" Color="Color.Default" Dense="true" Class="web-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" Color="Color.Inherit" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="web-app-title">
            <span class="web-app-title__full">@Locale.Text("살뜰 통합 베타", "Ssalddel Integrated Beta", "Ssalddel 統合ベータ")</span>
            <span class="web-app-title__compact">@Locale.Text("살뜰", "Ssalddel", "Ssalddel")</span>
        </MudText>
        <MudSpacer />
        <WebLanguageSwitcher />
        @if (AuthSession.IsLoggedIn)
        {
            <MudTooltip Text="@($"{AuthSession.UserName ?? AuthSession.UserId} 로그아웃")">
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               aria-label="로그아웃"
                               OnClick="LogoutAsync" />
            </MudTooltip>
        }
        else
        {
            <MudButton Href="@LoginHref"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Login">
                @Locale.Text("로그인", "Sign in", "ログイン")
            </MudButton>
        }
        <MudChip T="string" Class="web-role-chip" Variant="Variant.Filled" Size="Size.Small">@CurrentRoleLabel</MudChip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive" Class="web-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="web-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="py-4">
            <PreviewPortalBar />
            @if (_sessionInitialized)
            {
                <PageReturnContextBar />
                @Body
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8" aria-live="polite">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">로그인 상태를 확인하는 중입니다.</MudText>
                </MudStack>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _sessionInitialized;
    private WebRoleTheme CurrentTheme => AuthSession.CurrentTheme;
    private string LoginHref
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var returnUrl = string.IsNullOrWhiteSpace(relativePath) ? "/" : $"/{relativePath}";
            return returnUrl.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
                ? "/login"
                : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
    }
    private string CurrentRoleLabel
        => Locale.IsKorean
            ? CurrentTheme.RoleLabel
            : CurrentTheme.RoleLabel switch
            {
                "방문자" => "Visitor",
                "화주" => "Shipper",
                "기사" => "Driver",
                "창고 관리자" => "Warehouse manager",
                "주문자" => "Orderer",
                "관세사" => "Customs broker",
                _ => CurrentTheme.RoleLabel
            };

    protected override void OnInitialized()
    {
        AuthSession.Changed += HandleAuthChanged;
        Locale.Changed += HandleLocaleChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AuthSession.RestoreAsync();
            await Locale.InitializeAsync();
        }
        finally
        {
            _sessionInitialized = true;
            StateHasChanged();
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task LogoutAsync()
    {
        await AuthSession.ClearAsync();
        Navigation.NavigateTo("/login");
    }

    private void HandleAuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await Locale.InitializeAsync();
            StateHasChanged();
        });
    }

    private void HandleLocaleChanged()
        => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(() => Locale.InitializeAsync());

    public void Dispose()
    {
        AuthSession.Changed -= HandleAuthChanged;
        Locale.Changed -= HandleLocaleChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
