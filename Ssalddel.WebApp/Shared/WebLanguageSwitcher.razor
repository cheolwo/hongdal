@implements IDisposable
@inject WebLocalePreferenceService Locale

<div class="web-language-switcher" role="group" aria-label="@Locale.Text("화면 언어", "Display language")">
    <MudButton Variant="@KoreanVariant"
               Color="Color.Primary"
               Size="Size.Small"
               Disabled="@_changing"
               OnClick="SelectKoreanAsync">
        한국어
    </MudButton>
    <span aria-hidden="true">|</span>
    <MudButton Variant="@EnglishVariant"
               Color="Color.Primary"
               Size="Size.Small"
               Disabled="@_changing"
               OnClick="SelectEnglishAsync">
        English
    </MudButton>
</div>

@if (!string.IsNullOrWhiteSpace(Locale.LastPersistenceError))
{
    <span class="web-language-switcher__error" role="status">
        @Locale.Text("계정에는 저장하지 못했지만 이 브라우저에는 적용했습니다.",
            "Applied in this browser, but could not save it to the account.")
    </span>
}

<style>
    .web-language-switcher {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        white-space: nowrap;
    }

    .web-language-switcher .mud-button-root {
        min-width: auto;
        padding-inline: 7px;
    }

    .web-language-switcher__error {
        max-width: 220px;
        color: var(--mud-palette-error);
        font-size: 0.68rem;
        line-height: 1.25;
    }
</style>

@code {
    private bool _changing;
    private Variant KoreanVariant => Locale.IsEnglish ? Variant.Text : Variant.Filled;
    private Variant EnglishVariant => Locale.IsEnglish ? Variant.Filled : Variant.Text;

    protected override void OnInitialized()
        => Locale.Changed += HandleLocaleChanged;

    private Task SelectKoreanAsync() => SelectAsync("ko-KR");
    private Task SelectEnglishAsync() => SelectAsync("en-US");

    private async Task SelectAsync(string languageCode)
    {
        _changing = true;
        try
        {
            await Locale.SelectAsync(languageCode);
        }
        finally
        {
            _changing = false;
        }
    }

    private void HandleLocaleChanged()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
        => Locale.Changed -= HandleLocaleChanged;
}
