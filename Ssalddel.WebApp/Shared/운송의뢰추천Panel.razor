<MudPaper Elevation="0" Outlined="true" Class="pa-3">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2">화물 기반 추천</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@ViewModel.추천운송설명</MudText>
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.AutoFixHigh"
                       OnClick="ApplyAsync">
                추천값 적용
            </MudButton>
        </MudStack>

        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                권장 운송: @ViewModel.권장운송방식
            </MudChip>
            @foreach (var 차량 in ViewModel.추천차량종류목록)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @차량
                </MudChip>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public 운송의뢰작성ViewModel ViewModel { get; set; } = default!;
    [Parameter] public EventCallback OnApplied { get; set; }

    private async Task ApplyAsync()
    {
        ViewModel.화물기반추천적용();
        await OnApplied.InvokeAsync();
    }
}
