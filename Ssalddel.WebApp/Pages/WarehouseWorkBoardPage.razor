@page "/warehouse/work-board"
@page "/work-board"

<PageTitle>창고 작업 진입점</PageTitle>

<WebPageHeader Eyebrow="Warehouse Web · 2.5"
               Title="창고 작업 진입점"
               Description="고정 샘플 작업을 표시하지 않고, 서버 원장과 stable ID를 사용하는 목적별 화면으로 이동합니다."
               Badge="읽기 전용 허브" />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    이 허브는 작업 상태를 바꾸지 않습니다. 목록·상세 조회 뒤 정확한 작업의 실행 화면에서만 상태 전이를 요청합니다.
</MudAlert>

<WebPageLinkGrid Items="WorkLinks" />

@code {
    private static readonly IReadOnlyList<WebAppPageLink> WorkLinks =
    [
        new("입고 상품 확인", "상품 바코드로 입고 예정 상품을 찾고 현장 반입 요청을 별도로 기록합니다.", WarehouseManagerRoutes.InboundProductScan, Icons.Material.Filled.QrCodeScanner, "입고"),
        new("입고 검수", "검수 대상 목록에서 stable ID 상세를 연 뒤 기록 화면으로 이동합니다.", WarehouseManagerRoutes.InboundInspection, Icons.Material.Filled.FactCheck, "검수"),
        new("재고 현황", "현재 계정이 접근 가능한 재고와 입고 근거를 읽기 전용으로 조회합니다.", WarehouseManagerRoutes.GeneralInventory, Icons.Material.Filled.Warehouse, "재고"),
        new("적재 작업", "검수 완료 재고의 보관 위치 확정 화면으로 이동합니다.", WarehouseManagerRoutes.PutAwayTask, Icons.Material.Filled.Inventory, "적재"),
        new("피킹 작업", "서버에 배정된 피킹 작업 목록과 stable-key 실행 화면을 엽니다.", WarehouseManagerRoutes.PickingBatch, Icons.Material.Filled.Inventory2, "피킹"),
        new("포장 작업", "적재 완료 재고의 포장 사실 기록 화면을 엽니다.", WarehouseManagerRoutes.PackingTask, Icons.Material.Filled.AllInbox, "포장"),
        new("출고예정 검토", "포장·수량·출발지와 운송의뢰 필수 입력을 읽기 전용으로 검토합니다.", WarehouseManagerRoutes.OutboundPlanReview, Icons.Material.Filled.Checklist, "출고"),
        new("출고 인계 준비", "검토된 포장 재고를 출고예정 원장에 기록하는 독립 화면을 엽니다.", WarehouseManagerRoutes.GeneralTransportHandoff, Icons.Material.Filled.LocalShipping, "출고")
    ];
}
