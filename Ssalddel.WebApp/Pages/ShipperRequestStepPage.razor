@page "/shipper/request/cargo"
@page "/shipper/request/transport"
@page "/shipper/request/procedure"
@page "/shipper/request/summary"
@inject 운송의뢰작성ViewModel 작성상태
@inject NavigationManager Navigation
@inject 운송의뢰자동저장Service 자동저장Service

<WebPageHeader Eyebrow="Shipper Web"
               Title="@PageTitleText"
               Description="입력 항목을 나눠서 보고 싶은 사용자를 위한 선택형 단계 입력입니다."
               Badge="선택 모드" />

<MudGrid @onfocusout="AutoSaveDraftAsync">
    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            @if (CurrentStep == "cargo")
            {
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">화물 정보</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.화물종류" Label="화물 종류" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="작성상태.화물적재형태" Label="화물 적재 형태" Variant="Variant.Outlined">
                                @foreach (var 적재형태 in 운송의뢰작성ViewModel.화물적재형태목록)
                                {
                                    <MudSelectItem Value="@적재형태">@적재형태</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="작성상태.온도조건" Label="온도 조건" Variant="Variant.Outlined" Clearable="true">
                                <MudSelectItem Value="@("상온")">상온</MudSelectItem>
                                <MudSelectItem Value="@("냉장")">냉장</MudSelectItem>
                                <MudSelectItem Value="@("냉동")">냉동</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="작성상태.화물설명"
                                          Label="화물 설명"
                                          Lines="3"
                                          Variant="Variant.Outlined"
                                          Placeholder="예: 삼겹살 3kg 단위 묶음, 파손 주의 상품 등" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="int?" @bind-Value="작성상태.화물수량" Label="수량" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="decimal?" @bind-Value="작성상태.화물중량Kg" Label="중량 kg" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="decimal?" @bind-Value="작성상태.화물부피Cbm" Label="부피 cbm" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudButton Href="/shipper/request" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                            한 화면 입력
                        </MudButton>
                        <MudButton Href="/shipper/request/transport" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">
                            운송 정보
                        </MudButton>
                    </MudStack>
                </MudStack>
            }
            else if (CurrentStep == "transport")
            {
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">운송 정보</MudText>
                    <Ssalddel운송정보입력정책Panel 화물적재형태="@작성상태.화물적재형태" />

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.상차도로명주소" Label="상차 도로명 주소" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.상차상세주소" Label="상차 상세 주소" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.상차연락처이름" Label="상차 담당자" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.상차연락처전화번호" Label="상차 담당자 연락처" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.하차도로명주소" Label="하차 도로명 주소" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.하차상세주소" Label="하차 상세 주소" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.하차연락처이름" Label="하차 담당자" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.하차연락처전화번호" Label="하차 담당자 연락처" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="작성상태.운송방식" Label="운송 방식" Variant="Variant.Outlined">
                                <MudSelectItem Value="@("혼적")">혼적</MudSelectItem>
                                <MudSelectItem Value="@("단독")">단독</MudSelectItem>
                                <MudSelectItem Value="@("세대 배송")">세대 배송</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="작성상태.서비스레벨" Label="서비스 수준" Variant="Variant.Outlined" Clearable="true">
                                <MudSelectItem Value="@("일반")">일반</MudSelectItem>
                                <MudSelectItem Value="@("당일")">당일</MudSelectItem>
                                <MudSelectItem Value="@("예약")">예약</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="작성상태.요청사항" Label="요청 사항" Lines="3" Variant="Variant.Outlined" HelperText="@작성상태.요청사항입력힌트" />
                        </MudItem>
                    </MudGrid>

                    @if (작성상태.운송정보경고목록.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            @foreach (var warning in 작성상태.운송정보경고목록)
                            {
                                <div>@warning</div>
                            }
                        </MudAlert>
                    }

                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudButton Href="/shipper/request/cargo" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                            화물 정보
                        </MudButton>
                        <MudButton Href="/shipper/request/procedure" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">
                            절차/결제 정보
                        </MudButton>
                    </MudStack>
                </MudStack>
            }
            else if (CurrentStep == "procedure")
            {
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">절차/결제 정보</MudText>
                    <운송의뢰추천Panel ViewModel="작성상태" OnApplied="AutoSaveDraftAsync" />
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="작성상태.차량종류" Label="차량 종류" Variant="Variant.Outlined" Required="true">
                                @foreach (var 차량 in VehicleTypes)
                                {
                                    <MudSelectItem Value="@차량">@차량</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal?" @bind-Value="작성상태.예상거리Km" Label="예상 거리 km" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <Ssalddel결제수단선택Buttons @bind-Value="작성상태.결제수단" />
                        </MudItem>
                        <MudItem xs="12">
                            <운송의뢰결제후속절차Panel ViewModel="작성상태" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="int?" @bind-Value="작성상태.결제예정금액" Label="결제 예정 금액" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal?" @bind-Value="작성상태.기준운임" Label="기준 운임" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="int?" @bind-Value="작성상태.기사지급예정운임" Label="기사 지급 예정 운임" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="decimal?" @bind-Value="작성상태.대기료" Label="대기료" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="decimal?" @bind-Value="작성상태.수작업비" Label="수작업비" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="decimal?" @bind-Value="작성상태.할증" Label="할증" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="int" @bind-Value="작성상태.알선단계" Label="알선 단계" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="작성상태.알선소Id" Label="알선소 ID" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Value="작성상태.재알선금지" Label="재알선 금지" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="작성상태.절차메모" Label="절차 메모" Lines="3" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudButton Href="/shipper/request/transport" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                            운송 정보
                        </MudButton>
                        <MudButton Href="/shipper/request/summary" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.FactCheck">
                            작성 요약
                        </MudButton>
                    </MudStack>
                </MudStack>
            }
            else
            {
                <MudStack Spacing="3">
                    @if (!작성상태.서버등록가능)
                    {
                        <MudAlert Severity="Severity.Warning">
                            아직 서버 등록 전에 보완해야 하는 필수 입력이 있습니다.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success">
                            서버 운송 의뢰 등록에 필요한 필수 입력이 채워졌습니다.
                        </MudAlert>
                    }

                    <MudText Typo="Typo.h6">작성 요약</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2">화물</MudText>
                            <MudText Typo="Typo.body2">@작성상태.화물종류 · @작성상태.화물적재형태 · @(작성상태.화물수량)개 · @(작성상태.화물중량Kg) kg</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2">운송 구간</MudText>
                            <MudText Typo="Typo.body2">@작성상태.상차도로명주소 → @작성상태.하차도로명주소</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2">결제/운임</MudText>
                            <MudText Typo="Typo.body2">@작성상태.결제수단 · @작성상태.결제예정금액?.ToString("N0")원</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2">절차</MudText>
                            <MudText Typo="Typo.body2">@작성상태.차량종류 · 알선 @(작성상태.알선단계)단계</MudText>
                        </MudItem>
                    </MudGrid>

                    <운송의뢰검증Panel ViewModel="작성상태" />

                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudButton Href="/shipper/request/procedure" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                            절차/결제 정보
                        </MudButton>
                        <MudButton Href="/shipper/request" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ViewAgenda">
                            한 화면에서 최종 확인
                        </MudButton>
                    </MudStack>
                </MudStack>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <운송의뢰작성요약Panel ViewModel="작성상태" />
            @if (!string.IsNullOrWhiteSpace(AutoSaveMessage))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@AutoSaveMessage</MudText>
            }
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">입력 모드</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        기본은 한 화면 입력입니다. 단계별 입력값은 같은 초안으로 이어집니다.
                    </MudText>
                    <MudButton Href="/shipper/request"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ViewAgenda">
                        한 화면 입력으로 돌아가기
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<string> VehicleTypes =
    [
        "오토바이 퀵",
        "1톤 카고",
        "1.4톤 윙바디",
        "2.5톤 탑차",
        "냉동탑차",
        "5톤 트럭",
        "컨테이너 트레일러"
    ];

    private bool AutoSaveReady { get; set; }
    private string AutoSaveMessage { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var restored = await 자동저장Service.LoadAsync();
        if (restored is not null)
        {
            작성상태.ApplyDraft(restored);
            AutoSaveMessage = $"자동 저장 초안을 복구했습니다. 저장 시각: {restored.작성일시:MM-dd HH:mm}";
        }

        AutoSaveReady = true;
        StateHasChanged();
    }

    private async Task AutoSaveDraftAsync()
    {
        if (!AutoSaveReady)
        {
            return;
        }

        await 자동저장Service.SaveAsync(작성상태);
        AutoSaveMessage = $"자동 저장됨: {DateTime.Now:HH:mm:ss}";
    }

    private string CurrentStep
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
            if (path.EndsWith("transport", StringComparison.OrdinalIgnoreCase))
            {
                return "transport";
            }

            if (path.EndsWith("procedure", StringComparison.OrdinalIgnoreCase))
            {
                return "procedure";
            }

            if (path.EndsWith("summary", StringComparison.OrdinalIgnoreCase))
            {
                return "summary";
            }

            return "cargo";
        }
    }

    private string PageTitleText => CurrentStep switch
    {
        "transport" => "운송 의뢰 작성 - 운송 정보",
        "procedure" => "운송 의뢰 작성 - 절차/결제 정보",
        "summary" => "운송 의뢰 작성 - 작성 요약",
        _ => "운송 의뢰 작성 - 화물 정보"
    };
}
