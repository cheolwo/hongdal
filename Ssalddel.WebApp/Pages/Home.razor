@page "/"

<PageTitle>살뜰 01~05 역할별 WebApp</PageTitle>

<main class="role-experience @SelectedRole.ThemeClass">
    <header class="role-experience__header">
        <div>
            <span>SSALDDEL · ROLE WEBAPPS 01—05</span>
            <h1>필요한 역할 앱만 가볍게 엽니다</h1>
            <p>01 커뮤니티, 02 주문자, 03 화주, 04 기사, 05 창고를 서로 다른 WebAssembly 앱으로 분리했습니다. 선택한 역할의 화면만 내려받고 다른 역할은 앱을 전환할 때 엽니다.</p>
        </div>
        <MudButton Href="/roles/01/"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Forum"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Class="role-experience__header-action">
            01 커뮤니티 시작
        </MudButton>
    </header>

    <nav class="role-experience__selector" aria-label="01~05 역할 WebApp 선택">
        @foreach (var role in WebExperienceCatalog.Roles)
        {
            var isSelected = role.Key == SelectedRole.Key;
            var roleState = IntegratedBetaCatalog.Resolve(role.StartHref);
            <button type="button"
                    class="role-experience__role-button @(isSelected ? "is-selected" : null)"
                    aria-pressed="@isSelected"
                    @onclick="@(() => SelectRole(role))">
                <span class="role-experience__role-icon">
                    <MudIcon Icon="@role.Icon" Size="Size.Small" />
                </span>
                <span class="role-experience__role-copy">
                    <small>@role.Eyebrow[..2]</small>
                    <strong>@role.Title</strong>
                </span>
                <span class="role-experience__stage-pill @IntegratedBetaCatalog.StageCssClass(roleState.Stage)">
                    @roleState.StageLabel
                </span>
            </button>
        }
    </nav>

    <section class="role-experience__workspace" aria-live="polite">
        <div class="role-experience__screens">
            <div class="role-experience__screens-heading">
                <div>
                    <span>FIGMA PAGE · @SelectedRole.Eyebrow</span>
                    <h2>@SelectedRole.Title</h2>
                    <p>@SelectedRole.Description</p>
                    <div class="role-experience__selected-status">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@IntegratedBetaCatalog.StageColor(SelectedRoleState.Stage)"
                                 Variant="Variant.Outlined"
                                 Icon="@IntegratedBetaCatalog.StageIcon(SelectedRoleState.Stage)">
                            @SelectedRoleState.StageLabel
                        </MudChip>
                        <span>@SelectedRoleState.BoundaryLabel · @SelectedRoleState.AccessLabel</span>
                    </div>
                </div>
                <MudButton Href="@SelectedRole.AppHref"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@SelectedRole.Icon"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    @SelectedRole.StartLabel
                </MudButton>
            </div>

            <div class="role-experience__screen-list">
                @foreach (var screen in SelectedRole.Screens)
                {
                    var screenState = IntegratedBetaCatalog.Resolve(screen.Href);
                    <a class="role-experience__screen-link"
                       href="@SelectedRole.HrefFor(screen.Href)"
                       title="@screenState.Notice">
                        <span class="role-experience__screen-icon">
                            <MudIcon Icon="@screen.Icon" Size="Size.Small" />
                        </span>
                        <span class="role-experience__screen-copy">
                            <span class="role-experience__screen-step">@screen.AreaLabel</span>
                            <strong>@screen.Title</strong>
                            <small>@screen.Description</small>
                        </span>
                        <span class="role-experience__screen-meta">
                            <span class="role-experience__stage-pill @IntegratedBetaCatalog.StageCssClass(screenState.Stage)">
                                @screenState.StageLabel
                            </span>
                            <small>@screenState.BoundaryLabel · @screenState.AccessLabel</small>
                        </span>
                        <span class="role-experience__screen-arrow">
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </span>
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="role-experience__release" aria-labelledby="integrated-release-title">
        <div class="role-experience__release-heading">
            <div>
                <span>RELEASE STATUS</span>
                <h2 id="integrated-release-title">01~05 독립 앱 구성 현황</h2>
                <p>@(RepresentativeScreenCount)개 대표 화면을 다섯 역할의 독립 진입점으로 연결했습니다.</p>
            </div>
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.Hub">
                @(WebExperienceCatalog.Roles.Count)개 역할
            </MudChip>
        </div>

        <div class="role-experience__release-grid">
            @foreach (var stage in IntegratedBetaCatalog.StageOrder)
            {
                <article class="role-experience__release-card @IntegratedBetaCatalog.StageCssClass(stage)">
                    <span class="role-experience__release-icon">
                        <MudIcon Icon="@IntegratedBetaCatalog.StageIcon(stage)" Size="Size.Small" />
                    </span>
                    <strong>@StageCount(stage)</strong>
                    <span>@IntegratedBetaPageState.StageLabelFor(stage)</span>
                    <small>@IntegratedBetaPageState.StageDescriptionFor(stage)</small>
                </article>
            }
        </div>

        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined"
                  Icon="@Icons.Material.Filled.Security"
                  Class="role-experience__release-notice">
            역할 앱을 나누어도 실제 실행 경계는 <strong>SsalddelExecution:Mode</strong> 한 곳을 따릅니다.
            유상 화물 추천·자동 배차·계약 확정·실결제·실정산·실보관은 활성화하지 않으며, 관련 화면은 Simulation 또는 준비 중으로 표시합니다.
        </MudAlert>
    </section>
</main>

@code {
    private WebExperienceRole SelectedRole { get; set; } = WebExperienceCatalog.DefaultRole;

    private IntegratedBetaPageState SelectedRoleState
        => IntegratedBetaCatalog.Resolve(SelectedRole.StartHref);

    private static int RepresentativeScreenCount
        => WebExperienceCatalog.Roles
            .SelectMany(role => role.Screens)
            .Select(screen => screen.Href)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private static int StageCount(IntegratedBetaStage stage)
        => WebExperienceCatalog.Roles
            .SelectMany(role => role.Screens)
            .DistinctBy(screen => screen.Href, StringComparer.OrdinalIgnoreCase)
            .Count(screen => IntegratedBetaCatalog.Resolve(screen.Href).Stage == stage);

    private void SelectRole(WebExperienceRole role)
    {
        SelectedRole = role;
    }
}
