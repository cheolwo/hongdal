<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">이동</MudText>
        <MudButton Href="@($"/driver/transports/{TransportId}/dropoff")"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Flag">
            하차 처리로
        </MudButton>
        <MudButton Href="/driver/transports/current"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.LocalShipping">
            진행 중 운송으로
        </MudButton>
        <MudButton Href="@($"/driver/transport/proof?transportId={TransportId}")"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PhotoCamera">
            통합 증빙 화면
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public long TransportId { get; set; }
}
