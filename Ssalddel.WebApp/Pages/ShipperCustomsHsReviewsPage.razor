@page "/shipper/customs/hs-reviews"
@inject NavigationManager Navigation

<PageTitle>HS 코드 검토</PageTitle>

<WebPageHeader Eyebrow="Shipper Web"
               Title="HS 코드 검토"
               Description="활성 HS 코드 원장, 공식 공개 분류사례와 공개 동의된 대행 경험을 한 ID 기준으로 확인합니다."
               Badge="읽기 전용 베타" />

<ShipperHsCodeReviewWorkspace ReviewId="@ReviewId"
                              ReviewSelected="HandleReviewSelected" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "reviewId")]
    public long? ReviewId { get; set; }

    private void HandleReviewSelected(long reviewId)
    {
        if (ReviewId == reviewId)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/shipper/customs/hs-reviews?reviewId={reviewId}",
            replace: true);
    }
}
