@page "/driver/notifications"
@inject NavigationManager Navigation

<WebPageHeader Eyebrow="살뜰 2.0 · 기사"
               Title="알림 연결"
               Description="실제 수신 payload를 추천·현재 운송·상차·하차·정산의 전용 화면으로 연결합니다."
               Badge="읽기 전용 딥링크" />

<MudStack Spacing="3">
    @if (HasIncomingPayload)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@IncomingDisplayType</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@IncomingPayloadSummary</MudText>
                    </MudStack>
                    <MudButton Href="@IncomingHref"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@IncomingActionIcon">
                        @IncomingActionLabel
                    </MudButton>
                </MudStack>
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                    이 화면은 알림을 근거로 상태를 바꾸지 않습니다. 대상 화면의 서버 조회와 권한 검증을 거쳐 다음 행동을 결정합니다.
                </MudAlert>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            영속 알림 목록 API는 아직 2.0 배포 후보에 연결되지 않았습니다. 실제 알림이 없는 상태에서 샘플 알림을 최근 알림처럼 표시하지 않습니다.
        </MudAlert>
    }

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">기사 업무로 이동</MudText>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudButton Href="@DriverRoutes.Recommendations"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Route">
                    추천 목록
                </MudButton>
                <MudButton Href="@DriverRoutes.CurrentTransport"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.LocalShipping">
                    현재 운송
                </MudButton>
                <MudButton Href="@DriverRoutes.NotificationSettings"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Settings">
                    알림 설정
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? PayloadType { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public string? RequestId { get; set; }

    [SupplyParameterFromQuery(Name = "transportId")]
    public long? TransportId { get; set; }

    [SupplyParameterFromQuery(Name = "open")]
    public bool AutoOpen { get; set; }

    private bool autoOpened;
    private bool HasIncomingPayload => !string.IsNullOrWhiteSpace(PayloadType);
    private string IncomingDisplayType => DriverNotificationDeepLinkResolver.ResolveDisplayType(PayloadType);
    private string IncomingActionLabel => DriverNotificationDeepLinkResolver.ResolveActionLabel(PayloadType);
    private string IncomingActionIcon => DriverNotificationPresentation.ResolveActionIcon(PayloadType);
    private string IncomingHref => DriverNotificationDeepLinkResolver.ResolveHref(PayloadType, RequestId, TransportId);
    private string IncomingPayloadSummary => DriverNotificationPresentation.BuildPayloadSummary(PayloadType, RequestId, TransportId);

    protected override void OnParametersSet()
        => autoOpened = false;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (AutoOpen && HasIncomingPayload && !autoOpened)
        {
            autoOpened = true;
            Navigation.NavigateTo(IncomingHref);
        }

        return Task.CompletedTask;
    }
}
