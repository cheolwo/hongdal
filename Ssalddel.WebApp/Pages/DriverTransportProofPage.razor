@page "/driver/transport/proof"
@inherits MvvmComponentBase<DriverTransportProofPageViewModel>
@using Ssalddel.WebApp.Pages.DriverTransportProof
@using Ssalddel.WebApp.ViewModels

<WebPageHeader Eyebrow="Driver Web"
               Title="상하차 증빙/예외 처리"
               Description="사진 업로드 응답을 받은 뒤에만 상차 완료와 하차 완료 상태를 서버에 반영하는 흐름을 검증합니다."
               Badge="증빙 API" />

<MudGrid>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <DriverTransportProofTargetPanel Model="@ViewModel" />

            @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
            {
                <MudAlert Severity="@ResolveStatusSeverity(ViewModel.StatusTone)" Variant="Variant.Outlined">
                    @ViewModel.StatusMessage
                </MudAlert>
            }

            <DriverTransportProofStatePanel Model="@ViewModel" />
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudTabs Rounded="true" Elevation="0">
                <MudTabPanel Text="상차 증빙">
                    <DriverPickupProofEditor Model="@ViewModel.Pickup" IsBusy="@ViewModel.IsBusy" />
                </MudTabPanel>
                <MudTabPanel Text="하차 증빙">
                    <DriverDropoffProofEditor Model="@ViewModel.Dropoff" IsBusy="@ViewModel.IsBusy" />
                </MudTabPanel>
                <MudTabPanel Text="예외 신고">
                    <DriverTransportIssueEditor Model="@ViewModel.Issue" IsBusy="@ViewModel.IsBusy" />
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "transportId")]
    public long? TransportIdFromQuery { get; set; }

    protected override void OnParametersSet()
        => ViewModel.ConfigureTransportId(TransportIdFromQuery);

    private static Severity ResolveStatusSeverity(DriverTransportProofMessageTone tone)
        => tone switch
        {
            DriverTransportProofMessageTone.Success => Severity.Success,
            DriverTransportProofMessageTone.Warning => Severity.Warning,
            DriverTransportProofMessageTone.Error => Severity.Error,
            _ => Severity.Info
        };
}
