@page "/shipper"
@using Ssalddel.Ui.Common.Areas.App.Components.Shipper
@inject WebAuthSessionService AuthSession

<ShipperHomeScreen @ref="homeScreen"
                   TransportHref="@ShipperRoutes.Request"
                   WarehouseHref="@ShipperRoutes.WarehouseWorkspace"
                   SalesHref="@ShipperRoutes.SalesOrders"
                   InternationalHref="@ShipperRoutes.FclLclPlanner"
                   LoginHref="/login">
    <AdditionalTools>
        <ShipperHomeWebToolDirectory />
    </AdditionalTools>
</ShipperHomeScreen>

@code {
    private ShipperHomeScreen? homeScreen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.RestoreAsync();
        if (homeScreen is not null)
        {
            await homeScreen.RefreshAsync();
        }
    }
}
