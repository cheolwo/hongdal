@page "/shipper/sales/orders"
@inject NavigationManager Navigation

<PageTitle>판매채널 주문 출고 후보</PageTitle>

<WebPageHeader Eyebrow="Shipper Web"
               Title="판매채널 주문 출고 후보"
               Description="외부 주문을 새로 수집하지 않고 내 원장에 영속된 재고 예약·출고 후보를 조회합니다."
               Badge="읽기 전용 베타" />

<ShipperSalesOrderWorkspace OrderId="@OrderId"
                            OrderSelected="HandleOrderSelected" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "orderId")]
    public long? OrderId { get; set; }

    private void HandleOrderSelected(long orderId)
    {
        if (OrderId == orderId)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/shipper/sales/orders?orderId={orderId}",
            replace: true);
    }
}
