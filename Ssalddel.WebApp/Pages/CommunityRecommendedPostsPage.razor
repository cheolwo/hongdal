@page "/community/posts/recommended"
@inject NavigationManager Navigation

<PageTitle>@RouteContext.WorkspaceTitle</PageTitle>

@if (IsLegacyDetailLink)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-8" aria-live="polite">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText>추천 게시글 상세 화면으로 이동하고 있습니다.</MudText>
    </MudStack>
}
else
{
    <CommunityRoutePageFrame BackHref="@RouteContext.BackHref"
                             BackLabel="@RouteContext.BackLabel"
                             Eyebrow="@RouteContext.WorkspaceEyebrow"
                             Heading="@RouteContext.WorkspaceHeading"
                             Description="@RouteContext.WorkspaceDescription"
                             ShowComposeAction="true"
                             ComposeHref="@CommunityPageRoutes.ComposeFor(QueryBoardName)">
        <CommunityRecommendedPostListScreen AppName="살뜰"
                                            RoleLabel="웹 사용자"
                                            AppKey="shipper"
                                            BoardName="@QueryBoardName" />
    </CommunityRoutePageFrame>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "seed")]
    public string? LegacySeedPostTitle { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "board")]
    public string? QueryBoardName { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "boardKey")]
    public string? QueryBoardKey { get; set; }

    private bool IsLegacyDetailLink => !string.IsNullOrWhiteSpace(LegacySeedPostTitle);

    private CommunityWorkspaceRouteContext RouteContext
        => CommunityWorkspaceRouteContext.Resolve(
            CommunityPageRoutes.RecommendedPosts,
            null,
            null,
            null,
            QueryBoardName,
            QueryBoardKey,
            null);

    protected override void OnParametersSet()
    {
        if (IsLegacyDetailLink)
        {
            Navigation.NavigateTo(
                CommunityPageRoutes.RecommendedPostDetailFor(LegacySeedPostTitle!, QueryBoardName),
                replace: true);
        }
    }
}
