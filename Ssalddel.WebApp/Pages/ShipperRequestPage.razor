@page "/shipper/request"
@inject ShipperRequestAuthoringPageViewModel PageModel
@inject NavigationManager Navigation

<PageTitle>운송 의뢰 작성</PageTitle>

<ShipperRequestAuthoringScreen ViewModel="PageModel.State"
                               NavigationContext="RouteContext"
                               VehicleTypes="PageModel.VehicleTypes"
                               RegistrationEnabled="PageModel.RegistrationEnabled"
                               RegistrationBoundaryMessage="@PageModel.RegistrationBoundaryMessage"
                               StatusMessage="@PageModel.StatusMessage"
                               StatusSeverity="PageModel.StatusSeverity"
                               AutoSaveMessage="@PageModel.AutoSaveMessage"
                               IsBusy="PageModel.IsBusy"
                               BulkHref="@ShipperRequestPageRoutes.Bulk"
                               CommunityConsultationHref="@CommunityConsultationHref"
                               Changed="PageModel.AutoSaveAsync"
                               SaveRequested="PageModel.SaveAsync"
                               ResetRequested="PageModel.ResetAsync"
                               SubmitRequested="PageModel.SubmitAsync"
                               RetryRegistrationCheck="PageModel.LoadTransportRegistrationAvailabilityAsync">
    <BeforeContent>
        @if (RouteContext.SourcePostId is > 0)
        {
            <ShipperRequestSourcePostImportPanel PageModel="PageModel"
                                                 ReturnPath="@RouteContext.RootPath"
                                                 Applied="RefreshAsync" />
        }
    </BeforeContent>
</ShipperRequestAuthoringScreen>

@code {
    private ShipperRequestNavigationContext RouteContext
        => ShipperRequestNavigationContext.Parse(Navigation.Uri);

    private string CommunityConsultationHref
        => CommunityPageRoutes.ComposeFor(
            boardName: "화물",
            boardKey: CommunityBoardKeys.Cargo,
            returnPath: RouteContext.RootPath);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PageModel.InitializeAsync(RouteContext);
        StateHasChanged();
    }

    private Task RefreshAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
