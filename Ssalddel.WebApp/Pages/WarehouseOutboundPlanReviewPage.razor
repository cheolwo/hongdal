@page "/warehouse/general/outbound-plan-review"
@page "/work/outbound/plans"
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession
@implements IDisposable

<PageTitle>출고예정 운송 전 검토 · 살뜰</PageTitle>
<WebPageHeader Eyebrow="Warehouse Web" Title="출고예정 운송 전 검토" Description="준비된 출고예정 원장과 운송의뢰 생성 전 필수 입력을 읽기 전용으로 확인합니다." Badge="Beta · ReadOnly" />
@if(!AuthSession.IsLoggedIn){<MudPaper Elevation="0" Outlined="true" Class="pa-6"><MudStack AlignItems="AlignItems.Center" Spacing="2"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" /><MudText Typo="Typo.h6">출고예정 검토에는 로그인이 필요합니다.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">서버에서 창고 배정과 HR 출고 역할을 확인합니다. 익명 허용 커뮤니티는 로그인 없이 이용할 수 있습니다.</MudText><MudStack Row="true"><MudButton Href="/login" Variant="Variant.Filled">로그인</MudButton><MudButton Href="/community" Variant="Variant.Outlined">익명 커뮤니티 보기</MudButton></MudStack></MudStack></MudPaper>}
else{<SsalddelOutboundPlanReviewWorkspace OutboundPlanId="@OutboundPlanId" OnPlanSelected="UpdateRoute" />}

@code {
    [SupplyParameterFromQuery(Name="outboundPlanId")] public long? OutboundPlanId { get; set; }
    protected override void OnInitialized()=>AuthSession.Changed+=AuthChanged;
    private void AuthChanged()=>_=InvokeAsync(StateHasChanged);
    private Task UpdateRoute(long? id){Navigation.NavigateTo(id is>0?$"{WarehouseManagerRoutes.OutboundPlanReview}?outboundPlanId={id}":WarehouseManagerRoutes.OutboundPlanReview,replace:true);return Task.CompletedTask;}
    public void Dispose()=>AuthSession.Changed-=AuthChanged;
}
