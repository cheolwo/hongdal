@page "/driver/transports/{TransportId:long}/pickup"
@inherits MvvmComponentBase<DriverTransportPickupPageViewModel>
@using Ssalddel.WebApp.Pages.DriverTransportProof
@using Ssalddel.WebApp.Pages.DriverTransportPickup
@using Ssalddel.WebApp.ViewModels

<WebPageHeader Eyebrow="Driver Web"
               Title="상차 처리"
               Description="상차지 도착, 상차 사진 업로드, 인수증 확인, 상차 완료를 한 화면에서 처리합니다."
               Badge="상차 전용" />

<MudGrid>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <DriverTransportPickupSummaryPanel Model="@ViewModel" />

            @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
            {
                <MudAlert Severity="@ResolveStatusSeverity(ViewModel.StatusTone)" Variant="Variant.Outlined">
                    @ViewModel.StatusMessage
                </MudAlert>
            }

            <DriverTransportPickupNavigation TransportId="@ViewModel.TransportId" />
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <DriverPickupProofPhotoEditor Model="@ViewModel.Pickup"
                                              IsBusy="@ViewModel.IsBusy"
                                              Description="사진 업로드 응답의 ObjectName이 확인된 뒤에만 상차 완료 처리를 전송합니다." />
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <DriverPickupReceiptEditor Model="@ViewModel.Pickup"
                                           IsBusy="@ViewModel.IsBusy"
                                           ShowCompleteButton="true"
                                           TwoColumnLayout="true" />
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <DriverTransportIssueEditor Model="@ViewModel.Issue"
                                            IsBusy="@ViewModel.IsBusy"
                                            Title="상차 예외 신고"
                                            SubmitLabel="상차 예외 기록"
                                            PreviewAlt="상차 예외 증빙 미리보기" />
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public long TransportId { get; set; }

    protected override Task OnParametersSetAsync()
        => ViewModel.InitializeAsync(TransportId);

    private static Severity ResolveStatusSeverity(DriverTransportProofMessageTone tone)
        => tone switch
        {
            DriverTransportProofMessageTone.Success => Severity.Success,
            DriverTransportProofMessageTone.Warning => Severity.Warning,
            DriverTransportProofMessageTone.Error => Severity.Error,
            _ => Severity.Info
        };
}
