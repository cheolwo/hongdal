@page "/warehouse/bonded-customs"

<PageTitle>보세·통관 상태 · 살뜰 창고</PageTitle>

<RoleFlowSurface Title="보세·통관 상태"
                 Badge="수입"
                 Description="보세 반입부터 검사·신고·반출 가능까지 필요한 근거를 확인하는 준비 화면입니다."
                 Metrics="Metrics"
                 SectionTitle="통관·반출 확인 항목"
                 Items="Checklist"
                 EmptyMessage="확인 항목이 없습니다."
                 NoticeTitle="자격 업무 경계"
                 NoticeDescription="통관 판단과 신고는 자격 있는 관세 전문가가 수행하며 창고는 보관·반입·반출 상태와 근거 문서 연결만 기록합니다."
                 WarningNotice="true"
                 Palette="RoleFlowPalette.Warehouse">
    <ChildContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            보세·통관 상태 원장 API는 아직 연결 전입니다. 아래 항목은 현재 완료 상태가 아니라 확인 순서 안내입니다.
        </MudAlert>
    </ChildContent>
</RoleFlowSurface>

@code {
    private static IReadOnlyList<RoleDashboardMetric> Metrics =>
    [
        new("반입 완료", "—", "원장 연결 전"),
        new("검사 중", "—", "원장 연결 전"),
        new("반출 대기", "—", "원장 연결 전")
    ];

    private static IReadOnlyList<RoleFlowListItem> Checklist =>
    [
        new("입항·반입 확인", "운송·반입 근거 문서와 창고 원장 ID 연결", "확인 필요", Tone: RoleDashboardTone.Default),
        new("보세 운송 신고", "자격 전문가의 신고 결과 참조", "확인 필요", Tone: RoleDashboardTone.Default),
        new("식품 검사 결과", "검사 결과와 대상 로트 연결", "확인 필요", Tone: RoleDashboardTone.Warning),
        new("수입 신고 수리", "반출 가능 여부를 전문가 결과로 확인", "확인 필요", Tone: RoleDashboardTone.Warning)
    ];
}
