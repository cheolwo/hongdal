@page "/shipper/request/payment-status"
@inject NavigationManager Navigation

<PageTitle>운송 의뢰 결제·정산 조회</PageTitle>

<WebPageHeader Eyebrow="살뜰 2.0 · 화주"
               Title="결제·정산 조회"
               Description="운송 의뢰 ID를 받아 해당 원장의 읽기 전용 결제 화면으로 연결합니다."
               Badge="조회 진입 전용" />

<MudGrid>
    <MudItem xs="12" lg="7">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    이 화면에서는 결제 준비·승인, 입금 완료, 후불 승인이나 현장 지급 Command를 실행하지 않습니다.
                    실제 결제와 정산은 운영 승인 전까지 비활성입니다.
                </MudAlert>

                <MudTextField T="string"
                              @bind-Value="RequestId"
                              Label="운송 의뢰 ID"
                              Variant="Variant.Outlined"
                              Placeholder="예: REQ-20260723-001"
                              Immediate="true" />

                @if (!string.IsNullOrWhiteSpace(StatusMessage))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                        @StatusMessage
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@string.IsNullOrWhiteSpace(RequestId)"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="OpenPaymentView">
                        결제·정산 상태 열기
                    </MudButton>
                    <MudButton Href="@ShipperRoutes.RequestDetailLookup"
                               Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.ReceiptLong">
                        의뢰 상세 찾기
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">화면 책임</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                        stable 운송 의뢰 ID 확인
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                        의뢰별 결제 상태 화면 연결
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Block">
                        결제·입금·정산 상태 변경 없음
                    </MudListItem>
                </MudList>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public string? RequestId { get; set; }

    private string StatusMessage { get; set; } = string.Empty;

    private void OpenPaymentView()
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            StatusMessage = "조회할 운송 의뢰 ID를 입력해 주세요.";
            return;
        }

        StatusMessage = string.Empty;
        Navigation.NavigateTo(ShipperRoutes.RequestPaymentFor(RequestId.Trim()));
    }
}
