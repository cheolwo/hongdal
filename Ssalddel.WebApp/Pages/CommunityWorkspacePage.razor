@page "/community/workspace"
@page "/community/write"
@page "/community/posts/{PostId:long}"
@page "/community/posts/recommended"
@implements IDisposable
@inject PlatformDiagramPaletteStateService DiagramPalette
@inject NavigationManager Navigation

<PageTitle>@WorkspaceTitle</PageTitle>

<main class="community-workspace-page">
    <header class="community-workspace-page__context">
        <a href="@BackHref">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            @BackLabel
        </a>
        <div>
            <span>@WorkspaceEyebrow</span>
            <h1>@WorkspaceHeading</h1>
            <p>@WorkspaceDescription</p>
        </div>
        @if (!IsWriteRoute)
        {
            <MudButton Href="/community/write"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit">
                새 글 쓰기
            </MudButton>
        }
    </header>

    @if (IsWorkspaceLandingRoute)
    {
        <nav class="community-workspace-page__sections" aria-label="업무·원장 공간 바로가기">
            <a href="#community-workspace-hub">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" />
                <span><strong>업무 연결</strong><small>필요에 맞는 업무 도구 찾기</small></span>
            </a>
            <a href="#community-ledger-draft">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                <span><strong>원장 초안</strong><small>조건과 진행 흐름 정리하기</small></span>
            </a>
            <a href="#community-board-management">
                <MudIcon Icon="@Icons.Material.Filled.AddComment" Size="Size.Small" />
                <span><strong>게시판 개설</strong><small>새 주제 공간 신청하기</small></span>
            </a>
        </nav>
    }

    <PlatformCommunityHome @key="WorkspaceKey"
                           AppName="살뜰"
                           RoleLabel="웹 사용자"
                           AppKey="shipper"
                           CargoRequestDraftHrefBase="/shipper/request"
                           UseDedicatedCommunityRoutes="true"
                           WorkspaceOnly="@IsWorkspaceLandingRoute"
                           PostDetailOnly="@IsPostDetailRoute"
                           UseBaguaRoleTransitionPages="true"
                           QuickActions="QuickActions"
                           QueryLedgerTemplateKey="@QueryLedgerTemplateKey"
                           QueryDiagramMode="@QueryDiagramMode"
                           QueryPostId="@(PostId ?? QueryPostId)"
                           QuerySeedPostTitle="@QuerySeedPostTitle"
                           QueryBoardName="@QueryBoardName"
                           StartInComposeMode="@IsWriteRoute" />
</main>

@code {
    [Parameter]
    public long? PostId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "postId")]
    public long? QueryPostId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "seed")]
    public string? QuerySeedPostTitle { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "board")]
    public string? QueryBoardName { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "boardKey")]
    public string? QueryBoardKey { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "ledgerTemplate")]
    public string? QueryLedgerTemplateKey { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "diagram")]
    public string? QueryDiagramMode { get; set; }

    private bool IsWriteRoute
        => Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Equals("community/write", StringComparison.OrdinalIgnoreCase);

    private bool IsWorkspaceRoute
        => Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Equals("community/workspace", StringComparison.OrdinalIgnoreCase);

    private bool IsPostDetailRoute
        => EffectivePostId is not null || !string.IsNullOrWhiteSpace(QuerySeedPostTitle);

    private bool IsDiagramRoute => IsTruthyQueryValue(QueryDiagramMode);

    private bool IsWorkspaceLandingRoute
        => IsWorkspaceRoute && !IsPostDetailRoute && !IsDiagramRoute;

    private long? EffectivePostId => PostId ?? QueryPostId;
    private string WorkspaceKey => $"{(IsWriteRoute ? "write" : IsWorkspaceLandingRoute ? "workspace" : "detail")}-{EffectivePostId?.ToString() ?? "none"}-{QuerySeedPostTitle}-{QueryBoardName}-{QueryBoardKey}-{QueryDiagramMode}";
    private string WorkspaceTitle => IsWriteRoute
        ? "글쓰기 · 살뜰 커뮤니티"
        : IsWorkspaceLandingRoute
            ? "업무·원장 공간 · 살뜰 커뮤니티"
            : IsDiagramRoute
                ? "업무 다이어그램 · 살뜰 커뮤니티"
            : "게시글 · 살뜰 커뮤니티";
    private string WorkspaceEyebrow => IsWriteRoute
        ? "COMMUNITY COMPOSE"
        : IsWorkspaceLandingRoute
            ? "COMMUNITY WORKSPACE"
            : IsDiagramRoute
                ? "LEDGER DIAGRAM"
            : "COMMUNITY POST";
    private string WorkspaceHeading => IsWriteRoute
        ? "커뮤니티에 글쓰기"
        : IsWorkspaceLandingRoute
            ? "업무·원장 공간"
            : IsDiagramRoute
                ? "업무 다이어그램"
            : EffectivePostId is long id
                ? $"게시글 #{id:N0}"
                : "추천 게시글";
    private string WorkspaceDescription => IsWriteRoute
        ? "필요한 일과 가능한 일을 알리고, 당사자가 직접 선택하고 합의할 수 있도록 조건을 분명하게 적습니다."
        : IsWorkspaceLandingRoute
            ? "게시판에서 모인 필요를 게시판 운영, 업무 연결과 공동 원장 도구로 차분히 정리합니다."
            : IsDiagramRoute
                ? "공동 원장의 참여자, 상태와 다음 업무를 하나의 흐름으로 확인합니다."
            : "글의 대화와 참여 기록을 확인하고, 합의한 경우에만 공동 원장과 업무 흐름으로 이어갑니다.";
    private string BackHref => IsWorkspaceLandingRoute
        ? "/community"
        : !string.IsNullOrWhiteSpace(QueryBoardKey)
            ? $"/community/boards?boardKey={Uri.EscapeDataString(QueryBoardKey)}"
            : !string.IsNullOrWhiteSpace(QueryBoardName)
                ? $"/community/boards?board={Uri.EscapeDataString(QueryBoardName)}"
                : "/community/boards";
    private string BackLabel => IsWorkspaceLandingRoute ? "공개 커뮤니티" : "글 목록";

    private static readonly IReadOnlyList<PlatformHomeQuickAction> QuickActions =
    [
        new("함께 하는 일", "마음 모으기부터 실행 중 추가 참여와 완료 기록까지 이어서 봅니다.", "/community/actions", Icons.Material.Filled.Groups, Color.Success),
        new("음식 영상 발견", "여러 나라의 음식 영상을 보고 커뮤니티에 정보 글로 나눕니다.", "/community/discover/food", Icons.Material.Filled.SmartDisplay, Color.Error),
        new("글로벌 무역 대화", "해외 공급자와 댓글로 협의한 뒤 수입 주문원장과 업무 다이어그램으로 전환합니다.", GlobalTradeRoutes.CommunityThread(101), Icons.Material.Filled.Language, Color.Info),
        new("공동구매 제안", "제안 글부터 수요 모집, 이의 검토와 전자서명까지 한 흐름으로 진행합니다.", "/community/group-purchase", Icons.Material.Filled.GroupAdd, Color.Success),
        new("운송 단가 질문", "운송 의뢰 작성 중 생성한 초안을 게시판에서 다듬습니다.", "/shipper/request", Icons.Material.Filled.PostAdd, Color.Primary),
        new("기사 경험 보기", "추천 배차와 현장 예외 상황을 기사 관점에서 봅니다.", "/driver/recommendations", Icons.Material.Filled.Route, Color.Info)
    ];

    protected override void OnInitialized()
    {
        DiagramPalette.Changed += HandleDiagramModeChanged;
    }

    protected override void OnParametersSet()
    {
        if (IsTruthyQueryValue(QueryDiagramMode))
        {
            DiagramPalette.SetDiagramMode(true);
        }
    }

    private static bool IsTruthyQueryValue(string? value)
        => !string.IsNullOrWhiteSpace(value) &&
           (value.Equals("1", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("true", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("yes", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("diagram", StringComparison.OrdinalIgnoreCase));

    private void HandleDiagramModeChanged()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
        => DiagramPalette.Changed -= HandleDiagramModeChanged;
}
