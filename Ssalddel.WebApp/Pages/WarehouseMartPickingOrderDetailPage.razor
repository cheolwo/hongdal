@page "/warehouse/mart/picking/orders/{OrderId:long}"
@page "/mart/picking/orders/{OrderId:long}"
@inherits MvvmComponentBase<마트피킹작업PageViewModel>
@inject WebAuthSessionService AuthSession

<WebPageHeader Eyebrow="Warehouse Web"
               Title="마트 피킹/포장 주문 상세"
               Description="주소에 지정한 영속 마트 주문 한 건과 접근 가능한 작업만 조회합니다."
               Badge="Beta · ReadOnly" />

@if (!AuthSession.IsLoggedIn)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">창고 업무 로그인이 필요합니다.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                서버가 창고관리자 보안 역할, HR 세부 역할과 접근 가능한 창고 범위를 최종 확인합니다.
            </MudText>
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">
                로그인하러 가기
            </MudButton>
        </MudStack>
    </MudPaper>
}
else if (_initializing)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">주문 #@OrderId 상세를 조회하고 있습니다.</MudText>
        </MudStack>
    </MudPaper>
}
else if (!string.IsNullOrWhiteSpace(_pageError))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText>@_pageError</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RetryAsync">다시 조회</MudButton>
        </MudStack>
    </MudAlert>
}
else
{
    <SsalddelMartPickingOrderDetail Model="@ViewModel.상세"
                                    BackUrl="@WarehouseManagerRoutes.MartPickingPacking" />
}

@code {
    private bool _initializing;
    private long? _loadedOrderId;
    private string? _pageError;

    [Parameter]
    public long OrderId { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AuthSession.Changed += AuthChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthSession.IsLoggedIn && _loadedOrderId != OrderId)
        {
            await LoadAsync();
        }
    }

    private void AuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (AuthSession.IsLoggedIn)
            {
                await LoadAsync(force: true);
            }
            else
            {
                ViewModel.결과초기화();
                _pageError = null;
                _loadedOrderId = null;
            }

            StateHasChanged();
        });
    }

    private async Task LoadAsync(bool force = false)
    {
        if (_initializing || (!force && _loadedOrderId == OrderId))
        {
            return;
        }

        _initializing = true;
        _pageError = null;
        try
        {
            var succeeded = await ViewModel.상세초기화Async(OrderId);
            if (!succeeded)
            {
                _pageError = ViewModel.상세.오류메시지 ?? "마트 피킹 주문 상세를 조회하지 못했습니다.";
            }

            _loadedOrderId = OrderId;
        }
        finally
        {
            _initializing = false;
        }
    }

    private Task RetryAsync() => LoadAsync(force: true);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            AuthSession.Changed -= AuthChanged;
        }

        base.Dispose(disposing);
    }
}
