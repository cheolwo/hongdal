@page "/community/categories"
@page "/community/boards/directory"
@using Ssalddel.WebApp.ViewModels
@inject PlatformCommunityService CommunityService

<PageTitle>게시판 모음 · 살뜰</PageTitle>

<PlatformCommunityReadingThemeFrame>
<main class="community-directory platform-home--classic-forum">
    <header class="community-directory__hero">
        <div class="community-directory__hero-title">
            <span class="community-directory__mountain" aria-label="간괘, 산">☶</span>
            <div>
                <span>GEN ☶ · COMMUNITY MOUNTAINS</span>
                <h1>게시판 산맥</h1>
                <p>일반 대화 게시판과 Command·Event가 묶인 업무단위 산을 한곳에서 조망합니다. 0.0~3.5 버전은 보조 표지입니다.</p>
            </div>
        </div>
        <label class="community-directory__search">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            <input type="search"
                   aria-label="게시판 검색"
                   placeholder="게시판 이름이나 주제 검색"
                   value="@ViewModel.SearchText"
                   @oninput="HandleSearchInput" />
        </label>
    </header>

    @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            <div class="community-directory__recoverable-error">
                <span>@ViewModel.StatusMessage</span>
                <MudButton Variant="Variant.Text"
                           Color="Color.Warning"
                           Size="Size.Small"
                           Disabled="@ViewModel.IsLoading"
                           OnClick="ReloadAsync">
                    다시 불러오기
                </MudButton>
            </div>
        </MudAlert>
    }

    <a class="community-directory__all" href="@CommunityPageRoutes.Boards">
        <span class="community-directory__icon"><MudIcon Icon="@Icons.Material.Filled.DynamicFeed" /></span>
        <span><strong>전체 글</strong><small>공개 게시판의 글을 한 번에 봅니다.</small></span>
        <b>@ViewModel.TotalPostCount.ToString("N0")</b>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
    </a>

    @if (ViewModel.IsLoading)
    {
        <div class="community-directory__state" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <span>게시판을 불러오는 중입니다.</span>
        </div>
    }
    else if (ViewModel.VisibleGroups.Count == 0)
    {
        <div class="community-directory__state">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
            <span>검색 조건에 맞는 게시판이 없습니다.</span>
        </div>
    }
    else
    {
        @foreach (var group in ViewModel.VisibleGroups)
        {
            var isActivityGroup = CommunityBoardGroupCodes.IsActivityWorkflow(group.Key);
            <section class="@BuildGroupClass(group.Key)" aria-labelledby="@($"board-group-{group.Key}")">
                <header>
                    <span>@GroupEyebrow(group.Key)</span>
                    <h2 id="@($"board-group-{group.Key}")">@group.DisplayName</h2>
                </header>
                @if (isActivityGroup)
                {
                    <p class="community-directory__group-description">
                        각 산은 하나의 업무 책임입니다. 버전은 보조 표지로만 남기고, 관련 Command·Event·페이지와 공개 기록 여부를 함께 점검합니다.
                    </p>
                }
                <div class="@BuildBoardListClass(group.Key)">
                    @foreach (var board in group.Boards)
                    {
                        var activityBundle = CommunityActivityBoardCatalog.FindBundle(board.BoardKey);
                        @if (activityBundle is not null)
                        {
                            <article class="community-directory__board community-directory__board--activity"
                                     data-activity-board="@activityBundle.Board.Key">
                                <span class="community-directory__icon community-directory__icon--mountain"
                                      aria-label="간괘, 산">☶</span>
                                <div class="community-directory__board-copy">
                                    <div class="community-directory__board-heading">
                                        <strong>@board.DisplayName</strong>
                                        <span class="community-directory__activity-badges">
                                            <em>v@activityBundle.ProductVersion</em>
                                            <em>@activityBundle.ProductName</em>
                                        </span>
                                    </div>
                                    <small>@board.Description</small>
                                    <div class="community-directory__activity-counts"
                                         aria-label="연결된 Command Event 페이지 수">
                                        <span>Command <strong>@activityBundle.CommandCount</strong></span>
                                        <span>Event <strong>@activityBundle.EventCount</strong></span>
                                        <span>페이지 <strong>@activityBundle.Pages.Count</strong></span>
                                    </div>
                                    <details class="community-directory__activity-details">
                                        <summary>Command·Event·페이지 연결 보기</summary>
                                        <div class="community-directory__connections">
                                            <section>
                                                <strong>Command</strong>
                                                @if (activityBundle.CommandCount == 0)
                                                {
                                                    <p>현재 구현된 Command 경계 없음</p>
                                                }
                                                else
                                                {
                                                    <ul>
                                                        @foreach (var activity in activityBundle.Activities.Where(item =>
                                                                      item.SourceKind == CommunityActivitySourceKinds.Command))
                                                        {
                                                            <li>
                                                                <code>@activity.SourceName</code>
                                                                <small>@activity.PublicationLabel · @activity.ActivityDisplayName</small>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </section>
                                            <section>
                                                <strong>Event</strong>
                                                @if (activityBundle.EventCount == 0)
                                                {
                                                    <p>현재 구현된 Event 경계 없음</p>
                                                }
                                                else
                                                {
                                                    <ul>
                                                        @foreach (var activity in activityBundle.Activities.Where(item =>
                                                                      item.SourceKind == CommunityActivitySourceKinds.Event))
                                                        {
                                                            <li>
                                                                <code>@activity.SourceName</code>
                                                                <small>@activity.PublicationLabel · @activity.ActivityDisplayName</small>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </section>
                                            <section class="community-directory__connection-pages">
                                                <strong>관련 페이지</strong>
                                                <ul>
                                                    @foreach (var relatedPage in activityBundle.Pages)
                                                    {
                                                        <li>
                                                            @if (relatedPage.CanNavigateFromCommunityWeb)
                                                            {
                                                                <a href="@relatedPage.Route">@relatedPage.PageName</a>
                                                            }
                                                            else
                                                            {
                                                                <span>@relatedPage.PageName</span>
                                                            }
                                                            <small>@relatedPage.Surface · <code>@relatedPage.Route</code></small>
                                                        </li>
                                                    }
                                                </ul>
                                            </section>
                                        </div>
                                    </details>
                                </div>
                                <div class="community-directory__activity-footer">
                                    <span><strong>@board.PostCount.ToString("N0")</strong>개 글</span>
                                    <a href="@BoardHref(board.BoardKey)">
                                        게시판 보기
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                    </a>
                                </div>
                            </article>
                        }
                        else
                        {
                            <a class="community-directory__board" href="@BoardHref(board.BoardKey)">
                                <span class="community-directory__icon">
                                    <MudIcon Icon="@ResolveBoardIcon(board.BoardKey)" />
                                </span>
                                <span class="community-directory__board-copy">
                                    <span class="community-directory__board-heading">
                                        <strong>@board.DisplayName</strong>
                                        @if (!board.IsUserCreatable)
                                        {
                                            <span class="community-directory__activity-badges">
                                                <em>운영</em>
                                            </span>
                                        }
                                    </span>
                                    <small>@board.Description</small>
                                </span>
                                <b>@board.PostCount.ToString("N0")</b>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                            </a>
                        }
                    }
                </div>
            </section>
        }
    }

    <aside class="community-directory__safety" aria-label="안전센터">
        <span class="community-directory__icon"><MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" /></span>
        <span>
            <strong>신고·분쟁은 안전센터에서 보호합니다.</strong>
            <small>신고 원문과 첨부·댓글은 일반 게시판 목록에 공개하지 않습니다.</small>
        </span>
        <MudButton Href="/community/safety"
                   Variant="Variant.Outlined"
                   Color="Color.Error"
                   EndIcon="@Icons.Material.Filled.ChevronRight">
            안전센터
        </MudButton>
    </aside>
</main>
</PlatformCommunityReadingThemeFrame>

@code {
    private CommunityDirectoryPageViewModel ViewModel { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        ViewModel = new CommunityDirectoryPageViewModel(
            cancellationToken => CommunityService.GetBoardSummariesAsync("shipper", cancellationToken));
        await ViewModel.LoadAsync();
    }

    private Task ReloadAsync() => ViewModel.LoadAsync();

    private void HandleSearchInput(ChangeEventArgs args)
        => ViewModel.UpdateSearch(args.Value?.ToString());

    private static string BoardHref(string boardKey)
        => CommunityPageRoutes.BoardsFor(boardKey: boardKey);

    private static string GroupEyebrow(string groupCode)
    {
        if (CommunityBoardGroupCodes.IsActivityWorkflow(groupCode))
        {
            return "☶ GEN · WORK UNIT";
        }

        return groupCode switch
        {
            CommunityBoardGroupCodes.CollectiveWork => "COLLECTIVE WORK",
            CommunityBoardGroupCodes.ServiceOperation => "SERVICE OPERATION",
            _ => "PEOPLE & INFORMATION"
        };
    }

    private static string ResolveBoardIcon(string boardKey)
    {
        return boardKey switch
        {
            CommunityBoardKeys.NoticeGuide => Icons.Material.Filled.Campaign,
            CommunityBoardKeys.Vow => Icons.Material.Filled.FavoriteBorder,
            CommunityBoardKeys.FreeLife => Icons.Material.Filled.Forum,
            CommunityBoardKeys.QuestionHelp => Icons.Material.Filled.HelpOutline,
            CommunityBoardKeys.InformationPrices => Icons.Material.Filled.QueryStats,
            CommunityBoardKeys.Participation => Icons.Material.Filled.Groups,
            CommunityBoardKeys.SalesSupply => Icons.Material.Filled.Storefront,
            CommunityBoardKeys.LedgerProgress => Icons.Material.Filled.AccountTree,
            CommunityBoardKeys.CompletionReview => Icons.Material.Filled.Verified,
            CommunityBoardKeys.ProductFeedback => Icons.Material.Filled.Lightbulb,
            _ => Icons.Material.Filled.Topic
        };
    }

    private static string BuildGroupClass(string groupCode)
        => CommunityBoardGroupCodes.IsActivityWorkflow(groupCode)
            ? "community-directory__group community-directory__group--activity"
            : "community-directory__group";

    private static string BuildBoardListClass(string groupCode)
        => CommunityBoardGroupCodes.IsActivityWorkflow(groupCode)
            ? "community-directory__list community-directory__list--activity"
            : "community-directory__list";
}
