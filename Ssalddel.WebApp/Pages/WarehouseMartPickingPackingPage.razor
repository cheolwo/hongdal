@page "/warehouse/mart/picking"
@page "/mart/picking"
@inherits MvvmComponentBase<마트피킹작업PageViewModel>
@inject WebAuthSessionService AuthSession
@inject NavigationManager Navigation

<WebPageHeader Eyebrow="Warehouse Web"
               Title="알뜰살뜰 마트 피킹/포장"
               Description="접근 가능한 영속 마트 주문과 피킹·포장 작업을 조회합니다."
               Badge="Beta · ReadOnly" />

@if (!AuthSession.IsLoggedIn)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">창고 업무 로그인이 필요합니다.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                서버가 창고관리자 보안 역할, HR 세부 역할과 접근 가능한 창고 범위를 최종 확인합니다.
            </MudText>
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">
                로그인하러 가기
            </MudButton>
        </MudStack>
    </MudPaper>
}
else if (_initializing)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">마트 피킹 작업을 조회하고 있습니다.</MudText>
        </MudStack>
    </MudPaper>
}
else if (!string.IsNullOrWhiteSpace(_pageError))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText>@_pageError</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RetryAsync">다시 조회</MudButton>
        </MudStack>
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        서버 원본을 읽는 Beta/ReadOnly 화면입니다. 피킹·포장·출고 상태는 이 페이지에서 변경하지 않습니다.
    </MudAlert>

    <SsalddelMartPickingPackingWorkflow Model="@ViewModel"
                                        WorkBoardUrl="@WarehouseManagerRoutes.MartWorkBoard"
                                        OnOrderSelected="OpenOrderAsync" />
}

@code {
    private bool _initializing;
    private bool _loaded;
    private long? _loadedOrderId;
    private string? _pageError;

    [Parameter]
    [SupplyParameterFromQuery(Name = "orderId")]
    public long? OrderId { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AuthSession.Changed += AuthChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthSession.IsLoggedIn && (!_loaded || _loadedOrderId != OrderId))
        {
            await LoadAsync();
        }
    }

    private void AuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (AuthSession.IsLoggedIn)
            {
                await LoadAsync(force: true);
            }
            else
            {
                ViewModel.결과초기화();
                _pageError = null;
                _loaded = false;
            }

            StateHasChanged();
        });
    }

    private async Task LoadAsync(bool force = false)
    {
        if (_initializing || (!force && _loaded && _loadedOrderId == OrderId))
        {
            return;
        }

        _initializing = true;
        _pageError = null;
        try
        {
            var succeeded = await ViewModel.초기화Async(OrderId);
            if (!succeeded)
            {
                _pageError = ViewModel.목록.오류메시지
                             ?? ViewModel.상세.오류메시지
                             ?? "마트 피킹 작업을 조회하지 못했습니다.";
            }

            _loadedOrderId = OrderId;
            _loaded = true;
        }
        finally
        {
            _initializing = false;
        }
    }

    private Task RetryAsync() => LoadAsync(force: true);

    private Task OpenOrderAsync(long? orderId)
    {
        var target = orderId is > 0
            ? $"/warehouse/mart/picking?orderId={orderId.Value}"
            : "/warehouse/mart/picking";
        Navigation.NavigateTo(target);
        return Task.CompletedTask;
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            AuthSession.Changed -= AuthChanged;
        }

        base.Dispose(disposing);
    }
}
