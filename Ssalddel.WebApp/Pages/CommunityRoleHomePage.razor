    private static IReadOnlyList<LearningMapCountry> BuildLearningMapCountries()
        => YouTube지식성찰채널Catalog.항목
            .GroupBy(channel => channel.국가코드, StringComparer.Ordinal)
            .Select(group =>
            {
                var channels = group.ToArray();
                var scriptures = string.Equals(group.Key, "KR", StringComparison.Ordinal)
                    ? ScriptureDecorationCatalog.Definitions
                    : [];
                var perspectives = string.Join(" · ", channels.Select(channel => channel.관점표시).Distinct(StringComparer.Ordinal));
                return new LearningMapCountry(
                    group.Key,
                    CountryName(group.Key),
                    ContinentName(group.Key),
                    $"{perspectives} 공개 자료가 있다는 사실부터 가볍게 알아차립니다. 이를 관심·동의나 추천 신호로 기록하지 않습니다.",
                    $"채널 {channels.Length} · 주제 {channels.SelectMany(channel => channel.주제코드목록).Distinct(StringComparer.Ordinal).Count()}",
                    channels,
                    scriptures);
            })
            .OrderBy(country => country.Code == "KR" ? 0 : 1)
            .ThenBy(country => country.Name, StringComparer.Ordinal)
            .ToArray();

