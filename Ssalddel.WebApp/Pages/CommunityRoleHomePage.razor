    private static readonly IReadOnlyList<LearningMapCountry> LearningMapCountries = BuildLearningMapCountries();

    private bool IsNightLearning => false;

    private IReadOnlyList<커뮤니티세계지도LayerDto> CurrentLayers
        => _appliedSnapshot?.Layers
           ?? 커뮤니티세계지도LayerCatalog.ForDataset(DatasetCode);

    private IReadOnlyList<MapLayerDiagram> ActiveLayerDiagrams
        => ConsolidateLedgerDiagrams(CurrentLayers
            .Where(layer => IsLayerSelected(layer.Code))
            .Select(BuildLayerDiagram));

    private IReadOnlyList<GoogleMapMarker> CurrentMapMarkers
        => _appliedSnapshot is null
            ? BuildCatalogFallbackMarkers()
            : _appliedSnapshot.Observations
                .Where(observation => IsLayerSelected(observation.LayerCode))
                .Select(GoogleMapMarker.FromObservation)
                .ToArray();

    private IReadOnlyList<GoogleMapMarker> FallbackMapMarkers
        => CurrentMapMarkers
            .GroupBy(
                marker => IsIndividualLocationLayer(marker.LayerCode)
                    ? marker.Id
                    : marker.Code,
                StringComparer.Ordinal)
            .Select(group =>
            {
                var first = group.First();
                return first with
                {
                    Id = IsIndividualLocationLayer(first.LayerCode)
                        ? first.Id
                        : $"fallback:{first.Code}",
                    DataLabel = group.Count() == 1 ? first.DataLabel : $"자료 {group.Count()}건"
                };
            })
            .ToArray();

    private IReadOnlyList<커뮤니티세계지도ObservationDto> VisibleObservations
        => _appliedSnapshot?.Observations
            .Where(observation => IsLayerSelected(observation.LayerCode))
            .Where(observation => _selectedCountryCode is null
                                  || string.Equals(observation.CountryCode, _selectedCountryCode, StringComparison.Ordinal))
            .Where(observation => _selectedObservationId is null
                                  || string.Equals(observation.StableId, _selectedObservationId, StringComparison.Ordinal))
            .OrderBy(observation => observation.CountryName, StringComparer.Ordinal)
            .ThenBy(observation => observation.Title, StringComparer.Ordinal)
            .ToArray()
           ?? [];

    private IReadOnlyList<MapLayerDiagram> SelectedDayLedgerDiagrams
    {
        get
        {
            if (IsNightLearning || SelectedCountry is null)
            {
                return [];
            }

            var availableLayerCodes = VisibleObservations
                .Select(observation => observation.LayerCode)
                .ToHashSet(StringComparer.Ordinal);
            if (_appliedSnapshot is null)
            {
                if (SelectedCountry.Regions.Count > 0)
                {
                    availableLayerCodes.Add(커뮤니티세계지도LayerCodes.RegionalCulture);
                }

                availableLayerCodes.Add(커뮤니티세계지도LayerCodes.PublicPrice);
                if (커뮤니티도매시장MapCatalog.ForCountry(SelectedCountry.Code).Count > 0)
                {
                    availableLayerCodes.Add(커뮤니티세계지도LayerCodes.WholesaleMarket);
                }
            }

            return ConsolidateLedgerDiagrams(CurrentLayers
                .Where(layer => IsLayerSelected(layer.Code) && availableLayerCodes.Contains(layer.Code))
                .Select(BuildLedgerWorkflowDiagram));
        }
    }

