            or 커뮤니티세계지도LayerCodes.OverseasManufacturer;

    private AppContextImageAssetDto? SelectedRegionImage
    {
        get
        {
            var markerId = SelectedObservation?.StableId ?? SelectedMapMarker?.Id;
            if (string.IsNullOrWhiteSpace(markerId))
            {
                return null;
            }

            var normalizedMarkerId = markerId.StartsWith("culture:", StringComparison.Ordinal)
                ? markerId["culture:".Length..]
                : markerId;
            return _regionalImages
                .Select(image => new
                {
                    Image = image,
                    RegionKey = image.SceneKey.EndsWith("--scene-01", StringComparison.Ordinal)
                        ? image.SceneKey[..^"--scene-01".Length]
                        : image.SceneKey
                })
                .Where(candidate => normalizedMarkerId.Contains(
                    candidate.RegionKey,
                    StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(candidate => candidate.RegionKey.Length)
                .Select(candidate => candidate.Image)
                .FirstOrDefault();
        }
    }

    private async Task LoadRegionalImagesAsync()
    {
        _regionImagesLoading = true;
        _regionImagesError = null;
        try
        {
            _regionalImages = await RegionalImageClient.팩조회Async(RegionalCultureImagePackId);
        }
        catch (Exception)
        {
            _regionalImages = [];
            _regionImagesError = "지역 이미지를 불러오지 못했습니다.";
        }
        finally
        {
            _regionImagesLoading = false;
        }
    }

