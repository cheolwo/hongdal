    private MapLayerDiagram BuildLedgerWorkflowDiagram(커뮤니티세계지도LayerDto layer)
    {
        var templateKey = layer.Code switch
        {
            커뮤니티세계지도LayerCodes.RegionalCulture => CommunityLedgerTemplateKeys.LocalSale,
            커뮤니티세계지도LayerCodes.WholesaleMarket when _selectedCountryCode is not null
                && !string.Equals(_selectedCountryCode, "KR", StringComparison.Ordinal) => CommunityLedgerTemplateKeys.GroupImport,
            커뮤니티세계지도LayerCodes.WholesaleMarket => CommunityLedgerTemplateKeys.GroupPurchase,
            커뮤니티세계지도LayerCodes.TraditionalMarketHub => CommunityLedgerTemplateKeys.GroupPurchase,
            커뮤니티세계지도LayerCodes.OverseasManufacturer => CommunityLedgerTemplateKeys.GroupImport,
            커뮤니티세계지도LayerCodes.PublicPrice when _selectedCountryCode is not null
                && !string.Equals(_selectedCountryCode, "KR", StringComparison.Ordinal) => CommunityLedgerTemplateKeys.GroupImport,
            커뮤니티세계지도LayerCodes.PublicPrice => CommunityLedgerTemplateKeys.GroupPurchase,
            _ => CommunityLedgerTemplateKeys.Errand
        };

        var template = CommunityLedgerTemplateCatalog.Find(templateKey);
        var nodes = template.LedgerBlocks
            .Select((block, index) =>
            {
                var nextBlock = index + 1 < template.LedgerBlocks.Count
                    ? template.LedgerBlocks[index + 1]
                    : null;
                var relation = nextBlock is null
                    ? null
                    : template.BlockRelations.FirstOrDefault(candidate =>
                        string.Equals(candidate.FromBlockCode, block.Code, StringComparison.OrdinalIgnoreCase)
                        && string.Equals(candidate.ToBlockCode, nextBlock.Code, StringComparison.OrdinalIgnoreCase));
                return new MapLayerDiagramNode(
                    $"{index + 1:00}",
                    block.Code,
                    block.BlockType,
                    block.DisplayName,
                    block.Purpose,
                    FormatBlockRelation(relation));
            })
            .ToArray();

        return new MapLayerDiagram(
            layer.Code,
            layer.DisplayName,
            template.DisplayName,
            layer.Color,
            layer.MarkerShape,
            $"{template.WorkflowTag} · {template.Category}",
            template.Key,
            nodes,
            template.BlockRelations.Count,
            string.IsNullOrWhiteSpace(template.BestLedgerPatternSummary)
                ? template.Summary
                : template.BestLedgerPatternSummary,
            template.CompositionRules.Select(rule => rule.Title).ToArray());
    }

