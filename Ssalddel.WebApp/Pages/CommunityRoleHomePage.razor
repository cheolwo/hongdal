    public async ValueTask DisposeAsync()
    {
        if (_pollingCts is not null)
        {
            await _pollingCts.CancelAsync();
            if (_pollingTask is not null)
            {
                try
                {
                    await _pollingTask;
                }
                catch (OperationCanceledException)
                {
                }
            }

            _pollingCts.Dispose();
        }

        if (_googleMapModule is not null)
        {
            try
            {
                await _googleMapModule.InvokeVoidAsync("dispose", "community-world-google-map");
                await _googleMapModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _googleMapCallback?.Dispose();
    }
