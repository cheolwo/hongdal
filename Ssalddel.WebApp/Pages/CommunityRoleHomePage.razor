    protected override void OnParametersSet()
    {
        var requestedMode = MapDatasetMode.DayWork;
        if (_datasetMode != requestedMode)
        {
            _datasetMode = requestedMode;
            _selectedCountryCode = null;
            _pendingGoogleMapUpdate = true;
            ResetSnapshotForDataset();
        }

        EnsureDefaultLayersSelected();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _googleMapModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/community-world-google-map.js");
            _googleMapCallback = DotNetObjectReference.Create(this);
            var runtimeSettings = await GoogleMapsRuntimeClient.TryGetAsync();
            var status = await _googleMapModule.InvokeAsync<string>(
                "initialize",
                "community-world-google-map",
                CurrentMapMarkers,
                DatasetCode,
                _selectedCountryCode,
                _selectedObservationId,
                _googleMapCallback,
                runtimeSettings);

            _googleMapState = status switch
            {
                "ready" => GoogleMapState.Ready,
                "failed" => GoogleMapState.Failed,
                "blocked-origin" => GoogleMapState.BlockedOrigin,
                _ => GoogleMapState.Unconfigured
            };
            _pendingGoogleMapUpdate = false;
            _pollingCts = new CancellationTokenSource();
            _pollingTask = PollMapSnapshotsAsync(_pollingCts.Token);
            StateHasChanged();
            return;
        }

        if (_googleMapState == GoogleMapState.Ready && _pendingGoogleMapUpdate && _googleMapModule is not null)
        {
            _pendingGoogleMapUpdate = false;
            var preserveViewport = _preserveGoogleMapViewport;
            _preserveGoogleMapViewport = false;
            await _googleMapModule.InvokeVoidAsync(
                "updateDataset",
                "community-world-google-map",
                CurrentMapMarkers,
                DatasetCode,
                _selectedCountryCode,
                _selectedObservationId,
                preserveViewport);
        }

        if (_pendingFocusElementId is not null && _googleMapModule is not null)
        {
            var elementId = _pendingFocusElementId;
            _pendingFocusElementId = null;
            await _googleMapModule.InvokeVoidAsync("focusElement", elementId);
        }
    }

