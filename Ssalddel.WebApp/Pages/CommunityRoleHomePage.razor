    private void ResetSnapshotForDataset()
    {
        _appliedSnapshot = null;
        _selectedObservationId = null;
        _selectedLayerCodes.Clear();
        _snapshotConnectionMessage = null;
    }

    private async Task PollMapSnapshotsAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            await RefreshMapSnapshotAsync(applyImmediately: false, cancellationToken);
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(30), cancellationToken);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                break;
            }
        }
    }

    private async Task RefreshMapSnapshotAsync(bool applyImmediately, CancellationToken cancellationToken)
    {
        var requestedDataset = DatasetCode;
        try
        {
            await _snapshotRefreshGate.WaitAsync(cancellationToken);
            try
            {
                var snapshot = await WorldMapClient.조회Async(requestedDataset, cancellationToken);
                if (!string.Equals(requestedDataset, DatasetCode, StringComparison.Ordinal))
                {
                    return;
                }

                await InvokeAsync(() =>
                {
                    _lastSnapshotCheckedAt = DateTimeOffset.Now;
                    _snapshotConnectionMessage = null;
                    if (applyImmediately || _appliedSnapshot is null)
                    {
                        ApplySnapshot(snapshot);
                    }
                    else if (!string.Equals(_appliedSnapshot.Revision, snapshot.Revision, StringComparison.Ordinal))
                    {
                        ApplySnapshot(snapshot, preserveViewport: true);
                    }

                    StateHasChanged();
                });
            }
            finally
            {
                _snapshotRefreshGate.Release();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            await InvokeAsync(() =>
            {
                _snapshotConnectionMessage = _appliedSnapshot is null
                    ? "서버 snapshot을 가져오지 못해 현재 내장 공개 카탈로그를 표시합니다."
                    : "서버 snapshot을 다시 확인하지 못해 마지막으로 연결된 자료를 유지합니다.";
                StateHasChanged();
            });
        }
    }

    private void ApplySnapshot(커뮤니티세계지도SnapshotDto snapshot, bool preserveViewport = false)
    {
        _appliedSnapshot = snapshot;
        if (_selectedObservationId is not null
            && !snapshot.Observations.Any(observation =>
                string.Equals(observation.StableId, _selectedObservationId, StringComparison.Ordinal)))
        {
            _selectedObservationId = null;
        }
        _pendingGoogleMapUpdate = true;
        _preserveGoogleMapViewport = preserveViewport;
        EnsureDefaultLayersSelected();
    }

    private IReadOnlyList<GoogleMapMarker> BuildCatalogFallbackMarkers()
    {
        if (IsNightLearning)
        {
            return LearningMapCountries
                .Where(_ => IsLayerSelected(커뮤니티세계지도LayerCodes.LearningChannel)
                            || IsLayerSelected(커뮤니티세계지도LayerCodes.ScriptureAndClassics))
                .Select(country => GoogleMapMarker.For(
                    $"catalog:{country.Code}",
                    country.Code,
                    country.Name,
                    country.DataLabel,
                    커뮤니티세계지도LayerCodes.LearningChannel))
                .ToArray();
        }

        var countryMarkers = MapCountries
            .Where(country => (country.Regions.Count > 0 && IsLayerSelected(커뮤니티세계지도LayerCodes.RegionalCulture))
                              || IsLayerSelected(커뮤니티세계지도LayerCodes.PublicPrice))
            .Select(country => GoogleMapMarker.For(
                    $"catalog:{country.Code}",
                    country.Code,
                    country.Name,
                    country.DataLabel,
                    country.Regions.Count > 0
                        ? 커뮤니티세계지도LayerCodes.RegionalCulture
                        : 커뮤니티세계지도LayerCodes.PublicPrice));
        var marketMarkers = IsLayerSelected(커뮤니티세계지도LayerCodes.WholesaleMarket)
            ? 커뮤니티도매시장MapCatalog.All.Select(GoogleMapMarker.ForMarket)
            : Enumerable.Empty<GoogleMapMarker>();

        return countryMarkers.Concat(marketMarkers).ToArray();
    }

