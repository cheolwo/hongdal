        var left = (marker.Longitude + 180d) / 360d * 100d;
        var top = (90d - marker.Latitude) / 180d * 100d;
        return FormattableString.Invariant($"--marker-left: {left:F3}%; --marker-top: {top:F3}%;");
    }

