@page "/warehouse/general/transport-request-draft"
@page "/work/outbound/transport-request-draft"
@inject WebAuthSessionService AuthSession
@implements IDisposable

<PageTitle>운송의뢰 로컬 초안 · 살뜰</PageTitle>
<WebPageHeader Eyebrow="Warehouse Web" Title="운송의뢰 로컬 초안" Description="검토를 통과한 출고예정의 하차지·희망 일정·차량 조건만 구성합니다." Badge="Beta · Simulation" />
@if(!AuthSession.IsLoggedIn){<MudPaper Elevation="0" Outlined="true" Class="pa-6"><MudStack AlignItems="AlignItems.Center" Spacing="2"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" /><MudText Typo="Typo.h6">운송의뢰 초안에는 로그인이 필요합니다.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">서버에서 창고 배정과 HR 출고 역할을 확인합니다.</MudText><MudButton Href="/login" Variant="Variant.Filled">로그인</MudButton></MudStack></MudPaper>}
else{<SsalddelTransportRequestDraftWorkspace OutboundPlanId="@OutboundPlanId" />}

@code {
    [SupplyParameterFromQuery(Name="outboundPlanId")] public long? OutboundPlanId { get; set; }
    protected override void OnInitialized()=>AuthSession.Changed+=AuthChanged;
    private void AuthChanged()=>_=InvokeAsync(StateHasChanged);
    public void Dispose()=>AuthSession.Changed-=AuthChanged;
}
