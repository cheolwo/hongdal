@page "/food/mart/order"
@page "/food/mart/order/{ProductId:long}"
@page "/orderer/mart/order"
@page "/orderer/mart/order/{ProductId:long}"
@inject NavigationManager Navigation
@inject CommunityMapApplicationLedgerClient MapApplicationLedgerClient
@using Ssalddel.Contracts.Common.Community
@using Ssalddel.Contracts.Common.Mart
@using Ssalddel.Contracts.Common.Privacy

<PageTitle>알뜰살뜰 마트 주문 요청 · 살뜰</PageTitle>

@if (RequiresMapPrivacyConsent && !_privacyConsentAccepted)
{
    <ApplicationPrivacyConsentPanel ApplicationKind="@신청개인정보업무Codes.개별주문"
                                    Accepted="AcceptPrivacyAsync" />
}
else
{
    @if (RequiresMapPrivacyConsent)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
            지도 마커 <strong>@(MarkerTitle ?? "선택 항목")</strong>에서 시작했습니다.
            지도 마커는 주문 상품이나 판매자를 확정하지 않습니다. 공개 상품을 직접 선택한 뒤 비구속 주문 의향을 작성하세요.
        </MudAlert>
        @if (_provisionalLedger is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
                비구속 가원장 <strong>@_provisionalLedger.원장Id</strong>을 먼저 만들었습니다. 주문 확정·결제·재고 예약은 발생하지 않습니다.
            </MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_ledgerError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_ledgerError</MudAlert>
        }
    }

<MartProductAccessFrame Context="@Context"
                        CurrentScreen="MartProductScreenKind.Order"
                        ProductId="@EffectiveProductId"
                        Eyebrow="ORDER REQUEST"
                        Title="알뜰살뜰 마트 주문 요청"
                        Description="선택한 공개 상품 한 건의 비구속 주문 의향만 저장하고 같은 요청 ID를 다시 확인합니다."
                        HomeHref="@WebOrdererRoutes.Home">
    <OrdererMartOrderRequestWorkspace ProductId="@EffectiveProductId"
                                      RequestId="@RequestId"
                                      ApplicationPrivacyConsentEvidenceId="@_privacyConsentEvidenceId"
                                      ApplicationSourceCode="@_applicationSourceCode"
                                      CatalogHref="@Context.PathFor(MartProductScreenKind.List)"
                                      BeforeSubmit="EnsureProvisionalLedgerAsync"
                                      RequestSelected="OnRequestSelectedAsync" />

    @if (RequestId.HasValue)
    {
        <ApplicationPrivacyWithdrawalPanel WorkCode="@신청개인정보업무Codes.개별주문"
                                           OperationalSourceType="MartOrderRequest"
                                           OperationalSourceId="@RequestId.Value.ToString("D")" />
        <MapApplicationOperationalCancellationPanel WorkCode="@신청개인정보업무Codes.개별주문"
                                                    OperationalSourceType="MartOrderRequest"
                                                    OperationalSourceId="@RequestId.Value.ToString("D")" />
    }
</MartProductAccessFrame>
}

@code {
    [Parameter] public long? ProductId { get; set; }

    [SupplyParameterFromQuery(Name = "productId")]
    public long? LegacyProductId { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public Guid? RequestId { get; set; }

    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    [SupplyParameterFromQuery(Name = "markerTitle")]
    public string? MarkerTitle { get; set; }

    [SupplyParameterFromQuery(Name = "sourceMarkerId")]
    public string? SourceMarkerId { get; set; }

    [SupplyParameterFromQuery(Name = "markerLayer")]
    public string? MarkerLayer { get; set; }

    [SupplyParameterFromQuery(Name = "country")]
    public string? CountryCode { get; set; }

    private bool _privacyConsentAccepted;
    private Guid? _privacyConsentEvidenceId;
    private string _applicationSourceCode = string.Empty;
    private 지도신청가원장Response? _provisionalLedger;
    private string? _ledgerError;

    private bool RequiresMapPrivacyConsent
        => string.Equals(
            Source,
            CommunityMapApplicationRoutes.SourceCode,
            StringComparison.OrdinalIgnoreCase);

    private long? EffectiveProductId => ProductId is > 0 ? ProductId : LegacyProductId;

    private MartProductNavigationContext Context
        => MartProductNavigationContext.Parse(Navigation.Uri);

    protected override void OnParametersSet()
    {
        if (ProductId is not > 0 && LegacyProductId is > 0)
        {
            var target = Context.PathFor(MartProductScreenKind.Order, LegacyProductId);
            Navigation.NavigateTo(AppendRequestId(target, RequestId), replace: true);
        }
    }

    private async Task OnRequestSelectedAsync(Guid? requestId)
    {
        if (requestId.HasValue)
        {
            var linked = await LinkSubmittedLedgerAsync("MartOrderRequest", requestId.Value.ToString("D"));
            if (linked && _provisionalLedger is not null)
            {
                Navigation.NavigateTo(CommunityMapApplicationRoutes.ReturnToMarker(
                    SourceMarkerId ?? string.Empty,
                    MarkerLayer ?? string.Empty,
                    CountryCode ?? string.Empty,
                    _provisionalLedger.원장Id));
                return;
            }
        }

        var target = EffectiveProductId is > 0
            ? Context.PathFor(MartProductScreenKind.Order, EffectiveProductId)
            : MartProductPageRoutes.OrderRoot;
        Navigation.NavigateTo(AppendRequestId(target, requestId), replace: true);
    }

    private static string AppendRequestId(string path, Guid? requestId)
    {
        if (!requestId.HasValue)
        {
            return path;
        }

        var separator = path.Contains('?', StringComparison.Ordinal) ? '&' : '?';
        return $"{path}{separator}requestId={requestId.Value:D}";
    }

    private Task AcceptPrivacyAsync(신청개인정보동의증적Response evidence)
    {
        _privacyConsentEvidenceId = evidence.증적Id;
        _applicationSourceCode = evidence.출처Code;
        _privacyConsentAccepted = true;
        return Task.CompletedTask;
    }

    private async Task<bool> EnsureProvisionalLedgerAsync()
    {
        if (!RequiresMapPrivacyConsent || _provisionalLedger is not null)
        {
            return true;
        }

        var attempt = await MapApplicationLedgerClient.TryCreateAsync(new 지도신청가원장생성Request
        {
            신청개인정보동의증적Id = _privacyConsentEvidenceId ?? Guid.Empty,
            업무Code = 신청개인정보업무Codes.개별주문,
            신청출처Code = _applicationSourceCode,
            MarkerId = SourceMarkerId ?? string.Empty,
            MarkerName = MarkerTitle ?? string.Empty,
            LayerCode = MarkerLayer ?? string.Empty,
            CountryCode = CountryCode ?? string.Empty
        });
        _provisionalLedger = attempt.Ledger;
        _ledgerError = attempt.Error;
        return attempt.Succeeded;
    }

    private async Task<bool> LinkSubmittedLedgerAsync(string sourceType, string sourceId)
    {
        if (!RequiresMapPrivacyConsent || _provisionalLedger is null)
        {
            return false;
        }

        var attempt = await MapApplicationLedgerClient.TryMarkSubmittedAsync(
            _provisionalLedger.원장Id,
            new 지도신청실원장전환Request
            {
                신청개인정보동의증적Id = _privacyConsentEvidenceId ?? Guid.Empty,
                업무Code = 신청개인정보업무Codes.개별주문,
                신청출처Code = _applicationSourceCode,
                운영원본종류 = sourceType,
                운영원본Id = sourceId
            });
        _provisionalLedger = attempt.Ledger ?? _provisionalLedger;
        _ledgerError = attempt.Error is null
            ? null
            : $"주문 요청은 저장됐지만 원장 연결이 보류되었습니다. 요청을 다시 제출하지 말고 원장 연결을 재시도해 주세요. {attempt.Error}";
        return attempt.Succeeded;
    }
}
