@page "/driver"
@page "/driver/home"
@using Ssalddel.Contracts.Driver.Recommendation
@inject I기사추천수신Service 추천Service

<RoleDashboardSurface Title="기사 홈 요약"
                      Badge="오늘"
                      Description="운행 준비와 제안, 진행 중 업무를 한눈에 확인합니다."
                      Metrics="Metrics"
                      Tasks="Tasks"
                      IsLoading="_isLoading"
                      BoundaryTitle="운행 가능 상태"
                      BoundaryDescription="차량·보험·휴식 상태를 확인한 뒤 운행 가능을 직접 켜세요.">
    <Notice>
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                @_statusMessage
            </MudAlert>
        }
    </Notice>
    <Footer>
        <nav class="driver-home-links" aria-label="기사 보조 업무">
            <a href="@Relative(DriverRoutes.CommunityRequests)">개별 의뢰</a>
            <a href="@Relative(DriverRoutes.ExplorationCampaigns)">탐색 문의</a>
            <a href="@Relative(DriverRoutes.Reservations)">운행 예약</a>
            <a href="driver/notifications">알림</a>
        </nav>
    </Footer>
</RoleDashboardSurface>

@code {
    private IReadOnlyList<기사추천수신항목> _recommendations = [];
    private bool _isLoading;
    private string? _statusMessage;

    private IReadOnlyList<RoleDashboardMetric> Metrics =>
    [
        new("제안", $"{_recommendations.Count:N0}건"),
        new("진행 운송", 추천Service.선택추천 is null ? "0건" : "1건"),
        new("예상 수입", ExpectedIncome)
    ];

    private IReadOnlyList<RoleDashboardTask> Tasks =>
    [
        new(
            "운행 전 상태 확인",
            "차량·보험·휴식과 위치 공유 동의를 확인합니다.",
            "준비",
            Relative(DriverRoutes.WorkStart),
            RoleDashboardTone.Success),
        new(
            "신규 운송 후보",
            _recommendations.Count == 0
                ? "현재 조회된 추천이 없습니다."
                : $"{_recommendations.Count:N0}건의 조건을 비교할 수 있습니다.",
            "보기",
            Relative(DriverRoutes.Recommendations)),
        new(
            "현재 운송 확인",
            "수락한 운송의 상차·하차 다음 행동을 확인합니다.",
            "운송",
            Relative(DriverRoutes.CurrentTransport)),
        new(
            "상하차 증빙 확인",
            "사진과 인수 확인을 개인정보 보호 범위에서 보완합니다.",
            "증빙",
            Relative(DriverRoutes.ProofStageSelector),
            RoleDashboardTone.Warning)
    ];

    private string ExpectedIncome
    {
        get
        {
            var value = _recommendations
                .Where(item => item.예상수익 is > 0)
                .Sum(item => item.예상수익 ?? 0);
            return value > 0 ? $"{value:N0}원" : "—";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _recommendations = await 추천Service.추천조회Async(
                기사추천조회범위.전체,
                CancellationToken.None);
        }
        catch (Exception exception) when (exception is InvalidOperationException or HttpRequestException)
        {
            _statusMessage = "추천 수치는 로그인 후 서버 원장에서 확인됩니다.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string Relative(string path)
        => path.TrimStart('/');
}
