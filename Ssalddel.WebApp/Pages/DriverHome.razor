@page "/driver"
@page "/driver/home"
@using Ssalddel.Contracts.Driver.Recommendation
@inject I기사추천수신Service 추천Service

<div class="driver-home-map-shell">
    <div class="driver-home-map">
        <div class="driver-home-road driver-home-road--primary"></div>
        <div class="driver-home-road driver-home-road--secondary"></div>
        <div class="driver-home-road driver-home-road--tertiary"></div>
        <div class="driver-home-zone driver-home-zone--pickup"></div>
        <div class="driver-home-zone driver-home-zone--dropoff"></div>
        <div class="driver-home-pin driver-home-pin--driver">현위치</div>
        <div class="driver-home-pin driver-home-pin--pickup">상차</div>
        <div class="driver-home-pin driver-home-pin--dropoff">하차</div>
    </div>

    <div class="driver-home-actions">
        <MudTooltip Text="내 정보">
            <MudIconButton Href="/driver/me"
                           Icon="@Icons.Material.Filled.AccountCircle"
                           Color="Color.Inherit"
                           Variant="Variant.Filled"
                           Class="driver-home-action-button"
                           aria-label="내 정보" />
        </MudTooltip>
        <MudTooltip Text="현재 운송">
            <MudIconButton Href="@DriverRoutes.CurrentTransport"
                           Icon="@Icons.Material.Filled.LocalShipping"
                           Color="Color.Inherit"
                           Variant="Variant.Filled"
                           Class="driver-home-action-button"
                           aria-label="현재 운송" />
        </MudTooltip>
    </div>

    @if (ActiveRecommendation is not null)
    {
        <a class="driver-home-recommendation-strip" href="@RecommendationHref">
            <span class="driver-home-recommendation-title">신규 추천</span>
            <span class="driver-home-recommendation-route">@Display(ActiveRecommendation.픽업지, "상차지") → @Display(ActiveRecommendation.하차지, "하차지")</span>
            <span class="driver-home-recommendation-fare">@DisplayMoney(ActiveRecommendation.예상수익)</span>
        </a>
    }
</div>

@code {
    private 기사추천수신항목? ActiveRecommendation => 추천Service.선택추천;

    private string RecommendationHref
        => ActiveRecommendation is null
            ? DriverRoutes.Recommendations
            : DriverRoutes.RecommendationFor(ActiveRecommendation.의뢰Id);

    private static string Display(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string DisplayMoney(decimal? value)
        => value.HasValue ? $"{value.Value:N0}원" : "금액 미정";
}
