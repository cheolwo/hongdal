@page "/community/group-purchase"
@inject NavigationManager Navigation

<PageTitle>공동구매 목록</PageTitle>

@if (LegacyCampaignId is null)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h6">공동구매가 처음인가요?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    가상 이웃과 먼저 친해지고 조건을 맞추는 저장 없는 연습방을 이용해 보세요.
                </MudText>
            </MudStack>
            <MudButton Href="@CommunityPageRoutes.GroupPurchasePractice"
                       Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.SportsEsports">
                게임처럼 연습하기
            </MudButton>
        </MudStack>
    </MudPaper>
    <CommunityGroupPurchaseListScreen />
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "campaignId")]
    public Guid? LegacyCampaignId { get; set; }

    protected override void OnParametersSet()
    {
        if (LegacyCampaignId is Guid campaignId && campaignId != Guid.Empty)
        {
            Navigation.NavigateTo(
                CommunityPageRoutes.GroupPurchaseDetailFor(campaignId),
                replace: true);
        }
    }
}
