@page "/warehouse/work/inbound/inspection"
@page "/work/inbound/inspection"
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession
@implements IDisposable

<PageTitle>입고 검수 · 살뜰</PageTitle>

<WebPageHeader Eyebrow="Warehouse Web"
               Title="입고 검수 작업"
               Description="서버의 입고 완료 상품을 조회하고 수량·불량 검수 결과를 기록한 뒤 같은 ID를 다시 확인합니다."
               Badge="Beta · Simulation" />

@if (!AuthSession.IsLoggedIn)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">입고 검수에는 로그인이 필요합니다.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                서버에서 창고 배정과 HR 입고 역할을 확인합니다. 익명 허용 커뮤니티 게시판은 로그인 없이 계속 이용할 수 있습니다.
            </MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Justify="Justify.Center">
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">로그인</MudButton>
                <MudButton Href="/community" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Forum">익명 커뮤니티 보기</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}
else
{
    <SsalddelInboundInspectionWorkspace InboundItemId="@InboundItemId"
                                        OnInboundItemSelected="UpdateInboundItemRoute" />
}

@code {
    [SupplyParameterFromQuery(Name = "inboundItemId")]
    public long? InboundItemId { get; set; }

    protected override void OnInitialized()
        => AuthSession.Changed += AuthChanged;

    private void AuthChanged()
        => _ = InvokeAsync(StateHasChanged);

    private Task UpdateInboundItemRoute(long? inboundItemId)
    {
        var target = inboundItemId is > 0
            ? $"{WarehouseManagerRoutes.InboundInspection}?inboundItemId={inboundItemId.Value}"
            : WarehouseManagerRoutes.InboundInspection;
        Navigation.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }

    public void Dispose()
        => AuthSession.Changed -= AuthChanged;
}
