@page "/warehouse/work/{ProcessCode}/workbench"
@page "/work/{ProcessCode}/workbench"
@inject NavigationManager Navigation

<WebPageHeader Eyebrow="Warehouse Web"
               Title="@Definition.Title"
               Description="@Definition.Description"
               Badge="@Definition.Label" />

<MudContainer MaxWidth="MaxWidth.Small" Class="px-0">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">작업대 바코드</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Definition.InputHelp</MudText>
                    </MudStack>
                    <MudChip T="string" Color="@Definition.Color" Variant="Variant.Outlined">@Definition.Label</MudChip>
                </MudStack>

                <MudTextField T="string"
                              Label="작업대 바코드"
                              Value="@WorkbenchBarcode"
                              ValueChanged="OnBarcodeChanged"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              AutoFocus="true"
                              Placeholder="@Definition.Placeholder"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                              OnKeyDown="OnKeyDownAsync" />

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <MudAlert Severity="@MessageSeverity">@Message</MudAlert>
                }

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="@Definition.Color" StartIcon="@Icons.Material.Filled.Done" Disabled="@(!CanConfirm)" OnClick="ConfirmAsync">
                        작업대 확인
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Backspace" OnClick="Clear">
                        다시 입력
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">샘플 바코드: 입고 작업대 WB:IN-01, 포장 작업대 WB:PK-03</MudAlert>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string ProcessCode { get; set; } = WarehouseWorkProcessCodes.Inbound;

    private string WorkbenchBarcode = string.Empty;
    private string? Message;
    private Severity MessageSeverity = Severity.Info;
    private WorkbenchDefinition Definition => ResolveDefinition(ProcessCode);
    private bool CanConfirm => IsValidWorkbenchBarcode(WorkbenchBarcode);

    private Task OnBarcodeChanged(string value)
    {
        WorkbenchBarcode = (value ?? string.Empty).Trim();
        Message = null;
        return Task.CompletedTask;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await ConfirmAsync();
        }
    }

    private async Task ConfirmAsync()
    {
        if (!CanConfirm)
        {
            MessageSeverity = Severity.Warning;
            Message = "작업대 바코드를 입력해 주세요. 예: WB:IN-01";
            return;
        }

        MessageSeverity = Severity.Success;
        Message = $"{Definition.Label} 작업대 {NormalizeWorkbenchBarcode(WorkbenchBarcode)} 확인이 완료되었습니다.";
        await Task.Delay(300);
        Navigation.NavigateTo(Definition.NextRoute);
    }

    private void Clear()
    {
        WorkbenchBarcode = string.Empty;
        Message = null;
    }

    private static bool IsValidWorkbenchBarcode(string value)
    {
        var normalized = NormalizeWorkbenchBarcode(value);
        return normalized.StartsWith("WB:", StringComparison.OrdinalIgnoreCase)
            || normalized.StartsWith("BENCH:", StringComparison.OrdinalIgnoreCase)
            || normalized.StartsWith("TABLE:", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeWorkbenchBarcode(string value)
        => (value ?? string.Empty).Trim().ToUpperInvariant();

    private static WorkbenchDefinition ResolveDefinition(string? processCode)
        => Definitions.FirstOrDefault(x => string.Equals(x.ProcessCode, processCode, StringComparison.OrdinalIgnoreCase))
           ?? Definitions[0];

    private static readonly IReadOnlyList<WorkbenchDefinition> Definitions =
    [
        new(WarehouseWorkProcessCodes.Inbound, "입고 작업대 확인", "입고 작업자가 사용할 검수/입고 작업대를 바코드로 확인합니다.", "입고", "입고 검수대 또는 입고 작업대에 부착된 바코드를 입력합니다.", "WB:IN-01", Color.Warning, WarehouseManagerRoutes.InboundProductScan),
        new(WarehouseWorkProcessCodes.Packing, "포장 작업대 확인", "포장 작업자가 사용할 포장 작업대를 바코드로 확인합니다.", "포장", "포장대 또는 출고 포장 작업대에 부착된 바코드를 입력합니다.", "WB:PK-03", Color.Success, WarehouseManagerRoutes.WorkBoard)
    ];

    private sealed record WorkbenchDefinition(
        string ProcessCode,
        string Title,
        string Description,
        string Label,
        string InputHelp,
        string Placeholder,
        Color Color,
        string NextRoute);
}
