@page "/driver/transports/{TransportId:long}/dropoff"
@using Ssalddel.Contracts.Driver.Transport
@inject 기사운송증빙Service 증빙Service

<WebPageHeader Eyebrow="Driver Web"
               Title="하차 처리"
               Description="하차지 도착, 하차 사진 업로드, 인수 확인, 하차 완료를 한 화면에서 처리합니다."
               Badge="하차 전용" />

<MudGrid>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">운송 정보</MudText>
                        <MudChip T="string" Color="@ResolveTransportStateColor(CurrentTransport?.상태)" Size="Size.Small">
                            @Display(CurrentTransport?.상태, "조회 전")
                        </MudChip>
                    </MudStack>

                    @if (CurrentTransport is null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">운송 ID @TransportId 정보를 조회합니다.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2">@CurrentTransport.운송번호</MudText>
                        <MudText Typo="Typo.body2">@Display(CurrentTransport.출발지, "-") → @Display(CurrentTransport.도착지, "-")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">운임 @DisplayMoney(CurrentTransport.운임) · @Display(CurrentTransport.결제방식, "현장 확인")</MudText>
                        @if (CurrentTransport.관리자확인필요)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined">관리자 확인 필요</MudChip>
                        }
                    }

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Disabled="@IsBusy"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   OnClick="LoadTransportAsync">
                            새로고침
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@IsBusy"
                                   StartIcon="@Icons.Material.Filled.Flag"
                                   OnClick="ArriveDropoffAsync">
                            하차지 도착
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined">@StatusMessage</MudAlert>
            }

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">이동</MudText>
                    <MudButton Href="@PickupHref" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FileUpload">
                        상차 처리로
                    </MudButton>
                    <MudButton Href="/driver/transports/current" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.LocalShipping">
                        진행 중 운송으로
                    </MudButton>
                    <MudButton Href="@UnifiedProofHref" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PhotoCamera">
                        통합 증빙 화면
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6">하차 완료 사진</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            하차 위치와 인수 상태가 보이도록 촬영하고, 업로드 성공 후 하차 완료를 처리합니다.
                        </MudText>
                    </MudStack>

                    <InputFile OnChange="OnDropoffPhotoSelectedAsync" accept="image/*" />

                    @if (!string.IsNullOrWhiteSpace(DropoffPreviewUrl))
                    {
                        <img src="@DropoffPreviewUrl" alt="하차 증빙 미리보기" class="driver-proof-preview" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">첨부 파일: @DropoffFileName</MudText>
                    }

                    @if (DropoffUpload is not null)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined">
                            업로드 완료: @DropoffUpload.ObjectName
                        </MudAlert>
                    }

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="ReceiverName" Label="수령자/담당자" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" @bind-Value="PaymentEvidenceMethod" Label="현장 결제/증빙 방식" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("인수증")">인수증</MudSelectItem>
                                <MudSelectItem T="string" Value="@("하단 계좌")">하단 계좌</MudSelectItem>
                                <MudSelectItem T="string" Value="@("카드")">카드</MudSelectItem>
                                <MudSelectItem T="string" Value="@("현금")">현금</MudSelectItem>
                                <MudSelectItem T="string" Value="@("후불 정산")">후불 정산</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudCheckBox T="bool" @bind-Value="DropoffPlaceConfirmed" Label="하차지에 도착했고 주소를 확인했습니다." Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="ReceiverConfirmed" Label="수령자 또는 현장 담당자에게 화물을 인계했습니다." Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="PaymentEvidenceConfirmed" Label="현장 결제/증빙 방식을 확인했습니다." Color="Color.Primary" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Disabled="@(!CanCompleteDropoff)"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="CompleteDropoffProofAsync">
                        하차 완료 처리
                    </MudButton>
                    @if (!CanCompleteDropoff)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@DropoffCompletionGuide</MudText>
                    }
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">하차 예외 신고</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" Label="예외 사유" @bind-Value="IssueCode" Variant="Variant.Outlined">
                                @foreach (var reason in DropoffIssueReasons)
                                {
                                    <MudSelectItem T="string" Value="@reason.Code">@reason.Label</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string" Label="현장 메모" @bind-Value="IssueMemo" Lines="4" Variant="Variant.Outlined" Class="mt-3" />
                            <MudCheckBox T="bool" @bind-Value="RequireAdminReview" Label="관리자 확인 요청" Color="Color.Warning" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <InputFile OnChange="OnIssuePhotoSelectedAsync" accept="image/*" />
                            @if (!string.IsNullOrWhiteSpace(IssuePreviewUrl))
                            {
                                <img src="@IssuePreviewUrl" alt="하차 예외 증빙 미리보기" class="driver-proof-preview mt-3" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">첨부 파일: @IssueFileName</MudText>
                            }
                            @if (IssueUpload is not null)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                                    예외 증빙 업로드 완료: @IssueUpload.ObjectName
                                </MudAlert>
                            }
                        </MudItem>
                    </MudGrid>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               Disabled="@IsBusy"
                               StartIcon="@Icons.Material.Filled.ReportProblem"
                               OnClick="ReportIssueAsync">
                        하차 예외 기록
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private const long MaxImageBytes = 5 * 1024 * 1024;

    [Parameter] public long TransportId { get; set; }

    private static readonly IReadOnlyList<운송예외사유Option> DropoffIssueReasons =
    [
        new("하차지부재", "하차지 부재", "하차"),
        new("수령자부재", "수령자 부재", "하차"),
        new("수량불일치", "수량이 다름", "하차"),
        new("화물훼손", "화물 훼손", "하차"),
        new("사진재촬영필요", "사진 재촬영 필요", "하차")
    ];

    private 기사운송요약응답? CurrentTransport { get; set; }
    private 기사운송상태변경응답? LastState { get; set; }
    private bool IsBusy { get; set; }
    private string? StatusMessage { get; set; }
    private Severity StatusSeverity { get; set; } = Severity.Info;
    private string? DropoffPreviewUrl { get; set; }
    private string? DropoffFileName { get; set; }
    private 기사운송사진업로드결과? DropoffUpload { get; set; }
    private string? ReceiverName { get; set; }
    private string PaymentEvidenceMethod { get; set; } = "인수증";
    private bool DropoffPlaceConfirmed { get; set; }
    private bool ReceiverConfirmed { get; set; }
    private bool PaymentEvidenceConfirmed { get; set; }
    private string IssueCode { get; set; } = DropoffIssueReasons[0].Code;
    private string? IssueMemo { get; set; }
    private bool RequireAdminReview { get; set; } = true;
    private string? IssuePreviewUrl { get; set; }
    private string? IssueFileName { get; set; }
    private 기사운송사진업로드결과? IssueUpload { get; set; }

    private string PickupHref => $"/driver/transports/{TransportId}/pickup";
    private string UnifiedProofHref => $"/driver/transport/proof?transportId={TransportId}";
    private bool FieldChecksCompleted => DropoffPlaceConfirmed && ReceiverConfirmed && PaymentEvidenceConfirmed;
    private bool CanCompleteDropoff => !IsBusy && DropoffUpload is not null && FieldChecksCompleted;
    private string DropoffCompletionGuide
    {
        get
        {
            if (DropoffUpload is null && !FieldChecksCompleted)
            {
                return "하차 사진을 업로드하고 현장 확인 항목을 완료해야 합니다.";
            }

            if (DropoffUpload is null)
            {
                return "하차 완료 사진을 먼저 업로드해 주세요.";
            }

            return "주소, 수령자, 결제/증빙 확인을 모두 완료해 주세요.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await TryLoadTransportAsync();
    }

    private async Task TryLoadTransportAsync()
    {
        try
        {
            await LoadTransportCoreAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"운송 정보를 아직 불러오지 못했습니다. {ex.Message}", Severity.Info);
        }
    }

    private async Task LoadTransportAsync()
    {
        await RunAsync("운송 정보를 조회했습니다.", LoadTransportCoreAsync);
    }

    private async Task LoadTransportCoreAsync()
    {
        CurrentTransport = await 증빙Service.상세조회Async(TransportId);
    }

    private async Task ArriveDropoffAsync()
    {
        await RunAsync("하차지 도착 상태를 서버에 반영했습니다.", async () =>
        {
            LastState = await 증빙Service.하차지도착Async(TransportId);
            await RefreshDetailQuietlyAsync();
        });
    }

    private async Task OnDropoffPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        await SelectAndUploadAsync(e.File, 운송증빙단계.하차, result =>
        {
            DropoffPreviewUrl = result.PreviewUrl;
            DropoffFileName = result.FileName;
            DropoffUpload = result.Upload;
        });
    }

    private async Task OnIssuePhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        await SelectAndUploadAsync(e.File, 운송증빙단계.예외, result =>
        {
            IssuePreviewUrl = result.PreviewUrl;
            IssueFileName = result.FileName;
            IssueUpload = result.Upload;
        });
    }

    private async Task CompleteDropoffProofAsync()
    {
        if (!CanCompleteDropoff)
        {
            SetStatus(DropoffCompletionGuide, Severity.Warning);
            return;
        }

        await RunAsync("하차 완료 상태를 서버에 반영했습니다.", async () =>
        {
            LastState = await 증빙Service.하차완료Async(TransportId, DropoffUpload!);
            await RefreshDetailQuietlyAsync();
        });
    }

    private async Task ReportIssueAsync()
    {
        var option = DropoffIssueReasons.FirstOrDefault(x => x.Code == IssueCode) ?? DropoffIssueReasons[0];
        await RunAsync("하차 예외 사유를 서버에 기록했습니다.", async () =>
        {
            LastState = await 증빙Service.예외신고Async(
                TransportId,
                new 기사운송문제신고요청
                {
                    단계 = option.Stage,
                    예외코드 = option.Code,
                    사유 = option.Label,
                    메모 = IssueMemo,
                    증빙ObjectName = IssueUpload?.ObjectName,
                    증빙Url = IssueUpload?.Url,
                    관리자확인요청 = RequireAdminReview
                });
            await RefreshDetailQuietlyAsync();
        });
    }

    private async Task SelectAndUploadAsync(
        IBrowserFile file,
        운송증빙단계 stage,
        Action<운송증빙선택결과> apply)
    {
        await RunAsync($"{DisplayStage(stage)} 사진을 업로드했습니다.", async () =>
        {
            var (preview, fileName, contentType, bytes) = await ReadImageAsync(file);
            var upload = await 증빙Service.사진업로드Async(TransportId, stage, fileName, contentType, bytes);
            apply(new 운송증빙선택결과(preview, fileName, upload));
        });
    }

    private async Task RefreshDetailQuietlyAsync()
    {
        try
        {
            CurrentTransport = await 증빙Service.상세조회Async(TransportId);
        }
        catch
        {
            // 상태 전환 자체는 성공했을 수 있으므로 후속 상세 조회 실패는 화면 상태 메시지를 덮지 않는다.
        }
    }

    private async Task RunAsync(string successMessage, Func<Task> action)
    {
        IsBusy = true;
        SetStatus("서버 요청을 처리하는 중입니다.", Severity.Info);

        try
        {
            await action();
            SetStatus(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static async Task<(string PreviewUrl, string FileName, string ContentType, byte[] Bytes)> ReadImageAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxImageBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        var bytes = memory.ToArray();
        return ($"data:{contentType};base64,{Convert.ToBase64String(bytes)}", file.Name, contentType, bytes);
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }

    private static Color ResolveTransportStateColor(string? status)
    {
        if (ContainsAny(status, "완료", "인수"))
        {
            return Color.Success;
        }

        if (ContainsAny(status, "예외", "실패", "문제"))
        {
            return Color.Error;
        }

        if (ContainsAny(status, "도착", "상차", "하차"))
        {
            return Color.Info;
        }

        return Color.Default;
    }

    private static bool ContainsAny(string? value, params string[] tokens)
        => !string.IsNullOrWhiteSpace(value)
           && tokens.Any(token => value.Contains(token, StringComparison.OrdinalIgnoreCase));

    private static string Display(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static string DisplayMoney(decimal? value)
        => value.HasValue ? $"{value.Value:N0}원" : "금액 미정";

    private static string DisplayStage(운송증빙단계 stage)
        => stage switch
        {
            운송증빙단계.상차 => "상차",
            운송증빙단계.하차 => "하차",
            _ => "예외"
        };

    private sealed record 운송예외사유Option(string Code, string Label, string Stage);
    private sealed record 운송증빙선택결과(string PreviewUrl, string FileName, 기사운송사진업로드결과 Upload);
}
