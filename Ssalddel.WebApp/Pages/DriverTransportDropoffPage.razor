@page "/driver/transports/{TransportId:long}/dropoff"
@inherits MvvmComponentBase<DriverTransportDropoffPageViewModel>
@using Ssalddel.WebApp.Pages.DriverTransportDropoff
@using Ssalddel.WebApp.Pages.DriverTransportProof
@using Ssalddel.WebApp.ViewModels

<WebPageHeader Eyebrow="살뜰 2.0 · 기사"
               Title="하차 처리"
               Description="하차지 도착, 하차 증빙, 현장 인계 확인과 하차 예외만 처리합니다."
               Badge="하차 전용" />

<MudGrid>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <DriverTransportDropoffSummaryPanel Model="@ViewModel" />

            @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
            {
                <MudAlert Severity="@ResolveStatusSeverity(ViewModel.StatusTone)" Variant="Variant.Outlined">
                    @ViewModel.StatusMessage
                </MudAlert>
            }

            <DriverTransportDropoffNavigation TransportId="@ViewModel.TransportId" />
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <DriverTransportDropoffEvidenceEditor Model="@ViewModel" />
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <DriverTransportIssueEditor Model="@ViewModel.Issue"
                                            IsBusy="@ViewModel.IsBusy"
                                            Title="하차 예외 신고"
                                            SubmitLabel="하차 예외 기록"
                                            PreviewAlt="하차 예외 증빙 미리보기" />
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public long TransportId { get; set; }

    protected override Task OnParametersSetAsync()
        => ViewModel.InitializeAsync(TransportId);

    private static Severity ResolveStatusSeverity(DriverTransportProofMessageTone tone)
        => tone switch
        {
            DriverTransportProofMessageTone.Success => Severity.Success,
            DriverTransportProofMessageTone.Warning => Severity.Warning,
            DriverTransportProofMessageTone.Error => Severity.Error,
            _ => Severity.Info
        };
}
