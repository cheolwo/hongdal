<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">이동</MudText>
        <MudButton Href="@DriverRoutes.PickupFor(TransportId)"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.FileUpload">
            상차 처리로
        </MudButton>
        <MudButton Href="@DriverRoutes.CurrentTransport"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.LocalShipping">
            진행 중 운송으로
        </MudButton>
        <MudButton Href="@DriverRoutes.ProofFor(TransportId)"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PhotoCamera">
            증빙 단계 다시 선택
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public long TransportId { get; set; }
}
