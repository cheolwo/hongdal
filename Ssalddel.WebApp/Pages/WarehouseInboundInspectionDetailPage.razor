@page "/work/inbound/inspection/{InboundItemId:long}"
@page "/warehouse/work/inbound/inspection/{InboundItemId:long}"
@using Ssalddel.Contracts.Common.Inventory
@inject NavigationManager Navigation

<PageTitle>입고 검수 상세 · 살뜰</PageTitle>

<WarehouseInboundInspectionAccessFrame Title="입고 검수 상세"
                                       Description="한 입고상품의 검수 기준과 현재 서버 상태를 읽기 전용으로 확인합니다.">
    <InboundInspectionDetailScreen InboundItemId="@InboundItemId"
                                   Context="@Context"
                                   HomeHref="@WarehouseManagerRoutes.WorkBoard" />
</WarehouseInboundInspectionAccessFrame>

@code {
    [Parameter] public long InboundItemId { get; set; }

    private InboundInspectionNavigationContext Context
        => InboundInspectionNavigationContext.Parse(Navigation.Uri);
}
