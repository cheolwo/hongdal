@page "/driver/exploration/campaigns"
@using Ssalddel.Contracts.Common.Exploration
@inject ISsalddelJsonApiClient ApiClient

<PageTitle>보낸 탐색 문의함 · 살뜰 기사</PageTitle>

<RoleFlowSurface Title="보낸 탐색 문의함"
                 Badge="탐색"
                 Description="공개 수요를 찾기 위해 만든 탐색 캠페인과 응답 상태를 확인합니다."
                 Metrics="Metrics"
                 SectionTitle="탐색 문의"
                 Items="Items"
                 IsLoading="_isLoading"
                 EmptyMessage="아직 보낸 탐색 문의가 없습니다."
                 NoticeTitle="공개 범위"
                 NoticeDescription="탐색에는 필요한 차량·권역·가능 시간만 사용하고 개인 연락처는 별도 동의 후 공유합니다."
                 Palette="RoleFlowPalette.Driver">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                @_statusMessage
            </MudAlert>
        }
    </ChildContent>
</RoleFlowSurface>

@code {
    private IReadOnlyList<탐색캠페인목록항목응답> _campaigns = [];
    private bool _isLoading;
    private string? _statusMessage;

    private IReadOnlyList<RoleDashboardMetric> Metrics =>
    [
        new("보낸 문의", $"{_campaigns.Count:N0}건"),
        new("응답", $"{_campaigns.Sum(item => item.응답수):N0}건"),
        new("종료", $"{_campaigns.Count(item => item.탐색상태 is 탐색캠페인상태값.종료 or 탐색캠페인상태값.취소):N0}건")
    ];

    private IReadOnlyList<RoleFlowListItem> Items
        => _campaigns
            .OrderByDescending(item => item.UpdatedAt)
            .Select(item => new RoleFlowListItem(
                item.탐색명,
                $"{item.출발권역} → {item.희망도착권역 ?? "도착지 협의"} · 응답 {item.응답수:N0}/{item.모집대상수:N0}",
                item.탐색상태,
                Tone: StatusTone(item.탐색상태)))
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _campaigns = await ApiClient.GetAsync<IReadOnlyList<탐색캠페인목록항목응답>>(
                "api/v1/driver/exploration-campaigns",
                "기사 탐색 캠페인 목록 조회",
                allowNotFound: false) ?? [];
        }
        catch (Exception exception) when (exception is InvalidOperationException or HttpRequestException)
        {
            _statusMessage = "보낸 탐색 문의는 기사 로그인 후 서버 원장에서 확인됩니다.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static RoleDashboardTone StatusTone(string status)
        => status switch
        {
            탐색캠페인상태값.확정연결대기 => RoleDashboardTone.Success,
            탐색캠페인상태값.응답부족 => RoleDashboardTone.Warning,
            탐색캠페인상태값.종료 or 탐색캠페인상태값.취소 => RoleDashboardTone.Default,
            _ => RoleDashboardTone.Primary
        };
}
