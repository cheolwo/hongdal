@page "/information/korea-agricultural-map"
@page "/information/regional-agricultural-map"
@using Ssalddel.Ui.Common.Areas.App.Components.Information

<PageTitle>한국·미국 농수산물 데이터 지도 · 살뜰</PageTitle>

<div class="ssalddel-agricultural-map-host">
    <KoreaAgriculturalMapWorkspace InitialCountryCode="@CountryCode"
                                   InitialContentLayerKey="@ContentLayerKey" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "country")]
    public string? CountryCode { get; set; }

    [SupplyParameterFromQuery(Name = "layer")]
    public string? ContentLayerKey { get; set; }
}
