@using Ssalddel.Contracts.Driver.Transport

<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">현장 상태 전환</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Disabled="@IsBusy"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Place"
                   OnClick="OnArrivePickup">
            상차지 도착
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Disabled="@IsBusy"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Flag"
                   OnClick="OnArriveDropoff">
            하차지 도착
        </MudButton>
        <MudButton Href="@NextAction.Href"
                   Variant="Variant.Filled"
                   Color="@NextAction.Color"
                   FullWidth="true"
                   StartIcon="@NextAction.Icon">
            @NextAction.ButtonLabel
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public 기사운송요약응답 Transport { get; set; } = default!;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnArrivePickup { get; set; }

    [Parameter]
    public EventCallback OnArriveDropoff { get; set; }

    private DriverCurrentTransportNextAction NextAction
        => DriverCurrentTransportPresentation.ResolveNextAction(Transport);
}
