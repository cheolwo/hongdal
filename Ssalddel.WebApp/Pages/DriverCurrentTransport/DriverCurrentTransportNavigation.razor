<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">이동</MudText>
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Disabled="@IsBusy"
                   StartIcon="@Icons.Material.Filled.Sync"
                   OnClick="OnRefresh">
            현재 운송 새로고침
        </MudButton>
        <MudButton Href="/driver/work/start"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PlayArrow">
            운행 시작으로
        </MudButton>
        <MudButton Href="/driver/home"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Home">
            기사 홈으로
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }
}
