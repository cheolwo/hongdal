@using Ssalddel.Contracts.Driver.Transport

<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">다음 처리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            현장 도착·증빙·예외 신고는 운송 ID가 고정된 전용 화면에서 처리합니다.
        </MudText>
        <MudButton Href="@NextAction.Href"
                   Variant="Variant.Filled"
                   Color="@NextAction.Color"
                   FullWidth="true"
                   StartIcon="@NextAction.Icon">
            @NextAction.ButtonLabel
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public 기사운송요약응답 Transport { get; set; } = default!;

    private DriverCurrentTransportNextAction NextAction
        => DriverCurrentTransportPresentation.ResolveNextAction(Transport);
}
