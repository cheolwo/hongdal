@using Ssalddel.Contracts.Driver.Transport

<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Transport.운송번호</MudText>
                <MudText Typo="Typo.h5">@NextAction.Heading</MudText>
            </MudStack>
            <MudChip T="string"
                     Color="@DriverCurrentTransportPresentation.ResolveTransportStateColor(Transport.상태)"
                     Variant="Variant.Filled">
                @DriverCurrentTransportPresentation.Display(Transport.상태, "진행중")
            </MudChip>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary">상차</MudText>
                <MudText Typo="Typo.subtitle1">@DriverCurrentTransportPresentation.Display(Transport.출발지, "-")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary">하차</MudText>
                <MudText Typo="Typo.subtitle1">@DriverCurrentTransportPresentation.Display(Transport.도착지, "-")</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">운임</MudText>
                <MudText Typo="Typo.body1">@DriverCurrentTransportPresentation.DisplayMoney(Transport.운임)</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">결제/증빙</MudText>
                <MudText Typo="Typo.body1">@DriverCurrentTransportPresentation.Display(Transport.결제방식, "현장 확인")</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">최근 갱신</MudText>
                <MudText Typo="Typo.body1">@Transport.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</MudText>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            @if (Transport.인수증필요)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                    @(Transport.인수증서명필수 ? "인수증 서명 필수" : "인수증 필요")
                </MudChip>
            }
            @if (Transport.예외신고됨)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">예외 신고됨</MudChip>
            }
            @if (Transport.관리자확인필요)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">관리자 확인 필요</MudChip>
            }
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(Transport.다음행동안내))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                @Transport.다음행동안내
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(Transport.최근예외메시지))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                @Transport.최근예외단계 · @Transport.최근예외코드 · @Transport.최근예외메시지
            </MudAlert>
        }

        <DriverCurrentTransportTimeline Status="@Transport.상태" />
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public 기사운송요약응답 Transport { get; set; } = default!;

    private DriverCurrentTransportNextAction NextAction
        => DriverCurrentTransportPresentation.ResolveNextAction(Transport);
}
