@using Ssalddel.WebApp.ViewModels

<MudGrid Class="pt-3">
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">@Title</MudText>
            <MudSelect T="string" Label="예외 사유" @bind-Value="Model.IssueCode" Variant="Variant.Outlined">
                @foreach (var reason in Model.Reasons)
                {
                    <MudSelectItem T="string" Value="@reason.Code">@reason.Label</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="현장 메모" @bind-Value="Model.Memo" Lines="4" Variant="Variant.Outlined" />
            <MudCheckBox T="bool" @bind-Value="Model.RequireAdminReview" Label="관리자 확인 요청" Color="Color.Warning" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       Disabled="@IsBusy"
                       StartIcon="@Icons.Material.Filled.ReportProblem"
                       OnClick="Model.ReportAsync">
                @SubmitLabel
            </MudButton>
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">예외 증빙 사진</MudText>
            <InputFile OnChange="OnPhotoSelectedAsync" accept="image/*" />
            @if (!string.IsNullOrWhiteSpace(Model.PreviewUrl))
            {
                <img src="@Model.PreviewUrl" alt="@PreviewAlt" class="driver-proof-preview" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">첨부 파일: @Model.FileName</MudText>
            }
            @if (Model.Upload is not null)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined">
                    예외 증빙 업로드 완료: @Model.Upload.ObjectName
                </MudAlert>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public DriverTransportIssueViewModel Model { get; set; } = default!;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string Title { get; set; } = "현장 예외 신고";

    [Parameter]
    public string SubmitLabel { get; set; } = "예외 사유 기록";

    [Parameter]
    public string PreviewAlt { get; set; } = "예외 증빙 미리보기";

    private Task OnPhotoSelectedAsync(InputFileChangeEventArgs args)
        => Model.UploadAsync(args.File);
}
