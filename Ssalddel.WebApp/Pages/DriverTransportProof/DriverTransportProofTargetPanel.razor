@using Ssalddel.WebApp.ViewModels

<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">운송 대상</MudText>
        <MudNumericField T="long"
                         @bind-Value="Model.TransportId"
                         Label="운송 ID"
                         Variant="Variant.Outlined"
                         Min="1" />
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@Model.IsBusy"
                       StartIcon="@Icons.Material.Filled.LocalShipping"
                       OnClick="Model.LoadCurrentTransportAsync">
                현재 운송
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       Disabled="@Model.IsBusy"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="Model.LoadTransportDetailAsync">
                상세 조회
            </MudButton>
        </MudStack>

        @if (Model.CurrentTransport is not null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">@Model.CurrentTransport.운송번호</MudText>
                    <MudText Typo="Typo.body2">@Model.CurrentTransport.출발지 → @Model.CurrentTransport.도착지</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@DriverTransportProofPresentation.ResolveTransportStateColor(Model.CurrentTransport.상태)">
                            @Model.CurrentTransport.상태
                        </MudChip>
                        @if (Model.CurrentTransport.인수증필요)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">인수증 필요</MudChip>
                        }
                        @if (Model.CurrentTransport.예외신고됨)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">예외 신고됨</MudChip>
                        }
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentTransport.다음행동안내))
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                            @Model.CurrentTransport.다음행동안내
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public DriverTransportProofPageViewModel Model { get; set; } = default!;
}
