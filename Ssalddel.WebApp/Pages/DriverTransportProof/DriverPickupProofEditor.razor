@using Ssalddel.WebApp.ViewModels

<MudGrid Class="pt-3">
    <MudItem xs="12" md="7">
        <DriverPickupProofPhotoEditor Model="@Model"
                                      IsBusy="@IsBusy"
                                      ShowCompleteButton="true"
                                      EmphasizeDescription="true"
                                      Description="사진 선택 즉시 서버 업로드를 시도합니다. 업로드 성공 후 `ObjectName`이 있어야 상차 완료 버튼이 활성화됩니다." />
    </MudItem>
    <MudItem xs="12" md="5">
        <DriverPickupReceiptEditor Model="@Model" IsBusy="@IsBusy" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public DriverPickupProofViewModel Model { get; set; } = default!;

    [Parameter]
    public bool IsBusy { get; set; }
}
