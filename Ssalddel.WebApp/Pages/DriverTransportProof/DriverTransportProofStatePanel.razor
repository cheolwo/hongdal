@using Ssalddel.WebApp.ViewModels

<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">상태 전환</MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Disabled="@Model.IsBusy"
                       StartIcon="@Icons.Material.Filled.Place"
                       OnClick="Model.ArrivePickupAsync">
                상차지 도착
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Disabled="@Model.IsBusy"
                       StartIcon="@Icons.Material.Filled.Flag"
                       OnClick="Model.ArriveDropoffAsync">
                하차지 도착
            </MudButton>
        </MudStack>
        @if (Model.LastState is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                마지막 처리: @Model.LastState.운송번호 / @Model.LastState.상태 / @Model.LastState.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")
            </MudText>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public DriverTransportProofPageViewModel Model { get; set; } = default!;
}
