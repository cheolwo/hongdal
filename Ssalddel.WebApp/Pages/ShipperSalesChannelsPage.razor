@page "/shipper/sales/channels"
@inject NavigationManager Navigation

<PageTitle>판매채널 연결 준비</PageTitle>

<WebPageHeader Eyebrow="Shipper Web"
               Title="판매채널 연결 준비"
               Description="내 판매채널 계정 원장을 조회하고 외부 자격증명 없이 연결 준비 기록을 남깁니다."
               Badge="내부 원장 베타" />

<ShipperSalesChannelWorkspace AccountId="@AccountId"
                              AccountSelected="HandleAccountSelected" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "accountId")]
    public long? AccountId { get; set; }

    private void HandleAccountSelected(long accountId)
    {
        if (AccountId == accountId)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/shipper/sales/channels?accountId={accountId}",
            replace: true);
    }
}
