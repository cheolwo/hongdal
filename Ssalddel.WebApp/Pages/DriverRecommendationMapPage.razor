@page "/driver/recommendations/{RequestId}"
@using Ssalddel.Contracts.Driver.Recommendation
@using Ssalddel.WebApp.Pages.DriverRecommendationComponents
@inject I기사추천수신Service 추천Service

<PageTitle>배차 추천 상세</PageTitle>

<WebPageHeader Eyebrow="살뜰 2.0 · 기사"
               Title="추천 상세"
               Description="경로·화물·운임·비용·차량 적합성과 서버 원장 상태를 읽고, 상태 변경은 별도의 배차 판단 화면으로 넘깁니다."
               Badge="조회 전용" />

<MudStack Spacing="3">
    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
        <MudButton Href="@DriverRoutes.Recommendations"
                   Variant="Variant.Text"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            추천 목록
        </MudButton>
        @if (Recommendation is not null)
        {
            <MudButton Href="@DriverRoutes.DispatchDecisionFor(Recommendation.의뢰Id)"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Rule">
                수락·거절 판단으로
            </MudButton>
        }
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined">
            @StatusMessage
        </MudAlert>
    }

    @if (IsBusy && Recommendation is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (Recommendation is null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-6">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                         Size="Size.Large"
                         Color="Color.Warning" />
                <MudText Typo="Typo.h6">추천을 확인할 수 없습니다</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    추천 목록에서 현재 계정에 제시된 건을 다시 선택해 주세요.
                </MudText>
                <MudButton Href="@DriverRoutes.Recommendations"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    추천 목록으로
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <DriverRecommendationDetailPanel Recommendation="@Recommendation"
                                         Detail="@Detail" />
    }
</MudStack>

@code {
    [Parameter]
    public string? RequestId { get; set; }

    private string? LoadedRequestId { get; set; }
    private 기사추천수신항목? Recommendation { get; set; }
    private 기사운송의뢰상세응답? Detail { get; set; }
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;
    private Severity StatusSeverity { get; set; } = Severity.Info;

    protected override async Task OnParametersSetAsync()
    {
        var normalized = RequestId?.Trim();
        if (string.Equals(normalized, LoadedRequestId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        LoadedRequestId = normalized;
        Recommendation = null;
        Detail = null;

        if (string.IsNullOrWhiteSpace(normalized))
        {
            SetStatus("추천 의뢰 ID가 필요합니다.", Severity.Warning);
            return;
        }

        await LoadAsync(normalized);
    }

    private async Task LoadAsync(string requestId)
    {
        IsBusy = true;
        SetStatus("추천 상세를 조회하는 중입니다.", Severity.Info);

        try
        {
            Recommendation = 추천Service.선택추천조회(requestId);
            if (Recommendation is null)
            {
                var items = await 추천Service.추천조회Async(기사추천조회범위.전체);
                Recommendation = items.FirstOrDefault(
                    item => string.Equals(item.의뢰Id, requestId, StringComparison.OrdinalIgnoreCase));
                if (Recommendation is not null)
                {
                    추천Service.선택추천설정(Recommendation, "서버 추천 재조회");
                }
            }

            if (Recommendation is null)
            {
                SetStatus("현재 계정에 제시된 추천 목록에서 이 의뢰를 찾지 못했습니다.", Severity.Warning);
                return;
            }

            try
            {
                Detail = await 추천Service.상세조회Async(requestId);
                SetStatus("추천 조건과 서버 원장 상태를 조회했습니다.", Severity.Success);
            }
            catch (Exception ex)
            {
                SetStatus(
                    $"추천 조건은 표시했지만 서버 원장 상세는 확인하지 못했습니다. {ex.Message}",
                    Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }
}
