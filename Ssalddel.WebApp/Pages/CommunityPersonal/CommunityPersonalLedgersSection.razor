@using Ssalddel.WebApp.Models
@using Ssalddel.WebApp.ViewModels

<section class="community-personal-section" aria-labelledby="personal-ledgers-title">
    <div class="community-personal-section-heading">
        <div><span>LEDGERS</span><h2 id="personal-ledgers-title">내 원장</h2></div>
        <MudButton Href="/community/write" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">원장으로 글쓰기</MudButton>
    </div>
    @if (Activity.IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (Activity.Ledgers.Count == 0)
    {
        <div class="community-personal-empty">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" />
            <strong>현재 계정에서 확인할 원장이 없습니다.</strong>
            <span>게시글에서 참여가 모이면 가원장을 만들고, 실행 조건이 갖춰질 때 실제 원장으로 이어갈 수 있습니다.</span>
        </div>
    }
    else
    {
        <div class="community-personal-list">
            @foreach (var ledger in Activity.Ledgers)
            {
                <a href="/community/workspace">
                    <span class="community-personal-list-icon"><MudIcon Icon="@Icons.Material.Filled.Assignment" /></span>
                    <span><strong>@ledger.제목</strong><small>@ledger.원장템플릿명 · @CommunityPersonalPresentation.FormatDate(ledger.수정시각Utc)</small></span>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </a>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public CommunityPersonalActivityViewModel Activity { get; set; } = default!;
}
