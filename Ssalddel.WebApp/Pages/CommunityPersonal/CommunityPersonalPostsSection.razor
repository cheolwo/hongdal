@using Ssalddel.WebApp.Models
@using Ssalddel.WebApp.ViewModels

<section class="community-personal-section" aria-labelledby="personal-posts-title">
    <div class="community-personal-section-heading">
        <div><span>POSTS</span><h2 id="personal-posts-title">내 글</h2></div>
        <MudButton Href="/community/write" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">글쓰기</MudButton>
    </div>
    @if (Activity.IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (Activity.Posts.Count == 0)
    {
        <div class="community-personal-empty">
            <MudIcon Icon="@Icons.Material.Filled.Article" />
            <strong>계정에 연결된 글이 없습니다.</strong>
            <span>닉네임으로 쓴 글은 글 비밀번호로 관리되고, 로그인 계정 글만 이곳에 모입니다.</span>
        </div>
    }
    else
    {
        <div class="community-personal-list">
            @foreach (var post in Activity.Posts)
            {
                <a href="@($"/community/posts/{post.Id}")">
                    <span class="community-personal-list-icon"><MudIcon Icon="@Icons.Material.Filled.Article" /></span>
                    <span><strong>@post.Title</strong><small>@post.Category · @CommunityPersonalPresentation.FormatDate(post.CreatedAtUtc)</small></span>
                    <span class="community-personal-list-count">댓글 @post.CommentCount</span>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </a>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public CommunityPersonalActivityViewModel Activity { get; set; } = default!;
}
