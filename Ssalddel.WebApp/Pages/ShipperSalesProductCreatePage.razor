@page "/shipper/sales/products/new"
@inject ShipperSalesProductCreatePageViewModel ViewModel

<PageTitle>판매상품 등록</PageTitle>

<WebPageHeader Eyebrow="Shipper Web · 2.5"
               Title="판매상품 등록"
               Description="주소의 재고 ID 한 건을 다시 조회하고 내부 판매상품 원장만 생성합니다."
               Badge="내부 원장 저장" />

<MudButton Href="@ShipperRoutes.WarehouseInventory"
           Variant="Variant.Text"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.ArrowBack"
           Class="mb-3">
    재고 원장으로
</MudButton>

@if (ViewModel.IsBusy && ViewModel.Inventory is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
    {
        <MudAlert Severity="@(ViewModel.HasError ? Severity.Error : Severity.Success)"
                  Variant="Variant.Outlined"
                  Class="mb-4">
            @ViewModel.StatusMessage
        </MudAlert>
    }

    @if (ViewModel.Inventory is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">선택 재고</MudText>
            <MudGrid Class="mt-1">
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">재고 ID</MudText>
                    <MudText>@ViewModel.Inventory.입고상품Id</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">상품</MudText>
                    <MudText>@ViewModel.Inventory.상품명</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">가용 수량</MudText>
                    <MudText>@ViewModel.Inventory.가용수량</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              Label="대표 상품명"
                              @bind-Value="ViewModel.ProductName"
                              Required="true"
                              Variant="Variant.Outlined" />
                <MudTextField T="string"
                              Label="판매 SKU"
                              @bind-Value="ViewModel.SalesSku"
                              Required="true"
                              Variant="Variant.Outlined" />
                <MudNumericField T="decimal"
                                 Label="판매가"
                                 @bind-Value="ViewModel.Price"
                                 Min="0"
                                 Variant="Variant.Outlined" />

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    상품 저장은 채널 출품을 자동 실행하지 않습니다. 저장 뒤 판매상품을 직접 선택해 별도 출품 준비 원장을 만듭니다.
                </MudAlert>

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@ViewModel.IsBusy"
                               OnClick="CreateAsync">
                        판매상품 저장
                    </MudButton>
                    <MudButton Href="@ShipperRoutes.SalesProducts"
                               Variant="Variant.Outlined"
                               Color="Color.Primary">
                        판매상품 원장
                    </MudButton>
                    @if (ViewModel.CreatedProduct is not null)
                    {
                        <MudButton Href="@ShipperRoutes.SalesListingCreateForProduct(ViewModel.CreatedProduct.Id)"
                                   Variant="Variant.Filled"
                                   Color="Color.Success">
                            이 상품 채널 출품 준비
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "inventoryItemId")]
    public long? InventoryItemId { get; set; }

    private bool Initialized;
    private long? LoadedInventoryItemId;

    protected override async Task OnParametersSetAsync()
    {
        if (Initialized && LoadedInventoryItemId == InventoryItemId)
        {
            return;
        }

        Initialized = true;
        LoadedInventoryItemId = InventoryItemId;
        await ViewModel.LoadAsync(InventoryItemId);
    }

    private Task CreateAsync()
        => ViewModel.CreateAsync();
}
