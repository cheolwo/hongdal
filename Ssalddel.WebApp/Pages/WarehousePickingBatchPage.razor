@page "/warehouse/work/picking-batch"
@page "/work/picking-batch"
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession
@implements IDisposable

<PageTitle>피킹 작업 · 살뜰</PageTitle>

<WebPageHeader Eyebrow="Warehouse Web"
               Title="피킹 작업"
               Description="서버에 배정된 피킹 작업을 조회하고 시작·완료 상태를 같은 작업 Key로 확인합니다."
               Badge="Beta · Simulation" />

@if (!AuthSession.IsLoggedIn)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">피킹 작업에는 로그인이 필요합니다.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                서버에서 창고 배정과 HR 피킹 역할을 확인합니다. 익명 허용 커뮤니티 게시판은 로그인 없이 계속 이용할 수 있습니다.
            </MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Justify="Justify.Center">
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">로그인</MudButton>
                <MudButton Href="/community" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Forum">익명 커뮤니티 보기</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}
else
{
    <SsalddelPickingTaskWorkspace TaskKey="@TaskKey"
                                  OnTaskSelected="UpdateTaskRoute" />
}

@code {
    [SupplyParameterFromQuery(Name = "taskKey")]
    public string? TaskKey { get; set; }

    protected override void OnInitialized()
        => AuthSession.Changed += AuthChanged;

    private void AuthChanged()
        => _ = InvokeAsync(StateHasChanged);

    private Task UpdateTaskRoute(string? taskKey)
    {
        var target = string.IsNullOrWhiteSpace(taskKey)
            ? WarehouseManagerRoutes.PickingBatch
            : $"{WarehouseManagerRoutes.PickingBatch}?taskKey={Uri.EscapeDataString(taskKey)}";
        Navigation.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }

    public void Dispose()
        => AuthSession.Changed -= AuthChanged;
}
