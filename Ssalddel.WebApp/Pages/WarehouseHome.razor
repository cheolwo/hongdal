@page "/warehouse"
@inject IWarehouseWorkspaceService WarehouseService

<RoleDashboardSurface Title="창고 운영 홈"
                      Badge="A-01"
                      Description="입고·재고·출고의 오늘 상태와 예외를 한눈에 봅니다."
                      Metrics="Metrics"
                      Tasks="Tasks"
                      IsLoading="_isLoading"
                      BoundaryTitle="교대 전 확인"
                      BoundaryDescription="미완료 작업과 예외 담당자를 확인한 뒤 다음 교대에 인계합니다.">
    <Notice>
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                @_statusMessage
            </MudAlert>
        }
    </Notice>
    <Footer>
        <a href="warehouse/workspace">전체 창고 업무 보기 ›</a>
    </Footer>
</RoleDashboardSurface>

@code {
    private IReadOnlyList<입고요청항목응답> _inbounds = [];
    private IReadOnlyList<재고항목응답> _inventory = [];
    private bool _isLoading;
    private string? _statusMessage;

    private int PendingInboundCount
        => _inbounds.Count(item =>
            !ContainsAny(item.상태, "완료", "취소"));

    private int ExceptionCount
        => _inbounds.Count(item =>
            ContainsAny(item.상태, "예외", "파손", "보류", "불일치"));

    private IReadOnlyList<RoleDashboardMetric> Metrics =>
    [
        new("입고 예정", $"{PendingInboundCount:N0}건"),
        new("재고 항목", $"{_inventory.Count:N0}건"),
        new("예외", $"{ExceptionCount:N0}건")
    ];

    private IReadOnlyList<RoleDashboardTask> Tasks =>
    [
        new(
            "입고",
            $"예정 {PendingInboundCount:N0} · 검수 화면으로 이동",
            $"{PendingInboundCount:N0}건",
            Relative(WarehouseManagerRoutes.ExpectedInbounds),
            RoleDashboardTone.Warning),
        new(
            "보관",
            $"재고 {_inventory.Count:N0} · 적재와 이동 확인",
            "재고",
            Relative(WarehouseManagerRoutes.GeneralInventory)),
        new(
            "출고",
            "피킹·포장과 출고 예정 원장을 확인합니다.",
            "작업",
            Relative(WarehouseManagerRoutes.PickingBatch),
            RoleDashboardTone.Success),
        new(
            "예외 인계",
            $"현재 확인 대상 {ExceptionCount:N0}건",
            "확인",
            Relative(WarehouseManagerRoutes.Exceptions),
            ExceptionCount > 0 ? RoleDashboardTone.Warning : RoleDashboardTone.Default)
    ];

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var inboundsTask = WarehouseService.GetInboundsAsync();
            var inventoryTask = WarehouseService.GetInventoryAsync();
            await Task.WhenAll(inboundsTask, inventoryTask);
            _inbounds = (await inboundsTask)?.Items ?? [];
            _inventory = (await inventoryTask)?.Items ?? [];
        }
        catch (Exception exception) when (exception is InvalidOperationException or HttpRequestException)
        {
            _statusMessage = "창고 수치는 로그인 후 서버 원장에서 확인됩니다.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static bool ContainsAny(string? value, params string[] keywords)
        => !string.IsNullOrWhiteSpace(value)
           && keywords.Any(keyword =>
               value.Contains(keyword, StringComparison.OrdinalIgnoreCase));

    private static string Relative(string path)
        => path.TrimStart('/');
}
