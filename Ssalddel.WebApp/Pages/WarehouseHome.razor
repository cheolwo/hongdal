@page "/warehouse"

<WebPageHeader Eyebrow="Warehouse Web"
               Title="창고 관리자 웹 작업공간"
               Description="WarehouseManagerApp의 입고, 스캔, 피킹, 포장, 알뜰살뜰 마트 흐름을 통합 WebAssembly 셸 안에서 검증합니다."
               Badge="WarehouseManagerApp 통합" />

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">창고 공정</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">입고, 출고, 포장, 배송대행 작업자가 들어오는 현장 공정입니다.</MudText>
                </MudStack>
                <WebPageLinkGrid Items="WorkflowLinks" />
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">도심 마트 풀필먼트</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">알뜰살뜰 마트처럼 좁은 도심 창고에서 피킹, 포장, 배달 기사 픽업까지 빠르게 처리합니다.</MudText>
                </MudStack>
                <WebPageLinkGrid Items="MartLinks" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">현장 단일 책임 화면</MudText>
                @foreach (var item in WorkItems)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<WebAppPageLink> WorkflowLinks =
    [
        new("입고 시작", "입고 작업자 확인 후 작업대 바코드와 상품 확인으로 이어갑니다.", WarehouseManagerRoutes.InboundWorkStart, Icons.Material.Filled.MoveToInbox, "창고"),
        new("입고 상품 확인", "상품 바코드로 입고 예정 상품을 찾고 현장 입고 예외를 등록합니다.", WarehouseManagerRoutes.InboundProductScan, Icons.Material.Filled.QrCodeScanner, "창고"),
        new("입고 검수", "수량 차이, 파손, 유통기한, 보관 조건을 검수합니다.", WarehouseManagerRoutes.InboundInspection, Icons.Material.Filled.FactCheck, "창고"),
        new("재고 현황", "현재 계정의 창고 범위에서 가용·예약 수량과 입고 근거를 확인합니다.", WarehouseManagerRoutes.GeneralInventory, Icons.Material.Filled.Warehouse, "창고"),
        new("적재 작업", "검수 완료 재고의 위치 표찰을 확인하고 보관 위치를 확정합니다.", WarehouseManagerRoutes.PutAwayTask, Icons.Material.Filled.Inventory, "창고"),
        new("포장 작업", "적재 완료 재고의 전체 가용수량과 포장 표찰을 확인합니다.", WarehouseManagerRoutes.PackingTask, Icons.Material.Filled.Inventory2, "창고"),
        new("출고 인계 준비", "포장 완료 재고를 출고예정 원장에 기록하고 운송 생성은 분리합니다.", WarehouseManagerRoutes.GeneralTransportHandoff, Icons.Material.Filled.LocalShipping, "창고"),
        new("출고예정 검토", "준비된 출고예정 원장과 운송의뢰 필수 입력을 읽기 전용으로 확인합니다.", WarehouseManagerRoutes.OutboundPlanReview, Icons.Material.Filled.FactCheck, "창고"),
        new("출고 운송의뢰", "검토를 통과한 출고예정에 실제 하차지·희망 일정·차량 조건을 저장하고 기사 인계 상태를 확인합니다.", WarehouseManagerRoutes.TransportRequestDraft, Icons.Material.Filled.LocalShipping, "창고"),
        new("일반 작업 보드", "입고, 적재, 출고, 포장 업무와 연결 대상을 확인합니다.", WarehouseManagerRoutes.WorkBoard, Icons.Material.Filled.ViewKanban, "창고"),
        new("피킹 작업", "서버에 배정된 피킹 작업의 시작·완료 상태를 처리합니다.", WarehouseManagerRoutes.PickingBatch, Icons.Material.Filled.Inventory2, "창고"),
        new("스캔 스테이션", "입고, 적재, 번들, 포장 작업의 바코드 스캔을 처리합니다.", WarehouseManagerRoutes.Scan, Icons.Material.Filled.QrCodeScanner, "창고")
    ];

    private static readonly IReadOnlyList<WebAppPageLink> MartLinks =
    [
        new("알뜰살뜰 마트 홈", "도심 입고, 보충, 주문 피킹/포장, 배달 픽업 진입점을 모읍니다.", WarehouseManagerRoutes.MartHome, Icons.Material.Filled.Storefront, "알뜰살뜰 마트"),
        new("알뜰살뜰 마트 작업 보드", "음식점 주문 보드처럼 빠르게 보되 창고 재고와 배달 픽업을 기준으로 처리합니다.", WarehouseManagerRoutes.MartWorkBoard, Icons.Material.Filled.Dashboard, "알뜰살뜰 마트"),
        new("도심 입고", "납품, 반품, 거점 이동 물량을 창고 재고로 확인합니다.", WarehouseManagerRoutes.MartInboundWorkStart, Icons.Material.Filled.MoveToInbox, "알뜰살뜰 마트"),
        new("피킹/포장", "고객 주문별로 상품을 피킹하고 포장 완료 상태까지 처리합니다.", WarehouseManagerRoutes.MartPickingWorkStart, Icons.Material.Filled.ShoppingCartCheckout, "알뜰살뜰 마트")
    ];

    private static readonly IReadOnlyList<(string Title, string Description)> WorkItems =
    [
        ("입고 검수", "상품 정보, 보관 조건, 라벨 필요 여부 확인"),
        ("적재대 스캔", "위치 바코드와 상품 바코드 매칭"),
        ("피킹", "할당된 수량만큼 상품을 꺼내는 작업"),
        ("포장", "피킹 완료 상품을 주문/배송 단위로 묶는 작업")
    ];
}
