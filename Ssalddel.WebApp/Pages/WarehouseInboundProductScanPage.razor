@page "/warehouse/work/inbound/products"
@page "/work/inbound/products"
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession
@implements IDisposable

<PageTitle>입고상품 수령 · 살뜰</PageTitle>

<WebPageHeader Eyebrow="Warehouse Web"
               Title="입고상품 수령"
               Description="상품 바코드로 서버 입고예정을 찾고, 일치 항목이 없으면 현장 반입 요청만 기록합니다."
               Badge="Beta · 플랫폼 저장" />

@if (!AuthSession.IsLoggedIn)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">입고 원장 조회와 저장에는 로그인이 필요합니다.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                창고 배정과 HR 세부 역할을 서버에서 확인합니다. 커뮤니티의 익명 허용 게시판은 로그인 없이 계속 이용할 수 있습니다.
            </MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Justify="Justify.Center">
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">로그인</MudButton>
                <MudButton Href="/community" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Forum">익명 커뮤니티 보기</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}
else
{
    <SsalddelInboundReceivingWorkspace InboundId="@InboundId"
                                       WorkBoardPath="@WarehouseManagerRoutes.WorkBoard"
                                       OnInboundSelected="UpdateInboundRoute" />
}

@code {
    [SupplyParameterFromQuery(Name = "inboundId")]
    public long? InboundId { get; set; }

    protected override void OnInitialized()
        => AuthSession.Changed += AuthChanged;

    private void AuthChanged()
        => _ = InvokeAsync(StateHasChanged);

    private Task UpdateInboundRoute(long? inboundId)
    {
        var target = inboundId is > 0
            ? $"{WarehouseManagerRoutes.InboundProductScan}?inboundId={inboundId.Value}"
            : WarehouseManagerRoutes.InboundProductScan;
        Navigation.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }

    public void Dispose()
        => AuthSession.Changed -= AuthChanged;
}
