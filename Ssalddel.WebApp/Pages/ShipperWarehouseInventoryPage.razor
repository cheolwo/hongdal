@page "/shipper/warehouse/inventory"
@inject NavigationManager Navigation

<PageTitle>화주 재고 원장</PageTitle>

<SsalddelWarehouseInventoryHub
    Title="화주 재고 원장"
    Description="서버의 사용자 소유 재고를 조회하고, 선택한 재고의 다음 업무는 독립 화면에서 진행합니다."
    AuxiliaryMetricLabel="실행 경계"
    AuxiliaryMetricValue="조회 전용"
    OnReconsignmentRequested="OpenReconsignment"
    OnSaleRequested="OpenProductCreate" />

@code {
    private Task OpenReconsignment(재고항목응답 item)
    {
        Navigation.NavigateTo(
            ShipperRoutes.ReconsignmentOrdersForInventory(item.입고상품Id));
        return Task.CompletedTask;
    }

    private Task OpenProductCreate(재고항목응답 item)
    {
        Navigation.NavigateTo(
            ShipperRoutes.SalesProductCreateForInventory(item.입고상품Id));
        return Task.CompletedTask;
    }
}
