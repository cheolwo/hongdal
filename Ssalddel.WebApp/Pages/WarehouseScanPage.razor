@page "/warehouse/scan"
@page "/scan"

<WebPageHeader Eyebrow="Warehouse Web"
               Title="스캔 스테이션"
               Description="입고, 적재, 번들, 포장 작업의 바코드 스캔을 처리합니다."
               Badge="스캔 웹 검증" />

<MudStack Spacing="3">
    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect T="string" Label="작업 단계" @bind-Value="Step" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@WarehouseScanStepCode.ReceiveInbound">입고 스캔</MudSelectItem>
                    <MudSelectItem T="string" Value="@WarehouseScanStepCode.SplitProduct">상품 분할</MudSelectItem>
                    <MudSelectItem T="string" Value="@WarehouseScanStepCode.CreateBundle">번들 생성</MudSelectItem>
                    <MudSelectItem T="string" Value="@WarehouseScanStepCode.PutAway">적재 스캔</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8" Class="d-flex align-center">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    샘플 prefix: INB, SKU, LOC, BND, HU. 실제 장비 연결 전에는 키보드 입력이나 스캐너 HID 입력으로 검증합니다.
                </MudAlert>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <SsalddelWarehouseScanStation Step="@Step"
                                     Scans="@Scans"
                                     ScansChanged="OnScansChangedAsync"
                                     ActionConfirmed="OnActionConfirmedAsync"
                                     Title="@StepTitle"
                                     ConfirmButtonText="작업 확인"
                                     ClearButtonText="스캔 초기화"
                                     ScannerId="warehouse-manager-web" />
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <MudAlert Severity="Severity.Success">@Message</MudAlert>
    }
</MudStack>

@code {
    private readonly List<WarehouseBarcodeScan> Scans = [];
    private string Step = WarehouseScanStepCode.ReceiveInbound;
    private string? Message;

    private string StepTitle => Step switch
    {
        WarehouseScanStepCode.ReceiveInbound => "입고 스캔",
        WarehouseScanStepCode.SplitProduct => "상품 분할",
        WarehouseScanStepCode.CreateBundle => "번들 생성",
        WarehouseScanStepCode.PutAway => "적재 스캔",
        _ => "창고 스캔"
    };

    private Task OnScansChangedAsync(IReadOnlyList<WarehouseBarcodeScan> value)
    {
        Scans.Clear();
        Scans.AddRange(value);
        return Task.CompletedTask;
    }

    private Task OnActionConfirmedAsync(WarehouseScanAction action)
    {
        if (action.IsReady)
        {
            Message = $"{action.DisplayName} 작업 확인됨: {string.Join(", ", action.Scans.Select(x => x.RawCode))}";
            Scans.Clear();
        }

        return Task.CompletedTask;
    }
}
