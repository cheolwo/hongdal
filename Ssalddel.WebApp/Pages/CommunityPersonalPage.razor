@page "/community/me"
@page "/community/me/{SectionKey}"
@inherits MvvmComponentBase<CommunityPersonalPageViewModel>
@using Ssalddel.WebApp.Pages.CommunityPersonal
@using Ssalddel.WebApp.ViewModels

<PageTitle>@RouteContext.PageTitle</PageTitle>

<main class="community-personal-shell">
    <header class="community-personal-header">
        <div class="community-personal-avatar" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Person" />
        </div>
        <div>
            <span>MY COMMUNITY</span>
            <h1>@ViewModel.Activity.IdentityLabel</h1>
            <p>@ViewModel.Activity.IdentityDescription</p>
        </div>
        <MudChip T="string" Variant="Variant.Outlined" Color="@(ViewModel.Activity.IsLoggedIn ? Color.Success : Color.Default)" Size="Size.Small">
            @(ViewModel.Activity.IsLoggedIn ? "계정 연결됨" : "방문자")
        </MudChip>
    </header>

    <nav class="community-personal-tabs" aria-label="내 커뮤니티 메뉴">
        @foreach (var section in CommunityPersonalRouteContext.Sections)
        {
            <a href="@section.Href"
               class="@BuildSectionClass(section.Key)"
               aria-current="@(RouteContext.SectionKey == section.Key ? "page" : null)">
                <MudIcon Icon="@ResolveSectionIcon(section.Key)" Size="Size.Small" />
                <span>@section.Title</span>
            </a>
        }
    </nav>

    @switch (RouteContext.SectionKey)
    {
        case "posts":
            <CommunityPersonalPostsSection Activity="@ViewModel.Activity" />
            break;
        case "actions":
            <CommunityPersonalActionsSection />
            break;
        case "ledgers":
            <CommunityPersonalLedgersSection Activity="@ViewModel.Activity" />
            break;
        case "notifications":
            <CommunityPersonalNotificationsSection Preferences="@ViewModel.Preferences" />
            break;
        case "decorations":
            <CommunityPersonalDecorationsSection Decorations="@ViewModel.Decorations" />
            break;
        case "settings":
            <CommunityPersonalSettingsSection Preferences="@ViewModel.Preferences" />
            break;
        default:
            <CommunityPersonalOverviewSection Activity="@ViewModel.Activity"
                                              Decorations="@ViewModel.Decorations" />
            break;
    }

    @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
    {
        <MudAlert Severity="@ResolveStatusSeverity(ViewModel.StatusTone)" Variant="Variant.Outlined" Dense="true">
            @ViewModel.StatusMessage
        </MudAlert>
    }
</main>

@code {
    [Parameter]
    public string? SectionKey { get; set; }

    private CommunityPersonalRouteContext RouteContext { get; set; }
        = CommunityPersonalRouteContext.Resolve(sectionKey: null);

    protected override void OnParametersSet()
    {
        RouteContext = CommunityPersonalRouteContext.Resolve(SectionKey);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ViewModel.InitializeAsync();
    }

    private string BuildSectionClass(string key)
        => key == RouteContext.SectionKey
            ? "community-personal-tab community-personal-tab--active"
            : "community-personal-tab";

    private static string ResolveSectionIcon(string key)
        => key switch
        {
            "posts" => Icons.Material.Filled.Article,
            "actions" => Icons.Material.Filled.Groups,
            "ledgers" => Icons.Material.Filled.Assignment,
            "notifications" => Icons.Material.Filled.Notifications,
            "decorations" => Icons.Material.Filled.Palette,
            "settings" => Icons.Material.Filled.Settings,
            _ => Icons.Material.Filled.AccountCircle
        };

    private static Severity ResolveStatusSeverity(CommunityPersonalMessageTone tone)
        => tone switch
        {
            CommunityPersonalMessageTone.Success => Severity.Success,
            CommunityPersonalMessageTone.Warning => Severity.Warning,
            _ => Severity.Info
        };
}
