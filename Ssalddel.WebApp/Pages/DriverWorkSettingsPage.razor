@page "/driver/work/settings"
@inject 기사운행Service 운행Service

<WebPageHeader Eyebrow="Driver Web"
               Title="운행 설정"
               Description="운행 시작 기준, 복귀지, 최근 운행 상태를 확인합니다."
               Badge="운행 기준" />

<MudGrid>
    <MudItem xs="12" lg="7">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">현재 근무</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@IsBusy" StartIcon="@Icons.Material.Filled.Sync" OnClick="LoadAsync">
                        새로고침
                    </MudButton>
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(StatusMessage))
                {
                    <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined">@StatusMessage</MudAlert>
                }

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">운행 상태</MudText>
                        <MudText Typo="Typo.body1">@Display(CurrentWork?.운행상태, WorkStatus?.Status, "미확인")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">시작 모드</MudText>
                        <MudText Typo="Typo.body1">@Display(CurrentWork?.시작모드, "미확인")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">시작 위치</MudText>
                        <MudText Typo="Typo.body1">@Display(CurrentWork?.시작위치, "미확인")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">복귀지</MudText>
                        <MudText Typo="Typo.body1">@Display(CurrentWork?.복귀지, CurrentWork?.오늘의복귀지주소, "미설정")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">최근 위치</MudText>
                        <MudText Typo="Typo.body1">@LocationLabel</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">갱신 시각</MudText>
                        <MudText Typo="Typo.body1">@DisplayDate(WorkStatus?.최근위치수신시각, WorkStatus?.UpdatedAt)</MudText>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="5">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">이동</MudText>
                <MudButton Href="/driver/work/start" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow">
                    운행 시작
                </MudButton>
                <MudButton Href="/driver/me" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AccountCircle">
                    내 정보 메뉴
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private Ssalddel.Contracts.Driver.Work.기사현재근무응답? CurrentWork { get; set; }
    private Ssalddel.Contracts.Driver.Work.기사운행상태응답? WorkStatus { get; set; }
    private bool IsBusy { get; set; }
    private string? StatusMessage { get; set; }
    private Severity StatusSeverity { get; set; } = Severity.Info;

    private string LocationLabel
        => WorkStatus?.현재위도 is null || WorkStatus?.현재경도 is null
            ? "위치 미확인"
            : $"{WorkStatus.현재위도:F6}, {WorkStatus.현재경도:F6}";

    protected override async Task OnInitializedAsync()
    {
        await TryLoadAsync();
    }

    private async Task TryLoadAsync()
    {
        try
        {
            await LoadCoreAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"운행 설정을 아직 불러오지 못했습니다. {ex.Message}", Severity.Info);
        }
    }

    private async Task LoadAsync()
    {
        IsBusy = true;
        SetStatus("운행 설정을 조회하는 중입니다.", Severity.Info);

        try
        {
            await LoadCoreAsync();
            SetStatus("운행 설정을 조회했습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LoadCoreAsync()
    {
        WorkStatus = await 운행Service.운행상태조회Async();
        CurrentWork = await 운행Service.현재근무조회Async();
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }

    private static string Display(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static string DisplayDate(params DateTime?[] values)
    {
        var value = values.FirstOrDefault(x => x.HasValue);
        return value.HasValue ? value.Value.ToLocalTime().ToString("MM-dd HH:mm") : "-";
    }
}
