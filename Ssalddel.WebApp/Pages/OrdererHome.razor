@page "/orderer"
@inject OrdererBetaReadinessService ReadinessService
@inject WebAuthSessionService AuthSession

<WebPageHeader Eyebrow="Orderer Web"
               Title="주문자 1.5 점검 작업공간"
               Description="개별 필요에서 시작해 공동구매 수요를 모으고, 수입·수출 준비 원장을 Simulation 경계에서 점검합니다."
               Badge="문화교통 1.5 베타" />

@if (_readiness is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        서버 연결 상태를 확인하고 있습니다.
    </MudAlert>
}
else
{
    <MudAlert Severity="@(_readiness.IsReady ? Severity.Success : Severity.Warning)"
              Variant="Variant.Outlined"
              Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2">
                <b>@(_readiness.IsReady ? "점검 서버 연결됨" : "점검 서버 확인 필요")</b>
                · @_readiness.Message
            </MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RefreshReadinessAsync">
                다시 확인
            </MudButton>
        </MudStack>
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" lg="8">
        <WebPageLinkGrid Items="Links" />
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">현재 실행 경계</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    주문자의 개별 수요와 주문 원장을 먼저 보존한 뒤, 동의한 정보만 공동구매와 공동수출 집계 원장에 연결합니다.
                </MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    계약·결제·신고 제출·포워더 자동 선정·외부 전송은 실행하지 않습니다. 현재 화면은 플랫폼 원장 저장과 검토용입니다.
                </MudAlert>
                @if (!AuthSession.IsLoggedIn)
                {
                    <MudButton Href="/login?returnUrl=%2Forderer"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Login">
                        로그인해서 원장 점검하기
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<WebAppPageLink> Links =
    [
        new("공동구매 둘러보기", "공개 모집과 참여 조건을 확인하고 개별 수요가 공동성으로 이어지는 흐름을 살펴봅니다.", WebOrdererRoutes.GroupPurchase, Icons.Material.Filled.GroupWork, "1.0"),
        new("공동구매 수요 등록", "여러 재료와 배송 조건을 비구속 수요로 남기고 주문자 집단 후보를 기다립니다.", WebOrdererRoutes.GroupPurchaseDemand, Icons.Material.Filled.PlaylistAdd, "1.0"),
        new("개별수입 원장", "기존 개별주문을 원천으로 수입 주체·판매자·통관 검토 상태를 연결합니다.", WebOrdererRoutes.IndividualImportLedger, Icons.Material.Filled.MoveToInbox, "1.5"),
        new("개별수출 원장", "개별주문에서 수출자·해외 구매자·요건·서류 검토 상태를 분리해 기록합니다.", WebOrdererRoutes.IndividualExportLedger, Icons.Material.Filled.Outbox, "1.5"),
        new("공동수출 원장", "여러 개별수출을 집하·합포장·포워더 인계 후보로 묶되 신고 원본은 보존합니다.", WebOrdererRoutes.GroupExportLedger, Icons.Material.Filled.Inventory, "1.5"),
        new("공식 식재료 정보", "공공 데이터와 출처·확인 시각을 살펴보고 공동구매 재료 후보를 검토합니다.", "/information/food-ingredients", Icons.Material.Filled.MenuBook, "정보"),
        new("마트 공개 상품", "공개 상품과 투영된 판매 가능 수량을 로그인 없이 확인합니다.", WebOrdererRoutes.Mart, Icons.Material.Filled.Storefront, "마트"),
        new("마트 주문 요청", "상품을 선택한 뒤 비구속 구매 의향을 서버 원장에 저장합니다.", WebOrdererRoutes.MartOrderRequest, Icons.Material.Filled.AddShoppingCart, "마트"),
        new("커뮤니티", "같은 품목, 같은 배송권의 사용자 경험을 공유합니다.", "/community", Icons.Material.Filled.Forum, "Common")
    ];

    private OrdererBetaReadiness? _readiness;

    protected override Task OnInitializedAsync()
        => RefreshReadinessAsync();

    private async Task RefreshReadinessAsync()
    {
        _readiness = await ReadinessService.CheckAsync();
    }
}
