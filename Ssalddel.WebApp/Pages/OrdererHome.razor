@page "/orderer"

<WebPageHeader Eyebrow="Orderer Web"
               Title="주문자 웹 작업공간"
               Description="공동주문 의사 표시, 공개 마트 상품과 비구속 주문 요청을 한 웹 작업공간에서 확인합니다."
               Badge="주문자 통합 베타" />

<MudGrid>
    <MudItem xs="12" lg="8">
        <WebPageLinkGrid Items="Links" />
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">자동 집단화 관점</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    주문자가 가볍게 의사를 남기면 서버가 배송권, 품목, 시기 기준으로 주문자 집단 후보를 형성하는 방향으로 확장합니다.
                </MudText>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    마트 주문 요청은 플랫폼 원장에 저장되지만 재고 예약·결제·피킹·배송은 실행하지 않습니다. 공동주문 집단화와 실제 결제도 별도 단계입니다.
                </MudAlert>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<WebAppPageLink> Links =
    [
        new("마트 공개 상품", "공개 상품과 투영된 판매 가능 수량을 로그인 없이 확인합니다.", WebOrdererRoutes.Mart, Icons.Material.Filled.Storefront, "마트"),
        new("마트 주문 요청", "상품을 선택한 뒤 비구속 구매 의향을 서버 원장에 저장합니다.", WebOrdererRoutes.MartOrderRequest, Icons.Material.Filled.AddShoppingCart, "마트"),
        new("공동주문 의사 표시", "구매 의사를 가볍게 남기고 주문자 집단 형성을 기다립니다.", WebOrdererRoutes.Home, Icons.Material.Filled.GroupAdd, "Orderer"),
        new("커뮤니티", "같은 품목, 같은 배송권의 사용자 경험을 공유합니다.", "/community", Icons.Material.Filled.Forum, "Common")
    ];
}
