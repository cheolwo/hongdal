@page "/driver/recommendations"
@implements IAsyncDisposable
@using Ssalddel.Contracts.Driver.Recommendation
@using Ssalddel.WebApp.Pages.DriverRecommendationComponents
@inject I기사추천수신Service 추천Service
@inject NavigationManager Navigation

<PageTitle>기사 추천 목록</PageTitle>

<WebPageHeader Eyebrow="살뜰 2.0 · 기사"
               Title="추천 목록"
               Description="현재 기사에게 제시된 추천만 조회하고, 상세 조건과 수락·거절 판단은 각각의 전용 화면으로 넘깁니다."
               Badge="조회 전용" />

<MudGrid>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween"
                              Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">추천 수신</MudText>
                        <MudChip T="string" Color="@ConnectionColor" Size="Size.Small">
                            @추천Service.연결상태
                        </MudChip>
                    </MudStack>

                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                        이 화면은 추천을 조회만 합니다. 운행 시작과 위치 전송은 운행 시작 화면에서, 수락·거절은 배차 판단 화면에서 수행합니다.
                    </MudAlert>

                    <MudSelect T="기사추천조회범위"
                               @bind-Value="QueryScope"
                               Label="추천 조회 범위"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="기사추천조회범위" Value="@기사추천조회범위.전체">전체 추천</MudSelectItem>
                        <MudSelectItem T="기사추천조회범위" Value="@기사추천조회범위.운행중">운행 중 추천</MudSelectItem>
                        <MudSelectItem T="기사추천조회범위" Value="@기사추천조회범위.비운행중">비운행 중 추천</MudSelectItem>
                        <MudSelectItem T="기사추천조회범위" Value="@기사추천조회범위.전국콜">전국콜</MudSelectItem>
                    </MudSelect>

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@IsBusy"
                                   StartIcon="@Icons.Material.Filled.Hub"
                                   OnClick="ConnectAsync">
                            실시간 연결
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   Disabled="@IsBusy"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   OnClick="LoadAsync">
                            서버 조회
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Warning"
                                   Disabled="@IsBusy"
                                   StartIcon="@Icons.Material.Filled.Science"
                                   OnClick="LoadMockAsync">
                            모의 추천
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">다음 행동</MudText>
                    <MudButton Href="@DriverRoutes.WorkStart"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.PlayArrow">
                        운행 시작·위치 전송
                    </MudButton>
                    <MudButton Href="@DriverRoutes.CurrentTransport"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.LocalShipping">
                        진행 중 운송 확인
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudStack Spacing="3">
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined">
                    @StatusMessage
                </MudAlert>
            }

            @if (IsBusy && Recommendations.Count == 0)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (Recommendations.Count == 0)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationsNone"
                                 Size="Size.Large"
                                 Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">현재 표시할 추천이 없습니다</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            서버 조회를 다시 시도하거나 모의 추천으로 화면 흐름을 점검할 수 있습니다.
                        </MudText>
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <MudGrid>
                    @foreach (var item in Recommendations)
                    {
                        <MudItem xs="12" md="6">
                            <DriverRecommendationListItem Item="@item"
                                                          OpenRequested="OpenRecommendation" />
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private readonly List<기사추천수신항목> Recommendations = [];
    private 기사추천조회범위 QueryScope { get; set; } = 기사추천조회범위.전체;
    private bool IsBusy { get; set; }
    private string StatusMessage { get; set; } = string.Empty;
    private Severity StatusSeverity { get; set; } = Severity.Info;

    private Color ConnectionColor
        => string.Equals(추천Service.연결상태, "Connected", StringComparison.OrdinalIgnoreCase)
            ? Color.Success
            : Color.Default;

    protected override void OnInitialized()
    {
        추천Service.추천수신 += OnRecommendationsReceivedAsync;
        추천Service.상태변경 += OnConnectionStatusChangedAsync;
    }

    private Task ConnectAsync()
        => RunAsync(
            "실시간 추천 수신 연결을 확인했습니다.",
            cancellationToken => 추천Service.연결Async(cancellationToken));

    private Task LoadAsync()
        => RunAsync(
            "서버 추천 목록을 조회했습니다.",
            async cancellationToken =>
            {
                var items = await 추천Service.추천조회Async(QueryScope, cancellationToken);
                ReplaceRecommendations(items);
            });

    private Task LoadMockAsync()
    {
        ReplaceRecommendations(추천Service.모의추천목록());
        SetStatus(
            "모의 추천을 준비했습니다. 상세 조건을 확인한 뒤 별도 배차 판단 화면으로 이동할 수 있습니다.",
            Severity.Info);
        return Task.CompletedTask;
    }

    private void OpenRecommendation(기사추천수신항목 item)
    {
        var now = DateTimeOffset.UtcNow;
        var deadline = DriverRecommendationPresentation.ResolveDeadline(item, null, now);
        var responseSeconds = Math.Max(1, (int)Math.Ceiling((deadline - now).TotalSeconds));
        추천Service.선택추천설정(item, "추천 목록", deadline, responseSeconds);
        Navigation.NavigateTo(DriverRoutes.RecommendationFor(item.의뢰Id));
    }

    private async Task OnRecommendationsReceivedAsync(IReadOnlyList<기사추천수신항목> items)
    {
        await InvokeAsync(() =>
        {
            ReplaceRecommendations(items);
            SetStatus("새 추천을 수신했습니다.", Severity.Info);
            StateHasChanged();
        });
    }

    private async Task OnConnectionStatusChangedAsync(string message)
    {
        await InvokeAsync(() =>
        {
            SetStatus(message, Severity.Info);
            StateHasChanged();
        });
    }

    private void ReplaceRecommendations(IEnumerable<기사추천수신항목> items)
    {
        Recommendations.Clear();
        Recommendations.AddRange(
            items
                .Where(item => !string.IsNullOrWhiteSpace(item.의뢰Id))
                .GroupBy(item => item.의뢰Id, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First()));
    }

    private async Task RunAsync(
        string successMessage,
        Func<CancellationToken, Task> action)
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        SetStatus("서버 요청을 처리하는 중입니다.", Severity.Info);

        try
        {
            await action(CancellationToken.None);
            SetStatus(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }

    public async ValueTask DisposeAsync()
    {
        추천Service.추천수신 -= OnRecommendationsReceivedAsync;
        추천Service.상태변경 -= OnConnectionStatusChangedAsync;
        await 추천Service.연결해제Async();
    }
}
