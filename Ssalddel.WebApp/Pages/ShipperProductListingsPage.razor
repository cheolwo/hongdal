@page "/shipper/sales/listings"
@inject ShipperSalesListingsPageViewModel ViewModel

<PageTitle>채널 출품 원장</PageTitle>

<WebPageHeader Eyebrow="Shipper Web · 2.5"
               Title="채널 출품 원장"
               Description="내부 판매상품과 판매채널 계정의 연결 준비 상태만 조회합니다."
               Badge="조회 전용" />

<MudStack Row="true"
          Justify="Justify.FlexEnd"
          Spacing="1"
          Wrap="Wrap.Wrap"
          Class="mb-4">
    <MudButton Href="@ShipperRoutes.SalesProducts"
               Variant="Variant.Outlined"
               Color="Color.Primary">
        판매상품 원장
    </MudButton>
    <MudButton Href="@ShipperRoutes.SalesListingCreate"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.AddBusiness">
        채널 출품 준비
    </MudButton>
</MudStack>

@if (ViewModel.IsBusy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        @ViewModel.ErrorMessage
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   OnClick="ReloadAsync">
            다시 조회
        </MudButton>
    </MudAlert>
}
else if (ViewModel.Listings.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        저장된 채널 출품 준비 원장이 없습니다. 판매상품과 채널계정을 직접 선택해 준비 원장을 만들 수 있습니다.
    </MudAlert>
}
else
{
    <MudTable Items="ViewModel.Listings.OrderByDescending(item => item.Id)"
              Dense="true"
              Hover="true"
              Elevation="0">
        <HeaderContent>
            <MudTh>출품 ID</MudTh>
            <MudTh>판매상품</MudTh>
            <MudTh>판매채널</MudTh>
            <MudTh>채널상품번호</MudTh>
            <MudTh>출품 상태</MudTh>
            <MudTh>동기화 상태</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="출품 ID">@context.Id</MudTd>
            <MudTd DataLabel="판매상품">
                @ViewModel.ProductName(context.판매상품Id)
            </MudTd>
            <MudTd DataLabel="판매채널">
                @ViewModel.AccountName(context.판매채널계정Id)
            </MudTd>
            <MudTd DataLabel="채널상품번호">
                @(string.IsNullOrWhiteSpace(context.채널상품번호) ? "발행 전" : context.채널상품번호)
            </MudTd>
            <MudTd DataLabel="출품 상태">@context.출품상태</MudTd>
            <MudTd DataLabel="동기화 상태">@context.동기화상태</MudTd>
        </RowTemplate>
    </MudTable>
}

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
    이 화면은 내부 준비 원장만 표시합니다. 외부 판매채널 발행·주문 동기화는 운영 승인 전 실행하지 않습니다.
</MudAlert>

@code {
    protected override Task OnInitializedAsync()
        => ViewModel.LoadAsync();

    private Task ReloadAsync()
        => ViewModel.LoadAsync();
}
