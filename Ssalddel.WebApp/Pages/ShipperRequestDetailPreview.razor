@page "/shipper/request/detail"
@page "/shipper/request/{RequestId}"
@inject ShipperRequestDetailPageViewModel PageModel
@inject NavigationManager Navigation
@using Ssalddel.Contracts.Common.Privacy

<PageTitle>운송 의뢰 요약</PageTitle>

<ShipperRequestSummaryScreen State="@PageModel.State"
                             Context="@RouteContext"
                             HomeHref="@ShipperRoutes.Home"
                             NewRequestHref="@ShipperRoutes.Request"
                             LoginHref="/login"
                             RefreshRequested="RefreshAsync"
                             LookupRequested="OpenRequest" />

@if (!string.IsNullOrWhiteSpace(EffectiveRequestId))
{
    <ApplicationPrivacyWithdrawalPanel WorkCode="@신청개인정보업무Codes.운송대행"
                                       OperationalSourceType="CargoTransportRequest"
                                       OperationalSourceId="@EffectiveRequestId" />
    <MapApplicationOperationalCancellationPanel WorkCode="@신청개인정보업무Codes.운송대행"
                                                OperationalSourceType="CargoTransportRequest"
                                                OperationalSourceId="@EffectiveRequestId" />
}

@code {
    [Parameter] public string? RequestId { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? LegacyRequestId { get; set; }

    [SupplyParameterFromQuery(Name = "created")]
    public bool Created { get; set; }

    [SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)]
    public string? ReturnPath { get; set; }

    private string? EffectiveRequestId
        => string.IsNullOrWhiteSpace(RequestId) ? LegacyRequestId : RequestId;

    private ShipperRequestDetailNavigationContext RouteContext
        => new() { ReturnPath = ReturnPath, Created = Created };

    protected override Task OnParametersSetAsync()
        => PageModel.LoadAsync(EffectiveRequestId, Created);

    private Task RefreshAsync()
        => PageModel.LoadAsync(EffectiveRequestId, Created);

    private void OpenRequest(string requestId)
    {
        if (string.IsNullOrWhiteSpace(requestId))
        {
            return;
        }

        var context = RouteContext with { Created = false };
        Navigation.NavigateTo(context.PathFor(ShipperRequestDetailScreenKind.Summary, requestId));
    }
}
