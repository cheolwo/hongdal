@implements IDisposable
@inject NavigationManager Navigation
@inject WebAuthSessionService AuthSession

<div class="web-navigation-shell">
    <div class="web-navigation-main">
        <MudStack Spacing="0" Class="px-4 pt-3 pb-2">
            <MudText Typo="Typo.overline" Color="Color.Secondary">
                @(IsCommunityMode ? "살뜰 커뮤니티" : "살뜰 업무")
            </MudText>
            <MudText Typo="Typo.subtitle2">@AuthSession.CurrentTheme.RoleLabel</MudText>
        </MudStack>

        <MudNavMenu Class="platform-navigation-menu">
            @foreach (var item in CurrentItems)
            {
                <MudNavLink Href="@item.Href"
                            Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                            Icon="@item.Icon">
                    @item.Title
                </MudNavLink>
            }
        </MudNavMenu>
    </div>

    <MudPaper Square="true" Elevation="0" Class="web-navigation-mode-switch pa-2">
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="@BusinessModeVariant"
                       Color="Color.Primary"
                       Size="Size.Small"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Work"
                       OnClick="OpenBusinessMode">
                업무
            </MudButton>
            <MudButton Variant="@CommunityModeVariant"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Forum"
                       OnClick="OpenCommunityMode">
                커뮤니티
            </MudButton>
        </MudStack>
    </MudPaper>
</div>

<style>
    .web-navigation-shell {
        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

    .web-navigation-main {
        flex: 1 1 auto;
    }

    .platform-navigation-menu {
        padding-bottom: 12px;
    }

    .web-navigation-mode-switch {
        position: sticky;
        bottom: 0;
        z-index: 2;
        border-top: 1px solid rgba(var(--mud-palette-primary-rgb), 0.12);
        background: var(--mud-palette-drawer-background);
    }

    .web-navigation-mode-switch .mud-button-root {
        min-width: 0;
    }
</style>

@code {
    private bool IsCommunityMode
        => WebNavigationCatalog.IsCommunityRoute(Navigation.ToBaseRelativePath(Navigation.Uri));

    private IReadOnlyList<WebNavigationItem> CurrentItems
        => IsCommunityMode
            ? WebNavigationCatalog.CommunityItems
            : WebNavigationCatalog.GetBusinessItems(AuthSession.CurrentTheme.ThemeCode);

    private Variant BusinessModeVariant => IsCommunityMode ? Variant.Outlined : Variant.Filled;

    private Variant CommunityModeVariant => IsCommunityMode ? Variant.Filled : Variant.Outlined;

    protected override void OnInitialized()
    {
        AuthSession.Changed += HandleStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void OpenBusinessMode()
        => Navigation.NavigateTo(WebNavigationCatalog.GetBusinessHome(AuthSession.CurrentTheme.ThemeCode));

    private void OpenCommunityMode()
        => Navigation.NavigateTo("/community");

    private void HandleStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthSession.Changed -= HandleStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
