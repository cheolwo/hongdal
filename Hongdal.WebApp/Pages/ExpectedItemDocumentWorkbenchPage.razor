@page "/tools/expected-item-documents"

<WebPageHeader Eyebrow="Document Tool"
               Title="예정 품목 문서 출력"
               Description="입고예정 품목표와 출고예정 품목표를 바코드 포함 HTML 문서로 출력합니다."
               Badge="인쇄 양식" />

<MudTabs Rounded="true" Elevation="0">
    <MudTabPanel Text="입고예정 품목표">
        <MudStack Spacing="3" Class="mt-3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                문서번호는 INB, 품목은 SKU/BND 바코드로 출력합니다. 프린터로 출력한 뒤 현장 입고 확인과 검수에서 그대로 스캔할 수 있게 맞춥니다.
            </MudAlert>
            <HongdalExpectedItemDocumentOutputPanel Draft="@InboundDraft" />
        </MudStack>
    </MudTabPanel>
    <MudTabPanel Text="출고예정 품목표">
        <MudStack Spacing="3" Class="mt-3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                기본값은 음식 주문 전표처럼 80mm 열전사 용지에 맞춘 전표형입니다. 피킹, 포장, 기사 픽업 전에 짧은 주문 전표로 확인합니다.
            </MudAlert>
            <HongdalExpectedItemDocumentOutputPanel Draft="@OutboundDraft" />
        </MudStack>
    </MudTabPanel>
</MudTabs>

