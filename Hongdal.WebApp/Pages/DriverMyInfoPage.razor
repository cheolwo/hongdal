@page "/driver/me"
@using Hongdal.Contracts.Driver.Profile
@inject 기사내정보Service 내정보Service
@inject WebAuthSessionService AuthSession

<WebPageHeader Eyebrow="Driver Web"
               Title="내 정보"
               Description="기사 홈 우측 상단에서 들어오는 정보 메뉴입니다. 프로필, 운송 내역, 정산, 계좌, 알림 설정을 여기서 확인합니다."
               Badge="기사 메뉴" />

<MudGrid>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Color="Color.Primary" Size="Size.Large">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" />
                        </MudAvatar>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">@Display(Profile?.기사명, AuthSession.UserName, "기사")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Display(Profile?.차량명, Profile?.차량, "차량 정보 미등록")</MudText>
                        </MudStack>
                    </MudStack>

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <MudAlert Severity="@StatusSeverity" Dense="true" Variant="Variant.Outlined">@StatusMessage</MudAlert>
                    }

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">운행 상태</MudText>
                            <MudText Typo="Typo.body1">@Display(Profile?.운행상태, "미확인")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">활동 지역</MudText>
                            <MudText Typo="Typo.body1">@Display(Profile?.주_활동지역, "미등록")</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">복귀지</MudText>
                            <MudText Typo="Typo.body1">@Display(Profile?.기본복귀지주소, "기본 복귀지 미설정")</MudText>
                        </MudItem>
                    </MudGrid>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@IsBusy"
                               StartIcon="@Icons.Material.Filled.Sync"
                               OnClick="LoadProfileAsync">
                        프로필 새로고침
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">빠른 이동</MudText>
                    <MudButton Href="/driver/home" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Map">
                        지도 홈
                    </MudButton>
                    <MudButton Href="/driver/work/start" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlayArrow">
                        운행 시작
                    </MudButton>
                    <MudButton Href="/driver/transports/current" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.LocalShipping">
                        현재 운송
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">기사 정보 메뉴</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        DriverApp 사용자 메뉴의 주요 항목을 WebAssembly 작업공간으로 정리했습니다.
                    </MudText>
                </MudStack>

                <MudGrid>
                    @foreach (var item in MenuItems)
                    {
                        <MudItem xs="12" sm="6">
                            <MudPaper Elevation="0" Outlined="true" Class="driver-info-menu-card pa-4 h-100">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Color="@item.Color" Size="Size.Medium">
                                            <MudIcon Icon="@item.Icon" />
                                        </MudAvatar>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@item.Title</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Description</MudText>
                                        </MudStack>
                                    </MudStack>
                                    <MudButton Href="@item.Route"
                                               Variant="Variant.Text"
                                               Color="@item.Color"
                                               EndIcon="@Icons.Material.Filled.ChevronRight">
                                        확인
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<DriverInfoMenuItem> MenuItems =
    [
        new("운송 내역", "완료/진행 운송 기록과 다음 행동", "/driver/transports/history", Icons.Material.Filled.History, Color.Primary),
        new("계좌 정보", "정산 받을 계좌와 본인 확인", "/driver/account/bank", Icons.Material.Filled.AccountBalance, Color.Info),
        new("월 정산", "이번 달 배차 건수와 이용료", "/driver/settlements/current-month", Icons.Material.Filled.ReceiptLong, Color.Success),
        new("알림 설정", "추천콜, 운송, 정산 알림 방식", "/driver/notifications/settings", Icons.Material.Filled.Notifications, Color.Warning),
        new("화면 설정", "기사 홈과 추천 카드 표시 방식", "/driver/settings/views", Icons.Material.Filled.Tune, Color.Secondary),
        new("운행 설정", "복귀지와 운행 시작 기준", "/driver/work/settings", Icons.Material.Filled.Route, Color.Secondary)
    ];

    private 용달기사등록응답? Profile { get; set; }
    private bool IsBusy { get; set; }
    private string? StatusMessage { get; set; }
    private Severity StatusSeverity { get; set; } = Severity.Info;

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.RestoreAsync();
        await TryLoadProfileAsync();
    }

    private async Task TryLoadProfileAsync()
    {
        try
        {
            await LoadProfileCoreAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"기사 프로필을 아직 불러오지 못했습니다. {ex.Message}", Severity.Info);
        }
    }

    private async Task LoadProfileAsync()
    {
        IsBusy = true;
        SetStatus("기사 프로필을 조회하는 중입니다.", Severity.Info);

        try
        {
            await LoadProfileCoreAsync();
            SetStatus("기사 프로필을 조회했습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LoadProfileCoreAsync()
    {
        Profile = await 내정보Service.내프로필조회Async();
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }

    private static string Display(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private sealed record DriverInfoMenuItem(
        string Title,
        string Description,
        string Route,
        string Icon,
        Color Color);
}
