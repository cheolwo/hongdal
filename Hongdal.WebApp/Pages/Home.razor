@page "/"

<WebPageHeader Title="홍달 웹앱 통합 홈"
               Description="모바일 앱으로 굳히기 전에 브라우저에서 역할별 화면과 1.0 핵심 워크플로우를 먼저 검증합니다."
               Badge="홍달 1.0 웹 검증" />

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">역할별 웹 진입</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        화주, 기사, 창고 관리자, 주문자 화면을 웹에서 먼저 눌러보고 업무 흐름을 조정합니다.
                    </MudText>
                </MudStack>
                <WebPageLinkGrid Items="PrimaryLinks" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">1차 이관 기준</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle">공통 UI 컴포넌트는 WebAssembly에서 바로 사용</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle">네이티브 센서 기능은 모바일 앱에 유지</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle">화면은 역할별 단일 책임으로 분리</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle">서버 API는 `HongdalApiBaseAddress` 기준으로 호출</MudListItem>
                    </MudList>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">다음 이관 대상</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        기사 추천 상세, 상차/하차 증빙, 창고 피킹/스캔, 주문자 공동주문 화면은 공통 RCL로 옮기면 웹과 모바일에서 함께 재사용할 수 있습니다.
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<WebAppPageLink> PrimaryLinks =
    [
        new("웹 로그인", "공통 로그인 패널과 소셜 로그인 뼈대를 웹에서 확인합니다.", "/login", Icons.Material.Filled.Login, "Common"),
        new("화주 웹", "운송 의뢰, 입고, 창고, 판매 채널 흐름을 웹에서 확인합니다.", "/shipper", Icons.Material.Filled.LocalShipping, "Shipper"),
        new("기사 웹", "추천 배차, 진행 중 운송, 정산 관점을 웹 화면으로 분리합니다.", "/driver", Icons.Material.Filled.Route, "Driver"),
        new("창고 관리자 웹", "입고, 스캔, 피킹, 포장 작업을 브라우저 기준 화면으로 정리합니다.", "/warehouse", Icons.Material.Filled.Warehouse, "Warehouse"),
        new("주문자 웹", "공동주문 의사 표시와 주문자 집단 형성 흐름을 웹에서 검토합니다.", "/orderer", Icons.Material.Filled.Groups, "Orderer")
    ];
}
