@page "/warehouse/mart"
@page "/mart"

<WebPageHeader Eyebrow="Warehouse Web"
               Title="홍달마트"
               Description="음식점 주문 처리처럼 빠르게 움직이지만, 조리 대신 창고 재고를 입고, 보충, 피킹, 포장 완료 후 배달 기사 픽업으로 연결합니다."
               Badge="도심 물류" />

<MudGrid>
    @foreach (var item in MartActions)
    {
        <MudItem xs="12" md="6" xl="3">
            <MudPaper Class="pa-4 h-100" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudIcon Icon="@item.Icon" Color="@item.Color" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@item.Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Description</MudText>
                    <MudButton Href="@item.Route" Variant="Variant.Filled" Color="@item.Color">시작</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">홍달마트 업무 흐름</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">주문 마감, 재고 위치, 포장 완료, 배달 기사 도착 시간을 같이 보며 처리 우선순위를 잡습니다.</MudText>
        </MudStack>
        <MudButton Href="@WarehouseManagerRoutes.MartWorkBoard" Variant="Variant.Filled" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ChevronRight">
            작업 보드
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private static readonly IReadOnlyList<MartAction> MartActions =
    [
        new("도심 입고", "납품, 반품, 거점 이동 물량을 창고 재고로 확인합니다.", WarehouseManagerRoutes.MartInboundWorkStart, Icons.Material.Filled.MoveToInbox, Color.Warning),
        new("진열/피킹존 보충", "냉장, 상온, 즉시 출고 구역의 재고를 주문 처리 가능 상태로 맞춥니다.", WarehouseManagerRoutes.MartReplenishmentWorkStart, Icons.Material.Filled.Inventory2, Color.Info),
        new("주문 피킹/포장", "고객 주문 단위로 상품을 모으고 포장 완료 상태까지 처리합니다.", WarehouseManagerRoutes.MartPickingWorkStart, Icons.Material.Filled.ShoppingCartCheckout, Color.Primary),
        new("배달 기사 픽업", "포장 완료된 주문을 음식 배달 기사에게 넘기고 고객 배송으로 연결합니다.", WarehouseManagerRoutes.MartDeliveryPickupWorkStart, Icons.Material.Filled.DeliveryDining, Color.Success)
    ];

    private sealed record MartAction(string Title, string Description, string Route, string Icon, Color Color);
}
