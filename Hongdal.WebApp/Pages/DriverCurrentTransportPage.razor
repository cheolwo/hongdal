@page "/driver/transports/current"
@using Hongdal.Contracts.Driver.Transport
@inject 기사운송증빙Service 증빙Service

<WebPageHeader Eyebrow="Driver Web"
               Title="진행 중 운송"
               Description="추천 수락 이후 생성된 현재 운송의 다음 행동을 확인하고 상차/하차 증빙 화면으로 이어갑니다."
               Badge="현재 운송 API" />

<MudStack Spacing="3">
    @if (HasAcceptedRequestContext)
    {
        <MudAlert Severity="@(IsWaitingForAcceptedTransport ? Severity.Info : IsAcceptedRequestLoaded ? Severity.Success : Severity.Warning)" Dense="true" Variant="Variant.Outlined">
            @AcceptedTransportGuideText
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined">
            @StatusMessage
        </MudAlert>
    }

    @if (CurrentTransport is null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">표시할 현재 운송이 없습니다.</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    기사 계정으로 로그인한 뒤 현재 운송을 조회하거나 추천 배차를 먼저 수락해 주세요.
                </MudText>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Justify="Justify.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="@IsBusy" OnClick="LoadCurrentTransportAsync">
                        현재 운송 조회
                    </MudButton>
                    <MudButton Href="/driver/recommendations" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TaskAlt">
                        추천 배차로
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" lg="8">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@CurrentTransport.운송번호</MudText>
                                <MudText Typo="Typo.h5">@NextActionLabel</MudText>
                            </MudStack>
                            <MudChip T="string" Color="@ResolveTransportStateColor(CurrentTransport.상태)" Variant="Variant.Filled">
                                @Display(CurrentTransport.상태, "진행중")
                            </MudChip>
                        </MudStack>

                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">상차</MudText>
                                <MudText Typo="Typo.subtitle1">@Display(CurrentTransport.출발지, "-")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">하차</MudText>
                                <MudText Typo="Typo.subtitle1">@Display(CurrentTransport.도착지, "-")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">운임</MudText>
                                <MudText Typo="Typo.body1">@DisplayMoney(CurrentTransport.운임)</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">결제/증빙</MudText>
                                <MudText Typo="Typo.body1">@Display(CurrentTransport.결제방식, "현장 확인")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">최근 갱신</MudText>
                                <MudText Typo="Typo.body1">@CurrentTransport.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</MudText>
                            </MudItem>
                        </MudGrid>

                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @if (CurrentTransport.인수증필요)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                    @(CurrentTransport.인수증서명필수 ? "인수증 서명 필수" : "인수증 필요")
                                </MudChip>
                            }
                            @if (CurrentTransport.예외신고됨)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">예외 신고됨</MudChip>
                            }
                            @if (CurrentTransport.관리자확인필요)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">관리자 확인 필요</MudChip>
                            }
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(CurrentTransport.다음행동안내))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                                @CurrentTransport.다음행동안내
                            </MudAlert>
                        }

                        @if (!string.IsNullOrWhiteSpace(CurrentTransport.최근예외메시지))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                                @CurrentTransport.최근예외단계 · @CurrentTransport.최근예외코드 · @CurrentTransport.최근예외메시지
                            </MudAlert>
                        }

                        <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">운송 상태 타임라인</MudText>
                                <MudGrid>
                                    @foreach (var step in Timeline)
                                    {
                                        <MudItem xs="6" sm="4" md="2">
                                            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@step.Icon" Color="@step.Color" Size="Size.Medium" />
                                                <MudText Typo="Typo.caption" Align="Align.Center">@step.Label</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@step.Color" Variant="@step.Variant">@step.Status</MudChip>
                                            </MudStack>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudStack>
                        </MudPaper>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudStack Spacing="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">현장 상태 전환</MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Disabled="@IsBusy"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Place"
                                       OnClick="ArrivePickupAsync">
                                상차지 도착
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Disabled="@IsBusy"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Flag"
                                       OnClick="ArriveDropoffAsync">
                                하차지 도착
                            </MudButton>
                            <MudButton Href="@ProofHref"
                                       Variant="Variant.Filled"
                                       Color="@NextActionColor"
                                       FullWidth="true"
                                       StartIcon="@NextActionIcon">
                                @NextActionButtonLabel
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">이동</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@IsBusy" StartIcon="@Icons.Material.Filled.Sync" OnClick="LoadCurrentTransportAsync">
                                현재 운송 새로고침
                            </MudButton>
                            <MudButton Href="/driver/work/start" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlayArrow">
                                운행 시작으로
                            </MudButton>
                            <MudButton Href="/driver/home" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Home">
                                기사 홈으로
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private const int AcceptedTransportRetryCount = 5;
    private static readonly TimeSpan AcceptedTransportRetryDelay = TimeSpan.FromMilliseconds(700);

    [SupplyParameterFromQuery(Name = "acceptedRequestId")]
    public string? AcceptedRequestId { get; set; }

    private 기사운송요약응답? CurrentTransport { get; set; }
    private bool IsBusy { get; set; }
    private bool IsWaitingForAcceptedTransport { get; set; }
    private int AcceptedTransportRetryAttempt { get; set; }
    private string? StatusMessage { get; set; }
    private Severity StatusSeverity { get; set; } = Severity.Info;

    private bool HasAcceptedRequestContext => !string.IsNullOrWhiteSpace(AcceptedRequestId);
    private bool IsAcceptedRequestLoaded
        => !HasAcceptedRequestContext
           || string.Equals(CurrentTransport?.운송번호, AcceptedRequestId, StringComparison.OrdinalIgnoreCase);
    private string AcceptedTransportGuideText
        => IsWaitingForAcceptedTransport
            ? $"{AcceptedRequestId} 수락을 현재 운송으로 전환하는 중입니다. 자동 조회 {AcceptedTransportRetryAttempt}/{AcceptedTransportRetryCount}"
            : IsAcceptedRequestLoaded
                ? $"{AcceptedRequestId} 수락 건이 현재 운송으로 연결되었습니다."
                : $"{AcceptedRequestId} 수락 건과 다른 현재 운송이 조회되었습니다. 새로고침으로 다시 확인해 주세요.";
    private bool ShouldPickup => CurrentStageOrder <= 2;
    private int CurrentStageOrder => ResolveStageOrder(CurrentTransport?.상태);
    private string NextActionLabel => ShouldPickup ? "상차 준비" : "하차/인수 확인";
    private string NextActionButtonLabel => ShouldPickup ? "상차 증빙으로" : "하차 증빙으로";
    private string NextActionIcon => ShouldPickup ? Icons.Material.Filled.FileUpload : Icons.Material.Filled.TaskAlt;
    private Color NextActionColor => ShouldPickup ? Color.Primary : Color.Success;
    private string ProofHref => CurrentTransport is null
        ? "/driver/transport/proof"
        : ShouldPickup
            ? $"/driver/transports/{CurrentTransport.Id}/pickup"
            : $"/driver/transports/{CurrentTransport.Id}/dropoff";

    private IReadOnlyList<TimelineStep> Timeline =>
    [
        BuildTimelineStep("접수", Icons.Material.Filled.AssignmentTurnedIn, 0),
        BuildTimelineStep("배차확정", Icons.Material.Filled.LocalShipping, 1),
        BuildTimelineStep("상차지", Icons.Material.Filled.Place, 2),
        BuildTimelineStep("상차완료", Icons.Material.Filled.FileUpload, 3),
        BuildTimelineStep("하차지", Icons.Material.Filled.Flag, 4),
        BuildTimelineStep("인수완료", Icons.Material.Filled.TaskAlt, 5)
    ];

    protected override async Task OnInitializedAsync()
    {
        await TryLoadCurrentTransportAsync();
    }

    private async Task TryLoadCurrentTransportAsync()
    {
        try
        {
            await LoadCurrentTransportCoreAsync();
            if (HasAcceptedRequestContext && !IsAcceptedRequestLoaded)
            {
                await WaitForAcceptedTransportAsync();
                return;
            }

            if (HasAcceptedRequestContext && IsAcceptedRequestLoaded)
            {
                SetStatus("추천 수락 후 현재 운송을 조회했습니다. 다음 행동을 확인해 주세요.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            if (HasAcceptedRequestContext)
            {
                await WaitForAcceptedTransportAsync(ex.Message);
                return;
            }

            SetStatus($"현재 운송을 아직 불러오지 못했습니다. {ex.Message}", Severity.Info);
        }
    }

    private async Task LoadCurrentTransportAsync()
    {
        await RunAsync("현재 운송을 조회했습니다.", LoadCurrentTransportCoreAsync);
    }

    private async Task LoadCurrentTransportCoreAsync()
    {
        CurrentTransport = await 증빙Service.현재운송조회Async();
    }

    private async Task WaitForAcceptedTransportAsync(string? firstFailureMessage = null)
    {
        IsWaitingForAcceptedTransport = true;

        try
        {
            for (var attempt = 1; attempt <= AcceptedTransportRetryCount; attempt++)
            {
                AcceptedTransportRetryAttempt = attempt;
                await InvokeAsync(StateHasChanged);

                if (attempt > 1)
                {
                    await Task.Delay(AcceptedTransportRetryDelay);
                }

                try
                {
                    await LoadCurrentTransportCoreAsync();
                    if (IsAcceptedRequestLoaded)
                    {
                        SetStatus("배차 수락으로 생성된 현재 운송을 확인했습니다.", Severity.Success);
                        return;
                    }
                }
                catch (Exception ex)
                {
                    var message = attempt == 1 && !string.IsNullOrWhiteSpace(firstFailureMessage)
                        ? firstFailureMessage
                        : ex.Message;
                    SetStatus($"현재 운송 생성 여부를 확인하는 중입니다. {message}", Severity.Info);
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (CurrentTransport is null)
            {
                SetStatus("수락은 전송됐지만 현재 운송 건을 아직 찾지 못했습니다. 잠시 후 현재 운송 새로고침을 눌러 주세요.", Severity.Warning);
                return;
            }

            SetStatus($"{AcceptedRequestId} 수락 건 대신 {CurrentTransport.운송번호} 운송이 조회되었습니다. 기존 진행 운송이 있거나 서버 사후처리를 확인해야 합니다.", Severity.Warning);
        }
        finally
        {
            IsWaitingForAcceptedTransport = false;
        }
    }

    private async Task ArrivePickupAsync()
    {
        if (CurrentTransport is null)
        {
            SetStatus("먼저 현재 운송을 조회해 주세요.", Severity.Warning);
            return;
        }

        await RunAsync("상차지 도착 상태를 서버에 반영했습니다.", async () =>
        {
            await 증빙Service.상차지도착Async(CurrentTransport.Id);
            await LoadCurrentTransportCoreAsync();
        });
    }

    private async Task ArriveDropoffAsync()
    {
        if (CurrentTransport is null)
        {
            SetStatus("먼저 현재 운송을 조회해 주세요.", Severity.Warning);
            return;
        }

        await RunAsync("하차지 도착 상태를 서버에 반영했습니다.", async () =>
        {
            await 증빙Service.하차지도착Async(CurrentTransport.Id);
            await LoadCurrentTransportCoreAsync();
        });
    }

    private async Task RunAsync(string successMessage, Func<Task> action)
    {
        IsBusy = true;
        SetStatus("서버 요청을 처리하는 중입니다.", Severity.Info);

        try
        {
            await action();
            SetStatus(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }

    private TimelineStep BuildTimelineStep(string label, string icon, int order)
    {
        var current = order == CurrentStageOrder;
        var reached = order <= CurrentStageOrder;
        return new TimelineStep(
            label,
            icon,
            current ? "현재" : reached ? "완료" : "대기",
            current ? Color.Primary : reached ? Color.Success : Color.Default,
            current || reached ? Variant.Filled : Variant.Outlined);
    }

    private static int ResolveStageOrder(string? status)
    {
        if (ContainsAny(status, "인수", "하차완료", "완료"))
        {
            return 5;
        }

        if (ContainsAny(status, "하차지"))
        {
            return 4;
        }

        if (ContainsAny(status, "상차완료", "운송중"))
        {
            return 3;
        }

        if (ContainsAny(status, "상차지", "상차"))
        {
            return 2;
        }

        if (ContainsAny(status, "배차", "매칭"))
        {
            return 1;
        }

        return 0;
    }

    private static Color ResolveTransportStateColor(string? status)
    {
        if (ContainsAny(status, "완료", "인수"))
        {
            return Color.Success;
        }

        if (ContainsAny(status, "예외", "실패", "문제"))
        {
            return Color.Error;
        }

        if (ContainsAny(status, "도착", "상차", "하차", "운송"))
        {
            return Color.Info;
        }

        return Color.Default;
    }

    private static bool ContainsAny(string? value, params string[] tokens)
        => !string.IsNullOrWhiteSpace(value)
           && tokens.Any(token => value.Contains(token, StringComparison.OrdinalIgnoreCase));

    private static string Display(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static string DisplayMoney(decimal? value)
        => value.HasValue ? $"{value.Value:N0}원" : "금액 미정";

    private sealed record TimelineStep(
        string Label,
        string Icon,
        string Status,
        Color Color,
        Variant Variant);
}
