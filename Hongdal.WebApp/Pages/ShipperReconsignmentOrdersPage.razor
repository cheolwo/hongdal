@page "/shipper/reconsignment/orders"
@inject IWarehouseWorkspaceService WarehouseService
@inject NavigationManager Navigation

<WebPageHeader Eyebrow="Shipper Web"
               Title="재위탁 운송"
               Description="입고된 재고를 기사님에게 다시 운송위탁하는 전용 화면입니다."
               Badge="재고 기반 운송" />

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="@MessageSeverity" Class="mb-4">@Message</MudAlert>
}

<MudGrid>
    <MudItem xs="12" lg="5">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">재고 선택</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">새로고침</MudButton>
                </MudStack>

                @if (Inventory.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">재위탁 가능한 재고가 없습니다.</MudAlert>
                }
                else
                {
                    <MudList T="재고항목응답" Dense="true">
                        @foreach (var item in Inventory)
                        {
                            <MudListItem T="재고항목응답" Value="@item" OnClick="@(() => SelectInventory(item))">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1">@item.상품명 (@item.SKU)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.창고명 · 가용 @item.가용수량 · @item.보관위치</MudText>
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="7">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            @if (SelectedInventory is null)
            {
                <MudAlert Severity="Severity.Info">왼쪽에서 재고를 선택하면 기사 운송위탁 정보를 입력할 수 있습니다.</MudAlert>
            }
            else
            {
                <MudStack Spacing="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">기사 운송위탁 - @SelectedInventory.상품명</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">수량과 도착지를 입력한 뒤 운송의뢰 생성 흐름을 검증합니다.</MudText>
                    </MudStack>

                    <MudGrid>
                        <MudItem xs="12" md="4"><MudNumericField T="int" Label="위탁수량" @bind-Value="Quantity" Variant="Variant.Outlined" Min="1" Max="@SelectedInventory.가용수량" /></MudItem>
                        <MudItem xs="12" md="4"><MudTextField Label="화물종류" @bind-Value="CargoType" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="4"><MudTextField Label="차량종류" @bind-Value="VehicleType" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="8"><MudTextField Label="도착지 주소" @bind-Value="DropoffAddress" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="4"><MudTextField Label="도착지 상세주소" @bind-Value="DropoffAddressDetail" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="IsBusy" OnClick="CreateAsync">운송위탁 생성</MudButton>
                        <MudButton Variant="Variant.Outlined" Href="@ShipperRoutes.WarehouseInventory">재고 허브로 돌아가기</MudButton>
                    </MudStack>
                </MudStack>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public long? InventoryItemId { get; set; }

    private readonly List<재고항목응답> Inventory = [];
    private 재고항목응답? SelectedInventory;
    private bool IsBusy;
    private string? Message;
    private Severity MessageSeverity = Severity.Info;
    private int Quantity = 1;
    private string CargoType = string.Empty;
    private string VehicleType = "1톤 카고";
    private string DropoffAddress = "서울 마포구 월드컵북로";
    private string DropoffAddressDetail = "상세 주소 확인 필요";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var response = await WarehouseService.GetInventoryAsync();
        Inventory.Clear();
        Inventory.AddRange((response?.Items ?? []).Where(x => x.가용수량 > 0));

        if (InventoryItemId.HasValue)
        {
            var matched = Inventory.FirstOrDefault(x => x.입고상품Id == InventoryItemId.Value);
            if (matched is not null)
            {
                SelectInventory(matched);
            }
        }

        MessageSeverity = Severity.Info;
        Message = $"재위탁 가능한 재고 {Inventory.Count}건을 불러왔습니다.";
    }

    private void SelectInventory(재고항목응답 item)
    {
        SelectedInventory = item;
        Quantity = Math.Max(1, Math.Min(1, item.가용수량));
        CargoType = item.상품명;
        VehicleType = item.상품명.Contains("냉장", StringComparison.OrdinalIgnoreCase) ? "냉동탑차" : "1톤 카고";
    }

    private async Task CreateAsync()
    {
        if (SelectedInventory is null || IsBusy)
        {
            return;
        }

        IsBusy = true;
        try
        {
            await Task.Delay(120);
            MessageSeverity = Severity.Success;
            Message = $"재위탁 운송의뢰 WEB-RE-{DateTime.Now:HHmmss} 생성 흐름을 확인했습니다.";
        }
        finally
        {
            IsBusy = false;
        }
    }
}
