@page "/driver/settlements/current-month"
@using Hongdal.Contracts.Driver.Settlement
@inject 기사정산Service 정산Service

<WebPageHeader Eyebrow="Driver Web"
               Title="월 정산"
               Description="이번 달 배차 건수, 이용료, 월 상한, 결제 상태를 확인합니다."
               Badge="현재 월" />

<MudStack Spacing="3">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined">@StatusMessage</MudAlert>
    }

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h6">@SettlementMonthLabel</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@IsBusy" StartIcon="@Icons.Material.Filled.Sync" OnClick="LoadAsync">
            새로고침
        </MudButton>
    </MudStack>

    <MudGrid>
        @foreach (var item in SummaryItems)
        {
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Label</MudText>
                    <MudText Typo="Typo.h6">@item.Value</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">상세 내역</MudText>
            @foreach (var line in DetailLines)
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="driver-settlement-line">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2">@line.Title</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@line.Description</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="driver-settlement-line__amount">@line.Amount</MudText>
                </MudStack>
            }

            <MudAlert Severity="@(Settlement?.IsPaid == true ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined">
                @(Settlement?.IsPaid == true ? "이번 달 정산이 완료되었습니다." : "이번 달 이용료 확인이 필요합니다.")
            </MudAlert>

            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudButton Href="/driver/account/bank" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountBalance">
                    계좌 정보
                </MudButton>
                <MudButton Href="/driver/me" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AccountCircle">
                    내 정보 메뉴
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private 기사정산응답? Settlement { get; set; }
    private bool IsBusy { get; set; }
    private string? StatusMessage { get; set; }
    private Severity StatusSeverity { get; set; } = Severity.Info;

    private string SettlementMonthLabel
        => Settlement is null ? "정산 월 미확인" : $"{Settlement.Year}년 {Settlement.Month}월";

    private IReadOnlyList<(string Label, string Value)> SummaryItems =>
    [
        ("배차 건수", $"{Settlement?.DispatchCount ?? 0:N0}건"),
        ("이용료", $"{Settlement?.UsageFee ?? 0m:N0}원"),
        ("월 상한", $"{Settlement?.MonthlyFeeCap ?? 0m:N0}원"),
        ("상한 잔여", $"{Settlement?.RemainingUntilCap ?? 0m:N0}원")
    ];

    private IReadOnlyList<(string Title, string Description, string Amount)> DetailLines =>
    [
        ("이용료", "이번 달 배차 기준 누적 이용료", $"{Settlement?.UsageFee ?? 0m:N0}원"),
        ("월 상한", "정책상 월 이용료 상한", $"{Settlement?.MonthlyFeeCap ?? 0m:N0}원"),
        ("상한 잔여", "월 상한까지 남은 금액", $"{Settlement?.RemainingUntilCap ?? 0m:N0}원")
    ];

    protected override async Task OnInitializedAsync()
    {
        await TryLoadAsync();
    }

    private async Task TryLoadAsync()
    {
        try
        {
            Settlement = await 정산Service.현재월조회Async();
        }
        catch (Exception ex)
        {
            SetStatus($"정산 정보를 아직 불러오지 못했습니다. {ex.Message}", Severity.Info);
        }
    }

    private async Task LoadAsync()
    {
        IsBusy = true;
        SetStatus("정산 정보를 조회하는 중입니다.", Severity.Info);

        try
        {
            Settlement = await 정산Service.현재월조회Async();
            SetStatus("정산 정보를 조회했습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }
}
