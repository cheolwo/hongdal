@page "/community"
@implements IDisposable
@inject PlatformDiagramPaletteStateService DiagramPalette

<PlatformCommunityHome AppName="홍달 웹앱"
                       RoleLabel="웹 사용자"
                       AppKey="shipper"
                       QuickActions="QuickActions"
                       QueryLedgerTemplateKey="QueryLedgerTemplateKey"
                       QueryDiagramMode="QueryDiagramMode"
                       QueryPostId="QueryPostId" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "ledgerTemplate")]
    public string? QueryLedgerTemplateKey { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "diagram")]
    public string? QueryDiagramMode { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "postId")]
    public long? QueryPostId { get; set; }

    private static readonly IReadOnlyList<PlatformHomeQuickAction> QuickActions =
    [
        new("운송 단가 질문", "운송 의뢰 작성 중 생성한 초안을 게시판에서 다듬습니다.", "/shipper/request", Icons.Material.Filled.PostAdd, Color.Primary),
        new("기사 경험 보기", "추천 배차와 현장 예외 상황을 기사 관점에서 봅니다.", "/driver/recommendations", Icons.Material.Filled.Route, Color.Info)
    ];

    protected override void OnInitialized()
    {
        DiagramPalette.Changed += HandleDiagramModeChanged;
    }

    protected override void OnParametersSet()
    {
        if (IsTruthyQueryValue(QueryDiagramMode))
        {
            DiagramPalette.SetDiagramMode(true);
        }
    }

    private static bool IsTruthyQueryValue(string? value)
        => !string.IsNullOrWhiteSpace(value) &&
           (value.Equals("1", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("true", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("yes", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("diagram", StringComparison.OrdinalIgnoreCase));

    private void HandleDiagramModeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DiagramPalette.Changed -= HandleDiagramModeChanged;
    }
}
