@page "/shipper"

<WebPageHeader Eyebrow="Shipper Web"
               Title="화주 웹 작업공간"
               Description="웹에서는 운송 의뢰 정보를 한 화면에서 입력하고, 모바일에서는 단계형 입력 흐름을 검증합니다."
               Badge="공통 운송 모델 사용" />

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">화주 주요 작업</MudText>
                <WebPageLinkGrid Items="Links" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">의뢰 상태 타임라인</MudText>
                <div class="web-timeline">
                    @foreach (var item in Timeline)
                    {
                        <MudStack Spacing="0" Class="mb-3">
                            <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                        </MudStack>
                    }
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<WebAppPageLink> Links =
    [
        new("운송 의뢰 작성", "웹 기본값으로 화물, 운송, 절차/결제 정보를 한 화면에서 입력합니다.", "/shipper/request", Icons.Material.Filled.PostAdd, "Shipper"),
        new("의뢰 상세 타임라인", "결제, 배차, 수락, 상차, 하차, 정산 상태를 한 화면으로 검증합니다.", "/shipper/request/HD-WEB-001", Icons.Material.Filled.Timeline, "Shipper"),
        new("커뮤니티 상담", "단가나 차량 선택이 애매할 때 게시글 초안을 만들고 상담을 받을 수 있습니다.", "/community", Icons.Material.Filled.Forum, "Common"),
        new("모바일 페이지 이관 목록", "입고, 창고, 판매 채널 페이지를 웹앱으로 옮길 때의 기준점을 확인합니다.", "/", Icons.Material.Filled.FormatListBulleted, "WebApp", "정리 필요")
    ];

    private static readonly IReadOnlyList<(string Title, string Description)> Timeline =
    [
        ("의뢰 작성", "화주가 화물, 운송, 결제 조건을 입력합니다."),
        ("배차 추천", "서버가 기사 후보를 찾고 추천을 보냅니다."),
        ("기사 수락", "수락 후 화주에게 준비 알림이 전달됩니다."),
        ("상차/하차 증빙", "사진 업로드가 완료된 뒤 상태가 변경됩니다."),
        ("정산", "하차 완료 후 결제/입금 상태를 관리합니다.")
    ];
}
