@page "/"
@page "/reviews/compositions"
@page "/world/review/compositions"
@using Ssalddel.Contracts.Common.WorldProjection
@inject Synty공간조립검토Workspace Workspace
@inject UnityReviewAuthSessionService AuthSession


<PageTitle>Synty 공간 조립 Web 검토 · 살뜰</PageTitle>

<header class="review-page-header">
    <span>UNITY ARTIFACT REVIEW</span>
    <h1>Synty 공간 조립 Web 검토</h1>
    <p>Unity가 촬영한 조합물을 휴대폰 Web에서 확인하고, 서버 원장에 후보 판단만 기록합니다.</p>
    <strong>관리자 · 후보 검토</strong>
</header>

@if (!AuthSession.IsInitialized)
{
    <section class="review-gate">
        <h2>검토 세션을 확인하고 있습니다</h2>
        <p>전용 Unity 산출물 검토 앱의 로그인 상태를 불러오는 중입니다.</p>
    </section>
}
else if (!AuthSession.IsLoggedIn)
{
    <section class="review-gate">
        <h2>로그인이 필요합니다</h2>
        <p>촬영 조합물과 검토 이력은 서버관리자에게만 공개됩니다.</p>
        <a class="primary-link" href="login">로그인</a>
    </section>
}
else if (!IsServerAdministrator)
{
    <section class="review-gate">
        <h2>서버관리자 전용 검토함입니다</h2>
        <p>현재 계정으로는 촬영 묶음과 검토 원장을 조회할 수 없습니다.</p>
    </section>
}
else
{
    <main class="composition-review-shell">
        <section class="safety-lock @(Workspace.ParkingConfirmed ? "confirmed" : string.Empty)">
            <div>
                <strong>신호 대기 중에는 사용하지 마세요</strong>
                <p>차량을 합법적인 장소에 완전히 주차하고 운전을 종료한 뒤에만 검토해 주세요.</p>
            </div>
            @if (!Workspace.ParkingConfirmed)
            {
                <button type="button" class="parking-confirm" @onclick="Workspace.ConfirmParking">
                    안전하게 주차했습니다
                </button>
            }
            else
            {
                <span class="parking-state">주차 검토 모드</span>
            }
        </section>

        <section class="public-image-notice" aria-label="검토 이미지 공개 범위">
            <strong>이미지 공개 범위</strong>
            <span>검토 화면은 관리자 전용이지만 검토 이미지 객체는 공개 읽기 방식입니다. 이미지 URL을 가진 사람은 로그인 없이 열 수 있습니다.</span>
        </section>

        <section class="review-toolbar" aria-label="검토함 상태">
            <div>
                <span>전체 <strong>@(Workspace.Inbox?.TotalCount ?? 0)</strong></span>
                <span>검토 대기 <strong>@(Workspace.Inbox?.ReadyCount ?? 0)</strong></span>
                <span>판단 완료 <strong>@(Workspace.Inbox?.ReviewedCount ?? 0)</strong></span>
            </div>
            <div class="toolbar-actions">
                @if (Workspace.OfflinePendingCount > 0)
                {
                    <button type="button" class="sync-button" disabled="@Workspace.Busy" @onclick="Workspace.SynchronizeOfflineAsync">
                        오프라인 @Workspace.OfflinePendingCount 건 동기화
                    </button>
                }
                <button type="button" class="refresh-button" disabled="@Workspace.Busy" @onclick="Workspace.LoadInboxAsync">
                    새로고침
                </button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Workspace.Message))
        {
            <div class="review-message @(Workspace.MessageIsError ? "error" : "success")" role="status">
                @Workspace.Message
            </div>
        }

        @if (Workspace.Loading)
        {
            <section class="review-empty">검토 조합물을 불러오고 있습니다.</section>
        }
        else if (Workspace.CurrentItem is null)
        {
            <section class="review-empty">
                <h2>아직 등록된 촬영 조합물이 없습니다</h2>
                <p>Unity 촬영 묶음을 관리자 API에 등록하면 이 화면에 카드가 나타납니다.</p>
            </section>
        }
        else
        {
            var item = Workspace.CurrentItem;
            var composition = item.Composition;
            var capture = Workspace.CurrentCapture;

            <article class="review-card" aria-labelledby="composition-review-title">
                <header class="card-heading">
                    <div>
                        <span class="card-progress">@(Workspace.CurrentIndex + 1) / @(Workspace.Inbox?.Items.Count ?? 0)</span>
                        <h2 id="composition-review-title">@composition.DisplayName</h2>
                        <p>@item.BatchTitle · @composition.VariantCode · @composition.StateProfileCode</p>
                    </div>
                    <span class="state-badge @Synty공간조립검토Presentation.StateCss(item.ReviewStateCode)">@Synty공간조립검토Presentation.StateLabel(item.ReviewStateCode)</span>
                </header>

                <section class="capture-stage">
                    @if (capture is null)
                    {
                        <div class="capture-placeholder">
                            <strong>촬영 대기</strong>
                            <span>이미지가 등록되어야 휴대폰 검토를 시작할 수 있습니다.</span>
                        </div>
                    }
                    else
                    {
                        @if (Workspace.ImageLoadFailed)
                        {
                            <div class="capture-placeholder image-error">
                                <strong>이미지를 불러오지 못했습니다</strong>
                                <span>이미지 공개 읽기 설정과 불변 저장 경로를 확인한 뒤 다시 시도해 주세요.</span>
                                <button type="button" @onclick="Workspace.RetryImage">이미지 다시 시도</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="capture-image-button" @onclick="Workspace.OpenImage" aria-label="이미지 전체 화면으로 보기">
                                <img @key="Workspace.ImageRenderKey"
                                     src="@capture.ImageUrl"
                                     alt="@($"{composition.DisplayName} · {capture.DisplayName}")"
                                     loading="eager"
                                     @onerror="Workspace.HandleImageLoadError" />
                            </button>
                        }
                        <span class="capture-label">@capture.DisplayName · @capture.Width×@capture.Height</span>
                    }
                </section>

                @if (item.ReviewStateCode == Synty공간조립검토상태Codes.NeedsRevision)
                {
                    <section class="recapture-waiting">
                        <strong>Unity 재촬영 대기</strong>
                        <span>현재 촬영 묶음과 원장 개정을 부모로 참조하는 새 촬영이 등록되어야 다시 검토할 수 있습니다.</span>
                    </section>
                }

                @if (composition.Captures.Count > 1)
                {
                    <nav class="capture-nav" aria-label="촬영 시점 선택">
                        @for (var captureIndex = 0; captureIndex < composition.Captures.Count; captureIndex++)
                        {
                            var index = captureIndex;
                            <button type="button"
                                    class="@(index == Workspace.CaptureIndex ? "active" : string.Empty)"
                                    aria-label="@(composition.Captures[index].DisplayName)"
                                    @onclick="() => Workspace.SelectCapture(index)">
                                @(index + 1)
                            </button>
                        }
                    </nav>
                }

                <section class="composition-facts">
                    <div><span>H1</span><code>@composition.H1StableId</code></div>
                    <div><span>H2</span><code>@composition.H2StableId</code></div>
                    <div><span>H3</span><code>@composition.H3StableId</code></div>
                </section>

                <section class="pack-usage" aria-label="팩 활용 비율">
                    @foreach (var pack in composition.PackUsages.OrderByDescending(pack => pack.UsagePercent))
                    {
                        <div class="pack-row">
                            <div><strong>@pack.PackCode</strong><span>@pack.RoleCode</span></div>
                            <div class="pack-meter"><span style="width: @(pack.UsagePercent)%"></span></div>
                            <b>@pack.UsagePercent%</b>
                        </div>
                    }
                </section>

                <section class="issue-section">
                    <h3>눈에 띈 문제</h3>
                    <div class="issue-chips">
                        @foreach (var issue in Synty공간조립검토Presentation.IssueChoices)
                        {
                            var selected = Workspace.SelectedIssues.Contains(issue.Code);
                            <button type="button"
                                    class="@(selected ? "selected" : string.Empty)"
                                    aria-pressed="@selected"
                                    disabled="@(!Workspace.ParkingConfirmed || Workspace.Busy)"
                                    @onclick="() => Workspace.ToggleIssue(issue.Code)">
                                @issue.Label
                            </button>
                        }
                    </div>
                    <label for="composition-review-note">짧은 메모</label>
                    <textarea id="composition-review-note"
                              maxlength="500"
                              rows="2"
                              disabled="@(!Workspace.ParkingConfirmed || Workspace.Busy)"
                              placeholder="필요할 때만 입력하세요."
                              @bind="Workspace.Note"></textarea>
                </section>

                @if (item.History.Count > 0)
                {
                    <section class="review-history" aria-label="최근 검토 이력">
                        <h3>최근 검토 이력</h3>
                        @foreach (var history in item.History.OrderByDescending(value => value.Revision).Take(3))
                        {
                            <div>
                                <strong>@Synty공간조립검토Presentation.HistoryLabel(history)</strong>
                                <span>@history.ReviewerDisplayName · @history.DecidedAtUtc.ToLocalTime().ToString("MM-dd HH:mm")</span>
                                @if (!string.IsNullOrWhiteSpace(history.Note))
                                {
                                    <p>@history.Note</p>
                                }
                            </div>
                        }
                    </section>
                }

                <section class="decision-grid" aria-label="빠른 검토 판단">
                    <button type="button" class="good" disabled="@Workspace.DecisionDisabled" @onclick="() => Workspace.SubmitDecisionAsync(Synty공간조립검토결정Codes.Good)">
                        <strong>좋음</strong><span>검토 후보로 남김</span>
                    </button>
                    <button type="button" class="revise" disabled="@Workspace.DecisionDisabled" @onclick="() => Workspace.SubmitDecisionAsync(Synty공간조립검토결정Codes.NeedsRevision)">
                        <strong>수정 필요</strong><span>문제와 함께 재조립</span>
                    </button>
                    <button type="button" class="hold" disabled="@Workspace.DecisionDisabled" @onclick="() => Workspace.SubmitDecisionAsync(Synty공간조립검토결정Codes.OnHold)">
                        <strong>보류</strong><span>나중에 다시 판단</span>
                    </button>
                    <button type="button" class="compare" disabled="@Workspace.DecisionDisabled" @onclick="() => Workspace.SubmitDecisionAsync(Synty공간조립검토결정Codes.CompareCandidate)">
                        <strong>비교 후보</strong><span>A/B/C와 나란히 보기</span>
                    </button>
                </section>

                <footer class="card-footer">
                    <button type="button" disabled="@(Workspace.CurrentIndex <= 0 || Workspace.Busy)" @onclick="Workspace.PreviousItem">이전</button>
                    <span>휴대폰 판단은 최종 Scene 승인이 아닙니다.</span>
                    <button type="button" disabled="@(!Workspace.CanMoveNext || Workspace.Busy)" @onclick="Workspace.NextItem">다음</button>
                </footer>
            </article>

            @if (Workspace.ImageExpanded && capture is not null)
            {
                <div class="image-lightbox" role="dialog" aria-modal="true" aria-label="조합물 촬영 이미지 확대" @onclick="Workspace.CloseImage">
                    <button type="button" class="lightbox-close" @onclick="Workspace.CloseImage">닫기</button>
                    <img src="@capture.ImageUrl" alt="@($"{composition.DisplayName} · {capture.DisplayName} 확대")" />
                    <span>@capture.DisplayName · 손가락으로 확대해 세부를 확인하세요.</span>
                </div>
            }
        }
    </main>
}
