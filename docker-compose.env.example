# 이 파일을 .env로 복사한 뒤 실제 값으로 바꿉니다. .env는 Git과 Docker 이미지에서 제외됩니다.
SSALDDEL_ASPNETCORE_ENVIRONMENT=Production

SSALDDEL_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
SSALDDEL_MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
SSALDDEL_MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
SSALDDEL_DB_CONNECTION_STRING=server=mysql;port=3306;database=ssalddel_dev;user=ssalddel;password=CHANGE_ME_APP_PASSWORD;
# 권장 단일 VM 구성은 Redis입니다. Redis 없이 확인할 때만 Memory로 바꿉니다.
SSALDDEL_TRANSIENT_STATE_PROVIDER=Redis
SSALDDEL_REDIS_CONNECTION_STRING=redis:6379
SSALDDEL_MONGO_CONNECTION_STRING=mongodb://ssalddel:CHANGE_ME_MONGO_PASSWORD@mongo:27017/?authSource=admin

SSALDDEL_JWT_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
SSALDDEL_DATA_PROTECTION_CERTIFICATE_PATH=/run/secrets/ssalddel-data-protection.pfx
SSALDDEL_DATA_PROTECTION_CERTIFICATE_PASSWORD=
SSALDDEL_ISMSP_AES256_GCM_KEY_BASE64=CHANGE_ME_WITH_A_32_BYTE_BASE64_KEY
SSALDDEL_ISMSP_HASH_SALT=CHANGE_ME_WITH_A_RANDOM_HASH_SALT
SSALDDEL_ISMSP_TRANSPORT_KEY_ID=ssalddel-local-transport-v1
SSALDDEL_ISMSP_FAIL_WHEN_KEY_MISSING=true
# PEM은 배포 플랫폼의 비밀 저장소에서 실제 줄바꿈을 보존해 주입하는 것을 권장합니다.
SSALDDEL_ISMSP_TRANSPORT_PUBLIC_KEY_PEM=
SSALDDEL_ISMSP_TRANSPORT_PRIVATE_KEY_PEM=

# 최초 관리자 계정이 없을 때만 true로 바꾸고 초기화 명령을 한 번 실행합니다.
# 성공 직후 false로 되돌리고 비밀번호 값을 제거합니다.
SSALDDEL_BOOTSTRAP_ADMIN_ENABLED=false
SSALDDEL_BOOTSTRAP_ADMIN_USER_NAME=
SSALDDEL_BOOTSTRAP_ADMIN_EMAIL=
SSALDDEL_BOOTSTRAP_ADMIN_PASSWORD=

SSALDDEL_AGRICULTURAL_FISHERIES_BATCH_ENABLED=true
SSALDDEL_KAMIS_DAILY_BATCH_ENABLED=true
SSALDDEL_KAMIS_DAILY_CRON_EXPRESSION="0 30 6 * * ?"
SSALDDEL_KAMIS_MONTHLY_BATCH_ENABLED=true
SSALDDEL_KAMIS_MONTHLY_CRON_EXPRESSION="0 0 7 2 * ?"
SSALDDEL_USDA_MONTHLY_BATCH_ENABLED=true
SSALDDEL_USDA_MONTHLY_CRON_EXPRESSION="0 30 7 10 * ?"
SSALDDEL_KAMIS_CERTIFICATION_KEY=CHANGE_ME_KAMIS_CERTIFICATION_KEY
SSALDDEL_KAMIS_REQUESTER_ID=CHANGE_ME_KAMIS_REQUESTER_ID
SSALDDEL_USDA_NASS_API_KEY=CHANGE_ME_USDA_NASS_API_KEY

# Azure VM Managed Identity에 Translator의 Cognitive Services User 역할을 부여한 뒤 true로 바꿉니다.
# ApiKey 방식은 로컬 호환용이며 운영 기본값은 MicrosoftEntraId입니다. 신고·분쟁 글은 기본적으로 번역하지 않습니다.
SSALDDEL_COMMUNITY_TRANSLATION_ENABLED=false
SSALDDEL_AZURE_TRANSLATOR_AUTHENTICATION_MODE=MicrosoftEntraId
SSALDDEL_AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
SSALDDEL_AZURE_TRANSLATOR_RESOURCE_ID=
SSALDDEL_AZURE_TRANSLATOR_MANAGED_IDENTITY_CLIENT_ID=
SSALDDEL_AZURE_TRANSLATOR_KEY=
SSALDDEL_AZURE_TRANSLATOR_REGION=koreacentral

# Gmail 앱 비밀번호는 Google 계정의 2단계 인증 후 별도로 발급한 16자리 값을 사용합니다.
SSALDDEL_COMMUNITY_POST_EMAIL_ENABLED=false
SSALDDEL_COMMUNITY_POST_EMAIL_RECIPIENT=
SSALDDEL_PUBLIC_BASE_URL=
SSALDDEL_GMAIL_USER_NAME=
SSALDDEL_GMAIL_APP_PASSWORD=
SSALDDEL_GMAIL_FROM_ADDRESS=
